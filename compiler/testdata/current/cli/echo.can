package app
    provides []
    uses [bytes, codec, io]
fn void main
    emits [codec::invalid_data, io::write_failed]
    given
        str[] args
    asserts
        sample: ["hello"] => ok
    match chain
        call bytes::from_utf8(args[0]) as bytes::buffer message
        call io::stdout_write(message) as int written
        ok => ok
        codec::invalid_data
        io::write_failed
