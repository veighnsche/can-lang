package app
    provides []
    uses [bytes, codec, io]
fn void main
    emits [codec::invalid_data, io::write_failed]
    given
        str[] args
    asserts
        sample: ["hello"] => ok
    match call bytes::from_utf8(args[0])
        codec::invalid_data
        ok bytes::buffer message => match call io::stdout_write(message)
            when
                sample: message => ok 5
            io::write_failed
            ok => ok
