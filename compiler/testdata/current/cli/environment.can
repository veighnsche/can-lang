package app
    provides []
    uses [env, option, http, io, bytes, codec]
fn void main
    emits [env::invalid_name, http::credentials_missing, io::write_failed, codec::invalid_data]
    given
        str[] args
    asserts
        sample: ["VALUE"] => ok
    option::some<int> unrelated = option::some<int>(1)
    match call env::required(args[0])
        when
            sample: "VALUE" => ok "fixture"
        env::invalid_name
        http::credentials_missing
        ok str value => match call env::optional("EMPTY")
            when
                sample: "EMPTY" => ok option::some<str>("")
            env::invalid_name
            ok option::value<str> present => match call env::optional("MISSING")
                when
                    sample: "MISSING" => ok option::none()
                env::invalid_name
                ok option::value<str> absent => match present is option::some<str>("") and absent is option::none()
                    false => do
                        int invalid = 1 / 0
                        ok
                    true => match call bytes::from_utf8(value)
                        codec::invalid_data
                        ok bytes::buffer encoded => match call io::stdout_write(encoded)
                            when
                                sample: encoded => ok 7
                            io::write_failed
                            ok int written => ok
