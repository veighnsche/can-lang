package app
    provides []
    uses [io, bytes, codec]
fn void main
    emits [io::limit_exceeded, io::read_failed, io::write_failed, codec::invalid_data]
    given
        str[] args
    asserts
        sample: [] => ok
    match call io::stdin_text(16)
        when
            sample: 16 => ok "fixture"
        ok str input => match call bytes::from_utf8(input)
            ok bytes::buffer encoded => match call io::stdout_write(encoded)
                when
                    sample: encoded => ok 7
                ok int written => ok
                io::write_failed
            codec::invalid_data
        io::limit_exceeded
        io::read_failed
        codec::invalid_data
