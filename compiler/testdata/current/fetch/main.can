package fetches
    provides []
    uses [http, codec, bytes]
record receipt
    int count
connection service
    endpoint "http://127.0.0.1:1/"
    auth bearer env "CAN_I26_TOKEN"
    timeout_ms 5000
    max_body_bytes 8192
fetch receipt load_json from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    get "/json"
    query
        labels = ["a b", "+"]
    headers
        x_probe = "yes"
fetch http::response<bytes::buffer> load_envelope from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    get "/envelope"
fetch str send_text from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    given
        str payload
    post "/text"
    body text payload
fetch receipt send_json from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    given
        receipt payload
    put "/json"
    body json payload
fetch bytes::buffer send_bytes from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    given
        bytes::buffer payload
    patch "/bytes"
    body bytes payload
fetch str head_text from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    head "/head"
fetch str delete_text from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    delete "/delete"
fetch str options_text from service
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    options "/options"
fn void require
    emits []
    given
        bool condition
    asserts
        yes: true => ok
    match condition
        true => ok
        false => do
            int invalid = 1 / 0
            ok
fn void main
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    given
        str[] args
    asserts
        sample: [] => ok
    bytes::buffer payload = call bytes::empty()
    match call load_json()
        when
            sample:  => ok receipt(9007199254740993)
        ok receipt received => do
            call require(received.count is 9007199254740993)
            match call load_envelope()
                when
                    sample:  => ok http::response<bytes::buffer>(418, [], payload)
                ok http::response<bytes::buffer> envelope => do
                    call require(envelope.status is 418)
                    match call send_text("hello")
                        when
                            sample: "hello" => ok "hello"
                        ok str text => do
                            call require(text is "hello")
                            match call send_json(receipt(9007199254740993))
                                when
                                    sample: receipt(9007199254740993) => ok receipt(9007199254740993)
                                ok receipt sent => do
                                    call require(sent.count is 9007199254740993)
                                    match call send_bytes(payload)
                                        when
                                            sample: payload => ok payload
                                        ok bytes::buffer binary => do
                                            int[] binary_values = call bytes::to_ints(binary)
                                            int[] no_values = []
                                            call require(binary_values is no_values)
                                            match call head_text()
                                                when
                                                    sample:  => ok ""
                                                ok str head => do
                                                    call require(head is "")
                                                    match call delete_text()
                                                        when
                                                            sample:  => ok "delete"
                                                        ok str deleted => do
                                                            call require(deleted is "delete")
                                                            match call options_text()
                                                                when
                                                                    sample:  => ok "options"
                                                                ok str options => do
                                                                    call require(options is "options")
                                                                    ok
                                                                http::invalid_request
                                                                http::credentials_missing
                                                                http::transport_failed
                                                                http::timeout
                                                                http::body_limit
                                                                http::status_error
                                                                codec::invalid_data
                                                        http::invalid_request
                                                        http::credentials_missing
                                                        http::transport_failed
                                                        http::timeout
                                                        http::body_limit
                                                        http::status_error
                                                        codec::invalid_data
                                                http::invalid_request
                                                http::credentials_missing
                                                http::transport_failed
                                                http::timeout
                                                http::body_limit
                                                http::status_error
                                                codec::invalid_data
                                        http::invalid_request
                                        http::credentials_missing
                                        http::transport_failed
                                        http::timeout
                                        http::body_limit
                                        http::status_error
                                        codec::invalid_data
                                http::invalid_request
                                http::credentials_missing
                                http::transport_failed
                                http::timeout
                                http::body_limit
                                http::status_error
                                codec::invalid_data
                        http::invalid_request
                        http::credentials_missing
                        http::transport_failed
                        http::timeout
                        http::body_limit
                        http::status_error
                        codec::invalid_data
                http::invalid_request
                http::credentials_missing
                http::transport_failed
                http::timeout
                http::body_limit
                http::status_error
                codec::invalid_data
        http::invalid_request
        http::credentials_missing
        http::transport_failed
        http::timeout
        http::body_limit
        http::status_error
        codec::invalid_data
fn str referenced
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    asserts
        sample: => ok "fixture"
    callable str (str) emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data] action = callable send_text
    match call action("value")
        when
            sample: "value" => ok "fixture"
        ok str output => ok output
        http::invalid_request
        http::credentials_missing
        http::transport_failed
        http::timeout
        http::body_limit
        http::status_error
        codec::invalid_data
