package fetches
    provides []
    uses [http, codec, bytes, checks]
record receipt
    int count
connection service
    endpoint "http://127.0.0.1:1/"
    auth bearer env "CAN_I26_TOKEN"
    timeout_ms 5000
    max_body_bytes 8192
fetch receipt load_json from service
    emits [http::request_failed]
    get (call [["/json"]].map(callable extract))[0]
    query
        labels = call [["a b"], ["+"]].map(callable extract)
        omitted = (([]))
    headers
        x_probe = call [["yes"]].map(callable extract)
        x_omitted = ([...([])])
fetch http::response<bytes::buffer> load_envelope from service
    emits [http::request_failed]
    get "/envelope"
fetch str send_text from service
    emits [http::request_failed]
    given
        str payload
    post "/text"
    body text (call [[payload]].map(callable extract))[0]
fetch receipt send_json from service
    emits [http::request_failed]
    given
        receipt payload
    put "/json"
    headers
        content_type = ([...([("application/json")])])
    body json payload
fetch bytes::buffer send_bytes from service
    emits [http::request_failed]
    given
        bytes::buffer payload
    patch "/bytes"
    body bytes payload
fetch str head_text from service
    emits [http::request_failed]
    head "/head"
fetch str delete_text from service
    emits [http::request_failed]
    delete "/delete"
fetch str options_text from service
    emits [http::request_failed]
    options "/options"
fn void main
    emits [http::request_failed, checks::failed]
    given
        str[] args
    asserts
        sample: [] => ok
    bytes::buffer payload = call bytes::empty()
    match call load_json()
        when
            sample:  => ok receipt(9007199254740993)
        http::request_failed
        ok receipt received => match call checks::require(received.count is 9007199254740993, "receipt count")
            checks::failed
            ok => match call load_envelope()
                when
                    sample:  => ok http::response<bytes::buffer>(418, [], payload)
                http::request_failed
                ok http::response<bytes::buffer> envelope => match call checks::require(envelope.status is 418, "envelope status")
                    checks::failed
                    ok => match call send_text("hello")
                        when
                            sample: "hello" => ok "hello"
                        http::request_failed
                        ok str text => match call checks::require(text is "hello", "text echo")
                            checks::failed
                            ok => match call send_json(receipt(9007199254740993))
                                when
                                    sample: receipt(9007199254740993) => ok receipt(9007199254740993)
                                http::request_failed
                                ok receipt sent => match call checks::require(sent.count is 9007199254740993, "sent count")
                                    checks::failed
                                    ok => match call send_bytes(payload)
                                        when
                                            sample: payload => ok payload
                                        http::request_failed
                                        ok bytes::buffer binary => do
                                            int[] binary_values = call bytes::to_ints(binary)
                                            int[] no_values = []
                                            match call checks::require(binary_values is no_values, "binary roundtrip")
                                                checks::failed
                                                ok => match call head_text()
                                                    when
                                                        sample:  => ok ""
                                                    http::request_failed
                                                    ok str head => match call checks::require(head is "", "head text")
                                                        checks::failed
                                                        ok => match call delete_text()
                                                            when
                                                                sample:  => ok "delete"
                                                            http::request_failed
                                                            ok str deleted => match call checks::require(deleted is "delete", "deleted text")
                                                                checks::failed
                                                                ok => match call options_text()
                                                                    when
                                                                        sample:  => ok "options"
                                                                    http::request_failed
                                                                    ok str options => match call checks::require(options is "options", "options text")
                                                                        checks::failed
                                                                        ok => ok
fn str referenced
    emits [http::request_failed]
    asserts
        sample: => ok "fixture"
    callable str (str) emits [http::request_failed] action = callable send_text
    match call action("value")
        when
            sample: "value" => ok "fixture"
        http::request_failed
        ok str output => ok output

fn str extract
    emits []
    given
        str[] values
    asserts
        first: ["value"] => ok "value"
    ok values[0]
fn receipt load_or_default
    emits [http::request_failed]
    asserts
        recovered: => ok receipt(0)
        status: => http::request_failed(http::status_error(429, []))
        timeout: => http::request_failed(http::timeout(5))
        transport: => http::request_failed(http::transport_failed("connect"))
        invalid: => http::request_failed(http::invalid_request("url"))
        credential: => http::request_failed(http::credentials_missing("TOKEN"))
        limit: => http::request_failed(http::body_limit(3))
        codec: => http::request_failed(codec::invalid_data("/0", "invalid_json"))
    match call load_json()
        when
            recovered: => http::request_failed(http::status_error(404, []))
            status: => http::request_failed(http::status_error(429, []))
            timeout: => http::request_failed(http::timeout(5))
            transport: => http::request_failed(http::transport_failed("connect"))
            invalid: => http::request_failed(http::invalid_request("url"))
            credential: => http::request_failed(http::credentials_missing("TOKEN"))
            limit: => http::request_failed(http::body_limit(3))
            codec: => http::request_failed(codec::invalid_data("/0", "invalid_json"))
        http::request_failed as failed => match failed.detail
            http::status_error => match status_error.status
                404 => ok receipt(0)
                _ => http::request_failed(failed.detail)
            _ => http::request_failed(failed.detail)
        ok receipt found => ok found
