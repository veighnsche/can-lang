package core
    provides [identity, refuse, denied]
    uses []
error denied(str reason)
fn item identity<item>
    emits []
    given
        item value
    asserts
        number: 3 => ok 3
    ok value
fn int refuse<item>
    emits [denied]
    given
        item value
    asserts
        sample: 1 => denied("no")
    denied("no")
