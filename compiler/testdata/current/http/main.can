package app
    provides []
    uses [http, bytes, codec, option, html, stream, files]
record item
    str name
    int count
record search_form
    str query
    str[] tags
    option::value<str> note
fn http::server_response handle
    emits []
    given
        http::request req
    asserts
        method: => ok
        missing: => ok
    match call http::request_method(req)
        when
            method: req => ok "GET"
            missing: req => ok "GET"
        ok str method => match call http::query_one(req, "q")
            when
                method: req, "q" => ok "v"
                missing: req, "q" => http::invalid_request("query_missing")
            http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "missing")
            ok str value => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), method)
fn http::server_response submit
    emits []
    given
        http::request req
    asserts
        created: => ok
        bad: => ok
    match call http::request_json<item>(req, 1024)
        when
            created: req, 1024 => ok item("a", 1)
            bad: req, 1024 => http::invalid_request("unsupported_media_type")
        http::body_limit => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        codec::invalid_data => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        ok item found => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), found.name)
fn bool json_ok
    emits [codec::invalid_data]
    asserts
        sample: => ok true
    match call http::response_json<item>(call http::status_ok(), call http::empty_server_headers(), item("a", 1))
        codec::invalid_data
        ok http::server_response response => ok true
fn http::server_response search
    emits []
    given
        http::request req
    asserts
        found: => ok
        incomplete: => ok
    match call http::request_form<search_form>(req, 2048)
        when
            found: req, 2048 => ok search_form("ann", ["x"], option::none())
            incomplete: req, 2048 => http::invalid_request("form_missing")
        http::body_limit => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        codec::invalid_data => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        ok search_form form => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), form.query)
fn http::server_response inspect
    emits [http::body_limit]
    given
        http::request req
    asserts
        path: => ok
    match call http::request_path(req)
        when
            path: req => ok "/a"
        ok str path => match call http::query_all(req, "x")
            when
                path: req, "x" => ok ["1", "2"]
            http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            ok str[] values => match call http::request_headers(req)
                when
                    path: req => ok [http::header("x-test", "1")]
                ok http::header[] headers => match call http::request_body(req, 64)
                    when
                        path: req, 64 => ok call bytes::empty()
                    http::body_limit
                    ok bytes::buffer content => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), path)
fn http::server_response tagged<mark>
    emits []
    given
        http::request req
        near mark tag
    asserts
        sample: "t" => ok
    ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), tag)
fn http::server_response upload
    emits []
    given
        http::request req
    asserts
        first: => ok
        ended: => ok
    match call http::request_body_stream(req, 4)
        when
            first: req, 4 => ok
            ended: req, 4 => ok
        http::body_limit => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        ok stream::reader<bytes::buffer> reader => match call stream::read_many(reader, 1)
            when
                first: reader, 1 => ok [call bytes::empty()]
                ended: reader, 1 => ok []
            stream::read_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            stream::cancelled => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            files::limit_exceeded => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            ok bytes::buffer[] chunks => match call stream::close_reader(reader)
                when
                    first: reader => ok
                    ended: reader => ok
                stream::close_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                ok => match chunks.length is 0
                    true => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), "empty")
                    false => match call bytes::to_utf8(chunks[0])
                        codec::invalid_data => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                        ok str head => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), head)
fn http::server_response stream_echo
    emits []
    given
        http::request req
    asserts
        sample: => ok
    match call http::request_body_stream(req, 64)
        when
            sample: req, 64 => ok
        http::body_limit => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        ok stream::reader<bytes::buffer> reader => match call stream::read_many(reader, 1)
            when
                sample: reader, 1 => ok [call bytes::empty()]
            stream::read_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            stream::cancelled => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            files::limit_exceeded => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            ok bytes::buffer[] chunks => match call stream::close_reader(reader)
                when
                    sample: reader => ok
                stream::close_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                ok => match call http::response_stream(call http::status_ok(), call http::empty_server_headers())
                    http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                    ok http::server_response pending => match call http::response_writer(pending)
                        when
                            sample: pending => ok
                        http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                        ok stream::writer out => match call stream::write_some(out, chunks[0])
                            when
                                sample: out, chunks[0] => ok 0
                            stream::write_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                            ok int accepted => match call stream::close_writer(out)
                                when
                                    sample: out => ok
                                stream::close_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                                ok => ok pending
fn http::server_response events
    emits []
    given
        http::request req
    asserts
        sample: => ok
    http::sse_event tick = http::sse_event("tick", "beat", "7", "")
    match call http::response_sse(call http::status_ok(), call http::empty_server_headers())
        http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        ok http::server_response pending => match call http::response_writer(pending)
            when
                sample: pending => ok
            http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
            ok stream::writer out => match call http::sse_send(out, tick)
                when
                    sample: out, tick => ok 30
                http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                http::body_limit => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                stream::write_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                ok int sent => match call http::sse_comment(out, "still here")
                    when
                        sample: out, "still here" => ok 14
                    http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                    http::body_limit => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                    stream::write_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                    ok int noted => match call stream::close_writer(out)
                        when
                            sample: out => ok
                        stream::close_failed => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
                        ok => ok pending
fn http::server_response attach
    emits []
    given
        http::request req
    asserts
        sample: => ok
    match call http::request_multipart(req, 1024)
        when
            sample: req, 1024 => ok http::multipart_form([http::multipart_field("n", "v")], [http::multipart_file("f", "a.txt", "text/plain", call bytes::empty())])
        http::body_limit => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        http::invalid_request => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        codec::invalid_data => ok call http::response_text(call http::status_unprocessable(), call http::empty_server_headers(), "bad")
        ok http::multipart_form form => match form.fields.length is 0
            true => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), "empty")
            false => match form.files.length is 0
                true => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), form.fields[0].value)
                false => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), form.fields[0].value + "|" + form.files[0].filename)
fn http::server_response wrapped
    emits []
    given
        http::request req
    asserts
        sample: => ok
    match call handle(req)
        when
            sample: req => ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), "GET")
        ok http::server_response response => ok response
fn bool responses
    emits [http::invalid_request, html::invalid_structure]
    asserts
        sample: => ok true
    match chain
        call http::make_status(304) as http::status cached
        call http::make_status(204) as http::status empty_status
        call http::make_body_status(201) as http::body_status created
        call http::status_internal() as http::body_status oops
        call http::status_unavailable() as http::body_status down
        call http::make_server_headers([http::header("x-a", "1")]) as http::server_headers headers
        call http::response_empty(empty_status, call http::empty_server_headers()) as http::server_response e
        call http::response_empty(cached, call http::empty_server_headers()) as http::server_response c
        call http::response_bytes(created, headers, call bytes::empty()) as http::server_response b
        call html::text("ok") as html::node node
        call html::fragment([node]) as html::safe page
        call http::response_html(oops, headers, page) as http::server_response h
        http::invalid_request
        html::invalid_structure
        ok => ok true
fn http::router mounted
    emits [http::invalid_route, http::duplicate_route, http::ambiguous_route]
    asserts
        sample: => ok
    str tag = "t"
    match chain
        call http::route_get("/a", callable handle) as http::route first
        call http::route_post("/b", callable submit) as http::route second
        call http::route_get("/g", callable tagged) as http::route generic
        call http::route_post("/w", callable wrapped) as http::route wrap
        call http::route_post("/s", callable search) as http::route form
        call http::route_put("/p", callable handle) as http::route put
        call http::route_patch("/p", callable handle) as http::route patch
        call http::route_delete("/d", callable handle) as http::route delete
        call http::route_options("/o", callable handle) as http::route options
        call http::route_head("/h", callable handle) as http::route head
        call http::route_post("/u", callable upload) as http::route raw_upload
        call http::route_stream(raw_upload) as http::route streamed
        call http::route_post("/echo", callable stream_echo) as http::route raw_echo
        call http::route_stream(raw_echo) as http::route echo
        call http::route_get("/events", callable events) as http::route feed
        call http::route_post("/attach", callable attach) as http::route upload_form
        call http::make_router([first, second, generic, wrap, form, put, patch, delete, options, head, streamed, echo, feed, upload_form]) as http::router router
        http::invalid_route
        http::duplicate_route
        http::ambiguous_route
        ok => ok router
fn void main
    emits [http::invalid_route, http::duplicate_route, http::ambiguous_route]
    given
        str[] args
    asserts
        sample: [] => ok
    match call mounted()
        http::invalid_route
        http::duplicate_route
        http::ambiguous_route
        ok http::router router => ok
