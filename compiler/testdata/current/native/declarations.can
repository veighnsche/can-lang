package app
    provides [weights, weighted, classifier]
    uses [ai, http, codec, llm]

connection classifier
    endpoint "http://127.0.0.1:1/systemone"
    auth bearer env "MUST_NOT_BE_READ_DURING_COMPILATION"
    timeout_ms 1000
    metadata
        protocol "typesafe_systemone_v1"
        model "jev-latest"

connection generator
    endpoint "http://127.0.0.1:1/responses"
    timeout_ms 1000
    metadata
        protocol "openai_responses_v1"
        model "fixture-model"

noul bool question from classifier
    emits [ai::invalid_question, ai::invalid_answer]
    given
        str description
    asks description
        true "Yes" => do
            float probability = %
            ok probability >= 0.5
        false "No" => ok false

judge bool assess from classifier
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data, ai::invalid_question, ai::invalid_answer]
    state
        str message
    call question("First") as bool first
    call question("Second") as bool second
    ok => ok first and second

record weights choice float weighted from classifier
    emits [ai::invalid_question, ai::invalid_answer]
    confidence as certainty
    asks "Choose"
        first "First" => ok % * certainty
        second "Second" => ok %

record arms
    choice_arm<float> emits [] left
    choice_arm<float> emits [] right

record variadic_weights choice float variadic_weighted from classifier
    emits [ai::invalid_question, ai::invalid_answer]
    given
        arms ...choices
    asks "Choose"
        ...choices[0]

fn str describe
    emits []
    given
        float value
    asserts
        sample: 0.5 => ok "Description"
    ok "Description"

llm str generate from generator
    emits [http::invalid_request, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data, llm::refused, llm::truncated, llm::invalid_response]
    state
        str message
    asks "Describe the message"

fetch str retrieve from classifier
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data]
    get "/resource"
    query
        q = ["one", "two"]

fn void main
    emits []
    given
        str[] arguments
    asserts
        empty: [] => ok
    ok
