package generation
    provides []
    uses [http, codec, llm, ai]
record item<value>
    str label
    value count
record plan
    item<int>[] choices
    bool ready
    float ratio
connection generator
    endpoint "http://127.0.0.1:1/responses"
    auth bearer env "CAN_I28_TOKEN"
    timeout_ms 5000
    max_body_bytes 65536
    metadata
        protocol "openai_responses_v1"
        model "fixture-model"
        max_output_tokens 512
connection classifier
    endpoint "http://127.0.0.1:1/systemone"
    auth bearer env "CAN_I28_TOKEN"
    timeout_ms 5000
    metadata
        protocol "typesafe_systemone_v1"
        model "jev-latest"
llm str describe from generator
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data, llm::refused, llm::truncated, llm::invalid_response]
    given
        str private_setting
    state
        int count
    asks "Describe"
llm plan generate from generator
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data, llm::refused, llm::truncated, llm::invalid_response]
    state
        str description
    asks "Plan"
choice str select from classifier
    emits [ai::invalid_question, ai::invalid_answer]
    given
        str description
    asks "Choose"
        first description => ok "chosen"
        second "Other" => ok "other"
judge str decide from classifier
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data, ai::invalid_question, ai::invalid_answer]
    state
        plan generated
    call select(generated.choices[0].label + " transformed") as str selected
    ok => ok selected
fn void main
    emits [http::invalid_request, http::credentials_missing, http::transport_failed, http::timeout, http::body_limit, http::status_error, codec::invalid_data, llm::refused, llm::truncated, llm::invalid_response, ai::invalid_question, ai::invalid_answer]
    given
        str[] args
    asserts
        sample: [] => ok
    match call describe("private-not-disclosed", (9007199254740993))
        when
            sample: "private-not-disclosed", (9007199254740993) => ok "description"
        http::invalid_request
        http::credentials_missing
        http::transport_failed
        http::timeout
        http::body_limit
        http::status_error
        codec::invalid_data
        llm::refused
        llm::truncated
        llm::invalid_response
        ok str description => match call generate((description))
            when
                sample: ("description") => ok plan([item<int>("First", 9007199254740993)], true, 0.5)
            http::invalid_request
            http::credentials_missing
            http::transport_failed
            http::timeout
            http::body_limit
            http::status_error
            codec::invalid_data
            llm::refused
            llm::truncated
            llm::invalid_response
            ok plan generated => match call decide((generated))
                when
                    sample: (plan([item<int>("First", 9007199254740993)], true, 0.5)) => ok "chosen"
                http::invalid_request
                http::credentials_missing
                http::transport_failed
                http::timeout
                http::body_limit
                http::status_error
                codec::invalid_data
                ai::invalid_question
                ai::invalid_answer
                ok str selected => match selected is "chosen" and generated.choices[0].count is 9007199254740993 and generated.ready and generated.ratio is 0.5
                    true => ok
                    false => do
                        int invalid = 1 / 0
                        ok
