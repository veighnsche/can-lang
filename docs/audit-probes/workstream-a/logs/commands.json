{
  "whole-stdlib": {
    "command": [
      "go",
      "run",
      "./compiler",
      "--out",
      "/tmp/can-workstream-a-stdlib",
      "std/ascii/ascii.can",
      "std/division/division.can",
      "std/host/host.can",
      "std/html/html.can",
      "std/json/json.can",
      "std/map/map.can",
      "std/quota/quota.can",
      "std/ratio/ratio.can",
      "std/scalars/scalars.can",
      "std/schema/schema.can",
      "std/seq/seq.can",
      "std/set/set.can",
      "std/text/text.can"
    ],
    "exit_code": 1,
    "log": "whole-stdlib.txt"
  },
  "fresh-json-can": {
    "command": [
      "go",
      "run",
      "./compiler",
      "--out",
      "/tmp/can-workstream-a-json",
      "std/json/json.can",
      "std/scalars/scalars.can"
    ],
    "exit_code": 0,
    "log": "fresh-json-can.txt"
  },
  "repository-ts": {
    "command": [
      "./tscheck/node_modules/.bin/tsc",
      "--noEmit",
      "-p",
      "tscheck/tsconfig.json"
    ],
    "exit_code": 1,
    "log": "repository-ts.txt"
  },
  "fresh-json-ts": {
    "command": [
      "./tscheck/node_modules/.bin/tsc",
      "--noEmit",
      "--strict",
      "--target",
      "ES2020",
      "--module",
      "ESNext",
      "--moduleResolution",
      "bundler",
      "/tmp/can-workstream-a-json/json.ts",
      "/tmp/can-workstream-a-json/scalars.ts"
    ],
    "exit_code": 1,
    "log": "fresh-json-ts.txt"
  }
}
