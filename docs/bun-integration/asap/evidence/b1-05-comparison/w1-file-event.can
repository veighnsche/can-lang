package w1_file_event
    provides [pump, scan_file, main]
    uses [bytes, codec, files, io, stream, text]

/// Grouped scan state: lines decoded, bytes observed, first matching id.
record scan_state
    int lines_seen
    int bytes_seen
    int found_id

/// One typed JSONL record. Full codec policy arrives with document formats.
record json_id
    int id

/// Pull loop over a shared line reader. Demand is explicit: one line per
/// read, and an empty batch is the normal end. Every terminal arm closes
/// the reader; failure arms close first and re-raise the primary error by
/// reconstruction, so cleanup never overwrites the original failure.
/// Stop granularity is one line; batch reads would widen it to one batch.
fn scan_state pump
    emits [stream::read_failed, stream::cancelled, stream::use_after_close, codec::invalid_data]
    given
        scan_state state
        stream::reader<str> input
    asserts
        end: scan_state(1, 8, -1) => ok scan_state(1, 8, -1)
        keep: scan_state(0, 0, -1) => ok scan_state(1, 8, -1)
        hit: scan_state(0, 0, -1) => ok scan_state(1, 9, 42)
        fail: scan_state(0, 0, -1) => stream::read_failed("disk")
        cancelled: scan_state(0, 0, -1) => stream::cancelled("deadline")
    match call stream::read_many<str>(input, 1)
        when
            end: input, 1 => ok []
            keep: input, 1 => ok ["{\"id\":7}"]
            keep: input, 1 => ok []
            hit: input, 1 => ok ["{\"id\":42}"]
            fail: input, 1 => stream::read_failed("disk")
            cancelled: input, 1 => stream::cancelled("deadline")
        stream::read_failed as cause => match call stream::close(input)
            when
                fail: input => ok
            stream::use_after_close
            ok => stream::read_failed(cause.detail)
        stream::cancelled as cause => match call stream::close(input)
            when
                cancelled: input => ok
            stream::use_after_close
            ok => stream::cancelled(cause.detail)
        stream::use_after_close
        ok str[] batch => match batch.length is 0
            true => match call stream::close(input)
                when
                    end: input => ok
                    keep: input => ok
                stream::use_after_close
                ok => ok state
            false => match chain
                call bytes::from_utf8(batch[0]) as bytes::buffer raw
                call codec::decode_json<json_id>(raw) as json_id found
                codec::invalid_data
                ok => match found.id is 42
                    true => match call stream::close(input)
                        when
                            hit: input => ok
                        stream::use_after_close
                        ok => ok scan_state(state.lines_seen + 1, state.bytes_seen + batch[0].length, found.id)
                    false => ok call pump(scan_state(state.lines_seen + 1, state.bytes_seen + batch[0].length, state.found_id), input)

/// Scan a JSONL file and stop after the predicate match. Acquisition uses
/// domain errors; the pull loop owns dispatch, state, backpressure demand,
/// early stop and cleanup with no hidden scheduling.
fn scan_state scan_file
    emits [files::not_found, files::denied, files::invalid_path, files::unexpected_kind, stream::read_failed, stream::cancelled, stream::use_after_close, codec::invalid_data]
    given
        str path
    asserts
        sample: "records.jsonl" => ok scan_state(3, 25, 42)
    match call files::read_lines_stream(path, files::read_options(65536))
        when
            sample: "records.jsonl", files::read_options(65536) => ok
        files::not_found
        files::denied
        files::invalid_path
        files::unexpected_kind
        ok stream::reader<str> input => ok call pump(scan_state(0, 0, -1), input)

/// Print the first matching record id.
fn void main
    emits [files::not_found, files::denied, files::invalid_path, files::unexpected_kind, stream::read_failed, stream::cancelled, stream::use_after_close, codec::invalid_data, io::write_failed]
    given
        str[] args
    asserts
        sample: ["records.jsonl"] => ok
    match call scan_file(args[0])
        files::not_found
        files::denied
        files::invalid_path
        files::unexpected_kind
        stream::read_failed
        stream::cancelled
        stream::use_after_close
        codec::invalid_data
        ok scan_state done => match chain
            call bytes::from_utf8(call text::from_int(done.found_id)) as bytes::buffer message
            codec::invalid_data
            ok => match call io::stdout_write(message)
                when
                    sample: message => ok 2
                io::write_failed
                ok int written => ok
