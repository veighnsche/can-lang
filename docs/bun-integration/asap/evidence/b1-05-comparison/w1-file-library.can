package w1_library
    provides [on_line, find_record, main]
    uses [bytes, codec, files, io, stream, text]

/// Grouped scan state: lines decoded, bytes observed, first matching id.
record scan_state
    int lines_seen
    int bytes_seen
    int found_id

/// One typed JSONL record. Full codec policy arrives with document formats.
record json_id
    int id

/// Per-line handler. The adapter awaits each handler before pulling the
/// next line, so a slow handler pauses native reads without buffering.
/// Handler failure (codec) stays distinguishable from external failure.
fn stream::decision<scan_state> on_line
    emits [codec::invalid_data]
    given
        scan_state state
        str line
    asserts
        keep: scan_state(2, 40, -1), "{\"id\":7}" => ok stream::continue<scan_state>(scan_state(3, 48, -1))
        hit: scan_state(2, 40, -1), "{\"id\":42}" => ok stream::stop<scan_state>(scan_state(3, 49, 42))
        bad: scan_state(0, 0, -1), "oops" => codec::invalid_data("", "syntax")
    match chain
        call bytes::from_utf8(line) as bytes::buffer raw
        call codec::decode_json<json_id>(raw) as json_id found
        codec::invalid_data
        ok => match found.id is 42
            false => ok stream::continue<scan_state>(scan_state(state.lines_seen + 1, state.bytes_seen + raw.length, state.found_id))
            true => ok stream::stop<scan_state>(scan_state(state.lines_seen + 1, state.bytes_seen + raw.length, found.id))

/// Scan a JSONL file and stop after the predicate match. Acquisition uses
/// domain errors; mid-stream failure, deadline and budget use stream errors.
/// Cleanup (close on end, stop, failure or cancel) is adapter-owned.
fn scan_state find_record
    emits [files::not_found, files::denied, files::invalid_path, files::unexpected_kind, stream::read_failed, stream::cancelled, stream::limit_exceeded, codec::invalid_data]
    given
        str path
    asserts
        sample: "records.jsonl" => ok scan_state(3, 25, 42)
    match call files::read_lines(path, files::scan_options(65536, 1000000, 30000))
        when
            sample: "records.jsonl", files::scan_options(65536, 1000000, 30000) => ok
        files::not_found
        files::denied
        files::invalid_path
        files::unexpected_kind
        ok stream::source<str> lines => match call stream::consume<str, scan_state>(lines, scan_state(0, 0, -1), stream::limits(1048576, 1000000, 30000), callable on_line)
            when
                sample: lines, scan_state(0, 0, -1), stream::limits(1048576, 1000000, 30000), callable on_line => ok scan_state(3, 25, 42)
            stream::read_failed
            stream::cancelled
            stream::limit_exceeded
            codec::invalid_data
            ok scan_state done => ok done

/// Print the first matching record id.
fn void main
    emits [files::not_found, files::denied, files::invalid_path, files::unexpected_kind, stream::read_failed, stream::cancelled, stream::limit_exceeded, codec::invalid_data, io::write_failed]
    given
        str[] args
    asserts
        sample: ["records.jsonl"] => ok
    match call find_record(args[0])
        files::not_found
        files::denied
        files::invalid_path
        files::unexpected_kind
        stream::read_failed
        stream::cancelled
        stream::limit_exceeded
        codec::invalid_data
        ok scan_state done => match chain
            call bytes::from_utf8(call text::from_int(done.found_id)) as bytes::buffer message
            codec::invalid_data
            ok => match call io::stdout_write(message)
                when
                    sample: message => ok 2
                io::write_failed
                ok int written => ok
