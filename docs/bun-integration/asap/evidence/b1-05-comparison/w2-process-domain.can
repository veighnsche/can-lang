package w2_process_domain
    provides [on_chunk, run_shout, main]
    uses [bytes, codec, io, process, text]

/// Grouped progress state: bytes per pipe and chunks observed.
record progress
    int out_bytes
    int err_bytes
    int chunks

/// One interleaved child-output chunk tagged by file descriptor.
record text_chunk
    int fd
    str text

/// Per-chunk handler. The decision type is process-owned, so this domain
/// never names a shared stream contract. Exit handling stays separate:
/// drain completion reports progress, and exit_of reports status.
fn process::drain_decision<progress> on_chunk
    emits [text::invalid_number]
    given
        progress state
        text_chunk chunk
    asserts
        keep: progress(2, 0, 1), text_chunk(1, "50") => ok process::carry<progress>(progress(4, 0, 2))
        done: progress(2, 0, 1), text_chunk(1, "100") => ok process::halt<progress>(progress(5, 0, 2))
        err: progress(2, 0, 1), text_chunk(2, "note") => ok process::carry<progress>(progress(2, 4, 2))
        bad: progress(0, 0, 0), text_chunk(1, "xx") => text::invalid_number("xx")
    match chunk.fd
        1 => match call text::to_int(chunk.text)
            text::invalid_number
            ok int percent => match percent is 100
                true => ok process::halt<progress>(progress(state.out_bytes + chunk.text.length, state.err_bytes, state.chunks + 1))
                false => ok process::carry<progress>(progress(state.out_bytes + chunk.text.length, state.err_bytes, state.chunks + 1))
        2 => ok process::carry<progress>(progress(state.out_bytes, state.err_bytes + chunk.text.length, state.chunks + 1))
        _ => ok process::carry<progress>(progress(state.out_bytes, state.err_bytes, state.chunks + 1))

/// Stream one child to completion. The deadline cancels the run and reaps
/// the child; the output budget reuses the existing output_limit error.
fn progress run_shout
    emits [process::spawn_failed, process::invalid_config, process::cancelled, process::output_limit, text::invalid_number, process::nonzero, process::io_error]
    given
        str word
    asserts
        sample: "ada" => ok progress(5, 4, 3)
    match call process::drain_output<progress>(["/bin/echo", "shout", word], process::drain_options(5000, 65536, 4096), progress(0, 0, 0), callable on_chunk)
        when
            sample: ["/bin/echo", "shout", word], process::drain_options(5000, 65536, 4096), progress(0, 0, 0), callable on_chunk => ok progress(5, 4, 3)
        process::spawn_failed
        process::invalid_config
        process::cancelled
        process::output_limit
        text::invalid_number
        ok progress done => match call process::exit_of()
            when
                sample: => ok process::exit(0, "")
            process::nonzero
            process::io_error
            ok process::exit status => ok done

/// Print the drained chunk count.
fn void main
    emits [process::spawn_failed, process::invalid_config, process::cancelled, process::output_limit, text::invalid_number, process::nonzero, process::io_error, codec::invalid_data, io::write_failed]
    given
        str[] args
    asserts
        sample: ["ada"] => ok
    match call run_shout(args[0])
        process::spawn_failed
        process::invalid_config
        process::cancelled
        process::output_limit
        text::invalid_number
        process::nonzero
        process::io_error
        ok progress done => match chain
            call bytes::from_utf8(call text::from_int(done.chunks)) as bytes::buffer message
            codec::invalid_data
            ok => match call io::stdout_write(message)
                when
                    sample: message => ok 1
                io::write_failed
                ok int written => ok
