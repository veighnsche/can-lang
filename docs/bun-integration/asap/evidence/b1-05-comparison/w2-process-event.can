package w2_process_event
    provides [pump, run_shout, main]
    uses [bytes, clock, codec, io, process, stream, text]

/// Grouped progress state: bytes per pipe and chunks observed.
record progress
    int out_bytes
    int err_bytes
    int chunks

/// One interleaved child-output chunk tagged by file descriptor.
record text_chunk
    int fd
    str text

/// Pull loop over multiplexed child output. Cancellation is cooperative:
/// the caller checks the remaining budget each round and cancels before
/// the next read. Exit status is read through the same explicit handle,
/// so no ambient terminal query is needed.
fn progress pump
    emits [stream::read_failed, stream::cancelled, stream::use_after_close, text::invalid_number, process::nonzero, process::io_error]
    given
        progress state
        int budget_ms
        stream::reader<text_chunk> input
    asserts
        end: progress(5, 0, 2), 4000 => ok progress(5, 0, 2)
        keep: progress(0, 0, 0), 4000 => ok progress(2, 4, 2)
        stop: progress(0, 0, 0), 4000 => ok progress(3, 0, 1)
        expired: progress(0, 0, 0), 0 => stream::cancelled("deadline")
        fail: progress(0, 0, 0), 4000 => stream::read_failed("pipe")
    match budget_ms < 1
        true => match call stream::cancel(input, "deadline")
            when
                expired: input, "deadline" => ok
            stream::use_after_close
            ok => stream::cancelled("deadline")
        false => match call stream::read_many<text_chunk>(input, 1)
            when
                end: input, 1 => ok []
                keep: input, 1 => ok [text_chunk(1, "50")]
                keep: input, 1 => ok [text_chunk(2, "note")]
                keep: input, 1 => ok []
                stop: input, 1 => ok [text_chunk(1, "100")]
                fail: input, 1 => stream::read_failed("pipe")
            stream::read_failed as cause => match call stream::close(input)
                when
                    fail: input => ok
                stream::use_after_close
                ok => stream::read_failed(cause.detail)
            stream::cancelled as cause => match call stream::close(input)
                stream::use_after_close
                ok => stream::cancelled(cause.detail)
            stream::use_after_close
            ok text_chunk[] batch => match batch.length is 0
                true => match call stream::close(input)
                    when
                        end: input => ok
                        keep: input => ok
                    stream::use_after_close
                    ok => match call process::exit_of(input)
                        when
                            end: input => ok process::exit(0, "")
                            keep: input => ok process::exit(0, "")
                        process::nonzero
                        process::io_error
                        ok process::exit status => ok state
                false => match batch[0].fd
                    1 => match call text::to_int(batch[0].text)
                        text::invalid_number
                        ok int percent => match percent is 100
                            true => match call stream::close(input)
                                when
                                    stop: input => ok
                                stream::use_after_close
                                ok => match call process::exit_of(input)
                                    when
                                        stop: input => ok process::exit(0, "")
                                    process::nonzero
                                    process::io_error
                                    ok process::exit status => ok progress(state.out_bytes + batch[0].text.length, state.err_bytes, state.chunks + 1)
                            false => ok call pump(progress(state.out_bytes + batch[0].text.length, state.err_bytes, state.chunks + 1), budget_ms - 1, input)
                    2 => ok call pump(progress(state.out_bytes, state.err_bytes + batch[0].text.length, state.chunks + 1), budget_ms - 1, input)
                    _ => ok call pump(progress(state.out_bytes, state.err_bytes, state.chunks + 1), budget_ms - 1, input)

/// Stream one child to completion. The monotonic clock seeds the cancel
/// budget once; the pull loop enforces it without further clock reads.
fn progress run_shout
    emits [process::spawn_failed, process::invalid_config, stream::read_failed, stream::cancelled, stream::use_after_close, text::invalid_number, process::nonzero, process::io_error]
    given
        str word
    asserts
        sample: "ada" => ok progress(5, 4, 3)
    match call process::spawn_text_streaming(["/bin/echo", "shout", word], process::stream_options(65536, 4096))
        when
            sample: ["/bin/echo", "shout", word], process::stream_options(65536, 4096) => ok
        process::spawn_failed
        process::invalid_config
        ok stream::reader<text_chunk> piped => match call clock::monotonic_millis()
            when
                sample: => ok 1000
            ok int started => ok call pump(progress(0, 0, 0), 6000 - started, piped)

/// Print the drained chunk count.
fn void main
    emits [process::spawn_failed, process::invalid_config, stream::read_failed, stream::cancelled, stream::use_after_close, text::invalid_number, process::nonzero, process::io_error, codec::invalid_data, io::write_failed]
    given
        str[] args
    asserts
        sample: ["ada"] => ok
    match call run_shout(args[0])
        process::spawn_failed
        process::invalid_config
        stream::cancelled
        stream::use_after_close
        stream::read_failed
        text::invalid_number
        process::nonzero
        process::io_error
        ok progress done => match chain
            call bytes::from_utf8(call text::from_int(done.chunks)) as bytes::buffer message
            codec::invalid_data
            ok => match call io::stdout_write(message)
                when
                    sample: message => ok 1
                io::write_failed
                ok int written => ok
