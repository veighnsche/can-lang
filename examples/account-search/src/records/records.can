package records
    provides [search_parameters, account_row, search_view, account_form, account_accepted, account_rejected, account_outcome]
    uses []

/// Parameters for the manifest search descriptor.
record search_parameters
    str term

/// One validated account row.
record account_row
    int id
    str display_name

/// Data passed to the safe fragment renderer.
record search_view
    int status
    account_row[] rows
    str message

/// The account validation form body.
record account_form
    str name
record account_accepted
    str name
record account_rejected
    str message
variant account_outcome
    account_accepted
    account_rejected
