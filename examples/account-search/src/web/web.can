package web
    provides [show_accounts, search_accounts, validate_account, dashboard_summary, search_routes, boot, main]
    uses [records, model, render, action, form, http, html, htmx, sql, clock, text, codec, bytes, io]

/// Serve the accounts page.
fn http::server_response show_accounts
    emits []
    given
        http::request req
    asserts
        sample: => ok
    match call render::page()
        html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        html::invalid_url => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        htmx::invalid_target => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        htmx::invalid_interval => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        ok html::safe document => ok call http::response_html(call http::status_ok(), call http::empty_server_headers(), document)

/// Answer one account search from the query string.
fn http::server_response search_accounts
    emits []
    given
        http::request req
        near sql::pool pool
    asserts
        missing: => ok
        blank: => ok
        found: => ok
        down: => ok
    callable records::account_row[] (str) emits [sql::unsupported_value, sql::connection_failed, sql::query_failed, sql::constraint_failed, sql::row_limit, sql::schema_mismatch] loader = callable model::pool_loader
    match call http::query_one(req, "query")
        when
            missing: req, "query" => http::invalid_request("query_missing")
            blank: req, "query" => ok ""
            found: req, "query" => ok "ann"
            down: req, "query" => ok "ann"
        http::invalid_request => match call render::feedback("Enter a search term.")
            html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
            ok html::safe fragment => ok call http::response_html(call http::status_unprocessable(), call http::empty_server_headers(), fragment)

        ok str query => match query is ""
            false => match call model::search_accounts_model(query, loader)
                when
                    found: "ann", loader => ok records::search_view(200, [records::account_row(7, "Ann")], "")
                    down: "ann", loader => ok records::search_view(503, [], "Temporarily unavailable.")
                ok records::search_view view => match view.status
                    200 => match call render::results_list(view.rows)
                        html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
                        ok html::safe fragment => ok call http::response_html(call http::status_ok(), call http::empty_server_headers(), fragment)
                    503 => match call render::feedback(view.message)
                        html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
                        ok html::safe fragment => ok call http::response_html(call http::status_unavailable(), call http::empty_server_headers(), fragment)
                    _ => match call render::feedback(view.message)
                        html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
                        ok html::safe fragment => ok call http::response_html(call http::status_internal(), call http::empty_server_headers(), fragment)
            true => match call render::feedback("Enter a search term.")
                html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
                ok html::safe fragment => ok call http::response_html(call http::status_unprocessable(), call http::empty_server_headers(), fragment)
/// Validate one account name submission: the checked HTML policy admits the
/// 422 feedback swap for blank names.
action account_validation
    post "/accounts/validate"
    form records::account_form limit 2048
    returns records::account_outcome
    body html
    cases
        records::account_accepted status 200 swap inner
        records::account_rejected status 422 swap inner

/// Validate one submitted account name.
fn records::account_outcome validate_account
    emits []
    given
        http::request req
        records::account_form form
    asserts
        blank: records::account_form("") => ok records::account_rejected("Name is required.")
        named: records::account_form("Ann") => ok records::account_accepted("Ann")
    match form.name is ""
        false => ok records::account_accepted(form.name)
        true => ok records::account_rejected("Name is required.")

/// Render one account outcome as the swapped validation fragment.
fn html::safe render_account_outcome
    emits []
    given
        records::account_outcome outcome
    asserts
        accepted: records::account_accepted("Ann") => ok
        rejected: records::account_rejected("Name is required.") => ok
    match outcome
        records::account_accepted => match call render::feedback(outcome.name)
            html::invalid_structure => ok call html::text_fragment("account accepted")
            ok html::safe fragment => ok fragment
        records::account_rejected => match call render::feedback(outcome.message)
            html::invalid_structure => ok call html::text_fragment("account rejected")
            ok html::safe fragment => ok fragment

/// Render one structurally rejected account form as guidance.
fn html::safe render_account_rejected
    emits []
    given
        form::rejected<records::account_form> bad
    asserts
        sample: form::rejected<records::account_form>([form::raw_entry("name", "")], [form::issue("name", "form_missing")]) => ok
    match call render::feedback("Name is required.")
        html::invalid_structure => ok call html::text_fragment("account rejected")
        ok html::safe fragment => ok fragment
/// Summarize the dashboard clock reading.
fn http::server_response dashboard_summary
    emits []
    given
        http::request req
    asserts
        sample: => ok
    match call clock::wall_millis()
        when
            sample: => ok 1000
        ok int millis => match call text::from_int(millis)
            ok str label => match call render::feedback(label)
                html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
                ok html::safe fragment => ok call http::response_html(call http::status_ok(), call http::empty_server_headers(), fragment)

/// Mount the four account callbacks, capturing the open pool.
fn http::router search_routes
    emits [http::invalid_route, http::duplicate_route, http::ambiguous_route]
    given
        near sql::pool pool
    asserts
        sample: => ok
    match chain
        call http::route_get("/accounts", callable show_accounts) as http::route home
        call http::route_get("/accounts/search", callable search_accounts) as http::route search
        call action::mount(account_validation, callable validate_account, callable render_account_outcome, callable render_account_rejected) as http::route submit
        call http::route_get("/dashboard/summary", callable dashboard_summary) as http::route summary
        call http::make_router([home, search, submit, summary]) as http::router built
        http::invalid_route
        http::duplicate_route
        http::ambiguous_route
        ok => ok built

/// Open the pool and start the account server on one port.
fn http::server boot
    emits [http::credentials_missing, sql::connection_failed, http::invalid_server_config, http::invalid_route, http::duplicate_route, http::ambiguous_route, http::bind_failed]
    given
        int port
    asserts
        sample: 0 => ok
    match call sql::pool_open("ACCOUNTS_DB", 5)
        when
            sample: "ACCOUNTS_DB", 5 => ok
        http::credentials_missing
        sql::connection_failed
        ok sql::pool pool => match call http::make_server_config("127.0.0.1", port, 65536, 5000)
            http::invalid_server_config
            ok http::server_config config => match call search_routes(pool)
                http::invalid_route
                http::duplicate_route
                http::ambiguous_route
                ok http::router built => match call http::server_start(config, built)
                    when
                        sample: config, built => ok
                    http::bind_failed
                    ok http::server sturdy => ok sturdy

/// Serve accounts until a shutdown signal, then close the pool.
fn void main
    emits [codec::invalid_data, io::write_failed, http::credentials_missing, sql::connection_failed, sql::close_failed, http::invalid_server_config, http::invalid_route, http::duplicate_route, http::ambiguous_route, http::bind_failed, http::shutdown_failed]
    given
        str[] args
    asserts
        empty: [] => ok
        serve: ["18484"] => ok
    match args.length is 0
        false => match call bytes::from_utf8(args[0])
            codec::invalid_data
            ok bytes::buffer raw => match call codec::decode_json<int>(raw)
                codec::invalid_data
                ok int port => match call sql::pool_open("ACCOUNTS_DB", 5)
                    when
                        serve: "ACCOUNTS_DB", 5 => ok
                    http::credentials_missing
                    sql::connection_failed
                    ok sql::pool pool => match call http::make_server_config("127.0.0.1", port, 65536, 5000)
                        http::invalid_server_config
                        ok http::server_config config => match call search_routes(pool)
                            http::invalid_route
                            http::duplicate_route
                            http::ambiguous_route
                            ok http::router built => match call http::server_start(config, built)
                                when
                                    serve: config, built => ok
                                http::bind_failed
                                ok http::server sturdy => match call http::server_wait(sturdy)
                                    when
                                        serve: sturdy => ok
                                    http::shutdown_failed
                                    ok => match call sql::pool_close(pool, 1000)
                                        when
                                            serve: pool, 1000 => ok
                                        sql::close_failed
                                        ok => ok
        true => match call bytes::from_utf8("usage: account-search <port>")
            codec::invalid_data
            ok bytes::buffer message => match call io::stdout_write(message)
                when
                    empty: message => ok 0
                io::write_failed
                ok int written => ok
