package model
    provides [read_recent, recent_count, account_total, down, ready]
    uses [records, sql]
scenario down
scenario ready

/// Read recent accounts once through the captured pool. Each outcome
/// row is queued twice so the redundant race below supplies both of its
/// identical branches.
fn records::account_row[] read_recent
    emits [sql::unsupported_value, sql::connection_failed, sql::query_failed, sql::constraint_failed, sql::row_limit, sql::schema_mismatch]
    given
        near sql::pool pool
    asserts
        unit: => ok [records::account_row(1, "Ann"), records::account_row(2, "Bo")]
    match call sql::query_rows<records::search_parameters, records::account_row>(pool, "recent_accounts", records::search_parameters("%"), 25)
        when
            unit: pool, "recent_accounts", records::search_parameters("%"), 25 => ok [records::account_row(1, "Ann"), records::account_row(2, "Bo")]
            sample: pool, "recent_accounts", records::search_parameters("%"), 25 => ok [records::account_row(1, "Ann"), records::account_row(2, "Bo")]
            sample: pool, "recent_accounts", records::search_parameters("%"), 25 => ok [records::account_row(1, "Ann"), records::account_row(2, "Bo")]
            scenario down: pool, "recent_accounts", records::search_parameters("%"), 25 => sql::connection_failed("recent_accounts")
            scenario down: pool, "recent_accounts", records::search_parameters("%"), 25 => sql::connection_failed("recent_accounts")
            scenario ready: pool, "recent_accounts", records::search_parameters("%"), 25 => ok [records::account_row(1, "Ann"), records::account_row(2, "Bo")]
            scenario ready: pool, "recent_accounts", records::search_parameters("%"), 25 => ok [records::account_row(1, "Ann"), records::account_row(2, "Bo")]
        sql::unsupported_value
        sql::connection_failed
        sql::query_failed
        sql::constraint_failed
        sql::row_limit
        sql::schema_mismatch
        ok records::account_row[] rows => ok rows

/// Count recent accounts, racing two identical reads through the pool.
/// The first success wins with the same rows either way; only all_failed,
/// when both branches fail, maps the count to unknown.
fn records::count_value recent_count
    emits []
    given
        near sql::pool pool
    asserts
        sample: => ok records::count_value(2, true)
        down: => ok records::count_value(0, false) link down
    records::count_value count = match call race
        read_recent(pool)
        read_recent(pool)
        all_failed => ok records::count_value(0, false)
        ok records::account_row[] won => ok records::count_value(won.length, true)
    ok count

/// Read the account total through the captured pool.
fn records::count_value account_total
    emits []
    given
        near sql::pool pool
    asserts
        sample: => ok records::count_value(2, true)
        down: => ok records::count_value(0, false) link down
    match call sql::query_one<records::count_params, records::total_row>(pool, "account_total", records::count_params(0))
        when
            sample: pool, "account_total", records::count_params(0) => ok records::total_row(2)
            scenario down: pool, "account_total", records::count_params(0) => sql::query_failed("account_total", "08006")
            scenario ready: pool, "account_total", records::count_params(0) => ok records::total_row(2)
        sql::unsupported_value => ok records::count_value(0, false)
        sql::connection_failed => ok records::count_value(0, false)
        sql::query_failed => ok records::count_value(0, false)
        sql::constraint_failed => ok records::count_value(0, false)
        sql::row_missing => ok records::count_value(0, false)
        sql::row_count => ok records::count_value(0, false)
        sql::schema_mismatch => ok records::count_value(0, false)
        ok records::total_row row => ok records::count_value(row.total, true)
