package records
    provides [signup_form, signup_view, signup_accepted, signup_rejected, signup_outcome]
    uses [option]

/// The signup form body: one name, repeated tags, an optional note.
record signup_form
    str name
    str[] tags
    option::value<str> note

/// Validated signup data passed to the renderer.
record signup_view
    int status
    str name
    int tag_count
    str message
record signup_accepted
    signup_view view
record signup_rejected
    str message
variant signup_outcome
    signup_accepted
    signup_rejected
