package web
    provides [show_signup, validate_signup, signup_routes, boot, main]
    uses [records, model, render, action, form, http, html, htmx, codec, bytes, io, option]

/// Serve the signup page.
fn http::server_response show_signup
    emits []
    given
        http::request req
    asserts
        sample: => ok
    match call render::page()
        html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        html::invalid_url => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        htmx::invalid_target => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        ok html::safe document => ok call http::response_html(call http::status_ok(), call http::empty_server_headers(), document)

/// Validate one signup submission: the checked HTML policy admits the 422
/// feedback swap for blank names.
action signup_validation
    post "/signup/validate"
    form records::signup_form limit 2048
    returns records::signup_outcome
    body html
    cases
        records::signup_accepted status 200 swap inner
        records::signup_rejected status 422 swap inner

/// Validate one submitted signup against the shared model.
fn records::signup_outcome validate_signup
    emits []
    given
        http::request req
        records::signup_form form
    asserts
        blank: records::signup_form("", [], option::none()) => ok records::signup_rejected("Name is required.")
        named: records::signup_form("Ann", ["a", "b"], option::some("hi")) => ok records::signup_accepted(records::signup_view(200, "Ann", 2, ""))
    match call model::validate_signup(form)
        ok records::signup_view view => match view.status
            200 => ok records::signup_accepted(view)
            _ => ok records::signup_rejected(view.message)

/// Render one signup outcome as the swapped results fragment.
fn html::safe render_signup_outcome
    emits []
    given
        records::signup_outcome outcome
    asserts
        accepted: records::signup_accepted(records::signup_view(200, "Ann", 2, "")) => ok
        rejected: records::signup_rejected("Name is required.") => ok
    match outcome
        records::signup_accepted => match call render::signup_result(outcome.view)
            html::invalid_structure => ok call html::text_fragment("signup accepted")
            ok html::safe fragment => ok fragment
        records::signup_rejected => match call render::feedback(outcome.message)
            html::invalid_structure => ok call html::text_fragment("signup rejected")
            ok html::safe fragment => ok fragment

/// Render one structurally rejected signup form as guidance.
fn html::safe render_signup_rejected
    emits []
    given
        form::rejected<records::signup_form> bad
    asserts
        sample: form::rejected<records::signup_form>([form::raw_entry("name", "")], [form::issue("name", "form_missing")]) => ok
    match call render::feedback("Name is required.")
        html::invalid_structure => ok call html::text_fragment("signup rejected")
        ok html::safe fragment => ok fragment
/// Mount the signup callbacks.
fn http::router signup_routes
    emits [http::invalid_route, http::duplicate_route, http::ambiguous_route]
    asserts
        sample: => ok
    match chain
        call http::route_get("/signup", callable show_signup) as http::route home
        call action::mount(signup_validation, callable validate_signup, callable render_signup_outcome, callable render_signup_rejected) as http::route submit
        call http::make_router([home, submit]) as http::router built
        http::invalid_route
        http::duplicate_route
        http::ambiguous_route
        ok => ok built

/// Start the signup server on one port.
fn http::server boot
    emits [http::invalid_server_config, http::invalid_route, http::duplicate_route, http::ambiguous_route, http::bind_failed]
    given
        int port
    asserts
        sample: 0 => ok
    match call http::make_server_config("127.0.0.1", port, 65536, 5000)
        http::invalid_server_config
        ok http::server_config config => match call signup_routes()
            http::invalid_route
            http::duplicate_route
            http::ambiguous_route
            ok http::router built => match call http::server_start(config, built)
                when
                    sample: config, built => ok
                http::bind_failed
                ok http::server sturdy => ok sturdy

/// Serve signups until a shutdown signal.
fn void main
    emits [codec::invalid_data, io::write_failed, http::invalid_server_config, http::invalid_route, http::duplicate_route, http::ambiguous_route, http::bind_failed, http::shutdown_failed]
    given
        str[] args
    asserts
        empty: [] => ok
        serve: ["18485"] => ok
    match args.length is 0
        false => match call bytes::from_utf8(args[0])
            codec::invalid_data
            ok bytes::buffer raw => match call codec::decode_json<int>(raw)
                codec::invalid_data
                ok int port => match call http::make_server_config("127.0.0.1", port, 65536, 5000)
                    http::invalid_server_config
                    ok http::server_config config => match call signup_routes()
                        http::invalid_route
                        http::duplicate_route
                        http::ambiguous_route
                        ok http::router built => match call http::server_start(config, built)
                            when
                                serve: config, built => ok
                            http::bind_failed
                            ok http::server sturdy => match call http::server_wait(sturdy)
                                when
                                    serve: sturdy => ok
                                http::shutdown_failed
                                ok => ok
        true => match call bytes::from_utf8("usage: form-validation <port>")
            codec::invalid_data
            ok bytes::buffer message => match call io::stdout_write(message)
                when
                    empty: message => ok 0
                io::write_failed
                ok int written => ok
