            ok str notice => match call model::with_notice(snap.value, notice)
                ok records::panel next => match call browser::replace_state(cell, snap.version, next)
                    browser::disposed => ok
                    browser::stale_version => ok
                    ok int version => match call render_replace(app, left_view, left_cell, right_view, right_cell, view)
                        ok => ok

/// Mirror press: fold the left panel notice into the right panel,
/// then re-render on success. A closed left panel mirrors nothing.
fn void on_mirror_click
    emits []
    given
        browser::event e
        near browser::app app
        near browser::view view
        near browser::view left_view
        near browser::state<records::panel> left_cell
        near browser::view right_view
        near browser::state<records::panel> right_cell
    asserts
        sample: browser::event("click", "mirror", "", "") => ok
    match call mirror_notice(left_cell, right_cell)
        ok option::value<records::panel> done => match done
            option::some => match call render_replace(app, left_view, left_cell, right_view, right_cell, view)
                ok => ok
            option::none => ok

/// Drop-left press: dispose the left state view, then re-render
/// right-only. The right instance keeps its own cell and view and
/// is unaffected.
fn void on_dispose_left
    emits []
    given
        browser::event e
        near browser::app app
        near browser::view view
        near browser::view left_view
        near browser::state<records::panel> left_cell
        near browser::view right_view
        near browser::state<records::panel> right_cell
    asserts
        sample: browser::event("click", "drop-left", "", "") => ok
    match call browser::dispose_view(left_view)
        ok => match call render_replace(app, left_view, left_cell, right_view, right_cell, view)
            ok => ok

/// Boot both panels: mount the host root, open one state view per
/// instance, mint both cells from seeds, then render. A failed
/// mount or view disposes the app; nothing renders half-built.
fn void boot
    emits []
    asserts
        ready:  => ok
    match call browser::mount("invoice-compare")
        browser::missing_root => ok
        ok browser::app app => match call browser::open_view(app)
            browser::disposed => match call browser::dispose_app(app)
                ok => ok
            ok browser::view left_view => match call browser::create_state<records::panel>(left_view, call model::seed_panel("left"))
                browser::disposed => match call browser::dispose_app(app)
                    ok => ok
                ok browser::state<records::panel> left_cell => match call browser::open_view(app)
                    browser::disposed => match call browser::dispose_app(app)
                        ok => ok
                    ok browser::view right_view => match call browser::create_state<records::panel>(right_view, call model::seed_panel("right"))
                        browser::disposed => match call browser::dispose_app(app)
                            ok => ok
                        ok browser::state<records::panel> right_cell => match call render_fresh(app, left_view, left_cell, right_view, right_cell)
                            ok => ok

/// Compare entry: the compiler-owned zero-argument main runs once
/// after DOM readiness and boots both seeded panels.
fn void main
    emits []
    asserts
        ready:  => ok
    match call boot()
        ok => ok
