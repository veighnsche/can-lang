        same: records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), ""), "k1", "1.00" => ok records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), "")
