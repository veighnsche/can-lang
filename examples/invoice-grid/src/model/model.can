            false => match call marked_unsaved(call with_current(state, next))
                ok records::grid_state marked => ok marked
            true => ok state

/// Append one blank line and move focus to its id field.
fn records::grid_state line_added
    emits []
    given
        records::grid_state state
    asserts
        sample: records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), "") => ok records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true), records::draft_line("k2", "", "1", "0.00", 1, 0, true)], 1), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::unsaved_state("unsaved changes"), "id:k2")
    match call free_key(state.current.lines, 1)
        ok str key => match call marked_unsaved(call with_current(state, call added_line(state.current)))
            ok records::grid_state marked => match call refocused(marked, "id:" + key)
                ok records::grid_state moved => ok moved

/// Drop one line and move focus to the add-line button. Unknown
/// keys pass the state through untouched.
fn records::grid_state line_removed
    emits []
    given
        records::grid_state state
        str key
    asserts
        hit: records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true), records::draft_line("k2", "b", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), ""), "k1" => ok records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k2", "b", "1", "1.00", 1, 100, true)], 1), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::unsaved_state("unsaved changes"), "add")
        miss: records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), ""), "k9" => ok records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), "")
    match call removed_line(state.current, key)
        ok records::draft next => match next.edit_seq is state.current.edit_seq
            false => match call marked_unsaved(call with_current(state, next))
                ok records::grid_state marked => match call refocused(marked, "add")
                    ok records::grid_state moved => ok moved
            true => ok state

/// Move one line up (0) or down (1) and keep focus on the moved
/// button. Edges, unknown keys and other directions pass the
/// state through untouched.
fn records::grid_state line_moved
    emits []
    given
        records::grid_state state
        str key
        int dir
    asserts
        up: records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true), records::draft_line("k2", "b", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), ""), "k2", 0 => ok records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k2", "b", "1", "1.00", 1, 100, true), records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 1), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::unsaved_state("unsaved changes"), "up:k2")
        down: records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true), records::draft_line("k2", "b", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), ""), "k1", 1 => ok records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k2", "b", "1", "1.00", 1, 100, true), records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 1), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::unsaved_state("unsaved changes"), "down:k1")
        edge: records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), ""), "k1", 0 => ok records::grid_state(contract::invoice_key(1, 7), records::draft("1", [records::draft_line("k1", "a", "1", "1.00", 1, 100, true)], 0), 0, 0, contract::grid_edit_input("", "", []), 0, contract::grid_snapshot("1", [], 0), records::clean_state("loaded revision 1"), "")
    match call moved_line(state.current, key, dir)
        ok records::draft next => match next.edit_seq is state.current.edit_seq
            false => match dir is 0
                false => match call marked_unsaved(call with_current(state, next))
                    ok records::grid_state marked => match call refocused(marked, "down:" + key)
                        ok records::grid_state moved => ok moved
                true => match call marked_unsaved(call with_current(state, next))
                    ok records::grid_state marked => match call refocused(marked, "up:" + key)
                        ok records::grid_state moved => ok moved
            true => ok state

/// Resolve one row focus intent against one stable row key: the
/// control name ("id", "qty", "price", "up", "down" or "del") when
/// the intent names this row's control, else "". Chrome intents
/// ("save", "status", ...) never match a row.
fn str row_focus_control
    emits []
    given
        str focus
        str row
    asserts
        id: "id:k1", "k1" => ok "id"
        qty: "qty:k1", "k1" => ok "qty"
        price: "price:k1", "k1" => ok "price"
        up: "up:k1", "k1" => ok "up"
        down: "down:k1", "k1" => ok "down"
        del: "del:k1", "k1" => ok "del"
        other_row: "qty:k2", "k1" => ok ""
        chrome: "save", "k1" => ok ""
        empty: "", "k1" => ok ""
    match focus is "id:" + row
        false => match focus is "qty:" + row
            false => match focus is "price:" + row
                false => match focus is "up:" + row
                    false => match focus is "down:" + row
                        false => match focus is "del:" + row
                            false => ok ""
                            true => ok "del"
                        true => ok "down"
                    true => ok "up"
                true => ok "price"
            true => ok "qty"
        true => ok "id"
