package records
    provides [draft_line, draft, clean_state, unsaved_state, saving_state, failed_state, uncertain_state, denied_state, conflict_state, grid_status, grid_state]
    uses [billing::invoice_contract as contract]

/// One grid draft line. The raw edited id, quantity and price texts
/// stay beside the last parsed count and minor-unit price so an
/// unparsable edit keeps its text on screen while blocking the save
/// with a bad-quantity/bad-price notice; only parsed lines feed the
/// exact totals and the wire projection.
record draft_line
    str key
    str id
    str quantity
    str price
    int qty
    int price_minor
    bool valid
/// The editable draft. The base revision is the server revision the
/// draft was read from; the edit sequence counts local edits and lets
/// the grid tell a same-content replay from a new intent.
record draft
    str base_revision
    draft_line[] lines
    int edit_seq
/// Draft matches the server base: the notice names the revision.
record clean_state
    str notice
/// Local edits not yet saved.
record unsaved_state
    str notice
/// A request is in flight; the draft stays editable underneath.
record saving_state
    str notice
/// A finished failure that kept the draft: the notice carries the
/// reason and the next step (edit, reread or retry). Blocked presses
/// persist here too, so the feedback survives re-render.
record failed_state
    str notice
/// The save may or may not have committed (busy store, lost
/// response, undecodable answer). The draft is kept and the
/// identical operation id stays available for explicit replay.
record uncertain_state
    str notice
/// Access denied: foreign, nonexistent and unauthenticated targets
/// share one notice that discloses nothing. The in-view draft stays.
record denied_state
    str notice
/// The server moved under local edits. The held server snapshot waits
/// for an explicit choice: adopt it or keep editing. Nothing is
/// applied automatically, so newer edits are never clobbered.
record conflict_state
    str notice
    contract::grid_snapshot server
/// The seven grid statuses. Every leaf carries its own status-line
/// notice so rendering is a pure function of state.
variant grid_status
    clean_state
    unsaved_state
    saving_state
    failed_state
    uncertain_state
    denied_state
    conflict_state
/// The whole grid cell value: pure data, no browser handles. The key
/// names the invoice; the attempt counts every issued request; the
/// flight names the outstanding one (0 none, 1 save, 2 load) so late
/// or reordered outcomes are ignored instead of clobbering newer
/// state. The submitted input is the attempt-owned pending draft with
/// its operation id; the submit sequence tells same-content replays
/// from new intents. The acknowledged snapshot is the last
/// server-confirmed state, distinct from the editable current draft.
/// The focus intent names where the next render puts keyboard focus:
/// "", "status", "save", "reread", "replay", "add", "adopt",
/// "keep", "id:<key>", "qty:<key>", "price:<key>", "up:<key>",
/// "down:<key>" or "del:<key>". The status notice feeds the one
/// live region.
record grid_state
    contract::invoice_key key
    draft current
    int attempt
    int flight
    contract::grid_edit_input submitted
    int submit_seq
    contract::grid_snapshot acknowledged
    grid_status status
    str focus
