/// Quantity-text edit on one keyed row: folds the text (valid
/// or not) and refreshes the status line and the exact totals
/// in place.
fn void on_qty_input
    emits []
    given
        browser::event e
        near browser::state<records::grid_state> cell
        near str row
        near browser::node status_line
        near browser::node totals_line
    asserts
        sample: browser::event("input", "qty:k1", "4", ""), "k1" => ok
    match call browser::read_state(cell)
        browser::disposed => ok
        ok browser::snapshot<records::grid_state> snap => match call model::qty_edited(snap.value, row, e.value)
            ok records::grid_state next => match call browser::replace_state(cell, snap.version, next)
                browser::disposed => ok
                browser::stale_version => ok
                ok int version => match call model::status_notice(next.status)
                    ok str notice => match call browser::set_text(status_line, notice)
                        browser::disposed => ok
                        ok => match call model::totals_text(next.current)
                            ok str totals => match call browser::set_text(totals_line, totals)
                                browser::disposed => ok
                                ok => ok

/// Field key handling: Enter runs the same guarded save press
/// as the save button, then re-renders. Other keys do nothing:
/// tab order follows the document, and arrow navigation stays
/// out because sibling handles cannot cross row scopes.
fn void on_field_key
    emits []
    given
        browser::event e
        near browser::state<records::grid_state> cell
        near browser::app app
        near browser::view view
        near browser::node status_line
    asserts
        enter: browser::event("keydown", "qty:k1", "4", "Enter") => ok
        other: browser::event("keydown", "qty:k1", "4", "Tab") => ok
    match e.key is "Enter"
        false => ok
        true => match call send_save(cell, status_line)
            ok option::value<records::grid_state> done => match done
                option::some => match call render_replace(app, cell, view)
                    ok => ok
                option::none => ok

