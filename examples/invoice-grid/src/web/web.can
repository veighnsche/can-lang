/// Save press: run the guarded identified save, then re-render
/// on every state the press returns.
fn void on_save_click
    emits []
    given
        browser::event e
        near browser::state<records::grid_state> cell
        near browser::node status_line
        near browser::app app
        near browser::view view
    asserts
        sample: browser::event("click", "save", "", "") => ok
    match call send_save(cell, status_line)
        ok option::value<records::grid_state> done => match done
            option::some => match call render_replace(app, cell, view)
                ok => ok
            option::none => ok

/// Reread press: run the typed authorized GET, then re-render.
/// Changed rows hold for an explicit choice instead of
/// clobbering newer edits.
fn void on_reread_click
    emits []
    given
        browser::event e
        near browser::state<records::grid_state> cell
        near browser::app app
        near browser::view view
    asserts
        sample: browser::event("click", "reread", "", "") => ok
    match call load_pressed(cell)
        ok option::value<records::grid_state> done => match done
            option::some => match call render_replace(app, cell, view)
                ok => ok
            option::none => ok

/// Explicit identical-id replay: only available while the last
/// save is uncertain with unchanged content, in which case the
/// guard recomputes the identical operation id and the press
/// replays it.
fn void on_replay_click
    emits []
    given
        browser::event e
        near browser::state<records::grid_state> cell
        near browser::app app
        near browser::view view
        near browser::node status_line
    asserts
        sample: browser::event("click", "replay", "", "") => ok
    match call browser::read_state(cell)
        browser::disposed => ok
        ok browser::snapshot<records::grid_state> snap => match call model::replay_ready(snap.value)
            ok bool ready => match ready
                false => ok
                true => match call send_save(cell, status_line)
                    ok option::value<records::grid_state> done => match done
                        option::some => match call render_replace(app, cell, view)
                            ok => ok
                        option::none => ok

