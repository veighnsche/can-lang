            ok records::grid_state next => match call browser::replace_state(cell, snap.version, next)
                browser::disposed => ok
                browser::stale_version => ok
                ok int version => match call render_replace(app, cell, view)
                    ok => ok

/// Boot one grid: mount the host root, open the state view, mint
/// the boot cell, load the authorized invoice, then render. The
/// load runs before the first render so boot never needs a
/// render view handle it cannot hold. The draft lives in the
/// view cell only: reloads restart from the server, and the grid
/// promises no queue — one flight at a time, explicit presses.
fn void boot
    emits []
    given
        str invoice_id
    asserts
        sample: "inv-1" => ok
    match call browser::mount("invoice-grid")
        browser::missing_root => ok
        ok browser::app app => match call browser::open_view(app)
            browser::disposed => match call browser::dispose_app(app)
                ok => ok
            ok browser::view state_view => match call browser::create_state<records::grid_state>(state_view, call model::boot_state(invoice_id))
                browser::disposed => match call browser::dispose_app(app)
                    ok => ok
                ok browser::state<records::grid_state> cell => match call load_pressed(cell)
                    ok option::value<records::grid_state> done => match call render_fresh(app, cell)
                        ok => ok

/// Grid entry: the host page calls the browser main with the
/// invoice id as its first argument.
fn void main
    emits []
    given
        str[] args
    asserts
        empty: [] => ok
        invoice: ["inv-1"] => ok
    match args.length is 0
        false => match call boot(args[0])
            ok => ok
        true => ok
