package records
    provides [session_row, session_key, membership_row, membership_key, invoice_row, invoice_key, invoice_update, line_row, lines_key, line_insert, replay_row, replay_key, replay_insert, replay_expire, replay_cutoff, line_draft, checked_save, checked_form, flawed_save, save_check, form_check, written, write_conflict, write_denied, write_busy, write_outcome, read_found, read_denied, read_busy, read_outcome]
    uses []

/// One session row: token, actor and revocation marker (0 = live).
record session_row
    str token
    str actor
    int revoked_ms
/// Session lookup key.
record session_key
    str token
/// One membership row: actor belongs to the integer tenant.
record membership_row
    str actor
    int tenant
/// Membership lookup key.
record membership_key
    str actor
    int tenant
/// One stored invoice: integer tenant/invoice key, never-reused
/// optimistic revision, seat count, details text and write stamp.
record invoice_row
    int tenant
    int id
    int revision
    int seats
    str details
    int updated_ms
/// Invoice lookup key: the integer tenant/invoice pair.
record invoice_key
    int tenant
    int id
/// Invoice update parameters in statement order. The trailing
/// expected revision predicates the write, so a concurrent commit
/// blocks this one instead of clobbering it.
record invoice_update
    int revision
    int seats
    str details
    int updated_ms
    int tenant
    int id
    int expected
/// One stored invoice line: keyed identity, validated line id,
/// exact quantity and minor-unit price, stored position order.
record line_row
    int invoice_id
    str line_key
    str id
    int quantity
    int price_minor
    int position
/// Line collection key (scan and delete).
record lines_key
    int invoice_id
/// Line insert parameters in statement order.
record line_insert
    int invoice_id
    str line_key
    str id
    int quantity
    int price_minor
    int position
/// One replay ledger row: actor- and invoice-scoped operation id,
/// canonical content digest, committed result JSON, committed
/// revision and server commit stamp. Rows older than the retention
/// window expire: exact-result replay is no longer promised.
record replay_row
    str actor
    int tenant
    int invoice_id
    str operation_id
    str digest
    str result
    int revision
    int recorded_ms
/// Replay lookup key: actor plus captured tenant/invoice plus id.
record replay_key
    str actor
    int tenant
    int invoice_id
    str operation_id
/// Replay insert parameters in statement order.
record replay_insert
    str actor
    int tenant
    int invoice_id
    str operation_id
    str digest
    str result
    int revision
    int recorded_ms
/// Expired-row replacement key: deletes the one expired ledger row
/// for an operation before a fresh commit reuses its id.
record replay_expire
    str actor
    int tenant
    int invoice_id
    str operation_id
    int cutoff
/// Retention cleanup bound: delete rows recorded before cutoff.
record replay_cutoff
    int cutoff
/// One normalized save line shared by both wire channels: keyed
/// identity, validated line id and exact parsed quantity/price.
record line_draft
    str key
    str id
    int quantity
    int price_minor
/// Validated JSON save content ready for the protected write: the
/// base revision arrives pre-validated by the channel check. Seats
/// and details are preserved from the stored row, never from JSON.
record checked_save
    int revision
    line_draft[] lines
/// Validated form save content: seats/details/revision plus lines.
record checked_form
    int seats
    str details
    int revision
    line_draft[] lines
/// Failed validation: one finite reason plus the wire field or
/// form-level marker it belongs to, so both channels report the
/// first failure in submitted order without remapping tables.
record flawed_save
    str reason
    str field
/// Pure JSON validation outcome: validation runs before any store touch.
variant save_check
    checked_save
    flawed_save
/// Pure form validation outcome.
variant form_check
    checked_form
    flawed_save
/// Committed write: the new revision plus the exact acknowledged
/// content both channels project into their own result shapes.
record written
    int tenant
    int invoice
    int revision
    int seats
    str details
    line_draft[] lines
    int total
/// Stale or conflicting write: the key plus the current stored
/// revision so the writer can reread and retry. Returned only to
/// members, after membership is proven.
record write_conflict
    int tenant
    int invoice
    int revision
/// Denied write: the key echoes back (the caller sent it, so it
/// discloses nothing). Foreign, nonexistent and unauthenticated
/// targets share this one nondisclosing shape.
record write_denied
    int tenant
    int invoice
/// Unavailable store: the write may or may not have committed; the
/// identical JSON operation id replays safely.
record write_busy
    int tenant
    int invoice
/// The four neutral protected-write cases. Each channel maps these
/// to its own wire outcome; neither decoder invents cases here.
variant write_outcome
    written
    write_conflict
    write_denied
    write_busy
/// Loaded invoice: key, current revision, seats, details and lines
/// in stored position order with their exact total.
record read_found
    int tenant
    int invoice
    int revision
    int seats
    str details
    line_draft[] lines
    int total
/// Denied load: same nondisclosing shape as a denied write.
record read_denied
    int tenant
    int invoice
/// Unavailable store on a read: the GET retry is always safe.
record read_busy
    int tenant
    int invoice
/// The three neutral protected-read cases.
variant read_outcome
    read_found
    read_denied
    read_busy
