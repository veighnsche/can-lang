package web
    provides [invoice_routes, health, main]
    uses [billing::invoice_contract as contract, records, model, render, action, bytes, clock, codec, env, form, html, htmx, http, io, option, sql, text]

/// Serve one invoice load: authenticate from the session cookie on
/// every request, then run the protected read. GET needs no Origin;
/// a capture, wire field or browser token cannot authorize.
fn contract::grid_load_outcome load_grid
    emits []
    given
        near sql::pool pool
        http::request req
        contract::invoice_key key
    asserts
        lg_no_session: contract::invoice_key(1, 7) => ok contract::grid_load_forbidden("request denied")
        lg_found: contract::invoice_key(1, 7) => ok contract::grid_loaded(contract::grid_snapshot("1", [contract::grid_line_wire("k1", "a", "2", "5.00")], 1000))
    match call http::request_headers(req)
        when
            lg_no_session: req => ok []
            lg_found: req => ok [http::header("cookie", "session=tok-alice")]
        ok http::header[] headers => match call model::session_of(headers)
            ok option::value<str> session => match session
                option::none => ok contract::grid_load_forbidden("request denied")
                option::some => match call model::load_authorized(pool, session.value, key)
                    when
                        lg_found: pool, "tok-alice", contract::invoice_key(1, 7) => ok contract::grid_loaded(contract::grid_snapshot("1", [contract::grid_line_wire("k1", "a", "2", "5.00")], 1000))
                    ok contract::grid_load_outcome result => ok result

/// Serve one JSON save: authenticate from the session cookie, then
/// enforce the exact-Origin policy before any replay lookup or
/// mutation, then run the protected write both channels share.
fn contract::grid_edit_outcome save_grid
    emits []
    given
        near sql::pool pool
        near str public_origin
        near int window
        http::request req
        contract::invoice_key key
        contract::grid_edit_input body
    asserts
        sg_no_session: "https://shop.example", 1000, contract::invoice_key(1, 7), contract::grid_edit_input("op-1", "1", []) => ok contract::grid_forbidden("op-1", "request denied")
        sg_bad_origin: "https://shop.example", 1000, contract::invoice_key(1, 7), contract::grid_edit_input("op-1", "1", []) => ok contract::grid_forbidden("op-1", "request denied")
        sg_saved: "https://shop.example", 1000, contract::invoice_key(1, 7), contract::grid_edit_input("op-1", "1", [contract::grid_line_wire("k1", "a", "2", "5.00")]) => ok contract::grid_saved("op-1", contract::grid_snapshot("2", [contract::grid_line_wire("k1", "a", "2", "5.00")], 1000))
    match call http::request_headers(req)
        when
            sg_no_session: req => ok []
            sg_bad_origin: req => ok [http::header("cookie", "session=tok-alice")]
            sg_saved: req => ok [http::header("cookie", "session=tok-alice"), http::header("origin", "https://shop.example")]
        ok http::header[] headers => match call model::session_of(headers)
            ok option::value<str> session => match session
                option::none => ok contract::grid_forbidden(body.operation_id, "request denied")
                option::some => match call model::exact_origin(headers, public_origin)
                    ok bool admitted => match admitted
                        false => ok contract::grid_forbidden(body.operation_id, "request denied")
                        true => match call model::save_authorized(pool, session.value, key, body, window)
                            when
                                sg_saved: pool, "tok-alice", contract::invoice_key(1, 7), body, 1000 => ok contract::grid_saved("op-1", contract::grid_snapshot("2", [contract::grid_line_wire("k1", "a", "2", "5.00")], 1000))
                            ok contract::grid_edit_outcome result => ok result

/// Serve one form save through the same protected write as the JSON
/// channel: cookie session, exact Origin, then the shared domain
/// operation over parsed form content. Replay promises stay
/// distinct: the domain mints a fresh operation id per form save.
fn contract::edit_outcome save_html
    emits []
    given
        near sql::pool pool
        near str public_origin
        near int window
        http::request req
        contract::invoice_key key
        contract::invoice_form form
    asserts
        sh_no_session: "https://shop.example", 1000, contract::invoice_key(1, 7), contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], [])) => ok contract::forbidden("request denied")
        sh_bad_origin: "https://shop.example", 1000, contract::invoice_key(1, 7), contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], [])) => ok contract::forbidden("request denied")
        sh_saved: "https://shop.example", 1000, contract::invoice_key(1, 7), contract::invoice_form("2", option::some("rush"), "1", form::rows<contract::line_wire>(["k1"], [form::row_item<contract::line_wire>("k1", contract::line_wire("a", "2", "5.00"))])) => ok contract::saved(contract::invoice_form("2", option::some("rush"), "2", form::rows<contract::line_wire>(["k1"], [form::row_item<contract::line_wire>("k1", contract::line_wire("a", "2", "5.00"))])))
    match call http::request_headers(req)
        when
            sh_no_session: req => ok []
            sh_bad_origin: req => ok [http::header("cookie", "session=tok-alice")]
            sh_saved: req => ok [http::header("cookie", "session=tok-alice"), http::header("origin", "https://shop.example")]
        ok http::header[] headers => match call model::session_of(headers)
            ok option::value<str> session => match session
                option::none => ok contract::forbidden("request denied")
                option::some => match call model::exact_origin(headers, public_origin)
                    ok bool admitted => match admitted
                        false => ok contract::forbidden("request denied")
                        true => match call model::save_html_authorized(pool, session.value, key, form, window)
                            when
                                sh_saved: pool, "tok-alice", key, form, 1000 => ok contract::saved(contract::invoice_form("2", option::some("rush"), "2", form::rows<contract::line_wire>(["k1"], [form::row_item<contract::line_wire>("k1", contract::line_wire("a", "2", "5.00"))])))
                            ok contract::edit_outcome result => ok result

/// Render one field error as a list item naming the wire field and
/// its finite validation reason.
fn html::node error_item
    emits [html::invalid_structure]
    given
        contract::field_error fault
    asserts
        sample: contract::field_error("seats", "bad seats") => ok
    match chain
        call html::text(fault.field + ": " + fault.message) as html::node words
        call html::make_tag("li") as html::tag item_tag
        call html::element(item_tag, [], [words]) as html::node item
        html::invalid_structure
        ok => ok item

/// Render one save outcome as a status fragment. Every value enters
/// through the escaping text constructor. Success announces
/// politely; every failure arm wraps its summary plus a recovery
/// hint in an alert region, and the denied arm echoes nothing so
/// foreign and nonexistent targets disclose nothing.
fn html::safe outcome_fragment
    emits [html::invalid_structure]
    given
        contract::edit_outcome outcome
    asserts
        saved: contract::saved(contract::invoice_form("2", option::none(), "2", form::rows<contract::line_wire>([], []))) => ok
        invalid: contract::invalid(option::some(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], []))), [contract::field_error("seats", "bad seats")]) => ok
        conflict: contract::conflict(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], [])), "stale revision") => ok
        denied: contract::forbidden("request denied") => ok
        busy: contract::unavailable(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], [])), "store unavailable") => ok
        hostile: contract::invalid(option::some(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], []))), [contract::field_error("details", "<script>bad()</script>")]) => ok
    match outcome
        contract::saved => match chain
            call html::text("saved revision " + outcome.acknowledged.revision) as html::node words
            call html::make_tag("p") as html::tag paragraph
            call html::text_attribute("class", "save-saved") as html::attribute style
            call html::text_attribute("role", "status") as html::attribute polite
            call html::element(paragraph, [style, polite], [words]) as html::node line
            call html::fragment([line]) as html::safe body
            html::invalid_structure
            ok => ok body
        contract::invalid => match call outcome.errors.map(callable error_item)
            html::invalid_structure
            ok html::node[] problems => match chain
                call html::text("invoice invalid") as html::node heading_text
                call html::make_tag("p") as html::tag paragraph
                call html::element(paragraph, [], [heading_text]) as html::node heading
                call html::make_tag("ul") as html::tag list_tag
                call html::element(list_tag, [], problems) as html::node issue_list
                call html::text("Fix the form and save again.") as html::node hint_text
                call html::element(paragraph, [], [hint_text]) as html::node hint
                call html::make_tag("div") as html::tag alert_tag
                call html::text_attribute("role", "alert") as html::attribute alert
                call html::element(alert_tag, [alert], [heading, issue_list, hint]) as html::node notice
                call html::fragment([notice]) as html::safe body
                html::invalid_structure
                ok => ok body
        contract::conflict => match chain
            call html::text("conflict: " + outcome.message) as html::node words
            call html::make_tag("p") as html::tag paragraph
            call html::text_attribute("class", "save-conflict") as html::attribute style
            call html::element(paragraph, [style], [words]) as html::node line
            call html::text("Reload the form to reread, then save again.") as html::node hint_text
            call html::element(paragraph, [], [hint_text]) as html::node hint
            call html::make_tag("div") as html::tag alert_tag
            call html::text_attribute("role", "alert") as html::attribute alert
            call html::element(alert_tag, [alert], [line, hint]) as html::node notice
            call html::fragment([notice]) as html::safe body
            html::invalid_structure
            ok => ok body
        contract::forbidden => match chain
            call html::text("forbidden: " + outcome.message) as html::node words
            call html::make_tag("p") as html::tag paragraph
            call html::text_attribute("class", "save-denied") as html::attribute style
            call html::element(paragraph, [style], [words]) as html::node line
            call html::text("Sign in with an authorized account and try again.") as html::node hint_text
            call html::element(paragraph, [], [hint_text]) as html::node hint
            call html::make_tag("div") as html::tag alert_tag
            call html::text_attribute("role", "alert") as html::attribute alert
            call html::element(alert_tag, [alert], [line, hint]) as html::node notice
            call html::fragment([notice]) as html::safe body
            html::invalid_structure
            ok => ok body
        contract::unavailable => match chain
            call html::text("unavailable: " + outcome.message) as html::node words
            call html::make_tag("p") as html::tag paragraph
            call html::text_attribute("class", "save-busy") as html::attribute style
            call html::element(paragraph, [style], [words]) as html::node line
            call html::text("The store is unavailable; reread before retrying.") as html::node hint_text
            call html::element(paragraph, [], [hint_text]) as html::node hint
            call html::make_tag("div") as html::tag alert_tag
            call html::text_attribute("role", "alert") as html::attribute alert
            call html::element(alert_tag, [alert], [line, hint]) as html::node notice
            call html::fragment([notice]) as html::safe body
            html::invalid_structure
            ok => ok body

/// Render one save outcome for the HTML action. Structure failures
/// fall back to a fixed fragment so the renderer stays total.
fn html::safe render_html
    emits []
    given
        contract::edit_outcome outcome
    asserts
        saved: contract::saved(contract::invoice_form("2", option::none(), "2", form::rows<contract::line_wire>([], []))) => ok
        invalid: contract::invalid(option::some(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], []))), [contract::field_error("seats", "bad seats")]) => ok
        conflict: contract::conflict(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], [])), "stale revision") => ok
        denied: contract::forbidden("request denied") => ok
        busy: contract::unavailable(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], [])), "store unavailable") => ok
        hostile: contract::invalid(option::some(contract::invoice_form("2", option::none(), "1", form::rows<contract::line_wire>([], []))), [contract::field_error("details", "<script>bad()</script>")]) => ok
    match call outcome_fragment(outcome)
        html::invalid_structure => ok call html::text_fragment("invoice save")
        ok html::safe done => ok done

/// Render one retained raw form entry as a list item, echoing the
/// submitted name and value verbatim through escaping.
fn html::node raw_entry_item
    emits [html::invalid_structure]
    given
        form::raw_entry entry
    asserts
        sample: form::raw_entry("seats", "2") => ok
        hostile: form::raw_entry("details", "</li><script>bad()</script>") => ok
    match chain
        call html::text(entry.name + "=" + entry.value) as html::node words
        call html::make_tag("li") as html::tag item_tag
        call html::element(item_tag, [], [words]) as html::node item
        html::invalid_structure
        ok => ok item

/// Render one structural issue as a list item naming the wire field
/// and its finite violation reason.
fn html::node issue_item
    emits [html::invalid_structure]
    given
        form::issue issue
    asserts
        sample: form::issue("lines", "form_missing") => ok
    match chain
        call html::text(issue.name + ": " + issue.reason) as html::node words
        call html::make_tag("li") as html::tag item_tag
        call html::element(item_tag, [], [words]) as html::node item
        html::invalid_structure
        ok => ok item

/// Render one structurally rejected form: the heading plus the
/// retained raw entries and the issue list in document order, wrapped
/// in an alert region so the swapped 422 announces its errors.
fn html::safe rejected_fragment
    emits [html::invalid_structure]
    given
        form::rejected<contract::invoice_form> bad
    asserts
        sample: form::rejected<contract::invoice_form>([form::raw_entry("seats", "2")], [form::issue("lines", "form_missing")]) => ok
        hostile: form::rejected<contract::invoice_form>([form::raw_entry("details", "</li><script>bad()</script>")], [form::issue("lines", "form_missing")]) => ok
    match call bad.raw.map(callable raw_entry_item)
        html::invalid_structure
        ok html::node[] raw => match call bad.issues.map(callable issue_item)
            html::invalid_structure
            ok html::node[] problems => match chain
                call html::text("invoice form rejected") as html::node heading_text
                call html::make_tag("p") as html::tag paragraph
                call html::element(paragraph, [], [heading_text]) as html::node heading
                call html::make_tag("ul") as html::tag list_tag
                call html::text_attribute("class", "form-raw") as html::attribute raw_style
                call html::element(list_tag, [raw_style], raw) as html::node raw_list
                call html::text_attribute("class", "form-issues") as html::attribute issue_style
                call html::element(list_tag, [issue_style], problems) as html::node issue_list
                call html::make_tag("div") as html::tag alert_tag
                call html::text_attribute("role", "alert") as html::attribute alert
                call html::element(alert_tag, [alert], [heading, raw_list, issue_list]) as html::node notice
                call html::fragment([notice]) as html::safe body
                html::invalid_structure
                ok => ok body

/// Render one structural rejection for the HTML action at 422.
fn html::safe render_bad_form
    emits []
    given
        form::rejected<contract::invoice_form> bad
    asserts
        sample: form::rejected<contract::invoice_form>([form::raw_entry("seats", "2")], [form::issue("lines", "form_missing")]) => ok
        hostile: form::rejected<contract::invoice_form>([form::raw_entry("details", "</li><script>bad()</script>")], [form::issue("lines", "form_missing")]) => ok
    match call rejected_fragment(bad)
        html::invalid_structure => ok call html::text_fragment("invoice form rejected")
        ok html::safe done => ok done

/// Answer one fixed transport failure as plain text, carrying no
/// wire detail past the status line.
fn http::server_response fixed_at
    emits []
    given
        int code
        str text
    asserts
        bad_request: 400, "Bad Request" => ok
        too_large: 413, "Payload Too Large" => ok
    match call http::make_body_status(code)
        http::invalid_request => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        ok http::body_status status => ok call http::response_text(status, call http::empty_server_headers(), text)

/// Answer one notice document at an explicit status. An
/// inadmissible status or a render failure falls back to a 500 text
/// answer carrying no invoice content.
fn http::server_response notice_at
    emits []
    given
        int code
        str title
        str message
    asserts
        sample: 403, "Invoice denied", "denied 1/9" => ok
        bad_status: 99, "Invoice denied", "denied 1/9" => ok
    match call http::make_body_status(code)
        http::invalid_request => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        ok http::body_status status => match call render::notice_page(title, message)
            html::invalid_structure => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
            ok html::safe document => ok call http::response_html(status, call http::empty_server_headers(), document)

/// Load one invoice for the edit page on the serving pool.
fn records::read_outcome load_for_page
    emits []
    given
        sql::pool pool
        str token
        contract::invoice_key key
    asserts
        page_ok: "tok-alice", contract::invoice_key(1, 7) => ok records::read_found(1, 7, 1, 2, "rush", [records::line_draft("k1", "a", 2, 500)], 1000)
        page_denied: "tok-ghost", contract::invoice_key(1, 7) => ok records::read_denied(1, 7)
        page_down: "tok-alice", contract::invoice_key(1, 7) => ok records::read_busy(1, 7)
    match key
        contract::invoice_key => do
            str session_token = token
            int tenant = key.tenant_id
            int invoice_id = key.invoice_id
            match call sql::with_transaction<records::read_outcome>(pool, callable model::decide_load)
                when
                    page_ok: pool, callable model::decide_load => ok records::read_found(1, 7, 1, 2, "rush", [records::line_draft("k1", "a", 2, 500)], 1000)
                    page_denied: pool, callable model::decide_load => ok records::read_denied(1, 7)
                    page_down: pool, callable model::decide_load => sql::transaction_failed("commit")
                    form_found: pool, callable model::decide_load => ok records::read_found(1, 7, 1, 2, "rush", [records::line_draft("k1", "a", 2, 500)], 1000)
                    form_denied: pool, callable model::decide_load => ok records::read_denied(1, 9)
                    form_busy: pool, callable model::decide_load => sql::transaction_failed("commit")
                    form_render_down: pool, callable model::decide_load => ok records::read_found(1, 7, 1, 2, "rush", [records::line_draft("k 1", "a", 2, 500)], 1000)
                sql::connection_failed => ok records::read_busy(tenant, invoice_id)
                sql::transaction_failed => ok records::read_busy(tenant, invoice_id)
                sql::commit_unknown => ok records::read_busy(tenant, invoice_id)
                ok records::read_outcome outcome => ok outcome

/// Render one protected load for the edit page: a found invoice
/// becomes the edit form posting to the shared HTML action, while
/// denials and outages become notice documents at their truthful
/// statuses. Unmintable stored row keys fail the render into a 500
/// rather than serving a broken form.
fn http::server_response page_for_load
    emits []
    given
        records::read_outcome outcome
        contract::invoice_key key
    asserts
        page_found: records::read_found(1, 7, 1, 2, "rush", [records::line_draft("k1", "a", 2, 500)], 1000), contract::invoice_key(1, 7) => ok
        page_denied: records::read_denied(1, 9), contract::invoice_key(1, 9) => ok
        page_busy: records::read_busy(1, 7), contract::invoice_key(1, 7) => ok
        page_render_down: records::read_found(1, 7, 1, 2, "rush", [records::line_draft("k 1", "a", 2, 500)], 1000), contract::invoice_key(1, 7) => ok
    match outcome
        records::read_found => match call render::edit_page(key, outcome)
            html::invalid_structure => ok call fixed_at(500, "error")
            html::invalid_url => ok call fixed_at(500, "error")
            htmx::invalid_target => ok call fixed_at(500, "error")
            form::unknown_field => ok call fixed_at(500, "error")
            form::invalid_name => ok call fixed_at(500, "error")
            action::invalid_path => ok call fixed_at(500, "error")
            ok html::safe document => ok call http::response_html(call http::status_ok(), call http::empty_server_headers(), document)
        records::read_denied => match call notice_at(403, "Invoice denied", "denied " + call text::from_int(outcome.tenant) + "/" + call text::from_int(outcome.invoice))
            ok http::server_response done => ok done
        records::read_busy => match call notice_at(503, "Invoice unavailable", "busy " + call text::from_int(outcome.tenant) + "/" + call text::from_int(outcome.invoice))
            ok http::server_response done => ok done

/// Serve the invoice edit page: reject any request body, read the
/// integer tenant/invoice pair from its single query values, resolve
/// the session cookie, then run the protected read and render its
/// outcome. Every outcome keeps its truthful status; no failure
/// rewrites into success. The page stays query-addressed: captured
/// HTML pages are not expressible in the checked language (plain
/// routes are static-only, GET actions answer JSON-only), so the
/// captured /tenants/:tenant_id/invoices/:invoice_id/edit address is
/// deferred to a checker-owning follow-up (see UP19 Jev findings).
fn http::server_response form_route
    emits []
    given
        http::request req
        near sql::pool pool
    asserts
        form_over_limit: => ok
        form_bad_query: => ok
        form_bad_tenant: => ok
        form_found: => ok
        form_denied: => ok
        form_busy: => ok
        form_render_down: => ok
    match call http::request_body(req, 8192)
        when
            form_over_limit: req, 8192 => http::body_limit(8192)
            form_bad_query: req, 8192 => ok call bytes::empty()
            form_bad_tenant: req, 8192 => ok call bytes::empty()
            form_found: req, 8192 => ok call bytes::empty()
            form_denied: req, 8192 => ok call bytes::empty()
            form_busy: req, 8192 => ok call bytes::empty()
            form_render_down: req, 8192 => ok call bytes::empty()
        http::body_limit => ok call fixed_at(413, "Payload Too Large")
        ok bytes::buffer raw => match call bytes::to_ints(raw)
            ok int[] units => match units.length is 0
                false => ok call fixed_at(400, "Bad Request")
                true => match call http::query_one(req, "tenant_id")
                    when
                        form_bad_query: req, "tenant_id" => http::invalid_request("query")
                        form_bad_tenant: req, "tenant_id" => ok "1x"
                        form_found: req, "tenant_id" => ok "1"
                        form_denied: req, "tenant_id" => ok "1"
                        form_busy: req, "tenant_id" => ok "1"
                        form_render_down: req, "tenant_id" => ok "1"
                    http::invalid_request => ok call fixed_at(400, "Bad Request")
                    ok str tenant_text => match call http::query_one(req, "invoice_id")
                        when
                            form_bad_tenant: req, "invoice_id" => ok "7"
                            form_found: req, "invoice_id" => ok "7"
                            form_denied: req, "invoice_id" => ok "9"
                            form_busy: req, "invoice_id" => ok "7"
                            form_render_down: req, "invoice_id" => ok "7"
                        http::invalid_request => ok call fixed_at(400, "Bad Request")
                        ok str invoice_text => match call text::to_int(tenant_text)
                            text::invalid_number => ok call fixed_at(400, "Bad Request")
                            ok int tenant => match call text::to_int(invoice_text)
                                text::invalid_number => ok call fixed_at(400, "Bad Request")
                                ok int invoice => match call http::request_headers(req)
                                    when
                                        form_found: req => ok [http::header("cookie", "session=tok-alice")]
                                        form_denied: req => ok [http::header("x-t", "1")]
                                        form_busy: req => ok [http::header("cookie", "session=tok-alice")]
                                        form_render_down: req => ok [http::header("cookie", "session=tok-alice")]
                                    ok http::header[] headers => match call model::session_of(headers)
                                        ok option::value<str> session => match session
                                            option::none => match call load_for_page(pool, "", contract::invoice_key(tenant, invoice))
                                                ok records::read_outcome outcome => match call page_for_load(outcome, contract::invoice_key(tenant, invoice))
                                                    ok http::server_response done => ok done
                                            option::some => match call load_for_page(pool, session.value, contract::invoice_key(tenant, invoice))
                                                ok records::read_outcome outcome => match call page_for_load(outcome, contract::invoice_key(tenant, invoice))
                                                    ok http::server_response done => ok done

/// Serve the invoice grid shell: reject any request body, then
/// serve the static public shell. The shell carries no invoice data
/// and echoes no query input, so the route parses nothing and checks
/// no session; the browser application validates its own query keys
/// and renders API denials itself.
fn http::server_response grid_route
    emits []
    given
        http::request req
    asserts
        grid_over_limit: => ok
        grid_shell: => ok
    match call http::request_body(req, 8192)
        when
            grid_over_limit: req, 8192 => http::body_limit(8192)
            grid_shell: req, 8192 => ok call bytes::empty()
        http::body_limit => ok call fixed_at(413, "Payload Too Large")
        ok bytes::buffer raw => match call bytes::to_ints(raw)
            ok int[] units => match units.length is 0
                false => ok call fixed_at(400, "Bad Request")
                true => match call render::grid_page()
                    html::invalid_structure => ok call fixed_at(500, "error")
                    ok html::safe document => ok call http::response_html(call http::status_ok(), call http::empty_server_headers(), document)

/// Answer readiness for the operator and the test harness.
fn http::server_response health
    emits []
    given
        http::request req
    asserts
        sample: => ok
    ok call http::response_text(call http::status_ok(), call http::empty_server_headers(), "ok")

/// Mount the three shared invoice actions plus the query-addressed
/// edit page and the public grid shell, capturing the serving pool,
/// the validated public origin and the retention window. Importing
/// the contract registers nothing; only these mounts enter the server
/// route table.
fn http::router invoice_routes
    emits [http::invalid_route, http::duplicate_route, http::ambiguous_route]
    given
        near sql::pool pool
        near str public_origin
        near int window
    asserts
        sample: "https://shop.example", 1000 => ok
    match chain
        call action::mount(contract::load_invoice_grid, callable load_grid) as http::route load
        call action::mount(contract::save_invoice_grid, callable save_grid) as http::route save
        call action::mount(contract::save_invoice_html, callable save_html, callable render_html, callable render_bad_form) as http::route form
        call http::route_get("/invoices/form", callable form_route) as http::route form_page
        call http::route_get("/invoice-grid", callable grid_route) as http::route grid_page
        call http::route_get("/health", callable health) as http::route probe
        call http::make_router([load, save, form, form_page, grid_page, probe]) as http::router built
        http::invalid_route
        http::duplicate_route
        http::ambiguous_route
        ok => ok built

/// Reject a malformed startup value with an authored
/// env::invalid_name failure, so every startup problem shares one
/// failure signal.
fn void reject_startup
    emits [env::invalid_name, http::credentials_missing]
    asserts
        sample: => env::invalid_name("")
    env::invalid_name("")

/// Read the retention window: explicit positive
/// INVOICE_REPLAY_WINDOW_MS, else the seven-day default. A missing
/// variable reads the default; an unparsable or non-positive value
/// fails closed through the same startup rejection as a malformed
/// origin, so every window problem shares one failure signal.
fn int startup_window
    emits [env::invalid_name, http::credentials_missing]
    asserts
        default: => ok 604800000
        explicit: => ok 1000
        malformed: => env::invalid_name("")
        negative: => env::invalid_name("")
    match call env::optional("INVOICE_REPLAY_WINDOW_MS")
        when
            default: "INVOICE_REPLAY_WINDOW_MS" => ok option::none()
            explicit: "INVOICE_REPLAY_WINDOW_MS" => ok option::some("1000")
            malformed: "INVOICE_REPLAY_WINDOW_MS" => ok option::some("week")
            negative: "INVOICE_REPLAY_WINDOW_MS" => ok option::some("-5")
            serve: "INVOICE_REPLAY_WINDOW_MS" => ok option::none()
        env::invalid_name
        ok option::value<str> found => match found
            option::none => ok 604800000
            option::some => match call bytes::from_utf8(found.value)
                codec::invalid_data => match call reject_startup()
                    env::invalid_name
                    http::credentials_missing
                    ok => ok 0 - 1
                ok bytes::buffer raw => match call codec::decode_json<int>(raw)
                    codec::invalid_data => match call reject_startup()
                        env::invalid_name
                        http::credentials_missing
                        ok => ok 0 - 1
                    ok int window => match call model::valid_window(window)
                        ok bool positive => match positive
                            false => match call reject_startup()
                                env::invalid_name
                                http::credentials_missing
                                ok => ok 0 - 1
                            true => ok window

/// Serve invoices until a shutdown signal, then close the pool.
/// Startup validates one canonical public origin and the positive
/// retention window, expires the retention tail once, then serves.
fn void main
    emits [codec::invalid_data, io::write_failed, env::invalid_name, http::credentials_missing, sql::connection_failed, sql::close_failed, http::invalid_server_config, http::invalid_route, http::duplicate_route, http::ambiguous_route, http::bind_failed, http::shutdown_failed]
    given
        str[] args
    asserts
        empty: [] => ok
        serve: ["18495"] => ok
        bad_origin: ["18495"] => env::invalid_name("")
        bad_window: ["18495"] => env::invalid_name("")
    match args.length is 1
        false => match call bytes::from_utf8("usage: invoice <port>")
            codec::invalid_data
            ok bytes::buffer message => match call io::stdout_write(message)
                when
                    empty: message => ok 0
                io::write_failed
                ok int written => ok
        true => match call bytes::from_utf8(args[0])
            codec::invalid_data
            ok bytes::buffer raw => match call codec::decode_json<int>(raw)
                codec::invalid_data
                ok int port => match call env::required("INVOICE_DB")
                    when
                        serve: "INVOICE_DB" => ok "/tmp/inv.sqlite"
                        bad_origin: "INVOICE_DB" => ok "/tmp/inv.sqlite"
                        bad_window: "INVOICE_DB" => ok "/tmp/inv.sqlite"
                    env::invalid_name
                    http::credentials_missing
                    ok str db => match call env::required("PUBLIC_ORIGIN")
                        when
                            serve: "PUBLIC_ORIGIN" => ok "https://shop.example"
                            bad_origin: "PUBLIC_ORIGIN" => ok "http://shop.example"
                            bad_window: "PUBLIC_ORIGIN" => ok "https://shop.example"
                        env::invalid_name
                        http::credentials_missing
                        ok str origin => match call model::valid_public_origin(origin)
                            ok bool shaped => match shaped
                                false => match call reject_startup()
                                    env::invalid_name
                                    http::credentials_missing
                                    ok => ok
                                true => match call startup_window()
                                    when
                                        bad_window: => env::invalid_name("")
                                    env::invalid_name
                                    http::credentials_missing
                                    ok int window => match call sql::sqlite_open_file(db, sql::sqlite_file_options("rw", 5000))
                                        when
                                            serve: "/tmp/inv.sqlite", sql::sqlite_file_options("rw", 5000) => ok
                                        sql::connection_failed
                                        ok sql::pool pool => match call model::cleanup_expired(pool, window)
                                            when
                                                serve: pool, 604800000 => ok 0
                                            ok int expired => match call http::make_server_config("127.0.0.1", port, 65536, 5000)
                                                http::invalid_server_config
                                                ok http::server_config config => match call invoice_routes(pool, origin, window)
                                                    http::invalid_route
                                                    http::duplicate_route
                                                    http::ambiguous_route
                                                    ok http::router built => match call http::server_start(config, built)
                                                        when
                                                            serve: config, built => ok
                                                        http::bind_failed
                                                        ok http::server sturdy => match call http::server_wait(sturdy)
                                                            when
                                                                serve: sturdy => ok
                                                            http::shutdown_failed
                                                            ok => match call sql::pool_close(pool, 1000)
                                                                when
                                                                    serve: pool, 1000 => ok
                                                                sql::close_failed
                                                                ok => ok
