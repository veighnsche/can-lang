package markdown_example
    provides [preview, publish, serve, main]
    uses [markdown, html, http, bytes, io, codec]
/// Ordinary display: native HTML stays a plain string, raw markup
/// included, so callers can preview untrusted documents as text.
fn str preview
    emits [markdown::over_limit]
    given
        str source
    asserts
        sample: "# Release" => ok "<h1>Release</h1>\n"
        hostile: "<script>alert(1)</script>" => ok "<script>alert(1)</script>\n"
    relay call markdown::render_text_html(source)
/// Safe publishing: the same document becomes an opaque html::safe
/// fragment with raw markup escaped and links policy-checked.
fn html::safe publish
    emits [markdown::over_limit, html::invalid_url]
    given
        str source
    asserts
        sample: "# Release" => ok
        bad_link: "[t](javascript:alert(1))" => html::invalid_url("scheme")
    relay call markdown::render_safe(source)
/// Safe HTTP responses accept only the typed safe result; the raw
/// preview string cannot flow here (see the integration negatives).
fn http::server_response serve
    emits [markdown::over_limit, html::invalid_url]
    given
        str source
    asserts
        sample: "# Release" => ok
    match chain
        call markdown::render_safe(source) as html::safe sheet
        call http::status_ok() as http::body_status ok_status
        call http::empty_server_headers() as http::server_headers headers
        call http::response_html(ok_status, headers, sheet) as http::server_response response
        markdown::over_limit
        html::invalid_url
        ok => ok response
fn int emit
    emits [codec::invalid_data, io::write_failed]
    given
        str text
    asserts
        sample: "hi" => ok 2
    match call bytes::from_utf8(text)
        codec::invalid_data
        ok bytes::buffer message => match call io::stdout_write(message)
            when
                sample: message => ok 2
                empty: message => ok 0
                arity: message => ok 0
            io::write_failed
            ok int written => ok written
fn void main
    emits [markdown::over_limit, codec::invalid_data, io::write_failed]
    given
        str[] args
    asserts
        empty: [] => ok
        arity: ["preview"] => ok
    match args.length is 0
        false => match args[0]
            "preview" => match args.length is 2
                false => match call emit("usage: notes preview <source>")
                    codec::invalid_data
                    io::write_failed
                    ok int written => ok
                true => match call preview(args[1])
                    markdown::over_limit
                    ok str out => match call emit(out)
                        codec::invalid_data
                        io::write_failed
                        ok int written => ok
            _ => match call emit("usage: notes preview <source>")
                codec::invalid_data
                io::write_failed
                ok int written => ok
        true => match call emit("usage: notes preview <source>")
            codec::invalid_data
            io::write_failed
            ok int written => ok
