package utilities_example
    provides [link_host, link_tags, tokyo_time, first_word, b64, main]
    uses [bytes, codec, io, text, time, url]

/// Host of an absolute URL.
fn str link_host
    emits [url::invalid_url]
    given
        str text
    asserts
        sample: "https://example.com:8080/x?a=1" => ok "example.com"
        bad_scheme: "ftp://example.com/x" => url::invalid_url("scheme")
    match call url::parse(text)
        url::invalid_url
        ok url::parts parts => ok parts.host

/// Every "tag" query value in document order.
fn str[] link_tags
    emits [url::invalid_url]
    given
        str text
    asserts
        sample: "https://example.com/?tag=a&x=1&tag=b" => ok ["a", "b"]
    match call url::parse(text)
        url::invalid_url
        ok url::parts parts => match call url::query_all(parts, "tag")
            ok str[] tags => ok tags

/// Epoch millis formatted for Tokyo with medium/short styles.
fn str tokyo_time
    emits [time::out_of_range, time::invalid_zone, time::invalid_option]
    given
        int millis
    asserts
        sample: 1790164800000 => ok "Sep 23, 2026 at 9:00 PM"
    match call time::instant_from_epoch_millis(millis)
        time::out_of_range
        ok time::instant instant => match call time::format_in_zone(instant, "en-US", "Asia/Tokyo", "medium", "short")
            time::invalid_zone
            time::invalid_option
            ok str rendered => ok rendered

/// First word characters of the text.
fn str first_word
    emits [text::invalid_regex, text::invalid_limit]
    given
        str value
    asserts
        sample: "hi there" => ok "hi"
    match call text::compile_regex("\\w+", "")
        text::invalid_regex
        ok text::regex compiled => match call text::matches(compiled, value, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits[0].text

/// Standard base64 of the UTF-8 bytes.
fn str b64
    emits [codec::invalid_data]
    given
        str text
    asserts
        sample: "héllo" => ok "aMOpbGxv"
    match chain
        call bytes::from_utf8(text) as bytes::buffer raw
        call bytes::encode_base64(raw) as str encoded
        codec::invalid_data
        ok => ok encoded

/// Print "host @ tokyo-time" for a URL and epoch millis.
fn void main
    emits [url::invalid_url, codec::invalid_data, time::out_of_range, time::invalid_zone, time::invalid_option, io::write_failed]
    given
        str[] args
    asserts
        empty: [] => ok
        sample: ["https://example.com/x", "1790164800000"] => ok
    match args.length is 2
        false => match call bytes::from_utf8("usage: describe <url> <epoch-millis>")
            codec::invalid_data
            ok bytes::buffer message => match call io::stdout_write(message)
                when
                    empty: message => ok 0
                io::write_failed
                ok int written => ok
        true => match chain
            call link_host(args[0]) as str host
            call bytes::from_utf8(args[1]) as bytes::buffer raw
            call codec::decode_json<int>(raw) as int millis
            call tokyo_time(millis) as str stamped
            call text::join([host, " @ ", stamped], "") as str line
            call bytes::from_utf8(line) as bytes::buffer body
            url::invalid_url
            codec::invalid_data
            time::out_of_range
            time::invalid_zone
            time::invalid_option
            ok => match call io::stdout_write(body)
                when
                    sample: body => ok 37
                io::write_failed
                ok int written => ok
