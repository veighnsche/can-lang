package web
    provides [receive, receive_claim, receive_heartbeat, receive_ack, receive_dead, health, webhook_routes, boot, main]
    uses [records, model, bytes, clock, codec, env, http, io, option, sql]

/// Answer a receipt at an explicit status. The status and JSON bodies
/// are real, so both assertion cases run natively; an inadmissible
/// status or an unencodable body falls back to a 500 text answer.
fn http::server_response receipt_at
    emits []
    given
        int code
        records::receipt value
    asserts
        sample: 200, records::receipt("accepted") => ok
        bad_status: 99, records::receipt("accepted") => ok
    match call http::make_body_status(code)
        http::invalid_request => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        ok http::body_status status => match call http::response_json<records::receipt>(status, call http::empty_server_headers(), value)
            codec::invalid_data => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
            ok http::server_response done => ok done

/// Answer one acknowledgement outcome at an explicit status.
fn http::server_response ack_at
    emits []
    given
        int code
        records::ack_result value
    asserts
        sample: 200, records::ack_result("done", 1) => ok
        bad_status: 99, records::ack_result("done", 1) => ok
    match call http::make_body_status(code)
        http::invalid_request => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        ok http::body_status status => match call http::response_json<records::ack_result>(status, call http::empty_server_headers(), value)
            codec::invalid_data => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
            ok http::server_response done => ok done

/// Answer one claim page at an explicit status.
fn http::server_response claim_at
    emits []
    given
        int code
        records::claim_page value
    asserts
        sample: 200, records::claim_page("claimed", [records::claim_item("del-1", "invoice.paid", "sub-9", 0, 1005000, 1)]) => ok
        bad_status: 99, records::claim_page("empty", []) => ok
    match call http::make_body_status(code)
        http::invalid_request => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
        ok http::body_status status => match call http::response_json<records::claim_page>(status, call http::empty_server_headers(), value)
            codec::invalid_data => ok call http::response_text(call http::status_internal(), call http::empty_server_headers(), "error")
            ok http::server_response done => ok done

