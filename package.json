{
  "name": "can-runtime-tooling",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "lint:runtime": "oxlint runtime tools/runtime --ignore-pattern '**/vendor/**' --deny-warnings",
    "lint:fix:runtime": "oxlint runtime tools/runtime --ignore-pattern '**/vendor/**' --fix",
    "format:runtime": "oxfmt \"runtime/**/*.ts\" \"tools/runtime/**/*.ts\"",
    "format:check:runtime": "oxfmt --check \"runtime/**/*.ts\" \"tools/runtime/**/*.ts\"",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json",
    "check:runtime": "bun run lint:runtime && bun run format:check:runtime && bun run typecheck:runtime"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.13.6",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright": "1.55.1",
    "typescript": "7.0.2"
  }
}
