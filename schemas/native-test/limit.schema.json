{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://can-lang.org/schemas/native-test/1/limit",
  "title": "Native-test finite budgets",
  "description": "Every budget is a required positive integer. Omitted, zero, negative or non-numeric limits are rejected: no field may mean unlimited.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "positive": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "budgets": {
      "type": "object",
      "properties": {
        "run_wall_ms": {
          "$ref": "#/$defs/positive"
        },
        "final_cleanup_reserve_ms": {
          "$ref": "#/$defs/positive"
        },
        "prepare_ms": {
          "$ref": "#/$defs/positive"
        },
        "case_body_ms": {
          "$ref": "#/$defs/positive"
        },
        "max_case_body_ms": {
          "$ref": "#/$defs/positive"
        },
        "max_producer_ms": {
          "$ref": "#/$defs/positive"
        },
        "case_cleanup_ms": {
          "$ref": "#/$defs/positive"
        },
        "cancel_grace_ms": {
          "$ref": "#/$defs/positive"
        },
        "assert_root_ms": {
          "$ref": "#/$defs/positive"
        },
        "max_processes": {
          "$ref": "#/$defs/positive"
        },
        "max_memory_bytes": {
          "$ref": "#/$defs/positive"
        },
        "max_temp_bytes": {
          "$ref": "#/$defs/positive"
        },
        "max_workspace_entries": {
          "$ref": "#/$defs/positive"
        },
        "max_workspace_depth": {
          "$ref": "#/$defs/positive"
        },
        "max_evidence_bytes": {
          "$ref": "#/$defs/positive"
        },
        "max_stream_bytes": {
          "$ref": "#/$defs/positive"
        },
        "max_run_data_bytes": {
          "$ref": "#/$defs/positive"
        },
        "max_report_bytes": {
          "$ref": "#/$defs/positive"
        },
        "max_receipt_bytes": {
          "$ref": "#/$defs/positive"
        },
        "control_reserve_bytes": {
          "$ref": "#/$defs/positive"
        },
        "available_disk_floor_bytes": {
          "$ref": "#/$defs/positive"
        }
      },
      "required": ["run_wall_ms", "final_cleanup_reserve_ms", "prepare_ms", "case_body_ms", "max_case_body_ms", "max_producer_ms", "case_cleanup_ms", "cancel_grace_ms", "assert_root_ms", "max_processes", "max_memory_bytes", "max_temp_bytes", "max_workspace_entries", "max_workspace_depth", "max_evidence_bytes", "max_stream_bytes", "max_run_data_bytes", "max_report_bytes", "max_receipt_bytes", "control_reserve_bytes", "available_disk_floor_bytes"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "run_id", "budgets"],
  "additionalProperties": false
}
