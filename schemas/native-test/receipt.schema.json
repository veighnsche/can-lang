{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://can-lang.org/schemas/native-test/1/receipt",
  "title": "Native-test owner completion receipt",
  "description": "N's final receipt binding the Can report digest, plan digest and R/N identities, with terminal boundary and released/remaining/forced cleanup facts. Consumers accept only the matching report/receipt pair.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "clockTime": {
      "type": "object",
      "properties": {
        "clock": {
          "type": "string",
          "enum": ["n-monotonic", "wall-utc"]
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["clock", "ms"],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "forcedAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": ["action", "target", "reason"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "report_digest": {
      "$ref": "#/$defs/digest"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "reference_digest": {
      "$ref": "#/$defs/digest"
    },
    "owner_digest": {
      "$ref": "#/$defs/digest"
    },
    "host_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "terminal": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["recover", "prepare", "plan", "active", "quiesce", "clean", "terminal"]
        },
        "at_ms": {
          "$ref": "#/$defs/clockTime"
        }
      },
      "required": ["state", "at_ms"],
      "additionalProperties": false
    },
    "released": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "maxItems": 4096
    },
    "remaining": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "maxItems": 4096
    },
    "forced_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forcedAction"
      },
      "maxItems": 1024
    },
    "cleanup": {
      "type": "string",
      "enum": ["clean", "failed", "unresolved"]
    }
  },
  "required": ["schema_version", "run_id", "report_digest", "plan_digest", "reference_digest", "owner_digest", "host_profile", "terminal", "released", "remaining", "forced_actions", "cleanup"],
  "additionalProperties": false
}
