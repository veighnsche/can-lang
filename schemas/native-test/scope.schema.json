{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://can-lang.org/schemas/native-test/1/scope",
  "title": "Native-test run scope",
  "description": "Binds a run/case/variant/attempt to its mode, purpose, host profile and plan digest.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "variant_id": {
      "$ref": "#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "mode": {
      "type": "string",
      "enum": ["execute", "list", "plan"]
    },
    "purpose": {
      "type": "string",
      "enum": ["execution", "qualification"]
    },
    "host_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": ["run_id", "case_id", "attempt", "mode", "purpose", "host_profile", "plan_digest"],
  "additionalProperties": false
}
