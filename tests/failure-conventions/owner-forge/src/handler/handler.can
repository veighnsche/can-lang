package handler
    provides [tier_view, tier_for, handle_tier]
    uses [ids]
/// The rendered membership tier.
record tier_view
    str name
    bool priority
/// Extracted owner-accepting helper: pure tier mapping over a validated
/// score. Tested through the private factory; never sees raw input.
fn tier_view tier_for
    emits []
    given
        ids::user_id id
    asserts
        gold: call fixture_id(90) => ok tier_view("gold", true)
        silver: call fixture_id(50) => ok tier_view("silver", false)
        bronze: call fixture_id(10) => ok tier_view("bronze", false)
        forged: ids::user_id(7) => ok tier_view("bronze", false)
    match call ids::value(id)
        ok int score => match score > 80
            false => match score > 40
                false => ok tier_view("bronze", false)
                true => ok tier_view("silver", false)
            true => ok tier_view("gold", true)
/// After extraction: parse once, then relay to the helper. Retained
/// end-to-end roots pin the handler contract.
fn tier_view handle_tier
    emits [ids::invalid]
    given
        int raw
    asserts
        gold: 90 => ok tier_view("gold", true)
        silver: 50 => ok tier_view("silver", false)
        bronze: 10 => ok tier_view("bronze", false)
        bad: 0 => ids::invalid(0)
    match call ids::parse(raw)
        ids::invalid
        ok ids::user_id id => relay call tier_for(id)
/// Private factory: the only test path from raw scores to owner values.
/// Unexpected rejection fails closed through the arithmetic trap (the
/// relay argument faults before any call happens), never a forged value.
fn ids::user_id fixture_id
    emits []
    given
        int raw
    asserts
        unit: 1 => ok call fixture_id(1)
    match call ids::parse(raw)
        ids::invalid => relay call fixture_id(1 / 0)
        ok ids::user_id id => ok id
/// Specification probe: the trap surfaces as kind arithmetic.
fn str trap_kind
    emits []
    asserts
        kind: => ok "arithmetic"
    match call fixture_id(0)
        [_] as standard_failure failure => ok failure.kind
        ok ids::user_id id => ok "no-fault"
/// Specification probe: the trap message is the fixed division template.
fn str trap_message
    emits []
    asserts
        text: => ok "arithmetic: integer division by zero"
    match call fixture_id(0)
        [_] as standard_failure failure => ok failure.message
        ok ids::user_id id => ok "no-fault"
