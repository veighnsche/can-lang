package retry
    provides [completed, rejected, outcome, traced, retry, tag]
    uses []
/// A nominal success leaf: the operation produced a value.
record completed<item>
    item value
/// A nominal rejection leaf: the operation produced a failure value.
record rejected<failure>
    failure reason
/// The result-data outcome: success and failure are both plain data, so
/// one helper serves unrelated failure types through generics while every
/// declaration keeps an explicit finite emits bound.
variant outcome<item, failure>
    completed<item>
    rejected<failure>
/// One trace shell: which operation produced the wrapped failure. Layers
/// nest (traced<traced<load_failure>>); the original failure value stays
/// intact at the bottom for root-cause recovery and re-raise.
record traced<failure>
    str operation
    failure cause
/// Bounded retry over result data. Attempts the operation while rejections
/// arrive and attempts remain; returns the first completion or the last
/// rejection. Standard failures are never caught here: they propagate
/// untouched with their occurrence intact (see blast_kind).
fn outcome<item, failure> retry<item, failure, arg>
    emits []
    given
        callable outcome<item, failure> (arg) emits [] operation
        arg input
        int remaining
    asserts
        direct: callable canned, "ok", 2 => ok call canned("ok")
        single: callable canned, "bad", 1 => ok call canned("bad")
    match call operation(input)
        ok outcome<item, failure> first => match first
            completed<item> => ok first
            rejected<failure> => ok first
/// Canned operation for the helper's own rows: deterministic outcomes
/// without fixtures (one function, two modes).
fn outcome<int, str> canned
    emits []
    given
        str mode
    asserts
        good: "ok" => ok completed(7)
        bad: "bad" => ok rejected("down")
    match mode is "ok"
        false => ok rejected("down")
        true => ok completed(7)
/// Tag one failure value with its producing operation (single trace shell).
/// Callers match the outcome and tag the rejected leaf; completed values
/// pass through with a plain ok of the narrowed leaf.
fn traced<failure> tag<failure>
    emits []
    given
        str operation
        failure cause
    asserts
        sample: "load", "boom" => ok traced("load", "boom")
    ok traced(operation, cause)
