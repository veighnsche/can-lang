package i03_example
    provides [occurrence_demo, lease_demo, death_demo]
    uses [i03, late, option, test]

/// Tiny typed I03 example: three worked flows over the late-occurrence
/// wrappers. occurrence_demo runs the occurrence half end to end
/// (select/enroll/gate/emit/seal/observe/tally/outcome); lease_demo
/// runs the lease lifecycle (grant/read/release); death_demo marks the
/// worker dead and reads the counters. Rows are offline/provisional
/// asserts (static until qualified execution); when-stubs pin the
/// wrapper call shapes.

/// Run one worker occurrence lifecycle and return the outcome facts.
fn late::outcome_facts occurrence_demo
    emits {test::stale_handle, late::late_fault}
    given
        test::owner owner
    asserts
        fresh: => ok late::outcome_facts("incomplete", "terminal proof incomplete", option::some("completed"), option::none(), false)
    match call i03::select_alpha(owner)
        when
            fresh: owner => ok late::select_facts("late.alpha", false)
        test::stale_handle
        late::late_fault
        ok late::select_facts selected => match call i03::enroll_worker(owner)
            when
                fresh: owner => ok late::enroll_facts("worker", "late.alpha")
            test::stale_handle
            late::late_fault
            ok late::enroll_facts joined => match call i03::gate_worker(owner)
                when
                    fresh: owner => ok late::gate_facts("worker", 1, false)
                test::stale_handle
                late::late_fault
                ok late::gate_facts gated => match call i03::emit_worker_fault(owner, 1)
                    when
                        fresh: owner, 1 => ok late::event_facts("worker", "late.alpha", "fault", 1, true, [])
                    test::stale_handle
                    late::late_fault
                    ok late::event_facts admitted => match call i03::seal_worker_completed(owner)
                        when
                            fresh: owner => ok late::terminal_facts("worker", "late.alpha", "completed", "sha256:stub")
                        test::stale_handle
                        late::late_fault
                        ok late::terminal_facts sealed => match call i03::observe_worker(owner, 1)
                            when
                                fresh: owner, 1 => ok late::observation_facts("worker", "late.alpha", "fault", 1, true, option::some("completed"), option::some("sha256:stub"))
                            test::stale_handle
                            late::late_fault
                            ok late::observation_facts seen => match call i03::tally_worker(owner)
                                when
                                    fresh: owner => ok late::reconcile_facts("worker", 1, 1, [], 2)
                                test::stale_handle
                                late::late_fault
                                ok late::reconcile_facts tallied => match call i03::read_outcome_now(owner)
                                    when
                                        fresh: owner => ok late::outcome_facts("incomplete", "terminal proof incomplete", option::some("completed"), option::none(), false)
                                    test::stale_handle
                                    ok late::outcome_facts ended => ok ended
/// Run one worker lease lifecycle and return the release facts.
fn late::release_facts lease_demo
    emits {test::stale_handle, late::late_fault}
    given
        test::owner owner
        str lease
    asserts
        first: "llease1" => ok late::release_facts("llease1", "worker", "late.alpha", "completed", "sha256:stub")
    match call i03::lease_worker(owner)
        when
            first: owner => ok late::lease_facts("llease1", "worker", "late.alpha", 1, false)
        test::stale_handle
        late::late_fault
        ok late::lease_facts granted => match call i03::read_lease_worker(owner, lease)
            when
                first: owner, "llease1" => ok late::lease_facts("llease1", "worker", "late.alpha", 1, false)
            test::stale_handle
            late::late_fault
            ok late::lease_facts held => match call i03::free_lease_worker(owner, lease)
                when
                    first: owner, "llease1" => ok late::release_facts("llease1", "worker", "late.alpha", "completed", "sha256:stub")
                test::stale_handle
                late::late_fault
                ok late::release_facts freed => ok freed
/// Mark the worker dead and return the service counters.
fn late::counters death_demo
    emits {test::stale_handle}
    given
        test::owner owner
    asserts
        fresh: => ok late::counters(1, 0, 0, 0, 0, 0, 0, 0, 0)
    match call i03::kill_worker_now(owner)
        when
            fresh: owner => ok late::outcome_facts("incomplete", "worker-dead", option::none(), option::none(), true)
        test::stale_handle
        ok late::outcome_facts killed => match call i03::read_counters_now(owner)
            when
                fresh: owner => ok late::counters(1, 0, 0, 0, 0, 0, 0, 0, 0)
            test::stale_handle
            ok late::counters counted => ok counted
