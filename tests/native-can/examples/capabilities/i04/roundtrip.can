package i04_example
    provides [peer_demo, peer_accept_exchange, http_demo, peer_transfer_demo]
    uses [http, http_peer, i04, option, test]

/// Tiny typed I04 example: both capability flows end to end through the
/// i04 helper package. peer_demo runs declare->dial->accept->write->
/// read->close; http_demo runs request->deliver->read->close. Rows are
/// offline/provisional asserts (static until qualified execution).
/// peer_demo's completed chain is live-tested: no Can expression can
/// construct the dial_result fixture the happy path would need (ws
/// precedent); its rows pin declare-time admission instead, while
/// peer_transfer_demo pins the write->read->close leg statically.

/// Full peer flow: declare a listener, dial it, accept the dialer, run
/// the write->read->close exchange, then close the listener. A failed
/// dial (no connection minted) closes the listener and reports a zero
/// exchange instead of faulting: dial failure is data, not an error.
fn i04::peer_exchange peer_demo
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        str destination
    asserts
        foreign: "peer-evil" => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
        stale: "peer-a" => test::stale_handle{"owner"}
    match call i04::open_listener(owner, destination)
        when
            foreign: owner, destination => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
            stale: owner, destination => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::listener listener => match call i04::dial_peer(owner, destination)
            test::stale_handle
            http_peer::peer_fault
            ok http_peer::dial_result dialed => match call peer_accept_exchange(owner, listener, dialed.connection, [104, 105], 16)
                test::stale_handle
                test::closed_handle
                http_peer::peer_fault
                ok i04::peer_exchange done => ok done
/// Accept-side continuation of peer_demo after a completed dial: when the
/// dial minted no connection, close the listener and report a zero
/// exchange; otherwise accept, run the exchange, and close. Split out so
/// the connection option is a named given: option narrowing refines the
/// matched name (s3 precedent), not a chained field scrutinee.
fn i04::peer_exchange peer_accept_exchange
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::listener listener
        option::value<http_peer::connection> maybe
        int[] bytes
        int max_bytes
    asserts
        dropped: option::none(), [104, 105], 16 => ok i04::peer_exchange(0, [], false, 0)
    match maybe
        option::none => match call i04::close_listener(owner, listener)
            when
                dropped: owner, listener => ok http_peer::listener_close_receipt(0, 0, 0)
            test::stale_handle
            test::closed_handle
            http_peer::peer_fault
            ok http_peer::listener_close_receipt shut => ok i04::peer_exchange(0, [], false, 0)
        option::some => match call i04::accept(owner, listener)
            test::stale_handle
            test::closed_handle
            http_peer::peer_fault
            ok http_peer::connection server => match call i04::run_peer_exchange(owner, maybe.value, server, bytes, max_bytes)
                test::stale_handle
                test::closed_handle
                http_peer::peer_fault
                ok i04::peer_exchange done => match call i04::close_listener(owner, listener)
                    test::stale_handle
                    test::closed_handle
                    http_peer::peer_fault
                    ok http_peer::listener_close_receipt shut => ok done
/// Full http flow: open a POST request, add one header, send one body
/// chunk, then run the end->deliver->read->close exchange.
fn i04::http_exchange http_demo
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        str origin
    asserts
        sample: "origin-a" => ok i04::http_exchange(200, 2, [104, 105], true, 0)
        foreign: "origin-evil" => http_peer::http_fault{"foreign-destination", "origin is not declared"}
        stale: "origin-a" => test::stale_handle{"owner"}
    match call i04::open_request(owner, origin, "POST", "/upload", "1.1")
        when
            sample: owner, origin, "POST", "/upload", "1.1" => ok
            foreign: owner, origin, "POST", "/upload", "1.1" => http_peer::http_fault{"foreign-destination", "origin is not declared"}
            stale: owner, origin, "POST", "/upload", "1.1" => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::http_fault
        ok http_peer::request request => match call i04::add_header(owner, request, "host", "example")
            when
                sample: owner, request, "host", "example" => ok http_peer::header_receipt(1, 15)
            test::stale_handle
            test::closed_handle
            http_peer::http_fault
            ok http_peer::header_receipt first => match call i04::send_body_chunk(owner, request, [104, 105])
                when
                    sample: owner, request, [104, 105] => ok http_peer::body_chunk_receipt(2, 2)
                test::stale_handle
                test::closed_handle
                http_peer::http_fault
                ok http_peer::body_chunk_receipt sent => match call i04::run_http_exchange(owner, request, 200, [http::header("content-type", "text/plain")], [104, 105], 16)
                    when
                        sample: owner, request, 200, [http::header("content-type", "text/plain")], [104, 105], 16 => ok i04::http_exchange(200, 2, [104, 105], true, 0)
                    test::stale_handle
                    test::closed_handle
                    http_peer::http_fault
                    ok i04::http_exchange done => ok done
/// Peer transfer leg with both ends already paired: write, read, close.
/// Pins the write->read->close composition statically; peer_demo covers
/// the declare->dial->accept prefix around it.
fn i04::peer_exchange peer_transfer_demo
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::connection client
        http_peer::connection server
    asserts
        sample: => ok i04::peer_exchange(2, [104, 105], false, 0)
        backpressure: => http_peer::peer_fault{"backpressure", "peer inbound buffer is full"}
        stale: => test::stale_handle{"owner"}
    match call i04::run_peer_exchange(owner, client, server, [104, 105], 16)
        when
            sample: owner, client, server, [104, 105], 16 => ok i04::peer_exchange(2, [104, 105], false, 0)
            backpressure: owner, client, server, [104, 105], 16 => http_peer::peer_fault{"backpressure", "peer inbound buffer is full"}
            stale: owner, client, server, [104, 105], 16 => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok i04::peer_exchange got => ok got
