package i05_example
    provides [frames_demo, close_demo]
    uses [http_peer, i05, option, test]

/// Tiny typed I05 example: two worked flows over the
/// websocket wrappers. frames_demo runs connect, a text
/// send, a text delivery, a poll, and a facts re-read;
/// close_demo runs a local close, the remote close, and a
/// facts re-read showing the terminal state. Rows are
/// offline/provisional asserts (static until qualified
/// execution); when-stubs pin the wrapper call shapes.

/// Connect, send, deliver, poll, and re-read facts.
fn http_peer::ws_connection_facts frames_demo
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
    asserts
        fresh: => ok http_peer::ws_connection_facts("w1", "grant-stub", "ws-a", "open", option::none(), option::none(), 1, 3, 1, 1, 0, 0, 0, 0)
    match call i05::connect(owner, "ws-a")
        when
            fresh: owner, "ws-a" => ok http_peer::ws_connection_handle("websocket", "w1", "grant-stub", "ws-a")
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::ws_connection_handle connected => match call i05::send_text(owner, "w1", [1, 2, 3])
            when
                fresh: owner, "w1", [1, 2, 3] => ok http_peer::ws_send_receipt("text", 3, 1, 3)
            test::stale_handle
            test::closed_handle
            http_peer::peer_fault
            ok http_peer::ws_send_receipt sent => match call i05::deliver_text(owner, "w1", [9, 8])
                when
                    fresh: owner, "w1", [9, 8] => ok http_peer::ws_deliver_receipt("text", 1, 2, 1)
                test::stale_handle
                test::closed_handle
                http_peer::peer_fault
                ok http_peer::ws_deliver_receipt injected => match call i05::poll_event(owner, "w1")
                    when
                        fresh: owner, "w1" => ok http_peer::ws_poll_result(option::some(http_peer::ws_event("text", [9, 8])), 0, 1, 1)
                    test::stale_handle
                    test::closed_handle
                    http_peer::peer_fault
                    ok http_peer::ws_poll_result polled => match call i05::read_facts(owner, "w1")
                        when
                            fresh: owner, "w1" => ok http_peer::ws_connection_facts("w1", "grant-stub", "ws-a", "open", option::none(), option::none(), 1, 3, 1, 1, 0, 0, 0, 0)
                        test::stale_handle
                        http_peer::peer_fault
                        ok http_peer::ws_connection_facts facts => ok facts
/// Close locally, deliver the remote close, re-read facts.
fn http_peer::ws_connection_facts close_demo
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
    asserts
        fresh: => ok http_peer::ws_connection_facts("w1", "grant-stub", "ws-a", "closed", option::some(http_peer::ws_close_facts("local", 1000, "done")), option::some(http_peer::ws_close_facts("remote", 1000, "bye")), 0, 0, 0, 0, 0, 0, 0, 0)
    match call i05::close_local(owner, "w1", 1000, "done")
        when
            fresh: owner, "w1", 1000, "done" => ok http_peer::ws_close_receipt("local", 1000, false, 0, 0)
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::ws_close_receipt local => match call i05::deliver_remote_close(owner, "w1", 1000, "bye")
            when
                fresh: owner, "w1", 1000, "bye" => ok http_peer::ws_close_receipt("remote", 1000, true, 0, 0)
            test::stale_handle
            test::closed_handle
            http_peer::peer_fault
            ok http_peer::ws_close_receipt remote => match call i05::read_facts(owner, "w1")
                when
                    fresh: owner, "w1" => ok http_peer::ws_connection_facts("w1", "grant-stub", "ws-a", "closed", option::some(http_peer::ws_close_facts("local", 1000, "done")), option::some(http_peer::ws_close_facts("remote", 1000, "bye")), 0, 0, 0, 0, 0, 0, 0, 0)
                test::stale_handle
                http_peer::peer_fault
                ok http_peer::ws_connection_facts facts => ok facts
