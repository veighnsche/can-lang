package i13_example
    provides [namespace_demo, row_demo, returning_demo]
    uses [db, i13, test]

/// Tiny typed I13 example: three worked flows over the
/// database-observer wrappers. namespace_demo runs the namespace
/// lifecycle (open/receipt/pin/token/unpin/close); row_demo runs
/// one exact-cell roundtrip (seed/begin/fetch/compare/end);
/// returning_demo runs one RETURNING flow (compile/payload/final
/// records, payload-vs-final and claimed-row comparisons, credit
/// verdict). Rows are offline/provisional asserts (static until
/// qualified execution); when-stubs pin the wrapper call shapes.

/// Run one namespace lifecycle and return the closing receipt read.
fn db::namespace_receipt namespace_demo
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
    asserts
        fresh: => ok db::namespace_receipt("tenant-alpha", "owner-a", "ns-handle:owner-a:tenant-alpha", "sha256:stub", 1)
    match call i13::open_ns(owner, "tenant-alpha")
        when
            fresh: owner, "tenant-alpha" => ok db::namespace_receipt("tenant-alpha", "owner-a", "ns-handle:owner-a:tenant-alpha", "sha256:stub", 0)
        test::stale_handle
        db::db_fault
        ok db::namespace_receipt opened => match call i13::pin_conn(owner, "tenant-alpha", "raw-1")
            when
                fresh: owner, "tenant-alpha", "raw-1" => ok db::connection_facts("raw-1", "tenant-alpha", "owner-a", "sha256:stub", true, false)
            test::stale_handle
            db::db_fault
            ok db::connection_facts pinned => match call i13::conn_token(owner, "tenant-alpha", "raw-1")
                when
                    fresh: owner, "tenant-alpha", "raw-1" => ok "conn-token-stub"
                test::stale_handle
                db::db_fault
                ok str token => match call i13::unpin_conn(owner, "tenant-alpha", "raw-1", token)
                    when
                        fresh: owner, "tenant-alpha", "raw-1", "conn-token-stub" => ok
                    test::stale_handle
                    db::db_fault
                    ok => match call i13::close_ns(owner, "tenant-alpha")
                        when
                            fresh: owner, "tenant-alpha" => ok
                        test::stale_handle
                        db::db_fault
                        ok => match call i13::read_receipt(owner, "tenant-alpha")
                            when
                                fresh: owner, "tenant-alpha" => ok db::namespace_receipt("tenant-alpha", "owner-a", "ns-handle:owner-a:tenant-alpha", "sha256:stub", 1)
                            test::stale_handle
                            db::db_fault
                            ok db::namespace_receipt receipted => ok receipted
/// Seed one exact row, read it back, and compare it against itself.
fn db::row_comparison row_demo
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
    asserts
        fresh: => ok db::row_comparison(true, [])
    match call i13::seed_table(owner, "tenant-alpha", "items", [db::seed_row([db::number_cell("1.10"), db::null_cell()])])
        when
            fresh: owner, "tenant-alpha", "items", [db::seed_row([db::number_cell("1.10"), db::null_cell()])] => ok db::seed_facts("items", 1)
        test::stale_handle
        db::db_fault
        ok db::seed_facts seeded => match call i13::begin_table_read(owner, "tenant-alpha", "raw-1", "conn-token-stub", "items")
            when
                fresh: owner, "tenant-alpha", "raw-1", "conn-token-stub", "items" => ok db::conversation_facts("raw-1:items")
            test::stale_handle
            db::db_fault
            ok db::conversation_facts begun => match call i13::fetch_table(owner, "tenant-alpha", "raw-1", "conn-token-stub", "items")
                when
                    fresh: owner, "tenant-alpha", "raw-1", "conn-token-stub", "items" => ok db::read_facts("raw-1", "tenant-alpha", "items", [db::row_facts(0, [db::number_cell("1.10"), db::null_cell()], "sha256:stub")], 1, "sha256:stub")
                test::stale_handle
                db::db_fault
                ok db::read_facts read => match call i13::compare_cells(owner, [db::number_cell("1.10"), db::null_cell()], [db::number_cell("1.10"), db::null_cell()])
                    when
                        fresh: owner, [db::number_cell("1.10"), db::null_cell()], [db::number_cell("1.10"), db::null_cell()] => ok db::row_comparison(true, [])
                    test::stale_handle
                    ok db::row_comparison compared => match call i13::end_table_read(owner, "tenant-alpha", "raw-1", "conn-token-stub")
                        when
                            fresh: owner, "tenant-alpha", "raw-1", "conn-token-stub" => ok
                        test::stale_handle
                        db::db_fault
                        ok => ok compared
/// Record one compile with payload and final rows, compare them,
/// check one claimed row, and read the never-credit verdict.
fn db::returning_credit_verdict returning_demo
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
    asserts
        fresh: => ok db::returning_credit_verdict(false, "raw RETURNING alone cannot credit C")
    match call i13::record_statement(owner, "d1", "INSERT ... RETURNING id", ["number"])
        when
            fresh: owner, "d1", "INSERT ... RETURNING id", ["number"] => ok db::compile_facts("compile-0", "d1", "sha256:stub", ["number"])
        test::stale_handle
        db::db_fault
        ok db::compile_facts compiled => match call i13::read_compile(owner, "compile-0")
            when
                fresh: owner, "compile-0" => ok db::compile_facts("compile-0", "d1", "sha256:stub", ["number"])
            test::stale_handle
            db::db_fault
            ok db::compile_facts reread => match call i13::record_payload(owner, "compile-0", [db::seed_row([db::number_cell("7")])])
                when
                    fresh: owner, "compile-0", [db::seed_row([db::number_cell("7")])] => ok db::returning_payload_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
                test::stale_handle
                db::db_fault
                ok db::returning_payload_facts payload => match call i13::read_payload(owner, "compile-0")
                    when
                        fresh: owner, "compile-0" => ok db::returning_payload_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
                    test::stale_handle
                    db::db_fault
                    ok db::returning_payload_facts payload_again => match call i13::record_final(owner, "compile-0", [db::seed_row([db::number_cell("7")])])
                        when
                            fresh: owner, "compile-0", [db::seed_row([db::number_cell("7")])] => ok db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
                        test::stale_handle
                        db::db_fault
                        ok db::final_rows_facts final => match call i13::read_final(owner, "compile-0")
                            when
                                fresh: owner, "compile-0" => ok db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
                            test::stale_handle
                            db::db_fault
                            ok db::final_rows_facts final_again => match call i13::compare_payload_final(owner, payload, final)
                                when
                                    fresh: owner, db::returning_payload_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub"), db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok db::returning_comparison(true, [])
                                test::stale_handle
                                db::db_fault
                                ok db::returning_comparison agreed => match call i13::compare_claimed_cells(owner, [db::number_cell("7")], [db::number_cell("7")])
                                    when
                                        fresh: owner, [db::number_cell("7")], [db::number_cell("7")] => ok db::returning_comparison(true, [])
                                    test::stale_handle
                                    ok db::returning_comparison claimed => match call i13::read_credit_verdict(owner)
                                        when
                                            fresh: owner => ok db::returning_credit_verdict(false, "raw RETURNING alone cannot credit C")
                                        test::stale_handle
                                        ok db::returning_credit_verdict verdict => ok verdict
