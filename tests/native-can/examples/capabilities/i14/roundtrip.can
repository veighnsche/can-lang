package i14_example
    provides [entry_demo, full_demo]
    uses [db, i14, test]

/// Tiny typed I14 example: two worked flows over the transaction
/// wrappers. entry_demo runs actor entry and identity re-read;
/// full_demo runs one actor end to end (LAST_INSERT_ID record,
/// re-read and compare, committed-on-postgres settlement,
/// re-read, release, ack re-read). Rows are offline/provisional
/// asserts (static until qualified execution); when-stubs pin the
/// wrapper call shapes.

/// Enter one actor and re-read its identity facts.
fn db::actor_identity_facts entry_demo
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
    asserts
        fresh: => ok db::actor_identity_facts("a1", "conn:a1", "sha256:stub", 0, false, false)
    match call i14::enter_actor(owner, "a1")
        when
            fresh: owner, "a1" => ok db::callback_entry(db::callback_entry_facts("a1", "conn:a1", 0, "sha256:stub"), "txn-token-stub")
        test::stale_handle
        db::db_fault
        ok db::callback_entry entered => match call i14::read_actor(owner, "a1")
            when
                fresh: owner, "a1" => ok db::actor_identity_facts("a1", "conn:a1", "sha256:stub", 0, false, false)
            test::stale_handle
            db::db_fault
            ok db::actor_identity_facts known => ok known
/// Run one actor from entry to release acknowledgment.
fn db::release_record full_demo
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
    asserts
        fresh: => ok db::release_record("a1", "conn:a1", true, "sha256:stub")
    match call i14::record_id(owner, "a1", "txn-token-stub", db::number_cell("42"))
        when
            fresh: owner, "a1", "txn-token-stub", db::number_cell("42") => ok db::last_insert_id_record("a1", "conn:a1", "sha256:stub", db::number_cell("42"), "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::last_insert_id_record bound => match call i14::read_id(owner, "a1")
            when
                fresh: owner, "a1" => ok db::last_insert_id_record("a1", "conn:a1", "sha256:stub", db::number_cell("42"), "sha256:stub")
            test::stale_handle
            db::db_fault
            ok db::last_insert_id_record reread => match call i14::compare_id(owner, reread, db::last_insert_id_claim("a1", "conn:a1", db::number_cell("42")))
                when
                    fresh: owner, db::last_insert_id_record("a1", "conn:a1", "sha256:stub", db::number_cell("42"), "sha256:stub"), db::last_insert_id_claim("a1", "conn:a1", db::number_cell("42")) => ok db::identity_comparison(true, [])
                test::stale_handle
                ok db::identity_comparison agreed => match call i14::settle_committed_postgres(owner, "a1", "txn-token-stub")
                    when
                        fresh: owner, "a1", "txn-token-stub" => ok db::settlement_record("a1", "conn:a1", "committed", "postgres", "sha256:stub")
                    test::stale_handle
                    db::db_fault
                    ok db::settlement_record settled => match call i14::read_settlement(owner, "a1")
                        when
                            fresh: owner, "a1" => ok db::settlement_record("a1", "conn:a1", "committed", "postgres", "sha256:stub")
                        test::stale_handle
                        db::db_fault
                        ok db::settlement_record reread_settlement => match call i14::release_actor(owner, "a1", "txn-token-stub")
                            when
                                fresh: owner, "a1", "txn-token-stub" => ok db::release_record("a1", "conn:a1", true, "sha256:stub")
                            test::stale_handle
                            db::db_fault
                            ok db::release_record freed => match call i14::read_release(owner, "a1")
                                when
                                    fresh: owner, "a1" => ok db::release_record("a1", "conn:a1", true, "sha256:stub")
                                test::stale_handle
                                db::db_fault
                                ok db::release_record acked => ok acked
