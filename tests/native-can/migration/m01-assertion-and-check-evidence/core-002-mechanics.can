package m01core002mechanics
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-002 "bundled assertions: queue/callable/native mechanics + I/O/domain/init boundary".
/// Source: tests/integration/assertions_test.go symbol TestCurrentBundledAssertions.
/// Related fixtures: compiler/testdata/current/assertions/native-slice.can
/// (argument validation, selected/actual rows), queues.can (shared queues,
/// callable capture, exhaustion/leftover rows), plus the inline io_test
/// boundary, errors::failed domain and broken-initializer sources.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): native fixture argument validation, shared queues
/// green, callable mismatch creation path (callable/instance/fixturePaths),
/// exhaustion (missing fixture row 1) and leftover (unused fixture row 2,
/// no argument mismatch), caught external I/O cannot pass a missing fixture,
/// supplied I/O boundary passes, expected domain completion passes, broken
/// initializer fails, strict tsc stays environment-gated.
/// Report shape, green counts and no-publish legs live in
/// core-002-report-shape.can; scope selection and selector refusal live in
/// core-002-selection.can.
/// Variants: bad native arguments, missing/unused shared rows, caught I/O,
/// supplied I/O, domain completion, broken initializer. Fixture-count,
/// selector and bad-value/bad-type variants belong to the sibling files; the
/// strict-tsc variant is environment-gated (CAN_TSC with CAN_BUN) and stays
/// recorded-conditional here, never waived.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. The tsc leg additionally needs
/// CAN_TSC with CAN_BUN. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case bundled/mechanics checks: native-args-validated, queues-green,
/// callable-path, exhaustion-fails, exhaustion-row, leftover-fails,
/// leftover-row, caught-io-fails, supplied-io-green, domain-green,
/// initializer-fails, tsc-gated.
/// Facet map (assertions_test.go legs): native-args-validated pins the bad
/// native arguments leg (L154-158: selected 1,3 becomes 2,3, then exit 1,
/// passed false, "argument mismatch"); queues-green pins the shared queues
/// full run passing (L164-167; the 22 count lives in report-shape);
/// callable-path pins the callable mismatch creation path (L186-190:
/// "argument mismatch" plus "callable":, "instance":, "fixturePaths": keys);
/// exhaustion-fails/exhaustion-row pin shared queue exhaustion (L191-195:
/// "missing fixture" with "row":1); leftover-fails/leftover-row pin the
/// leftover check after losing-participant drain (L196-200: "unused fixture"
/// with "row":2 and NO "argument mismatch"); caught-io-fails pins the caught
/// external boundary (L215-219: exit 1, passed false, "missing fixture", the
/// must-not-be-written payload absent); supplied-io-green pins the supplied
/// I/O boundary (L220-225: exit 0, passed, supplied-completion);
/// domain-green pins expected domain completion (L226-251: errors::failed
/// project passes); initializer-fails pins the broken initializer
/// (L252-257: "int broken = 1 / 0" fails with "initialization failed");
/// tsc-gated pins the strict-tsc leg as conditional on CAN_TSC with CAN_BUN
/// (L168-185; BLOCKED in this session, recorded here, never waived).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool native_args_validated
    bool queues_green
    bool callable_path
    bool exhaustion_fails
    int exhaustion_row
    bool leftover_fails
    int leftover_row
    bool caught_io_fails
    bool supplied_io_green
    bool domain_green
    bool initializer_fails
    bool tsc_gated
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/mechanics", "default", "", "offline"), "native-args-validated" => ok "case bundled/mechanics variant default root native-args-validated run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/mechanics", "default", "", "offline"), "queues-green" => ok evidence("queues-green", "true", "true", true, "case bundled/mechanics variant default root queues-green run offline")
        different: false, true, context("bundled/mechanics", "default", "", "offline"), "queues-green" => failed{"queues-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("bundled/mechanics", "default", "", "offline"), "exhaustion-row" => ok evidence("exhaustion-row", "1", "1", true, "case bundled/mechanics variant default root exhaustion-row run offline")
        different: 0, 1, context("bundled/mechanics", "default", "", "offline"), "exhaustion-row" => failed{"exhaustion-row"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, 1, true, 2, true, true, true, true, true)
        seed_native_args_unchecked: "seed-native-args-unchecked" => ok observation(false, true, true, true, 1, true, 2, true, true, true, true, true)
        seed_queues_red: "seed-queues-red" => ok observation(true, false, true, true, 1, true, 2, true, true, true, true, true)
        seed_callable_bare: "seed-callable-bare" => ok observation(true, true, false, true, 1, true, 2, true, true, true, true, true)
        seed_exhaustion_passed: "seed-exhaustion-passed" => ok observation(true, true, true, false, 1, true, 2, true, true, true, true, true)
        seed_exhaustion_row_missing: "seed-exhaustion-row-missing" => ok observation(true, true, true, true, 0, true, 2, true, true, true, true, true)
        seed_leftover_passed: "seed-leftover-passed" => ok observation(true, true, true, true, 1, false, 2, true, true, true, true, true)
        seed_leftover_row_missing: "seed-leftover-row-missing" => ok observation(true, true, true, true, 1, true, 0, true, true, true, true, true)
        seed_io_leak: "seed-io-leak" => ok observation(true, true, true, true, 1, true, 2, false, true, true, true, true)
        seed_supplied_io_red: "seed-supplied-io-red" => ok observation(true, true, true, true, 1, true, 2, true, false, true, true, true)
        seed_domain_red: "seed-domain-red" => ok observation(true, true, true, true, 1, true, 2, true, true, false, true, true)
        seed_init_green: "seed-init-green" => ok observation(true, true, true, true, 1, true, 2, true, true, true, false, true)
        seed_tsc_waived: "seed-tsc-waived" => ok observation(true, true, true, true, 1, true, 2, true, true, true, true, false)
    match variant_id
        "seed-native-args-unchecked" => ok observation(false, true, true, true, 1, true, 2, true, true, true, true, true)
        "seed-queues-red" => ok observation(true, false, true, true, 1, true, 2, true, true, true, true, true)
        "seed-callable-bare" => ok observation(true, true, false, true, 1, true, 2, true, true, true, true, true)
        "seed-exhaustion-passed" => ok observation(true, true, true, false, 1, true, 2, true, true, true, true, true)
        "seed-exhaustion-row-missing" => ok observation(true, true, true, true, 0, true, 2, true, true, true, true, true)
        "seed-leftover-passed" => ok observation(true, true, true, true, 1, false, 2, true, true, true, true, true)
        "seed-leftover-row-missing" => ok observation(true, true, true, true, 1, true, 0, true, true, true, true, true)
        "seed-io-leak" => ok observation(true, true, true, true, 1, true, 2, false, true, true, true, true)
        "seed-supplied-io-red" => ok observation(true, true, true, true, 1, true, 2, true, false, true, true, true)
        "seed-domain-red" => ok observation(true, true, true, true, 1, true, 2, true, true, false, true, true)
        "seed-init-green" => ok observation(true, true, true, true, 1, true, 2, true, true, true, false, true)
        "seed-tsc-waived" => ok observation(true, true, true, true, 1, true, 2, true, true, true, true, false)
        _ => ok observation(true, true, true, true, 1, true, 2, true, true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m01_002: "m01-002" => ok [check("native-args-validated", "bad native fixture arguments fail with argument mismatch"), check("queues-green", "shared queues full run passes"), check("callable-path", "callable mismatch carries callable/instance/fixturePaths"), check("exhaustion-fails", "exhausted shared queue fails with missing fixture"), check("exhaustion-row", "exhaustion reports row 1"), check("leftover-fails", "leftover fixture fails with unused fixture and no mismatch"), check("leftover-row", "leftover reports row 2"), check("caught-io-fails", "caught external I/O cannot pass a missing fixture"), check("supplied-io-green", "supplied I/O boundary passes with supplied-completion"), check("domain-green", "expected domain completion passes"), check("initializer-fails", "broken initializer fails with initialization failed"), check("tsc-gated", "strict tsc leg stays conditional on CAN_TSC with CAN_BUN")]
        other: "nope" => ok []
    match scope is "m01-002"
        false => ok []
        true => ok [check("native-args-validated", "bad native fixture arguments fail with argument mismatch"), check("queues-green", "shared queues full run passes"), check("callable-path", "callable mismatch carries callable/instance/fixturePaths"), check("exhaustion-fails", "exhausted shared queue fails with missing fixture"), check("exhaustion-row", "exhaustion reports row 1"), check("leftover-fails", "leftover fixture fails with unused fixture and no mismatch"), check("leftover-row", "leftover reports row 2"), check("caught-io-fails", "caught external I/O cannot pass a missing fixture"), check("supplied-io-green", "supplied I/O boundary passes with supplied-completion"), check("domain-green", "expected domain completion passes"), check("initializer-fails", "broken initializer fails with initialization failed"), check("tsc-gated", "strict tsc leg stays conditional on CAN_TSC with CAN_BUN")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/mechanics" => ok [expected_check("native-args-validated", "true"), expected_check("queues-green", "true"), expected_check("callable-path", "true"), expected_check("exhaustion-fails", "true"), expected_check("exhaustion-row", "1"), expected_check("leftover-fails", "true"), expected_check("leftover-row", "2"), expected_check("caught-io-fails", "true"), expected_check("supplied-io-green", "true"), expected_check("domain-green", "true"), expected_check("initializer-fails", "true"), expected_check("tsc-gated", "true")]
        unknown: "nope" => ok []
    match case is "bundled/mechanics"
        false => ok []
        true => ok [expected_check("native-args-validated", "true"), expected_check("queues-green", "true"), expected_check("callable-path", "true"), expected_check("exhaustion-fails", "true"), expected_check("exhaustion-row", "1"), expected_check("leftover-fails", "true"), expected_check("leftover-row", "2"), expected_check("caught-io-fails", "true"), expected_check("supplied-io-green", "true"), expected_check("domain-green", "true"), expected_check("initializer-fails", "true"), expected_check("tsc-gated", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/mechanics", "default", "", "offline") => ok
        seed_native_args_unchecked: context("bundled/mechanics", "seed-native-args-unchecked", "", "offline") => failed{"native-args-validated"}
        seed_queues_red: context("bundled/mechanics", "seed-queues-red", "", "offline") => failed{"queues-green"}
        seed_callable_bare: context("bundled/mechanics", "seed-callable-bare", "", "offline") => failed{"callable-path"}
        seed_exhaustion_passed: context("bundled/mechanics", "seed-exhaustion-passed", "", "offline") => failed{"exhaustion-fails"}
        seed_exhaustion_row_missing: context("bundled/mechanics", "seed-exhaustion-row-missing", "", "offline") => failed{"exhaustion-row"}
        seed_leftover_passed: context("bundled/mechanics", "seed-leftover-passed", "", "offline") => failed{"leftover-fails"}
        seed_leftover_row_missing: context("bundled/mechanics", "seed-leftover-row-missing", "", "offline") => failed{"leftover-row"}
        seed_io_leak: context("bundled/mechanics", "seed-io-leak", "", "offline") => failed{"caught-io-fails"}
        seed_supplied_io_red: context("bundled/mechanics", "seed-supplied-io-red", "", "offline") => failed{"supplied-io-green"}
        seed_domain_red: context("bundled/mechanics", "seed-domain-red", "", "offline") => failed{"domain-green"}
        seed_init_green: context("bundled/mechanics", "seed-init-green", "", "offline") => failed{"initializer-fails"}
        seed_tsc_waived: context("bundled/mechanics", "seed-tsc-waived", "", "offline") => failed{"tsc-gated"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.native_args_validated, true, c, "native-args-validated")
            failed
            ok evidence native_evidence => match call require_bool(got.queues_green, true, c, "queues-green")
                failed
                ok evidence queues_evidence => match call require_bool(got.callable_path, true, c, "callable-path")
                    failed
                    ok evidence callable_evidence => match call require_bool(got.exhaustion_fails, true, c, "exhaustion-fails")
                        failed
                        ok evidence exhaustion_evidence => match call require_int(got.exhaustion_row, 1, c, "exhaustion-row")
                            failed
                            ok evidence exhaustion_row_evidence => match call require_bool(got.leftover_fails, true, c, "leftover-fails")
                                failed
                                ok evidence leftover_evidence => match call require_int(got.leftover_row, 2, c, "leftover-row")
                                    failed
                                    ok evidence leftover_row_evidence => match call require_bool(got.caught_io_fails, true, c, "caught-io-fails")
                                        failed
                                        ok evidence caught_evidence => match call require_bool(got.supplied_io_green, true, c, "supplied-io-green")
                                            failed
                                            ok evidence supplied_evidence => match call require_bool(got.domain_green, true, c, "domain-green")
                                                failed
                                                ok evidence domain_evidence => match call require_bool(got.initializer_fails, true, c, "initializer-fails")
                                                    failed
                                                    ok evidence initializer_evidence => match call require_bool(got.tsc_gated, true, c, "tsc-gated")
                                                        failed
                                                        ok evidence tsc_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m01_002: "m01-002" => ok test_case("bundled/mechanics", ["assertions", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 300000, [check_ref("native-args-validated"), check_ref("queues-green"), check_ref("callable-path"), check_ref("exhaustion-fails"), check_ref("exhaustion-row"), check_ref("leftover-fails"), check_ref("leftover-row"), check_ref("caught-io-fails"), check_ref("supplied-io-green"), check_ref("domain-green"), check_ref("initializer-fails"), check_ref("tsc-gated")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m01-002"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/mechanics", ["assertions", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 300000, [check_ref("native-args-validated"), check_ref("queues-green"), check_ref("callable-path"), check_ref("exhaustion-fails"), check_ref("exhaustion-row"), check_ref("leftover-fails"), check_ref("leftover-row"), check_ref("caught-io-fails"), check_ref("supplied-io-green"), check_ref("domain-green"), check_ref("initializer-fails"), check_ref("tsc-gated")], callable case_body)
