    asserts
        m01_002: "m01-002" => ok [check("report-kind", "report kind pins can.assertion-report"), check("schema-version", "report schemaVersion pins 1"), check("basic-count", "basic full run carries exactly 3 assertions"), check("native-count", "native-slice full run carries exactly 3 assertions"), check("queues-count", "queues full run carries exactly 22 assertions"), check("supplied-marker", "green full runs carry supplied-completion evidence"), check("stderr-separate", "report JSON on stdout with diagnostics on stderr"), check("mismatch-fails", "bad expected value fails with outcome mismatch"), check("static-no-publish", "static mismatch fails without publishing dist/current.json"), check("pipe-fails-closed", "broken report pipe exits 1 with empty stderr")]
        other: "nope" => ok []
