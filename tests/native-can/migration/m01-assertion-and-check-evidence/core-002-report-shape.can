        "seed-queues-short" => ok observation("can.assertion-report", 1, 3, 3, 21, true, true, true, true, true)
        "seed-supplied-gap" => ok observation("can.assertion-report", 1, 3, 3, 22, false, true, true, true, true)
        "seed-stderr-leak" => ok observation("can.assertion-report", 1, 3, 3, 22, true, false, true, true, true)
        "seed-mismatch-passed" => ok observation("can.assertion-report", 1, 3, 3, 22, true, true, false, true, true)
        "seed-published-on-failure" => ok observation("can.assertion-report", 1, 3, 3, 22, true, true, true, false, true)
        "seed-pipe-quiet" => ok observation("can.assertion-report", 1, 3, 3, 22, true, true, true, true, false)
        _ => ok observation("can.assertion-report", 1, 3, 3, 22, true, true, true, true, true)
