        seed_schema_drift: "seed-schema-drift" => ok observation("can.assertion-report", 2, 3, 3, 22, true, true, true, true, true)
        seed_basic_short: "seed-basic-short" => ok observation("can.assertion-report", 1, 2, 3, 22, true, true, true, true, true)
        seed_native_short: "seed-native-short" => ok observation("can.assertion-report", 1, 3, 2, 22, true, true, true, true, true)
        seed_queues_short: "seed-queues-short" => ok observation("can.assertion-report", 1, 3, 3, 21, true, true, true, true, true)
        seed_supplied_gap: "seed-supplied-gap" => ok observation("can.assertion-report", 1, 3, 3, 22, false, true, true, true, true)
        seed_stderr_leak: "seed-stderr-leak" => ok observation("can.assertion-report", 1, 3, 3, 22, true, false, true, true, true)
