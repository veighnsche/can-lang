package m01core002report
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-002 "bundled assertions: structured report shape and green counts".
/// Source: tests/integration/assertions_test.go symbol TestCurrentBundledAssertions.
/// Related fixtures: compiler/testdata/current/assertions/basic.can,
/// native-slice.can, queues.can.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): JSON report kind/schema, green assertion counts per
/// fixture (basic 3, native-slice 3, queues 22), supplied-completion marker,
/// stdout/stderr separation, bad-expected-value mismatch failure, static
/// supplied-mismatch failure without publishing (dist/current.json
/// byte-identical before/after), broken-pipe fails-closed.
/// Selection legs (short/qualified/full selectors, duplicate/ambiguous
/// refusal) live in core-002-selection.can; queue/callable/native-arg and
/// I/O/domain/initializer mechanics live in core-002-mechanics.can.
/// Variants: basic, native-slice, queues fixtures; bad expected value, bad
/// fixture type (the static supplied row). Selector, queues-mutation,
/// caught-I/O, domain and initializer variants belong to the sibling files.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case bundled/report-shape checks: report-kind, schema-version, basic-count,
/// native-count, queues-count, supplied-marker, stderr-separate,
/// mismatch-fails, static-no-publish, pipe-fails-closed.
/// Facet map (assertions_test.go legs): report-kind/schema-version pin the
/// report() helper (L70-80: kind can.assertion-report, schemaVersion 1);
/// basic-count pins the full basic run (L81-88: passed, 3 assertions,
/// supplied-completion); native-count pins the native-slice full run (L146-149:
/// 3 assertions, supplied-completion); queues-count pins the queues full run
/// (L164-167: 22 assertions); supplied-marker pins supplied-completion on
/// green full runs (L86/L147); stderr-separate pins JSON on stdout with empty
/// stderr on green legs (L82/L147/L165) and stderr-held diagnostics on failure
/// legs; mismatch-fails pins the bad expected value leg (L112-116: exit 1,
/// passed false, "outcome mismatch"); static-no-publish pins the static
/// supplied leg (L117-126: exit 1, empty stdout, "fixture" diagnostic,
/// dist/current.json byte-identical); pipe-fails-closed pins the broken
/// stdout pipe leg (L89-105: exit 1, empty stderr).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str report_kind
    int schema_version
    int basic_count
    int native_count
    int queues_count
    bool supplied_marker
    bool stderr_separate
    bool mismatch_fails
    bool static_no_publish
    bool pipe_fails_closed
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/report-shape", "default", "", "offline"), "report-kind" => ok "case bundled/report-shape variant default root report-kind run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/report-shape", "default", "", "offline"), "supplied-marker" => ok evidence("supplied-marker", "true", "true", true, "case bundled/report-shape variant default root supplied-marker run offline")
        different: false, true, context("bundled/report-shape", "default", "", "offline"), "supplied-marker" => failed{"supplied-marker"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("bundled/report-shape", "default", "", "offline"), "basic-count" => ok evidence("basic-count", "3", "3", true, "case bundled/report-shape variant default root basic-count run offline")
        different: 2, 3, context("bundled/report-shape", "default", "", "offline"), "basic-count" => failed{"basic-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can.assertion-report", "can.assertion-report", context("bundled/report-shape", "default", "", "offline"), "report-kind" => ok evidence("report-kind", "can.assertion-report", "can.assertion-report", true, "case bundled/report-shape variant default root report-kind run offline")
        different: "can.report", "can.assertion-report", context("bundled/report-shape", "default", "", "offline"), "report-kind" => failed{"report-kind"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
