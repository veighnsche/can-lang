package m01core003locations
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-003 "failure locations: exact fault-frame spans for both legs".
/// Source: tests/integration/assertions_test.go symbol TestAssertionFailureLocations.
/// Related fixtures: none (both Can sources are inline in the Go test: the
/// int-broken initializer leg and the bytes/io caught-violation leg).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): exact Can source byte span, line and column of the
/// fault frame on each leg (init: "1 / 0" at [53,58) line 4 column 14;
/// caught: "io::stdout_write(payload)" at [281,306) line 10 column 48), the
/// verbatim anchor expressions, and the main.can frame file shared by both
/// legs.
/// Redaction scans live in core-003-redaction.can; rejected status, empty
/// stderr, entry counts, reasons and sticky persistence live in
/// core-003-status-shape.can.
/// Variants: initialization failure, caught io::stdout_write fixture
/// violation. Status, redaction and environment-conditional facets belong
/// to the sibling files.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case locations/spans checks: init-span-start, init-span-end, init-line,
/// init-column, caught-span-start, caught-span-end, caught-line,
/// caught-column, init-expression-text, caught-expression-text, frame-file.
/// Facet map (assertions_test.go legs): init-span-start/init-span-end pin
/// the byte span derivation (L318-319: Index of "1 / 0" plus its length);
/// init-line/init-column pin the line/column derivation (L320-321);
/// caught-span-start/caught-span-end/caught-line/caught-column pin the same
/// derivation for "io::stdout_write(payload)" (L318-321 on the caught leg);
/// init-expression-text/caught-expression-text pin the anchor expressions
/// verbatim (L355/L369); frame-file pins frame["file"] == "main.can" on
/// every entry of both legs (L331).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int init_start
    int init_end
    int init_line
    int init_column
    int caught_start
    int caught_end
    int caught_line
    int caught_column
    str init_expression
    str caught_expression
    str frame_file
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("locations/spans", "default", "", "offline"), "init-span-start" => ok "case locations/spans variant default root init-span-start run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 53, 53, context("locations/spans", "default", "", "offline"), "init-span-start" => ok evidence("init-span-start", "53", "53", true, "case locations/spans variant default root init-span-start run offline")
        different: 52, 53, context("locations/spans", "default", "", "offline"), "init-span-start" => failed{"init-span-start"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "1 / 0", "1 / 0", context("locations/spans", "default", "", "offline"), "init-expression-text" => ok evidence("init-expression-text", "1 / 0", "1 / 0", true, "case locations/spans variant default root init-expression-text run offline")
        different: "2 / 0", "1 / 0", context("locations/spans", "default", "", "offline"), "init-expression-text" => failed{"init-expression-text"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_init_start_drift: "seed-init-start-drift" => ok observation(52, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_init_end_drift: "seed-init-end-drift" => ok observation(53, 59, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_init_line_drift: "seed-init-line-drift" => ok observation(53, 58, 5, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_init_column_drift: "seed-init-column-drift" => ok observation(53, 58, 4, 15, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_caught_start_drift: "seed-caught-start-drift" => ok observation(53, 58, 4, 14, 280, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_caught_end_drift: "seed-caught-end-drift" => ok observation(53, 58, 4, 14, 281, 307, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_caught_line_drift: "seed-caught-line-drift" => ok observation(53, 58, 4, 14, 281, 306, 11, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_caught_column_drift: "seed-caught-column-drift" => ok observation(53, 58, 4, 14, 281, 306, 10, 49, "1 / 0", "io::stdout_write(payload)", "main.can")
        seed_init_expression_empty: "seed-init-expression-empty" => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "", "io::stdout_write(payload)", "main.can")
        seed_caught_expression_empty: "seed-caught-expression-empty" => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "", "main.can")
        seed_frame_file_empty: "seed-frame-file-empty" => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "")
    match variant_id
        "seed-init-start-drift" => ok observation(52, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-init-end-drift" => ok observation(53, 59, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-init-line-drift" => ok observation(53, 58, 5, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-init-column-drift" => ok observation(53, 58, 4, 15, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-caught-start-drift" => ok observation(53, 58, 4, 14, 280, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-caught-end-drift" => ok observation(53, 58, 4, 14, 281, 307, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-caught-line-drift" => ok observation(53, 58, 4, 14, 281, 306, 11, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-caught-column-drift" => ok observation(53, 58, 4, 14, 281, 306, 10, 49, "1 / 0", "io::stdout_write(payload)", "main.can")
        "seed-init-expression-empty" => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "", "io::stdout_write(payload)", "main.can")
        "seed-caught-expression-empty" => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "", "main.can")
        "seed-frame-file-empty" => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "")
        _ => ok observation(53, 58, 4, 14, 281, 306, 10, 48, "1 / 0", "io::stdout_write(payload)", "main.can")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m01_003: "m01-003" => ok [check("init-span-start", "initialization span starts at byte 53"), check("init-span-end", "initialization span ends at byte 58"), check("init-line", "initialization fault sits on line 4"), check("init-column", "initialization fault sits on column 14"), check("caught-span-start", "caught violation span starts at byte 281"), check("caught-span-end", "caught violation span ends at byte 306"), check("caught-line", "caught violation sits on line 10"), check("caught-column", "caught violation sits on column 48"), check("init-expression-text", "initialization span anchors on 1 / 0 verbatim"), check("caught-expression-text", "caught span anchors on io::stdout_write(payload) verbatim"), check("frame-file", "fault frames name main.can on both legs")]
        other: "nope" => ok []
    match scope is "m01-003"
        false => ok []
        true => ok [check("init-span-start", "initialization span starts at byte 53"), check("init-span-end", "initialization span ends at byte 58"), check("init-line", "initialization fault sits on line 4"), check("init-column", "initialization fault sits on column 14"), check("caught-span-start", "caught violation span starts at byte 281"), check("caught-span-end", "caught violation span ends at byte 306"), check("caught-line", "caught violation sits on line 10"), check("caught-column", "caught violation sits on column 48"), check("init-expression-text", "initialization span anchors on 1 / 0 verbatim"), check("caught-expression-text", "caught span anchors on io::stdout_write(payload) verbatim"), check("frame-file", "fault frames name main.can on both legs")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "locations/spans" => ok [expected_check("init-span-start", "53"), expected_check("init-span-end", "58"), expected_check("init-line", "4"), expected_check("init-column", "14"), expected_check("caught-span-start", "281"), expected_check("caught-span-end", "306"), expected_check("caught-line", "10"), expected_check("caught-column", "48"), expected_check("init-expression-text", "1 / 0"), expected_check("caught-expression-text", "io::stdout_write(payload)"), expected_check("frame-file", "main.can")]
        unknown: "nope" => ok []
    match case is "locations/spans"
        false => ok []
        true => ok [expected_check("init-span-start", "53"), expected_check("init-span-end", "58"), expected_check("init-line", "4"), expected_check("init-column", "14"), expected_check("caught-span-start", "281"), expected_check("caught-span-end", "306"), expected_check("caught-line", "10"), expected_check("caught-column", "48"), expected_check("init-expression-text", "1 / 0"), expected_check("caught-expression-text", "io::stdout_write(payload)"), expected_check("frame-file", "main.can")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("locations/spans", "default", "", "offline") => ok
        seed_init_start_drift: context("locations/spans", "seed-init-start-drift", "", "offline") => failed{"init-span-start"}
        seed_init_end_drift: context("locations/spans", "seed-init-end-drift", "", "offline") => failed{"init-span-end"}
        seed_init_line_drift: context("locations/spans", "seed-init-line-drift", "", "offline") => failed{"init-line"}
        seed_init_column_drift: context("locations/spans", "seed-init-column-drift", "", "offline") => failed{"init-column"}
        seed_caught_start_drift: context("locations/spans", "seed-caught-start-drift", "", "offline") => failed{"caught-span-start"}
        seed_caught_end_drift: context("locations/spans", "seed-caught-end-drift", "", "offline") => failed{"caught-span-end"}
        seed_caught_line_drift: context("locations/spans", "seed-caught-line-drift", "", "offline") => failed{"caught-line"}
        seed_caught_column_drift: context("locations/spans", "seed-caught-column-drift", "", "offline") => failed{"caught-column"}
        seed_init_expression_empty: context("locations/spans", "seed-init-expression-empty", "", "offline") => failed{"init-expression-text"}
        seed_caught_expression_empty: context("locations/spans", "seed-caught-expression-empty", "", "offline") => failed{"caught-expression-text"}
        seed_frame_file_empty: context("locations/spans", "seed-frame-file-empty", "", "offline") => failed{"frame-file"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.init_start, 53, c, "init-span-start")
            failed
            ok evidence start_evidence => match call require_int(got.init_end, 58, c, "init-span-end")
                failed
                ok evidence end_evidence => match call require_int(got.init_line, 4, c, "init-line")
                    failed
                    ok evidence line_evidence => match call require_int(got.init_column, 14, c, "init-column")
                        failed
                        ok evidence column_evidence => match call require_int(got.caught_start, 281, c, "caught-span-start")
                            failed
                            ok evidence caught_start_evidence => match call require_int(got.caught_end, 306, c, "caught-span-end")
                                failed
                                ok evidence caught_end_evidence => match call require_int(got.caught_line, 10, c, "caught-line")
                                    failed
                                    ok evidence caught_line_evidence => match call require_int(got.caught_column, 48, c, "caught-column")
                                        failed
                                        ok evidence caught_column_evidence => match call require_text(got.init_expression, "1 / 0", c, "init-expression-text")
                                            failed
                                            ok evidence init_expression_evidence => match call require_text(got.caught_expression, "io::stdout_write(payload)", c, "caught-expression-text")
                                                failed
                                                ok evidence caught_expression_evidence => match call require_text(got.frame_file, "main.can", c, "frame-file")
                                                    failed
                                                    ok evidence file_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m01_003: "m01-003" => ok test_case("locations/spans", ["assertions", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("init-span-start"), check_ref("init-span-end"), check_ref("init-line"), check_ref("init-column"), check_ref("caught-span-start"), check_ref("caught-span-end"), check_ref("caught-line"), check_ref("caught-column"), check_ref("init-expression-text"), check_ref("caught-expression-text"), check_ref("frame-file")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m01-003"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("locations/spans", ["assertions", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("init-span-start"), check_ref("init-span-end"), check_ref("init-line"), check_ref("init-column"), check_ref("caught-span-start"), check_ref("caught-span-end"), check_ref("caught-line"), check_ref("caught-column"), check_ref("init-expression-text"), check_ref("caught-expression-text"), check_ref("frame-file")], callable case_body)
