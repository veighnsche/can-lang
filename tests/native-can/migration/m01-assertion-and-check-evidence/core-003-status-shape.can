        false => ok []
        true => ok [check("init-exit-rejected", "initialization leg exits 1"), check("caught-exit-rejected", "caught leg exits 1 despite the source catch"), check("init-stderr-empty", "initialization leg keeps stderr empty"), check("caught-stderr-empty", "caught leg keeps stderr empty"), check("init-entries-two", "initialization failure reports both roots"), check("init-reason", "initialization entries carry initialization failed"), check("caught-reason", "caught entries carry harness violation"), check("caught-missing-fixture", "caught stdout names the missing fixture"), check("caught-entries-present", "caught leg reports at least one entry"), check("init-report-parses", "initialization stdout parses as an assertion report"), check("caught-report-parses", "caught stdout parses as an assertion report"), check("sticky-persists", "source catch does not clear the sticky violation")]
