        true => ok test_case("status-shape/rejected", ["assertions", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("init-exit-rejected"), check_ref("caught-exit-rejected"), check_ref("init-stderr-empty"), check_ref("caught-stderr-empty"), check_ref("init-entries-two"), check_ref("init-reason"), check_ref("caught-reason"), check_ref("caught-missing-fixture"), check_ref("caught-entries-present"), check_ref("init-report-parses"), check_ref("caught-report-parses"), check_ref("sticky-persists")], callable case_body)
