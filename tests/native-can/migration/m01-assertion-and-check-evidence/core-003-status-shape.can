        true => ok [expected_check("init-exit-rejected", "true"), expected_check("caught-exit-rejected", "true"), expected_check("init-stderr-empty", "true"), expected_check("caught-stderr-empty", "true"), expected_check("init-entries-two", "2"), expected_check("init-reason", "initialization failed"), expected_check("caught-reason", "harness violation"), expected_check("caught-missing-fixture", "true"), expected_check("caught-entries-present", "true"), expected_check("init-report-parses", "true"), expected_check("caught-report-parses", "true"), expected_check("sticky-persists", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("status-shape/rejected", "default", "", "offline") => ok
        seed_init_exit_zero: context("status-shape/rejected", "seed-init-exit-zero", "", "offline") => failed{"init-exit-rejected"}
        seed_caught_exit_zero: context("status-shape/rejected", "seed-caught-exit-zero", "", "offline") => failed{"caught-exit-rejected"}
        seed_init_diag: context("status-shape/rejected", "seed-init-diag", "", "offline") => failed{"init-stderr-empty"}
        seed_caught_diag: context("status-shape/rejected", "seed-caught-diag", "", "offline") => failed{"caught-stderr-empty"}
        seed_init_single_root: context("status-shape/rejected", "seed-init-single-root", "", "offline") => failed{"init-entries-two"}
        seed_init_reason_drift: context("status-shape/rejected", "seed-init-reason-drift", "", "offline") => failed{"init-reason"}
        seed_caught_reason_drift: context("status-shape/rejected", "seed-caught-reason-drift", "", "offline") => failed{"caught-reason"}
        seed_fixture_silent: context("status-shape/rejected", "seed-fixture-silent", "", "offline") => failed{"caught-missing-fixture"}
        seed_caught_empty: context("status-shape/rejected", "seed-caught-empty", "", "offline") => failed{"caught-entries-present"}
        seed_init_garbled: context("status-shape/rejected", "seed-init-garbled", "", "offline") => failed{"init-report-parses"}
        seed_caught_garbled: context("status-shape/rejected", "seed-caught-garbled", "", "offline") => failed{"caught-report-parses"}
        seed_sticky_cleared: context("status-shape/rejected", "seed-sticky-cleared", "", "offline") => failed{"sticky-persists"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.init_exit_rejected, true, c, "init-exit-rejected")
            failed
            ok evidence init_exit_evidence => match call require_bool(got.caught_exit_rejected, true, c, "caught-exit-rejected")
                failed
                ok evidence caught_exit_evidence => match call require_bool(got.init_stderr_empty, true, c, "init-stderr-empty")
                    failed
                    ok evidence init_stderr_evidence => match call require_bool(got.caught_stderr_empty, true, c, "caught-stderr-empty")
                        failed
                        ok evidence caught_stderr_evidence => match call require_int(got.init_entries, 2, c, "init-entries-two")
                            failed
                            ok evidence entries_evidence => match call require_text(got.init_reason, "initialization failed", c, "init-reason")
                                failed
                                ok evidence init_reason_evidence => match call require_text(got.caught_reason, "harness violation", c, "caught-reason")
                                    failed
                                    ok evidence caught_reason_evidence => match call require_bool(got.caught_missing_fixture, true, c, "caught-missing-fixture")
                                        failed
                                        ok evidence fixture_evidence => match call require_bool(got.caught_entries_present, true, c, "caught-entries-present")
                                            failed
                                            ok evidence entries_present_evidence => match call require_bool(got.init_report_parses, true, c, "init-report-parses")
                                                failed
                                                ok evidence init_parse_evidence => match call require_bool(got.caught_report_parses, true, c, "caught-report-parses")
                                                    failed
                                                    ok evidence caught_parse_evidence => match call require_bool(got.sticky_persists, true, c, "sticky-persists")
                                                        failed
                                                        ok evidence sticky_evidence => ok
