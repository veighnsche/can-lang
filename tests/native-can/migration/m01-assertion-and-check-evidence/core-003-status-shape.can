        "seed-init-diag" => ok observation(true, true, false, true, 2, "initialization failed", "harness violation", true, true, true, true, true)
        "seed-caught-diag" => ok observation(true, true, true, false, 2, "initialization failed", "harness violation", true, true, true, true, true)
        "seed-init-single-root" => ok observation(true, true, true, true, 1, "initialization failed", "harness violation", true, true, true, true, true)
        "seed-init-reason-drift" => ok observation(true, true, true, true, 2, "harness violation", "harness violation", true, true, true, true, true)
        "seed-caught-reason-drift" => ok observation(true, true, true, true, 2, "initialization failed", "initialization failed", true, true, true, true, true)
        "seed-fixture-silent" => ok observation(true, true, true, true, 2, "initialization failed", "harness violation", false, true, true, true, true)
        "seed-caught-empty" => ok observation(true, true, true, true, 2, "initialization failed", "harness violation", true, false, true, true, true)
        "seed-init-garbled" => ok observation(true, true, true, true, 2, "initialization failed", "harness violation", true, true, false, true, true)
        "seed-caught-garbled" => ok observation(true, true, true, true, 2, "initialization failed", "harness violation", true, true, true, false, true)
        "seed-sticky-cleared" => ok observation(true, true, true, true, 2, "initialization failed", "harness violation", true, true, true, true, false)
        _ => ok observation(true, true, true, true, 2, "initialization failed", "harness violation", true, true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m01_003: "m01-003" => ok [check("init-exit-rejected", "initialization leg exits 1"), check("caught-exit-rejected", "caught leg exits 1 despite the source catch"), check("init-stderr-empty", "initialization leg keeps stderr empty"), check("caught-stderr-empty", "caught leg keeps stderr empty"), check("init-entries-two", "initialization failure reports both roots"), check("init-reason", "initialization entries carry initialization failed"), check("caught-reason", "caught entries carry harness violation"), check("caught-missing-fixture", "caught stdout names the missing fixture"), check("caught-entries-present", "caught leg reports at least one entry"), check("init-report-parses", "initialization stdout parses as an assertion report"), check("caught-report-parses", "caught stdout parses as an assertion report"), check("sticky-persists", "source catch does not clear the sticky violation")]
        other: "nope" => ok []
