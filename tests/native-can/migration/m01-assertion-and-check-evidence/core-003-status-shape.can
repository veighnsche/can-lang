package m01core003status
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-003 "failure locations: rejected status, entries and sticky persistence".
/// Source: tests/integration/assertions_test.go symbol TestAssertionFailureLocations.
/// Related fixtures: none (both Can sources are inline in the Go test: the
/// two-root int-broken initializer leg and the single-root guarded
/// bytes/io caught-violation leg).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): both legs exit 1 with empty stderr, stdout parses
/// as an assertion report, the init leg reports exactly 2 entries (both
/// roots) with reason "initialization failed", the caught leg reports at
/// least one entry with reason "harness violation" plus "missing fixture"
/// on stdout, and the source-level catch does not clear the sticky
/// violation.
/// Exact fault-frame spans live in core-003-locations.can; redaction scans
/// live in core-003-redaction.can.
/// Variants: initialization failure, caught io::stdout_write fixture
/// violation. Span, redaction and environment-conditional facets belong to
/// the sibling files.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case status-shape/rejected checks: init-exit-rejected,
/// caught-exit-rejected, init-stderr-empty, caught-stderr-empty,
/// init-entries-two, init-reason, caught-reason, caught-missing-fixture,
/// caught-entries-present, init-report-parses, caught-report-parses,
/// sticky-persists.
/// Facet map (assertions_test.go legs): init-exit-rejected/
/// caught-exit-rejected/init-stderr-empty/caught-stderr-empty pin the
/// status gate (L298-300: exit 1, empty stderr, both legs);
/// init-report-parses/caught-report-parses pin stdout parsing as a JSON
/// report (L301-304); init-entries-two pins both roots reporting init
/// failure (L312-314: exactly 2 entries); caught-entries-present pins the
/// non-empty entries gate on the caught leg (L305-308); init-reason/
/// caught-reason pin the per-entry reasons (L309-324: "initialization
/// failed" vs "harness violation"); caught-missing-fixture pins the
/// "missing fixture" stdout marker (L315-317); sticky-persists pins the
/// suite comment (L260-261: mapping survives a source catch of a sticky
/// harness violation) on the guarded leg (L356-369: the source catches
/// io::write_failed yet the report stays rejected).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool init_exit_rejected
    bool caught_exit_rejected
    bool init_stderr_empty
    bool caught_stderr_empty
    int init_entries
    str init_reason
    str caught_reason
    bool caught_missing_fixture
    bool caught_entries_present
    bool init_report_parses
    bool caught_report_parses
    bool sticky_persists
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("status-shape/rejected", "default", "", "offline"), "init-exit-rejected" => ok "case status-shape/rejected variant default root init-exit-rejected run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("status-shape/rejected", "default", "", "offline"), "init-exit-rejected" => ok evidence("init-exit-rejected", "true", "true", true, "case status-shape/rejected variant default root init-exit-rejected run offline")
        different: false, true, context("status-shape/rejected", "default", "", "offline"), "init-exit-rejected" => failed{"init-exit-rejected"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("status-shape/rejected", "default", "", "offline"), "init-entries-two" => ok evidence("init-entries-two", "2", "2", true, "case status-shape/rejected variant default root init-entries-two run offline")
        different: 1, 2, context("status-shape/rejected", "default", "", "offline"), "init-entries-two" => failed{"init-entries-two"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "initialization failed", "initialization failed", context("status-shape/rejected", "default", "", "offline"), "init-reason" => ok evidence("init-reason", "initialization failed", "initialization failed", true, "case status-shape/rejected variant default root init-reason run offline")
        different: "harness violation", "initialization failed", context("status-shape/rejected", "default", "", "offline"), "init-reason" => failed{"init-reason"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
