package m01core006shape
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-006 "bundled checks: require reason, occurrence and JSON preservation".
/// Source: tests/integration/checks_test.go symbol TestCurrentBundledChecks.
/// Related oracles: runtime/test/checks.test.ts (the 5 staged bun tests),
/// compiler/testdata/current/checks/main.can (the 7-row assert fixture).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): require(true) completes void, require(false)
/// yields checks::failed with the exact authored reason, declaration name
/// checks::failed, emitted provenance boundary, call-site origin span
/// (source/start/end), invocation path in private occurrence metadata,
/// check JSON payload preserved exactly through the report.
/// Hostile-reason validation, caught failures and the sticky harness
/// violation live in core-006-hostile-reasons.can; main fixture rows, the
/// staged-trace count and the silent production run live in
/// core-006-main-fixture.can.
/// Variants: true/false condition, authored reason text. Hostile reasons,
/// caught failures, fixture rows and tsc gating belong to the sibling files.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-007 (staged runtime/checks.test.ts).
/// Execution credit: NOT claimed (accept_after P23, QN1).
/// Case bundled/check-shape checks: true-green, false-reason, failed-decl,
/// emitted-boundary, origin-source, origin-start, origin-end,
/// invocation-path, payload-exact.
/// Facet map (checks.test.ts tests): true-green/false-reason pin test 1
/// (L52-62: require(true) completes void, require(false) yields
/// checks::failed with "reason text"); failed-decl pins the declaration
/// name (L58-59); emitted-boundary pins the provenance (L61: boundary
/// "emitted"); origin-source/origin-start/origin-end pin the call-site span
/// (L64-70: source "checks.test.ts", start 11, end 42); invocation-path
/// pins the invocation (L69: ["can.project.root/checks::guard#0"]);
/// payload-exact pins exact payload JSON (L70: {"reason":"traced"}) with
/// occurrence metadata staying private.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool true_green
    bool false_reason
    str failed_decl
    bool emitted_boundary
    str origin_source
    int origin_start
    int origin_end
    bool invocation_path
    bool payload_exact
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/check-shape", "default", "", "offline"), "true-green" => ok "case bundled/check-shape variant default root true-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/check-shape", "default", "", "offline"), "true-green" => ok evidence("true-green", "true", "true", true, "case bundled/check-shape variant default root true-green run offline")
        different: false, true, context("bundled/check-shape", "default", "", "offline"), "true-green" => failed{"true-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 11, 11, context("bundled/check-shape", "default", "", "offline"), "origin-start" => ok evidence("origin-start", "11", "11", true, "case bundled/check-shape variant default root origin-start run offline")
        different: 10, 11, context("bundled/check-shape", "default", "", "offline"), "origin-start" => failed{"origin-start"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "checks::failed", "checks::failed", context("bundled/check-shape", "default", "", "offline"), "failed-decl" => ok evidence("failed-decl", "checks::failed", "checks::failed", true, "case bundled/check-shape variant default root failed-decl run offline")
        different: "checks::broken", "checks::failed", context("bundled/check-shape", "default", "", "offline"), "failed-decl" => failed{"failed-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 42, true, true)
        seed_true_red: "seed-true-red" => ok observation(false, true, "checks::failed", true, "checks.test.ts", 11, 42, true, true)
        seed_false_green: "seed-false-green" => ok observation(true, false, "checks::failed", true, "checks.test.ts", 11, 42, true, true)
        seed_decl_drift: "seed-decl-drift" => ok observation(true, true, "checks::broken", true, "checks.test.ts", 11, 42, true, true)
        seed_boundary_drift: "seed-boundary-drift" => ok observation(true, true, "checks::failed", false, "checks.test.ts", 11, 42, true, true)
        seed_source_drift: "seed-source-drift" => ok observation(true, true, "checks::failed", true, "other.test.ts", 11, 42, true, true)
        seed_start_drift: "seed-start-drift" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 10, 42, true, true)
        seed_end_drift: "seed-end-drift" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 43, true, true)
        seed_invocation_drift: "seed-invocation-drift" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 42, false, true)
        seed_payload_leak: "seed-payload-leak" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 42, true, false)
    match variant_id
        "seed-true-red" => ok observation(false, true, "checks::failed", true, "checks.test.ts", 11, 42, true, true)
        "seed-false-green" => ok observation(true, false, "checks::failed", true, "checks.test.ts", 11, 42, true, true)
        "seed-decl-drift" => ok observation(true, true, "checks::broken", true, "checks.test.ts", 11, 42, true, true)
        "seed-boundary-drift" => ok observation(true, true, "checks::failed", false, "checks.test.ts", 11, 42, true, true)
        "seed-source-drift" => ok observation(true, true, "checks::failed", true, "other.test.ts", 11, 42, true, true)
        "seed-start-drift" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 10, 42, true, true)
        "seed-end-drift" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 43, true, true)
        "seed-invocation-drift" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 42, false, true)
        "seed-payload-leak" => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 42, true, false)
        _ => ok observation(true, true, "checks::failed", true, "checks.test.ts", 11, 42, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m01_006: "m01-006" => ok [check("true-green", "require(true) completes void"), check("false-reason", "require(false) yields checks::failed with the exact reason"), check("failed-decl", "failure declaration pins checks::failed"), check("emitted-boundary", "failure provenance pins the emitted boundary"), check("origin-source", "call-site origin pins checks.test.ts"), check("origin-start", "call-site origin pins start 11"), check("origin-end", "call-site origin pins end 42"), check("invocation-path", "occurrence keeps the invocation path private"), check("payload-exact", "check JSON payload preserves exactly the reason")]
        other: "nope" => ok []
    match scope is "m01-006"
        false => ok []
        true => ok [check("true-green", "require(true) completes void"), check("false-reason", "require(false) yields checks::failed with the exact reason"), check("failed-decl", "failure declaration pins checks::failed"), check("emitted-boundary", "failure provenance pins the emitted boundary"), check("origin-source", "call-site origin pins checks.test.ts"), check("origin-start", "call-site origin pins start 11"), check("origin-end", "call-site origin pins end 42"), check("invocation-path", "occurrence keeps the invocation path private"), check("payload-exact", "check JSON payload preserves exactly the reason")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/check-shape" => ok [expected_check("true-green", "true"), expected_check("false-reason", "true"), expected_check("failed-decl", "checks::failed"), expected_check("emitted-boundary", "true"), expected_check("origin-source", "checks.test.ts"), expected_check("origin-start", "11"), expected_check("origin-end", "42"), expected_check("invocation-path", "true"), expected_check("payload-exact", "true")]
        unknown: "nope" => ok []
    match case is "bundled/check-shape"
        false => ok []
        true => ok [expected_check("true-green", "true"), expected_check("false-reason", "true"), expected_check("failed-decl", "checks::failed"), expected_check("emitted-boundary", "true"), expected_check("origin-source", "checks.test.ts"), expected_check("origin-start", "11"), expected_check("origin-end", "42"), expected_check("invocation-path", "true"), expected_check("payload-exact", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/check-shape", "default", "", "offline") => ok
        seed_true_red: context("bundled/check-shape", "seed-true-red", "", "offline") => failed{"true-green"}
        seed_false_green: context("bundled/check-shape", "seed-false-green", "", "offline") => failed{"false-reason"}
        seed_decl_drift: context("bundled/check-shape", "seed-decl-drift", "", "offline") => failed{"failed-decl"}
        seed_boundary_drift: context("bundled/check-shape", "seed-boundary-drift", "", "offline") => failed{"emitted-boundary"}
        seed_source_drift: context("bundled/check-shape", "seed-source-drift", "", "offline") => failed{"origin-source"}
        seed_start_drift: context("bundled/check-shape", "seed-start-drift", "", "offline") => failed{"origin-start"}
        seed_end_drift: context("bundled/check-shape", "seed-end-drift", "", "offline") => failed{"origin-end"}
        seed_invocation_drift: context("bundled/check-shape", "seed-invocation-drift", "", "offline") => failed{"invocation-path"}
        seed_payload_leak: context("bundled/check-shape", "seed-payload-leak", "", "offline") => failed{"payload-exact"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.true_green, true, c, "true-green")
            failed
            ok evidence true_evidence => match call require_bool(got.false_reason, true, c, "false-reason")
                failed
                ok evidence false_evidence => match call require_text(got.failed_decl, "checks::failed", c, "failed-decl")
                    failed
                    ok evidence decl_evidence => match call require_bool(got.emitted_boundary, true, c, "emitted-boundary")
                        failed
                        ok evidence boundary_evidence => match call require_text(got.origin_source, "checks.test.ts", c, "origin-source")
                            failed
                            ok evidence source_evidence => match call require_int(got.origin_start, 11, c, "origin-start")
                                failed
                                ok evidence start_evidence => match call require_int(got.origin_end, 42, c, "origin-end")
                                    failed
                                    ok evidence end_evidence => match call require_bool(got.invocation_path, true, c, "invocation-path")
                                        failed
                                        ok evidence invocation_evidence => match call require_bool(got.payload_exact, true, c, "payload-exact")
                                            failed
                                            ok evidence payload_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m01_006: "m01-006" => ok test_case("bundled/check-shape", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("true-green"), check_ref("false-reason"), check_ref("failed-decl"), check_ref("emitted-boundary"), check_ref("origin-source"), check_ref("origin-start"), check_ref("origin-end"), check_ref("invocation-path"), check_ref("payload-exact")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m01-006"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/check-shape", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("true-green"), check_ref("false-reason"), check_ref("failed-decl"), check_ref("emitted-boundary"), check_ref("origin-source"), check_ref("origin-start"), check_ref("origin-end"), check_ref("invocation-path"), check_ref("payload-exact")], callable case_body)
