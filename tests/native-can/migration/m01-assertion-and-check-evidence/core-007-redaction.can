package m01core007redaction
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-007 "mismatch span: redaction of private root and bundle paths".
/// Source: tests/integration/checks_test.go symbol TestChecksMismatchSpan.
/// Related fixtures: none (the forbidden strings are the harness temp
/// workspace path and the bundle path behind the failed assert run).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the failed assert report stdout omits the private
/// temp workspace root and the private bundle path; the scan covers the
/// failed report stdout.
/// Exact require span, reason call site and frame file live in
/// core-007-span.can; rejected status, empty stderr, report shape, reasons,
/// evidence labels and frame presence live in core-007-report-shape.can.
/// Variants: one failing decoded-value require (the scan runs over its
/// failed report stdout). Span, status and environment-conditional facets
/// belong to the sibling files.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case mismatch/redaction checks: root-omitted, bundle-omitted,
/// report-scanned.
/// Facet map (checks_test.go): root-omitted/bundle-omitted pin the temp
/// workspace and bundle path absence (L199-203: root, bundle);
/// report-scanned pins the scan running over the failed assert report
/// stdout (L199: strings.Contains over out.String()).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool root_omitted
    bool bundle_omitted
    bool report_scanned
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("mismatch/redaction", "default", "", "offline"), "root-omitted" => ok "case mismatch/redaction variant default root root-omitted run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("mismatch/redaction", "default", "", "offline"), "root-omitted" => ok evidence("root-omitted", "true", "true", true, "case mismatch/redaction variant default root root-omitted run offline")
        different: false, true, context("mismatch/redaction", "default", "", "offline"), "root-omitted" => failed{"root-omitted"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true)
        seed_root_leaked: "seed-root-leaked" => ok observation(false, true, true)
        seed_bundle_leaked: "seed-bundle-leaked" => ok observation(true, false, true)
        seed_report_unscanned: "seed-report-unscanned" => ok observation(true, true, false)
    match variant_id
        "seed-root-leaked" => ok observation(false, true, true)
        "seed-bundle-leaked" => ok observation(true, false, true)
        "seed-report-unscanned" => ok observation(true, true, false)
        _ => ok observation(true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m01_007: "m01-007" => ok [check("root-omitted", "failure output omits the private workspace path"), check("bundle-omitted", "failure output omits the private bundle path"), check("report-scanned", "redaction scan covers the failed report stdout")]
        other: "nope" => ok []
    match scope is "m01-007"
        false => ok []
        true => ok [check("root-omitted", "failure output omits the private workspace path"), check("bundle-omitted", "failure output omits the private bundle path"), check("report-scanned", "redaction scan covers the failed report stdout")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "mismatch/redaction" => ok [expected_check("root-omitted", "true"), expected_check("bundle-omitted", "true"), expected_check("report-scanned", "true")]
        unknown: "nope" => ok []
    match case is "mismatch/redaction"
        false => ok []
        true => ok [expected_check("root-omitted", "true"), expected_check("bundle-omitted", "true"), expected_check("report-scanned", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("mismatch/redaction", "default", "", "offline") => ok
        seed_root_leaked: context("mismatch/redaction", "seed-root-leaked", "", "offline") => failed{"root-omitted"}
        seed_bundle_leaked: context("mismatch/redaction", "seed-bundle-leaked", "", "offline") => failed{"bundle-omitted"}
        seed_report_unscanned: context("mismatch/redaction", "seed-report-unscanned", "", "offline") => failed{"report-scanned"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.root_omitted, true, c, "root-omitted")
            failed
            ok evidence root_evidence => match call require_bool(got.bundle_omitted, true, c, "bundle-omitted")
                failed
                ok evidence bundle_evidence => match call require_bool(got.report_scanned, true, c, "report-scanned")
                    failed
                    ok evidence scan_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m01_007: "m01-007" => ok test_case("mismatch/redaction", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("root-omitted"), check_ref("bundle-omitted"), check_ref("report-scanned")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m01-007"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("mismatch/redaction", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("root-omitted"), check_ref("bundle-omitted"), check_ref("report-scanned")], callable case_body)
