package m01core007report
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-007 "mismatch span: rejected status, report shape and real-can evidence".
/// Source: tests/integration/checks_test.go symbol TestChecksMismatchSpan.
/// Related fixtures: none (the Can source is inline in the Go test: the
/// guarded bytes/codec/checks program with one failing decoded-value
/// require over the sample root).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the failing run exits 1 with empty stderr,
/// stdout parses as an assertion report that stays unpassed, the failing
/// sample entry carries reason "outcome mismatch" with exactly one
/// evidence label "real-can", and the frames carry the exact require span.
/// Exact require span, reason call site and frame file live in
/// core-007-span.can; redaction scans live in core-007-redaction.can.
/// Variants: one failing decoded-value require. Span, redaction and
/// environment-conditional facets belong to the sibling files.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case mismatch/report checks: exit-rejected, stderr-empty,
/// report-parses, passed-false, failed-root, failed-reason,
/// evidence-count, evidence-label, frame-found.
/// Facet map (checks_test.go): exit-rejected/stderr-empty pin the status
/// gate (L157-160: exit 1, empty stderr); report-parses pins stdout
/// parsing as a JSON report (L161-164); passed-false pins passed == false
/// (L165-167); failed-root/failed-reason pin the failing entry selection
/// and reason (L168-177: root "sample", reason "outcome mismatch");
/// evidence-count/evidence-label pin real execution evidence (L178-184:
/// exactly ["real-can"]); frame-found pins the exact-span frame gate
/// (L189-198: the found flag must hold).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool exit_rejected
    bool stderr_empty
    bool report_parses
    bool passed_false
    str failed_root
    str failed_reason
    int evidence_count
    str evidence_label
    bool frame_found
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("mismatch/report", "default", "", "offline"), "exit-rejected" => ok "case mismatch/report variant default root exit-rejected run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("mismatch/report", "default", "", "offline"), "exit-rejected" => ok evidence("exit-rejected", "true", "true", true, "case mismatch/report variant default root exit-rejected run offline")
        different: false, true, context("mismatch/report", "default", "", "offline"), "exit-rejected" => failed{"exit-rejected"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("mismatch/report", "default", "", "offline"), "evidence-count" => ok evidence("evidence-count", "1", "1", true, "case mismatch/report variant default root evidence-count run offline")
        different: 0, 1, context("mismatch/report", "default", "", "offline"), "evidence-count" => failed{"evidence-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "sample", "sample", context("mismatch/report", "default", "", "offline"), "failed-root" => ok evidence("failed-root", "sample", "sample", true, "case mismatch/report variant default root failed-root run offline")
        different: "empty", "sample", context("mismatch/report", "default", "", "offline"), "failed-root" => failed{"failed-root"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, "sample", "outcome mismatch", 1, "real-can", true)
        seed_exit_zero: "seed-exit-zero" => ok observation(false, true, true, true, "sample", "outcome mismatch", 1, "real-can", true)
        seed_diag: "seed-diag" => ok observation(true, false, true, true, "sample", "outcome mismatch", 1, "real-can", true)
        seed_garbled: "seed-garbled" => ok observation(true, true, false, true, "sample", "outcome mismatch", 1, "real-can", true)
        seed_passed_true: "seed-passed-true" => ok observation(true, true, true, false, "sample", "outcome mismatch", 1, "real-can", true)
        seed_root_empty: "seed-root-empty" => ok observation(true, true, true, true, "", "outcome mismatch", 1, "real-can", true)
        seed_reason_empty: "seed-reason-empty" => ok observation(true, true, true, true, "sample", "", 1, "real-can", true)
        seed_evidence_empty: "seed-evidence-empty" => ok observation(true, true, true, true, "sample", "outcome mismatch", 0, "real-can", true)
        seed_label_empty: "seed-label-empty" => ok observation(true, true, true, true, "sample", "outcome mismatch", 1, "", true)
        seed_frame_missing: "seed-frame-missing" => ok observation(true, true, true, true, "sample", "outcome mismatch", 1, "real-can", false)
    match variant_id
        "seed-exit-zero" => ok observation(false, true, true, true, "sample", "outcome mismatch", 1, "real-can", true)
        "seed-diag" => ok observation(true, false, true, true, "sample", "outcome mismatch", 1, "real-can", true)
        "seed-garbled" => ok observation(true, true, false, true, "sample", "outcome mismatch", 1, "real-can", true)
        "seed-passed-true" => ok observation(true, true, true, false, "sample", "outcome mismatch", 1, "real-can", true)
        "seed-root-empty" => ok observation(true, true, true, true, "", "outcome mismatch", 1, "real-can", true)
        "seed-reason-empty" => ok observation(true, true, true, true, "sample", "", 1, "real-can", true)
        "seed-evidence-empty" => ok observation(true, true, true, true, "sample", "outcome mismatch", 0, "real-can", true)
        "seed-label-empty" => ok observation(true, true, true, true, "sample", "outcome mismatch", 1, "", true)
        "seed-frame-missing" => ok observation(true, true, true, true, "sample", "outcome mismatch", 1, "real-can", false)
        _ => ok observation(true, true, true, true, "sample", "outcome mismatch", 1, "real-can", true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m01_007: "m01-007" => ok [check("exit-rejected", "failing require run exits 1"), check("stderr-empty", "failing require run keeps stderr empty"), check("report-parses", "failing stdout parses as an assertion report"), check("passed-false", "failing report stays unpassed"), check("failed-root", "failing entry names the sample root"), check("failed-reason", "failing entry carries outcome mismatch"), check("evidence-count", "failing entry carries exactly one evidence label"), check("evidence-label", "failing evidence label is real-can"), check("frame-found", "failing frames carry the exact require span")]
        other: "nope" => ok []
    match scope is "m01-007"
        false => ok []
        true => ok [check("exit-rejected", "failing require run exits 1"), check("stderr-empty", "failing require run keeps stderr empty"), check("report-parses", "failing stdout parses as an assertion report"), check("passed-false", "failing report stays unpassed"), check("failed-root", "failing entry names the sample root"), check("failed-reason", "failing entry carries outcome mismatch"), check("evidence-count", "failing entry carries exactly one evidence label"), check("evidence-label", "failing evidence label is real-can"), check("frame-found", "failing frames carry the exact require span")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "mismatch/report" => ok [expected_check("exit-rejected", "true"), expected_check("stderr-empty", "true"), expected_check("report-parses", "true"), expected_check("passed-false", "true"), expected_check("failed-root", "sample"), expected_check("failed-reason", "outcome mismatch"), expected_check("evidence-count", "1"), expected_check("evidence-label", "real-can"), expected_check("frame-found", "true")]
        unknown: "nope" => ok []
    match case is "mismatch/report"
        false => ok []
        true => ok [expected_check("exit-rejected", "true"), expected_check("stderr-empty", "true"), expected_check("report-parses", "true"), expected_check("passed-false", "true"), expected_check("failed-root", "sample"), expected_check("failed-reason", "outcome mismatch"), expected_check("evidence-count", "1"), expected_check("evidence-label", "real-can"), expected_check("frame-found", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("mismatch/report", "default", "", "offline") => ok
        seed_exit_zero: context("mismatch/report", "seed-exit-zero", "", "offline") => failed{"exit-rejected"}
        seed_diag: context("mismatch/report", "seed-diag", "", "offline") => failed{"stderr-empty"}
        seed_garbled: context("mismatch/report", "seed-garbled", "", "offline") => failed{"report-parses"}
        seed_passed_true: context("mismatch/report", "seed-passed-true", "", "offline") => failed{"passed-false"}
        seed_root_empty: context("mismatch/report", "seed-root-empty", "", "offline") => failed{"failed-root"}
        seed_reason_empty: context("mismatch/report", "seed-reason-empty", "", "offline") => failed{"failed-reason"}
        seed_evidence_empty: context("mismatch/report", "seed-evidence-empty", "", "offline") => failed{"evidence-count"}
        seed_label_empty: context("mismatch/report", "seed-label-empty", "", "offline") => failed{"evidence-label"}
        seed_frame_missing: context("mismatch/report", "seed-frame-missing", "", "offline") => failed{"frame-found"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.exit_rejected, true, c, "exit-rejected")
            failed
            ok evidence exit_evidence => match call require_bool(got.stderr_empty, true, c, "stderr-empty")
                failed
                ok evidence stderr_evidence => match call require_bool(got.report_parses, true, c, "report-parses")
                    failed
                    ok evidence parse_evidence => match call require_bool(got.passed_false, true, c, "passed-false")
                        failed
                        ok evidence passed_evidence => match call require_text(got.failed_root, "sample", c, "failed-root")
                            failed
                            ok evidence root_evidence => match call require_text(got.failed_reason, "outcome mismatch", c, "failed-reason")
                                failed
                                ok evidence reason_evidence => match call require_int(got.evidence_count, 1, c, "evidence-count")
                                    failed
                                    ok evidence count_evidence => match call require_text(got.evidence_label, "real-can", c, "evidence-label")
                                        failed
                                        ok evidence label_evidence => match call require_bool(got.frame_found, true, c, "frame-found")
                                            failed
                                            ok evidence frame_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m01_007: "m01-007" => ok test_case("mismatch/report", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("exit-rejected"), check_ref("stderr-empty"), check_ref("report-parses"), check_ref("passed-false"), check_ref("failed-root"), check_ref("failed-reason"), check_ref("evidence-count"), check_ref("evidence-label"), check_ref("frame-found")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m01-007"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("mismatch/report", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("exit-rejected"), check_ref("stderr-empty"), check_ref("report-parses"), check_ref("passed-false"), check_ref("failed-root"), check_ref("failed-reason"), check_ref("evidence-count"), check_ref("evidence-label"), check_ref("frame-found")], callable case_body)
