package m01core007span
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M01 CORE-007 "mismatch span: exact require span plus explicit reason call site".
/// Source: tests/integration/checks_test.go symbol TestChecksMismatchSpan.
/// Related fixtures: none (the Can source is inline in the Go test: the
/// guarded bytes/codec/checks program with one failing decoded-value
/// require).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): exact Can source byte span, line and column of
/// the failing require frame ([333,393) line 12 column 24), the verbatim
/// require expression, the verbatim explicit condition reason, and the
/// main.can frame file.
/// Redaction scans live in core-007-redaction.can; rejected status, empty
/// stderr, report shape, reasons, evidence labels and frame presence live
/// in core-007-report-shape.can.
/// Variants: one failing decoded-value require. Status, evidence and
/// environment-conditional facets belong to the sibling files.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case mismatch/span checks: span-start, span-end, span-line,
/// span-column, expression-text, reason-text, frame-file.
/// Facet map (checks_test.go): span-start/span-end pin the byte span
/// derivation (L185-186: Index of the require expression plus its length);
/// span-line/span-column pin the line/column derivation (L187-188);
/// expression-text pins the anchor require call verbatim (L149);
/// reason-text pins the explicit condition reason literal verbatim (L147,
/// L149); frame-file pins frame["file"] == "main.can" (L192).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int span_start
    int span_end
    int span_line
    int span_column
    str expression
    str reason
    str frame_file
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("mismatch/span", "default", "", "offline"), "span-start" => ok "case mismatch/span variant default root span-start run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 333, 333, context("mismatch/span", "default", "", "offline"), "span-start" => ok evidence("span-start", "333", "333", true, "case mismatch/span variant default root span-start run offline")
        different: 332, 333, context("mismatch/span", "default", "", "offline"), "span-start" => failed{"span-start"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "checks::require(values is [66], \"explicit condition reason\")", "checks::require(values is [66], \"explicit condition reason\")", context("mismatch/span", "default", "", "offline"), "expression-text" => ok evidence("expression-text", "checks::require(values is [66], \"explicit condition reason\")", "checks::require(values is [66], \"explicit condition reason\")", true, "case mismatch/span variant default root expression-text run offline")
        different: "checks::require(values is [67], \"explicit condition reason\")", "checks::require(values is [66], \"explicit condition reason\")", context("mismatch/span", "default", "", "offline"), "expression-text" => failed{"expression-text"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(333, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        seed_span_start_drift: "seed-span-start-drift" => ok observation(332, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        seed_span_end_drift: "seed-span-end-drift" => ok observation(333, 394, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        seed_span_line_drift: "seed-span-line-drift" => ok observation(333, 393, 13, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        seed_span_column_drift: "seed-span-column-drift" => ok observation(333, 393, 12, 25, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        seed_expression_empty: "seed-expression-empty" => ok observation(333, 393, 12, 24, "", "explicit condition reason", "main.can")
        seed_reason_empty: "seed-reason-empty" => ok observation(333, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "", "main.can")
        seed_frame_file_empty: "seed-frame-file-empty" => ok observation(333, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "")
    match variant_id
        "seed-span-start-drift" => ok observation(332, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        "seed-span-end-drift" => ok observation(333, 394, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        "seed-span-line-drift" => ok observation(333, 393, 13, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        "seed-span-column-drift" => ok observation(333, 393, 12, 25, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
        "seed-expression-empty" => ok observation(333, 393, 12, 24, "", "explicit condition reason", "main.can")
        "seed-reason-empty" => ok observation(333, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "", "main.can")
        "seed-frame-file-empty" => ok observation(333, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "")
        _ => ok observation(333, 393, 12, 24, "checks::require(values is [66], \"explicit condition reason\")", "explicit condition reason", "main.can")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m01_007: "m01-007" => ok [check("span-start", "failing require span starts at byte 333"), check("span-end", "failing require span ends at byte 393"), check("span-line", "failing require sits on line 12"), check("span-column", "failing require sits on column 24"), check("expression-text", "mismatch span anchors on the require call verbatim"), check("reason-text", "mismatch records the explicit condition reason verbatim"), check("frame-file", "mismatch frame names main.can")]
        other: "nope" => ok []
    match scope is "m01-007"
        false => ok []
        true => ok [check("span-start", "failing require span starts at byte 333"), check("span-end", "failing require span ends at byte 393"), check("span-line", "failing require sits on line 12"), check("span-column", "failing require sits on column 24"), check("expression-text", "mismatch span anchors on the require call verbatim"), check("reason-text", "mismatch records the explicit condition reason verbatim"), check("frame-file", "mismatch frame names main.can")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "mismatch/span" => ok [expected_check("span-start", "333"), expected_check("span-end", "393"), expected_check("span-line", "12"), expected_check("span-column", "24"), expected_check("expression-text", "checks::require(values is [66], \"explicit condition reason\")"), expected_check("reason-text", "explicit condition reason"), expected_check("frame-file", "main.can")]
        unknown: "nope" => ok []
    match case is "mismatch/span"
        false => ok []
        true => ok [expected_check("span-start", "333"), expected_check("span-end", "393"), expected_check("span-line", "12"), expected_check("span-column", "24"), expected_check("expression-text", "checks::require(values is [66], \"explicit condition reason\")"), expected_check("reason-text", "explicit condition reason"), expected_check("frame-file", "main.can")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("mismatch/span", "default", "", "offline") => ok
        seed_span_start_drift: context("mismatch/span", "seed-span-start-drift", "", "offline") => failed{"span-start"}
        seed_span_end_drift: context("mismatch/span", "seed-span-end-drift", "", "offline") => failed{"span-end"}
        seed_span_line_drift: context("mismatch/span", "seed-span-line-drift", "", "offline") => failed{"span-line"}
        seed_span_column_drift: context("mismatch/span", "seed-span-column-drift", "", "offline") => failed{"span-column"}
        seed_expression_empty: context("mismatch/span", "seed-expression-empty", "", "offline") => failed{"expression-text"}
        seed_reason_empty: context("mismatch/span", "seed-reason-empty", "", "offline") => failed{"reason-text"}
        seed_frame_file_empty: context("mismatch/span", "seed-frame-file-empty", "", "offline") => failed{"frame-file"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.span_start, 333, c, "span-start")
            failed
            ok evidence start_evidence => match call require_int(got.span_end, 393, c, "span-end")
                failed
                ok evidence end_evidence => match call require_int(got.span_line, 12, c, "span-line")
                    failed
                    ok evidence line_evidence => match call require_int(got.span_column, 24, c, "span-column")
                        failed
                        ok evidence column_evidence => match call require_text(got.expression, "checks::require(values is [66], \"explicit condition reason\")", c, "expression-text")
                            failed
                            ok evidence expression_evidence => match call require_text(got.reason, "explicit condition reason", c, "reason-text")
                                failed
                                ok evidence reason_evidence => match call require_text(got.frame_file, "main.can", c, "frame-file")
                                    failed
                                    ok evidence file_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m01_007: "m01-007" => ok test_case("mismatch/span", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("span-start"), check_ref("span-end"), check_ref("span-line"), check_ref("span-column"), check_ref("expression-text"), check_ref("reason-text"), check_ref("frame-file")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m01-007"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("mismatch/span", ["checks", "m01"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("span-start"), check_ref("span-end"), check_ref("span-line"), check_ref("span-column"), check_ref("expression-text"), check_ref("reason-text"), check_ref("frame-file")], callable case_body)
