package m02core005io
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M02 CORE-005 "bundled callables: missing fixture, sealed payload".
/// Source: tests/integration/callables_test.go symbol
/// TestCurrentBundledCallables.
/// Related fixtures: the inline boundary project (callables_test.go
/// L81-103: fn write calling io::stdout_write as the unsupplied I/O
/// boundary, fn guarded holding message "must-not-be-written").
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): an unsupplied I/O boundary surfaces as a missing
/// fixture report pinning "missing fixture" verbatim; the report leaks no
/// payload (the guarded message "must-not-be-written" is absent, leak
/// count 0); the missing fixture arises only through relay invocation.
/// The 11-root captures pin and the silent production run live in
/// core-005-roots-green.can; root-context retention and the relay/
/// no-relay exit legs live in core-005-capture-semantics.can.
/// Variants: selected guarded callable with relay (boundary reached) and
/// without relay (boundary untouched, no fixture).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23).
/// Case bundled/io-boundary checks: missing-fixture, fixture-text,
/// payload-sealed, guarded-message, leak-count, relay-required.
/// Facet map (callables_test.go legs): missing-fixture/fixture-text pin
/// the relay leg report (L106: stdout contains "missing fixture");
/// payload-sealed/guarded-message/leak-count pin the no-leak predicates
/// (L106: stdout lacks "must-not-be-written", pinned verbatim with 0
/// occurrences); relay-required pins the no-relay leg (L109-113: without
/// relay the same selection passes, so no missing fixture arises without
/// relay invocation).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool missing_fixture
    str fixture_text
    bool payload_sealed
    str guarded_message
    int leak_count
    bool relay_required
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/io-boundary", "default", "", "offline"), "missing-fixture" => ok "case bundled/io-boundary variant default root missing-fixture run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/io-boundary", "default", "", "offline"), "missing-fixture" => ok evidence("missing-fixture", "true", "true", true, "case bundled/io-boundary variant default root missing-fixture run offline")
        different: false, true, context("bundled/io-boundary", "default", "", "offline"), "missing-fixture" => failed{"missing-fixture"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("bundled/io-boundary", "default", "", "offline"), "leak-count" => ok evidence("leak-count", "0", "0", true, "case bundled/io-boundary variant default root leak-count run offline")
        different: 1, 0, context("bundled/io-boundary", "default", "", "offline"), "leak-count" => failed{"leak-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "missing fixture", "missing fixture", context("bundled/io-boundary", "default", "", "offline"), "fixture-text" => ok evidence("fixture-text", "missing fixture", "missing fixture", true, "case bundled/io-boundary variant default root fixture-text run offline")
        different: "absent fixture", "missing fixture", context("bundled/io-boundary", "default", "", "offline"), "fixture-text" => failed{"fixture-text"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, "missing fixture", true, "must-not-be-written", 0, true)
        seed_fixture_absent: "seed-fixture-absent" => ok observation(false, "missing fixture", true, "must-not-be-written", 0, true)
        seed_text_drift: "seed-text-drift" => ok observation(true, "absent fixture", true, "must-not-be-written", 0, true)
        seed_payload_leak: "seed-payload-leak" => ok observation(true, "missing fixture", false, "must-not-be-written", 0, true)
        seed_message_drift: "seed-message-drift" => ok observation(true, "missing fixture", true, "must-not-be-read", 0, true)
        seed_leak_count: "seed-leak-count" => ok observation(true, "missing fixture", true, "must-not-be-written", 1, true)
        seed_relay_unneeded: "seed-relay-unneeded" => ok observation(true, "missing fixture", true, "must-not-be-written", 0, false)
    match variant_id
        "seed-fixture-absent" => ok observation(false, "missing fixture", true, "must-not-be-written", 0, true)
        "seed-text-drift" => ok observation(true, "absent fixture", true, "must-not-be-written", 0, true)
        "seed-payload-leak" => ok observation(true, "missing fixture", false, "must-not-be-written", 0, true)
        "seed-message-drift" => ok observation(true, "missing fixture", true, "must-not-be-read", 0, true)
        "seed-leak-count" => ok observation(true, "missing fixture", true, "must-not-be-written", 1, true)
        "seed-relay-unneeded" => ok observation(true, "missing fixture", true, "must-not-be-written", 0, false)
        _ => ok observation(true, "missing fixture", true, "must-not-be-written", 0, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m02_005: "m02-005" => ok [check("missing-fixture", "unsupplied I/O boundary reports a missing fixture"), check("fixture-text", "fixture report pins missing fixture verbatim"), check("payload-sealed", "missing-fixture output leaks no payload"), check("guarded-message", "guarded payload pins must-not-be-written"), check("leak-count", "payload occurrences in output pin 0"), check("relay-required", "missing fixture arises only through relay invocation")]
        other: "nope" => ok []
    match scope is "m02-005"
        false => ok []
        true => ok [check("missing-fixture", "unsupplied I/O boundary reports a missing fixture"), check("fixture-text", "fixture report pins missing fixture verbatim"), check("payload-sealed", "missing-fixture output leaks no payload"), check("guarded-message", "guarded payload pins must-not-be-written"), check("leak-count", "payload occurrences in output pin 0"), check("relay-required", "missing fixture arises only through relay invocation")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/io-boundary" => ok [expected_check("missing-fixture", "true"), expected_check("fixture-text", "missing fixture"), expected_check("payload-sealed", "true"), expected_check("guarded-message", "must-not-be-written"), expected_check("leak-count", "0"), expected_check("relay-required", "true")]
        unknown: "nope" => ok []
    match case is "bundled/io-boundary"
        false => ok []
        true => ok [expected_check("missing-fixture", "true"), expected_check("fixture-text", "missing fixture"), expected_check("payload-sealed", "true"), expected_check("guarded-message", "must-not-be-written"), expected_check("leak-count", "0"), expected_check("relay-required", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/io-boundary", "default", "", "offline") => ok
        seed_fixture_absent: context("bundled/io-boundary", "seed-fixture-absent", "", "offline") => failed{"missing-fixture"}
        seed_text_drift: context("bundled/io-boundary", "seed-text-drift", "", "offline") => failed{"fixture-text"}
        seed_payload_leak: context("bundled/io-boundary", "seed-payload-leak", "", "offline") => failed{"payload-sealed"}
        seed_message_drift: context("bundled/io-boundary", "seed-message-drift", "", "offline") => failed{"guarded-message"}
        seed_leak_count: context("bundled/io-boundary", "seed-leak-count", "", "offline") => failed{"leak-count"}
        seed_relay_unneeded: context("bundled/io-boundary", "seed-relay-unneeded", "", "offline") => failed{"relay-required"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.missing_fixture, true, c, "missing-fixture")
            failed
            ok evidence fixture_evidence => match call require_text(got.fixture_text, "missing fixture", c, "fixture-text")
                failed
                ok evidence text_evidence => match call require_bool(got.payload_sealed, true, c, "payload-sealed")
                    failed
                    ok evidence sealed_evidence => match call require_text(got.guarded_message, "must-not-be-written", c, "guarded-message")
                        failed
                        ok evidence message_evidence => match call require_int(got.leak_count, 0, c, "leak-count")
                            failed
                            ok evidence leak_evidence => match call require_bool(got.relay_required, true, c, "relay-required")
                                failed
                                ok evidence relay_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m02_005: "m02-005" => ok test_case("bundled/io-boundary", ["callables", "m02"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("missing-fixture"), check_ref("fixture-text"), check_ref("payload-sealed"), check_ref("guarded-message"), check_ref("leak-count"), check_ref("relay-required")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m02-005"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/io-boundary", ["callables", "m02"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("missing-fixture"), check_ref("fixture-text"), check_ref("payload-sealed"), check_ref("guarded-message"), check_ref("leak-count"), check_ref("relay-required")], callable case_body)
