        sample: context("bundled/generics-roots", "default", "", "offline"), "assert-green" => ok "case bundled/generics-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
