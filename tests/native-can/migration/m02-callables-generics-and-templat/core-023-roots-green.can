    bool report_passed
    int root_count
    str fixture_set
    int identity_roots
    int read_roots
    int make_roots
    int main_roots
    bool run_silent
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
