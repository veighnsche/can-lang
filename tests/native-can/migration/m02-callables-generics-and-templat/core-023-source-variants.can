package m02core023variants
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M02 CORE-023 "bundled generics: finite/spread source variants".
/// Source: tests/integration/generics_test.go symbol
/// TestCurrentBundledGenerics.
/// Related fixtures: compiler/testdata/current/generics/finite-transition.can
/// (base + array-arm + inferred-call forms),
/// finite-field-chain.can (base + terminal-before + terminal-after forms),
/// spread-inferred.can (single spread form).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): each finite-transition, finite-field-chain and
/// spread-inferred source variant asserts green (passed true) and runs
/// silent (exit 0, empty stdout, empty stderr), including the added
/// array/terminal/inferred forms; 7 variants in total (3 + 3 + 1).
/// The six-root green pin and the silent production run live in
/// core-023-roots-green.can; the wrong-type unreachable-branch build
/// rejection lives in core-023-wrong-type-rejection.can.
/// Variants: finite-transition base/array/inferred, finite-field-chain
/// base/terminal-before/terminal-after, spread-inferred.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23).
/// Case bundled/generics-variants checks: finite-base, finite-array,
/// finite-inferred, chain-base, chain-terminal-before, chain-terminal-after,
/// spread-inferred, variant-count.
/// Facet map (generics_test.go legs): finite-base pins the base leg
/// (L104-129: finite-transition.can asserts passed and runs silent);
/// finite-array pins the array form (L111: added array arm runs silent);
/// finite-inferred pins the inferred form (L112: fixed([1]) runs silent);
/// chain-base pins the base leg (finite-field-chain.can asserts passed and
/// runs silent); chain-terminal-before pins the terminal-before form (L117:
/// terminal row before sample runs silent); chain-terminal-after pins the
/// terminal-after form (L117: terminal row after sample runs silent);
/// spread-inferred pins the spread leg (spread-inferred.can asserts passed
/// and runs silent); variant-count pins the 7-variant total (3 + 3 + 1).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool finite_base
    bool finite_array
    bool finite_inferred
    bool chain_base
    bool chain_terminal_before
    bool chain_terminal_after
    bool spread_inferred
    int variant_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/generics-variants", "default", "", "offline"), "finite-base" => ok "case bundled/generics-variants variant default root finite-base run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/generics-variants", "default", "", "offline"), "finite-base" => ok evidence("finite-base", "true", "true", true, "case bundled/generics-variants variant default root finite-base run offline")
        different: false, true, context("bundled/generics-variants", "default", "", "offline"), "finite-base" => failed{"finite-base"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 7, 7, context("bundled/generics-variants", "default", "", "offline"), "variant-count" => ok evidence("variant-count", "7", "7", true, "case bundled/generics-variants variant default root variant-count run offline")
        different: 6, 7, context("bundled/generics-variants", "default", "", "offline"), "variant-count" => failed{"variant-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "finite-transition.can", "finite-transition.can", context("bundled/generics-variants", "default", "", "offline"), "finite-base" => ok evidence("finite-base", "finite-transition.can", "finite-transition.can", true, "case bundled/generics-variants variant default root finite-base run offline")
        different: "spread-inferred.can", "finite-transition.can", context("bundled/generics-variants", "default", "", "offline"), "finite-base" => failed{"finite-base"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, true, true, true, 7)
        seed_finite_base_red: "seed-finite-base-red" => ok observation(false, true, true, true, true, true, true, 7)
        seed_finite_array_red: "seed-finite-array-red" => ok observation(true, false, true, true, true, true, true, 7)
        seed_finite_inferred_red: "seed-finite-inferred-red" => ok observation(true, true, false, true, true, true, true, 7)
        seed_chain_base_red: "seed-chain-base-red" => ok observation(true, true, true, false, true, true, true, 7)
        seed_chain_before_red: "seed-chain-before-red" => ok observation(true, true, true, true, false, true, true, 7)
        seed_chain_after_red: "seed-chain-after-red" => ok observation(true, true, true, true, true, false, true, 7)
        seed_spread_red: "seed-spread-red" => ok observation(true, true, true, true, true, true, false, 7)
        seed_variant_short: "seed-variant-short" => ok observation(true, true, true, true, true, true, true, 6)
    match variant_id
        "seed-finite-base-red" => ok observation(false, true, true, true, true, true, true, 7)
        "seed-finite-array-red" => ok observation(true, false, true, true, true, true, true, 7)
        "seed-finite-inferred-red" => ok observation(true, true, false, true, true, true, true, 7)
        "seed-chain-base-red" => ok observation(true, true, true, false, true, true, true, 7)
        "seed-chain-before-red" => ok observation(true, true, true, true, false, true, true, 7)
        "seed-chain-after-red" => ok observation(true, true, true, true, true, false, true, 7)
        "seed-spread-red" => ok observation(true, true, true, true, true, true, false, 7)
        "seed-variant-short" => ok observation(true, true, true, true, true, true, true, 6)
        _ => ok observation(true, true, true, true, true, true, true, 7)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m02_023: "m02-023" => ok [check("finite-base", "finite-transition base asserts passed and runs silent"), check("finite-array", "finite-transition array form asserts passed and runs silent"), check("finite-inferred", "finite-transition inferred-call form asserts passed and runs silent"), check("chain-base", "finite-field-chain base asserts passed and runs silent"), check("chain-terminal-before", "finite-field-chain terminal-before form asserts passed and runs silent"), check("chain-terminal-after", "finite-field-chain terminal-after form asserts passed and runs silent"), check("spread-inferred", "spread-inferred asserts passed and runs silent"), check("variant-count", "exactly 7 source variants are covered")]
        other: "nope" => ok []
    match scope is "m02-023"
        false => ok []
        true => ok [check("finite-base", "finite-transition base asserts passed and runs silent"), check("finite-array", "finite-transition array form asserts passed and runs silent"), check("finite-inferred", "finite-transition inferred-call form asserts passed and runs silent"), check("chain-base", "finite-field-chain base asserts passed and runs silent"), check("chain-terminal-before", "finite-field-chain terminal-before form asserts passed and runs silent"), check("chain-terminal-after", "finite-field-chain terminal-after form asserts passed and runs silent"), check("spread-inferred", "spread-inferred asserts passed and runs silent"), check("variant-count", "exactly 7 source variants are covered")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/generics-variants" => ok [expected_check("finite-base", "true"), expected_check("finite-array", "true"), expected_check("finite-inferred", "true"), expected_check("chain-base", "true"), expected_check("chain-terminal-before", "true"), expected_check("chain-terminal-after", "true"), expected_check("spread-inferred", "true"), expected_check("variant-count", "7")]
        unknown: "nope" => ok []
    match case is "bundled/generics-variants"
        false => ok []
        true => ok [expected_check("finite-base", "true"), expected_check("finite-array", "true"), expected_check("finite-inferred", "true"), expected_check("chain-base", "true"), expected_check("chain-terminal-before", "true"), expected_check("chain-terminal-after", "true"), expected_check("spread-inferred", "true"), expected_check("variant-count", "7")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/generics-variants", "default", "", "offline") => ok
        seed_finite_base_red: context("bundled/generics-variants", "seed-finite-base-red", "", "offline") => failed{"finite-base"}
        seed_finite_array_red: context("bundled/generics-variants", "seed-finite-array-red", "", "offline") => failed{"finite-array"}
        seed_finite_inferred_red: context("bundled/generics-variants", "seed-finite-inferred-red", "", "offline") => failed{"finite-inferred"}
        seed_chain_base_red: context("bundled/generics-variants", "seed-chain-base-red", "", "offline") => failed{"chain-base"}
        seed_chain_before_red: context("bundled/generics-variants", "seed-chain-before-red", "", "offline") => failed{"chain-terminal-before"}
        seed_chain_after_red: context("bundled/generics-variants", "seed-chain-after-red", "", "offline") => failed{"chain-terminal-after"}
        seed_spread_red: context("bundled/generics-variants", "seed-spread-red", "", "offline") => failed{"spread-inferred"}
        seed_variant_short: context("bundled/generics-variants", "seed-variant-short", "", "offline") => failed{"variant-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.finite_base, true, c, "finite-base")
            failed
            ok evidence finite_evidence => match call require_bool(got.finite_array, true, c, "finite-array")
                failed
                ok evidence array_evidence => match call require_bool(got.finite_inferred, true, c, "finite-inferred")
                    failed
                    ok evidence inferred_evidence => match call require_bool(got.chain_base, true, c, "chain-base")
                        failed
                        ok evidence chain_evidence => match call require_bool(got.chain_terminal_before, true, c, "chain-terminal-before")
                            failed
                            ok evidence before_evidence => match call require_bool(got.chain_terminal_after, true, c, "chain-terminal-after")
                                failed
                                ok evidence after_evidence => match call require_bool(got.spread_inferred, true, c, "spread-inferred")
                                    failed
                                    ok evidence spread_evidence => match call require_int(got.variant_count, 7, c, "variant-count")
                                        failed
                                        ok evidence count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m02_023: "m02-023" => ok test_case("bundled/generics-variants", ["generics", "m02"], ["can-bun-archive", "macos-sandbox-exec"], 300000, [check_ref("finite-base"), check_ref("finite-array"), check_ref("finite-inferred"), check_ref("chain-base"), check_ref("chain-terminal-before"), check_ref("chain-terminal-after"), check_ref("spread-inferred"), check_ref("variant-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m02-023"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/generics-variants", ["generics", "m02"], ["can-bun-archive", "macos-sandbox-exec"], 300000, [check_ref("finite-base"), check_ref("finite-array"), check_ref("finite-inferred"), check_ref("chain-base"), check_ref("chain-terminal-before"), check_ref("chain-terminal-after"), check_ref("spread-inferred"), check_ref("variant-count")], callable case_body)
