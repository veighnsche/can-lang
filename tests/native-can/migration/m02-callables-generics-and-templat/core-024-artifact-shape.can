package m02core024artifact
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M02 CORE-024 "bundled generic chain: production artifact shape".
/// Source: tests/integration/generics_test.go symbol
/// TestCurrentBundledGenericChain.
/// Related fixtures: compiler/testdata/current/generics/chain-main.can
/// (root module), chain-core.can, chain-helpers.can (the nested call
/// site "core::identity<box<item>>(box(value))" L26), chain-mail.can
/// (vendor modules); production emission across four authored modules.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the production build verifies as bun with
/// 10/10/0 assertions and a locked dependency identity; fourteen
/// canonical instances emit across four modules (core 4, helpers 6,
/// mail 2, root 2) with nested<int> and identity<box<int>>
/// deduplicated; the helpers source map pins the nested call-site bytes;
/// every authored, state, assertion and entry module in both staged
/// generations carries a sibling source map plus trailer with exact
/// .can mappings; the assertion generation holds 10 case modules each
/// referencing all 14 instances; the strict-tsc leg stays gated on
/// CAN_TSC and is recorded conditional, never waived.
/// The locked green chain and nested concrete behaviors live in
/// core-024-chain-green.can; the corruption/stale/symbolic/owner
/// negative legs live in core-024-negative-legs.can. C023 owns the
/// bundled-generics surface; this row owns ONLY the dependency-chain
/// surface.
/// Variants: 14 canonical instances; nested<int> serving four request
/// sites; identity<box<int>> serving body plus direct call; assert and
/// production generations; CAN_TSC-gated strict leg.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec; the strict-tsc leg is
/// additionally conditional on CAN_TSC. Logical gates SUITE/DIAG/FAULT
/// and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23).
/// Case bundled/generic-chain-artifact checks: build-verified,
/// instance-total, core-instances, helpers-instances, mail-instances,
/// root-instances, nested-dedup, identity-dedup, map-call-entry,
/// map-trailers, case-count, case-instance-refs, tsc-conditional.
/// Facet map (generics_test.go legs): build-verified pins the build leg
/// (L304-322: kind can.build, target bun, validation verified, roots
/// 10, passed 10, failed 0, locked dependency identity present);
/// instance-total/core-instances/helpers-instances/mail-instances/
/// root-instances pin the emission leg (L324-370: 14 exported functions
/// across 4 modules: core 4, helpers 6, mail 2, root 2);
/// nested-dedup/identity-dedup pin the canonical legs (L324-327:
/// nested<int> serves four request sites with one function,
/// identity<box<int>> serves the nested<int> body and the root direct
/// inferred call with one function); map-call-entry pins the nested
/// call-site link (L371-386: helpers map names carry the exact
/// call:start:end entry for "core::identity<box<item>>(box(value))");
/// map-trailers pins the map sweep (L388-417 plus checkSourceMap L568-598:
/// every authored/state/assertion/entry module in both generations
/// carries a sibling map plus trailer, authored maps with exact .can
/// mappings); case-count/case-instance-refs pin the assertion-emission
/// leg (L419-446: 10 case modules, each referencing all 14 instances);
/// tsc-conditional pins the strict-tsc leg (L455-477: gated on CAN_TSC,
/// strict-clean except the known UP13 state.ts invalidQuery error,
/// recorded conditional here, never waived).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool build_verified
    int instance_total
    int core_instances
    int helpers_instances
    int mail_instances
    int root_instances
    bool nested_dedup
    bool identity_dedup
    bool map_call_entry
    bool map_trailers
    int case_count
    int case_instance_refs
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/generic-chain-artifact", "default", "", "offline"), "build-verified" => ok "case bundled/generic-chain-artifact variant default root build-verified run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/generic-chain-artifact", "default", "", "offline"), "build-verified" => ok evidence("build-verified", "true", "true", true, "case bundled/generic-chain-artifact variant default root build-verified run offline")
        different: false, true, context("bundled/generic-chain-artifact", "default", "", "offline"), "build-verified" => failed{"build-verified"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 14, 14, context("bundled/generic-chain-artifact", "default", "", "offline"), "instance-total" => ok evidence("instance-total", "14", "14", true, "case bundled/generic-chain-artifact variant default root instance-total run offline")
        different: 13, 14, context("bundled/generic-chain-artifact", "default", "", "offline"), "instance-total" => failed{"instance-total"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
