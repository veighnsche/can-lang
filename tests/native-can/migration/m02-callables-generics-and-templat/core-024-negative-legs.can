package m02core024negative
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M02 CORE-024 "bundled generic chain: negative legs reject".
/// Source: tests/integration/generics_test.go symbol
/// TestCurrentBundledGenericChain.
/// Related fixtures: compiler/testdata/current/generics/chain-main.can
/// (the corrupted guard "direct.value is 9" L26), chain-mail.can (owner
/// email record, make_email factory), plus the inline symbolic a/b/c
/// project (generics_test.go L514-518) and the inline owner suspect
/// project (L548-551).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): corrupting one expected composed value fails
/// verification with "outcome mismatch" instead of running silent; a
/// stale locked dependency fails before any check, emission or execution
/// with the exact stale-digest line; a failed symbolic component rejects
/// on both assert and build with the root arithmetic failure at app::b
/// and never a consumer-side false proof naming app::c; both owner
/// negatives reject with their exact diagnoses; no negative leg
/// publishes a proof.
/// The locked green chain and nested concrete behaviors live in
/// core-024-chain-green.can; production emission counts, source-map
/// links and the optional strict-tsc leg live in
/// core-024-artifact-shape.can. C023 owns the bundled-generics surface;
/// this row owns ONLY the dependency-chain surface.
/// Variants: assertion corruption; stale lock; symbolic component; owner
/// construction and owner factory negatives.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23).
/// Case bundled/generic-chain-negatives checks: corruption-rejects,
/// corruption-diagnosis, stale-rejects, stale-diagnosis, symbolic-rejects,
/// symbolic-root, no-false-proof, owner-construction-rejects,
/// owner-construction-diagnosis, owner-factory-rejects,
/// owner-factory-diagnosis, no-publication.
/// Facet map (generics_test.go legs): corruption-rejects/
/// corruption-diagnosis pin the nonvacuous leg (L479-489: "direct.value
/// is 9" mutated to 8 fails run with "outcome mismatch");
/// stale-rejects/stale-diagnosis pin the stale leg (L491-506: bytes with
/// "// stale" under the old lock fail assert with 'stale dependency
/// digest for "can.project.dependency/vendor"');
/// symbolic-rejects/symbolic-root/no-false-proof pin the symbolic leg
/// (L508-528: inline a/b/c fails both assert and build with "exported
/// generic function", "app::b" and "operator + is not defined", while
/// the diagnosis never names "app::c");
/// owner-construction-rejects/owner-construction-diagnosis pin the
/// construction negative (L539-540: mail::email("forged") fails with
/// "exported generic function" and "only be constructed in its declaring
/// package"); owner-factory-rejects/owner-factory-diagnosis pin the
/// factory negative (L541-542: mail::make_email(value) fails with
/// "exported generic function" and "explicit named callable or
/// dictionary inputs"); no-publication pins that no negative leg
/// publishes a proof.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool corruption_rejects
    str corruption_diagnosis
    bool stale_rejects
    str stale_diagnosis
    bool symbolic_rejects
    str symbolic_root
    bool no_false_proof
    bool owner_construction_rejects
    str owner_construction_diagnosis
    bool owner_factory_rejects
    str owner_factory_diagnosis
    bool no_publication
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/generic-chain-negatives", "default", "", "offline"), "corruption-rejects" => ok "case bundled/generic-chain-negatives variant default root corruption-rejects run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/generic-chain-negatives", "default", "", "offline"), "corruption-rejects" => ok evidence("corruption-rejects", "true", "true", true, "case bundled/generic-chain-negatives variant default root corruption-rejects run offline")
        different: false, true, context("bundled/generic-chain-negatives", "default", "", "offline"), "corruption-rejects" => failed{"corruption-rejects"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "outcome mismatch", "outcome mismatch", context("bundled/generic-chain-negatives", "default", "", "offline"), "corruption-diagnosis" => ok evidence("corruption-diagnosis", "outcome mismatch", "outcome mismatch", true, "case bundled/generic-chain-negatives variant default root corruption-diagnosis run offline")
        different: "assertion failed", "outcome mismatch", context("bundled/generic-chain-negatives", "default", "", "offline"), "corruption-diagnosis" => failed{"corruption-diagnosis"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_corruption_ran: "seed-corruption-ran" => ok observation(false, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_corruption_misdiag: "seed-corruption-misdiag" => ok observation(true, "assertion failed", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_stale_admitted: "seed-stale-admitted" => ok observation(true, "outcome mismatch", false, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_stale_misdiag: "seed-stale-misdiag" => ok observation(true, "outcome mismatch", true, "digest mismatch", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_symbolic_admitted: "seed-symbolic-admitted" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", false, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_symbolic_drift: "seed-symbolic-drift" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::c", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_false_proof: "seed-false-proof" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", false, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_construction_admitted: "seed-construction-admitted" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, false, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        seed_construction_misdiag: "seed-construction-misdiag" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "type mismatch", true, "explicit named callable or dictionary inputs", true)
        seed_factory_admitted: "seed-factory-admitted" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", false, "explicit named callable or dictionary inputs", true)
        seed_factory_misdiag: "seed-factory-misdiag" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "type mismatch", true)
        seed_published: "seed-published" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", false)
    match variant_id
        "seed-corruption-ran" => ok observation(false, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-corruption-misdiag" => ok observation(true, "assertion failed", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-stale-admitted" => ok observation(true, "outcome mismatch", false, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-stale-misdiag" => ok observation(true, "outcome mismatch", true, "digest mismatch", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-symbolic-admitted" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", false, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-symbolic-drift" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::c", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-false-proof" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", false, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-construction-admitted" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, false, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
        "seed-construction-misdiag" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "type mismatch", true, "explicit named callable or dictionary inputs", true)
        "seed-factory-admitted" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", false, "explicit named callable or dictionary inputs", true)
        "seed-factory-misdiag" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "type mismatch", true)
        "seed-published" => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", false)
        _ => ok observation(true, "outcome mismatch", true, "stale dependency digest for \"can.project.dependency/vendor\"", true, "app::b", true, true, "only be constructed in its declaring package", true, "explicit named callable or dictionary inputs", true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m02_024: "m02-024" => ok [check("corruption-rejects", "corrupted expected value fails verification"), check("corruption-diagnosis", "corruption diagnosis pins outcome mismatch"), check("stale-rejects", "stale lock fails before check, emission and execution"), check("stale-diagnosis", "stale diagnosis pins the vendor digest line"), check("symbolic-rejects", "failed symbolic component rejects on assert and build"), check("symbolic-root", "symbolic diagnosis names the root at app::b"), check("no-false-proof", "symbolic diagnosis never names consumer app::c"), check("owner-construction-rejects", "owner construction outside its package rejects"), check("owner-construction-diagnosis", "construction diagnosis pins the declaring-package rule"), check("owner-factory-rejects", "opaque owner factory input rejects"), check("owner-factory-diagnosis", "factory diagnosis pins the named-callable inputs rule"), check("no-publication", "no negative leg publishes a proof")]
        other: "nope" => ok []
    match scope is "m02-024"
        false => ok []
        true => ok [check("corruption-rejects", "corrupted expected value fails verification"), check("corruption-diagnosis", "corruption diagnosis pins outcome mismatch"), check("stale-rejects", "stale lock fails before check, emission and execution"), check("stale-diagnosis", "stale diagnosis pins the vendor digest line"), check("symbolic-rejects", "failed symbolic component rejects on assert and build"), check("symbolic-root", "symbolic diagnosis names the root at app::b"), check("no-false-proof", "symbolic diagnosis never names consumer app::c"), check("owner-construction-rejects", "owner construction outside its package rejects"), check("owner-construction-diagnosis", "construction diagnosis pins the declaring-package rule"), check("owner-factory-rejects", "opaque owner factory input rejects"), check("owner-factory-diagnosis", "factory diagnosis pins the named-callable inputs rule"), check("no-publication", "no negative leg publishes a proof")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/generic-chain-negatives" => ok [expected_check("corruption-rejects", "true"), expected_check("corruption-diagnosis", "outcome mismatch"), expected_check("stale-rejects", "true"), expected_check("stale-diagnosis", "stale dependency digest for \"can.project.dependency/vendor\""), expected_check("symbolic-rejects", "true"), expected_check("symbolic-root", "app::b"), expected_check("no-false-proof", "true"), expected_check("owner-construction-rejects", "true"), expected_check("owner-construction-diagnosis", "only be constructed in its declaring package"), expected_check("owner-factory-rejects", "true"), expected_check("owner-factory-diagnosis", "explicit named callable or dictionary inputs"), expected_check("no-publication", "true")]
        unknown: "nope" => ok []
    match case is "bundled/generic-chain-negatives"
        false => ok []
        true => ok [expected_check("corruption-rejects", "true"), expected_check("corruption-diagnosis", "outcome mismatch"), expected_check("stale-rejects", "true"), expected_check("stale-diagnosis", "stale dependency digest for \"can.project.dependency/vendor\""), expected_check("symbolic-rejects", "true"), expected_check("symbolic-root", "app::b"), expected_check("no-false-proof", "true"), expected_check("owner-construction-rejects", "true"), expected_check("owner-construction-diagnosis", "only be constructed in its declaring package"), expected_check("owner-factory-rejects", "true"), expected_check("owner-factory-diagnosis", "explicit named callable or dictionary inputs"), expected_check("no-publication", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/generic-chain-negatives", "default", "", "offline") => ok
        seed_corruption_ran: context("bundled/generic-chain-negatives", "seed-corruption-ran", "", "offline") => failed{"corruption-rejects"}
        seed_corruption_misdiag: context("bundled/generic-chain-negatives", "seed-corruption-misdiag", "", "offline") => failed{"corruption-diagnosis"}
        seed_stale_admitted: context("bundled/generic-chain-negatives", "seed-stale-admitted", "", "offline") => failed{"stale-rejects"}
        seed_stale_misdiag: context("bundled/generic-chain-negatives", "seed-stale-misdiag", "", "offline") => failed{"stale-diagnosis"}
        seed_symbolic_admitted: context("bundled/generic-chain-negatives", "seed-symbolic-admitted", "", "offline") => failed{"symbolic-rejects"}
        seed_symbolic_drift: context("bundled/generic-chain-negatives", "seed-symbolic-drift", "", "offline") => failed{"symbolic-root"}
        seed_false_proof: context("bundled/generic-chain-negatives", "seed-false-proof", "", "offline") => failed{"no-false-proof"}
        seed_construction_admitted: context("bundled/generic-chain-negatives", "seed-construction-admitted", "", "offline") => failed{"owner-construction-rejects"}
        seed_construction_misdiag: context("bundled/generic-chain-negatives", "seed-construction-misdiag", "", "offline") => failed{"owner-construction-diagnosis"}
        seed_factory_admitted: context("bundled/generic-chain-negatives", "seed-factory-admitted", "", "offline") => failed{"owner-factory-rejects"}
        seed_factory_misdiag: context("bundled/generic-chain-negatives", "seed-factory-misdiag", "", "offline") => failed{"owner-factory-diagnosis"}
        seed_published: context("bundled/generic-chain-negatives", "seed-published", "", "offline") => failed{"no-publication"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.corruption_rejects, true, c, "corruption-rejects")
            failed
            ok evidence corruption_evidence => match call require_text(got.corruption_diagnosis, "outcome mismatch", c, "corruption-diagnosis")
                failed
                ok evidence mismatch_evidence => match call require_bool(got.stale_rejects, true, c, "stale-rejects")
                    failed
                    ok evidence stale_evidence => match call require_text(got.stale_diagnosis, "stale dependency digest for \"can.project.dependency/vendor\"", c, "stale-diagnosis")
                        failed
                        ok evidence digest_evidence => match call require_bool(got.symbolic_rejects, true, c, "symbolic-rejects")
                            failed
                            ok evidence symbolic_evidence => match call require_text(got.symbolic_root, "app::b", c, "symbolic-root")
                                failed
                                ok evidence root_evidence => match call require_bool(got.no_false_proof, true, c, "no-false-proof")
                                    failed
                                    ok evidence proof_evidence => match call require_bool(got.owner_construction_rejects, true, c, "owner-construction-rejects")
                                        failed
                                        ok evidence construction_evidence => match call require_text(got.owner_construction_diagnosis, "only be constructed in its declaring package", c, "owner-construction-diagnosis")
                                            failed
                                            ok evidence declaring_evidence => match call require_bool(got.owner_factory_rejects, true, c, "owner-factory-rejects")
                                                failed
                                                ok evidence factory_evidence => match call require_text(got.owner_factory_diagnosis, "explicit named callable or dictionary inputs", c, "owner-factory-diagnosis")
                                                    failed
                                                    ok evidence inputs_evidence => match call require_bool(got.no_publication, true, c, "no-publication")
                                                        failed
                                                        ok evidence publication_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m02_024: "m02-024" => ok test_case("bundled/generic-chain-negatives", ["generics", "m02"], ["can-bun-archive", "macos-sandbox-exec"], 480000, [check_ref("corruption-rejects"), check_ref("corruption-diagnosis"), check_ref("stale-rejects"), check_ref("stale-diagnosis"), check_ref("symbolic-rejects"), check_ref("symbolic-root"), check_ref("no-false-proof"), check_ref("owner-construction-rejects"), check_ref("owner-construction-diagnosis"), check_ref("owner-factory-rejects"), check_ref("owner-factory-diagnosis"), check_ref("no-publication")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m02-024"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/generic-chain-negatives", ["generics", "m02"], ["can-bun-archive", "macos-sandbox-exec"], 480000, [check_ref("corruption-rejects"), check_ref("corruption-diagnosis"), check_ref("stale-rejects"), check_ref("stale-diagnosis"), check_ref("symbolic-rejects"), check_ref("symbolic-root"), check_ref("no-false-proof"), check_ref("owner-construction-rejects"), check_ref("owner-construction-diagnosis"), check_ref("owner-factory-rejects"), check_ref("owner-factory-diagnosis"), check_ref("no-publication")], callable case_body)
