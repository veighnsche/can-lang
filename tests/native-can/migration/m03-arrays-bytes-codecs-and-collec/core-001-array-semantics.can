package m03core001semantics
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M03 CORE-001 "bundled arrays: order, alias, schedule, failure-stop".
/// Source: tests/integration/arrays_test.go symbol
/// TestCurrentBundledArrays.
/// Related fixtures: runtime/test/array.test.ts (the staged offline
/// traces leg, arrays_test.go L29-34) plus the map/filter/search/reduce/
/// sort/copy behavior it pins down.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): map/filter/search/reduce/sort/copy preserve
/// order, aliases and immutable sources; callback scheduling stays
/// serial with peak concurrency 1; callback failures stop every adapter
/// at visits 1,2 with the identical carrier; empty inputs never invoke
/// callbacks; mapping gaps keep later fixtures behind the traversal.
/// The 46+28 root pins and the silent production run live in
/// core-001-roots-green.can; occurrence preservation, raw refusal, owner
/// context, thenable/getter hostility, native delegation, staged traces
/// and the conditional tsc leg live in
/// core-001-hostile-production.can.
/// Variants: main 46 roots, contracts 28 roots (counts pinned in the
/// roots file; this file pins the semantic legs both fixtures share).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT
/// and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23).
/// Case bundled/array-semantics checks: map-order, map-alias,
/// search-early, reduce-chain, failure-stop, failure-adapters,
/// stop-order, sort-stable, copy-immutable, sync-serial,
/// fixture-ordered.
/// Facet map (array.test.ts legs): map-order/map-alias pin the gated
/// map leg (L30-78: started 0 then 0,1 then 0,1,2, peak 1, result
/// equals items with element aliases in a fresh frozen array, 0
/// assimilations); search-early pins the filter/search leg (L80-116:
/// filter sees 1,2,3, find/some stop at 1,2, every stops at 1, empty
/// inputs never reach callbacks, source unchanged); reduce-chain pins
/// the reduce leg (L118-179: for_each serializes 1,2,3 behind the gate,
/// fold protects thenable accumulators with 0 assimilations, empty fold
/// returns the seed); failure-stop/failure-adapters/stop-order pin the
/// failure loop (L203-273: standard and domain failures stop all 8 of
/// map, filter, for_each, fold, find, some, every, sort_by at visits
/// 1,2 with the identical carrier); sort-stable pins the sort leg
/// (L275-317: keys computed once in order, native stable order,
/// sources untouched, frozen results, nonfinite keys stop with
/// arithmetic at visits 0,1); copy-immutable pins the copying leg
/// (L371-389: concat/append/to_reversed preserve order and aliases in
/// fresh frozen arrays, sources unchanged); sync-serial pins the
/// absent-context sync leg (L455-562 plus the delayed fold L564-594:
/// serial visits, sync failure stop at 1,2, empty short-circuit, fold
/// peak 1); fixture-ordered pins the mapping-gap leg (L319-369:
/// participant events stay 0,1,2 behind the traversal, report passes).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool map_ordered
    bool map_aliased
    bool search_early
    bool reduce_chained
    bool failure_stops
    int failure_adapters
    str stop_order
    bool sort_stable
    bool copy_immutable
    bool sync_serial
    bool fixture_ordered
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/array-semantics", "default", "", "offline"), "map-order" => ok "case bundled/array-semantics variant default root map-order run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/array-semantics", "default", "", "offline"), "map-order" => ok evidence("map-order", "true", "true", true, "case bundled/array-semantics variant default root map-order run offline")
        different: false, true, context("bundled/array-semantics", "default", "", "offline"), "map-order" => failed{"map-order"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 8, 8, context("bundled/array-semantics", "default", "", "offline"), "failure-adapters" => ok evidence("failure-adapters", "8", "8", true, "case bundled/array-semantics variant default root failure-adapters run offline")
        different: 7, 8, context("bundled/array-semantics", "default", "", "offline"), "failure-adapters" => failed{"failure-adapters"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "1,2", "1,2", context("bundled/array-semantics", "default", "", "offline"), "stop-order" => ok evidence("stop-order", "1,2", "1,2", true, "case bundled/array-semantics variant default root stop-order run offline")
        different: "1,2,3", "1,2", context("bundled/array-semantics", "default", "", "offline"), "stop-order" => failed{"stop-order"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, true, 8, "1,2", true, true, true, true)
        seed_map_unordered: "seed-map-unordered" => ok observation(false, true, true, true, true, 8, "1,2", true, true, true, true)
        seed_map_unaliased: "seed-map-unaliased" => ok observation(true, false, true, true, true, 8, "1,2", true, true, true, true)
        seed_search_full: "seed-search-full" => ok observation(true, true, false, true, true, 8, "1,2", true, true, true, true)
        seed_reduce_broken: "seed-reduce-broken" => ok observation(true, true, true, false, true, 8, "1,2", true, true, true, true)
        seed_failure_continues: "seed-failure-continues" => ok observation(true, true, true, true, false, 8, "1,2", true, true, true, true)
        seed_failure_narrow: "seed-failure-narrow" => ok observation(true, true, true, true, true, 7, "1,2", true, true, true, true)
        seed_stop_drift: "seed-stop-drift" => ok observation(true, true, true, true, true, 8, "1,2,3", true, true, true, true)
        seed_sort_unstable: "seed-sort-unstable" => ok observation(true, true, true, true, true, 8, "1,2", false, true, true, true)
        seed_copy_mutating: "seed-copy-mutating" => ok observation(true, true, true, true, true, 8, "1,2", true, false, true, true)
        seed_sync_parallel: "seed-sync-parallel" => ok observation(true, true, true, true, true, 8, "1,2", true, true, false, true)
        seed_fixture_reordered: "seed-fixture-reordered" => ok observation(true, true, true, true, true, 8, "1,2", true, true, true, false)
    match variant_id
        "seed-map-unordered" => ok observation(false, true, true, true, true, 8, "1,2", true, true, true, true)
        "seed-map-unaliased" => ok observation(true, false, true, true, true, 8, "1,2", true, true, true, true)
        "seed-search-full" => ok observation(true, true, false, true, true, 8, "1,2", true, true, true, true)
        "seed-reduce-broken" => ok observation(true, true, true, false, true, 8, "1,2", true, true, true, true)
        "seed-failure-continues" => ok observation(true, true, true, true, false, 8, "1,2", true, true, true, true)
        "seed-failure-narrow" => ok observation(true, true, true, true, true, 7, "1,2", true, true, true, true)
        "seed-stop-drift" => ok observation(true, true, true, true, true, 8, "1,2,3", true, true, true, true)
        "seed-sort-unstable" => ok observation(true, true, true, true, true, 8, "1,2", false, true, true, true)
        "seed-copy-mutating" => ok observation(true, true, true, true, true, 8, "1,2", true, false, true, true)
        "seed-sync-parallel" => ok observation(true, true, true, true, true, 8, "1,2", true, true, false, true)
        "seed-fixture-reordered" => ok observation(true, true, true, true, true, 8, "1,2", true, true, true, false)
        _ => ok observation(true, true, true, true, true, 8, "1,2", true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m03_001: "m03-001" => ok [check("map-order", "map visits indices serially in order with peak concurrency 1"), check("map-alias", "map preserves element aliases in a fresh frozen array"), check("search-early", "filter and search stop at first decision and skip empty inputs"), check("reduce-chain", "for_each serializes and fold protects accumulators and seeds"), check("failure-stop", "standard and domain failures stop every adapter with the identical carrier"), check("failure-adapters", "callback failures stop all 8 adapters"), check("stop-order", "failure visits pin 1,2 before stop"), check("sort-stable", "sort keys compute once in order with native stable order"), check("copy-immutable", "copying operations preserve order aliases and immutable sources"), check("sync-serial", "absent-context sync callbacks run serially with failure stop"), check("fixture-ordered", "mapping gaps keep later fixtures behind the traversal")]
        other: "nope" => ok []
    match scope is "m03-001"
        false => ok []
        true => ok [check("map-order", "map visits indices serially in order with peak concurrency 1"), check("map-alias", "map preserves element aliases in a fresh frozen array"), check("search-early", "filter and search stop at first decision and skip empty inputs"), check("reduce-chain", "for_each serializes and fold protects accumulators and seeds"), check("failure-stop", "standard and domain failures stop every adapter with the identical carrier"), check("failure-adapters", "callback failures stop all 8 adapters"), check("stop-order", "failure visits pin 1,2 before stop"), check("sort-stable", "sort keys compute once in order with native stable order"), check("copy-immutable", "copying operations preserve order aliases and immutable sources"), check("sync-serial", "absent-context sync callbacks run serially with failure stop"), check("fixture-ordered", "mapping gaps keep later fixtures behind the traversal")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/array-semantics" => ok [expected_check("map-order", "true"), expected_check("map-alias", "true"), expected_check("search-early", "true"), expected_check("reduce-chain", "true"), expected_check("failure-stop", "true"), expected_check("failure-adapters", "8"), expected_check("stop-order", "1,2"), expected_check("sort-stable", "true"), expected_check("copy-immutable", "true"), expected_check("sync-serial", "true"), expected_check("fixture-ordered", "true")]
        unknown: "nope" => ok []
    match case is "bundled/array-semantics"
        false => ok []
        true => ok [expected_check("map-order", "true"), expected_check("map-alias", "true"), expected_check("search-early", "true"), expected_check("reduce-chain", "true"), expected_check("failure-stop", "true"), expected_check("failure-adapters", "8"), expected_check("stop-order", "1,2"), expected_check("sort-stable", "true"), expected_check("copy-immutable", "true"), expected_check("sync-serial", "true"), expected_check("fixture-ordered", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/array-semantics", "default", "", "offline") => ok
        seed_map_unordered: context("bundled/array-semantics", "seed-map-unordered", "", "offline") => failed{"map-order"}
        seed_map_unaliased: context("bundled/array-semantics", "seed-map-unaliased", "", "offline") => failed{"map-alias"}
        seed_search_full: context("bundled/array-semantics", "seed-search-full", "", "offline") => failed{"search-early"}
        seed_reduce_broken: context("bundled/array-semantics", "seed-reduce-broken", "", "offline") => failed{"reduce-chain"}
        seed_failure_continues: context("bundled/array-semantics", "seed-failure-continues", "", "offline") => failed{"failure-stop"}
        seed_failure_narrow: context("bundled/array-semantics", "seed-failure-narrow", "", "offline") => failed{"failure-adapters"}
        seed_stop_drift: context("bundled/array-semantics", "seed-stop-drift", "", "offline") => failed{"stop-order"}
        seed_sort_unstable: context("bundled/array-semantics", "seed-sort-unstable", "", "offline") => failed{"sort-stable"}
        seed_copy_mutating: context("bundled/array-semantics", "seed-copy-mutating", "", "offline") => failed{"copy-immutable"}
        seed_sync_parallel: context("bundled/array-semantics", "seed-sync-parallel", "", "offline") => failed{"sync-serial"}
        seed_fixture_reordered: context("bundled/array-semantics", "seed-fixture-reordered", "", "offline") => failed{"fixture-ordered"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.map_ordered, true, c, "map-order")
            failed
            ok evidence ev_order => match call require_bool(got.map_aliased, true, c, "map-alias")
                failed
                ok evidence ev_alias => match call require_bool(got.search_early, true, c, "search-early")
                    failed
                    ok evidence ev_search => match call require_bool(got.reduce_chained, true, c, "reduce-chain")
                        failed
                        ok evidence ev_reduce => match call require_bool(got.failure_stops, true, c, "failure-stop")
                            failed
                            ok evidence ev_stop => match call require_int(got.failure_adapters, 8, c, "failure-adapters")
                                failed
                                ok evidence ev_adapters => match call require_text(got.stop_order, "1,2", c, "stop-order")
                                    failed
                                    ok evidence ev_sequence => match call require_bool(got.sort_stable, true, c, "sort-stable")
                                        failed
                                        ok evidence ev_sort => match call require_bool(got.copy_immutable, true, c, "copy-immutable")
                                            failed
                                            ok evidence ev_copy => match call require_bool(got.sync_serial, true, c, "sync-serial")
                                                failed
                                                ok evidence ev_sync => match call require_bool(got.fixture_ordered, true, c, "fixture-ordered")
                                                    failed
                                                    ok evidence ev_fixture => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m03_001: "m03-001" => ok test_case("bundled/array-semantics", ["arrays", "m03"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("map-order"), check_ref("map-alias"), check_ref("search-early"), check_ref("reduce-chain"), check_ref("failure-stop"), check_ref("failure-adapters"), check_ref("stop-order"), check_ref("sort-stable"), check_ref("copy-immutable"), check_ref("sync-serial"), check_ref("fixture-ordered")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m03-001"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/array-semantics", ["arrays", "m03"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("map-order"), check_ref("map-alias"), check_ref("search-early"), check_ref("reduce-chain"), check_ref("failure-stop"), check_ref("failure-adapters"), check_ref("stop-order"), check_ref("sort-stable"), check_ref("copy-immutable"), check_ref("sync-serial"), check_ref("fixture-ordered")], callable case_body)
