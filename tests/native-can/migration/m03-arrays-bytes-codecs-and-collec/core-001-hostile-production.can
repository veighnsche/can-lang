package m03core001hostile
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M03 CORE-001 "bundled arrays: hostile callbacks, native run legs".
/// Source: tests/integration/arrays_test.go symbol
/// TestCurrentBundledArrays.
/// Related fixtures: runtime/test/array.test.ts (owner, refusal and
/// delegation legs) and the strict-tsc leg over emitted dist TypeScript
/// (arrays_test.go L92-111).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): callback failures preserve domain and standard
/// occurrences with boundary origins; raw and forged callback results
/// are refused without assimilating then; explicit owner context reaches
/// element callbacks serially in order with undefined legacy context;
/// thenable and getter payloads keep identity with zero assimilation
/// calls; adapters delegate to native mapping, filtering, reduction and
/// sorting APIs with pinned call counts; the staged bun traces report
/// 10 pass and 0 fail; the strict tsc leg runs only when CAN_TSC is set
/// with CAN_BUN.
/// The 46+28 root pins and the silent production run live in
/// core-001-roots-green.can; order/alias/immutability/scheduling/
/// failure-stop per operation live in core-001-array-semantics.can.
/// Variants: callback failure, owner context, thenable/getter
/// hostility, native delegation, staged traces, conditional tsc.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_TSC with CAN_BUN gates the
/// optional strict tsc leg: conditional, never waived. Logical gates
/// SUITE/DIAG/FAULT and C/R/N/S/A identities bind at P23; no live run
/// now.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23).
/// Case bundled/arrays-hostile checks: callback-failure, raw-refusal,
/// owner-forward, owner-ordered, thenable-safe, native-mapping,
/// native-filtering, native-reducing, native-sorting, traces-pass,
/// traces-fail, tsc-conditional.
/// Facet map (legs): callback-failure pins the occurrence leg
/// (array.test.ts L596-660: domain carrier identical with the same
/// occurrence ID, standard carrier identical with kept occurrence ID
/// and can:adapter origin plus boundary origin, both stop at 1,2);
/// raw-refusal pins the forged-result leg (L662-700: hostile thenable,
/// forged ok carrier, raw int and undefined all refuse as standard at
/// 1,2 with 0 assimilations); owner-forward pins the owner leg
/// (L434-453: both element callbacks see the explicit owner, cleanup
/// clean, values doubled); owner-ordered pins the browser owner leg
/// (L702-735: serial gated starts 1n then 1n,2n, owners equal, legacy
/// contexts undefined); thenable-safe pins the extraction leg
/// (L737-787: then and getter payloads keep identity through map and
/// fold, empty fold returns the seed, 0 then and getter calls);
/// native-mapping/native-filtering/native-reducing/native-sorting pin
/// the delegation leg (L391-432: mapping 3, filtering 1, reducing 2,
/// sorting 1); traces-pass/traces-fail pin the staged output predicates
/// (arrays_test.go L32-33: contains 10 pass and 0 fail verbatim);
/// tsc-conditional pins the optional leg (arrays_test.go L92-111: tsc
/// strict over dist TypeScript via CAN_BUN iff CAN_TSC is set).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool callback_failure
    bool raw_refusal
    bool owner_forward
    bool owner_ordered
    bool thenable_safe
    int native_mapping
    int native_filtering
    int native_reducing
    int native_sorting
    str pass_text
    str fail_text
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/arrays-hostile", "default", "", "offline"), "callback-failure" => ok "case bundled/arrays-hostile variant default root callback-failure run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/arrays-hostile", "default", "", "offline"), "callback-failure" => ok evidence("callback-failure", "true", "true", true, "case bundled/arrays-hostile variant default root callback-failure run offline")
        different: false, true, context("bundled/arrays-hostile", "default", "", "offline"), "callback-failure" => failed{"callback-failure"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("bundled/arrays-hostile", "default", "", "offline"), "native-mapping" => ok evidence("native-mapping", "3", "3", true, "case bundled/arrays-hostile variant default root native-mapping run offline")
        different: 2, 3, context("bundled/arrays-hostile", "default", "", "offline"), "native-mapping" => failed{"native-mapping"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "10 pass", "10 pass", context("bundled/arrays-hostile", "default", "", "offline"), "traces-pass" => ok evidence("traces-pass", "10 pass", "10 pass", true, "case bundled/arrays-hostile variant default root traces-pass run offline")
        different: "9 pass", "10 pass", context("bundled/arrays-hostile", "default", "", "offline"), "traces-pass" => failed{"traces-pass"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        seed_occurrence_lost: "seed-occurrence-lost" => ok observation(false, true, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        seed_raw_accepted: "seed-raw-accepted" => ok observation(true, false, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        seed_owner_dropped: "seed-owner-dropped" => ok observation(true, true, false, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        seed_owner_unordered: "seed-owner-unordered" => ok observation(true, true, true, false, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        seed_thenable_assimilated: "seed-thenable-assimilated" => ok observation(true, true, true, true, false, 3, 1, 2, 1, "10 pass", "0 fail", true)
        seed_mapping_drift: "seed-mapping-drift" => ok observation(true, true, true, true, true, 2, 1, 2, 1, "10 pass", "0 fail", true)
        seed_filtering_drift: "seed-filtering-drift" => ok observation(true, true, true, true, true, 3, 0, 2, 1, "10 pass", "0 fail", true)
        seed_reducing_drift: "seed-reducing-drift" => ok observation(true, true, true, true, true, 3, 1, 1, 1, "10 pass", "0 fail", true)
        seed_sorting_drift: "seed-sorting-drift" => ok observation(true, true, true, true, true, 3, 1, 2, 0, "10 pass", "0 fail", true)
        seed_pass_drift: "seed-pass-drift" => ok observation(true, true, true, true, true, 3, 1, 2, 1, "9 pass", "0 fail", true)
        seed_fail_drift: "seed-fail-drift" => ok observation(true, true, true, true, true, 3, 1, 2, 1, "10 pass", "1 fail", true)
        seed_tsc_unconditional: "seed-tsc-unconditional" => ok observation(true, true, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", false)
    match variant_id
        "seed-occurrence-lost" => ok observation(false, true, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        "seed-raw-accepted" => ok observation(true, false, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        "seed-owner-dropped" => ok observation(true, true, false, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        "seed-owner-unordered" => ok observation(true, true, true, false, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
        "seed-thenable-assimilated" => ok observation(true, true, true, true, false, 3, 1, 2, 1, "10 pass", "0 fail", true)
        "seed-mapping-drift" => ok observation(true, true, true, true, true, 2, 1, 2, 1, "10 pass", "0 fail", true)
        "seed-filtering-drift" => ok observation(true, true, true, true, true, 3, 0, 2, 1, "10 pass", "0 fail", true)
        "seed-reducing-drift" => ok observation(true, true, true, true, true, 3, 1, 1, 1, "10 pass", "0 fail", true)
        "seed-sorting-drift" => ok observation(true, true, true, true, true, 3, 1, 2, 0, "10 pass", "0 fail", true)
        "seed-pass-drift" => ok observation(true, true, true, true, true, 3, 1, 2, 1, "9 pass", "0 fail", true)
        "seed-fail-drift" => ok observation(true, true, true, true, true, 3, 1, 2, 1, "10 pass", "1 fail", true)
        "seed-tsc-unconditional" => ok observation(true, true, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", false)
        _ => ok observation(true, true, true, true, true, 3, 1, 2, 1, "10 pass", "0 fail", true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m03_001: "m03-001" => ok [check("callback-failure", "callback failures preserve occurrences with boundary origins"), check("raw-refusal", "raw and forged callback results are refused without assimilation"), check("owner-forward", "map forwards the explicit owner context to element callbacks"), check("owner-ordered", "browser owner callbacks receive owner and undefined context in order"), check("thenable-safe", "then and getter payloads keep identity with zero assimilation"), check("native-mapping", "mapping delegation pins 3 native calls"), check("native-filtering", "filtering delegation pins 1 native call"), check("native-reducing", "reduction delegation pins 2 native calls"), check("native-sorting", "sorting delegation pins 1 native call"), check("traces-pass", "staged bun output contains 10 pass"), check("traces-fail", "staged bun output contains 0 fail"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
        other: "nope" => ok []
    match scope is "m03-001"
        false => ok []
        true => ok [check("callback-failure", "callback failures preserve occurrences with boundary origins"), check("raw-refusal", "raw and forged callback results are refused without assimilation"), check("owner-forward", "map forwards the explicit owner context to element callbacks"), check("owner-ordered", "browser owner callbacks receive owner and undefined context in order"), check("thenable-safe", "then and getter payloads keep identity with zero assimilation"), check("native-mapping", "mapping delegation pins 3 native calls"), check("native-filtering", "filtering delegation pins 1 native call"), check("native-reducing", "reduction delegation pins 2 native calls"), check("native-sorting", "sorting delegation pins 1 native call"), check("traces-pass", "staged bun output contains 10 pass"), check("traces-fail", "staged bun output contains 0 fail"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/arrays-hostile" => ok [expected_check("callback-failure", "true"), expected_check("raw-refusal", "true"), expected_check("owner-forward", "true"), expected_check("owner-ordered", "true"), expected_check("thenable-safe", "true"), expected_check("native-mapping", "3"), expected_check("native-filtering", "1"), expected_check("native-reducing", "2"), expected_check("native-sorting", "1"), expected_check("traces-pass", "10 pass"), expected_check("traces-fail", "0 fail"), expected_check("tsc-conditional", "true")]
        unknown: "nope" => ok []
    match case is "bundled/arrays-hostile"
        false => ok []
        true => ok [expected_check("callback-failure", "true"), expected_check("raw-refusal", "true"), expected_check("owner-forward", "true"), expected_check("owner-ordered", "true"), expected_check("thenable-safe", "true"), expected_check("native-mapping", "3"), expected_check("native-filtering", "1"), expected_check("native-reducing", "2"), expected_check("native-sorting", "1"), expected_check("traces-pass", "10 pass"), expected_check("traces-fail", "0 fail"), expected_check("tsc-conditional", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/arrays-hostile", "default", "", "offline") => ok
        seed_occurrence_lost: context("bundled/arrays-hostile", "seed-occurrence-lost", "", "offline") => failed{"callback-failure"}
        seed_raw_accepted: context("bundled/arrays-hostile", "seed-raw-accepted", "", "offline") => failed{"raw-refusal"}
        seed_owner_dropped: context("bundled/arrays-hostile", "seed-owner-dropped", "", "offline") => failed{"owner-forward"}
        seed_owner_unordered: context("bundled/arrays-hostile", "seed-owner-unordered", "", "offline") => failed{"owner-ordered"}
        seed_thenable_assimilated: context("bundled/arrays-hostile", "seed-thenable-assimilated", "", "offline") => failed{"thenable-safe"}
        seed_mapping_drift: context("bundled/arrays-hostile", "seed-mapping-drift", "", "offline") => failed{"native-mapping"}
        seed_filtering_drift: context("bundled/arrays-hostile", "seed-filtering-drift", "", "offline") => failed{"native-filtering"}
        seed_reducing_drift: context("bundled/arrays-hostile", "seed-reducing-drift", "", "offline") => failed{"native-reducing"}
        seed_sorting_drift: context("bundled/arrays-hostile", "seed-sorting-drift", "", "offline") => failed{"native-sorting"}
        seed_pass_drift: context("bundled/arrays-hostile", "seed-pass-drift", "", "offline") => failed{"traces-pass"}
        seed_fail_drift: context("bundled/arrays-hostile", "seed-fail-drift", "", "offline") => failed{"traces-fail"}
        seed_tsc_unconditional: context("bundled/arrays-hostile", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.callback_failure, true, c, "callback-failure")
            failed
            ok evidence ev_failure => match call require_bool(got.raw_refusal, true, c, "raw-refusal")
                failed
                ok evidence ev_refusal => match call require_bool(got.owner_forward, true, c, "owner-forward")
                    failed
                    ok evidence ev_forward => match call require_bool(got.owner_ordered, true, c, "owner-ordered")
                        failed
                        ok evidence ev_ordered => match call require_bool(got.thenable_safe, true, c, "thenable-safe")
                            failed
                            ok evidence ev_safe => match call require_int(got.native_mapping, 3, c, "native-mapping")
                                failed
                                ok evidence ev_mapping => match call require_int(got.native_filtering, 1, c, "native-filtering")
                                    failed
                                    ok evidence ev_filtering => match call require_int(got.native_reducing, 2, c, "native-reducing")
                                        failed
                                        ok evidence ev_reducing => match call require_int(got.native_sorting, 1, c, "native-sorting")
                                            failed
                                            ok evidence ev_sorting => match call require_text(got.pass_text, "10 pass", c, "traces-pass")
                                                failed
                                                ok evidence ev_pass => match call require_text(got.fail_text, "0 fail", c, "traces-fail")
                                                    failed
                                                    ok evidence ev_fail => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                                        failed
                                                        ok evidence ev_tsc => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m03_001: "m03-001" => ok test_case("bundled/arrays-hostile", ["arrays", "m03"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("callback-failure"), check_ref("raw-refusal"), check_ref("owner-forward"), check_ref("owner-ordered"), check_ref("thenable-safe"), check_ref("native-mapping"), check_ref("native-filtering"), check_ref("native-reducing"), check_ref("native-sorting"), check_ref("traces-pass"), check_ref("traces-fail"), check_ref("tsc-conditional")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m03-001"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/arrays-hostile", ["arrays", "m03"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("callback-failure"), check_ref("raw-refusal"), check_ref("owner-forward"), check_ref("owner-ordered"), check_ref("thenable-safe"), check_ref("native-mapping"), check_ref("native-filtering"), check_ref("native-reducing"), check_ref("native-sorting"), check_ref("traces-pass"), check_ref("traces-fail"), check_ref("tsc-conditional")], callable case_body)
