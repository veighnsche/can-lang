        "seed-private-drift" => ok observation(true, true, true, true, "integer_token", true, "type", true, true, true, true, "type")
        _ => ok observation(true, true, true, true, "integer_token", true, "type", true, true, true, true, "variant_tag")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m03_009: "m03-009" => ok [check("bigint-roundtrip", "receipt amount 9007199254740993 roundtrips exactly"), check("unicode-roundtrip", "unicode description payload survives the roundtrip"), check("scaled-integer", "scaled 1.25e2 decodes to 125"), check("fractional-rejected", "fractional 1.25 is rejected as invalid data"), check("fractional-reason", "fractional rejection pins integer_token"), check("quoted-rejected", "quoted 42 is rejected as invalid data"), check("quoted-reason", "quoted rejection pins type"), check("callable-decode", "callable decode_json path decodes the big integer"), check("option-encode", "option some value encodes to its JSON shape"), check("option-decode", "option some JSON decodes back to some 42"), check("private-name-rejected", "private can.std.option tag is rejected as invalid data"), check("private-reason", "private-name rejection pins variant_tag")]
