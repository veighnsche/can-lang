        true => ok [expected_check("bigint-roundtrip", "true"), expected_check("unicode-roundtrip", "true"), expected_check("scaled-integer", "true"), expected_check("fractional-rejected", "true"), expected_check("fractional-reason", "integer_token"), expected_check("quoted-rejected", "true"), expected_check("quoted-reason", "type"), expected_check("callable-decode", "true"), expected_check("option-encode", "true"), expected_check("option-decode", "true"), expected_check("private-name-rejected", "true"), expected_check("private-reason", "variant_tag")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/codec-preservation", "default", "", "offline") => ok
        seed_bigint_loss: context("bundled/codec-preservation", "seed-bigint-loss", "", "offline") => failed{"bigint-roundtrip"}
        seed_unicode_loss: context("bundled/codec-preservation", "seed-unicode-loss", "", "offline") => failed{"unicode-roundtrip"}
        seed_scaled_red: context("bundled/codec-preservation", "seed-scaled-red", "", "offline") => failed{"scaled-integer"}
        seed_fractional_accepted: context("bundled/codec-preservation", "seed-fractional-accepted", "", "offline") => failed{"fractional-rejected"}
        seed_fractional_drift: context("bundled/codec-preservation", "seed-fractional-drift", "", "offline") => failed{"fractional-reason"}
        seed_quoted_accepted: context("bundled/codec-preservation", "seed-quoted-accepted", "", "offline") => failed{"quoted-rejected"}
        seed_quoted_drift: context("bundled/codec-preservation", "seed-quoted-drift", "", "offline") => failed{"quoted-reason"}
        seed_callable_red: context("bundled/codec-preservation", "seed-callable-red", "", "offline") => failed{"callable-decode"}
        seed_option_encode_red: context("bundled/codec-preservation", "seed-option-encode-red", "", "offline") => failed{"option-encode"}
        seed_option_decode_red: context("bundled/codec-preservation", "seed-option-decode-red", "", "offline") => failed{"option-decode"}
        seed_private_accepted: context("bundled/codec-preservation", "seed-private-accepted", "", "offline") => failed{"private-name-rejected"}
        seed_private_drift: context("bundled/codec-preservation", "seed-private-drift", "", "offline") => failed{"private-reason"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.bigint_roundtrip, true, c, "bigint-roundtrip")
            failed
            ok evidence bigint_evidence => match call require_bool(got.unicode_roundtrip, true, c, "unicode-roundtrip")
                failed
                ok evidence unicode_evidence => match call require_bool(got.scaled_integer, true, c, "scaled-integer")
                    failed
                    ok evidence scaled_evidence => match call require_bool(got.fractional_rejected, true, c, "fractional-rejected")
                        failed
                        ok evidence fractional_evidence => match call require_text(got.fractional_reason, "integer_token", c, "fractional-reason")
                            failed
                            ok evidence fractional_reason_evidence => match call require_bool(got.quoted_rejected, true, c, "quoted-rejected")
                                failed
                                ok evidence quoted_evidence => match call require_text(got.quoted_reason, "type", c, "quoted-reason")
                                    failed
                                    ok evidence quoted_reason_evidence => match call require_bool(got.callable_decode, true, c, "callable-decode")
                                        failed
                                        ok evidence callable_evidence => match call require_bool(got.option_encode, true, c, "option-encode")
                                            failed
                                            ok evidence option_encode_evidence => match call require_bool(got.option_decode, true, c, "option-decode")
                                                failed
                                                ok evidence option_decode_evidence => match call require_bool(got.private_rejected, true, c, "private-name-rejected")
                                                    failed
                                                    ok evidence private_evidence => match call require_text(got.private_reason, "variant_tag", c, "private-reason")
                                                        failed
                                                        ok evidence private_reason_evidence => ok
