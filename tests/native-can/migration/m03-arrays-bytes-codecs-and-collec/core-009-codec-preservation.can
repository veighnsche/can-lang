        "seed-unicode-loss" => ok observation(true, false, true, true, "integer_token", true, "type", true, true, true, true, "variant_tag")
        "seed-scaled-red" => ok observation(true, true, false, true, "integer_token", true, "type", true, true, true, true, "variant_tag")
        "seed-fractional-accepted" => ok observation(true, true, true, false, "integer_token", true, "type", true, true, true, true, "variant_tag")
        "seed-fractional-drift" => ok observation(true, true, true, true, "type", true, "type", true, true, true, true, "variant_tag")
        "seed-quoted-accepted" => ok observation(true, true, true, true, "integer_token", false, "type", true, true, true, true, "variant_tag")
        "seed-quoted-drift" => ok observation(true, true, true, true, "integer_token", true, "integer_token", true, true, true, true, "variant_tag")
        "seed-callable-red" => ok observation(true, true, true, true, "integer_token", true, "type", false, true, true, true, "variant_tag")
        "seed-option-encode-red" => ok observation(true, true, true, true, "integer_token", true, "type", true, false, true, true, "variant_tag")
        "seed-option-decode-red" => ok observation(true, true, true, true, "integer_token", true, "type", true, true, false, true, "variant_tag")
