package m03core009codec
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M03 CORE-009 "bundled codec: encode/decode preservation".
/// Source: tests/integration/codec_test.go symbol
/// TestCurrentBundledCodec.
/// Related fixtures: compiler/testdata/current/codec/roundtrip.can
/// (roundtrip L7-17, decode_integer L18-31, via_callable L32-43,
/// encode_option L59-69, decode_option L70-81).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production execution preserves encoding/decoding
/// behavior: exact big-int and unicode receipt roundtrip, scaled integer
/// decoding, fractional and quoted rejections with verbatim reasons,
/// callable decode path, option encode/decode, and private-name rejection
/// with verbatim reason.
/// The 10-root pin lives in core-009-roots-green.can; the production run
/// output/status shape lives in core-009-run-shape.can.
/// Variants: roundtrip.can fixture.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23).
/// Case bundled/codec-preservation checks: bigint-roundtrip,
/// unicode-roundtrip, scaled-integer, fractional-rejected,
/// fractional-reason, quoted-rejected, quoted-reason, callable-decode,
/// option-encode, option-decode, private-name-rejected, private-reason.
/// Facet map (roundtrip.can roots): bigint-roundtrip pins the exact root
/// (L12: receipt 9007199254740993 roundtrips exactly);
/// unicode-roundtrip pins the unicode payload (L12: the description with
/// the accented e and emoji survives); scaled-integer pins the scaled root
/// (L24: "1.25e2" => ok 125); fractional-rejected/fractional-reason pin
/// the fractional root (L25: "1.25" => invalid_data reason
/// "integer_token"); quoted-rejected/quoted-reason pin the quoted root
/// (L26: '"42"' => invalid_data reason "type"); callable-decode pins the
/// callable root (L37: decode through callable decode_json<int>);
/// option-encode pins the option encode root (L64: 42 => ok option some
/// JSON); option-decode pins the option decode root (L75: option some JSON
/// => ok some 42); private-name-rejected/private-reason pin the
/// private-name root (L76: can.std.option tag => invalid_data reason
/// "variant_tag").
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool bigint_roundtrip
    bool unicode_roundtrip
    bool scaled_integer
    bool fractional_rejected
    str fractional_reason
    bool quoted_rejected
    str quoted_reason
    bool callable_decode
    bool option_encode
    bool option_decode
    bool private_rejected
    str private_reason
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/codec-preservation", "default", "", "offline"), "bigint-roundtrip" => ok "case bundled/codec-preservation variant default root bigint-roundtrip run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/codec-preservation", "default", "", "offline"), "bigint-roundtrip" => ok evidence("bigint-roundtrip", "true", "true", true, "case bundled/codec-preservation variant default root bigint-roundtrip run offline")
        different: false, true, context("bundled/codec-preservation", "default", "", "offline"), "bigint-roundtrip" => failed{"bigint-roundtrip"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("bundled/codec-preservation", "default", "", "offline"), "root-count" => ok evidence("root-count", "10", "10", true, "case bundled/codec-preservation variant default root root-count run offline")
        different: 9, 10, context("bundled/codec-preservation", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "integer_token", "integer_token", context("bundled/codec-preservation", "default", "", "offline"), "fractional-reason" => ok evidence("fractional-reason", "integer_token", "integer_token", true, "case bundled/codec-preservation variant default root fractional-reason run offline")
        different: "type", "integer_token", context("bundled/codec-preservation", "default", "", "offline"), "fractional-reason" => failed{"fractional-reason"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
