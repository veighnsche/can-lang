        true => ok test_case("bundled/codec-preservation", ["codec", "m03"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("bigint-roundtrip"), check_ref("unicode-roundtrip"), check_ref("scaled-integer"), check_ref("fractional-rejected"), check_ref("fractional-reason"), check_ref("quoted-rejected"), check_ref("quoted-reason"), check_ref("callable-decode"), check_ref("option-encode"), check_ref("option-decode"), check_ref("private-name-rejected"), check_ref("private-reason")], callable case_body)
