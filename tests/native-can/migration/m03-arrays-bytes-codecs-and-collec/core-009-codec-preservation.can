    asserts
        known: "bundled/codec-preservation" => ok [expected_check("bigint-roundtrip", "true"), expected_check("unicode-roundtrip", "true"), expected_check("scaled-integer", "true"), expected_check("fractional-rejected", "true"), expected_check("fractional-reason", "integer_token"), expected_check("quoted-rejected", "true"), expected_check("quoted-reason", "type"), expected_check("callable-decode", "true"), expected_check("option-encode", "true"), expected_check("option-decode", "true"), expected_check("private-name-rejected", "true"), expected_check("private-reason", "variant_tag")]
