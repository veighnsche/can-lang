        seed_unicode_loss: "seed-unicode-loss" => ok observation(true, false, true, true, "integer_token", true, "type", true, true, true, true, "variant_tag")
        seed_scaled_red: "seed-scaled-red" => ok observation(true, true, false, true, "integer_token", true, "type", true, true, true, true, "variant_tag")
        seed_fractional_accepted: "seed-fractional-accepted" => ok observation(true, true, true, false, "integer_token", true, "type", true, true, true, true, "variant_tag")
        seed_fractional_drift: "seed-fractional-drift" => ok observation(true, true, true, true, "type", true, "type", true, true, true, true, "variant_tag")
