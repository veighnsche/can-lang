package m03core010collections
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M03 CORE-010 "bundled collections: map/set semantics, safe rejection".
/// Source: tests/integration/collections_test.go symbol
/// TestCurrentBundledCollections.
/// Related sources: runtime/test/collections.test.ts (the 10 bun-trace
/// roots behind DELEGATE-008; every behavior pin below cites its root) and
/// std/map/current/src/main.can (the 19 Can fixture roots asserting the
/// same semantics through the collections API).
/// Disposition: MIGRATE (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): maps/sets copy immutably with nominal keys,
/// forged and revoked values reject safely, native set order/equality hold,
/// and bulk construction publishes atomically with first-occurrence order.
/// The 19-root assert pin lives in core-010-roots-green.can; the run
/// output/status shape and silent production entry live in
/// core-010-run-shape.can.
/// Variants: duplicate bulk key, forged token, revoked backing,
/// intersection branches (small/large size branches).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec, CAN_TSC optional with
/// CAN_BUN; requires can-bun-archive, macos-sandbox-exec. Logical gates
/// SUITE/DIAG/FAULT and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-008 (runtime/test/collections.test.ts, 10
/// declarations, sha256 f235f9c2...5cad12; recorded, not executed; the Go
/// "4 pass"/"0 fail" spellings at collections_test.go L32 are old
/// pass-count spellings needing current-contract relevance review against
/// the live 10-root file).
/// Execution credit: NOT claimed (accept_after P23/QN2; both UNMET).
/// Case bundled/collections-semantics checks: immutable-copy, nominal-key,
/// forged-reject, revoked-reject, set-order, set-equality, atomic-bulk,
/// duplicate-bulk-key, intersection-branch.
/// Facet map (collections.test.ts roots + main.can roots): immutable-copy
/// pins immutable versions (L47-71: empty/first/second/replaced/removed
/// versions, aliases, frozen snapshots; L72-108: opaque containment with
/// snapshot lengths [0,1,2,2,1,2]; main.can alias L84-95: get(first,3)
/// still "original" after replace); nominal-key pins nominal entries and
/// key families (L47-71: entries keep [3n,2n] order with nominal values;
/// L265-320: str keys "", emoji, "__proto__", bool keys false/true;
/// main.can bool_keys L117-124, reference L125-133); forged-reject pins
/// forged storage rejection (L110-131: frozen {}, spread copy, Proxy,
/// record(), wrong keys 1/NaN/{}/"1"/true, wrong specialization);
/// revoked-reject pins revoked/unknown backing rejection (L133-227:
/// null/undefined/primitives/symbols/functions, unknown objects, zero-trap
/// proxies, revoked proxy L212-217, cross-type union/intersection/
/// difference L218-220); set-order pins native left order (L228-264:
/// [3n,2n,1n] through union/intersection/difference/add; main.can sets
/// L14-23); set-equality pins native equality and shared provenance
/// (L265-320: matching factories share provenance, "different" rejects;
/// main.can set_operations L96-116, folded L144-150); atomic-bulk pins
/// single-publish bulk construction (L321-338: build_map first-occurrence
/// [3n,2n], frozen; L353-378: build_set dedupes [3n,2n,3n,1n] to
/// [3n,2n,1n], frozen; L379-392: 20000 entries linear under 15000ms);
/// duplicate-bulk-key pins atomic duplicate failure (L339-352: duplicate
/// 3n => "collections::key_exists"; main.can changed duplicate L62: 2 =>
/// key_exists); intersection-branch pins both size branches (L250-254:
/// small [1n,2n] and large [1n,2n,4n,5n] both yield [2n,1n]; empty L263).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool immutable_copy
    bool nominal_key
    bool forged_reject
    bool revoked_reject
    bool set_order
    bool set_equality
    bool atomic_bulk
    str duplicate_error
    int branch_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/collections-semantics", "default", "", "offline"), "immutable-copy" => ok "case bundled/collections-semantics variant default root immutable-copy run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/collections-semantics", "default", "", "offline"), "immutable-copy" => ok evidence("immutable-copy", "true", "true", true, "case bundled/collections-semantics variant default root immutable-copy run offline")
        different: false, true, context("bundled/collections-semantics", "default", "", "offline"), "immutable-copy" => failed{"immutable-copy"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("bundled/collections-semantics", "default", "", "offline"), "intersection-branch" => ok evidence("intersection-branch", "2", "2", true, "case bundled/collections-semantics variant default root intersection-branch run offline")
        different: 1, 2, context("bundled/collections-semantics", "default", "", "offline"), "intersection-branch" => failed{"intersection-branch"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "collections::key_exists", "collections::key_exists", context("bundled/collections-semantics", "default", "", "offline"), "duplicate-bulk-key" => ok evidence("duplicate-bulk-key", "collections::key_exists", "collections::key_exists", true, "case bundled/collections-semantics variant default root duplicate-bulk-key run offline")
        different: "collections::key_absent", "collections::key_exists", context("bundled/collections-semantics", "default", "", "offline"), "duplicate-bulk-key" => failed{"duplicate-bulk-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, true, true, true, "collections::key_exists", 2)
        seed_copy_mutated: "seed-copy-mutated" => ok observation(false, true, true, true, true, true, true, "collections::key_exists", 2)
        seed_key_flattened: "seed-key-flattened" => ok observation(true, false, true, true, true, true, true, "collections::key_exists", 2)
        seed_forged_accepted: "seed-forged-accepted" => ok observation(true, true, false, true, true, true, true, "collections::key_exists", 2)
        seed_revoked_accepted: "seed-revoked-accepted" => ok observation(true, true, true, false, true, true, true, "collections::key_exists", 2)
        seed_order_lost: "seed-order-lost" => ok observation(true, true, true, true, false, true, true, "collections::key_exists", 2)
        seed_equality_lost: "seed-equality-lost" => ok observation(true, true, true, true, true, false, true, "collections::key_exists", 2)
        seed_bulk_split: "seed-bulk-split" => ok observation(true, true, true, true, true, true, false, "collections::key_exists", 2)
        seed_duplicate_drift: "seed-duplicate-drift" => ok observation(true, true, true, true, true, true, true, "collections::key_absent", 2)
        seed_branch_lost: "seed-branch-lost" => ok observation(true, true, true, true, true, true, true, "collections::key_exists", 1)
    match variant_id
        "seed-copy-mutated" => ok observation(false, true, true, true, true, true, true, "collections::key_exists", 2)
        "seed-key-flattened" => ok observation(true, false, true, true, true, true, true, "collections::key_exists", 2)
        "seed-forged-accepted" => ok observation(true, true, false, true, true, true, true, "collections::key_exists", 2)
        "seed-revoked-accepted" => ok observation(true, true, true, false, true, true, true, "collections::key_exists", 2)
        "seed-order-lost" => ok observation(true, true, true, true, false, true, true, "collections::key_exists", 2)
        "seed-equality-lost" => ok observation(true, true, true, true, true, false, true, "collections::key_exists", 2)
        "seed-bulk-split" => ok observation(true, true, true, true, true, true, false, "collections::key_exists", 2)
        "seed-duplicate-drift" => ok observation(true, true, true, true, true, true, true, "collections::key_absent", 2)
        "seed-branch-lost" => ok observation(true, true, true, true, true, true, true, "collections::key_exists", 1)
        _ => ok observation(true, true, true, true, true, true, true, "collections::key_exists", 2)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m03_010: "m03-010" => ok [check("immutable-copy", "map/set versions copy immutably with frozen snapshots"), check("nominal-key", "entries keep nominal keys order and values"), check("forged-reject", "forged and copied tokens and bad keys reject"), check("revoked-reject", "revoked and unknown backing rejects without traps"), check("set-order", "native set ops preserve left order"), check("set-equality", "scalar keys keep native equality and shared provenance"), check("atomic-bulk", "bulk construction publishes once in first-occurrence order"), check("duplicate-bulk-key", "duplicate bulk key fails atomically with key_exists"), check("intersection-branch", "both intersection size branches keep left order")]
        other: "nope" => ok []
    match scope is "m03-010"
        false => ok []
        true => ok [check("immutable-copy", "map/set versions copy immutably with frozen snapshots"), check("nominal-key", "entries keep nominal keys order and values"), check("forged-reject", "forged and copied tokens and bad keys reject"), check("revoked-reject", "revoked and unknown backing rejects without traps"), check("set-order", "native set ops preserve left order"), check("set-equality", "scalar keys keep native equality and shared provenance"), check("atomic-bulk", "bulk construction publishes once in first-occurrence order"), check("duplicate-bulk-key", "duplicate bulk key fails atomically with key_exists"), check("intersection-branch", "both intersection size branches keep left order")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/collections-semantics" => ok [expected_check("immutable-copy", "true"), expected_check("nominal-key", "true"), expected_check("forged-reject", "true"), expected_check("revoked-reject", "true"), expected_check("set-order", "true"), expected_check("set-equality", "true"), expected_check("atomic-bulk", "true"), expected_check("duplicate-bulk-key", "collections::key_exists"), expected_check("intersection-branch", "2")]
        unknown: "nope" => ok []
    match case is "bundled/collections-semantics"
        false => ok []
        true => ok [expected_check("immutable-copy", "true"), expected_check("nominal-key", "true"), expected_check("forged-reject", "true"), expected_check("revoked-reject", "true"), expected_check("set-order", "true"), expected_check("set-equality", "true"), expected_check("atomic-bulk", "true"), expected_check("duplicate-bulk-key", "collections::key_exists"), expected_check("intersection-branch", "2")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/collections-semantics", "default", "", "offline") => ok
        seed_copy_mutated: context("bundled/collections-semantics", "seed-copy-mutated", "", "offline") => failed{"immutable-copy"}
        seed_key_flattened: context("bundled/collections-semantics", "seed-key-flattened", "", "offline") => failed{"nominal-key"}
        seed_forged_accepted: context("bundled/collections-semantics", "seed-forged-accepted", "", "offline") => failed{"forged-reject"}
        seed_revoked_accepted: context("bundled/collections-semantics", "seed-revoked-accepted", "", "offline") => failed{"revoked-reject"}
        seed_order_lost: context("bundled/collections-semantics", "seed-order-lost", "", "offline") => failed{"set-order"}
        seed_equality_lost: context("bundled/collections-semantics", "seed-equality-lost", "", "offline") => failed{"set-equality"}
        seed_bulk_split: context("bundled/collections-semantics", "seed-bulk-split", "", "offline") => failed{"atomic-bulk"}
        seed_duplicate_drift: context("bundled/collections-semantics", "seed-duplicate-drift", "", "offline") => failed{"duplicate-bulk-key"}
        seed_branch_lost: context("bundled/collections-semantics", "seed-branch-lost", "", "offline") => failed{"intersection-branch"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.immutable_copy, true, c, "immutable-copy")
            failed
            ok evidence copy_evidence => match call require_bool(got.nominal_key, true, c, "nominal-key")
                failed
                ok evidence key_evidence => match call require_bool(got.forged_reject, true, c, "forged-reject")
                    failed
                    ok evidence forged_evidence => match call require_bool(got.revoked_reject, true, c, "revoked-reject")
                        failed
                        ok evidence revoked_evidence => match call require_bool(got.set_order, true, c, "set-order")
                            failed
                            ok evidence order_evidence => match call require_bool(got.set_equality, true, c, "set-equality")
                                failed
                                ok evidence equality_evidence => match call require_bool(got.atomic_bulk, true, c, "atomic-bulk")
                                    failed
                                    ok evidence bulk_evidence => match call require_text(got.duplicate_error, "collections::key_exists", c, "duplicate-bulk-key")
                                        failed
                                        ok evidence duplicate_evidence => match call require_int(got.branch_count, 2, c, "intersection-branch")
                                            failed
                                            ok evidence branch_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m03_010: "m03-010" => ok test_case("bundled/collections-semantics", ["collections", "m03"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("immutable-copy"), check_ref("nominal-key"), check_ref("forged-reject"), check_ref("revoked-reject"), check_ref("set-order"), check_ref("set-equality"), check_ref("atomic-bulk"), check_ref("duplicate-bulk-key"), check_ref("intersection-branch")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m03-010"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/collections-semantics", ["collections", "m03"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("immutable-copy"), check_ref("nominal-key"), check_ref("forged-reject"), check_ref("revoked-reject"), check_ref("set-order"), check_ref("set-equality"), check_ref("atomic-bulk"), check_ref("duplicate-bulk-key"), check_ref("intersection-branch")], callable case_body)
