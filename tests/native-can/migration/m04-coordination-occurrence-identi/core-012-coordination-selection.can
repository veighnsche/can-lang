                                                        failed
                                                        ok evidence faults_evidence => match call require_int(got.snapshot_leaves, 3, c, "snapshot-identity")
                                                            failed
                                                            ok evidence snapshot_evidence => match call require_int(got.empty_race_deadline_ms, 10, c, "empty-race-pending")
                                                                failed
                                                                ok evidence pending_evidence => match call require_int(got.owner_value, 7, c, "owner-retention")
                                                                    failed
                                                                    ok evidence retention_evidence => match call require_bool(got.native_delegated, true, c, "native-delegation")
                                                                        failed
                                                                        ok evidence delegation_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m04_012: "m04-012" => ok test_case("bundled/coordination-selection", ["coordination", "m04"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("all-first-rejection"), check_ref("settled-ordered"), check_ref("settled-handler-stop"), check_ref("any-allfailed-order"), check_ref("any-consume-late"), check_ref("race-first"), check_ref("empty-modes"), check_ref("aggregate-identity"), check_ref("first-failure-handling"), check_ref("settled-standard-slot"), check_ref("any-last-success"), check_ref("handler-faults"), check_ref("snapshot-identity"), check_ref("empty-race-pending"), check_ref("owner-retention"), check_ref("native-delegation")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m04-012"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/coordination-selection", ["coordination", "m04"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("all-first-rejection"), check_ref("settled-ordered"), check_ref("settled-handler-stop"), check_ref("any-allfailed-order"), check_ref("any-consume-late"), check_ref("race-first"), check_ref("empty-modes"), check_ref("aggregate-identity"), check_ref("first-failure-handling"), check_ref("settled-standard-slot"), check_ref("any-last-success"), check_ref("handler-faults"), check_ref("snapshot-identity"), check_ref("empty-race-pending"), check_ref("owner-retention"), check_ref("native-delegation")], callable case_body)
