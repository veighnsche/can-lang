    asserts
        same: "Error: late", "Error: late", context("bundled/coordination-selection", "default", "", "offline"), "any-consume-late" => ok evidence("any-consume-late", "Error: late", "Error: late", true, "case bundled/coordination-selection variant default root any-consume-late run offline")
        different: "Error: missing", "Error: late", context("bundled/coordination-selection", "default", "", "offline"), "any-consume-late" => failed{"any-consume-late"}
    match observed is expected
