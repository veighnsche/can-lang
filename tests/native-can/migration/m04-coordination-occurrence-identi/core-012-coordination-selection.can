        seed_owner_lost: context("bundled/coordination-selection", "seed-owner-lost", "", "offline") => failed{"owner-retention"}
        seed_native_bypass: context("bundled/coordination-selection", "seed-native-bypass", "", "offline") => failed{"native-delegation"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.all_first_index, 1, c, "all-first-rejection")
            failed
            ok evidence all_evidence => match call require_bool(got.settled_ordered, true, c, "settled-ordered")
                failed
                ok evidence settled_evidence => match call require_bool(got.settled_handler_stop, true, c, "settled-handler-stop")
                    failed
