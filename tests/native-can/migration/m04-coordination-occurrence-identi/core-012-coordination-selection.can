        seed_race_late: context("bundled/coordination-selection", "seed-race-late", "", "offline") => failed{"race-first"}
        seed_empty_any_drift: context("bundled/coordination-selection", "seed-empty-any-drift", "", "offline") => failed{"empty-modes"}
        seed_aggregate_short: context("bundled/coordination-selection", "seed-aggregate-short", "", "offline") => failed{"aggregate-identity"}
        seed_failure_late: context("bundled/coordination-selection", "seed-failure-late", "", "offline") => failed{"first-failure-handling"}
        seed_settled_standard_lost: context("bundled/coordination-selection", "seed-settled-standard-lost", "", "offline") => failed{"settled-standard-slot"}
        seed_any_early: context("bundled/coordination-selection", "seed-any-early", "", "offline") => failed{"any-last-success"}
