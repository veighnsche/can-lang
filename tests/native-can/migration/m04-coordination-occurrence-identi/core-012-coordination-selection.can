package m04core012coordination
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M04 CORE-012 "bundled coordination: selection, outcomes, delegation".
/// Source: tests/integration/coordination_test.go symbol
/// TestCurrentBundledCoordination (the staged bun leg L29-34) and
/// runtime/test/coordination.test.ts (every verbatim pin below comes from
/// its 15 test roots).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): Promise all/allSettled/any/race selection,
/// ordered outcomes, empty modes, domain/standard failures, owner
/// retention and native delegation, plus the late/losing-failure,
/// handler-fault, empty-race and snapshot-identity variants.
/// The 8-root assert pin lives in core-012-roots-green.can; the run
/// output/status shape and silent production entry live in
/// core-012-run-shape.can.
/// Variants: main fixture outcomes (main.can L110-117 silent guard);
/// late/losing failures, handler faults, empty race, snapshot identity.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-009 (runtime/test/coordination.test.ts,
/// read-only record; 15 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23/QN1/QN2/QN3 unmet).
/// Case bundled/coordination-selection checks: all-first-rejection,
/// settled-ordered, settled-handler-stop, any-allfailed-order,
/// any-consume-late, race-first, empty-modes, aggregate-identity,
/// first-failure-handling, settled-standard-slot, any-last-success,
/// handler-faults, snapshot-identity, empty-race-pending, owner-retention,
/// native-delegation.
/// Facet map (coordination.test.ts roots): all-first-rejection pins native
/// all selecting the first rejection (L66: index 1; L70: events [1]; L71:
/// late-first diagnostic "Error: late first"); settled-ordered pins
/// allSettled input-order handling (L89: events [0,1,2]; L91: ["A","B","C"]);
/// settled-handler-stop pins the handler-failure stop (L89: events [0,1];
/// L92: standard kind); any-allfailed-order pins any retaining original
/// all-failed outcomes in input order by identity (L103-105);
/// any-consume-late pins any consuming pre-success failures while keeping
/// the thenable payload unassimilated (L128: value 7) and retaining the
/// late diagnostic (L152: "Error: late"); race-first pins race selecting
/// the first completion (L165-170: winner at index 1, events [1]);
/// empty-modes pins empty all/settled succeeding with [] and empty any
/// selecting one empty aggregate (L189/L196: "fallback"; L197: aggregate
/// once for any, zero otherwise); aggregate-identity pins the typed
/// aggregate keeping nominal payloads and opaque standard identity (L309:
/// 4 values by identity; L315: frozen; L314: cause kept);
/// first-failure-handling pins all/race selecting the first domain or
/// standard failure (L367/L372: index 1, events [1]; L374: "handled";
/// L376: race late "Error: late C"); settled-standard-slot pins allSettled
/// propagating an unhandled standard slot in input order (L394: identity;
/// L395: events [0,1]); any-last-success pins any succeeding last after
/// domain and standard failures (L432-435: "C" at index 2, events [2],
/// zero aggregate calls); handler-faults pins handler failures escaping
/// without redispatch (L471: all ["each0"], any ["aggregate"]);
/// snapshot-identity pins map conversion preserving snapshot identity and
/// minting one outer aggregate occurrence (L494/L511: 3 leaves; L516-517:
/// occurrence id stable then fresh); empty-race-pending pins empty race
/// staying pending past the harness deadline (L531: 10ms; L533-534:
/// deadline observed, completed false); owner-retention pins the losing
/// participant's captured resource retained until late work finishes
/// (L547/L562: value 7; L581: ["late use","close"]; L582: closed);
/// native-delegation pins each mode delegating to its native Promise op
/// (L618: calls[0] is the mode; owner drain also uses allSettled).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int all_first_index
    bool settled_ordered
    bool settled_handler_stop
    bool any_allfailed_ordered
    str any_late_diagnostic
    int race_first_index
    str empty_any_value
    int aggregate_values
    int first_failure_index
    bool settled_standard_ordered
    int any_success_index
    bool handler_faults_escape
    int snapshot_leaves
    int empty_race_deadline_ms
    int owner_value
    bool native_delegated
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/coordination-selection", "default", "", "offline"), "all-first-rejection" => ok "case bundled/coordination-selection variant default root all-first-rejection run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/coordination-selection", "default", "", "offline"), "settled-ordered" => ok evidence("settled-ordered", "true", "true", true, "case bundled/coordination-selection variant default root settled-ordered run offline")
        different: false, true, context("bundled/coordination-selection", "default", "", "offline"), "settled-ordered" => failed{"settled-ordered"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("bundled/coordination-selection", "default", "", "offline"), "all-first-rejection" => ok evidence("all-first-rejection", "1", "1", true, "case bundled/coordination-selection variant default root all-first-rejection run offline")
        different: 0, 1, context("bundled/coordination-selection", "default", "", "offline"), "all-first-rejection" => failed{"all-first-rejection"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
