fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("coordination/snapshot-roots", "default", "", "offline") => ok
        seed_assert_red: context("coordination/snapshot-roots", "seed-assert-red", "", "offline") => failed{"assert-green"}
        seed_report_red: context("coordination/snapshot-roots", "seed-report-red", "", "offline") => failed{"report-passed"}
        seed_root_short: context("coordination/snapshot-roots", "seed-root-short", "", "offline") => failed{"root-count"}
        seed_fixture_drift: context("coordination/snapshot-roots", "seed-fixture-drift", "", "offline") => failed{"fixture-name"}
        seed_boom_loss: context("coordination/snapshot-roots", "seed-boom-loss", "", "offline") => failed{"boom-roots"}
        seed_identical_loss: context("coordination/snapshot-roots", "seed-identical-loss", "", "offline") => failed{"identical-roots"}
        seed_main_loss: context("coordination/snapshot-roots", "seed-main-loss", "", "offline") => failed{"main-roots"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.assert_green, true, c, "assert-green")
            failed
            ok evidence assert_evidence => match call require_bool(got.report_passed, true, c, "report-passed")
