fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, 1, "main.can", 1, 1, 1)
        seed_assert_red: "seed-assert-red" => ok observation(false, true, 1, "main.can", 1, 1, 1)
        seed_report_red: "seed-report-red" => ok observation(true, false, 1, "main.can", 1, 1, 1)
        seed_root_short: "seed-root-short" => ok observation(true, true, 0, "main.can", 1, 1, 1)
        seed_fixture_drift: "seed-fixture-drift" => ok observation(true, true, 1, "writes.can", 1, 1, 1)
        seed_boom_loss: "seed-boom-loss" => ok observation(true, true, 1, "main.can", 0, 1, 1)
        seed_identical_loss: "seed-identical-loss" => ok observation(true, true, 1, "main.can", 1, 0, 1)
        seed_main_loss: "seed-main-loss" => ok observation(true, true, 1, "main.can", 1, 1, 0)
    match variant_id
        "seed-assert-red" => ok observation(false, true, 1, "main.can", 1, 1, 1)
        "seed-report-red" => ok observation(true, false, 1, "main.can", 1, 1, 1)
        "seed-root-short" => ok observation(true, true, 0, "main.can", 1, 1, 1)
        "seed-fixture-drift" => ok observation(true, true, 1, "writes.can", 1, 1, 1)
        "seed-boom-loss" => ok observation(true, true, 1, "main.can", 0, 1, 1)
        "seed-identical-loss" => ok observation(true, true, 1, "main.can", 1, 0, 1)
        "seed-main-loss" => ok observation(true, true, 1, "main.can", 1, 1, 0)
        _ => ok observation(true, true, 1, "main.can", 1, 1, 1)
