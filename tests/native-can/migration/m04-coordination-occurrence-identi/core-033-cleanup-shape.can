package m04core033cleanup
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M04 CORE-033 "bundled ownership: reverse cleanup shape".
/// Source: tests/integration/owners_test.go symbol
/// TestBundledOwnershipOffline (L13-38) and runtime/test/owner.test.ts
/// (reverse cleanup, reentrant close, wrong-kind/forged rejection)
/// plus runtime/test/owner-roots.test.ts (omitted-close CLI status).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): reverse automatic cleanup order with omitted
/// and failed closes reported, reentrant idempotent close sharing one
/// native attempt, wrong-kind and forged handles failing without
/// touching native state, explicit and child-scope closes, callable
/// receipts without self-deadlock leases, host callback capture
/// preservation, and loser-opened lease retention.
/// The 23-root staged pin lives in core-033-roots-green.can; the scope/
/// lease/late-work semantics live in core-033-ownership-scopes.can.
/// Variants: omitted/automatic close; late loser retention; forged and
/// wrong-kind handles.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/CHILD/
/// NATIVE/FAULT and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-014 (owner-hung.test.ts, read-only),
/// DELEGATE-015 (owner-roots.test.ts, read-only), DELEGATE-016
/// (owner.test.ts, read-only; not executed here).
/// Execution credit: NOT claimed (accept_after P23/QN2/QN3 unmet).
/// Case bundled/ownership-cleanup checks: reverse-cleanup-order,
/// omitted-close-reported, failed-close-reported, cleanup-count,
/// reentrant-idempotent, wrong-kind-rejection, forged-no-touch,
/// explicit-close-ok, child-scope-release, callable-no-deadlock,
/// host-callback-preserved, loser-lease-retained.
/// Facet map (owner.test.ts roots): reverse-cleanup-order pins reverse
/// automatic cleanup (L160-182: events ["second","first"], first is
/// "second"); cleanup-count pins the omitted-close diagnostics (L181:
/// categories ["cleanup","cleanup"], count 2); failed-close-reported
/// pins native close faults (L366-384: cleanupFailed true, completion
/// standard, kind "cleanup"); reentrant-idempotent pins the shared
/// native attempt (L484-505: both closes ok, calls 1);
/// wrong-kind-rejection pins wrong-kind refusal (L325-364: refused
/// standard); forged-no-touch pins forged refusal without native
/// effects (L362: touched 0; L363: traps 0 recorded on the scopes
/// slice); explicit-close-ok pins participant explicit close (L460-482:
/// closed 1); child-scope-release pins managed child release (L430-458:
/// closes 1); callable-no-deadlock pins ordinary receipts (L544-557:
/// leases 0, closes 1); host-callback-preserved pins nested capture
/// evidence (L507-542: leases 1, closed true);
/// loser-lease-retained pins loser-opened retention (L386-428: state
/// "closing" leases 1, closed true after use). Omitted-close pin
/// (owner-roots.test.ts L51-71): omitted-close-reported pins status 1
/// with closed true and phase/category cleanup/cleanup.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str first_event
    int omitted_status
    str failure_kind
    int cleanup_count
    int reentrant_calls
    str refused_kind
    int native_touches
    int explicit_closes
    int child_closes
    int receipt_leases
    int host_leases
    str loser_state
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/ownership-cleanup", "default", "", "offline"), "reverse-cleanup-order" => ok "case bundled/ownership-cleanup variant default root reverse-cleanup-order run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/ownership-cleanup", "default", "", "offline"), "explicit-close-ok" => ok evidence("explicit-close-ok", "true", "true", true, "case bundled/ownership-cleanup variant default root explicit-close-ok run offline")
        different: false, true, context("bundled/ownership-cleanup", "default", "", "offline"), "explicit-close-ok" => failed{"explicit-close-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("bundled/ownership-cleanup", "default", "", "offline"), "omitted-close-reported" => ok evidence("omitted-close-reported", "1", "1", true, "case bundled/ownership-cleanup variant default root omitted-close-reported run offline")
        different: 0, 1, context("bundled/ownership-cleanup", "default", "", "offline"), "omitted-close-reported" => failed{"omitted-close-reported"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "second", "second", context("bundled/ownership-cleanup", "default", "", "offline"), "reverse-cleanup-order" => ok evidence("reverse-cleanup-order", "second", "second", true, "case bundled/ownership-cleanup variant default root reverse-cleanup-order run offline")
        different: "first", "second", context("bundled/ownership-cleanup", "default", "", "offline"), "reverse-cleanup-order" => failed{"reverse-cleanup-order"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
