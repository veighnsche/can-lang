        seed_omitted_green: "seed-omitted-green" => ok observation("second", 0, "cleanup", 2, 1, "standard", 0, 1, 1, 0, 1, "closing")
        seed_kind_drift: "seed-kind-drift" => ok observation("second", 1, "resource_state", 2, 1, "standard", 0, 1, 1, 0, 1, "closing")
        seed_cleanup_short: "seed-cleanup-short" => ok observation("second", 1, "cleanup", 1, 1, "standard", 0, 1, 1, 0, 1, "closing")
        seed_reentrant_twice: "seed-reentrant-twice" => ok observation("second", 1, "cleanup", 2, 2, "standard", 0, 1, 1, 0, 1, "closing")
        seed_kind_accepted: "seed-kind-accepted" => ok observation("second", 1, "cleanup", 2, 1, "ok", 0, 1, 1, 0, 1, "closing")
