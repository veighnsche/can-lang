    match variant_id
        "seed-order-forward" => ok observation("first", 1, "cleanup", 2, 1, "standard", 0, 1, 1, 0, 1, "closing")
        "seed-omitted-green" => ok observation("second", 0, "cleanup", 2, 1, "standard", 0, 1, 1, 0, 1, "closing")
        "seed-kind-drift" => ok observation("second", 1, "resource_state", 2, 1, "standard", 0, 1, 1, 0, 1, "closing")
        "seed-cleanup-short" => ok observation("second", 1, "cleanup", 1, 1, "standard", 0, 1, 1, 0, 1, "closing")
        "seed-reentrant-twice" => ok observation("second", 1, "cleanup", 2, 2, "standard", 0, 1, 1, 0, 1, "closing")
        "seed-kind-accepted" => ok observation("second", 1, "cleanup", 2, 1, "ok", 0, 1, 1, 0, 1, "closing")
        "seed-native-touched" => ok observation("second", 1, "cleanup", 2, 1, "standard", 1, 1, 1, 0, 1, "closing")
        "seed-explicit-lost" => ok observation("second", 1, "cleanup", 2, 1, "standard", 0, 0, 1, 0, 1, "closing")
        "seed-child-leaked" => ok observation("second", 1, "cleanup", 2, 1, "standard", 0, 1, 0, 0, 1, "closing")
        "seed-receipt-leased" => ok observation("second", 1, "cleanup", 2, 1, "standard", 0, 1, 1, 1, 1, "closing")
        "seed-host-lost" => ok observation("second", 1, "cleanup", 2, 1, "standard", 0, 1, 1, 0, 0, "closing")
        "seed-loser-drift" => ok observation("second", 1, "cleanup", 2, 1, "standard", 0, 1, 1, 0, 1, "closed")
        _ => ok observation("second", 1, "cleanup", 2, 1, "standard", 0, 1, 1, 0, 1, "closing")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m04_033: "m04-033" => ok [check("reverse-cleanup-order", "reverse automatic cleanup runs second then first"), check("omitted-close-reported", "omitted close reports nonzero status"), check("failed-close-reported", "failed native close propagates the cleanup kind"), check("cleanup-count", "reverse cleanup emits two cleanup diagnostics"), check("reentrant-idempotent", "reentrant close shares one native attempt"), check("wrong-kind-rejection", "wrong-kind resources reject as standard"), check("forged-no-touch", "forged handles fail without touching native state"), check("explicit-close-ok", "a participant can explicitly close its own resource"), check("child-scope-release", "participant child scope releases its lease at exit"), check("callable-no-deadlock", "ordinary callable receipts add zero close leases"), check("host-callback-preserved", "host callback wrappers preserve capture leases"), check("loser-lease-retained", "loser-opened resources retain the closing lease")]
        other: "nope" => ok []
    match scope is "m04-033"
        false => ok []
        true => ok [check("reverse-cleanup-order", "reverse automatic cleanup runs second then first"), check("omitted-close-reported", "omitted close reports nonzero status"), check("failed-close-reported", "failed native close propagates the cleanup kind"), check("cleanup-count", "reverse cleanup emits two cleanup diagnostics"), check("reentrant-idempotent", "reentrant close shares one native attempt"), check("wrong-kind-rejection", "wrong-kind resources reject as standard"), check("forged-no-touch", "forged handles fail without touching native state"), check("explicit-close-ok", "a participant can explicitly close its own resource"), check("child-scope-release", "participant child scope releases its lease at exit"), check("callable-no-deadlock", "ordinary callable receipts add zero close leases"), check("host-callback-preserved", "host callback wrappers preserve capture leases"), check("loser-lease-retained", "loser-opened resources retain the closing lease")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/ownership-cleanup" => ok [expected_check("reverse-cleanup-order", "second"), expected_check("omitted-close-reported", "1"), expected_check("failed-close-reported", "cleanup"), expected_check("cleanup-count", "2"), expected_check("reentrant-idempotent", "1"), expected_check("wrong-kind-rejection", "standard"), expected_check("forged-no-touch", "0"), expected_check("explicit-close-ok", "1"), expected_check("child-scope-release", "1"), expected_check("callable-no-deadlock", "0"), expected_check("host-callback-preserved", "1"), expected_check("loser-lease-retained", "closing")]
        unknown: "nope" => ok []
    match case is "bundled/ownership-cleanup"
        false => ok []
        true => ok [expected_check("reverse-cleanup-order", "second"), expected_check("omitted-close-reported", "1"), expected_check("failed-close-reported", "cleanup"), expected_check("cleanup-count", "2"), expected_check("reentrant-idempotent", "1"), expected_check("wrong-kind-rejection", "standard"), expected_check("forged-no-touch", "0"), expected_check("explicit-close-ok", "1"), expected_check("child-scope-release", "1"), expected_check("callable-no-deadlock", "0"), expected_check("host-callback-preserved", "1"), expected_check("loser-lease-retained", "closing")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/ownership-cleanup", "default", "", "offline") => ok
        seed_order_forward: context("bundled/ownership-cleanup", "seed-order-forward", "", "offline") => failed{"reverse-cleanup-order"}
        seed_omitted_green: context("bundled/ownership-cleanup", "seed-omitted-green", "", "offline") => failed{"omitted-close-reported"}
        seed_kind_drift: context("bundled/ownership-cleanup", "seed-kind-drift", "", "offline") => failed{"failed-close-reported"}
        seed_cleanup_short: context("bundled/ownership-cleanup", "seed-cleanup-short", "", "offline") => failed{"cleanup-count"}
        seed_reentrant_twice: context("bundled/ownership-cleanup", "seed-reentrant-twice", "", "offline") => failed{"reentrant-idempotent"}
        seed_kind_accepted: context("bundled/ownership-cleanup", "seed-kind-accepted", "", "offline") => failed{"wrong-kind-rejection"}
        seed_native_touched: context("bundled/ownership-cleanup", "seed-native-touched", "", "offline") => failed{"forged-no-touch"}
        seed_explicit_lost: context("bundled/ownership-cleanup", "seed-explicit-lost", "", "offline") => failed{"explicit-close-ok"}
        seed_child_leaked: context("bundled/ownership-cleanup", "seed-child-leaked", "", "offline") => failed{"child-scope-release"}
        seed_receipt_leased: context("bundled/ownership-cleanup", "seed-receipt-leased", "", "offline") => failed{"callable-no-deadlock"}
        seed_host_lost: context("bundled/ownership-cleanup", "seed-host-lost", "", "offline") => failed{"host-callback-preserved"}
        seed_loser_drift: context("bundled/ownership-cleanup", "seed-loser-drift", "", "offline") => failed{"loser-lease-retained"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.first_event, "second", c, "reverse-cleanup-order")
            failed
            ok evidence order_evidence => match call require_int(got.omitted_status, 1, c, "omitted-close-reported")
                failed
                ok evidence omitted_evidence => match call require_text(got.failure_kind, "cleanup", c, "failed-close-reported")
                    failed
                    ok evidence kind_evidence => match call require_int(got.cleanup_count, 2, c, "cleanup-count")
                        failed
                        ok evidence cleanup_evidence => match call require_int(got.reentrant_calls, 1, c, "reentrant-idempotent")
                            failed
                            ok evidence reentrant_evidence => match call require_text(got.refused_kind, "standard", c, "wrong-kind-rejection")
                                failed
                                ok evidence refused_evidence => match call require_int(got.native_touches, 0, c, "forged-no-touch")
                                    failed
                                    ok evidence touched_evidence => match call require_int(got.explicit_closes, 1, c, "explicit-close-ok")
                                        failed
                                        ok evidence explicit_evidence => match call require_int(got.child_closes, 1, c, "child-scope-release")
                                            failed
                                            ok evidence child_evidence => match call require_int(got.receipt_leases, 0, c, "callable-no-deadlock")
                                                failed
                                                ok evidence receipt_evidence => match call require_int(got.host_leases, 1, c, "host-callback-preserved")
                                                    failed
                                                    ok evidence host_evidence => match call require_text(got.loser_state, "closing", c, "loser-lease-retained")
                                                        failed
                                                        ok evidence loser_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m04_033: "m04-033" => ok test_case("bundled/ownership-cleanup", ["ownership", "m04"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("reverse-cleanup-order"), check_ref("omitted-close-reported"), check_ref("failed-close-reported"), check_ref("cleanup-count"), check_ref("reentrant-idempotent"), check_ref("wrong-kind-rejection"), check_ref("forged-no-touch"), check_ref("explicit-close-ok"), check_ref("child-scope-release"), check_ref("callable-no-deadlock"), check_ref("host-callback-preserved"), check_ref("loser-lease-retained")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m04-033"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/ownership-cleanup", ["ownership", "m04"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("reverse-cleanup-order"), check_ref("omitted-close-reported"), check_ref("failed-close-reported"), check_ref("cleanup-count"), check_ref("reentrant-idempotent"), check_ref("wrong-kind-rejection"), check_ref("forged-no-touch"), check_ref("explicit-close-ok"), check_ref("child-scope-release"), check_ref("callable-no-deadlock"), check_ref("host-callback-preserved"), check_ref("loser-lease-retained")], callable case_body)
