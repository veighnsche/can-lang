package m05core017amounts
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-017 "bundled exact amounts: divmod, rounding, large units".
/// Source: tests/integration/exact_amount_test.go symbol
/// TestCurrentBundledExactAmounts (the staged bun leg L29-34) and
/// runtime/test/exact-amount.test.ts (every verbatim pin below comes from
/// its 5 test roots) plus std/ratio/current/src/main.can asserts.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): signed truncating divmod, Euclidean range,
/// half-even rounding vectors and conservation, large rational and minor
/// units, huge integers, unreduced remainders, zero-denominator domain
/// errors, plus the both-signs/parity-tie/huge-integer variants.
/// The 23-root assert pin lives in core-017-roots-green.can; the run
/// output/status shape and silent production entry live in
/// core-017-run-shape.can.
/// Variants: both signs (6 negative-operand vectors), parity ties (8 even
/// ties), huge integers (10^500 + 7 over 3 denominators), zero denominators
/// (3 operations raising the domain error).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-011 (runtime/test/exact-amount.test.ts,
/// read-only record; 5 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/exact-amounts checks: signed-divmod, euclidean-range,
/// half-even-rounding, half-even-conservation, large-rational, minor-units,
/// huge-integer, huge-denominators, unreduced-remainder, zero-denominator,
/// domain-error-name, both-signs, parity-tie, exact-share-text.
/// Facet map (exact-amount.test.ts roots + main.can asserts):
/// signed-divmod pins the truncating identity (test L42-55: sweep
/// -33..33/-9..9, quotient n/d, remainder n%; main.can L13: 7,3 =>
/// division(2,1)); euclidean-range pins the Euclidean identity and range
/// (test L50-51: n = q*d + r, 0 <= r < |d|; main.can L27: -7,3 =>
/// division(-3,2)); half-even-rounding pins the 10 rounding vectors (test
/// L58-69); half-even-conservation pins exact conservation with minimal
/// distance and even ties (test L77-91: sweep -75..75/-11..11, cross
/// multiplication, 2|r| == d => value even); large-rational pins the large
/// share (test L96-101: 4503599627370498/-1/2; main.can L66);
/// minor-units pins the large deposit total (test L94-95: 9007199254740993
/// + 2 = 9007199254740995; main.can L59); huge-integer pins the 500-digit
/// operand (test L102: 10^500 + 7); huge-denominators pins its 3
/// denominators (test L103: 3, -3, 10^250 + 1); unreduced-remainder pins
/// the unreduced 2/4 case (test L109-113: 0/2/4; main.can L48);
/// zero-denominator pins the 3 fallible operations (test L117: divmod,
/// euclideanDivmod, roundRatioHalfEven); domain-error-name pins the raised
/// declaration (test L122: "number::zero_divisor"); both-signs pins the 6
/// negative-operand vectors (test L58-69 rows [-5,2],[-7,2],[5,-2],
/// [-5,-2],[-1,2],[0,-3]); parity-tie pins the 8 even ties (test L58-69 +
/// L89: every 2|r| == d row rounds to an even value); exact-share-text pins
/// the encoded share JSON verbatim (main.can L66/L97).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int trunc_quotient
    int euclid_remainder
    int half_even_vectors
    bool conserved
    int share_value
    int minor_total
    int huge_exponent
    int huge_denominators
    int unreduced_remainder
    int zero_denominator_ops
    str error_name
    int negative_vectors
    int even_ties
    str share_json
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/exact-amounts", "default", "", "offline"), "signed-divmod" => ok "case bundled/exact-amounts variant default root signed-divmod run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/exact-amounts", "default", "", "offline"), "half-even-conservation" => ok evidence("half-even-conservation", "true", "true", true, "case bundled/exact-amounts variant default root half-even-conservation run offline")
        different: false, true, context("bundled/exact-amounts", "default", "", "offline"), "half-even-conservation" => failed{"half-even-conservation"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("bundled/exact-amounts", "default", "", "offline"), "half-even-rounding" => ok evidence("half-even-rounding", "10", "10", true, "case bundled/exact-amounts variant default root half-even-rounding run offline")
        different: 9, 10, context("bundled/exact-amounts", "default", "", "offline"), "half-even-rounding" => failed{"half-even-rounding"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "number::zero_divisor", "number::zero_divisor", context("bundled/exact-amounts", "default", "", "offline"), "domain-error-name" => ok evidence("domain-error-name", "number::zero_divisor", "number::zero_divisor", true, "case bundled/exact-amounts variant default root domain-error-name run offline")
        different: "codec::invalid_data", "number::zero_divisor", context("bundled/exact-amounts", "default", "", "offline"), "domain-error-name" => failed{"domain-error-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
