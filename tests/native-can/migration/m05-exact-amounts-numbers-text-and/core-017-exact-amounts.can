        seed_trunc_drift: "seed-trunc-drift" => ok observation(1, 2, 10, true, 4503599627370498, 9007199254740995, 500, 3, 2, 3, "number::zero_divisor", 6, 8, "{\"value\":4503599627370498,\"remainder_numerator\":-1,\"denominator\":2}")
