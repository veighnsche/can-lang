fn check[] checks
    emits {}
    given
        str scope
    asserts
        m05_017: "m05-017" => ok [check("signed-divmod", "truncating divmod matches the native signed identity (7/3 => 2)"), check("euclidean-range", "euclidean divmod keeps the identity with a non-negative range (-7/3 => r 2)"), check("half-even-rounding", "half-even rounding pins 10 vectors"), check("half-even-conservation", "rounded results conserve the exact rational with minimal distance and even ties"), check("large-rational", "large share pins value 4503599627370498"), check("minor-units", "large deposit pins total 9007199254740995"), check("huge-integer", "huge operand pins exponent 500"), check("huge-denominators", "huge operand pins 3 denominators"), check("unreduced-remainder", "unreduced 2/4 pins remainder 2"), check("zero-denominator", "3 operations raise on zero denominators"), check("domain-error-name", "zero denominators raise number::zero_divisor"), check("both-signs", "rounding vectors pin 6 negative-operand rows"), check("parity-tie", "rounding vectors pin 8 even ties"), check("exact-share-text", "encoded share pins the exact JSON text")]
        other: "nope" => ok []
    match scope is "m05-017"
        false => ok []
        true => ok [check("signed-divmod", "truncating divmod matches the native signed identity (7/3 => 2)"), check("euclidean-range", "euclidean divmod keeps the identity with a non-negative range (-7/3 => r 2)"), check("half-even-rounding", "half-even rounding pins 10 vectors"), check("half-even-conservation", "rounded results conserve the exact rational with minimal distance and even ties"), check("large-rational", "large share pins value 4503599627370498"), check("minor-units", "large deposit pins total 9007199254740995"), check("huge-integer", "huge operand pins exponent 500"), check("huge-denominators", "huge operand pins 3 denominators"), check("unreduced-remainder", "unreduced 2/4 pins remainder 2"), check("zero-denominator", "3 operations raise on zero denominators"), check("domain-error-name", "zero denominators raise number::zero_divisor"), check("both-signs", "rounding vectors pin 6 negative-operand rows"), check("parity-tie", "rounding vectors pin 8 even ties"), check("exact-share-text", "encoded share pins the exact JSON text")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/exact-amounts" => ok [expected_check("signed-divmod", "2"), expected_check("euclidean-range", "2"), expected_check("half-even-rounding", "10"), expected_check("half-even-conservation", "true"), expected_check("large-rational", "4503599627370498"), expected_check("minor-units", "9007199254740995"), expected_check("huge-integer", "500"), expected_check("huge-denominators", "3"), expected_check("unreduced-remainder", "2"), expected_check("zero-denominator", "3"), expected_check("domain-error-name", "number::zero_divisor"), expected_check("both-signs", "6"), expected_check("parity-tie", "8"), expected_check("exact-share-text", "{\"value\":4503599627370498,\"remainder_numerator\":-1,\"denominator\":2}")]
        unknown: "nope" => ok []
    match case is "bundled/exact-amounts"
        false => ok []
        true => ok [expected_check("signed-divmod", "2"), expected_check("euclidean-range", "2"), expected_check("half-even-rounding", "10"), expected_check("half-even-conservation", "true"), expected_check("large-rational", "4503599627370498"), expected_check("minor-units", "9007199254740995"), expected_check("huge-integer", "500"), expected_check("huge-denominators", "3"), expected_check("unreduced-remainder", "2"), expected_check("zero-denominator", "3"), expected_check("domain-error-name", "number::zero_divisor"), expected_check("both-signs", "6"), expected_check("parity-tie", "8"), expected_check("exact-share-text", "{\"value\":4503599627370498,\"remainder_numerator\":-1,\"denominator\":2}")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/exact-amounts", "default", "", "offline") => ok
        seed_trunc_drift: context("bundled/exact-amounts", "seed-trunc-drift", "", "offline") => failed{"signed-divmod"}
        seed_euclid_drift: context("bundled/exact-amounts", "seed-euclid-drift", "", "offline") => failed{"euclidean-range"}
        seed_vectors_short: context("bundled/exact-amounts", "seed-vectors-short", "", "offline") => failed{"half-even-rounding"}
        seed_conservation_lost: context("bundled/exact-amounts", "seed-conservation-lost", "", "offline") => failed{"half-even-conservation"}
        seed_share_short: context("bundled/exact-amounts", "seed-share-short", "", "offline") => failed{"large-rational"}
        seed_minor_short: context("bundled/exact-amounts", "seed-minor-short", "", "offline") => failed{"minor-units"}
        seed_huge_short: context("bundled/exact-amounts", "seed-huge-short", "", "offline") => failed{"huge-integer"}
        seed_denominators_short: context("bundled/exact-amounts", "seed-denominators-short", "", "offline") => failed{"huge-denominators"}
        seed_unreduced_drift: context("bundled/exact-amounts", "seed-unreduced-drift", "", "offline") => failed{"unreduced-remainder"}
        seed_ops_short: context("bundled/exact-amounts", "seed-ops-short", "", "offline") => failed{"zero-denominator"}
        seed_error_drift: context("bundled/exact-amounts", "seed-error-drift", "", "offline") => failed{"domain-error-name"}
        seed_signs_short: context("bundled/exact-amounts", "seed-signs-short", "", "offline") => failed{"both-signs"}
        seed_ties_short: context("bundled/exact-amounts", "seed-ties-short", "", "offline") => failed{"parity-tie"}
        seed_share_text_drift: context("bundled/exact-amounts", "seed-share-text-drift", "", "offline") => failed{"exact-share-text"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.trunc_quotient, 2, c, "signed-divmod")
            failed
            ok evidence trunc_evidence => match call require_int(got.euclid_remainder, 2, c, "euclidean-range")
                failed
                ok evidence euclid_evidence => match call require_int(got.half_even_vectors, 10, c, "half-even-rounding")
                    failed
                    ok evidence vectors_evidence => match call require_bool(got.conserved, true, c, "half-even-conservation")
                        failed
                        ok evidence conservation_evidence => match call require_int(got.share_value, 4503599627370498, c, "large-rational")
                            failed
                            ok evidence share_evidence => match call require_int(got.minor_total, 9007199254740995, c, "minor-units")
                                failed
                                ok evidence minor_evidence => match call require_int(got.huge_exponent, 500, c, "huge-integer")
                                    failed
                                    ok evidence huge_evidence => match call require_int(got.huge_denominators, 3, c, "huge-denominators")
                                        failed
                                        ok evidence denominators_evidence => match call require_int(got.unreduced_remainder, 2, c, "unreduced-remainder")
                                            failed
                                            ok evidence unreduced_evidence => match call require_int(got.zero_denominator_ops, 3, c, "zero-denominator")
                                                failed
                                                ok evidence ops_evidence => match call require_text(got.error_name, "number::zero_divisor", c, "domain-error-name")
                                                    failed
                                                    ok evidence error_evidence => match call require_int(got.negative_vectors, 6, c, "both-signs")
                                                        failed
                                                        ok evidence signs_evidence => match call require_int(got.even_ties, 8, c, "parity-tie")
                                                            failed
                                                            ok evidence ties_evidence => match call require_text(got.share_json, "{\"value\":4503599627370498,\"remainder_numerator\":-1,\"denominator\":2}", c, "exact-share-text")
                                                                failed
                                                                ok evidence share_text_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m05_017: "m05-017" => ok test_case("bundled/exact-amounts", ["exact-amounts", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("signed-divmod"), check_ref("euclidean-range"), check_ref("half-even-rounding"), check_ref("half-even-conservation"), check_ref("large-rational"), check_ref("minor-units"), check_ref("huge-integer"), check_ref("huge-denominators"), check_ref("unreduced-remainder"), check_ref("zero-denominator"), check_ref("domain-error-name"), check_ref("both-signs"), check_ref("parity-tie"), check_ref("exact-share-text")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m05-017"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/exact-amounts", ["exact-amounts", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("signed-divmod"), check_ref("euclidean-range"), check_ref("half-even-rounding"), check_ref("half-even-conservation"), check_ref("large-rational"), check_ref("minor-units"), check_ref("huge-integer"), check_ref("huge-denominators"), check_ref("unreduced-remainder"), check_ref("zero-denominator"), check_ref("domain-error-name"), check_ref("both-signs"), check_ref("parity-tie"), check_ref("exact-share-text")], callable case_body)
