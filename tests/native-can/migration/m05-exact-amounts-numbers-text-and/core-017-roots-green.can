package m05core017roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-017 "bundled exact amounts: roots green".
/// Source: tests/integration/exact_amount_test.go symbol
/// TestCurrentBundledExactAmounts.
/// Related fixtures: std/ratio/current/src/main.can
/// (ground for every per-function pin below: truncating 5, euclidean 5,
/// rounded 9, deposit 1, encoded_share 1, reference 1, main 1 = 23 roots)
/// and runtime/test/exact-amount.test.ts (the staged bun trace pinned by
/// trace-pass/trace-fail).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): canlc assert green with passed report and exactly
/// 23 roots grounded per function in main.can, plus the staged bun trace
/// counts.
/// Exact-amount semantics live in core-017-exact-amounts.can; the run
/// output/status shape and silent production entry live in
/// core-017-run-shape.can.
/// Variants: main fixture (the Go loop table pins main at 23 rows; the only
/// row).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-011 (runtime/test/exact-amount.test.ts,
/// read-only record; 5 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/exact-amounts-roots checks: assert-green, report-passed,
/// root-count, fixture-name, truncating-roots, euclidean-roots,
/// rounded-roots, deposit-roots, encoded-share-roots, reference-roots,
/// main-roots, trace-pass, trace-fail.
/// Facet map (exact_amount_test.go legs): assert-green pins the assert leg
/// (L80-83: exit 0, empty stderr); report-passed/root-count pin the report
/// leg (L84-87: passed true, 23 assertions for main); fixture-name grounds
/// the 23 roots in main.can (L75-79); truncating-roots pins truncating
/// (main.can L12-17: positive, negative, divisor_negative, both_negative,
/// zero); euclidean-roots pins euclidean (L26-31: negative, both_negative,
/// positive, exact, zero); rounded-roots pins rounded (L40-49: even, odd,
/// negative_even, negative_odd, non_tie, denominator_negative,
/// both_negative, unreduced, zero); deposit-roots pins deposit (L59: large
/// => ok account(9007199254740995, EUR)); encoded-share-roots pins
/// encoded_share (L66: large => ok share JSON); reference-roots pins
/// reference (L77: sample => ok division(-3, 2)); main-roots pins main
/// (L87: empty [] => ok); trace-pass/trace-fail pin the staged bun trace
/// (L32: "5 pass", "0 fail").
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    str fixture_name
    int truncating_roots
    int euclidean_roots
    int rounded_roots
    int deposit_roots
    int encoded_share_roots
    int reference_roots
    int main_roots
    int trace_pass
    int trace_fail
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/exact-amounts-roots", "default", "", "offline"), "assert-green" => ok "case bundled/exact-amounts-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/exact-amounts-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case bundled/exact-amounts-roots variant default root assert-green run offline")
        different: false, true, context("bundled/exact-amounts-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
