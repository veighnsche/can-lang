package m05core017run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-017 "bundled exact amounts: run shape, silent production".
/// Source: tests/integration/exact_amount_test.go symbol
/// TestCurrentBundledExactAmounts.
/// Related fixtures: std/ratio/current/src/main.can main entry (L82-100:
/// deposit + encoded_share verification with the silent combined guard
/// L96-100) executed through the exact_amount_test.go run helper (L51-69:
/// /usr/bin/sandbox-exec with the deny-network profile, PATH=/nonexistent,
/// fresh temp HOME).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production execution preserves exact-amount
/// outcomes through a silent run (exit 0, empty stdout, empty stderr)
/// under the offline deny-network sandbox profile, plus the conditional
/// strict-tsc leg.
/// The 23-root assert pin lives in core-017-roots-green.can; the divmod and
/// rounding semantics live in core-017-exact-amounts.can.
/// Variants: main fixture (single loop row).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none beyond DELEGATE-011 (recorded on the
/// roots/amounts slices; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/exact-amounts-run checks: run-exit, run-stdout-empty,
/// run-stderr-empty, entry-silent, sandbox-profile, offline-ok,
/// tsc-conditional.
/// Facet map (exact_amount_test.go legs): run-exit/run-stdout-empty/
/// run-stderr-empty pin the run leg (L88-91: exit 0, empty stdout, empty
/// stderr); entry-silent pins the combined silent-production facet
/// (L88-91 with main.can L96-100: main verifies the exact share without
/// emitting output); sandbox-profile pins the offline run shape (L29/L52:
/// "(version 1)(allow default)(deny network*)" verbatim); offline-ok pins
/// the offline behavior (L29-31/L51-69: the sandboxed deny-network run with
/// PATH=/nonexistent succeeds); tsc-conditional pins the optional strict
/// tsc leg (L92-111: strict tsc over emitted dist TypeScript runs only when
/// CAN_TSC is set with CAN_BUN).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stdout_empty
    bool run_stderr_empty
    bool entry_silent
    str sandbox_profile
    bool offline_ok
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/exact-amounts-run", "default", "", "offline"), "run-exit" => ok "case bundled/exact-amounts-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/exact-amounts-run", "default", "", "offline"), "run-stdout-empty" => ok evidence("run-stdout-empty", "true", "true", true, "case bundled/exact-amounts-run variant default root run-stdout-empty run offline")
        different: false, true, context("bundled/exact-amounts-run", "default", "", "offline"), "run-stdout-empty" => failed{"run-stdout-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("bundled/exact-amounts-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case bundled/exact-amounts-run variant default root run-exit run offline")
        different: 1, 0, context("bundled/exact-amounts-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("bundled/exact-amounts-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case bundled/exact-amounts-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("bundled/exact-amounts-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, true, true, true, "(version 1)(allow default)(deny network*)", true, true)
        seed_run_red: "seed-run-red" => ok observation(1, true, true, true, "(version 1)(allow default)(deny network*)", true, true)
        seed_stdout_noisy: "seed-stdout-noisy" => ok observation(0, false, true, true, "(version 1)(allow default)(deny network*)", true, true)
        seed_stderr_noisy: "seed-stderr-noisy" => ok observation(0, true, false, true, "(version 1)(allow default)(deny network*)", true, true)
        seed_entry_noisy: "seed-entry-noisy" => ok observation(0, true, true, false, "(version 1)(allow default)(deny network*)", true, true)
        seed_profile_drift: "seed-profile-drift" => ok observation(0, true, true, true, "(version 1)(allow default)", true, true)
        seed_offline_fail: "seed-offline-fail" => ok observation(0, true, true, true, "(version 1)(allow default)(deny network*)", false, true)
        seed_tsc_unconditional: "seed-tsc-unconditional" => ok observation(0, true, true, true, "(version 1)(allow default)(deny network*)", true, false)
    match variant_id
        "seed-run-red" => ok observation(1, true, true, true, "(version 1)(allow default)(deny network*)", true, true)
        "seed-stdout-noisy" => ok observation(0, false, true, true, "(version 1)(allow default)(deny network*)", true, true)
        "seed-stderr-noisy" => ok observation(0, true, false, true, "(version 1)(allow default)(deny network*)", true, true)
        "seed-entry-noisy" => ok observation(0, true, true, false, "(version 1)(allow default)(deny network*)", true, true)
        "seed-profile-drift" => ok observation(0, true, true, true, "(version 1)(allow default)", true, true)
        "seed-offline-fail" => ok observation(0, true, true, true, "(version 1)(allow default)(deny network*)", false, true)
        "seed-tsc-unconditional" => ok observation(0, true, true, true, "(version 1)(allow default)(deny network*)", true, false)
        _ => ok observation(0, true, true, true, "(version 1)(allow default)(deny network*)", true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m05_017: "m05-017" => ok [check("run-exit", "production run exits 0"), check("run-stdout-empty", "production run keeps stdout empty"), check("run-stderr-empty", "production run keeps stderr empty"), check("entry-silent", "production entry is silent with exit 0"), check("sandbox-profile", "run helper pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed run succeeds"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
        other: "nope" => ok []
    match scope is "m05-017"
        false => ok []
        true => ok [check("run-exit", "production run exits 0"), check("run-stdout-empty", "production run keeps stdout empty"), check("run-stderr-empty", "production run keeps stderr empty"), check("entry-silent", "production entry is silent with exit 0"), check("sandbox-profile", "run helper pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed run succeeds"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/exact-amounts-run" => ok [expected_check("run-exit", "0"), expected_check("run-stdout-empty", "true"), expected_check("run-stderr-empty", "true"), expected_check("entry-silent", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("tsc-conditional", "true")]
        unknown: "nope" => ok []
    match case is "bundled/exact-amounts-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stdout-empty", "true"), expected_check("run-stderr-empty", "true"), expected_check("entry-silent", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("tsc-conditional", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/exact-amounts-run", "default", "", "offline") => ok
        seed_run_red: context("bundled/exact-amounts-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stdout_noisy: context("bundled/exact-amounts-run", "seed-stdout-noisy", "", "offline") => failed{"run-stdout-empty"}
        seed_stderr_noisy: context("bundled/exact-amounts-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_entry_noisy: context("bundled/exact-amounts-run", "seed-entry-noisy", "", "offline") => failed{"entry-silent"}
        seed_profile_drift: context("bundled/exact-amounts-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_fail: context("bundled/exact-amounts-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
        seed_tsc_unconditional: context("bundled/exact-amounts-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stdout_empty, true, c, "run-stdout-empty")
                failed
                ok evidence stdout_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                    failed
                    ok evidence stderr_evidence => match call require_bool(got.entry_silent, true, c, "entry-silent")
                        failed
                        ok evidence silent_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                            failed
                            ok evidence profile_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                                failed
                                ok evidence offline_evidence => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                    failed
                                    ok evidence tsc_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m05_017: "m05-017" => ok test_case("bundled/exact-amounts-run", ["exact-amounts", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stdout-empty"), check_ref("run-stderr-empty"), check_ref("entry-silent"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("tsc-conditional")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m05-017"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/exact-amounts-run", ["exact-amounts", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stdout-empty"), check_ref("run-stderr-empty"), check_ref("entry-silent"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("tsc-conditional")], callable case_body)
