package m05core032numbers
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-032 "bundled numbers: formatting, conversion, parsing, predicates".
/// Source: tests/integration/numbers_test.go symbol
/// TestCurrentBundledNumbers (the staged bun leg L29-33) and
/// runtime/test/number.test.ts (every verbatim pin below comes from its 6
/// test roots) with std/scalars/current/src/main.can grounding the Can
/// assertion side.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): native number formatting, exact conversion,
/// integer/float/bool parsing grammars, Math/Number predicates, plus the
/// bigint, NaN/infinity, exact-value and invalid-parse variants.
/// The 40-root assert pin lives in core-032-roots-green.can; the run
/// output/status shape and silent production entry live in
/// core-032-run-shape.can.
/// Variants: bigint digits beyond 2^53, NaN/infinity spellings and
/// behavior, exact represented values (2^53, 2^80, MAX_VALUE), and invalid
/// parses rejected with the input payload.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-013 (runtime/test/number.test.ts,
/// read-only record; 6 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/numbers-semantics checks: bigint, ieee-boundary,
/// grammar-boundary, formatting, conversion, parsing, predicate,
/// nan-variant, infinity-variant, exact-value-variant,
/// invalid-parse-variant, bool-spelling, bool-range, float-grammar,
/// int-grammar, no-locale.
/// Facet map (number.test.ts roots + main.can): bigint pins exact bigint
/// digits (L67: 0n, -1n, 9007199254740993n, 10n**400n => String;
/// main.can L9: large; L154: referenced sample; L170: main guard);
/// ieee-boundary pins 9 float spellings (L69-79: NaN, Infinity, -Infinity,
/// -0, 0, MIN_VALUE, MAX_VALUE, 0.1, 1e21; main.can L16-19);
/// grammar-boundary pins the leading-zero rejection shared by both
/// grammars (L137/L180: "01" invalid; main.can L134);
/// formatting pins negative zero (L81: fromFloat(-0) => "0"; main.can L16);
/// conversion pins the inexact reason (L88-91: 9007199254740993n and
/// 10n**400n => "not exactly representable as float"; main.can L35);
/// parsing pins the 6 valid integer spellings (L127: 0, -0, 1, -1,
/// 9007199254740993, 9x400; main.can L120-122); predicate pins 15
/// boundary inputs across floor/ceil/trunc/round/isFinite/isNaN (L99-123
/// incl round(-0.5) => -0; main.can L74-113); nan-variant pins NaN (L70:
/// "NaN" spelling; L94: floatToInt inexact; L121: isNaN; main.can L17,
/// L112); infinity-variant pins Infinity (L71-72: spellings; L120: not
/// finite; main.can L18-19, L75, L105); exact-value-variant pins 2^53
/// exact both directions (L86: 0n/-1n/2^53/2^80/-(2^100); L92: 0/-0/1/-1/
/// 2^80/MAX_VALUE; main.can L34, L44); invalid-parse-variant pins " 1"
/// rejected (L132/L175 invalid lists with {input} payload; main.can L121);
/// bool-spelling pins exact "true" (L207: toBool; L211: "True" invalid;
/// main.can L144-145); bool-range pins 3 int-to-bool rejections (L209-210:
/// -1n, 2n, 2^100n => invalid_bool{value}; main.can L63-65);
/// float-grammar pins accepted "01.0" (L155-171 valid incl 00e1/1e3/1E+3/
/// -1e-999/1.25e-2/5e-324; L172-197 invalid incl 1e309 overflow; main.can
/// L131-135); int-grammar pins 19 rejected integer spellings (L129-151;
/// main.can L120-122); no-locale pins plain String spellings without
/// locale grouping (L68/L80 incl 1e21 => "1e+21"; main.can L9-10).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str bigint_digits
    int ieee_cases
    str grammar_reject
    str negative_zero
    str inexact_reason
    int valid_int_parses
    int predicate_inputs
    str nan_spelling
    str infinity_spelling
    str exact_value
    str invalid_input
    str bool_true
    int bool_rejects
    str float_accept
    int invalid_int_count
    bool locale_free
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/numbers-semantics", "default", "", "offline"), "bigint" => ok "case bundled/numbers-semantics variant default root bigint run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/numbers-semantics", "default", "", "offline"), "no-locale" => ok evidence("no-locale", "true", "true", true, "case bundled/numbers-semantics variant default root no-locale run offline")
        different: false, true, context("bundled/numbers-semantics", "default", "", "offline"), "no-locale" => failed{"no-locale"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 9, 9, context("bundled/numbers-semantics", "default", "", "offline"), "ieee-boundary" => ok evidence("ieee-boundary", "9", "9", true, "case bundled/numbers-semantics variant default root ieee-boundary run offline")
        different: 8, 9, context("bundled/numbers-semantics", "default", "", "offline"), "ieee-boundary" => failed{"ieee-boundary"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "9007199254740993", "9007199254740993", context("bundled/numbers-semantics", "default", "", "offline"), "bigint" => ok evidence("bigint", "9007199254740993", "9007199254740993", true, "case bundled/numbers-semantics variant default root bigint run offline")
        different: "900719925474099", "9007199254740993", context("bundled/numbers-semantics", "default", "", "offline"), "bigint" => failed{"bigint"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
