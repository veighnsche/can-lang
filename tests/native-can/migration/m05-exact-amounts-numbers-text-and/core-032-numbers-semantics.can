fn check[] checks
    emits {}
    given
        str scope
    asserts
        m05_032: "m05-032" => ok [check("bigint", "native formatting preserves bigint digits exactly"), check("ieee-boundary", "IEEE spellings cover 9 float boundary inputs"), check("grammar-boundary", "integer grammar rejects leading-zero 01"), check("formatting", "negative zero formats as 0"), check("conversion", "inexact conversion reports not exactly representable"), check("parsing", "integer parsing accepts 6 exact decimal spellings"), check("predicate", "predicates agree on 15 boundary inputs"), check("nan-variant", "NaN spells NaN and fails integer conversion"), check("infinity-variant", "infinity spells Infinity and is not finite"), check("exact-value-variant", "2^53 is exactly representable both directions"), check("invalid-parse-variant", "leading-space 1 is rejected as invalid"), check("bool-spelling", "bool parsing accepts exact true spelling"), check("bool-range", "int-to-bool rejects 3 out-of-range values"), check("float-grammar", "float grammar admits leading-zero 01.0"), check("int-grammar", "integer grammar rejects 19 invalid spellings"), check("no-locale", "formatting uses plain String spellings without locale")]
        other: "nope" => ok []
    match scope is "m05-032"
        false => ok []
        true => ok [check("bigint", "native formatting preserves bigint digits exactly"), check("ieee-boundary", "IEEE spellings cover 9 float boundary inputs"), check("grammar-boundary", "integer grammar rejects leading-zero 01"), check("formatting", "negative zero formats as 0"), check("conversion", "inexact conversion reports not exactly representable"), check("parsing", "integer parsing accepts 6 exact decimal spellings"), check("predicate", "predicates agree on 15 boundary inputs"), check("nan-variant", "NaN spells NaN and fails integer conversion"), check("infinity-variant", "infinity spells Infinity and is not finite"), check("exact-value-variant", "2^53 is exactly representable both directions"), check("invalid-parse-variant", "leading-space 1 is rejected as invalid"), check("bool-spelling", "bool parsing accepts exact true spelling"), check("bool-range", "int-to-bool rejects 3 out-of-range values"), check("float-grammar", "float grammar admits leading-zero 01.0"), check("int-grammar", "integer grammar rejects 19 invalid spellings"), check("no-locale", "formatting uses plain String spellings without locale")]
