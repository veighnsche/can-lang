        seed_nan_drift: "seed-nan-drift" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 6, 15, "nan", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_infinity_drift: "seed-infinity-drift" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 6, 15, "NaN", "inf", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_exact_drift: "seed-exact-drift" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740993", " 1", "true", 3, "01.0", 19, true)
        seed_invalid_drift: "seed-invalid-drift" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", "1", "true", 3, "01.0", 19, true)
        seed_bool_drift: "seed-bool-drift" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "True", 3, "01.0", 19, true)
        seed_range_short: "seed-range-short" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 2, "01.0", 19, true)
