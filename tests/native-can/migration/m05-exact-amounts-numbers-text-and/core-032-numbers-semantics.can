    asserts
        known: "bundled/numbers-semantics" => ok [expected_check("bigint", "9007199254740993"), expected_check("ieee-boundary", "9"), expected_check("grammar-boundary", "01"), expected_check("formatting", "0"), expected_check("conversion", "not exactly representable as float"), expected_check("parsing", "6"), expected_check("predicate", "15"), expected_check("nan-variant", "NaN"), expected_check("infinity-variant", "Infinity"), expected_check("exact-value-variant", "9007199254740992"), expected_check("invalid-parse-variant", " 1"), expected_check("bool-spelling", "true"), expected_check("bool-range", "3"), expected_check("float-grammar", "01.0"), expected_check("int-grammar", "19"), expected_check("no-locale", "true")]
        unknown: "nope" => ok []
    match case is "bundled/numbers-semantics"
        false => ok []
        true => ok [expected_check("bigint", "9007199254740993"), expected_check("ieee-boundary", "9"), expected_check("grammar-boundary", "01"), expected_check("formatting", "0"), expected_check("conversion", "not exactly representable as float"), expected_check("parsing", "6"), expected_check("predicate", "15"), expected_check("nan-variant", "NaN"), expected_check("infinity-variant", "Infinity"), expected_check("exact-value-variant", "9007199254740992"), expected_check("invalid-parse-variant", " 1"), expected_check("bool-spelling", "true"), expected_check("bool-range", "3"), expected_check("float-grammar", "01.0"), expected_check("int-grammar", "19"), expected_check("no-locale", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/numbers-semantics", "default", "", "offline") => ok
        seed_bigint_short: context("bundled/numbers-semantics", "seed-bigint-short", "", "offline") => failed{"bigint"}
        seed_ieee_short: context("bundled/numbers-semantics", "seed-ieee-short", "", "offline") => failed{"ieee-boundary"}
        seed_grammar_drift: context("bundled/numbers-semantics", "seed-grammar-drift", "", "offline") => failed{"grammar-boundary"}
        seed_negzero_drift: context("bundled/numbers-semantics", "seed-negzero-drift", "", "offline") => failed{"formatting"}
        seed_conversion_drift: context("bundled/numbers-semantics", "seed-conversion-drift", "", "offline") => failed{"conversion"}
        seed_parsing_short: context("bundled/numbers-semantics", "seed-parsing-short", "", "offline") => failed{"parsing"}
        seed_predicate_short: context("bundled/numbers-semantics", "seed-predicate-short", "", "offline") => failed{"predicate"}
        seed_nan_drift: context("bundled/numbers-semantics", "seed-nan-drift", "", "offline") => failed{"nan-variant"}
        seed_infinity_drift: context("bundled/numbers-semantics", "seed-infinity-drift", "", "offline") => failed{"infinity-variant"}
        seed_exact_drift: context("bundled/numbers-semantics", "seed-exact-drift", "", "offline") => failed{"exact-value-variant"}
        seed_invalid_drift: context("bundled/numbers-semantics", "seed-invalid-drift", "", "offline") => failed{"invalid-parse-variant"}
        seed_bool_drift: context("bundled/numbers-semantics", "seed-bool-drift", "", "offline") => failed{"bool-spelling"}
        seed_range_short: context("bundled/numbers-semantics", "seed-range-short", "", "offline") => failed{"bool-range"}
        seed_float_drift: context("bundled/numbers-semantics", "seed-float-drift", "", "offline") => failed{"float-grammar"}
        seed_int_short: context("bundled/numbers-semantics", "seed-int-short", "", "offline") => failed{"int-grammar"}
        seed_locale_grouped: context("bundled/numbers-semantics", "seed-locale-grouped", "", "offline") => failed{"no-locale"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.bigint_digits, "9007199254740993", c, "bigint")
            failed
            ok evidence bigint_evidence => match call require_int(got.ieee_cases, 9, c, "ieee-boundary")
                failed
                ok evidence ieee_evidence => match call require_text(got.grammar_reject, "01", c, "grammar-boundary")
                    failed
                    ok evidence grammar_evidence => match call require_text(got.negative_zero, "0", c, "formatting")
                        failed
                        ok evidence formatting_evidence => match call require_text(got.inexact_reason, "not exactly representable as float", c, "conversion")
                            failed
                            ok evidence conversion_evidence => match call require_int(got.valid_int_parses, 6, c, "parsing")
                                failed
                                ok evidence parsing_evidence => match call require_int(got.predicate_inputs, 15, c, "predicate")
                                    failed
                                    ok evidence predicate_evidence => match call require_text(got.nan_spelling, "NaN", c, "nan-variant")
                                        failed
                                        ok evidence nan_evidence => match call require_text(got.infinity_spelling, "Infinity", c, "infinity-variant")
                                            failed
                                            ok evidence infinity_evidence => match call require_text(got.exact_value, "9007199254740992", c, "exact-value-variant")
                                                failed
                                                ok evidence exact_evidence => match call require_text(got.invalid_input, " 1", c, "invalid-parse-variant")
                                                    failed
                                                    ok evidence invalid_evidence => match call require_text(got.bool_true, "true", c, "bool-spelling")
                                                        failed
                                                        ok evidence spelling_evidence => match call require_int(got.bool_rejects, 3, c, "bool-range")
                                                            failed
                                                            ok evidence range_evidence => match call require_text(got.float_accept, "01.0", c, "float-grammar")
                                                                failed
                                                                ok evidence float_evidence => match call require_int(got.invalid_int_count, 19, c, "int-grammar")
                                                                    failed
                                                                    ok evidence int_grammar_evidence => match call require_bool(got.locale_free, true, c, "no-locale")
                                                                        failed
                                                                        ok evidence locale_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m05_032: "m05-032" => ok test_case("bundled/numbers-semantics", ["numbers", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("bigint"), check_ref("ieee-boundary"), check_ref("grammar-boundary"), check_ref("formatting"), check_ref("conversion"), check_ref("parsing"), check_ref("predicate"), check_ref("nan-variant"), check_ref("infinity-variant"), check_ref("exact-value-variant"), check_ref("invalid-parse-variant"), check_ref("bool-spelling"), check_ref("bool-range"), check_ref("float-grammar"), check_ref("int-grammar"), check_ref("no-locale")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m05-032"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/numbers-semantics", ["numbers", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("bigint"), check_ref("ieee-boundary"), check_ref("grammar-boundary"), check_ref("formatting"), check_ref("conversion"), check_ref("parsing"), check_ref("predicate"), check_ref("nan-variant"), check_ref("infinity-variant"), check_ref("exact-value-variant"), check_ref("invalid-parse-variant"), check_ref("bool-spelling"), check_ref("bool-range"), check_ref("float-grammar"), check_ref("int-grammar"), check_ref("no-locale")], callable case_body)
