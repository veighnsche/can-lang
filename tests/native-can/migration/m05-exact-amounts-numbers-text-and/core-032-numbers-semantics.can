    asserts
        default: "default" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_bigint_short: "seed-bigint-short" => ok observation("900719925474099", 9, "01", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_ieee_short: "seed-ieee-short" => ok observation("9007199254740993", 8, "01", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_grammar_drift: "seed-grammar-drift" => ok observation("9007199254740993", 9, "1", "0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_negzero_drift: "seed-negzero-drift" => ok observation("9007199254740993", 9, "01", "-0", "not exactly representable as float", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_conversion_drift: "seed-conversion-drift" => ok observation("9007199254740993", 9, "01", "0", "inexact", 6, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
        seed_parsing_short: "seed-parsing-short" => ok observation("9007199254740993", 9, "01", "0", "not exactly representable as float", 5, 15, "NaN", "Infinity", "9007199254740992", " 1", "true", 3, "01.0", 19, true)
