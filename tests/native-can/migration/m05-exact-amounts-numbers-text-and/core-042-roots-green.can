package m05core042roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-042 "bundled text: roots green".
/// Source: tests/integration/text_test.go symbol
/// TestCurrentBundledText.
/// Related fixtures: std/text/current/src/main.can (ground for every
/// per-function pin below: includes 2, starts 1, ends 1, lower 1, upper 1,
/// trimmed 1, sliced 1, split 3, replace 2, joined 2, scalars 3,
/// from_scalars 4, graphemes 2, normalized 2, references 1,
/// slice_reference 1, supplied 1, spread_replace 1, main 1, nested_join 1,
/// retain 1, nested_explicit 1, nested_inferred 1, nested_construction 1,
/// first_match 2, first_groups 2, compiles 3, capped_count 2 = 45 roots)
/// and runtime/test/text.test.ts (the staged bun trace pinned by
/// trace-pass/trace-fail).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): canlc assert green with passed report and exactly
/// 45 roots grounded per function in main.can, plus the staged bun trace
/// counts.
/// Text semantics live in core-042-text-semantics.can; the run
/// output/status shape and silent production entry live in
/// core-042-run-shape.can.
/// Variants: main fixture (the Go loop table pins main at 45 rows; the only
/// row); malformed surrogate/scalar, bad regex and zero-width matches are
/// pinned as counts and verbatim text in the semantics slice.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-022 (runtime/test/text.test.ts,
/// read-only record; 9 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/text-roots checks: assert-green, report-passed,
/// root-count, fixture-name, includes-roots, starts-roots, ends-roots,
/// lower-roots, upper-roots, trimmed-roots, sliced-roots, split-roots,
/// replace-roots, joined-roots, scalars-roots, from-scalars-roots,
/// graphemes-roots, normalized-roots, references-roots,
/// slice-reference-roots, supplied-roots, spread-replace-roots, main-roots,
/// nested-join-roots, retain-roots, nested-explicit-roots,
/// nested-inferred-roots, nested-construction-roots, first-match-roots,
/// first-groups-roots, compiles-roots, capped-count-roots, trace-pass,
/// trace-fail.
/// Facet map (text_test.go legs): assert-green pins the assert leg
/// (L80-82: exit 0, empty stderr); report-passed/root-count pin the report
/// leg (L84-86: passed true, 45 assertions for main); fixture-name grounds
/// the 45 roots in main.can (L71-79: {"main", 45} staged as src/main.can);
/// includes-roots pins includes (main.can L10-11: astral sample, empty
/// needle); starts-roots pins starts (L19: prefix sample); ends-roots pins
/// ends (L27: suffix sample); lower-roots pins lower (L34: ABC => abc);
/// upper-roots pins upper (L41: sharp-s => SS); trimmed-roots pins trimmed
/// (L48: padded hi); sliced-roots pins sliced (L55: slice(1, 3) emoji);
/// split-roots pins split (L63-65: empties, empty, empty separator);
/// replace-roots pins replace (L76-77: dollar sample, empty pattern);
/// joined-roots pins joined (L86-87: sample, empty); scalars-roots pins
/// scalars (L94-96: astral, empty, unpaired); from-scalars-roots pins
/// from_scalars (L105-108: astral, empty, surrogate, range);
/// graphemes-roots pins graphemes (L117-118: clusters, unpaired);
/// normalized-roots pins normalized (L127-128: NFC sample, unpaired);
/// references-roots pins references (L137: includes map);
/// slice-reference-roots pins slice_reference (L143: bound slice);
/// supplied-roots pins supplied (L149: fixture);
/// spread-replace-roots pins spread_replace (L157: spread dollars);
/// main-roots pins main (L166: empty [] => ok); nested-join-roots pins
/// nested_join (L176: spread join); retain-roots pins retain (L183:
/// generic sample); nested-explicit-roots pins nested_explicit (L188:
/// explicit spread); nested-inferred-roots pins nested_inferred (L193:
/// inferred spread); nested-construction-roots pins nested_construction
/// (L198: nested array); first-match-roots pins first_match (L206-207:
/// hit, none); first-groups-roots pins first_groups (L221-222: groups,
/// absent); compiles-roots pins compiles (L234-236: valid, syntax, flags);
/// capped-count-roots pins capped_count (L247-248: capped, over);
/// trace-pass/trace-fail pin the staged bun trace (L32: "9 pass",
/// "0 fail").
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    str fixture_name
    int includes_roots
    int starts_roots
    int ends_roots
    int lower_roots
    int upper_roots
    int trimmed_roots
    int sliced_roots
    int split_roots
    int replace_roots
    int joined_roots
    int scalars_roots
    int from_scalars_roots
    int graphemes_roots
    int normalized_roots
    int references_roots
    int slice_reference_roots
    int supplied_roots
    int spread_replace_roots
    int main_roots
    int nested_join_roots
    int retain_roots
    int nested_explicit_roots
    int nested_inferred_roots
    int nested_construction_roots
    int first_match_roots
    int first_groups_roots
    int compiles_roots
    int capped_count_roots
    int trace_pass
    int trace_fail
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/text-roots", "default", "", "offline"), "assert-green" => ok "case bundled/text-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/text-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case bundled/text-roots variant default root assert-green run offline")
        different: false, true, context("bundled/text-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 45, 45, context("bundled/text-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "45", "45", true, "case bundled/text-roots variant default root root-count run offline")
        different: 44, 45, context("bundled/text-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "main.can", "main.can", context("bundled/text-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "main.can", "main.can", true, "case bundled/text-roots variant default root fixture-name run offline")
        different: "text.can", "main.can", context("bundled/text-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
