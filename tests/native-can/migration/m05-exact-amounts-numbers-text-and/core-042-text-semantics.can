package m05core042text
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-042 "bundled text: unicode, split, scalars, regex".
/// Source: tests/integration/text_test.go symbol
/// TestCurrentBundledText (the staged bun leg L29-33) and
/// runtime/test/text.test.ts (every verbatim pin below comes from its 9
/// test roots) with std/text/current/src/main.can grounding the Can
/// assertion side.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): native Unicode/code-unit/grapheme behavior,
/// literal replacement and empty-preserving split, scalar validity,
/// bounded bulk decoding, regex caps/offsets, plus the
/// malformed-surrogate/malformed-scalar/bad-regex/zero-width variants.
/// The 45-root assert pin lives in core-042-roots-green.can; the run
/// output/status shape and silent production entry live in
/// core-042-run-shape.can.
/// Variants: malformed surrogate (unpaired, rejected by the named Unicode
/// ops), malformed scalar (surrogate/range, rejected by from_scalars),
/// bad regex (syntax + flags), zero-width matches (empty-hit advance and
/// the maximum cap).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-022 (runtime/test/text.test.ts,
/// read-only record; 9 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/text-semantics checks: unicode, code-unit, grapheme,
/// replacement, split, scalar-validity, bulk-chunks, regex-caps,
/// regex-offset, malformed-surrogate, malformed-scalar, bad-regex,
/// zero-width.
/// Facet map (text.test.ts roots + main.can): unicode pins native case
/// (L67-68: toUpperCase incl sharp-s => "SS"; main.can L41);
/// code-unit pins UTF-16 slicing (L71-72: slice(1n, 2n) half surrogate +
/// bigint clamp; main.can L55: slice(1, 3) => astral emoji); grapheme pins
/// 4 clusters (L99-100: A, astral, combining e, ZWJ family; main.can
/// L117); replacement pins literal dollars (L76-81: six spellings $&, $`,
/// $', $$, $1, astral + "a.a"; main.can L76: "aba" => "$&b$&"); split pins
/// empty pieces (L82-86: ",a,," keeps 4 frozen pieces + join round-trip;
/// main.can L63); scalar-validity pins code points (L93-96: Array.from
/// codePointAt shorter than UTF-16 length, frozen; main.can L94: astral =>
/// 65, 128512); bulk-chunks pins bounded decoding (L120-127: 150000
/// scalars decode in native chunks, input untouched); regex-caps pins
/// groups (L141-149: a, b + absent "", b; main.can L221); regex-offset pins
/// UTF-16 offsets (L141-146: 0..3 first hit; L150-152: astral 0..2);
/// malformed-surrogate pins unpaired rejection (L108-113: 4 inputs x 3
/// ops; main.can L96/L118/L128); malformed-scalar pins scalar rejection
/// (L114-117: 5 invalid + 4 boundary-valid; main.can L107-108); bad-regex
/// pins invalid patterns (L129-135: g/y/d/z/ii-space flags, "(a", "uv";
/// main.can L235-236); zero-width pins empty-hit advance (L154-191: 0, 2,
/// 3 u/v, 0..3 plain, 10000 cap, limit 1/0/-1/10001; main.can L247-248:
/// capped 2, over => invalid_limit).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str upper_ss
    str sliced_emoji
    int grapheme_count
    str replaced
    str split_joined
    str scalars_csv
    bool bulk_bounded
    str groups_csv
    str offsets_csv
    str surrogate_reason
    str scalar_reason
    str regex_reason
    int zero_width_hits
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/text-semantics", "default", "", "offline"), "unicode" => ok "case bundled/text-semantics variant default root unicode run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/text-semantics", "default", "", "offline"), "bulk-chunks" => ok evidence("bulk-chunks", "true", "true", true, "case bundled/text-semantics variant default root bulk-chunks run offline")
        different: false, true, context("bundled/text-semantics", "default", "", "offline"), "bulk-chunks" => failed{"bulk-chunks"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("bundled/text-semantics", "default", "", "offline"), "grapheme" => ok evidence("grapheme", "4", "4", true, "case bundled/text-semantics variant default root grapheme run offline")
        different: 3, 4, context("bundled/text-semantics", "default", "", "offline"), "grapheme" => failed{"grapheme"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "SS", "SS", context("bundled/text-semantics", "default", "", "offline"), "unicode" => ok evidence("unicode", "SS", "SS", true, "case bundled/text-semantics variant default root unicode run offline")
        different: "ss", "SS", context("bundled/text-semantics", "default", "", "offline"), "unicode" => failed{"unicode"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_upper_drift: "seed-upper-drift" => ok observation("ss", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_slice_drift: "seed-slice-drift" => ok observation("SS", "A", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_grapheme_short: "seed-grapheme-short" => ok observation("SS", "😀", 3, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_replace_drift: "seed-replace-drift" => ok observation("SS", "😀", 4, "abab", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_split_drift: "seed-split-drift" => ok observation("SS", "😀", 4, "$&b$&", "a", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_scalar_drift: "seed-scalar-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_bulk_unbounded: "seed-bulk-unbounded" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", false, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_groups_drift: "seed-groups-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_offset_drift: "seed-offset-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,2", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        seed_surrogate_drift: "seed-surrogate-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired", "invalid scalar value", "syntax", 2)
        seed_malformed_scalar_drift: "seed-malformed-scalar-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "out of range", "syntax", 2)
        seed_regex_drift: "seed-regex-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "flags", 2)
        seed_zero_width_short: "seed-zero-width-short" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 1)
    match variant_id
        "seed-upper-drift" => ok observation("ss", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-slice-drift" => ok observation("SS", "A", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-grapheme-short" => ok observation("SS", "😀", 3, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-replace-drift" => ok observation("SS", "😀", 4, "abab", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-split-drift" => ok observation("SS", "😀", 4, "$&b$&", "a", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-scalar-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-bulk-unbounded" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", false, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-groups-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-offset-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,2", "unpaired surrogate", "invalid scalar value", "syntax", 2)
        "seed-surrogate-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired", "invalid scalar value", "syntax", 2)
        "seed-malformed-scalar-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "out of range", "syntax", 2)
        "seed-regex-drift" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "flags", 2)
        "seed-zero-width-short" => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 1)
        _ => ok observation("SS", "😀", 4, "$&b$&", ",a,,", "65,128512", true, "a,b", "0,3", "unpaired surrogate", "invalid scalar value", "syntax", 2)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m05_042: "m05-042" => ok [check("unicode", "native case maps sharp-s to SS"), check("code-unit", "code-unit slice keeps the astral emoji"), check("grapheme", "grapheme segmentation finds 4 clusters"), check("replacement", "literal replacement preserves dollar sequences"), check("split", "split retains every empty piece"), check("scalar-validity", "scalar decoding matches code points"), check("bulk-chunks", "bulk scalar decoding uses bounded native chunks"), check("regex-caps", "regex reports capture groups"), check("regex-offset", "matches report UTF-16 offsets"), check("malformed-surrogate", "unpaired surrogates rejected as invalid unicode"), check("malformed-scalar", "out-of-range scalars rejected as invalid unicode"), check("bad-regex", "bad patterns rejected as invalid regex"), check("zero-width", "zero-width matches advance and honor caps")]
        other: "nope" => ok []
    match scope is "m05-042"
        false => ok []
        true => ok [check("unicode", "native case maps sharp-s to SS"), check("code-unit", "code-unit slice keeps the astral emoji"), check("grapheme", "grapheme segmentation finds 4 clusters"), check("replacement", "literal replacement preserves dollar sequences"), check("split", "split retains every empty piece"), check("scalar-validity", "scalar decoding matches code points"), check("bulk-chunks", "bulk scalar decoding uses bounded native chunks"), check("regex-caps", "regex reports capture groups"), check("regex-offset", "matches report UTF-16 offsets"), check("malformed-surrogate", "unpaired surrogates rejected as invalid unicode"), check("malformed-scalar", "out-of-range scalars rejected as invalid unicode"), check("bad-regex", "bad patterns rejected as invalid regex"), check("zero-width", "zero-width matches advance and honor caps")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/text-semantics" => ok [expected_check("unicode", "SS"), expected_check("code-unit", "😀"), expected_check("grapheme", "4"), expected_check("replacement", "$&b$&"), expected_check("split", ",a,,"), expected_check("scalar-validity", "65,128512"), expected_check("bulk-chunks", "true"), expected_check("regex-caps", "a,b"), expected_check("regex-offset", "0,3"), expected_check("malformed-surrogate", "unpaired surrogate"), expected_check("malformed-scalar", "invalid scalar value"), expected_check("bad-regex", "syntax"), expected_check("zero-width", "2")]
        unknown: "nope" => ok []
    match case is "bundled/text-semantics"
        false => ok []
        true => ok [expected_check("unicode", "SS"), expected_check("code-unit", "😀"), expected_check("grapheme", "4"), expected_check("replacement", "$&b$&"), expected_check("split", ",a,,"), expected_check("scalar-validity", "65,128512"), expected_check("bulk-chunks", "true"), expected_check("regex-caps", "a,b"), expected_check("regex-offset", "0,3"), expected_check("malformed-surrogate", "unpaired surrogate"), expected_check("malformed-scalar", "invalid scalar value"), expected_check("bad-regex", "syntax"), expected_check("zero-width", "2")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/text-semantics", "default", "", "offline") => ok
        seed_upper_drift: context("bundled/text-semantics", "seed-upper-drift", "", "offline") => failed{"unicode"}
        seed_slice_drift: context("bundled/text-semantics", "seed-slice-drift", "", "offline") => failed{"code-unit"}
        seed_grapheme_short: context("bundled/text-semantics", "seed-grapheme-short", "", "offline") => failed{"grapheme"}
        seed_replace_drift: context("bundled/text-semantics", "seed-replace-drift", "", "offline") => failed{"replacement"}
        seed_split_drift: context("bundled/text-semantics", "seed-split-drift", "", "offline") => failed{"split"}
        seed_scalar_drift: context("bundled/text-semantics", "seed-scalar-drift", "", "offline") => failed{"scalar-validity"}
        seed_bulk_unbounded: context("bundled/text-semantics", "seed-bulk-unbounded", "", "offline") => failed{"bulk-chunks"}
        seed_groups_drift: context("bundled/text-semantics", "seed-groups-drift", "", "offline") => failed{"regex-caps"}
        seed_offset_drift: context("bundled/text-semantics", "seed-offset-drift", "", "offline") => failed{"regex-offset"}
        seed_surrogate_drift: context("bundled/text-semantics", "seed-surrogate-drift", "", "offline") => failed{"malformed-surrogate"}
        seed_malformed_scalar_drift: context("bundled/text-semantics", "seed-malformed-scalar-drift", "", "offline") => failed{"malformed-scalar"}
        seed_regex_drift: context("bundled/text-semantics", "seed-regex-drift", "", "offline") => failed{"bad-regex"}
        seed_zero_width_short: context("bundled/text-semantics", "seed-zero-width-short", "", "offline") => failed{"zero-width"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.upper_ss, "SS", c, "unicode")
            failed
            ok evidence upper_ss_evidence => match call require_text(got.sliced_emoji, "😀", c, "code-unit")
                failed
                ok evidence sliced_emoji_evidence => match call require_int(got.grapheme_count, 4, c, "grapheme")
                    failed
                    ok evidence grapheme_count_evidence => match call require_text(got.replaced, "$&b$&", c, "replacement")
                        failed
                        ok evidence replaced_evidence => match call require_text(got.split_joined, ",a,,", c, "split")
                            failed
                            ok evidence split_joined_evidence => match call require_text(got.scalars_csv, "65,128512", c, "scalar-validity")
                                failed
                                ok evidence scalars_csv_evidence => match call require_bool(got.bulk_bounded, true, c, "bulk-chunks")
                                    failed
                                    ok evidence bulk_bounded_evidence => match call require_text(got.groups_csv, "a,b", c, "regex-caps")
                                        failed
                                        ok evidence groups_csv_evidence => match call require_text(got.offsets_csv, "0,3", c, "regex-offset")
                                            failed
                                            ok evidence offsets_csv_evidence => match call require_text(got.surrogate_reason, "unpaired surrogate", c, "malformed-surrogate")
                                                failed
                                                ok evidence surrogate_reason_evidence => match call require_text(got.scalar_reason, "invalid scalar value", c, "malformed-scalar")
                                                    failed
                                                    ok evidence scalar_reason_evidence => match call require_text(got.regex_reason, "syntax", c, "bad-regex")
                                                        failed
                                                        ok evidence regex_reason_evidence => match call require_int(got.zero_width_hits, 2, c, "zero-width")
                                                            failed
                                                            ok evidence zero_width_hits_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m05_042: "m05-042" => ok test_case("bundled/text-semantics", ["text", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("unicode"), check_ref("code-unit"), check_ref("grapheme"), check_ref("replacement"), check_ref("split"), check_ref("scalar-validity"), check_ref("bulk-chunks"), check_ref("regex-caps"), check_ref("regex-offset"), check_ref("malformed-surrogate"), check_ref("malformed-scalar"), check_ref("bad-regex"), check_ref("zero-width")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m05-042"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/text-semantics", ["text", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("unicode"), check_ref("code-unit"), check_ref("grapheme"), check_ref("replacement"), check_ref("split"), check_ref("scalar-validity"), check_ref("bulk-chunks"), check_ref("regex-caps"), check_ref("regex-offset"), check_ref("malformed-surrogate"), check_ref("malformed-scalar"), check_ref("bad-regex"), check_ref("zero-width")], callable case_body)
