package m05core045roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-045 "bundled utilities: roots green".
/// Source: tests/integration/utilities_test.go symbol
/// TestCurrentBundledUtilities.
/// Related fixtures: compiler/testdata/current/cli/utilities.can (ground
/// for every per-function pin below: hash_empty 2, main 1 = 3 roots),
/// runtime/test/url.test.ts (the 5-pass staged bun trace) and
/// runtime/test/datetime.test.ts (the 7-pass staged bun trace).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): canlc assert green with passed report and exactly
/// 3 roots grounded per function in utilities.can, the supplied-completion
/// report token with secret redaction, plus the two staged bun trace
/// counts.
/// URL/datetime semantics and the conversion/bounds table live in
/// core-045-utilities-semantics.can; the run output/status shape, silent
/// production entry, build leg and conditional strict tsc leg live in
/// core-045-run-shape.can.
/// Variants: main fixture (the only staged row; utilities.can is copied to
/// src/main.can verbatim before assert).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-010 (runtime/test/datetime.test.ts,
/// read-only record; 7 declarations; not executed here), DELEGATE-030
/// (runtime/test/url.test.ts, read-only record; 5 declarations; not
/// executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/utilities-roots checks: assert-green, report-passed,
/// root-count, fixture-name, hash-empty-roots, main-roots,
/// supplied-completion, assert-redacted, url-trace-pass,
/// datetime-trace-pass, trace-fail.
/// Facet map (utilities_test.go legs): assert-green pins the assert leg
/// (L77: exit 0, empty stderr); report-passed pins the report outcome
/// (L77: the assert command succeeds, so the report passes);
/// root-count pins exactly 3 roots grounded in the fixture (the Go assert
/// leg checks exit/diag/substring only, so the count grounds in
/// utilities.can: hash_empty 2 + main 1); fixture-name grounds the 3 roots
/// in utilities.can (L55-60: compiler/testdata/current/cli/utilities.can
/// staged to src/main.can); hash-empty-roots pins hash_empty
/// (utilities.can L6-8: sample, native_expected); main-roots pins main
/// (L16-17: sample); supplied-completion pins the report token (L77:
/// output contains "supplied-completion" verbatim); assert-redacted pins
/// the redaction facet (L77: output omits "secret" even though the
/// fixture logs "secret info"/"secret error"); url-trace-pass pins the url
/// trace (L31: "5 pass"); datetime-trace-pass pins the datetime trace
/// (L31: "7 pass"); trace-fail pins both traces (L35: "0 fail" required
/// for each trace file).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    str fixture_name
    int hash_empty_roots
    int main_roots
    str supplied_token
    bool assert_redacted
    int url_trace_pass
    int datetime_trace_pass
    int trace_fail
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/utilities-roots", "default", "", "offline"), "assert-green" => ok "case bundled/utilities-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/utilities-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case bundled/utilities-roots variant default root assert-green run offline")
        different: false, true, context("bundled/utilities-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("bundled/utilities-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "3", "3", true, "case bundled/utilities-roots variant default root root-count run offline")
        different: 2, 3, context("bundled/utilities-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "utilities.can", "utilities.can", context("bundled/utilities-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "utilities.can", "utilities.can", true, "case bundled/utilities-roots variant default root fixture-name run offline")
        different: "utils.can", "utilities.can", context("bundled/utilities-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
