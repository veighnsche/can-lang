    asserts
        default: "default" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        seed_assert_red: "seed-assert-red" => ok observation(false, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        seed_report_red: "seed-report-red" => ok observation(true, false, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        seed_root_short: "seed-root-short" => ok observation(true, true, 2, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        seed_fixture_drift: "seed-fixture-drift" => ok observation(true, true, 3, "utils.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        seed_hash_empty_loss: "seed-hash-empty-loss" => ok observation(true, true, 3, "utilities.can", 1, 1, "supplied-completion", true, 5, 7, 0)
        seed_main_loss: "seed-main-loss" => ok observation(true, true, 3, "utilities.can", 2, 0, "supplied-completion", true, 5, 7, 0)
        seed_token_drift: "seed-token-drift" => ok observation(true, true, 3, "utilities.can", 2, 1, "real-can", true, 5, 7, 0)
        seed_assert_leak: "seed-assert-leak" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", false, 5, 7, 0)
        seed_url_short: "seed-url-short" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 4, 7, 0)
        seed_datetime_short: "seed-datetime-short" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 6, 0)
        seed_trace_fail_noisy: "seed-trace-fail-noisy" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 1)
    match variant_id
        "seed-assert-red" => ok observation(false, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        "seed-report-red" => ok observation(true, false, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        "seed-root-short" => ok observation(true, true, 2, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        "seed-fixture-drift" => ok observation(true, true, 3, "utils.can", 2, 1, "supplied-completion", true, 5, 7, 0)
        "seed-hash-empty-loss" => ok observation(true, true, 3, "utilities.can", 1, 1, "supplied-completion", true, 5, 7, 0)
        "seed-main-loss" => ok observation(true, true, 3, "utilities.can", 2, 0, "supplied-completion", true, 5, 7, 0)
        "seed-token-drift" => ok observation(true, true, 3, "utilities.can", 2, 1, "real-can", true, 5, 7, 0)
        "seed-assert-leak" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", false, 5, 7, 0)
        "seed-url-short" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 4, 7, 0)
        "seed-datetime-short" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 6, 0)
        "seed-trace-fail-noisy" => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 1)
        _ => ok observation(true, true, 3, "utilities.can", 2, 1, "supplied-completion", true, 5, 7, 0)
