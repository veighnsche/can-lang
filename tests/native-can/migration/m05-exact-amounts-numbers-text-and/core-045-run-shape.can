package m05core045run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-045 "bundled utilities: run shape, structured stderr, build".
/// Source: tests/integration/utilities_test.go symbol
/// TestCurrentBundledUtilities.
/// Related fixtures: compiler/testdata/current/cli/utilities.can main
/// entry (L12-53: wall/monotonic/sleep/secure_bytes/uuid/hash guards with
/// the write_info + write_error log tail L45-53 and no stdout emission)
/// executed through the utilities_test.go run helper (L61-76:
/// /usr/bin/sandbox-exec with the deny-network profile, PATH=/nonexistent,
/// fresh temp HOME).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production execution preserves utility outcomes
/// through a stdout-silent run (exit 0, empty stdout) carrying the two
/// structured JSON log lines on stderr, under the offline deny-network
/// sandbox profile, plus the build leg and the conditional strict-tsc leg.
/// The 3-root assert pin lives in core-045-roots-green.can; the URL and
/// datetime semantics with the conversion/bounds table live in
/// core-045-utilities-semantics.can.
/// Variants: main fixture (single staged row; the bound mutations in
/// L84-98 rewrite src/main.can per row and restore it at L99 before the
/// build leg).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none beyond DELEGATE-010 + DELEGATE-030 (recorded
/// on the roots/semantics slices; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/utilities-run checks: run-exit, run-stdout-empty,
/// run-stderr-first, run-stderr-lines, entry-silent, sandbox-profile,
/// offline-ok, build-green, tsc-conditional.
/// Facet map (utilities_test.go legs): run-exit/run-stdout-empty pin the
/// run leg (L81: exit 0, empty stdout); run-stderr-first pins the first
/// structured log line (L80: {"level":"info","message":"secret info"}
/// verbatim); run-stderr-lines pins the two-line stderr shape (L80: info
/// line + {"level":"error","message":"secret error"} line, each newline
/// terminated); entry-silent pins the combined stdout-silent facet (L81
/// with utilities.can L12-53: main verifies every guard and emits only
/// the two log lines to stderr); sandbox-profile pins the offline run
/// shape (L32/L62: "(version 1)(allow default)(deny network*)" verbatim);
/// offline-ok pins the offline behavior (L61-76: the sandboxed
/// deny-network run with PATH=/nonexistent succeeds); build-green pins
/// the build leg (L100-103: canlc build exits 0 and reports a directory);
/// tsc-conditional pins the optional strict tsc leg (L110-115: strict tsc
/// over the emitted entry.ts runs only when CAN_TSC is set).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stdout_empty
    str stderr_first
    int stderr_lines
    bool entry_silent
    str sandbox_profile
    bool offline_ok
    bool build_green
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/utilities-run", "default", "", "offline"), "run-exit" => ok "case bundled/utilities-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/utilities-run", "default", "", "offline"), "run-stdout-empty" => ok evidence("run-stdout-empty", "true", "true", true, "case bundled/utilities-run variant default root run-stdout-empty run offline")
        different: false, true, context("bundled/utilities-run", "default", "", "offline"), "run-stdout-empty" => failed{"run-stdout-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("bundled/utilities-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case bundled/utilities-run variant default root run-exit run offline")
        different: 1, 0, context("bundled/utilities-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "{\"level\":\"info\",\"message\":\"secret info\"}", "{\"level\":\"info\",\"message\":\"secret info\"}", context("bundled/utilities-run", "default", "", "offline"), "run-stderr-first" => ok evidence("run-stderr-first", "{\"level\":\"info\",\"message\":\"secret info\"}", "{\"level\":\"info\",\"message\":\"secret info\"}", true, "case bundled/utilities-run variant default root run-stderr-first run offline")
        different: "{\"level\":\"info\",\"message\":\"info\"}", "{\"level\":\"info\",\"message\":\"secret info\"}", context("bundled/utilities-run", "default", "", "offline"), "run-stderr-first" => failed{"run-stderr-first"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
        seed_run_red: "seed-run-red" => ok observation(1, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
        seed_stdout_noisy: "seed-stdout-noisy" => ok observation(0, false, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
        seed_stderr_drift: "seed-stderr-drift" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
        seed_stderr_short: "seed-stderr-short" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 1, true, "(version 1)(allow default)(deny network*)", true, true, true)
        seed_entry_noisy: "seed-entry-noisy" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, false, "(version 1)(allow default)(deny network*)", true, true, true)
        seed_profile_drift: "seed-profile-drift" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)", true, true, true)
        seed_offline_fail: "seed-offline-fail" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", false, true, true)
        seed_build_red: "seed-build-red" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, false, true)
        seed_tsc_unconditional: "seed-tsc-unconditional" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, false)
    match variant_id
        "seed-run-red" => ok observation(1, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
        "seed-stdout-noisy" => ok observation(0, false, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
        "seed-stderr-drift" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
        "seed-stderr-short" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 1, true, "(version 1)(allow default)(deny network*)", true, true, true)
        "seed-entry-noisy" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, false, "(version 1)(allow default)(deny network*)", true, true, true)
        "seed-profile-drift" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)", true, true, true)
        "seed-offline-fail" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", false, true, true)
        "seed-build-red" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, false, true)
        "seed-tsc-unconditional" => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, false)
        _ => ok observation(0, true, "{\"level\":\"info\",\"message\":\"secret info\"}", 2, true, "(version 1)(allow default)(deny network*)", true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m05_045: "m05-045" => ok [check("run-exit", "production run exits 0"), check("run-stdout-empty", "production run keeps stdout empty"), check("run-stderr-first", "production run logs the secret info line first on stderr"), check("run-stderr-lines", "production run emits exactly 2 stderr log lines"), check("entry-silent", "production entry is stdout-silent with exit 0"), check("sandbox-profile", "run helper pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed run succeeds"), check("build-green", "canlc build exits 0 with a directory"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set")]
        other: "nope" => ok []
    match scope is "m05-045"
        false => ok []
        true => ok [check("run-exit", "production run exits 0"), check("run-stdout-empty", "production run keeps stdout empty"), check("run-stderr-first", "production run logs the secret info line first on stderr"), check("run-stderr-lines", "production run emits exactly 2 stderr log lines"), check("entry-silent", "production entry is stdout-silent with exit 0"), check("sandbox-profile", "run helper pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed run succeeds"), check("build-green", "canlc build exits 0 with a directory"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/utilities-run" => ok [expected_check("run-exit", "0"), expected_check("run-stdout-empty", "true"), expected_check("run-stderr-first", "{\"level\":\"info\",\"message\":\"secret info\"}"), expected_check("run-stderr-lines", "2"), expected_check("entry-silent", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("build-green", "true"), expected_check("tsc-conditional", "true")]
        unknown: "nope" => ok []
    match case is "bundled/utilities-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stdout-empty", "true"), expected_check("run-stderr-first", "{\"level\":\"info\",\"message\":\"secret info\"}"), expected_check("run-stderr-lines", "2"), expected_check("entry-silent", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("build-green", "true"), expected_check("tsc-conditional", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/utilities-run", "default", "", "offline") => ok
        seed_run_red: context("bundled/utilities-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stdout_noisy: context("bundled/utilities-run", "seed-stdout-noisy", "", "offline") => failed{"run-stdout-empty"}
        seed_stderr_drift: context("bundled/utilities-run", "seed-stderr-drift", "", "offline") => failed{"run-stderr-first"}
        seed_stderr_short: context("bundled/utilities-run", "seed-stderr-short", "", "offline") => failed{"run-stderr-lines"}
        seed_entry_noisy: context("bundled/utilities-run", "seed-entry-noisy", "", "offline") => failed{"entry-silent"}
        seed_profile_drift: context("bundled/utilities-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_fail: context("bundled/utilities-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
        seed_build_red: context("bundled/utilities-run", "seed-build-red", "", "offline") => failed{"build-green"}
        seed_tsc_unconditional: context("bundled/utilities-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stdout_empty, true, c, "run-stdout-empty")
                failed
                ok evidence stdout_evidence => match call require_text(got.stderr_first, "{\"level\":\"info\",\"message\":\"secret info\"}", c, "run-stderr-first")
                    failed
                    ok evidence stderr_first_evidence => match call require_int(got.stderr_lines, 2, c, "run-stderr-lines")
                        failed
                        ok evidence stderr_lines_evidence => match call require_bool(got.entry_silent, true, c, "entry-silent")
                            failed
                            ok evidence silent_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                failed
                                ok evidence profile_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                                    failed
                                    ok evidence offline_evidence => match call require_bool(got.build_green, true, c, "build-green")
                                        failed
                                        ok evidence build_evidence => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                            failed
                                            ok evidence tsc_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m05_045: "m05-045" => ok test_case("bundled/utilities-run", ["utilities", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stdout-empty"), check_ref("run-stderr-first"), check_ref("run-stderr-lines"), check_ref("entry-silent"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("build-green"), check_ref("tsc-conditional")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m05-045"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/utilities-run", ["utilities", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stdout-empty"), check_ref("run-stderr-first"), check_ref("run-stderr-lines"), check_ref("entry-silent"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("build-green"), check_ref("tsc-conditional")], callable case_body)
