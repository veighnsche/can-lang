package m05core045utilities
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M05 CORE-045 "bundled utilities: URL, datetime, conversion, bounds".
/// Source: tests/integration/utilities_test.go symbol
/// TestCurrentBundledUtilities (the staged bun leg L28-38 and the
/// conversion/bounds table L84-98), runtime/test/url.test.ts (every URL
/// pin below comes from its 5 test roots) and runtime/test/
/// datetime.test.ts (every datetime pin below comes from its 7 test
/// roots), with compiler/testdata/current/cli/utilities.can grounding the
/// Can assertion side.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): native URL normalization/query and datetime
/// zone/locale/civil edge cases, the compiled Can utilities from/to
/// conversion table and bound enforcement, plus the URL-5/datetime-7 case
/// variants.
/// The 3-root assert pin lives in core-045-roots-green.can; the run
/// output/status shape, silent production entry, build leg and
/// conditional strict tsc leg live in core-045-run-shape.can.
/// Variants: URL 5 cases (3 parsing roots + 2 query roots), datetime 7
/// cases (1 instant root + 2 zoned-formatting roots + 4 civil roots), Can
/// utility from/to conversion table (4 rows: 2 clock + 2 random).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: DELEGATE-010 (runtime/test/datetime.test.ts,
/// read-only record; 7 declarations; not executed here), DELEGATE-030
/// (runtime/test/url.test.ts, read-only record; 5 declarations; not
/// executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case bundled/utilities-semantics checks: url-normalization, url-query,
/// datetime-zone, datetime-locale, datetime-civil, conversion-table,
/// bounds, url-cases, datetime-cases.
/// Facet map (url.test.ts + datetime.test.ts roots + Go table):
/// url-normalization pins the normalized projection (url.test.ts L71-93:
/// HTTPS://Example.COM:8080/a/../b?q=1#f => scheme https, host
/// example.com, port 8080, path /b, query q=1, fragment f; bare http://h
/// defaults L83-90; default 443 deflates to 0 L91-92; ftp => scheme and
/// malformed text => syntax with userinfo never projecting L94-102;
/// relative resolution L103-110); url-query pins the 6 ordered pairs
/// (L114-130: a=1, a=2, b=+x => " x", u => euro sign, bare e, empty f;
/// queryAll vectors L116-120; rebuild with form encoding L131-143);
/// datetime-zone pins the Tokyo rendering (datetime.test.ts L108-112:
/// "Sep 23, 2026 at 9:00 PM"; unknown Mars/Olympus zone => invalid_zone
/// L123-131); datetime-locale pins the Berlin rendering (L119-121:
/// "23.09.26, 14:00"; full-date UTC L113-115; medium-time UTC L116-118;
/// bad date_style/time_style/locale => invalid_option L131-149);
/// datetime-civil pins the civil zone (L153: America/New_York; ordinary
/// resolve L154-159; spring gap rejects and fall overlap takes the
/// explicit 0/1 policy L160-175; impossible dates => nonexistent_time and
/// bad parts/policy => invalid_option L176-207; low year 99 stays literal
/// L208-213); conversion-table pins the 4-row from/to table
/// (utilities_test.go L84-89: sleep(0) => sleep(-1)/sleep(2147483648)
/// with can.std.clock@1::invalid_duration; secure_bytes(0) =>
/// secure_bytes(-1)/secure_bytes(65537) with
/// can.std.random@1::invalid_length); bounds pins bound enforcement
/// (L90-98: each mutated run exits 1 with empty stdout, diag carrying
/// "identity":"can.error.v2:" + the row identity, and no "secret");
/// url-cases pins the 5 URL cases (L31: "5 pass"; DELEGATE-030);
/// datetime-cases pins the 7 datetime cases (L31: "7 pass";
/// DELEGATE-010). Trace counts repeat the roots-slice trace pins so this
/// package stays self-contained.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str url_host
    int query_pairs
    str zone_text
    str locale_text
    str civil_zone
    int conversion_rows
    int bound_exit
    int url_cases
    int datetime_cases
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/utilities-semantics", "default", "", "offline"), "url-normalization" => ok "case bundled/utilities-semantics variant default root url-normalization run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/utilities-semantics", "default", "", "offline"), "bounds" => ok evidence("bounds", "true", "true", true, "case bundled/utilities-semantics variant default root bounds run offline")
        different: false, true, context("bundled/utilities-semantics", "default", "", "offline"), "bounds" => failed{"bounds"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("bundled/utilities-semantics", "default", "", "offline"), "url-query" => ok evidence("url-query", "6", "6", true, "case bundled/utilities-semantics variant default root url-query run offline")
        different: 5, 6, context("bundled/utilities-semantics", "default", "", "offline"), "url-query" => failed{"url-query"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "example.com", "example.com", context("bundled/utilities-semantics", "default", "", "offline"), "url-normalization" => ok evidence("url-normalization", "example.com", "example.com", true, "case bundled/utilities-semantics variant default root url-normalization run offline")
        different: "example.org", "example.com", context("bundled/utilities-semantics", "default", "", "offline"), "url-normalization" => failed{"url-normalization"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
        seed_host_drift: "seed-host-drift" => ok observation("example.org", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
        seed_pairs_short: "seed-pairs-short" => ok observation("example.com", 5, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
        seed_zone_drift: "seed-zone-drift" => ok observation("example.com", 6, "Sep 23, 2026 at 9:01 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
        seed_locale_drift: "seed-locale-drift" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:01", "America/New_York", 4, 1, 5, 7)
        seed_civil_drift: "seed-civil-drift" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/Chicago", 4, 1, 5, 7)
        seed_table_short: "seed-table-short" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 3, 1, 5, 7)
        seed_bound_green: "seed-bound-green" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 0, 5, 7)
        seed_url_short: "seed-url-short" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 4, 7)
        seed_datetime_short: "seed-datetime-short" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 6)
    match variant_id
        "seed-host-drift" => ok observation("example.org", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
        "seed-pairs-short" => ok observation("example.com", 5, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
        "seed-zone-drift" => ok observation("example.com", 6, "Sep 23, 2026 at 9:01 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
        "seed-locale-drift" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:01", "America/New_York", 4, 1, 5, 7)
        "seed-civil-drift" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/Chicago", 4, 1, 5, 7)
        "seed-table-short" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 3, 1, 5, 7)
        "seed-bound-green" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 0, 5, 7)
        "seed-url-short" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 4, 7)
        "seed-datetime-short" => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 6)
        _ => ok observation("example.com", 6, "Sep 23, 2026 at 9:00 PM", "23.09.26, 14:00", "America/New_York", 4, 1, 5, 7)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m05_045: "m05-045" => ok [check("url-normalization", "absolute urls project normalized immutable parts"), check("url-query", "queries keep 6 ordered pairs with form decoding"), check("datetime-zone", "explicit zones format deterministically on the pinned ICU"), check("datetime-locale", "locale and style matrix renders verbatim text"), check("datetime-civil", "civil times resolve in America/New_York with gap and overlap policy"), check("conversion-table", "from/to conversion table carries 4 rows"), check("bounds", "bound violations exit 1 with identity diagnostics"), check("url-cases", "url trace pins 5 cases"), check("datetime-cases", "datetime trace pins 7 cases")]
        other: "nope" => ok []
    match scope is "m05-045"
        false => ok []
        true => ok [check("url-normalization", "absolute urls project normalized immutable parts"), check("url-query", "queries keep 6 ordered pairs with form decoding"), check("datetime-zone", "explicit zones format deterministically on the pinned ICU"), check("datetime-locale", "locale and style matrix renders verbatim text"), check("datetime-civil", "civil times resolve in America/New_York with gap and overlap policy"), check("conversion-table", "from/to conversion table carries 4 rows"), check("bounds", "bound violations exit 1 with identity diagnostics"), check("url-cases", "url trace pins 5 cases"), check("datetime-cases", "datetime trace pins 7 cases")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/utilities-semantics" => ok [expected_check("url-normalization", "example.com"), expected_check("url-query", "6"), expected_check("datetime-zone", "Sep 23, 2026 at 9:00 PM"), expected_check("datetime-locale", "23.09.26, 14:00"), expected_check("datetime-civil", "America/New_York"), expected_check("conversion-table", "4"), expected_check("bounds", "1"), expected_check("url-cases", "5"), expected_check("datetime-cases", "7")]
        unknown: "nope" => ok []
    match case is "bundled/utilities-semantics"
        false => ok []
        true => ok [expected_check("url-normalization", "example.com"), expected_check("url-query", "6"), expected_check("datetime-zone", "Sep 23, 2026 at 9:00 PM"), expected_check("datetime-locale", "23.09.26, 14:00"), expected_check("datetime-civil", "America/New_York"), expected_check("conversion-table", "4"), expected_check("bounds", "1"), expected_check("url-cases", "5"), expected_check("datetime-cases", "7")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/utilities-semantics", "default", "", "offline") => ok
        seed_host_drift: context("bundled/utilities-semantics", "seed-host-drift", "", "offline") => failed{"url-normalization"}
        seed_pairs_short: context("bundled/utilities-semantics", "seed-pairs-short", "", "offline") => failed{"url-query"}
        seed_zone_drift: context("bundled/utilities-semantics", "seed-zone-drift", "", "offline") => failed{"datetime-zone"}
        seed_locale_drift: context("bundled/utilities-semantics", "seed-locale-drift", "", "offline") => failed{"datetime-locale"}
        seed_civil_drift: context("bundled/utilities-semantics", "seed-civil-drift", "", "offline") => failed{"datetime-civil"}
        seed_table_short: context("bundled/utilities-semantics", "seed-table-short", "", "offline") => failed{"conversion-table"}
        seed_bound_green: context("bundled/utilities-semantics", "seed-bound-green", "", "offline") => failed{"bounds"}
        seed_url_short: context("bundled/utilities-semantics", "seed-url-short", "", "offline") => failed{"url-cases"}
        seed_datetime_short: context("bundled/utilities-semantics", "seed-datetime-short", "", "offline") => failed{"datetime-cases"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.url_host, "example.com", c, "url-normalization")
            failed
            ok evidence host_evidence => match call require_int(got.query_pairs, 6, c, "url-query")
                failed
                ok evidence query_evidence => match call require_text(got.zone_text, "Sep 23, 2026 at 9:00 PM", c, "datetime-zone")
                    failed
                    ok evidence zone_evidence => match call require_text(got.locale_text, "23.09.26, 14:00", c, "datetime-locale")
                        failed
                        ok evidence locale_evidence => match call require_text(got.civil_zone, "America/New_York", c, "datetime-civil")
                            failed
                            ok evidence civil_evidence => match call require_int(got.conversion_rows, 4, c, "conversion-table")
                                failed
                                ok evidence table_evidence => match call require_int(got.bound_exit, 1, c, "bounds")
                                    failed
                                    ok evidence bounds_evidence => match call require_int(got.url_cases, 5, c, "url-cases")
                                        failed
                                        ok evidence url_cases_evidence => match call require_int(got.datetime_cases, 7, c, "datetime-cases")
                                            failed
                                            ok evidence datetime_cases_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m05_045: "m05-045" => ok test_case("bundled/utilities-semantics", ["utilities", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("url-normalization"), check_ref("url-query"), check_ref("datetime-zone"), check_ref("datetime-locale"), check_ref("datetime-civil"), check_ref("conversion-table"), check_ref("bounds"), check_ref("url-cases"), check_ref("datetime-cases")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m05-045"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/utilities-semantics", ["utilities", "m05"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("url-normalization"), check_ref("url-query"), check_ref("datetime-zone"), check_ref("datetime-locale"), check_ref("datetime-civil"), check_ref("conversion-table"), check_ref("bounds"), check_ref("url-cases"), check_ref("datetime-cases")], callable case_body)
