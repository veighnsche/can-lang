fn check[] checks
    emits {}
    given
        str scope
    asserts
        m06_014: "m06-014" => ok [check("roundtrip", "live roundtrip prints [1,2,3,4]"), check("hmac", "live hmac prints the RFC 4231 tag vector"), check("ask-correct", "live ask with the correct password prints match"), check("ask-wrong", "live ask with a wrong password prints mismatch"), check("misuse-reject", "live misuse returns crypto::key_misuse"), check("tamper-reject", "live tamper returns crypto::decrypt_failed"), check("build-identity", "rebuild and relocated build keep the first build ID"), check("wrong-arg-reject", "argument-type mutation rejects with the type diagnostic"), check("missing-emits-reject", "missing-emits mutation rejects with the domain diagnostic"), check("mutation-argtype-site", "argument-type mutation site pins the seal_size call"), check("mutation-emits-site", "missing-emits mutation site pins the seal_size emits")]
        other: "nope" => ok []
    match scope is "m06-014"
        false => ok []
        true => ok [check("roundtrip", "live roundtrip prints [1,2,3,4]"), check("hmac", "live hmac prints the RFC 4231 tag vector"), check("ask-correct", "live ask with the correct password prints match"), check("ask-wrong", "live ask with a wrong password prints mismatch"), check("misuse-reject", "live misuse returns crypto::key_misuse"), check("tamper-reject", "live tamper returns crypto::decrypt_failed"), check("build-identity", "rebuild and relocated build keep the first build ID"), check("wrong-arg-reject", "argument-type mutation rejects with the type diagnostic"), check("missing-emits-reject", "missing-emits mutation rejects with the domain diagnostic"), check("mutation-argtype-site", "argument-type mutation site pins the seal_size call"), check("mutation-emits-site", "missing-emits mutation site pins the seal_size emits")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "crypto/crypto-commands" => ok [expected_check("roundtrip", "[1,2,3,4]"), expected_check("hmac", "[176,52,76,97,216,219,56,83,92,168,175,206,175,11,241,43,136,29,194,0,201,131,61,167,38,233,55,108,46,50,207,247]"), expected_check("ask-correct", "match"), expected_check("ask-wrong", "mismatch"), expected_check("misuse-reject", "crypto::key_misuse"), expected_check("tamper-reject", "crypto::decrypt_failed"), expected_check("build-identity", "true"), expected_check("wrong-arg-reject", "expression type does not fit expected type"), expected_check("missing-emits-reject", "undeclared escaping domain error crypto::key_misuse"), expected_check("mutation-argtype-site", "match call bytes::from_ints(plaintext)"), expected_check("mutation-emits-site", "emits {codec::invalid_data, crypto::key_misuse}")]
        unknown: "nope" => ok []
    match case is "crypto/crypto-commands"
        false => ok []
        true => ok [expected_check("roundtrip", "[1,2,3,4]"), expected_check("hmac", "[176,52,76,97,216,219,56,83,92,168,175,206,175,11,241,43,136,29,194,0,201,131,61,167,38,233,55,108,46,50,207,247]"), expected_check("ask-correct", "match"), expected_check("ask-wrong", "mismatch"), expected_check("misuse-reject", "crypto::key_misuse"), expected_check("tamper-reject", "crypto::decrypt_failed"), expected_check("build-identity", "true"), expected_check("wrong-arg-reject", "expression type does not fit expected type"), expected_check("missing-emits-reject", "undeclared escaping domain error crypto::key_misuse"), expected_check("mutation-argtype-site", "match call bytes::from_ints(plaintext)"), expected_check("mutation-emits-site", "emits {codec::invalid_data, crypto::key_misuse}")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("crypto/crypto-commands", "default", "", "offline") => ok
        seed_roundtrip_drift: context("crypto/crypto-commands", "seed-roundtrip-drift", "", "offline") => failed{"roundtrip"}
        seed_hmac_drift: context("crypto/crypto-commands", "seed-hmac-drift", "", "offline") => failed{"hmac"}
        seed_ask_correct_drift: context("crypto/crypto-commands", "seed-ask-correct-drift", "", "offline") => failed{"ask-correct"}
        seed_ask_wrong_drift: context("crypto/crypto-commands", "seed-ask-wrong-drift", "", "offline") => failed{"ask-wrong"}
        seed_misuse_accepted: context("crypto/crypto-commands", "seed-misuse-accepted", "", "offline") => failed{"misuse-reject"}
        seed_tamper_accepted: context("crypto/crypto-commands", "seed-tamper-accepted", "", "offline") => failed{"tamper-reject"}
        seed_build_drift: context("crypto/crypto-commands", "seed-build-drift", "", "offline") => failed{"build-identity"}
        seed_argtype_admitted: context("crypto/crypto-commands", "seed-argtype-admitted", "", "offline") => failed{"wrong-arg-reject"}
        seed_emits_admitted: context("crypto/crypto-commands", "seed-emits-admitted", "", "offline") => failed{"missing-emits-reject"}
        seed_argtype_site_drift: context("crypto/crypto-commands", "seed-argtype-site-drift", "", "offline") => failed{"mutation-argtype-site"}
        seed_emits_site_drift: context("crypto/crypto-commands", "seed-emits-site-drift", "", "offline") => failed{"mutation-emits-site"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.roundtrip, "[1,2,3,4]", c, "roundtrip")
            failed
            ok evidence roundtrip_evidence => match call require_text(got.hmac, "[176,52,76,97,216,219,56,83,92,168,175,206,175,11,241,43,136,29,194,0,201,131,61,167,38,233,55,108,46,50,207,247]", c, "hmac")
                failed
                ok evidence hmac_evidence => match call require_text(got.ask_correct, "match", c, "ask-correct")
                    failed
                    ok evidence correct_evidence => match call require_text(got.ask_wrong, "mismatch", c, "ask-wrong")
                        failed
                        ok evidence wrong_evidence => match call require_text(got.misuse_reject, "crypto::key_misuse", c, "misuse-reject")
                            failed
                            ok evidence misuse_evidence => match call require_text(got.tamper_reject, "crypto::decrypt_failed", c, "tamper-reject")
