package m06core014crypto
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M06 CORE-014 "crypto commands: live outputs, build identity, rejects".
/// Source: tests/integration/crypto_test.go symbol
/// TestCurrentCryptoCommands (L49-245).
/// Related fixture: compiler/testdata/current/crypto/commands.can (read at
/// L28 and L162, staged as src/main.can at L46); the live-output pins
/// ground the main dispatch arms (roundtrip L81-95, hmac L96-106, misuse
/// L107-117, tamper L118-134, ask L135-155) and the assert vectors
/// (hmac_tag L11, check_password L26-27).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): live native command outputs (roundtrip, hmac,
/// ask correct/wrong, misuse and tamper domain errors), deterministic
/// build identity across rebuild and relocation, and the two negative
/// source mutations (wrong argument type, missing emits) with their
/// mutation sites.
/// The roots-green pin lives in core-014-roots-green.can; the production
/// process shape lives in core-014-run-shape.can.
/// Variants: roundtrip, hmac, ask correct/wrong, misuse, tamper (Go
/// L238-243); two negative source mutations (Go L166-173).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_TSC/CAN_BUN gate the optional
/// strict tsc leg (pinned conditional in the run-shape file). Logical gates
/// SUITE/WORK/PROC/N1 and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 240000ms mirrors the Go 4-minute ctx (L57).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QN1 unmet).
/// Case crypto/crypto-commands checks: roundtrip, hmac, ask-correct,
/// ask-wrong, misuse-reject, tamper-reject, build-identity,
/// wrong-arg-reject, missing-emits-reject, mutation-argtype-site,
/// mutation-emits-site.
/// Facet map (crypto_test.go legs): roundtrip pins the sealed roundtrip
/// output (L238: "[1,2,3,4]"; fixture L83-88); hmac pins the RFC 4231 tag
/// (L239: the 32-byte vector; fixture L11 rfc4231, JSON-compacted);
/// ask-correct pins "match" (L242: ask "correct horse"; fixture L151 and
/// L26 hit); ask-wrong pins "mismatch" (L243: ask "wrong"; fixture L145
/// and L27 miss); misuse-reject pins crypto::key_misuse (L240 fault;
/// fixture L110/L116: sign_ed25519 with an AES key); tamper-reject pins
/// crypto::decrypt_failed (L241 fault; fixture L124-125/L133: decrypt
/// with the wrong key); build-identity pins deterministic identity
/// (L111-123: rebuild and relocated build keep the first build ID);
/// wrong-arg-reject pins the argument-type diagnostic (L171/L184:
/// "expression type does not fit expected type");
/// missing-emits-reject pins the missing-emits diagnostic (L172/L184:
/// "undeclared escaping domain error crypto::key_misuse");
/// mutation-argtype-site pins the first mutation site (fixture L59;
/// Go L171 find needle); mutation-emits-site pins the second mutation
/// site (fixture L53; Go L172 find needle). The emitted-wiring needles
/// (L128-155) and the optional tsc leg (L156-161) need a built bundle
/// and stay blocked, never waived.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str roundtrip
    str hmac
    str ask_correct
    str ask_wrong
    str misuse_reject
    str tamper_reject
    bool build_identity
    str wrong_arg_reject
    str missing_emits_reject
    str mutation_argtype_site
    str mutation_emits_site
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("crypto/crypto-commands", "default", "", "offline"), "roundtrip" => ok "case crypto/crypto-commands variant default root roundtrip run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("crypto/crypto-commands", "default", "", "offline"), "build-identity" => ok evidence("build-identity", "true", "true", true, "case crypto/crypto-commands variant default root build-identity run offline")
        different: false, true, context("crypto/crypto-commands", "default", "", "offline"), "build-identity" => failed{"build-identity"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("crypto/crypto-commands", "default", "", "offline"), "live-checks" => ok evidence("live-checks", "6", "6", true, "case crypto/crypto-commands variant default root live-checks run offline")
        different: 5, 6, context("crypto/crypto-commands", "default", "", "offline"), "live-checks" => failed{"live-checks"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "[1,2,3,4]", "[1,2,3,4]", context("crypto/crypto-commands", "default", "", "offline"), "roundtrip" => ok evidence("roundtrip", "[1,2,3,4]", "[1,2,3,4]", true, "case crypto/crypto-commands variant default root roundtrip run offline")
        different: "[1,2,3,5]", "[1,2,3,4]", context("crypto/crypto-commands", "default", "", "offline"), "roundtrip" => failed{"roundtrip"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
