package m06core014run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M06 CORE-014 "crypto commands: run shape, ok/fault process split".
/// Source: tests/integration/crypto_test.go symbol
/// TestCurrentCryptoCommands (L49-245).
/// Related fixture: compiler/testdata/current/crypto/commands.can main
/// dispatch (L79-169); the live run helper (L198-220) executes the built
/// entry.ts directly with an empty fd-3 environment snapshot (L188-197)
/// while assert/build go through the sandboxed runAt helper (L68-87).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the live native
/// commands. Unlike rows with a silent entry, crypto main emits command
/// output by design (the crypto-commands file pins every stdout), so the
/// silence pins land where silence holds: ok commands exit 0 with empty
/// stderr, fault commands exit 1 with empty stdout. The entry also loads
/// silently under the empty fd-3 snapshot with no service.
/// The roots-green pin lives in core-014-roots-green.can; live outputs,
/// build identity and the negative mutations live in
/// core-014-crypto-commands.can.
/// Variants: ok path (roundtrip, hmac, ask correct/wrong) and fault path
/// (misuse, tamper); the optional CAN_TSC strict generated-TypeScript leg
/// (L156-161) is env-gated and recorded blocked, never waived.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 240000ms mirrors the Go 4-minute ctx (L57).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QN1 unmet).
/// Case crypto/commands-run checks: run-exit, run-stderr-empty,
/// fault-exit, fault-stdout-empty, snapshot-empty, sandbox-profile,
/// offline-ok, tsc-conditional.
/// Facet map (crypto_test.go legs): run-exit pins exit 0 on the ok path
/// (L226: status 0 or ok() fatals); run-stderr-empty pins empty stderr
/// on the ok path (L226: diag must be ""); fault-exit pins exit 1 on
/// the fault path (L234: status 1 or fault() fatals);
/// fault-stdout-empty pins empty stdout on the fault path (L234: out
/// must be ""); snapshot-empty pins the empty fd-3 snapshot (L195:
/// snapshot.json holds "{}"; L208: passed as fd 3); sandbox-profile
/// pins the offline invocation shape (L71: "(version 1)(allow
/// default)(deny network*)" verbatim); offline-ok pins the offline
/// behavior (L73-75/L88-89: the sandboxed deny-network assert/build
/// with PATH=/nonexistent succeeds); tsc-conditional pins the optional
/// leg (L156-161: strict tsc over emitted dist TypeScript via CAN_BUN
/// runs if and only if CAN_TSC is set).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stderr_empty
    int fault_exit
    bool fault_stdout_empty
    str snapshot_empty
    str sandbox_profile
    bool offline_ok
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("crypto/commands-run", "default", "", "offline"), "run-exit" => ok "case crypto/commands-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("crypto/commands-run", "default", "", "offline"), "run-stderr-empty" => ok evidence("run-stderr-empty", "true", "true", true, "case crypto/commands-run variant default root run-stderr-empty run offline")
        different: false, true, context("crypto/commands-run", "default", "", "offline"), "run-stderr-empty" => failed{"run-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("crypto/commands-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case crypto/commands-run variant default root run-exit run offline")
        different: 1, 0, context("crypto/commands-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("crypto/commands-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case crypto/commands-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("crypto/commands-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
        seed_run_red: "seed-run-red" => ok observation(1, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
        seed_stderr_noisy: "seed-stderr-noisy" => ok observation(0, false, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
        seed_fault_green: "seed-fault-green" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
        seed_fault_noisy: "seed-fault-noisy" => ok observation(0, true, 1, false, "{}", "(version 1)(allow default)(deny network*)", true, true)
        seed_snapshot_drift: "seed-snapshot-drift" => ok observation(0, true, 1, true, "[]", "(version 1)(allow default)(deny network*)", true, true)
        seed_profile_drift: "seed-profile-drift" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)", true, true)
        seed_offline_fail: "seed-offline-fail" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", false, true)
        seed_tsc_unconditional: "seed-tsc-unconditional" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, false)
    match variant_id
        "seed-run-red" => ok observation(1, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
        "seed-stderr-noisy" => ok observation(0, false, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
        "seed-fault-green" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
        "seed-fault-noisy" => ok observation(0, true, 1, false, "{}", "(version 1)(allow default)(deny network*)", true, true)
        "seed-snapshot-drift" => ok observation(0, true, 1, true, "[]", "(version 1)(allow default)(deny network*)", true, true)
        "seed-profile-drift" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)", true, true)
        "seed-offline-fail" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", false, true)
        "seed-tsc-unconditional" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, false)
        _ => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m06_014: "m06-014" => ok [check("run-exit", "live ok commands exit 0"), check("run-stderr-empty", "live ok commands keep stderr empty"), check("fault-exit", "live fault commands exit 1"), check("fault-stdout-empty", "live fault commands keep stdout empty"), check("snapshot-empty", "entries consume the empty fd-3 snapshot"), check("sandbox-profile", "assert/build invocation pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed assert/build succeeds"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
        other: "nope" => ok []
    match scope is "m06-014"
        false => ok []
        true => ok [check("run-exit", "live ok commands exit 0"), check("run-stderr-empty", "live ok commands keep stderr empty"), check("fault-exit", "live fault commands exit 1"), check("fault-stdout-empty", "live fault commands keep stdout empty"), check("snapshot-empty", "entries consume the empty fd-3 snapshot"), check("sandbox-profile", "assert/build invocation pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed assert/build succeeds"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "crypto/commands-run" => ok [expected_check("run-exit", "0"), expected_check("run-stderr-empty", "true"), expected_check("fault-exit", "1"), expected_check("fault-stdout-empty", "true"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("tsc-conditional", "true")]
        unknown: "nope" => ok []
    match case is "crypto/commands-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stderr-empty", "true"), expected_check("fault-exit", "1"), expected_check("fault-stdout-empty", "true"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("tsc-conditional", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("crypto/commands-run", "default", "", "offline") => ok
        seed_run_red: context("crypto/commands-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stderr_noisy: context("crypto/commands-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_fault_green: context("crypto/commands-run", "seed-fault-green", "", "offline") => failed{"fault-exit"}
        seed_fault_noisy: context("crypto/commands-run", "seed-fault-noisy", "", "offline") => failed{"fault-stdout-empty"}
        seed_snapshot_drift: context("crypto/commands-run", "seed-snapshot-drift", "", "offline") => failed{"snapshot-empty"}
        seed_profile_drift: context("crypto/commands-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_fail: context("crypto/commands-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
        seed_tsc_unconditional: context("crypto/commands-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                failed
                ok evidence stderr_evidence => match call require_int(got.fault_exit, 1, c, "fault-exit")
                    failed
                    ok evidence fault_evidence => match call require_bool(got.fault_stdout_empty, true, c, "fault-stdout-empty")
                        failed
                        ok evidence stdout_evidence => match call require_text(got.snapshot_empty, "{}", c, "snapshot-empty")
                            failed
                            ok evidence snapshot_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                failed
                                ok evidence profile_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                                    failed
                                    ok evidence offline_evidence => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                        failed
                                        ok evidence tsc_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m06_014: "m06-014" => ok test_case("crypto/commands-run", ["crypto", "m06"], ["can-bun-archive", "macos-sandbox-exec"], 240000, [check_ref("run-exit"), check_ref("run-stderr-empty"), check_ref("fault-exit"), check_ref("fault-stdout-empty"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("tsc-conditional")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m06-014"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("crypto/commands-run", ["crypto", "m06"], ["can-bun-archive", "macos-sandbox-exec"], 240000, [check_ref("run-exit"), check_ref("run-stderr-empty"), check_ref("fault-exit"), check_ref("fault-stdout-empty"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("tsc-conditional")], callable case_body)
