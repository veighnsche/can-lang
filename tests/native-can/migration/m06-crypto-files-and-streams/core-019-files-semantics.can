package m06core019files
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M06 CORE-019 "bundled files: native semantics, suite, live tree, rejects".
/// Source: tests/integration/files_test.go symbol
/// TestCurrentBundledFiles (L64-199).
/// Related source: runtime/test/files.test.ts (DELEGATE-012, 15 test roots
/// at L121/137/164/185/199/218/252/276/307/333/351/369/414/423/451; every
/// signature pin below comes from those roots) and the inline live program
/// template filesLiveProgramTmpl (Go L18-62, staged as src/main.can).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): native file bytes/text, errors, limits,
/// exclusive create, symlinks, list/copy/move/remove/glob/path and
/// unsupplied-assertion isolation (one signature pin per staged case);
/// the staged 15-case suite gate; Can live file tree writes and reads;
/// wrong type, unhandled error and unknown operation rejects with source
/// diagnostics; generated code uses native file operations.
/// The roots-green pin lives in core-019-roots-green.can; the production
/// process shape lives in core-019-run-shape.can.
/// Variants: 15 runtime cases (Go L77-82), live file tree (Go L123-151),
/// three rejection programs (Go L152-175).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 180000ms mirrors the Go 3-minute ctx (L70).
/// Delegated oracles: DELEGATE-012 (runtime/test/files.test.ts,
/// read-only record; 15 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case files/files-semantics checks: bytes-text, missing-denied,
/// limits-paths, over-cap, exclusive-create, missing-parents,
/// kind-errors, symlink-stat, list, copy-move, remove, glob, path,
/// isolation, classify, runtime-pass, runtime-fail, case-count,
/// live-disk, live-note, wrong-type-reject, unhandled-reject,
/// unknown-op-reject, unhandled-arm, reject-span, lower-write-text,
/// lower-read-text, lower-join, lower-create-reads, lower-bun-file,
/// lower-glob, lower-fs, lower-path.
/// Facet map (files.test.ts roots + files_test.go legs): bytes-text pins
/// the binary vector (L130: [0, 255, 1]; write L124; strict text rejects
/// with utf8 L131; text round-trip L133-134); missing-denied pins
/// files::not_found (L140-146 reads/stat/list/glob/remove; exists false
/// L143; denied never reports absence L152-158); limits-paths pins
/// files::limit_exceeded (L167-169 negative limits; ghost untouched L170;
/// invalid_path empty/nul_byte across all 9 ops L171-182); over-cap pins
/// the rejecting limit 999 (L189 on the 1000-byte file; exact 1000 ok
/// L190-191; huge 10n**100n ok L192; 0n rejects non-empty L193 but reads
/// the empty file L196); exclusive-create pins files::already_exists
/// (L203 second writer; overwrite ok L204-205; 10-racer single winner
/// L207-212; copy dup L214-215); missing-parents pins nodir (L220 write
/// fails; nodir never created L223; mkdir non-recursive L224, root
/// exists L225, recursive ok L226-227; copy/move missing ends L230-249);
/// kind-errors pins files::unexpected_kind (read_bytes L256, read_text
/// L260, list L263, copy L268, each with the operation payload);
/// symlink-stat pins symlink (L291/L299 no-follow kind; file with follow
/// L295; size 5n L287; dangling follow not_found L300; dangling exists
/// true L303); list pins the first sorted entry a.txt (L318: first of the
/// absolute sorted entries L317-322; kinds L323-328; entry identity L329;
/// limit 2 rejects L330);
/// copy-move pins payload (L337-340 round-trip; copy dup rejects L341;
/// move relocates L343-345; move overwrite gate L346-348); remove pins
/// files::not_empty (L358; tree survives L359; link/file/sub removal
/// L360-363; recursive removes tree L364-365; root survives L366); glob
/// pins *.txt (L378-380; recursive without follow L381-383; ** adds sub
/// L384-391; follow adds linkdir L392-400; * skips dotfiles L401-409; .*
/// pins .dot L410; limit rejects L411); path pins /a/b/c/d (L415 resolve;
/// dotdot L416; join L417; basename L418-419; extension L420-421);
/// isolation pins the 10 unsupplied calls (L426-437
/// read/write/stat/exists/list/mkdir/copy/move/remove/glob, all failing
/// L444; ghost and d untouched L446-447; pure path resolve ok L448);
/// classify pins cross_device (L464 EXDEV; EACCES denied L456, EBUSY
/// io_error L460, BOGUS undefined L468; TypeError/null/str/Proxy
/// undefined L452-455; validatePath L469-471; non-string arg standard
/// L472-473); runtime-pass/runtime-fail pin the staged gate (Go L80: 15
/// pass and 0 fail or the test fatals); case-count pins the 15 test()
/// roots (L121/137/164/185/199/218/252/276/307/333/351/369/414/423/451);
/// live-disk pins the independent disk bytes (Go L149: work/work/note.txt
/// reads live-data); live-note pins note.txt (template L36; Go L149);
/// wrong-type-reject pins the type diagnostic (Go L158-159:
/// read_bytes(123, 10)); unhandled-reject pins the arm diagnostic (Go
/// L160-161: read_bytes without arms); unknown-op-reject pins the call
/// diagnostic (Go L162-163: files::dance); unhandled-arm pins missing
/// completion arm (Go L161); reject-span pins main.can (Go
/// L159/L161/L163: every fixture); lower-write-text, lower-read-text,
/// lower-join, lower-create-reads, lower-bun-file, lower-glob, lower-fs
/// and lower-path pin the 8 native lowerings (Go L187/L194).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str bytes_text
    str missing_denied
    str limits_paths
    int over_cap_limit
    str exclusive_create
    str missing_parents
    str kind_errors
    str symlink_stat
    str list_first
    str copy_move
    str remove_err
    str glob_pattern
    str path_resolve
    int unsupplied_calls
    str classify_kind
    str runtime_pass
    str runtime_fail
    int case_count
    str live_disk
    str live_note
    str wrong_type_reject
    str unhandled_reject
    str unknown_op_reject
    str unhandled_arm
    str reject_span
    str lower_write_text
    str lower_read_text
    str lower_join
    str lower_create_reads
    str lower_bun_file
    str lower_glob
    str lower_fs
    str lower_path
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("files/files-semantics", "default", "", "offline"), "bytes-text" => ok "case files/files-semantics variant default root bytes-text run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("files/files-semantics", "default", "", "offline"), "bytes-text" => ok evidence("bytes-text", "true", "true", true, "case files/files-semantics variant default root bytes-text run offline")
        different: false, true, context("files/files-semantics", "default", "", "offline"), "bytes-text" => failed{"bytes-text"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 999, 999, context("files/files-semantics", "default", "", "offline"), "over-cap" => ok evidence("over-cap", "999", "999", true, "case files/files-semantics variant default root over-cap run offline")
        different: 998, 999, context("files/files-semantics", "default", "", "offline"), "over-cap" => failed{"over-cap"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "[0, 255, 1]", "[0, 255, 1]", context("files/files-semantics", "default", "", "offline"), "bytes-text" => ok evidence("bytes-text", "[0, 255, 1]", "[0, 255, 1]", true, "case files/files-semantics variant default root bytes-text run offline")
        different: "[0, 255, 2]", "[0, 255, 1]", context("files/files-semantics", "default", "", "offline"), "bytes-text" => failed{"bytes-text"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
