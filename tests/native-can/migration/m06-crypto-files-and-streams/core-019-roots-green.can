        true => ok test_case("files/bundled-roots", ["files", "m06"], ["can-bun-archive", "macos-sandbox-exec"], 180000, [check_ref("assert-green"), check_ref("report-passed"), check_ref("root-count"), check_ref("fixture-name"), check_ref("main-roots")], callable case_body)
