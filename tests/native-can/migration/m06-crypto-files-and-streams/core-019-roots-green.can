    asserts
        m06_019: "m06-019" => ok [check("assert-green", "canlc assert exits 0 with empty diagnostics"), check("report-passed", "assert report passes"), check("root-count", "assert report carries exactly 1 root"), check("fixture-name", "root pin grounds the staged src/main.can program"), check("main-roots", "main contributes 1 root (sample => ok)")]
        other: "nope" => ok []
