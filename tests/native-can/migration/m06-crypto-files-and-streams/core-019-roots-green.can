fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "files/bundled-roots" => ok [expected_check("assert-green", "true"), expected_check("report-passed", "true"), expected_check("root-count", "1"), expected_check("fixture-name", "src/main.can"), expected_check("main-roots", "1")]
        unknown: "nope" => ok []
    match case is "files/bundled-roots"
