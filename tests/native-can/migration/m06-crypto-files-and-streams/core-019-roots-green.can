/// M06 CORE-019 "bundled files: roots green, one assert root".
/// Source: tests/integration/files_test.go symbol
/// TestCurrentBundledFiles (L64-199).
/// Related source: the inline live program template filesLiveProgramTmpl
/// (Go L18-62), staged as src/main.can (Go L101); every count pin below
/// grounds the single sample assert in that template (main 1; total 1).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): canlc assert green with a passed report carrying
/// exactly 1 root, grounded in main of the staged live program.
/// File semantics, the staged 15-case suite, live-tree pins, the three
/// rejections and the native lowerings live in
/// core-019-files-semantics.can; the production process shape lives in
/// core-019-run-shape.can.
/// Variants: none in this file (default only); the 15 runtime cases, the
/// live file tree and the three rejection programs live in the
/// files-semantics file.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 180000ms mirrors the Go 3-minute ctx (L70).
/// Delegated oracles: DELEGATE-012 (runtime/test/files.test.ts,
/// read-only record; 15 declarations; not executed here).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case files/bundled-roots checks: assert-green, report-passed,
/// root-count, fixture-name, main-roots.
/// Facet map (files_test.go legs): assert-green pins the assert leg
/// (L134-137: status 0 and empty diagnostics or the test fatals);
/// report-passed pins the report leg (L142: passed true); root-count pins
/// the single root (L142: len assertions is 1); fixture-name grounds the
/// pin in the staged program (L101: src/main.can; template L18-62);
/// main-roots pins main (template L25-26: sample => ok, 1 root; the
/// when-sample clauses at template L30/L39/L47/L59 are fixtures, not
/// roots).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    str fixture_name
    int main_roots
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("files/bundled-roots", "default", "", "offline"), "assert-green" => ok "case files/bundled-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("files/bundled-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case files/bundled-roots variant default root assert-green run offline")
        different: false, true, context("files/bundled-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("files/bundled-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "1", "1", true, "case files/bundled-roots variant default root root-count run offline")
        different: 0, 1, context("files/bundled-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "src/main.can", "src/main.can", context("files/bundled-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "src/main.can", "src/main.can", true, "case files/bundled-roots variant default root fixture-name run offline")
        different: "src/other.can", "src/main.can", context("files/bundled-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, 1, "src/main.can", 1)
        seed_assert_red: "seed-assert-red" => ok observation(false, true, 1, "src/main.can", 1)
        seed_report_red: "seed-report-red" => ok observation(true, false, 1, "src/main.can", 1)
        seed_root_short: "seed-root-short" => ok observation(true, true, 0, "src/main.can", 1)
        seed_fixture_drift: "seed-fixture-drift" => ok observation(true, true, 1, "src/other.can", 1)
        seed_main_loss: "seed-main-loss" => ok observation(true, true, 1, "src/main.can", 0)
    match variant_id
        "seed-assert-red" => ok observation(false, true, 1, "src/main.can", 1)
        "seed-report-red" => ok observation(true, false, 1, "src/main.can", 1)
        "seed-root-short" => ok observation(true, true, 0, "src/main.can", 1)
        "seed-fixture-drift" => ok observation(true, true, 1, "src/other.can", 1)
        "seed-main-loss" => ok observation(true, true, 1, "src/main.can", 0)
        _ => ok observation(true, true, 1, "src/main.can", 1)
