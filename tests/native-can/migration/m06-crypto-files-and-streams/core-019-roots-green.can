        true => ok [expected_check("assert-green", "true"), expected_check("report-passed", "true"), expected_check("root-count", "1"), expected_check("fixture-name", "src/main.can"), expected_check("main-roots", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("files/bundled-roots", "default", "", "offline") => ok
        seed_assert_red: context("files/bundled-roots", "seed-assert-red", "", "offline") => failed{"assert-green"}
        seed_report_red: context("files/bundled-roots", "seed-report-red", "", "offline") => failed{"report-passed"}
        seed_root_short: context("files/bundled-roots", "seed-root-short", "", "offline") => failed{"root-count"}
        seed_fixture_drift: context("files/bundled-roots", "seed-fixture-drift", "", "offline") => failed{"fixture-name"}
        seed_main_loss: context("files/bundled-roots", "seed-main-loss", "", "offline") => failed{"main-roots"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.assert_green, true, c, "assert-green")
            failed
            ok evidence report_passed_evidence => match call require_bool(got.report_passed, true, c, "report-passed")
                failed
                ok evidence root_count_evidence => match call require_int(got.root_count, 1, c, "root-count")
                    failed
                    ok evidence fixture_name_evidence => match call require_text(got.fixture_name, "src/main.can", c, "fixture-name")
                        failed
                        ok evidence main_roots_evidence => match call require_int(got.main_roots, 1, c, "main-roots")
                            failed
                            ok evidence main_roots_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m06_019: "m06-019" => ok test_case("files/bundled-roots", ["files", "m06"], ["can-bun-archive", "macos-sandbox-exec"], 180000, [check_ref("assert-green"), check_ref("report-passed"), check_ref("root-count"), check_ref("fixture-name"), check_ref("main-roots")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m06-019"
