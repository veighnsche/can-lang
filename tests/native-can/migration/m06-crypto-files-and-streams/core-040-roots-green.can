    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    str fixture_name
    int pump_roots
    int main_roots
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("streams/pump-roots", "default", "", "offline"), "assert-green" => ok "case streams/pump-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("streams/pump-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case streams/pump-roots variant default root assert-green run offline")
        different: false, true, context("streams/pump-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("streams/pump-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "3", "3", true, "case streams/pump-roots variant default root root-count run offline")
        different: 2, 3, context("streams/pump-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "src/main.can", "src/main.can", context("streams/pump-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "src/main.can", "src/main.can", true, "case streams/pump-roots variant default root fixture-name run offline")
        different: "src/other.can", "src/main.can", context("streams/pump-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, 3, "src/main.can", 2, 1)
        seed_assert_red: "seed-assert-red" => ok observation(false, true, 3, "src/main.can", 2, 1)
        seed_report_red: "seed-report-red" => ok observation(true, false, 3, "src/main.can", 2, 1)
        seed_root_short: "seed-root-short" => ok observation(true, true, 2, "src/main.can", 2, 1)
        seed_fixture_drift: "seed-fixture-drift" => ok observation(true, true, 3, "src/other.can", 2, 1)
        seed_pump_short: "seed-pump-short" => ok observation(true, true, 3, "src/main.can", 1, 1)
        seed_main_loss: "seed-main-loss" => ok observation(true, true, 3, "src/main.can", 2, 0)
    match variant_id
        "seed-assert-red" => ok observation(false, true, 3, "src/main.can", 2, 1)
        "seed-report-red" => ok observation(true, false, 3, "src/main.can", 2, 1)
        "seed-root-short" => ok observation(true, true, 2, "src/main.can", 2, 1)
        "seed-fixture-drift" => ok observation(true, true, 3, "src/other.can", 2, 1)
        "seed-pump-short" => ok observation(true, true, 3, "src/main.can", 1, 1)
        "seed-main-loss" => ok observation(true, true, 3, "src/main.can", 2, 0)
        _ => ok observation(true, true, 3, "src/main.can", 2, 1)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m06_040: "m06-040" => ok [check("assert-green", "canlc assert exits 0 with empty diagnostics"), check("report-passed", "assert report passes"), check("root-count", "assert report carries exactly 3 roots"), check("fixture-name", "root pins ground the staged src/main.can program"), check("pump-roots", "pump contributes 2 roots (end/more)"), check("main-roots", "main contributes 1 root (sample => ok)")]
        other: "nope" => ok []
    match scope is "m06-040"
