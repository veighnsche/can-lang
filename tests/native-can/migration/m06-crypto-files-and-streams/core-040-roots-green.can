        true => ok [expected_check("assert-green", "true"), expected_check("report-passed", "true"), expected_check("root-count", "3"), expected_check("fixture-name", "src/main.can"), expected_check("pump-roots", "2"), expected_check("main-roots", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("streams/pump-roots", "default", "", "offline") => ok
        seed_assert_red: context("streams/pump-roots", "seed-assert-red", "", "offline") => failed{"assert-green"}
        seed_report_red: context("streams/pump-roots", "seed-report-red", "", "offline") => failed{"report-passed"}
        seed_root_short: context("streams/pump-roots", "seed-root-short", "", "offline") => failed{"root-count"}
        seed_fixture_drift: context("streams/pump-roots", "seed-fixture-drift", "", "offline") => failed{"fixture-name"}
        seed_pump_short: context("streams/pump-roots", "seed-pump-short", "", "offline") => failed{"pump-roots"}
        seed_main_loss: context("streams/pump-roots", "seed-main-loss", "", "offline") => failed{"main-roots"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.assert_green, true, c, "assert-green")
            failed
            ok evidence assert_evidence => match call require_bool(got.report_passed, true, c, "report-passed")
                failed
                ok evidence passed_evidence => match call require_int(got.root_count, 3, c, "root-count")
                    failed
                    ok evidence count_evidence => match call require_text(got.fixture_name, "src/main.can", c, "fixture-name")
                        failed
                        ok evidence fixture_evidence => match call require_int(got.pump_roots, 2, c, "pump-roots")
                            failed
                            ok evidence pump_evidence => match call require_int(got.main_roots, 1, c, "main-roots")
                                failed
                                ok evidence main_evidence => ok
