        true => ok test_case("streams/pump-roots", ["streams", "m06"], ["can-bun-archive", "macos-sandbox-exec"], 180000, [check_ref("assert-green"), check_ref("report-passed"), check_ref("root-count"), check_ref("fixture-name"), check_ref("pump-roots"), check_ref("main-roots")], callable case_body)
