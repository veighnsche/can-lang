        true => ok [check("assert-green", "canlc assert exits 0 with empty diagnostics"), check("report-passed", "assert report passes"), check("root-count", "assert report carries exactly 3 roots"), check("fixture-name", "root pins ground the staged src/main.can program"), check("pump-roots", "pump contributes 2 roots (end/more)"), check("main-roots", "main contributes 1 root (sample => ok)")]
