package m06core040run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M06 CORE-040 "bundled streams: run shape, live entry prints 2".
/// Source: tests/integration/streams_test.go symbol
/// TestCurrentBundledStreams (L196-339).
/// Related fixture: the inline streamsLiveProgramTmpl const (L59-129),
/// staged as src/main.can at L233 and executed through the run helper
/// (L236-254: /usr/bin/sandbox-exec with the deny-network profile,
/// PATH=/nonexistent, fresh temp HOME).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the live native
/// stream tree. ADAPTATION (documented, not silent-entry): unlike rows
/// with a silent entry, the streams live main prints the line count by
/// design (L291 pins stdout "2": first.length + rest.length over the
/// ["l1","l2"] + [] transcripts), so this row has no silent (exit 0,
/// empty stdout, empty stderr) production path; the stdout text pin lands
/// here as run-stdout "2" and the silence pin lands where silence holds
/// (run-stderr-empty). No run-stdout-empty/entry-silent pins are authored
/// because they would contradict the Go live-output assertion. The same
/// "2" ground truth is pinned once more as live-output in
/// core-040-streams-semantics.can (live-tree variant); both pins cite Go
/// L291 and the files stay self-contained.
/// The pump roots-green pin lives in core-040-roots-green.can; runtime
/// cases, live assert/disk legs, transcript bounds and the four
/// rejections live in core-040-streams-semantics.can.
/// Variants: live tree only (default); no fault path, no tsc leg.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 180000ms mirrors the Go 3-minute ctx (L202).
/// Delegated oracles: none in this file (DELEGATE-021 belongs to the
/// streams-semantics file).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case streams/stream-run checks: run-exit, run-stdout, run-stderr-empty,
/// sandbox-profile, offline-ok.
/// Facet map (streams_test.go legs): run-exit pins exit 0 on the live run
/// (L291: status 0 or the test fatals); run-stdout pins the live line
/// count (L291: out must be "2"; L122/L124-128: the entry prints
/// first.length + rest.length); run-stderr-empty pins empty stderr (L291:
/// diag must be ""); sandbox-profile pins the offline invocation shape
/// (L238: "(version 1)(allow default)(deny network*)" verbatim);
/// offline-ok pins the offline behavior (L236-254: the sandboxed
/// deny-network run with PATH=/nonexistent succeeds).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    str run_stdout
    bool run_stderr_empty
    str sandbox_profile
    bool offline_ok
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("streams/stream-run", "default", "", "offline"), "run-exit" => ok "case streams/stream-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("streams/stream-run", "default", "", "offline"), "run-stderr-empty" => ok evidence("run-stderr-empty", "true", "true", true, "case streams/stream-run variant default root run-stderr-empty run offline")
        different: false, true, context("streams/stream-run", "default", "", "offline"), "run-stderr-empty" => failed{"run-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("streams/stream-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case streams/stream-run variant default root run-exit run offline")
        different: 1, 0, context("streams/stream-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("streams/stream-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case streams/stream-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("streams/stream-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, "2", true, "(version 1)(allow default)(deny network*)", true)
        seed_run_red: "seed-run-red" => ok observation(1, "2", true, "(version 1)(allow default)(deny network*)", true)
        seed_stdout_drift: "seed-stdout-drift" => ok observation(0, "3", true, "(version 1)(allow default)(deny network*)", true)
        seed_stderr_noisy: "seed-stderr-noisy" => ok observation(0, "2", false, "(version 1)(allow default)(deny network*)", true)
        seed_profile_drift: "seed-profile-drift" => ok observation(0, "2", true, "(version 1)(allow default)", true)
        seed_offline_fail: "seed-offline-fail" => ok observation(0, "2", true, "(version 1)(allow default)(deny network*)", false)
    match variant_id
        "seed-run-red" => ok observation(1, "2", true, "(version 1)(allow default)(deny network*)", true)
        "seed-stdout-drift" => ok observation(0, "3", true, "(version 1)(allow default)(deny network*)", true)
        "seed-stderr-noisy" => ok observation(0, "2", false, "(version 1)(allow default)(deny network*)", true)
        "seed-profile-drift" => ok observation(0, "2", true, "(version 1)(allow default)", true)
        "seed-offline-fail" => ok observation(0, "2", true, "(version 1)(allow default)(deny network*)", false)
        _ => ok observation(0, "2", true, "(version 1)(allow default)(deny network*)", true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m06_040: "m06-040" => ok [check("run-exit", "live run exits 0"), check("run-stdout", "live run prints the line count 2"), check("run-stderr-empty", "live run keeps stderr empty"), check("sandbox-profile", "run helper pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed run succeeds")]
        other: "nope" => ok []
    match scope is "m06-040"
        false => ok []
        true => ok [check("run-exit", "live run exits 0"), check("run-stdout", "live run prints the line count 2"), check("run-stderr-empty", "live run keeps stderr empty"), check("sandbox-profile", "run helper pins the deny-network sandbox profile"), check("offline-ok", "offline sandboxed run succeeds")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "streams/stream-run" => ok [expected_check("run-exit", "0"), expected_check("run-stdout", "2"), expected_check("run-stderr-empty", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true")]
        unknown: "nope" => ok []
    match case is "streams/stream-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stdout", "2"), expected_check("run-stderr-empty", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("streams/stream-run", "default", "", "offline") => ok
        seed_run_red: context("streams/stream-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stdout_drift: context("streams/stream-run", "seed-stdout-drift", "", "offline") => failed{"run-stdout"}
        seed_stderr_noisy: context("streams/stream-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_profile_drift: context("streams/stream-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_fail: context("streams/stream-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_text(got.run_stdout, "2", c, "run-stdout")
                failed
                ok evidence stdout_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                    failed
                    ok evidence stderr_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                        failed
                        ok evidence profile_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                            failed
                            ok evidence offline_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m06_040: "m06-040" => ok test_case("streams/stream-run", ["streams", "m06"], ["can-bun-archive", "macos-sandbox-exec"], 180000, [check_ref("run-exit"), check_ref("run-stdout"), check_ref("run-stderr-empty"), check_ref("sandbox-profile"), check_ref("offline-ok")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m06-040"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("streams/stream-run", ["streams", "m06"], ["can-bun-archive", "macos-sandbox-exec"], 180000, [check_ref("run-exit"), check_ref("run-stdout"), check_ref("run-stderr-empty"), check_ref("sandbox-profile"), check_ref("offline-ok")], callable case_body)
