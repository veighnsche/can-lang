fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("streams/stream-semantics", "default", "", "offline") => ok
        seed_order_scrambled: context("streams/stream-semantics", "seed-order-scrambled", "", "offline") => failed{"order"}
        seed_framing_loss: context("streams/stream-semantics", "seed-framing-loss", "", "offline") => failed{"utf8-framing"}
        seed_caps_admitted: context("streams/stream-semantics", "seed-caps-admitted", "", "offline") => failed{"caps"}
        seed_cancel_lost: context("streams/stream-semantics", "seed-cancel-lost", "", "offline") => failed{"cancellation"}
        seed_close_admitted: context("streams/stream-semantics", "seed-close-admitted", "", "offline") => failed{"close-failure"}
        seed_copy_aliasing: context("streams/stream-semantics", "seed-copy-aliasing", "", "offline") => failed{"copy"}
        seed_pass_short: context("streams/stream-semantics", "seed-pass-short", "", "offline") => failed{"eleven-pass"}
        seed_fail_noisy: context("streams/stream-semantics", "seed-fail-noisy", "", "offline") => failed{"zero-fail"}
        seed_live_assert_red: context("streams/stream-semantics", "seed-live-assert-red", "", "offline") => failed{"live-assert-green"}
        seed_live_report_red: context("streams/stream-semantics", "seed-live-report-red", "", "offline") => failed{"live-report-passed"}
        seed_live_root_short: context("streams/stream-semantics", "seed-live-root-short", "", "offline") => failed{"live-root-count"}
        seed_live_output_drift: context("streams/stream-semantics", "seed-live-output-drift", "", "offline") => failed{"live-output"}
        seed_disk_drift: context("streams/stream-semantics", "seed-disk-drift", "", "offline") => failed{"live-disk-bytes"}
        seed_overrun_admitted: context("streams/stream-semantics", "seed-overrun-admitted", "", "offline") => failed{"overrun-reject"}
        seed_underrun_admitted: context("streams/stream-semantics", "seed-underrun-admitted", "", "offline") => failed{"underrun-reject"}
        seed_wrong_type_admitted: context("streams/stream-semantics", "seed-wrong-type-admitted", "", "offline") => failed{"wrong-type-reject"}
        seed_missing_arm_admitted: context("streams/stream-semantics", "seed-missing-arm-admitted", "", "offline") => failed{"missing-arm-reject"}
        seed_arm_detail_drift: context("streams/stream-semantics", "seed-arm-detail-drift", "", "offline") => failed{"missing-arm-detail"}
        seed_binding_admitted: context("streams/stream-semantics", "seed-binding-admitted", "", "offline") => failed{"result-binding-reject"}
        seed_unknown_op_admitted: context("streams/stream-semantics", "seed-unknown-op-admitted", "", "offline") => failed{"unknown-op-reject"}
        seed_span_drift: context("streams/stream-semantics", "seed-span-drift", "", "offline") => failed{"reject-span"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.order_chunks, "[[1, 2], [3, 4], [5]]", c, "order")
            failed
            ok evidence order_evidence => match call require_text(got.utf8_framing, "[\"one\", \"two\", \"€\", \"partial\"]", c, "utf8-framing")
                failed
                ok evidence framing_evidence => match call require_text(got.caps_domain, "files::limit_exceeded", c, "caps")
                    failed
                    ok evidence caps_evidence => match call require_text(got.cancel_domain, "stream::cancelled", c, "cancellation")
                        failed
                        ok evidence cancel_evidence => match call require_text(got.close_failure, "resource_state", c, "close-failure")
                            failed
                            ok evidence close_evidence => match call require_text(got.copy_bytes, "[10, 20]", c, "copy")
                                failed
                                ok evidence copy_evidence => match call require_text(got.eleven_pass, "11 pass", c, "eleven-pass")
                                    failed
                                    ok evidence pass_evidence => match call require_text(got.zero_fail, "0 fail", c, "zero-fail")
                                        failed
                                        ok evidence fail_evidence => match call require_bool(got.live_assert_green, true, c, "live-assert-green")
                                            failed
                                            ok evidence assert_evidence => match call require_bool(got.live_report_passed, true, c, "live-report-passed")
                                                failed
                                                ok evidence passed_evidence => match call require_int(got.live_root_count, 1, c, "live-root-count")
                                                    failed
                                                    ok evidence count_evidence => match call require_text(got.live_output, "2", c, "live-output")
                                                        failed
                                                        ok evidence output_evidence => match call require_text(got.live_disk_bytes, "l1\nl2\n", c, "live-disk-bytes")
                                                            failed
                                                            ok evidence disk_evidence => match call require_text(got.overrun_reject, "unused fixture", c, "overrun-reject")
                                                                failed
                                                                ok evidence overrun_evidence => match call require_text(got.underrun_reject, "missing fixture", c, "underrun-reject")
                                                                    failed
                                                                    ok evidence underrun_evidence => match call require_text(got.wrong_type_reject, "inference shape mismatch", c, "wrong-type-reject")
                                                                        failed
                                                                        ok evidence type_evidence => match call require_text(got.missing_arm_reject, "missing completion arm", c, "missing-arm-reject")
                                                                            failed
                                                                            ok evidence arm_evidence => match call require_text(got.missing_arm_detail, "requires an arm for each bound member", c, "missing-arm-detail")
                                                                                failed
                                                                                ok evidence detail_evidence => match call require_text(got.result_binding_reject, "completion arm binding type mismatch", c, "result-binding-reject")
                                                                                    failed
                                                                                    ok evidence binding_evidence => match call require_text(got.unknown_op_reject, "no eligible call stream::dance", c, "unknown-op-reject")
                                                                                        failed
                                                                                        ok evidence op_evidence => match call require_text(got.reject_span, "main.can", c, "reject-span")
                                                                                            failed
                                                                                            ok evidence span_evidence => ok
