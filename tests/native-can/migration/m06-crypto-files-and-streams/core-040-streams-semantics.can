fn check[] checks
    emits {}
    given
        str scope
    asserts
        m06_040: "m06-040" => ok [check("order", "byte chunks preserve order [[1,2],[3,4],[5]] with exact end"), check("utf8-framing", "lines frame CRLF/trailing/split UTF-8; malformed fails"), check("caps", "line over cap reports files::limit_exceeded once and ends"), check("cancellation", "cancel during pending read reports stream::cancelled"), check("close-failure", "close misuse throws resource-state; failures report once"), check("copy", "boundary copies detach both directions ([10,20])"), check("eleven-pass", "staged suite reports 11 pass"), check("zero-fail", "staged suite reports 0 fail"), check("live-assert-green", "live assert exits 0 with empty diagnostics"), check("live-report-passed", "live assert report passes"), check("live-root-count", "live assert report carries exactly 1 root"), check("live-output", "live run prints 2"), check("live-disk-bytes", "live tree writes l1/l2 bytes to disk"), check("overrun-reject", "overrun transcript rejects with unused fixture"), check("underrun-reject", "underrun transcript rejects with missing fixture"), check("wrong-type-reject", "wrong reader type rejects with inference mismatch"), check("missing-arm-reject", "unhandled error rejects with missing completion arm"), check("missing-arm-detail", "missing arm names the each-bound-member rule"), check("result-binding-reject", "wrong result binding rejects with binding mismatch"), check("unknown-op-reject", "unknown operation rejects with no eligible call"), check("reject-span", "rejections carry the main.can source span")]
        other: "nope" => ok []
    match scope is "m06-040"
        false => ok []
        true => ok [check("order", "byte chunks preserve order [[1,2],[3,4],[5]] with exact end"), check("utf8-framing", "lines frame CRLF/trailing/split UTF-8; malformed fails"), check("caps", "line over cap reports files::limit_exceeded once and ends"), check("cancellation", "cancel during pending read reports stream::cancelled"), check("close-failure", "close misuse throws resource-state; failures report once"), check("copy", "boundary copies detach both directions ([10,20])"), check("eleven-pass", "staged suite reports 11 pass"), check("zero-fail", "staged suite reports 0 fail"), check("live-assert-green", "live assert exits 0 with empty diagnostics"), check("live-report-passed", "live assert report passes"), check("live-root-count", "live assert report carries exactly 1 root"), check("live-output", "live run prints 2"), check("live-disk-bytes", "live tree writes l1/l2 bytes to disk"), check("overrun-reject", "overrun transcript rejects with unused fixture"), check("underrun-reject", "underrun transcript rejects with missing fixture"), check("wrong-type-reject", "wrong reader type rejects with inference mismatch"), check("missing-arm-reject", "unhandled error rejects with missing completion arm"), check("missing-arm-detail", "missing arm names the each-bound-member rule"), check("result-binding-reject", "wrong result binding rejects with binding mismatch"), check("unknown-op-reject", "unknown operation rejects with no eligible call"), check("reject-span", "rejections carry the main.can source span")]
