fn check[] checks
    emits {}
    given
        str scope
    asserts
        m07_018: "m07-018" => ok [check("eight-operations", "live run issues exactly 8 runtime requests and no assertion requests"), check("null-exchange", "unauthenticated raw fixture carries a null exchange"), check("methods", "per-operation methods pin GET,GET,POST,PUT,PATCH,HEAD,DELETE,OPTIONS"), check("query", "load_json query pins labels=a+b&labels=%2B with two values"), check("headers", "live requests carry X-Probe and X-Default and drop X-Omitted"), check("auth", "live requests carry the Bearer [REDACTED] credential"), check("body-media", "request bodies pin text, json and octet-stream media types"), check("bigint", "JSON count pins exact 9007199254740993"), check("status-fails", "status error mode fails with http::request_failed"), check("media-fails", "media error mode fails with http::request_failed"), check("charset-fails", "charset error mode fails with http::request_failed"), check("malformed-fails", "malformed error mode fails with http::request_failed"), check("envelope", "raw envelope pins status 418 with cookies and raw bytes"), check("invalid-header", "invalid computed header refuses with outcome mismatch"), check("header-before-credential", "header validation precedes credentials"), check("no-request-on-invalid", "invalid header launches no request")]
        other: "nope" => ok []
    match scope is "m07-018"
        false => ok []
        true => ok [check("eight-operations", "live run issues exactly 8 runtime requests and no assertion requests"), check("null-exchange", "unauthenticated raw fixture carries a null exchange"), check("methods", "per-operation methods pin GET,GET,POST,PUT,PATCH,HEAD,DELETE,OPTIONS"), check("query", "load_json query pins labels=a+b&labels=%2B with two values"), check("headers", "live requests carry X-Probe and X-Default and drop X-Omitted"), check("auth", "live requests carry the Bearer [REDACTED] credential"), check("body-media", "request bodies pin text, json and octet-stream media types"), check("bigint", "JSON count pins exact 9007199254740993"), check("status-fails", "status error mode fails with http::request_failed"), check("media-fails", "media error mode fails with http::request_failed"), check("charset-fails", "charset error mode fails with http::request_failed"), check("malformed-fails", "malformed error mode fails with http::request_failed"), check("envelope", "raw envelope pins status 418 with cookies and raw bytes"), check("invalid-header", "invalid computed header refuses with outcome mismatch"), check("header-before-credential", "header validation precedes credentials"), check("no-request-on-invalid", "invalid header launches no request")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/fetch-semantics" => ok [expected_check("eight-operations", "8"), expected_check("null-exchange", "true"), expected_check("methods", "GET,GET,POST,PUT,PATCH,HEAD,DELETE,OPTIONS"), expected_check("query", "labels=a+b&labels=%2B"), expected_check("headers", "true"), expected_check("auth", "Bearer [REDACTED]"), expected_check("body-media", "text/plain; charset=utf-8|application/json|application/octet-stream"), expected_check("bigint", "9007199254740993"), expected_check("status-fails", "true"), expected_check("media-fails", "true"), expected_check("charset-fails", "true"), expected_check("malformed-fails", "true"), expected_check("envelope", "418"), expected_check("invalid-header", "outcome mismatch"), expected_check("header-before-credential", "true"), expected_check("no-request-on-invalid", "true")]
        unknown: "nope" => ok []
    match case is "bundled/fetch-semantics"
        false => ok []
        true => ok [expected_check("eight-operations", "8"), expected_check("null-exchange", "true"), expected_check("methods", "GET,GET,POST,PUT,PATCH,HEAD,DELETE,OPTIONS"), expected_check("query", "labels=a+b&labels=%2B"), expected_check("headers", "true"), expected_check("auth", "Bearer [REDACTED]"), expected_check("body-media", "text/plain; charset=utf-8|application/json|application/octet-stream"), expected_check("bigint", "9007199254740993"), expected_check("status-fails", "true"), expected_check("media-fails", "true"), expected_check("charset-fails", "true"), expected_check("malformed-fails", "true"), expected_check("envelope", "418"), expected_check("invalid-header", "outcome mismatch"), expected_check("header-before-credential", "true"), expected_check("no-request-on-invalid", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/fetch-semantics", "default", "", "offline") => ok
        seed_seven_operations: context("bundled/fetch-semantics", "seed-seven-operations", "", "offline") => failed{"eight-operations"}
        seed_exchange_present: context("bundled/fetch-semantics", "seed-exchange-present", "", "offline") => failed{"null-exchange"}
        seed_methods_drift: context("bundled/fetch-semantics", "seed-methods-drift", "", "offline") => failed{"methods"}
        seed_query_drift: context("bundled/fetch-semantics", "seed-query-drift", "", "offline") => failed{"query"}
        seed_headers_red: context("bundled/fetch-semantics", "seed-headers-red", "", "offline") => failed{"headers"}
        seed_auth_drift: context("bundled/fetch-semantics", "seed-auth-drift", "", "offline") => failed{"auth"}
        seed_media_drift: context("bundled/fetch-semantics", "seed-media-drift", "", "offline") => failed{"body-media"}
        seed_bigint_short: context("bundled/fetch-semantics", "seed-bigint-short", "", "offline") => failed{"bigint"}
        seed_status_green: context("bundled/fetch-semantics", "seed-status-green", "", "offline") => failed{"status-fails"}
        seed_media_green: context("bundled/fetch-semantics", "seed-media-green", "", "offline") => failed{"media-fails"}
        seed_charset_green: context("bundled/fetch-semantics", "seed-charset-green", "", "offline") => failed{"charset-fails"}
        seed_malformed_green: context("bundled/fetch-semantics", "seed-malformed-green", "", "offline") => failed{"malformed-fails"}
        seed_envelope_drift: context("bundled/fetch-semantics", "seed-envelope-drift", "", "offline") => failed{"envelope"}
        seed_header_admitted: context("bundled/fetch-semantics", "seed-header-admitted", "", "offline") => failed{"invalid-header"}
