package m07core018fetch
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-018 "bundled fetch: live semantics, error modes, header gate".
/// Source: tests/integration/fetch_test.go symbol TestCurrentBundledFetch.
/// Related fixtures: compiler/testdata/current/fetch/main.can plus the raw
/// offline fixtures under compiler/testdata/current/fetch/fixtures (one per
/// operation plus the null-exchange load_json_unauthenticated.json).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the eight live operations plus the null exchange,
/// the live-server validation of method, query duplicate/order/encoding,
/// headers and auth, body media and the exact big integer, the four error
/// modes that must fail with http::request_failed, the raw 418 envelope,
/// and the invalid computed header that blocks before credentials with no
/// request launched.
/// The 20-root green pin lives in core-018-roots-green.can; the silent
/// production process shape lives in core-018-run-shape.can.
/// Variants: GET/PUT/POST/PATCH/HEAD/DELETE/OPTIONS per-operation methods
/// and the raw envelope; status/media/charset/malformed error modes; the
/// invalid-header mutation and the missing-credential gate (Go L271-287).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_I26_TOKEN is harness-supplied
/// (Go L99/L198: "test-only"), not an external gate. Logical gates
/// SUITE/DIAG/FAULT and C/R/N/S/A identities bind at P23/QHTTP; no live
/// run now. Descriptor timeout 300000ms mirrors the Go 5-minute ctx (L90).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/fetch-semantics checks: eight-operations, null-exchange,
/// methods, query, headers, auth, body-media, bigint, status-fails,
/// media-fails, charset-fails, malformed-fails, envelope, invalid-header,
/// header-before-credential, no-request-on-invalid.
/// Facet map (fetch_test.go legs): eight-operations pins the live request
/// count (L252-257: exactly 8 runtime requests and no assertion requests
/// or the test fatals); null-exchange pins the pretransport row
/// (load_json_unauthenticated.json: exchange null with an empty
/// environment, grounding fixture main.can L16 unauthenticated to
/// http::credentials_missing); methods pins the per-operation verbs in
/// fixture order (load_json GET, load_envelope GET, send_text POST,
/// send_json PUT, send_bytes PATCH, head_text HEAD, delete_text DELETE,
/// options_text OPTIONS) validated live per path (L114/L142/L147/L153/
/// L158/L163); query pins the encoded duplicate labels
/// (load_json.json URL verbatim "...?labels=a+b&labels=%2B"; live L115:
/// first "a b", two values, second "+", no omitted); headers pins the
/// restaged header contract (L26-81: every request gains x-default, the
/// load op drops x-omitted; live L107-108/L115: X-Default inherited,
/// X-Probe yes, X-Omitted absent); auth pins the staged bearer (fixture
/// request headers verbatim; live L104: Bearer [REDACTED] via the
/// CAN_I26_TOKEN env at L198); body-media pins the three request bodies
/// (L142: "hello" as text/plain with charset=utf-8; L119: the JSON count
/// as application/json; L147: empty bytes as application/octet-stream);
/// bigint pins the exact count above float precision (L119/L134:
/// 9007199254740993, required live by fixture main.can L87/L103-107);
/// status-fails pins the 409 mode (L122-124 plus the L258-266 table row);
/// media-fails pins the text/plain mode (L125-127 plus its table row);
/// charset-fails pins the latin1 mode (L128-130 plus its table row);
/// malformed-fails pins the wrong-type mode (L131-135: {"count":"wrong"}
/// plus its table row); envelope pins the raw response (L136-140:
/// status 418, Set-Cookie a=1 and b=2, body bytes 0 and 255);
/// invalid-header pins the computed-header refusal (L271-281: the mutation
/// x_probe "bad" plus non-ASCII fails with "build verification failed"
/// and "outcome mismatch"); header-before-credential pins the ordering
/// (L270/L278-281: with the credential emptied, verification still fails
/// first, before any launch or publication); no-request-on-invalid pins
/// the silence (L267-269/L283-287: the request count is unchanged or the
/// test fatals "invalid header launched a request").
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int eight_operations
    bool null_exchange
    str methods
    str query
    bool headers
    str auth
    str body_media
    int bigint
    bool status_fails
    bool media_fails
    bool charset_fails
    bool malformed_fails
    int envelope
    str invalid_header
    bool header_before_credential
    bool no_request_on_invalid
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/fetch-semantics", "default", "", "offline"), "eight-operations" => ok "case bundled/fetch-semantics variant default root eight-operations run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/fetch-semantics", "default", "", "offline"), "null-exchange" => ok evidence("null-exchange", "true", "true", true, "case bundled/fetch-semantics variant default root null-exchange run offline")
        different: false, true, context("bundled/fetch-semantics", "default", "", "offline"), "null-exchange" => failed{"null-exchange"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 8, 8, context("bundled/fetch-semantics", "default", "", "offline"), "eight-operations" => ok evidence("eight-operations", "8", "8", true, "case bundled/fetch-semantics variant default root eight-operations run offline")
        different: 7, 8, context("bundled/fetch-semantics", "default", "", "offline"), "eight-operations" => failed{"eight-operations"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "labels=a+b&labels=%2B", "labels=a+b&labels=%2B", context("bundled/fetch-semantics", "default", "", "offline"), "query" => ok evidence("query", "labels=a+b&labels=%2B", "labels=a+b&labels=%2B", true, "case bundled/fetch-semantics variant default root query run offline")
        different: "labels=a+b", "labels=a+b&labels=%2B", context("bundled/fetch-semantics", "default", "", "offline"), "query" => failed{"query"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
