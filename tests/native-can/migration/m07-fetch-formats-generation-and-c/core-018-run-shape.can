package m07core018run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-018 "bundled fetch: silent production run shape".
/// Source: tests/integration/fetch_test.go symbol TestCurrentBundledFetch.
/// Related fixture: compiler/testdata/current/fetch/main.can main entry
/// (L78-136); the live run helper (L188-210) executes the sandboxed binary
/// under the deny-network profile plus a localhost-only allowance for run.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the silent production process shape. The fetch
/// entry runs all eight operations and checks every result, yet the green
/// run exits 0 with empty stdout and empty stderr; the sandbox profile,
/// the run-only network allowance and the credential env plumbing pin the
/// invocation contract, and the strict-tsc leg stays conditional.
/// The 20-root green pin lives in core-018-roots-green.can; live fetch
/// semantics live in core-018-fetch-semantics.can.
/// Variants: none live in this file beyond the run path itself; error
/// modes, the invalid-header gate and the header-default restage belong
/// to the fetch-semantics file, and the optional CAN_TSC strict
/// generated-TypeScript leg (L290-309) is env-gated and recorded
/// blocked, never waived.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_I26_TOKEN is harness-supplied
/// (Go L99/L198: "test-only"), not an external gate. Logical gates
/// SUITE/DIAG/FAULT and C/R/N/S/A identities bind at P23/QHTTP; no live
/// run now. Descriptor timeout 300000ms mirrors the Go 5-minute ctx (L90).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/fetch-run checks: run-exit, run-stdout-empty,
/// run-stderr-empty, sandbox-profile, network-allowance, credential-env,
/// tsc-conditional.
/// Facet map (fetch_test.go legs): run-exit pins exit 0 on the green run
/// (L248-251: status 0 or "fetch execution" fatals); run-stdout-empty
/// pins empty stdout on the green run (L249: out must be "");
/// run-stderr-empty pins empty stderr on the green run (L249: diag must
/// be ""); sandbox-profile pins the deny-network base profile (L190:
/// "(version 1)(allow default)(deny network*)" verbatim); network-allowance
/// pins the run-only localhost allowance (L191-193: "(allow
/// network-outbound (remote ip "localhost:*"))" verbatim);
/// credential-env pins the credential plumbing (L198: CAN_I26_TOKEN set in
/// the run environment); tsc-conditional pins the optional leg (L290-309:
/// strict tsc over emitted dist TypeScript via CAN_BUN runs if and only
/// if CAN_TSC is set).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stdout_empty
    bool run_stderr_empty
    str sandbox_profile
    str network_allowance
    str credential_env
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/fetch-run", "default", "", "offline"), "run-exit" => ok "case bundled/fetch-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/fetch-run", "default", "", "offline"), "run-stdout-empty" => ok evidence("run-stdout-empty", "true", "true", true, "case bundled/fetch-run variant default root run-stdout-empty run offline")
        different: false, true, context("bundled/fetch-run", "default", "", "offline"), "run-stdout-empty" => failed{"run-stdout-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("bundled/fetch-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case bundled/fetch-run variant default root run-exit run offline")
        different: 1, 0, context("bundled/fetch-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("bundled/fetch-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case bundled/fetch-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("bundled/fetch-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        seed_run_red: "seed-run-red" => ok observation(1, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        seed_stdout_noisy: "seed-stdout-noisy" => ok observation(0, false, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        seed_stderr_noisy: "seed-stderr-noisy" => ok observation(0, true, false, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        seed_profile_drift: "seed-profile-drift" => ok observation(0, true, true, "(version 1)(allow default)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        seed_allowance_drift: "seed-allowance-drift" => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound)", "CAN_I26_TOKEN", true)
        seed_env_drift: "seed-env-drift" => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_TOKEN", true)
        seed_tsc_unconditional: "seed-tsc-unconditional" => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", false)
    match variant_id
        "seed-run-red" => ok observation(1, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        "seed-stdout-noisy" => ok observation(0, false, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        "seed-stderr-noisy" => ok observation(0, true, false, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        "seed-profile-drift" => ok observation(0, true, true, "(version 1)(allow default)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
        "seed-allowance-drift" => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound)", "CAN_I26_TOKEN", true)
        "seed-env-drift" => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_TOKEN", true)
        "seed-tsc-unconditional" => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", false)
        _ => ok observation(0, true, true, "(version 1)(allow default)(deny network*)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I26_TOKEN", true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m07_018: "m07-018" => ok [check("run-exit", "green run exits 0"), check("run-stdout-empty", "green run keeps stdout empty"), check("run-stderr-empty", "green run keeps stderr empty"), check("sandbox-profile", "invocation pins the deny-network sandbox profile"), check("network-allowance", "run pins the localhost-only network allowance"), check("credential-env", "run environment carries CAN_I26_TOKEN"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
        other: "nope" => ok []
    match scope is "m07-018"
        false => ok []
        true => ok [check("run-exit", "green run exits 0"), check("run-stdout-empty", "green run keeps stdout empty"), check("run-stderr-empty", "green run keeps stderr empty"), check("sandbox-profile", "invocation pins the deny-network sandbox profile"), check("network-allowance", "run pins the localhost-only network allowance"), check("credential-env", "run environment carries CAN_I26_TOKEN"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set with CAN_BUN")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/fetch-run" => ok [expected_check("run-exit", "0"), expected_check("run-stdout-empty", "true"), expected_check("run-stderr-empty", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("network-allowance", "(allow network-outbound (remote ip \"localhost:*\"))"), expected_check("credential-env", "CAN_I26_TOKEN"), expected_check("tsc-conditional", "true")]
        unknown: "nope" => ok []
    match case is "bundled/fetch-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stdout-empty", "true"), expected_check("run-stderr-empty", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("network-allowance", "(allow network-outbound (remote ip \"localhost:*\"))"), expected_check("credential-env", "CAN_I26_TOKEN"), expected_check("tsc-conditional", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/fetch-run", "default", "", "offline") => ok
        seed_run_red: context("bundled/fetch-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stdout_noisy: context("bundled/fetch-run", "seed-stdout-noisy", "", "offline") => failed{"run-stdout-empty"}
        seed_stderr_noisy: context("bundled/fetch-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_profile_drift: context("bundled/fetch-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_allowance_drift: context("bundled/fetch-run", "seed-allowance-drift", "", "offline") => failed{"network-allowance"}
        seed_env_drift: context("bundled/fetch-run", "seed-env-drift", "", "offline") => failed{"credential-env"}
        seed_tsc_unconditional: context("bundled/fetch-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stdout_empty, true, c, "run-stdout-empty")
                failed
                ok evidence stdout_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                    failed
                    ok evidence stderr_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                        failed
                        ok evidence profile_evidence => match call require_text(got.network_allowance, "(allow network-outbound (remote ip \"localhost:*\"))", c, "network-allowance")
                            failed
                            ok evidence allowance_evidence => match call require_text(got.credential_env, "CAN_I26_TOKEN", c, "credential-env")
                                failed
                                ok evidence env_evidence => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                    failed
                                    ok evidence tsc_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m07_018: "m07-018" => ok test_case("bundled/fetch-run", ["fetch", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 300000, [check_ref("run-exit"), check_ref("run-stdout-empty"), check_ref("run-stderr-empty"), check_ref("sandbox-profile"), check_ref("network-allowance"), check_ref("credential-env"), check_ref("tsc-conditional")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m07-018"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/fetch-run", ["fetch", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 300000, [check_ref("run-exit"), check_ref("run-stdout-empty"), check_ref("run-stdout-empty"), check_ref("run-stderr-empty"), check_ref("sandbox-profile"), check_ref("network-allowance"), check_ref("credential-env"), check_ref("tsc-conditional")], callable case_body)
