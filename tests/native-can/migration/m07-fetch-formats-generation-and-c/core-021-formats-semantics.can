    emits {}
    given
        str case
    asserts
        known: "formats/documents-semantics" => ok [expected_check("usage-nil", "usage: toml <path> | yaml <path> | json5 <path> | jsonl <path>"), expected_check("usage-bogus", "usage: toml <path> | yaml <path> | json5 <path> | jsonl <path>"), expected_check("usage-arity", "usage: toml <path>"), expected_check("toml-output", "8080"), expected_check("yaml-output", "7"), expected_check("json5-output", "7"), expected_check("jsonl-output", "3"), expected_check("jsonl-bigint", "9007199254740993"), expected_check("jsonl-blank", "true"), expected_check("missing-file", "files::not_found"), expected_check("malformed-toml", "codec::invalid_data"), expected_check("malformed-jsonl", "codec::invalid_data")]
        unknown: "nope" => ok []
    match case is "formats/documents-semantics"
        false => ok []
        true => ok [expected_check("usage-nil", "usage: toml <path> | yaml <path> | json5 <path> | jsonl <path>"), expected_check("usage-bogus", "usage: toml <path> | yaml <path> | json5 <path> | jsonl <path>"), expected_check("usage-arity", "usage: toml <path>"), expected_check("toml-output", "8080"), expected_check("yaml-output", "7"), expected_check("json5-output", "7"), expected_check("jsonl-output", "3"), expected_check("jsonl-bigint", "9007199254740993"), expected_check("jsonl-blank", "true"), expected_check("missing-file", "files::not_found"), expected_check("malformed-toml", "codec::invalid_data"), expected_check("malformed-jsonl", "codec::invalid_data")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("formats/documents-semantics", "default", "", "offline") => ok
        seed_usage_nil_drift: context("formats/documents-semantics", "seed-usage-nil-drift", "", "offline") => failed{"usage-nil"}
        seed_usage_bogus_drift: context("formats/documents-semantics", "seed-usage-bogus-drift", "", "offline") => failed{"usage-bogus"}
        seed_usage_arity_drift: context("formats/documents-semantics", "seed-usage-arity-drift", "", "offline") => failed{"usage-arity"}
        seed_toml_drift: context("formats/documents-semantics", "seed-toml-drift", "", "offline") => failed{"toml-output"}
        seed_yaml_drift: context("formats/documents-semantics", "seed-yaml-drift", "", "offline") => failed{"yaml-output"}
        seed_json5_drift: context("formats/documents-semantics", "seed-json5-drift", "", "offline") => failed{"json5-output"}
        seed_jsonl_drift: context("formats/documents-semantics", "seed-jsonl-drift", "", "offline") => failed{"jsonl-output"}
        seed_bigint_short: context("formats/documents-semantics", "seed-bigint-short", "", "offline") => failed{"jsonl-bigint"}
        seed_blank_red: context("formats/documents-semantics", "seed-blank-red", "", "offline") => failed{"jsonl-blank"}
        seed_missing_drift: context("formats/documents-semantics", "seed-missing-drift", "", "offline") => failed{"missing-file"}
        seed_toml_malformed_drift: context("formats/documents-semantics", "seed-toml-malformed-drift", "", "offline") => failed{"malformed-toml"}
        seed_jsonl_malformed_drift: context("formats/documents-semantics", "seed-jsonl-malformed-drift", "", "offline") => failed{"malformed-jsonl"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.usage_nil, "usage: toml <path> | yaml <path> | json5 <path> | jsonl <path>", c, "usage-nil")
            failed
            ok evidence usage_nil_evidence => match call require_text(got.usage_bogus, "usage: toml <path> | yaml <path> | json5 <path> | jsonl <path>", c, "usage-bogus")
                failed
                ok evidence usage_bogus_evidence => match call require_text(got.usage_arity, "usage: toml <path>", c, "usage-arity")
                    failed
                    ok evidence usage_arity_evidence => match call require_text(got.toml_output, "8080", c, "toml-output")
                        failed
                        ok evidence toml_evidence => match call require_text(got.yaml_output, "7", c, "yaml-output")
                            failed
                            ok evidence yaml_evidence => match call require_text(got.json5_output, "7", c, "json5-output")
                                failed
                                ok evidence json5_evidence => match call require_text(got.jsonl_output, "3", c, "jsonl-output")
                                    failed
                                    ok evidence jsonl_evidence => match call require_int(got.jsonl_bigint, 9007199254740993, c, "jsonl-bigint")
                                        failed
                                        ok evidence bigint_evidence => match call require_bool(got.jsonl_blank, true, c, "jsonl-blank")
                                            failed
                                            ok evidence blank_evidence => match call require_text(got.missing_file, "files::not_found", c, "missing-file")
                                                failed
                                                ok evidence missing_evidence => match call require_text(got.malformed_toml, "codec::invalid_data", c, "malformed-toml")
                                                    failed
                                                    ok evidence toml_malformed_evidence => match call require_text(got.malformed_jsonl, "codec::invalid_data", c, "malformed-jsonl")
                                                        failed
                                                        ok evidence jsonl_malformed_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m07_021: "m07-021" => ok test_case("formats/documents-semantics", ["formats", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 360000, [check_ref("usage-nil"), check_ref("usage-bogus"), check_ref("usage-arity"), check_ref("toml-output"), check_ref("yaml-output"), check_ref("json5-output"), check_ref("jsonl-output"), check_ref("jsonl-bigint"), check_ref("jsonl-blank"), check_ref("missing-file"), check_ref("malformed-toml"), check_ref("malformed-jsonl")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m07-021"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("formats/documents-semantics", ["formats", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 360000, [check_ref("usage-nil"), check_ref("usage-bogus"), check_ref("usage-arity"), check_ref("toml-output"), check_ref("yaml-output"), check_ref("json5-output"), check_ref("jsonl-output"), check_ref("jsonl-bigint"), check_ref("jsonl-blank"), check_ref("missing-file"), check_ref("malformed-toml"), check_ref("malformed-jsonl")], callable case_body)
