    emits {}
    given
        str scope
    asserts
        m07_021: "m07-021" => ok [check("usage-nil", "nil args print the full four-command usage"), check("usage-bogus", "unknown command prints the full four-command usage"), check("usage-arity", "toml without a path prints usage: toml <path>"), check("toml-output", "svc.toml prints 8080"), check("yaml-output", "point.yaml prints 7"), check("json5-output", "point.json5 prints 7"), check("jsonl-output", "points.jsonl prints 3"), check("jsonl-bigint", "points.jsonl pins exact 9007199254740993"), check("jsonl-blank", "points.jsonl blank line and CRLF are tolerated"), check("missing-file", "absent file yields files::not_found"), check("malformed-toml", "duplicate-key TOML yields codec::invalid_data"), check("malformed-jsonl", "truncated JSONL yields codec::invalid_data")]
        other: "nope" => ok []
    match scope is "m07-021"
        false => ok []
        true => ok [check("usage-nil", "nil args print the full four-command usage"), check("usage-bogus", "unknown command prints the full four-command usage"), check("usage-arity", "toml without a path prints usage: toml <path>"), check("toml-output", "svc.toml prints 8080"), check("yaml-output", "point.yaml prints 7"), check("json5-output", "point.json5 prints 7"), check("jsonl-output", "points.jsonl prints 3"), check("jsonl-bigint", "points.jsonl pins exact 9007199254740993"), check("jsonl-blank", "points.jsonl blank line and CRLF are tolerated"), check("missing-file", "absent file yields files::not_found"), check("malformed-toml", "duplicate-key TOML yields codec::invalid_data"), check("malformed-jsonl", "truncated JSONL yields codec::invalid_data")]
