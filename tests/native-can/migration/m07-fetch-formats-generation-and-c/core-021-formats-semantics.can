package m07core021formats
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-021 "formats documents: live semantics, exact outputs, faults".
/// Source: tests/integration/formats_test.go symbol
/// TestCurrentFormatsDocuments (L49-156).
/// Related fixture: tests/integration/testdata/formats/main.can (the fmt_cli
/// entry dispatch L123-211 plus the toml/yaml/json5/jsonl readers) with the
/// six staged documents in the Go formatsDocuments map (L18-25).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the live document semantics. The compiled CLI
/// parses TOML, YAML, JSON5 and JSONL documents with exact stdout,
/// including the 64-bit JSONL number above float precision and the blank
/// line plus CRLF the JSONL count still tolerates; the usage paths print
/// the exact usage strings; the absent file and the malformed TOML/JSONL
/// inputs yield the exact domain errors (Go L145-154).
/// The 9-root green pin lives in core-021-roots-green.can; the ok/fault
/// production process shape lives in core-021-run-shape.can.
/// Variants: usage nil/bogus/toml (Go L145-147); valid svc.toml,
/// point.yaml, point.json5, points.jsonl (L148-151); missing TOML,
/// duplicate-key TOML, truncated JSONL (L152-154).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23; no live run now. Descriptor timeout
/// 360000ms mirrors the Go 6-minute ctx (L55).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case formats/documents-semantics checks: usage-nil, usage-bogus,
/// usage-arity, toml-output, yaml-output, json5-output, jsonl-output,
/// jsonl-bigint, jsonl-blank, missing-file, malformed-toml,
/// malformed-jsonl.
/// Facet map (formats_test.go legs): usage-nil pins the nil-args path
/// (L145: ok(nil, "usage: toml <path> | yaml <path> | json5 <path> |
/// jsonl <path>")); usage-bogus pins the unknown-command path (L146:
/// ok(["bogus"], the same full usage)); usage-arity pins the missing-path
/// path (L147: ok(["toml"], "usage: toml <path>")); toml-output pins the
/// TOML read (L148: ok(["toml", svc.toml], "8080")); yaml-output pins the
/// YAML read (L149: ok(["yaml", point.yaml], "7")); json5-output pins the
/// JSON5 read (L150: ok(["json5", point.json5], "7")); jsonl-output pins
/// the JSONL count (L151: ok(["jsonl", points.jsonl], "3"));
/// jsonl-bigint pins the exact 64-bit value (L22: points.jsonl carries
/// 9007199254740993, above float precision); jsonl-blank pins the
/// tolerated separators (L22: points.jsonl carries a blank line and a
/// CRLF line ending, yet the count is still 3); missing-file pins the
/// absent-file error (L152: fault(absent.toml, "files::not_found"));
/// malformed-toml pins the duplicate-key error (L153: fault(bad.toml,
/// "codec::invalid_data")); malformed-jsonl pins the truncated-input
/// error (L154: fault(truncated.jsonl, "codec::invalid_data")). Every ok
/// leg also requires empty stderr and every fault leg empty stdout plus
/// the `"error":"..."` stderr fragment (L133/L141); those process-shape
/// halves live in the run-shape file.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str usage_nil
    str usage_bogus
    str usage_arity
    str toml_output
    str yaml_output
    str json5_output
    str jsonl_output
    int jsonl_bigint
    bool jsonl_blank
    str missing_file
    str malformed_toml
    str malformed_jsonl
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
