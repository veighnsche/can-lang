package m07core022generation
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-022 "bundled generation: live semantics and error mapping".
/// Source: tests/integration/generation_test.go symbol
/// TestCurrentBundledGeneration.
/// Related fixture: compiler/testdata/current/native/generation.can
/// (generator L11-19, classifier L20-26, describe L27-36, generate L37-44,
/// select L45-51, decide L52-60, main L61-103) plus the staged raw
/// fixtures generation_describe/generate/decide.json.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the live request/response path (3 requests with
/// the pinned profile, formats, asks, headers and transformed Choice
/// body), the four error variants mapping to distinct errors with no
/// retry or advance, the blank-ask and auth-omission pre-launch gates,
/// and the optional strict-ts leg.
/// The 4-root green pin lives in core-022-roots-green.can; the production
/// process shape lives in core-022-run-shape.can.
/// Variants: refusal, truncated, invalid, record (Go L168-185); blank ask
/// (L186-201); auth omission (L202-208).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_I28_TOKEN is harness-supplied
/// (Go L99/L104: "test-only"), not an external gate. Logical gates
/// SUITE/DIAG/FAULT and C/R/N/S/A identities bind at P23/QHTTP; no live
/// run now. Descriptor timeout 300000ms mirrors the Go 5-minute ctx (L27).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/generation-semantics checks: three-requests,
/// request-profile, text-format, schema-format, schema-shape, asks-inputs,
/// no-disclosure, choice-request, request-headers, refusal-maps,
/// truncated-maps, invalid-maps, record-maps, blank-ask-rejects,
/// blank-ask-silent, auth-build-exit, strict-ts, bigint.
/// Facet map (generation_test.go legs): three-requests pins the live
/// request count (L122-125: exactly 3 bodies for text, record, Choice or
/// the test fatals); request-profile pins the Responses shape (L133: 9
/// keys with model fixture-model, max_output_tokens 512, store/stream/
/// background false, truncation disabled); text-format pins the describe
/// format (L146-149: lone type text); schema-format pins the generate
/// format (L151-153: type json_schema, strict true, name matching
/// ^can_[0-9a-f]{32}$); schema-shape pins the generate schema (L155-161:
/// additionalProperties false, 3 required, choices items with count
/// integer); asks-inputs pins the prompts and inputs (L136-141: Describe
/// with {"count":9007199254740993}, Plan with {"description":
/// "description"}); no-disclosure pins the redaction (L142-144: no body
/// contains private-not-disclosed); choice-request pins the transformed
/// Choice body verbatim (L164-167: the jev-latest request); request-headers
/// pins the live headers (L43-45: POST with Bearer test-only and
/// application/json); refusal-maps pins the refusal variant (L171/L176-184:
/// "error":"llm::refused" with 1 request); truncated-maps pins the
/// truncated variant ("error":"llm::truncated" with 1 request);
/// invalid-maps pins the invalid variant ("error":"llm::invalid_response"
/// with 1 request); record-maps pins the record variant ("error":
/// "codec::invalid_data" with 2 requests); blank-ask-rejects pins the
/// blank-asks gate (L189-195: "build verification failed" plus "unused
/// fixture"); blank-ask-silent pins the gate silence (L190-201: no new
/// request or the test fatals); auth-build-exit pins the authless build
/// (L202-208: build exits 0 after the auth strip); strict-ts pins the
/// optional leg (L215-220: strict tsc over emitted entry.ts via CAN_BUN
/// runs if and only if CAN_TSC is set); bigint pins the exact count above
/// float precision (L136/L159: 9007199254740993).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int three_requests
    str request_profile
    str text_format
    str schema_format
    str schema_shape
    str asks_inputs
    bool no_disclosure
    str choice_request
    str request_headers
    str refusal_maps
    str truncated_maps
    str invalid_maps
    str record_maps
    str blank_ask
    bool blank_ask_silent
    int auth_build_exit
    bool strict_ts
    int bigint
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/generation-semantics", "default", "", "offline"), "three-requests" => ok "case bundled/generation-semantics variant default root three-requests run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/generation-semantics", "default", "", "offline"), "no-disclosure" => ok evidence("no-disclosure", "true", "true", true, "case bundled/generation-semantics variant default root no-disclosure run offline")
        different: false, true, context("bundled/generation-semantics", "default", "", "offline"), "no-disclosure" => failed{"no-disclosure"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("bundled/generation-semantics", "default", "", "offline"), "three-requests" => ok evidence("three-requests", "3", "3", true, "case bundled/generation-semantics variant default root three-requests run offline")
        different: 2, 3, context("bundled/generation-semantics", "default", "", "offline"), "three-requests" => failed{"three-requests"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "text", "text", context("bundled/generation-semantics", "default", "", "offline"), "text-format" => ok evidence("text-format", "text", "text", true, "case bundled/generation-semantics variant default root text-format run offline")
        different: "json_schema", "text", context("bundled/generation-semantics", "default", "", "offline"), "text-format" => failed{"text-format"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
