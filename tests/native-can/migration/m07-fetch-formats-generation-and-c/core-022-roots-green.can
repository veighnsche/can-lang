    bool report_passed
    int root_count
    str fixture_name
    int describe_roots
    int generate_roots
    int select_roots
    int decide_roots
    int main_roots
    bool label_supplied
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
