        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m07-022"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/generation-run", ["generation", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 300000, [check_ref("run-exit"), check_ref("run-stdout-empty"), check_ref("run-stderr-empty"), check_ref("assert-exit"), check_ref("assert-stderr-empty"), check_ref("assert-stdout-label"), check_ref("sandbox-profile"), check_ref("network-allowance"), check_ref("credential-env"), check_ref("provider-passed"), check_ref("provider-evidence")], callable case_body)
