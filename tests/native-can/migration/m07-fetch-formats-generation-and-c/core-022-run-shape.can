package m07core022run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-022 "bundled generation: production run shape".
/// Source: tests/integration/generation_test.go symbol
/// TestCurrentBundledGeneration.
/// Related fixture: compiler/testdata/current/native/generation.can main
/// entry (L61-103); the live run helper (L100-115) executes the sandboxed
/// binary under the deny-network profile plus a localhost-only allowance.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the production process shape. The green run
/// exits 0 with empty stdout and empty stderr; the assert leg exits 0
/// with empty stderr and a report carrying supplied-completion; the
/// sandbox profile, the run-only network allowance and the credential env
/// plumbing pin the invocation contract; the compiled raw-provider
/// harness passes with its two evidence labels.
/// The 4-root green pin lives in core-022-roots-green.can; live
/// generation semantics live in core-022-generation-semantics.can.
/// Variants: none live in this file beyond the green run and assert legs
/// themselves; error modes, the blank-ask gate, the authless build and
/// the optional CAN_TSC strict generated-TypeScript leg (L215-220) belong
/// to the generation-semantics file.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_I28_TOKEN is harness-supplied
/// (Go L99/L104: "test-only"), not an external gate. Logical gates
/// SUITE/DIAG/FAULT and C/R/N/S/A identities bind at P23/QHTTP; no live
/// run now. Descriptor timeout 300000ms mirrors the Go 5-minute ctx (L27).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/generation-run checks: run-exit, run-stdout-empty,
/// run-stderr-empty, assert-exit, assert-stderr-empty, assert-stdout-label,
/// sandbox-profile, network-allowance, credential-env, provider-passed,
/// provider-evidence.
/// Facet map (generation_test.go legs): run-exit pins exit 0 on the green
/// run (L116-118: status 0 or "generation execution" fatals);
/// run-stdout-empty pins empty stdout on the green run (L116: out must be
/// ""); run-stderr-empty pins empty stderr on the green run (L116: diag
/// must be ""); assert-exit pins exit 0 on the assert leg (L119-121:
/// status 0 or "consumer assertions" fatals); assert-stderr-empty pins
/// empty stderr on the assert leg (L119: diag must be "");
/// assert-stdout-label pins the non-silent assert stdout (L119: out
/// contains "supplied-completion"; adaptation per the CORE-014/019/040
/// precedent: the Go test pins substring containment, not full-output
/// equality, so the verbatim needle is pinned, not the whole report);
/// sandbox-profile pins the deny-network base profile (L102: "(version
/// 1)(allow default)(deny network*)" verbatim); network-allowance pins the
/// run-only localhost allowance (L102: "(allow network-outbound (remote
/// ip "localhost:*"))" verbatim); credential-env pins the credential
/// plumbing (L99/L104: CAN_I28_TOKEN=test-only in the run environment);
/// provider-passed pins the compiled raw-provider harness (L246-250: the
/// report passes); provider-evidence pins its evidence labels (L249:
/// ["raw-provider-fixture", "real-can"]).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stdout_empty
    bool run_stderr_empty
    int assert_exit
    bool assert_stderr_empty
    str assert_stdout_label
    str sandbox_profile
    str network_allowance
    str credential_env
    bool provider_passed
    str provider_evidence
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/generation-run", "default", "", "offline"), "run-exit" => ok "case bundled/generation-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/generation-run", "default", "", "offline"), "run-stdout-empty" => ok evidence("run-stdout-empty", "true", "true", true, "case bundled/generation-run variant default root run-stdout-empty run offline")
        different: false, true, context("bundled/generation-run", "default", "", "offline"), "run-stdout-empty" => failed{"run-stdout-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("bundled/generation-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case bundled/generation-run variant default root run-exit run offline")
        different: 1, 0, context("bundled/generation-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("bundled/generation-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case bundled/generation-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("bundled/generation-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
