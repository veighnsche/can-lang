fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/generation-run", "default", "", "offline") => ok
        seed_run_red: context("bundled/generation-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stdout_noisy: context("bundled/generation-run", "seed-stdout-noisy", "", "offline") => failed{"run-stdout-empty"}
        seed_stderr_noisy: context("bundled/generation-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_assert_red: context("bundled/generation-run", "seed-assert-red", "", "offline") => failed{"assert-exit"}
        seed_assert_noisy: context("bundled/generation-run", "seed-assert-noisy", "", "offline") => failed{"assert-stderr-empty"}
        seed_label_drift: context("bundled/generation-run", "seed-label-drift", "", "offline") => failed{"assert-stdout-label"}
        seed_profile_drift: context("bundled/generation-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_allowance_drift: context("bundled/generation-run", "seed-allowance-drift", "", "offline") => failed{"network-allowance"}
        seed_env_drift: context("bundled/generation-run", "seed-env-drift", "", "offline") => failed{"credential-env"}
        seed_provider_red: context("bundled/generation-run", "seed-provider-red", "", "offline") => failed{"provider-passed"}
        seed_evidence_drift: context("bundled/generation-run", "seed-evidence-drift", "", "offline") => failed{"provider-evidence"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stdout_empty, true, c, "run-stdout-empty")
                failed
                ok evidence stdout_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                    failed
                    ok evidence stderr_evidence => match call require_int(got.assert_exit, 0, c, "assert-exit")
                        failed
                        ok evidence assert_exit_evidence => match call require_bool(got.assert_stderr_empty, true, c, "assert-stderr-empty")
                            failed
                            ok evidence assert_stderr_evidence => match call require_text(got.assert_stdout_label, "supplied-completion", c, "assert-stdout-label")
                                failed
                                ok evidence label_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                    failed
                                    ok evidence profile_evidence => match call require_text(got.network_allowance, "(allow network-outbound (remote ip \"localhost:*\"))", c, "network-allowance")
                                        failed
                                        ok evidence allowance_evidence => match call require_text(got.credential_env, "CAN_I28_TOKEN=test-only", c, "credential-env")
                                            failed
                                            ok evidence env_evidence => match call require_bool(got.provider_passed, true, c, "provider-passed")
                                                failed
                                                ok evidence provider_evidence => match call require_text(got.provider_evidence, "raw-provider-fixture,real-can", c, "provider-evidence")
                                                    failed
                                                    ok evidence labels_evidence => ok
fn test_case descriptor
    emits {}
    given
