                failed
                ok evidence roundtrip_evidence => match call require_bool(got.escape_in_title, true, c, "escape-in-title")
                    failed
                    ok evidence title_evidence => match call require_bool(got.page_tail, true, c, "page-tail")
                        failed
                        ok evidence tail_evidence => match call require_text(got.htmx_attributes, "hx-get=\"/results?q=a&amp;x=b\" hx-target=\"#results\" hx-trigger=\"every 1000ms\"", c, "htmx-attributes")
                            failed
                            ok evidence attrs_evidence => match call require_text(got.htmx_assets, "/__can/assets/htmx-4.0.0.min.js|/__can/assets/htmx-guard.js", c, "htmx-assets")
                                failed
