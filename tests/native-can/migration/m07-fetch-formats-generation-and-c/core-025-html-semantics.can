        true => ok test_case("bundled/html-semantics", ["html", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("hostile-input"), check_ref("request-roundtrip"), check_ref("escape-in-title"), check_ref("page-tail"), check_ref("htmx-attributes"), check_ref("htmx-assets"), check_ref("two-safe-scripts"), check_ref("no-injected-script"), check_ref("no-injected-image"), check_ref("fragment-equals-native-escape")], callable case_body)
