                                    failed
                                    ok evidence scripts_evidence => match call require_bool(got.no_injected_script, true, c, "no-injected-script")
                                        failed
                                        ok evidence script_evidence => match call require_bool(got.no_injected_image, true, c, "no-injected-image")
