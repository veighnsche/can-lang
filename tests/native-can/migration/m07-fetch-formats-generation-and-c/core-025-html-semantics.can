        seed_roundtrip_red: context("bundled/html-semantics", "seed-roundtrip-red", "", "offline") => failed{"request-roundtrip"}
        seed_title_raw: context("bundled/html-semantics", "seed-title-raw", "", "offline") => failed{"escape-in-title"}
        seed_tail_drift: context("bundled/html-semantics", "seed-tail-drift", "", "offline") => failed{"page-tail"}
        seed_attrs_drift: context("bundled/html-semantics", "seed-attrs-drift", "", "offline") => failed{"htmx-attributes"}
        seed_assets_drift: context("bundled/html-semantics", "seed-assets-drift", "", "offline") => failed{"htmx-assets"}
        seed_script_short: context("bundled/html-semantics", "seed-script-short", "", "offline") => failed{"two-safe-scripts"}
        seed_script_injected: context("bundled/html-semantics", "seed-script-injected", "", "offline") => failed{"no-injected-script"}
        seed_image_injected: context("bundled/html-semantics", "seed-image-injected", "", "offline") => failed{"no-injected-image"}
        seed_fragment_raw: context("bundled/html-semantics", "seed-fragment-raw", "", "offline") => failed{"fragment-equals-native-escape"}
    match call observe(c.variant_id)
