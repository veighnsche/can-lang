package m07core025html
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-025 "bundled HTML: hostile escape, htmx shape, safe scripts".
/// Source: tests/integration/html_test.go symbol TestCurrentBundledHTML.
/// Related fixture: compiler/testdata/current/html/main.can render plus
/// fragment entries (L4-43); the harness fetches request-derived text
/// (Go L127-131) and renders the compiled functions (L133-149).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): request-derived hostile text is escaped in the
/// page title and the fragment render; the page keeps the expected htmx
/// attributes and assets, exactly two safe scripts, no injected script
/// and no image; the fragment render equals the native escape result.
/// The 3-root green pin lives in core-025-roots-green.can; the build plus
/// harness process shape lives in core-025-run-shape.can.
/// Variants: hostile input carrying script, image, ampersand and quotes
/// (Go L126); page render (L140-146) and fragment render (L147).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT and
/// C/R/N/S/A identities bind at P23/QHTTP; no live run now. Descriptor
/// timeout 120000ms mirrors the Go 2-minute ctx (L25).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/html-semantics checks: hostile-input, request-roundtrip,
/// escape-in-title, page-tail, htmx-attributes, htmx-assets,
/// two-safe-scripts, no-injected-script, no-injected-image,
/// fragment-equals-native-escape.
/// Facet map (html_test.go legs): hostile-input pins the hostile text
/// verbatim (L126: title-break plus script plus image plus & plus quotes);
/// request-roundtrip pins the fetch leg (L139: fetched input equals the
/// hostile text); escape-in-title pins the head (L142: output starts with
/// doctype plus html plus head plus title plus escaped plus title close);
/// page-tail pins the body (L143: output ends with the section plus p
/// tail carrying escaped text); htmx-attributes pins the live attributes
/// verbatim (L143: hx-get plus hx-target plus hx-trigger);
/// htmx-assets pins the runtime scripts (L145-146: htmx-4.0.0.min.js plus
/// htmx-guard.js); two-safe-scripts pins the script count (L144: exactly
/// 2 "<script " matches); no-injected-script pins the absence (L144: no
/// "<script>alert"); no-injected-image pins the absence (L144: no "<img");
/// fragment-equals-native-escape pins the fragment (L147: renderSafe of
/// the fragment equals Bun.escapeHTML of the input).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str hostile_input
    bool request_roundtrip
    bool escape_in_title
    bool page_tail
    str htmx_attributes
    str htmx_assets
    int two_safe_scripts
    bool no_injected_script
    bool no_injected_image
    bool fragment_equals_native_escape
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
