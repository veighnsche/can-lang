    asserts
        expected: context("bundled/html-run", "default", "", "offline") => ok
        seed_build_red: context("bundled/html-run", "seed-build-red", "", "offline") => failed{"build-exit"}
        seed_directory_missing: context("bundled/html-run", "seed-directory-missing", "", "offline") => failed{"build-directory"}
        seed_functions_drift: context("bundled/html-run", "seed-functions-drift", "", "offline") => failed{"generated-functions"}
        seed_runtime_zero: context("bundled/html-run", "seed-runtime-zero", "", "offline") => failed{"runtime-single"}
        seed_harness_red: context("bundled/html-run", "seed-harness-red", "", "offline") => failed{"harness-exit"}
        seed_marker_drift: context("bundled/html-run", "seed-marker-drift", "", "offline") => failed{"harness-marker"}
        seed_snapshot_drift: context("bundled/html-run", "seed-snapshot-drift", "", "offline") => failed{"snapshot-empty"}
        seed_profile_drift: context("bundled/html-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_allowance_drift: context("bundled/html-run", "seed-allowance-drift", "", "offline") => failed{"network-allowance"}
        seed_tsc_unconditional: context("bundled/html-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.build_exit, 0, c, "build-exit")
            failed
            ok evidence build_evidence => match call require_bool(got.build_directory, true, c, "build-directory")
                failed
                ok evidence directory_evidence => match call require_text(got.generated_functions, "can.project.root/app::render|can.project.root/app::fragment", c, "generated-functions")
                    failed
                    ok evidence functions_evidence => match call require_int(got.runtime_single, 1, c, "runtime-single")
                        failed
                        ok evidence runtime_evidence => match call require_int(got.harness_exit, 0, c, "harness-exit")
                            failed
                            ok evidence harness_evidence => match call require_text(got.harness_marker, "compiled request-derived HTML passed", c, "harness-marker")
                                failed
                                ok evidence marker_evidence => match call require_text(got.snapshot_empty, "{}", c, "snapshot-empty")
                                    failed
                                    ok evidence snapshot_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                        failed
                                        ok evidence profile_evidence => match call require_text(got.network_allowance, "(allow network-outbound (remote ip \"localhost:*\"))", c, "network-allowance")
                                            failed
