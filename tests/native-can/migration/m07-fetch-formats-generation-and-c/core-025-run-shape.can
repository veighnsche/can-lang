package m07core025run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-025 "bundled HTML: build plus harness run shape".
/// Source: tests/integration/html_test.go symbol TestCurrentBundledHTML.
/// Related fixture: compiler/testdata/current/html/main.can render plus
/// fragment entries (L4-43); the build leg emits the directory JSON
/// (Go L71-80) and the bun harness leg runs the compiled functions
/// (L150-166).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the production process shape. The build exits 0
/// with a directory carrying both generated functions and exactly one
/// runtime; the harness run exits 0 and logs the compiled pass marker;
/// the sandbox profiles, the run-only network allowance and the empty
/// fd snapshot pin the invocation contract, and the strict-tsc leg stays
/// conditional. Unlike silent-entry rows, the harness stdout is pinned
/// verbatim (adaptation below, CORE-014 precedent).
/// The 3-root green pin lives in core-025-roots-green.can; live HTML
/// semantics live in core-025-html-semantics.can.
/// Variants: none live in this file beyond the build plus harness path
/// itself; the hostile page/fragment variants belong to the
/// html-semantics file, and the optional CAN_TSC strict
/// generated-TypeScript leg (L81-86) is env-gated and recorded
/// blocked, never waived.
/// Adaptation: the Go test pins the harness run only by exit status
/// (L164-166: CombinedOutput error or "compiled native HTML" fatals).
/// The harness itself logs "compiled request-derived HTML passed" as
/// its pass marker (L148), pinned verbatim here as harness-marker per
/// the accepted CORE-014/019/040 non-silent-output precedent.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/DIAG/FAULT
/// and C/R/N/S/A identities bind at P23/QHTTP; no live run now.
/// Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L25).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/html-run checks: build-exit, build-directory,
/// generated-functions, runtime-single, harness-exit, harness-marker,
/// snapshot-empty, sandbox-profile, network-allowance, tsc-conditional.
/// Facet map (html_test.go legs): build-exit pins exit 0 on the build
/// (L71-74: status 0 or "build" fatals); build-directory pins the JSON
/// directory (L75-80: stdout unmarshals to a directory);
/// generated-functions pins the discovery needles verbatim (L109/L113:
/// can.project.root/app::render plus can.project.root/app::fragment or
/// "missing generated HTML functions" fatals at L119-121);
/// runtime-single pins the runtime count (L122-125: exactly 1
/// runtime/r-* glob hit or "missing runtime" fatals); harness-exit pins
/// exit 0 on the harness run (L164-166: CombinedOutput error or
/// "compiled native HTML" fatals); harness-marker pins the pass marker
/// verbatim (L148: "compiled request-derived HTML passed");
/// snapshot-empty pins the fd snapshot (L155: environment.json holds
/// "{}"; L160: passed as the extra file); sandbox-profile pins the
/// deny-network base profile (L54: "(version 1)(allow default)(deny
/// network*)" verbatim); network-allowance pins the harness-only
/// localhost allowance (L161: "(allow network-outbound (remote ip
/// "localhost:*"))" verbatim); tsc-conditional pins the optional leg
/// (L81-86: strict tsc over the emitted entry.ts runs if and only if
/// CAN_TSC is set).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int build_exit
    bool build_directory
    str generated_functions
    int runtime_single
    int harness_exit
    str harness_marker
    str snapshot_empty
    str sandbox_profile
    str network_allowance
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/html-run", "default", "", "offline"), "build-exit" => ok "case bundled/html-run variant default root build-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/html-run", "default", "", "offline"), "build-directory" => ok evidence("build-directory", "true", "true", true, "case bundled/html-run variant default root build-directory run offline")
        different: false, true, context("bundled/html-run", "default", "", "offline"), "build-directory" => failed{"build-directory"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("bundled/html-run", "default", "", "offline"), "build-exit" => ok evidence("build-exit", "0", "0", true, "case bundled/html-run variant default root build-exit run offline")
        different: 1, 0, context("bundled/html-run", "default", "", "offline"), "build-exit" => failed{"build-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "compiled request-derived HTML passed", "compiled request-derived HTML passed", context("bundled/html-run", "default", "", "offline"), "harness-marker" => ok evidence("harness-marker", "compiled request-derived HTML passed", "compiled request-derived HTML passed", true, "case bundled/html-run variant default root harness-marker run offline")
        different: "compiled HTML passed", "compiled request-derived HTML passed", context("bundled/html-run", "default", "", "offline"), "harness-marker" => failed{"harness-marker"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
