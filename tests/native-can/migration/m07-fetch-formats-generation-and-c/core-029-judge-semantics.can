fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/judge-semantics", "default", "", "offline") => ok
        seed_supplied_missing: context("bundled/judge-semantics", "seed-supplied-missing", "", "offline") => failed{"supplied-completion"}
        seed_provider_extra: context("bundled/judge-semantics", "seed-provider-extra", "", "offline") => failed{"live-provider"}
        seed_body_drift: context("bundled/judge-semantics", "seed-body-drift", "", "offline") => failed{"request-body"}
        seed_protocol_drift: context("bundled/judge-semantics", "seed-protocol-drift", "", "offline") => failed{"request-protocol"}
        seed_response_drift: context("bundled/judge-semantics", "seed-response-drift", "", "offline") => failed{"provider-response"}
        seed_state_drift: context("bundled/judge-semantics", "seed-state-drift", "", "offline") => failed{"state-exactness"}
        seed_invalid_admitted: context("bundled/judge-semantics", "seed-invalid-admitted", "", "offline") => failed{"invalid-answer"}
        seed_blank_admitted: context("bundled/judge-semantics", "seed-blank-admitted", "", "offline") => failed{"blank-descriptor"}
        seed_faulty_admitted: context("bundled/judge-semantics", "seed-faulty-admitted", "", "offline") => failed{"faulty-handler"}
        seed_root_drift: context("bundled/judge-semantics", "seed-root-drift", "", "offline") => failed{"raw-provider-root"}
        seed_raw_red: context("bundled/judge-semantics", "seed-raw-red", "", "offline") => failed{"raw-provider-passed"}
        seed_evidence_drift: context("bundled/judge-semantics", "seed-evidence-drift", "", "offline") => failed{"raw-provider-evidence"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.supplied_completion, "supplied-completion", c, "supplied-completion")
            failed
            ok evidence supplied_evidence => match call require_int(got.live_provider, 1, c, "live-provider")
                failed
                ok evidence provider_evidence => match call require_text(got.request_body, "{\"model\":\"jev-latest\",\"state\":{\"amount\":9007199254740993,\"signed_zero\":-0},\"questions\":{\"q0\":{\"type\":\"noul\",\"instructions\":\"First\",\"criteria\":{\"true\":\"Yes\",\"false\":\"No\"}},\"q1\":{\"type\":\"noul\",\"instructions\":\"Second\",\"criteria\":{\"true\":\"Yes\",\"false\":\"No\"}},\"q2\":{\"type\":\"noul\",\"instructions\":\"Unused\",\"criteria\":{\"true\":\"Yes\",\"false\":\"No\"}}}}", c, "request-body")
                    failed
                    ok evidence body_evidence => match call require_text(got.request_protocol, "POST|/systemone|Bearer test-only|application/json", c, "request-protocol")
                        failed
                        ok evidence protocol_evidence => match call require_text(got.provider_response, "{\"model\":\"resolved-model\",\"answers\":{\"q0\":{\"type\":\"noul\",\"noul\":0.5},\"q1\":{\"type\":\"noul\",\"noul\":0.25},\"q2\":{\"type\":\"noul\",\"noul\":1}}}", c, "provider-response")
                            failed
                            ok evidence response_evidence => match call require_text(got.state_exactness, "9007199254740993|-0", c, "state-exactness")
                                failed
                                ok evidence state_evidence => match call require_text(got.invalid_answer, "\"error\":\"ai::invalid_answer\"|2|stdout-empty", c, "invalid-answer")
                                    failed
                                    ok evidence invalid_evidence => match call require_text(got.blank_descriptor, "build verification failed|unused fixture|2|stdout-empty", c, "blank-descriptor")
                                        failed
                                        ok evidence blank_evidence => match call require_text(got.faulty_handler, "build verification failed|2|stdout-empty", c, "faulty-handler")
                                            failed
                                            ok evidence faulty_evidence => match call require_text(got.raw_provider_root, "conformance|compiled_judge|raw_provider", c, "raw-provider-root")
                                                failed
                                                ok evidence root_evidence => match call require_bool(got.raw_provider_passed, true, c, "raw-provider-passed")
                                                    failed
                                                    ok evidence passed_evidence => match call require_text(got.raw_provider_evidence, "raw-provider-fixture,real-can", c, "raw-provider-evidence")
                                                        failed
                                                        ok evidence labels_evidence => ok
