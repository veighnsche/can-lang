package m07core029judge
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-029 "bundled Noul judge: live semantics and stage rejection".
/// Source: tests/integration/judge_test.go symbol
/// TestCurrentBundledNoulJudge.
/// Related fixture: compiler/testdata/current/native/noul.can (classifier
/// L5-11, report L13-29, likelihood L31-38, assess L40-51, main L53-71)
/// plus the staged raw fixture fixtures/noul_assess.json.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the ordinary consumer path (supplied-completion
/// evidence with exactly 1 live provider request carrying the verbatim
/// batch body, protocol and response), the three rejection stages (the
/// invalid later answer fails at runtime after dispatching request 2; the
/// blank descriptor and the faulty handler fail build verification before
/// anything launches and dispatch nothing), and the raw-provider drive of
/// the compiled judge with no host verdict.
/// The 3-root green pin lives in core-029-roots-green.can; the production
/// process shape lives in core-029-run-shape.can.
/// Variants: normal (Go L92-102); invalid answer (L103-107); blank
/// descriptor (L108-118); faulty handler (L120-132); raw provider
/// (L134-202).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_I17_TOKEN is harness-supplied
/// (Go L79: "test-only"), not an external gate. Logical gates SUITE/DIAG/
/// FAULT and C/R/N/S/A identities bind at P23/QHTTP; no live run now.
/// Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L27).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/judge-semantics checks: supplied-completion, live-provider,
/// request-body, request-protocol, provider-response, state-exactness,
/// invalid-answer, blank-descriptor, faulty-handler, raw-provider-root,
/// raw-provider-passed, raw-provider-evidence.
/// Facet map (judge_test.go legs): supplied-completion pins the ordinary
/// consumer evidence (L95-97: assert stdout contains "supplied-completion"
/// with exit 0 and empty diagnostics); live-provider pins the live batch
/// count (L98-102: exactly 1 request across the green run plus assert
/// legs); request-body pins the batch body verbatim (L99-101: the
/// jev-latest request with the amount, signed zero and the three First/
/// Second/Unused noul questions); request-protocol pins the live headers
/// (L44: POST to /systemone with Bearer test-only and application/json);
/// provider-response pins the supplied answers verbatim (L35: the
/// resolved-model response with noul 0.5, 0.25 and 1); state-exactness
/// pins the exact state (L99: amount 9007199254740993 above float
/// precision with signed zero -0); invalid-answer pins the invalid variant
/// (L103-107: q2 noul 2 fails at runtime with empty stdout and diag
/// carrying "error":"ai::invalid_answer", after dispatching cumulative
/// request 2 per L114-117); blank-descriptor pins the blank gate (L110-118:
/// likelihood("") fails build verification with empty stdout and diag
/// carrying both "build verification failed" and "unused fixture", and
/// requests stays 2); faulty-handler pins the handler gate (L123-132: the
/// 1/0 fault fails build verification with empty stdout and diag carrying
/// "build verification failed", and requests stays 2);
/// raw-provider-root pins the compiled assertion root (L174: package
/// conformance, declaration compiled_judge, name raw_provider);
/// raw-provider-passed pins the compiled drive (L178: the report passes);
/// raw-provider-evidence pins its evidence labels (L179:
/// ["raw-provider-fixture", "real-can"]).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str supplied_completion
    int live_provider
    str request_body
    str request_protocol
    str provider_response
    str state_exactness
    str invalid_answer
    str blank_descriptor
    str faulty_handler
    str raw_provider_root
    bool raw_provider_passed
    str raw_provider_evidence
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/judge-semantics", "default", "", "offline"), "supplied-completion" => ok "case bundled/judge-semantics variant default root supplied-completion run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/judge-semantics", "default", "", "offline"), "raw-provider-passed" => ok evidence("raw-provider-passed", "true", "true", true, "case bundled/judge-semantics variant default root raw-provider-passed run offline")
        different: false, true, context("bundled/judge-semantics", "default", "", "offline"), "raw-provider-passed" => failed{"raw-provider-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("bundled/judge-semantics", "default", "", "offline"), "live-provider" => ok evidence("live-provider", "1", "1", true, "case bundled/judge-semantics variant default root live-provider run offline")
        different: 2, 1, context("bundled/judge-semantics", "default", "", "offline"), "live-provider" => failed{"live-provider"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "supplied-completion", "supplied-completion", context("bundled/judge-semantics", "default", "", "offline"), "supplied-completion" => ok evidence("supplied-completion", "supplied-completion", "supplied-completion", true, "case bundled/judge-semantics variant default root supplied-completion run offline")
        different: "other-label", "supplied-completion", context("bundled/judge-semantics", "default", "", "offline"), "supplied-completion" => failed{"supplied-completion"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
