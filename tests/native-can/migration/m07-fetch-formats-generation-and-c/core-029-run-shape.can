fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/judge-run", "default", "", "offline") => ok
        seed_run_red: context("bundled/judge-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stdout_drift: context("bundled/judge-run", "seed-stdout-drift", "", "offline") => failed{"run-stdout"}
        seed_stderr_noisy: context("bundled/judge-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_assert_red: context("bundled/judge-run", "seed-assert-red", "", "offline") => failed{"assert-exit"}
        seed_assert_noisy: context("bundled/judge-run", "seed-assert-noisy", "", "offline") => failed{"assert-stderr-empty"}
        seed_label_drift: context("bundled/judge-run", "seed-label-drift", "", "offline") => failed{"assert-stdout-label"}
        seed_profile_drift: context("bundled/judge-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_env_drift: context("bundled/judge-run", "seed-env-drift", "", "offline") => failed{"credential-env"}
        seed_build_red: context("bundled/judge-run", "seed-build-red", "", "offline") => failed{"build-exit"}
        seed_directory_missing: context("bundled/judge-run", "seed-directory-missing", "", "offline") => failed{"build-directory"}
        seed_import_drift: context("bundled/judge-run", "seed-import-drift", "", "offline") => failed{"main-import"}
        seed_runtime_zero: context("bundled/judge-run", "seed-runtime-zero", "", "offline") => failed{"runtime-single"}
        seed_harness_red: context("bundled/judge-run", "seed-harness-red", "", "offline") => failed{"harness-exit"}
        seed_snapshot_drift: context("bundled/judge-run", "seed-snapshot-drift", "", "offline") => failed{"harness-snapshot"}
        seed_harness_profile_drift: context("bundled/judge-run", "seed-harness-profile-drift", "", "offline") => failed{"harness-profile"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_text(got.run_stdout, "TFT", c, "run-stdout")
                failed
                ok evidence stdout_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                    failed
                    ok evidence stderr_evidence => match call require_int(got.assert_exit, 0, c, "assert-exit")
                        failed
                        ok evidence assert_exit_evidence => match call require_bool(got.assert_stderr_empty, true, c, "assert-stderr-empty")
                            failed
                            ok evidence assert_stderr_evidence => match call require_text(got.assert_stdout_label, "supplied-completion", c, "assert-stdout-label")
                                failed
                                ok evidence label_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", c, "sandbox-profile")
                                    failed
                                    ok evidence profile_evidence => match call require_text(got.credential_env, "CAN_I17_TOKEN=test-only", c, "credential-env")
                                        failed
                                        ok evidence env_evidence => match call require_int(got.build_exit, 0, c, "build-exit")
                                            failed
                                            ok evidence build_evidence => match call require_bool(got.build_directory, true, c, "build-directory")
                                                failed
                                                ok evidence directory_evidence => match call require_text(got.main_import, "as $canMain", c, "main-import")
                                                    failed
                                                    ok evidence import_evidence => match call require_int(got.runtime_single, 1, c, "runtime-single")
                                                        failed
                                                        ok evidence runtime_evidence => match call require_int(got.harness_exit, 0, c, "harness-exit")
                                                            failed
                                                            ok evidence harness_evidence => match call require_text(got.harness_snapshot, "{}", c, "harness-snapshot")
                                                                failed
                                                                ok evidence snapshot_evidence => match call require_text(got.harness_profile, "(version 1)(allow default)(deny network*)", c, "harness-profile")
                                                                    failed
                                                                    ok evidence harness_profile_evidence => ok
fn test_case descriptor
    emits {}
    given
