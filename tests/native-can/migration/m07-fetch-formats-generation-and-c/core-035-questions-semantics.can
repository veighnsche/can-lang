fn check[] checks
    emits {}
    given
        str scope
    asserts
        m07_035: "m07-035" => ok [check("batch-request", "first-stage batch body matches verbatim"), check("request-headers", "live requests pin POST to /systemone with the Bearer [REDACTED] JSON headers"), check("answer-kinds", "q0-q7 pins the five answer kinds in order"), check("invalid-answer", "invalid answer maps to ai::invalid_answer"), check("invalid-silent", "invalid answer exits nonzero with empty stdout"), check("duplicate-rejects", "duplicate criterion rejects with verification failure and unused fixture"), check("duplicate-silent", "duplicate criterion launches no request"), check("handler-rejects", "handler fault rejects with verification failure"), check("handler-silent", "handler fault dispatches no request"), check("record-rejects", "record fault rejects with verification failure"), check("record-silent", "record fault dispatches no request"), check("confidence-fallback", "lower confidence falls back with verbatim output"), check("second-stage", "followup request pins the prior result verbatim"), check("followup-judge", "nested complete judge pins live and staged previous"), check("two-stage", "two-stage run keeps the green output verbatim"), check("mixed-requests", "mixed phases issue exactly 5 requests"), check("raw-build-exit", "authless raw-provider build exits 0"), check("raw-request", "raw comparison pins method, path, headers and batch body"), check("raw-sandbox", "raw harness pins the deny-network sandbox profile"), check("raw-report", "raw assertion passes with pinned evidence"), check("emitted-shape", "emitted entry pins the main import and one shared runtime"), check("strict-ts", "strict tsc leg runs only when CAN_TSC is set")]
        other: "nope" => ok []
    match scope is "m07-035"
        false => ok []
        true => ok [check("batch-request", "first-stage batch body matches verbatim"), check("request-headers", "live requests pin POST to /systemone with the Bearer [REDACTED] JSON headers"), check("answer-kinds", "q0-q7 pins the five answer kinds in order"), check("invalid-answer", "invalid answer maps to ai::invalid_answer"), check("invalid-silent", "invalid answer exits nonzero with empty stdout"), check("duplicate-rejects", "duplicate criterion rejects with verification failure and unused fixture"), check("duplicate-silent", "duplicate criterion launches no request"), check("handler-rejects", "handler fault rejects with verification failure"), check("handler-silent", "handler fault dispatches no request"), check("record-rejects", "record fault rejects with verification failure"), check("record-silent", "record fault dispatches no request"), check("confidence-fallback", "lower confidence falls back with verbatim output"), check("second-stage", "followup request pins the prior result verbatim"), check("followup-judge", "nested complete judge pins live and staged previous"), check("two-stage", "two-stage run keeps the green output verbatim"), check("mixed-requests", "mixed phases issue exactly 5 requests"), check("raw-build-exit", "authless raw-provider build exits 0"), check("raw-request", "raw comparison pins method, path, headers and batch body"), check("raw-sandbox", "raw harness pins the deny-network sandbox profile"), check("raw-report", "raw assertion passes with pinned evidence"), check("emitted-shape", "emitted entry pins the main import and one shared runtime"), check("strict-ts", "strict tsc leg runs only when CAN_TSC is set")]
