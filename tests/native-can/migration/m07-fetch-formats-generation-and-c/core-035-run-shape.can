package m07core035run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M07 CORE-035 "bundled mixed questions: production run shape".
/// Source: tests/integration/questions_test.go symbol
/// TestCurrentBundledMixedQuestions.
/// Related fixture: compiler/testdata/current/native/questions.can main entry
/// (L158-176); the live run helper (L118-135) executes the sandboxed binary
/// under the deny-network profile plus a localhost-only allowance.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the production process shape. The green run
/// exits 0 with the verbatim 12-marker stdout "NBSCDEFLGRLH" and empty
/// stderr; the sandbox profile, the run-only network allowance and the
/// credential env plumbing pin the invocation contract, and the strict-tsc
/// leg stays conditional.
/// ADAPTATION (accepted CORE-014/019/040 precedent): questions main emits
/// marker output by design (fixture report/io::stdout_write relays; Go
/// L136 pins "NBSCDEFLGRLH"), so this row has no silent production path;
/// the verbatim stdout pin replaces run-stdout-empty here, and silence
/// pins land where silence holds (run-stderr-empty; the invalid-silent
/// and gate-silence pins in the semantics file).
/// The 8-root green pin lives in core-035-roots-green.can; live question
/// semantics live in core-035-questions-semantics.can.
/// Variants: none live in this file beyond the green run path itself;
/// invalid/duplicate/handler/record gates, confidence fallback, two-stage
/// followup and the raw-provider leg belong to the semantics file, and
/// the optional CAN_TSC strict generated-TypeScript leg (L285-290) is
/// env-gated and recorded blocked, never waived.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_I27_TOKEN is harness-supplied
/// (Go L123: "test-only"), not an external gate. Logical gates
/// SUITE/DIAG/FAULT and C/R/N/S/A identities bind at P23/QHTTP; no live
/// run now. Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L62).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case bundled/questions-run checks: run-exit, run-stdout,
/// run-stderr-empty, sandbox-profile, network-allowance, credential-env,
/// tsc-conditional.
/// Facet map (questions_test.go legs): run-exit pins exit 0 on the green run
/// (L136: status 0 or "judge execution" fatals); run-stdout pins the green
/// stdout verbatim (L136: out must be "NBSCDEFLGRLH"; adaptation above);
/// run-stderr-empty pins empty stderr on the green run (L136: diag must be
/// ""); sandbox-profile pins the invocation profile verbatim (L120:
/// "(version 1)(allow default)(deny network*)(allow network-outbound
/// (remote ip "localhost:*"))"); network-allowance pins the run-only
/// localhost allowance (the L120 clause "(allow network-outbound (remote
/// ip "localhost:*"))"); credential-env pins the credential plumbing
/// (L123: CAN_I27_TOKEN set in the run environment); tsc-conditional pins
/// the optional leg (L285-290: strict tsc over emitted entry.ts via the
/// bundle bun runs if and only if CAN_TSC is set).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    str run_stdout
    bool run_stderr_empty
    str sandbox_profile
    str network_allowance
    str credential_env
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("bundled/questions-run", "default", "", "offline"), "run-exit" => ok "case bundled/questions-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("bundled/questions-run", "default", "", "offline"), "run-stderr-empty" => ok evidence("run-stderr-empty", "true", "true", true, "case bundled/questions-run variant default root run-stderr-empty run offline")
        different: false, true, context("bundled/questions-run", "default", "", "offline"), "run-stderr-empty" => failed{"run-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("bundled/questions-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case bundled/questions-run variant default root run-exit run offline")
        different: 1, 0, context("bundled/questions-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "NBSCDEFLGRLH", "NBSCDEFLGRLH", context("bundled/questions-run", "default", "", "offline"), "run-stdout" => ok evidence("run-stdout", "NBSCDEFLGRLH", "NBSCDEFLGRLH", true, "case bundled/questions-run variant default root run-stdout run offline")
        different: "NBSCDEFLGRLX", "NBSCDEFLGRLH", context("bundled/questions-run", "default", "", "offline"), "run-stdout" => failed{"run-stdout"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
