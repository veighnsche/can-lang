        seed_run_red: "seed-run-red" => ok observation(1, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        seed_stdout_drift: "seed-stdout-drift" => ok observation(0, "NBSCDEFLGRLX", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        seed_stderr_noisy: "seed-stderr-noisy" => ok observation(0, "NBSCDEFLGRLH", false, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        seed_profile_drift: "seed-profile-drift" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        seed_allowance_drift: "seed-allowance-drift" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound)", "CAN_I27_TOKEN", true)
        seed_env_drift: "seed-env-drift" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_TOKEN", true)
        seed_tsc_unconditional: "seed-tsc-unconditional" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", false)
    match variant_id
        "seed-run-red" => ok observation(1, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        "seed-stdout-drift" => ok observation(0, "NBSCDEFLGRLX", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        "seed-stderr-noisy" => ok observation(0, "NBSCDEFLGRLH", false, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        "seed-profile-drift" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
        "seed-allowance-drift" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound)", "CAN_I27_TOKEN", true)
        "seed-env-drift" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_TOKEN", true)
        "seed-tsc-unconditional" => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", false)
        _ => ok observation(0, "NBSCDEFLGRLH", true, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", "(allow network-outbound (remote ip \"localhost:*\"))", "CAN_I27_TOKEN", true)
fn check[] checks
    emits {}
    given
