        true => ok [check("run-exit", "green run exits 0"), check("run-stdout", "green run prints NBSCDEFLGRLH verbatim"), check("run-stderr-empty", "green run keeps stderr empty"), check("sandbox-profile", "invocation pins the full sandbox profile"), check("network-allowance", "run pins the localhost-only network allowance"), check("credential-env", "run environment carries CAN_I27_TOKEN"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "bundled/questions-run" => ok [expected_check("run-exit", "0"), expected_check("run-stdout", "NBSCDEFLGRLH"), expected_check("run-stderr-empty", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))"), expected_check("network-allowance", "(allow network-outbound (remote ip \"localhost:*\"))"), expected_check("credential-env", "CAN_I27_TOKEN"), expected_check("tsc-conditional", "true")]
