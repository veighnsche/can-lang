    asserts
        m07_035: "m07-035" => ok [check("run-exit", "green run exits 0"), check("run-stdout", "green run prints NBSCDEFLGRLH verbatim"), check("run-stderr-empty", "green run keeps stderr empty"), check("sandbox-profile", "invocation pins the full sandbox profile"), check("network-allowance", "run pins the localhost-only network allowance"), check("credential-env", "run environment carries CAN_I27_TOKEN"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set")]
        other: "nope" => ok []
    match scope is "m07-035"
