        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stdout", "NBSCDEFLGRLH"), expected_check("run-stderr-empty", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))"), expected_check("network-allowance", "(allow network-outbound (remote ip \"localhost:*\"))"), expected_check("credential-env", "CAN_I27_TOKEN"), expected_check("tsc-conditional", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("bundled/questions-run", "default", "", "offline") => ok
        seed_run_red: context("bundled/questions-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stdout_drift: context("bundled/questions-run", "seed-stdout-drift", "", "offline") => failed{"run-stdout"}
        seed_stderr_noisy: context("bundled/questions-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_profile_drift: context("bundled/questions-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_allowance_drift: context("bundled/questions-run", "seed-allowance-drift", "", "offline") => failed{"network-allowance"}
        seed_env_drift: context("bundled/questions-run", "seed-env-drift", "", "offline") => failed{"credential-env"}
        seed_tsc_unconditional: context("bundled/questions-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence run_exit_evidence => match call require_text(got.run_stdout, "NBSCDEFLGRLH", c, "run-stdout")
                failed
                ok evidence run_stdout_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                    failed
                    ok evidence run_stderr_empty_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", c, "sandbox-profile")
                        failed
                        ok evidence sandbox_profile_evidence => match call require_text(got.network_allowance, "(allow network-outbound (remote ip \"localhost:*\"))", c, "network-allowance")
                            failed
                            ok evidence network_allowance_evidence => match call require_text(got.credential_env, "CAN_I27_TOKEN", c, "credential-env")
                                failed
                                ok evidence credential_env_evidence => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                    failed
                                    ok evidence tsc_conditional_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m07_035: "m07-035" => ok test_case("bundled/questions-run", ["questions", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stdout"), check_ref("run-stderr-empty"), check_ref("sandbox-profile"), check_ref("network-allowance"), check_ref("credential-env"), check_ref("tsc-conditional")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m07-035"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("bundled/questions-run", ["questions", "m07"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stdout"), check_ref("run-stderr-empty"), check_ref("sandbox-profile"), check_ref("network-allowance"), check_ref("credential-env"), check_ref("tsc-conditional")], callable case_body)
