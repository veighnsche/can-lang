fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("cookies/session-cookies", "default", "", "offline") => ok
        seed_boot_fail: context("cookies/session-cookies", "seed-boot-fail", "", "offline") => failed{"boot-ok"}
        seed_establish_red: context("cookies/session-cookies", "seed-establish-red", "", "offline") => failed{"establish-status"}
        seed_setcookie_empty: context("cookies/session-cookies", "seed-setcookie-empty", "", "offline") => failed{"setcookie-count"}
        seed_setcookie_drift: context("cookies/session-cookies", "seed-setcookie-drift", "", "offline") => failed{"setcookie-prefix"}
        seed_mint_fail: context("cookies/session-cookies", "seed-mint-fail", "", "offline") => failed{"mint-ok"}
        seed_bare_green: context("cookies/session-cookies", "seed-bare-green", "", "offline") => failed{"bare-status"}
        seed_bare_body_drift: context("cookies/session-cookies", "seed-bare-body-drift", "", "offline") => failed{"bare-body"}
        seed_welcome_red: context("cookies/session-cookies", "seed-welcome-red", "", "offline") => failed{"welcome-status"}
        seed_welcome_body_drift: context("cookies/session-cookies", "seed-welcome-body-drift", "", "offline") => failed{"welcome-body"}
        seed_cross_green: context("cookies/session-cookies", "seed-cross-green", "", "offline") => failed{"cross-status"}
        seed_cross_body_drift: context("cookies/session-cookies", "seed-cross-body-drift", "", "offline") => failed{"cross-body"}
        seed_bogus_green: context("cookies/session-cookies", "seed-bogus-green", "", "offline") => failed{"bogus-status"}
        seed_bogus_body_drift: context("cookies/session-cookies", "seed-bogus-body-drift", "", "offline") => failed{"bogus-body"}
        seed_stop_fail: context("cookies/session-cookies", "seed-stop-fail", "", "offline") => failed{"stop-ok"}
        seed_wait_fail: context("cookies/session-cookies", "seed-wait-fail", "", "offline") => failed{"wait-ok"}
        seed_completion_fail: context("cookies/session-cookies", "seed-completion-fail", "", "offline") => failed{"owned-completion-ok"}
        seed_cleanup_fail: context("cookies/session-cookies", "seed-cleanup-fail", "", "offline") => failed{"cleanup-clean"}
        seed_marker_drift: context("cookies/session-cookies", "seed-marker-drift", "", "offline") => failed{"lifecycle-marker"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.boot_ok, true, c, "boot-ok")
            failed
            ok evidence boot_evidence => match call require_int(got.establish_status, 200, c, "establish-status")
                failed
                ok evidence establish_evidence => match call require_int(got.setcookie_count, 1, c, "setcookie-count")
                    failed
                    ok evidence count_evidence => match call require_text(got.setcookie_prefix, "session=A;", c, "setcookie-prefix")
                        failed
                        ok evidence prefix_evidence => match call require_bool(got.mint_ok, true, c, "mint-ok")
                            failed
                            ok evidence mint_evidence => match call require_int(got.bare_status, 422, c, "bare-status")
                                failed
                                ok evidence bare_status_evidence => match call require_text(got.bare_body, "bad", c, "bare-body")
                                    failed
                                    ok evidence bare_body_evidence => match call require_int(got.welcome_status, 200, c, "welcome-status")
                                        failed
                                        ok evidence welcome_status_evidence => match call require_text(got.welcome_body, "welcome", c, "welcome-body")
                                            failed
                                            ok evidence welcome_body_evidence => match call require_int(got.cross_status, 422, c, "cross-status")
                                                failed
                                                ok evidence cross_status_evidence => match call require_text(got.cross_body, "bad", c, "cross-body")
                                                    failed
                                                    ok evidence cross_body_evidence => match call require_int(got.bogus_status, 422, c, "bogus-status")
                                                        failed
                                                        ok evidence bogus_status_evidence => match call require_text(got.bogus_body, "bad", c, "bogus-body")
                                                            failed
                                                            ok evidence bogus_body_evidence => match call require_bool(got.stop_ok, true, c, "stop-ok")
                                                                failed
                                                                ok evidence stop_evidence => match call require_bool(got.wait_ok, true, c, "wait-ok")
                                                                    failed
                                                                    ok evidence wait_evidence => match call require_bool(got.owned_completion_ok, true, c, "owned-completion-ok")
                                                                        failed
                                                                        ok evidence completion_evidence => match call require_bool(got.cleanup_clean, true, c, "cleanup-clean")
                                                                            failed
                                                                            ok evidence cleanup_evidence => match call require_text(got.lifecycle_marker, "compiled cookies lifecycle passed", c, "lifecycle-marker")
                                                                                failed
                                                                                ok evidence marker_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m08_011: "m08-011" => ok test_case("cookies/session-cookies", ["cookies", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("boot-ok"), check_ref("establish-status"), check_ref("setcookie-count"), check_ref("setcookie-prefix"), check_ref("mint-ok"), check_ref("bare-status"), check_ref("bare-body"), check_ref("welcome-status"), check_ref("welcome-body"), check_ref("cross-status"), check_ref("cross-body"), check_ref("bogus-status"), check_ref("bogus-body"), check_ref("stop-ok"), check_ref("wait-ok"), check_ref("owned-completion-ok"), check_ref("cleanup-clean"), check_ref("lifecycle-marker")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m08-011"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("cookies/session-cookies", ["cookies", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("boot-ok"), check_ref("establish-status"), check_ref("setcookie-count"), check_ref("setcookie-prefix"), check_ref("mint-ok"), check_ref("bare-status"), check_ref("bare-body"), check_ref("welcome-status"), check_ref("welcome-body"), check_ref("cross-status"), check_ref("cross-body"), check_ref("bogus-status"), check_ref("bogus-body"), check_ref("stop-ok"), check_ref("wait-ok"), check_ref("owned-completion-ok"), check_ref("cleanup-clean"), check_ref("lifecycle-marker")], callable case_body)
