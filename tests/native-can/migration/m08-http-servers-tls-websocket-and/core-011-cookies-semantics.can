package m08core011cookies
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M08 CORE-011 "cookies session: live lifecycle, session CSRF rejects".
/// Source: tests/integration/cookies_csrf_test.go symbol
/// TestCurrentBundledCookiesCSRF (L17-195).
/// Related fixture: compiler/testdata/current/cookies/session.can (read at
/// L46, staged as src/main.can at L50); the lifecycle pins ground the
/// establish handler (fixture L136-147: strict session cookie, 200
/// established) and the login guard (fixture L107-133: scan Cookie,
/// project session, verify query token; 422 bad on missing session,
/// bogus token or failed verify; 200 welcome on valid verify).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the compiled cookies lifecycle over the owned
/// server: boot returns ok, establish sets the session cookie, bare
/// token rejects, matching theme/session cookie succeeds, wrong session
/// and bogus token reject, stop and wait return ok, the owned root
/// completes clean, and the harness prints its marker.
/// The roots-green pin lives in core-011-roots-green.can; the production
/// process shape lives in core-011-run-shape.can.
/// Variants: establish (L154-158); bare token (L162-163); matching
/// theme/session cookie (L164-165); wrong session (L166-167); bogus
/// token (L168-169); stop/wait (L170-171).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_TSC gates the optional strict
/// tsc leg (pinned conditional in the run-shape file). Logical gates
/// SUITE/WORK/PROC and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case cookies/session-cookies checks: boot-ok, establish-status,
/// setcookie-count, setcookie-prefix, mint-ok, bare-status, bare-body,
/// welcome-status, welcome-body, cross-status, cross-body,
/// bogus-status, bogus-body, stop-ok, wait-ok, owned-completion-ok,
/// cleanup-clean, lifecycle-marker.
/// Facet map (cookies_csrf_test.go harness, L144-176): boot-ok pins the
/// boot result (L151-152: boot(18374n) kind is ok); establish-status
/// pins the establish status (L154-155: 200); setcookie-count pins the
/// cookie fields (L156-157: getSetCookie length 1); setcookie-prefix
/// pins the session field (L158: starts with "session=A;"); mint-ok
/// pins the mint result (L159-160: kind is ok); bare-status pins the
/// bare token status (L162-163: 422, no cookie header); bare-body pins
/// the bare token body (L163: "bad"); welcome-status pins the match
/// status (L164-165: cookie "theme=dark; session=A" answers 200);
/// welcome-body pins the match body (L165: "welcome"); cross-status pins
/// the wrong-session status (L166-167: cookie "session=B" answers 422);
/// cross-body pins the wrong-session body (L167: "bad"); bogus-status
/// pins the bogus-token status (L168-169: token bogus with session=A
/// answers 422); bogus-body pins the bogus-token body (L169: "bad");
/// stop-ok pins the stop result (L170: $canServer.stop kind is ok);
/// wait-ok pins the wait result (L171: $canServer.wait kind is ok);
/// owned-completion-ok pins the owned completion (L174:
/// owned.completion.kind is ok); cleanup-clean pins clean teardown
/// (L174: cleanupFailed is false); lifecycle-marker pins the harness
/// marker (L175: "compiled cookies lifecycle passed" verbatim; the
/// harness prints it only after every lifecycle assertion passes).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool boot_ok
    int establish_status
    int setcookie_count
    str setcookie_prefix
    bool mint_ok
    int bare_status
    str bare_body
    int welcome_status
    str welcome_body
    int cross_status
    str cross_body
    int bogus_status
    str bogus_body
    bool stop_ok
    bool wait_ok
    bool owned_completion_ok
    bool cleanup_clean
    str lifecycle_marker
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cookies/session-cookies", "default", "", "offline"), "boot-ok" => ok "case cookies/session-cookies variant default root boot-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cookies/session-cookies", "default", "", "offline"), "boot-ok" => ok evidence("boot-ok", "true", "true", true, "case cookies/session-cookies variant default root boot-ok run offline")
        different: false, true, context("cookies/session-cookies", "default", "", "offline"), "boot-ok" => failed{"boot-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("cookies/session-cookies", "default", "", "offline"), "establish-status" => ok evidence("establish-status", "200", "200", true, "case cookies/session-cookies variant default root establish-status run offline")
        different: 500, 200, context("cookies/session-cookies", "default", "", "offline"), "establish-status" => failed{"establish-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "session=A;", "session=A;", context("cookies/session-cookies", "default", "", "offline"), "setcookie-prefix" => ok evidence("setcookie-prefix", "session=A;", "session=A;", true, "case cookies/session-cookies variant default root setcookie-prefix run offline")
        different: "session=B;", "session=A;", context("cookies/session-cookies", "default", "", "offline"), "setcookie-prefix" => failed{"setcookie-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
