package m08core011run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M08 CORE-011 "cookies session: run shape, compile and serve split".
/// Source: tests/integration/cookies_csrf_test.go symbol
/// TestCurrentBundledCookiesCSRF (L17-195).
/// Related fixture: compiler/testdata/current/cookies/session.can main
/// (fixture L177-187: table build only, no output); the sandboxed runAt
/// helper (L51-69) drives assert/run/build with PATH=/nonexistent, while
/// the compiled lifecycle harness (L144-194) runs under the
/// localhost-network profile with the empty fd-3 environment snapshot
/// (L182-191).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the session build
/// and serve. The run leg is silent on stderr by assertion (L81-84:
/// exit 0 and empty diagnostics); run stdout is unpinned because the Go
/// test discards it (L81), so no run-stdout pin is authored here. The
/// only non-silent output the Go test pins is the compiled harness's own
/// lifecycle marker, pinned verbatim in the cookies-semantics file
/// (lifecycle-marker, L175). Build exits 0, the emitted bundle carries
/// app::boot and app::mint with exactly one vendored runtime, and the
/// harness succeeds under its localhost profile.
/// The roots-green pin lives in core-011-roots-green.can; the live
/// lifecycle pins live in core-011-cookies-semantics.can.
/// Variants: build/run only (L81-88); the optional CAN_TSC strict
/// generated-TypeScript leg (L95-100) is env-gated and recorded blocked,
/// never waived.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 120000ms mirrors the Go 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case cookies/session-run checks: run-exit, run-stderr-empty,
/// build-exit, boot-identity, mint-identity, single-runtime,
/// snapshot-empty, sandbox-profile, harness-profile, offline-ok,
/// tsc-conditional, harness-ok.
/// Facet map (cookies_csrf_test.go legs): run-exit pins exit 0 on the
/// run leg (L81-84: status 0 or the test fatals); run-stderr-empty pins
/// empty stderr on the run leg (L82: diag must be ""); build-exit pins
/// exit 0 on the build leg (L85-88: status 0 or the test fatals);
/// boot-identity pins the generated boot function (L102/L134-138:
/// "app::boot" must resolve in the emitted TypeScript); mint-identity
/// pins the generated mint function (L102/L134-138: "app::mint" must
/// resolve); single-runtime pins the vendored runtime (L139-142:
/// exactly one runtime/r-* directory or the test fatals);
/// snapshot-empty pins the empty environment snapshot (L183:
/// environment.json holds "{}"; L191: passed as fd 3);
/// sandbox-profile pins the offline invocation shape (L53: "(version
/// 1)(allow default)(deny network*)" verbatim); harness-profile pins the
/// lifecycle invocation shape (L189: the localhost-network profile
/// verbatim); offline-ok pins the offline behavior (L53-57/L70-88: the
/// sandboxed deny-network assert/run/build with PATH=/nonexistent
/// succeed); tsc-conditional pins the optional leg (L95-100: strict tsc
/// over the emitted entry.ts runs if and only if CAN_TSC is set);
/// harness-ok pins the compiled lifecycle success (L192-194: the
/// harness CombinedOutput must succeed).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stderr_empty
    int build_exit
    str boot_identity
    str mint_identity
    bool single_runtime
    str snapshot_empty
    str sandbox_profile
    str harness_profile
    bool offline_ok
    bool tsc_conditional
    bool harness_ok
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cookies/session-run", "default", "", "offline"), "run-exit" => ok "case cookies/session-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cookies/session-run", "default", "", "offline"), "run-stderr-empty" => ok evidence("run-stderr-empty", "true", "true", true, "case cookies/session-run variant default root run-stderr-empty run offline")
        different: false, true, context("cookies/session-run", "default", "", "offline"), "run-stderr-empty" => failed{"run-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("cookies/session-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case cookies/session-run variant default root run-exit run offline")
        different: 1, 0, context("cookies/session-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "app::boot", "app::boot", context("cookies/session-run", "default", "", "offline"), "boot-identity" => ok evidence("boot-identity", "app::boot", "app::boot", true, "case cookies/session-run variant default root boot-identity run offline")
        different: "app::serve", "app::boot", context("cookies/session-run", "default", "", "offline"), "boot-identity" => failed{"boot-identity"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
