package m08core026http
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M08 CORE-026 "http dispatch: queries, posts, routes, methods, streams".
/// Source: tests/integration/http_test.go symbol
/// TestCurrentBundledHTTP (L17-233); the embedded TypeScript harness
/// (L135-215) drives loopback ingress over the compiled mounted router
/// and checks every reply below (L157-212).
/// Related fixture: compiler/testdata/current/http/main.can route table
/// (L256-272: /a handle, /b submit, /g tagged, /w wrapped, /s search,
/// /p handle PUT+PATCH, /d handle DELETE, /o handle OPTIONS, /h handle
/// HEAD, /u upload streamed, /echo stream_echo streamed, /events events,
/// /attach attach) with handlers (handle L11-27, submit L28-42,
/// search L50-64, tagged L86-93, upload L94-123, stream_echo L124-159,
/// events L160-189, attach L190-206).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): compiled dispatch replies. Scenario replies pin
/// status|body (status alone where the Go test asserts no body); 405
/// replies pin status|allow since the Go test asserts the Allow header
/// instead of a body; content headers pin verbatim header values.
/// The roots-green pin lives in core-026-roots-green.can; the production
/// process shape lives in core-026-run-shape.can.
/// Variants: GET /a valid/absent/repeated/plus/percent-encoded (Go
/// L157-164); POST /b JSON/media/malformed (L165-173); /s form
/// duplicate/optional/empty/absent/broken (L174-185); /g and /w
/// (L186-189); missing/method mismatches and Allow (L190-195);
/// PUT/PATCH/DELETE/OPTIONS/HEAD and Allow sets (L196-204);
/// upload/echo/events/multipart (L205-212).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_TSC gates the optional strict
/// tsc leg (pinned conditional in the run-shape file). Logical gates
/// SUITE/WORK/PROC and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case http/http-dispatch checks: get-valid, get-absent, get-repeated,
/// get-plus, get-encoded, get-content-type, post-json,
/// post-json-content-type, post-media, post-malformed, form-duplicate,
/// form-optional, form-empty, form-absent, form-broken, generic-route,
/// wrapped-route, not-found, method-post-a, method-get-b,
/// method-head-a, put-route, patch-route, delete-route, options-route,
/// head-route, head-content-length, allow-post-p, allow-purge-d,
/// upload-chunk, upload-empty, stream-echo, events-body,
/// events-content-type, multipart-attach.
/// Facet map (http_test.go harness legs): get-valid pins /a?q=v
/// (L158: 200 GET); get-absent pins the missing query (L159: 422
/// missing); get-repeated pins repeated q (L160: 422, no body asserted);
/// get-plus pins plus decoding (L161: 200, no body asserted);
/// get-encoded pins percent decoding (L162: 200, no body asserted);
/// get-content-type pins the reply header (L163: text/plain;
/// charset=utf-8); post-json pins valid JSON (L166-167: 200 x);
/// post-json-content-type pins its header (L168: text/plain;
/// charset=utf-8); post-media pins media rejection (L169-170: 422 bad);
/// post-malformed pins malformed JSON (L171-172: 422, no body asserted);
/// form-duplicate pins duplicate tags (L175-176: 200 ann);
/// form-optional pins the optional note (L177-178: 200 ann);
/// form-empty pins the empty query (L179-180: 200 with empty body);
/// form-absent pins the missing query (L181-182: 422, no body asserted);
/// form-broken pins invalid percent (L183-184: body query=%FF renders
/// from the %%FF Sprintf escape; 422, no body asserted); generic-route
/// pins /g (L187: 200 t); wrapped-route pins POST /w?q=v (L188: 200
/// POST); not-found pins /nope (L191: 404 Not Found); method-post-a
/// pins POST /a (L192: 405 Allow GET); method-get-b pins GET /b (L193:
/// 405 Allow POST); method-head-a pins HEAD /a (L194: 405 Allow GET);
/// put-route pins PUT /p?q=v (L197: 200 PUT); patch-route pins PATCH
/// /p?q=v (L198: 200 PATCH); delete-route pins DELETE /d?q=v (L199:
/// 200 DELETE); options-route pins OPTIONS /o?q=v (L200: 200 OPTIONS);
/// head-route pins HEAD /h?q=v (L201: 200 with empty body);
/// head-content-length pins its header (L201: content-length 4);
/// allow-post-p pins POST /p (L202: 405 Allow PATCH, PUT verbatim
/// order); allow-purge-d pins PURGE /d (L203: 405 Allow DELETE);
/// upload-chunk pins the bounded upload (L206: 200 hell, the 4-byte
/// head of hello-world); upload-empty pins the empty upload (L207: 200
/// empty); stream-echo pins the echo (L208: 200 stream-me);
/// events-body pins the event payload (L209: 200 with the exact
/// beat/id-7/tick/comment bytes); events-content-type pins its header
/// (L209: text/event-stream; charset=utf-8); multipart-attach pins the
/// attachment (L211: 200 v|a.txt, first field plus filename).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str get_valid
    str get_absent
    str get_repeated
    str get_plus
    str get_encoded
    str get_content_type
    str post_json
    str post_json_content_type
    str post_media
    str post_malformed
    str form_duplicate
    str form_optional
    str form_empty
    str form_absent
    str form_broken
    str generic_route
    str wrapped_route
    str not_found
    str method_post_a
    str method_get_b
    str method_head_a
    str put_route
    str patch_route
    str delete_route
    str options_route
    str head_route
    str head_content_length
    str allow_post_p
    str allow_purge_d
    str upload_chunk
    str upload_empty
    str stream_echo
    str events_body
    str events_content_type
    str multipart_attach
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("http/http-dispatch", "default", "", "offline"), "get-valid" => ok "case http/http-dispatch variant default root get-valid run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("http/http-dispatch", "default", "", "offline"), "dispatch-green" => ok evidence("dispatch-green", "true", "true", true, "case http/http-dispatch variant default root dispatch-green run offline")
        different: false, true, context("http/http-dispatch", "default", "", "offline"), "dispatch-green" => failed{"dispatch-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 35, 35, context("http/http-dispatch", "default", "", "offline"), "reply-count" => ok evidence("reply-count", "35", "35", true, "case http/http-dispatch variant default root reply-count run offline")
        different: 34, 35, context("http/http-dispatch", "default", "", "offline"), "reply-count" => failed{"reply-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "200|GET", "200|GET", context("http/http-dispatch", "default", "", "offline"), "get-valid" => ok evidence("get-valid", "200|GET", "200|GET", true, "case http/http-dispatch variant default root get-valid run offline")
        different: "200|POST", "200|GET", context("http/http-dispatch", "default", "", "offline"), "get-valid" => failed{"get-valid"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("200|GET", "422|missing", "422", "200", "200", "text/plain; charset=utf-8", "200|x", "text/plain; charset=utf-8", "422|bad", "422", "200|ann", "200|ann", "200|", "422", "422", "200|t", "200|POST", "404|Not Found", "405|GET", "405|POST", "405|GET", "200|PUT", "200|PATCH", "200|DELETE", "200|OPTIONS", "200|", "4", "405|PATCH, PUT", "405|DELETE", "200|hell", "200|empty", "200|stream-me", "200|event: beat\nid: 7\ndata: tick\n\n: still here\n\n", "text/event-stream; charset=utf-8", "200|v|a.txt")
        seed_get_valid_drift: "seed-get-valid-drift" => ok observation("200|POST", "422|missing", "422", "200", "200", "text/plain; charset=utf-8", "200|x", "text/plain; charset=utf-8", "422|bad", "422", "200|ann", "200|ann", "200|", "422", "422", "200|t", "200|POST", "404|Not Found", "405|GET", "405|POST", "405|GET", "200|PUT", "200|PATCH", "200|DELETE", "200|OPTIONS", "200|", "4", "405|PATCH, PUT", "405|DELETE", "200|hell", "200|empty", "200|stream-me", "200|event: beat\nid: 7\ndata: tick\n\n: still here\n\n", "text/event-stream; charset=utf-8", "200|v|a.txt")
