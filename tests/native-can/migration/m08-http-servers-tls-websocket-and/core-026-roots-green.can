fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("http/main-roots", "default", "", "offline"), "assert-green" => ok "case http/main-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("http/main-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case http/main-roots variant default root assert-green run offline")
        different: false, true, context("http/main-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
