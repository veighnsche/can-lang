        seed_run_red: "seed-run-red" => ok observation(1, true, 0, "can.project.root/app::mounted", 1, 0, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true)
