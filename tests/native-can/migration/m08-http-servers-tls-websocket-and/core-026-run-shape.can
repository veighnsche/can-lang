package m08core026run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M08 CORE-026 "http dispatch: run shape, silent run, loopback harness".
/// Source: tests/integration/http_test.go symbol
/// TestCurrentBundledHTTP (L17-233).
/// Related fixture: compiler/testdata/current/http/main.can main
/// (L277-287) builds the mounted router and returns ok with no output;
/// the run leg (L51-69 helper, L81-84) executes it through the sandboxed
/// canlc run, while the dispatch harness (L135-232) runs the built
/// entry under Bun with an empty fd-3 environment snapshot (L220-229).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape. Run exits 0 with
/// empty stderr (L81-84); run stdout is deliberately unpinned because
/// the Go test discards it (L81 `_`); build exits 0 (L85-88); the
/// generated mount needle and single runtime dir gate the harness
/// (L101-133); the Bun dispatch harness exits 0 (L230-232) under the
/// loopback sandbox profile with the empty fd-3 snapshot.
/// The roots-green pin lives in core-026-roots-green.can; live dispatch
/// replies live in core-026-http-semantics.can.
/// Variants: none in this file (default only); the optional CAN_TSC
/// strict generated-TypeScript leg (L95-100) is env-gated and recorded
/// blocked, never waived.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 120000ms mirrors the Go 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case http/http-run checks: run-exit, run-stderr-empty, build-exit,
/// mount-needle, runtime-single, harness-exit, snapshot-empty,
/// sandbox-profile, loopback-profile, tsc-conditional.
/// Facet map (http_test.go legs): run-exit pins exit 0 on the run path
/// (L81-84: status 0 or the test fatals); run-stderr-empty pins empty
/// stderr on the run path (L81-84: diag must be ""); build-exit pins
/// exit 0 on the build path (L85-88: status 0 or the test fatals);
/// mount-needle pins the generated mount discovery (L120:
/// can.project.root/app::mounted verbatim; L127-129 fatal when the
/// module or mount name is missing); runtime-single pins exactly one
/// runtime dir (L130-133: len runtimes is 1 or the test fatals);
/// harness-exit pins exit 0 for the Bun dispatch harness (L230-232:
/// CombinedOutput err nil or the test fatals); snapshot-empty pins the
/// empty fd-3 snapshot (L221: environment.json holds "{}"; L229:
/// passed as fd 3); sandbox-profile pins the assert/run/build
/// invocation shape (L52: "(version 1)(allow default)(deny network*)"
/// verbatim); loopback-profile pins the harness invocation shape
/// (L227: the localhost loopback profile verbatim);
/// tsc-conditional pins the optional leg (L95-100: strict tsc over the
/// emitted entry.ts via the bundled bun runs if and only if CAN_TSC
/// is set).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stderr_empty
    int build_exit
    str mount_needle
    int runtime_single
    int harness_exit
    str snapshot_empty
    str sandbox_profile
    str loopback_profile
    bool tsc_conditional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("http/http-run", "default", "", "offline"), "run-exit" => ok "case http/http-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("http/http-run", "default", "", "offline"), "run-stderr-empty" => ok evidence("run-stderr-empty", "true", "true", true, "case http/http-run variant default root run-stderr-empty run offline")
        different: false, true, context("http/http-run", "default", "", "offline"), "run-stderr-empty" => failed{"run-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("http/http-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case http/http-run variant default root run-exit run offline")
        different: 1, 0, context("http/http-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("http/http-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case http/http-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("http/http-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
