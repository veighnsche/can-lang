fn check[] checks
    emits {}
    given
        str scope
    asserts
        m08_026: "m08-026" => ok [check("run-exit", "live run exits 0"), check("run-stderr-empty", "live run keeps stderr empty"), check("build-exit", "build exits 0"), check("mount-needle", "generated mount discovery pins the mounted needle"), check("runtime-single", "build output carries exactly one runtime dir"), check("harness-exit", "Bun dispatch harness exits 0"), check("snapshot-empty", "harness consumes the empty fd-3 snapshot"), check("sandbox-profile", "assert/run/build invocation pins the deny-network sandbox profile"), check("loopback-profile", "harness invocation pins the localhost loopback profile"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set")]
        other: "nope" => ok []
    match scope is "m08-026"
        false => ok []
        true => ok [check("run-exit", "live run exits 0"), check("run-stderr-empty", "live run keeps stderr empty"), check("build-exit", "build exits 0"), check("mount-needle", "generated mount discovery pins the mounted needle"), check("runtime-single", "build output carries exactly one runtime dir"), check("harness-exit", "Bun dispatch harness exits 0"), check("snapshot-empty", "harness consumes the empty fd-3 snapshot"), check("sandbox-profile", "assert/run/build invocation pins the deny-network sandbox profile"), check("loopback-profile", "harness invocation pins the localhost loopback profile"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "http/http-run" => ok [expected_check("run-exit", "0"), expected_check("run-stderr-empty", "true"), expected_check("build-exit", "0"), expected_check("mount-needle", "can.project.root/app::mounted"), expected_check("runtime-single", "1"), expected_check("harness-exit", "0"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("loopback-profile", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))"), expected_check("tsc-conditional", "true")]
        unknown: "nope" => ok []
    match case is "http/http-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stderr-empty", "true"), expected_check("build-exit", "0"), expected_check("mount-needle", "can.project.root/app::mounted"), expected_check("runtime-single", "1"), expected_check("harness-exit", "0"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("loopback-profile", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))"), expected_check("tsc-conditional", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("http/http-run", "default", "", "offline") => ok
        seed_run_red: context("http/http-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stderr_noisy: context("http/http-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_build_red: context("http/http-run", "seed-build-red", "", "offline") => failed{"build-exit"}
        seed_needle_drift: context("http/http-run", "seed-needle-drift", "", "offline") => failed{"mount-needle"}
        seed_runtime_extra: context("http/http-run", "seed-runtime-extra", "", "offline") => failed{"runtime-single"}
        seed_harness_red: context("http/http-run", "seed-harness-red", "", "offline") => failed{"harness-exit"}
        seed_snapshot_drift: context("http/http-run", "seed-snapshot-drift", "", "offline") => failed{"snapshot-empty"}
        seed_profile_drift: context("http/http-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_loopback_drift: context("http/http-run", "seed-loopback-drift", "", "offline") => failed{"loopback-profile"}
        seed_tsc_unconditional: context("http/http-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                failed
                ok evidence stderr_evidence => match call require_int(got.build_exit, 0, c, "build-exit")
                    failed
                    ok evidence build_evidence => match call require_text(got.mount_needle, "can.project.root/app::mounted", c, "mount-needle")
                        failed
                        ok evidence needle_evidence => match call require_int(got.runtime_single, 1, c, "runtime-single")
                            failed
                            ok evidence runtime_evidence => match call require_int(got.harness_exit, 0, c, "harness-exit")
                                failed
                                ok evidence harness_evidence => match call require_text(got.snapshot_empty, "{}", c, "snapshot-empty")
                                    failed
                                    ok evidence snapshot_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                        failed
                                        ok evidence profile_evidence => match call require_text(got.loopback_profile, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", c, "loopback-profile")
                                            failed
                                            ok evidence loopback_evidence => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                                failed
                                                ok evidence tsc_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m08_026: "m08-026" => ok test_case("http/http-run", ["http", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stderr-empty"), check_ref("build-exit"), check_ref("mount-needle"), check_ref("runtime-single"), check_ref("harness-exit"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("loopback-profile"), check_ref("tsc-conditional")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m08-026"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("http/http-run", ["http", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stderr-empty"), check_ref("build-exit"), check_ref("mount-needle"), check_ref("runtime-single"), check_ref("harness-exit"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("loopback-profile"), check_ref("tsc-conditional")], callable case_body)
