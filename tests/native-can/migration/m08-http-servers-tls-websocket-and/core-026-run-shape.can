        seed_loopback_drift: "seed-loopback-drift" => ok observation(0, true, 0, "can.project.root/app::mounted", 1, 0, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))", true)
