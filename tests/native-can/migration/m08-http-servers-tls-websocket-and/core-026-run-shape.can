        "seed-stderr-noisy" => ok observation(0, false, 0, "can.project.root/app::mounted", 1, 0, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true)
        "seed-build-red" => ok observation(0, true, 1, "can.project.root/app::mounted", 1, 0, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true)
