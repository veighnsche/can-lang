fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("http/server-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case http/server-roots variant default root assert-green run offline")
        different: false, true, context("http/server-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
