        "seed-stderr-noisy" => ok observation(0, false, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        "seed-build-red" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        "seed-directory-missing" => ok observation(0, true, 0, false, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
