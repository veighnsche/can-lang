package m08core038run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M08 CORE-038 "http server: production run shape, silent legs".
/// Source: tests/integration/server_test.go symbol
/// TestCurrentBundledServer (L17-177).
/// Related fixture: compiler/testdata/current/http/server.can main entry
/// (L79-89); the run helper (L51-69) drives assert/run/build through the
/// deny-network sandbox-exec profile (L52-53) with PATH=/nonexistent
/// (L57), while the lifecycle harness runs bun under the localhost
/// profile (L171) with an empty fd environment snapshot (L165-170).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the production process shape. The run leg exits
/// 0 with empty stderr; the build leg exits 0 with stdout that unmarshals
/// to a directory; the invocation pins the deny-network sandbox profile
/// and the localhost lifecycle profile with the empty snapshot; the
/// compiled lifecycle harness exits 0; the optional strict tsc leg runs
/// if and only if CAN_TSC is set. The assert leg (exit 0, empty stderr,
/// passed report) lives in core-038-roots-green.can; live lifecycle
/// semantics live in core-038-server-semantics.can.
/// Variants: none live in this file beyond the run, build and harness
/// legs themselves; the lifecycle variants (boot port, GET /health,
/// stop/wait, serve(0)) belong to the server-semantics file.
/// Adaptation: the Go test pins the build stdout by JSON shape (L89-94:
/// stdout unmarshals to a directory struct), so the directory contract is
/// pinned as build-directory per the accepted CORE-014/019/040
/// non-silent-output precedent, not by full-output equality. The Go test
/// does not pin the run stdout at all (L81: out is discarded with _), so
/// no run-stdout pin is authored here; pinning one would over-pin. The
/// assert stdout containment needles (L78: supplied-completion, real-can)
/// are pinned as supplied-evidence/real-evidence in the roots-green file.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC
/// and C/R/N/S/A identities bind at P23/QHTTP; no live run now.
/// Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case http/server-run checks: run-exit, run-stderr-empty, build-exit,
/// build-directory, snapshot-empty, sandbox-profile, lifecycle-profile,
/// offline-ok, tsc-conditional, harness-exit.
/// Facet map (server_test.go legs): run-exit pins exit 0 on the run leg
/// (L81-84: status 0 or "server execution" fatals); run-stderr-empty
/// pins empty stderr on the run leg (L81-84: diag must be "");
/// build-exit pins exit 0 on the build leg (L85-88: status 0 or "build"
/// fatals); build-directory pins the JSON directory (L89-94: stdout
/// unmarshals to a directory); snapshot-empty pins the empty fd snapshot
/// (L165: environment.json holds "{}"; L173: passed as the extra file);
/// sandbox-profile pins the deny-network invocation profile verbatim
/// (L52-53: "(version 1)(allow default)(deny network*)");
/// lifecycle-profile pins the localhost lifecycle profile verbatim (L171:
/// the deny-network profile plus outbound/bind/inbound localhost
/// allowances); offline-ok pins the offline behavior (L53-57/L70-88: the
/// sandboxed deny-network assert/run/build with PATH=/nonexistent
/// succeeds); tsc-conditional pins the optional leg (L95-100: strict tsc
/// over the emitted entry.ts via the bundled bun runs if and only if
/// CAN_TSC is set); harness-exit pins exit 0 on the compiled lifecycle
/// run (L174-176: CombinedOutput error or "compiled server lifecycle"
/// fatals).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stderr_empty
    int build_exit
    bool build_directory
    str snapshot_empty
    str sandbox_profile
    str lifecycle_profile
    bool offline_ok
    bool tsc_conditional
    int harness_exit
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("http/server-run", "default", "", "offline"), "run-exit" => ok "case http/server-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("http/server-run", "default", "", "offline"), "run-stderr-empty" => ok evidence("run-stderr-empty", "true", "true", true, "case http/server-run variant default root run-stderr-empty run offline")
        different: false, true, context("http/server-run", "default", "", "offline"), "run-stderr-empty" => failed{"run-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("http/server-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case http/server-run variant default root run-exit run offline")
        different: 1, 0, context("http/server-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("http/server-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case http/server-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("http/server-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
