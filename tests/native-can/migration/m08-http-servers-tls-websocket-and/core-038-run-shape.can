    asserts
        default: "default" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        seed_run_red: "seed-run-red" => ok observation(1, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        seed_stderr_noisy: "seed-stderr-noisy" => ok observation(0, false, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        seed_build_red: "seed-build-red" => ok observation(0, true, 1, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        seed_directory_missing: "seed-directory-missing" => ok observation(0, true, 0, false, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        seed_snapshot_drift: "seed-snapshot-drift" => ok observation(0, true, 0, true, "[]", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        seed_profile_drift: "seed-profile-drift" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 0)
        seed_lifecycle_profile_drift: "seed-lifecycle-profile-drift" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, true, 0)
        seed_offline_fail: "seed-offline-fail" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", false, true, 0)
        seed_tsc_unconditional: "seed-tsc-unconditional" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, false, 0)
        seed_harness_red: "seed-harness-red" => ok observation(0, true, 0, true, "{}", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", true, true, 1)
    match variant_id
