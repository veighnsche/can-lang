fn check[] checks
    emits {}
    given
        str scope
    asserts
        m08_038: "m08-038" => ok [check("run-exit", "live run leg exits 0"), check("run-stderr-empty", "live run leg keeps stderr empty"), check("build-exit", "live build leg exits 0"), check("build-directory", "live build stdout unmarshals to a directory"), check("snapshot-empty", "lifecycle consumes the empty fd snapshot"), check("sandbox-profile", "assert/run/build invocation pins the deny-network sandbox profile"), check("lifecycle-profile", "lifecycle invocation pins the localhost sandbox profile"), check("offline-ok", "offline sandboxed assert/run/build succeeds"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set"), check("harness-exit", "compiled lifecycle harness exits 0")]
        other: "nope" => ok []
    match scope is "m08-038"
        false => ok []
        true => ok [check("run-exit", "live run leg exits 0"), check("run-stderr-empty", "live run leg keeps stderr empty"), check("build-exit", "live build leg exits 0"), check("build-directory", "live build stdout unmarshals to a directory"), check("snapshot-empty", "lifecycle consumes the empty fd snapshot"), check("sandbox-profile", "assert/run/build invocation pins the deny-network sandbox profile"), check("lifecycle-profile", "lifecycle invocation pins the localhost sandbox profile"), check("offline-ok", "offline sandboxed assert/run/build succeeds"), check("tsc-conditional", "strict tsc leg runs only when CAN_TSC is set"), check("harness-exit", "compiled lifecycle harness exits 0")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "http/server-run" => ok [expected_check("run-exit", "0"), expected_check("run-stderr-empty", "true"), expected_check("build-exit", "0"), expected_check("build-directory", "true"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("lifecycle-profile", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))"), expected_check("offline-ok", "true"), expected_check("tsc-conditional", "true"), expected_check("harness-exit", "0")]
        unknown: "nope" => ok []
    match case is "http/server-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stderr-empty", "true"), expected_check("build-exit", "0"), expected_check("build-directory", "true"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("lifecycle-profile", "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))"), expected_check("offline-ok", "true"), expected_check("tsc-conditional", "true"), expected_check("harness-exit", "0")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("http/server-run", "default", "", "offline") => ok
        seed_run_red: context("http/server-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stderr_noisy: context("http/server-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_build_red: context("http/server-run", "seed-build-red", "", "offline") => failed{"build-exit"}
        seed_directory_missing: context("http/server-run", "seed-directory-missing", "", "offline") => failed{"build-directory"}
        seed_snapshot_drift: context("http/server-run", "seed-snapshot-drift", "", "offline") => failed{"snapshot-empty"}
        seed_profile_drift: context("http/server-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_lifecycle_profile_drift: context("http/server-run", "seed-lifecycle-profile-drift", "", "offline") => failed{"lifecycle-profile"}
        seed_offline_fail: context("http/server-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
        seed_tsc_unconditional: context("http/server-run", "seed-tsc-unconditional", "", "offline") => failed{"tsc-conditional"}
        seed_harness_red: context("http/server-run", "seed-harness-red", "", "offline") => failed{"harness-exit"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                failed
                ok evidence stderr_evidence => match call require_int(got.build_exit, 0, c, "build-exit")
                    failed
                    ok evidence build_evidence => match call require_bool(got.build_directory, true, c, "build-directory")
                        failed
                        ok evidence directory_evidence => match call require_text(got.snapshot_empty, "{}", c, "snapshot-empty")
                            failed
                            ok evidence snapshot_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                failed
                                ok evidence profile_evidence => match call require_text(got.lifecycle_profile, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", c, "lifecycle-profile")
                                    failed
                                    ok evidence lifecycle_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                                        failed
                                        ok evidence offline_evidence => match call require_bool(got.tsc_conditional, true, c, "tsc-conditional")
                                            failed
                                            ok evidence tsc_evidence => match call require_int(got.harness_exit, 0, c, "harness-exit")
                                                failed
                                                ok evidence harness_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m08_038: "m08-038" => ok test_case("http/server-run", ["http", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stderr-empty"), check_ref("build-exit"), check_ref("build-directory"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("lifecycle-profile"), check_ref("offline-ok"), check_ref("tsc-conditional"), check_ref("harness-exit")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m08-038"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("http/server-run", ["http", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stderr-empty"), check_ref("build-exit"), check_ref("build-directory"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("lifecycle-profile"), check_ref("offline-ok"), check_ref("tsc-conditional"), check_ref("harness-exit")], callable case_body)
