        same: "healthy", "healthy", context("http/server-lifecycle", "default", "", "offline"), "health-body" => ok evidence("health-body", "healthy", "healthy", true, "case http/server-lifecycle variant default root health-body run offline")
        different: "unhealthy", "healthy", context("http/server-lifecycle", "default", "", "offline"), "health-body" => failed{"health-body"}
    match observed is expected
