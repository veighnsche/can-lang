fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("http/server-lifecycle", "default", "", "offline") => ok
        seed_boot_port_drift: context("http/server-lifecycle", "seed-boot-port-drift", "", "offline") => failed{"boot-port"}
        seed_boot_fail: context("http/server-lifecycle", "seed-boot-fail", "", "offline") => failed{"boot-ok"}
        seed_url_drift: context("http/server-lifecycle", "seed-url-drift", "", "offline") => failed{"health-url"}
        seed_status_drift: context("http/server-lifecycle", "seed-status-drift", "", "offline") => failed{"health-status"}
        seed_body_drift: context("http/server-lifecycle", "seed-body-drift", "", "offline") => failed{"health-body"}
        seed_stop_fail: context("http/server-lifecycle", "seed-stop-fail", "", "offline") => failed{"stop-ok"}
        seed_wait_fail: context("http/server-lifecycle", "seed-wait-fail", "", "offline") => failed{"wait-ok"}
        seed_serve_fail: context("http/server-lifecycle", "seed-serve-fail", "", "offline") => failed{"serve-zero-ok"}
        seed_completion_fail: context("http/server-lifecycle", "seed-completion-fail", "", "offline") => failed{"completion-ok"}
        seed_cleanup_dirty: context("http/server-lifecycle", "seed-cleanup-dirty", "", "offline") => failed{"cleanup-clean"}
        seed_log_drift: context("http/server-lifecycle", "seed-log-drift", "", "offline") => failed{"lifecycle-log"}
        seed_boot_marker_drift: context("http/server-lifecycle", "seed-boot-marker-drift", "", "offline") => failed{"boot-marker"}
        seed_serve_marker_drift: context("http/server-lifecycle", "seed-serve-marker-drift", "", "offline") => failed{"serve-marker"}
        seed_runtime_split: context("http/server-lifecycle", "seed-runtime-split", "", "offline") => failed{"runtime-single"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.boot_port, 18371, c, "boot-port")
            failed
            ok evidence port_evidence => match call require_bool(got.boot_ok, true, c, "boot-ok")
                failed
                ok evidence boot_evidence => match call require_text(got.health_url, "http://127.0.0.1:18371/health", c, "health-url")
                    failed
                    ok evidence url_evidence => match call require_int(got.health_status, 200, c, "health-status")
                        failed
                        ok evidence status_evidence => match call require_text(got.health_body, "healthy", c, "health-body")
                            failed
                            ok evidence body_evidence => match call require_bool(got.stop_ok, true, c, "stop-ok")
                                failed
                                ok evidence stop_evidence => match call require_bool(got.wait_ok, true, c, "wait-ok")
                                    failed
                                    ok evidence wait_evidence => match call require_bool(got.serve_zero_ok, true, c, "serve-zero-ok")
                                        failed
                                        ok evidence serve_evidence => match call require_bool(got.completion_ok, true, c, "completion-ok")
                                            failed
                                            ok evidence completion_evidence => match call require_bool(got.cleanup_clean, true, c, "cleanup-clean")
                                                failed
                                                ok evidence cleanup_evidence => match call require_text(got.lifecycle_log, "compiled server lifecycle passed", c, "lifecycle-log")
                                                    failed
                                                    ok evidence log_evidence => match call require_text(got.boot_marker, "can.project.root/app::boot", c, "boot-marker")
                                                        failed
                                                        ok evidence boot_marker_evidence => match call require_text(got.serve_marker, "can.project.root/app::serve", c, "serve-marker")
                                                            failed
                                                            ok evidence serve_marker_evidence => match call require_int(got.runtime_single, 1, c, "runtime-single")
                                                                failed
                                                                ok evidence runtime_evidence => ok
