/// M08 CORE-038 "http server: compiled lifecycle, generated identity".
/// Source: tests/integration/server_test.go symbol
/// TestCurrentBundledServer (L17-177).
/// Related fixture: compiler/testdata/current/http/server.can (read at
/// L46, staged as src/main.can at L50); the live pins ground the boot
/// arm (fixture L37-53: make_server_config + table + server_start), the
/// serve arm (fixture L54-78: start then stop then wait), the /health
/// route (fixture L16: route_get "/health") and the healthy body
/// (fixture L10: response_text "healthy").
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the compiled server lifecycle (boot the fixed
/// loopback port, GET /health 200 healthy, owned stop/wait, serve(0)
/// with clean owner cleanup), the generated boot/serve function identity
/// and the single-runtime build identity.
/// The roots-green pin lives in core-038-roots-green.can; the production
/// process shape lives in core-038-run-shape.can.
/// Variants: boot fixed loopback port (Go L146); GET /health (Go L149);
/// stop/wait (Go L151-152); serve(0) (Go L153-154). All four live in this
/// file as the harness legs they pin.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_TSC gates the optional strict
/// tsc leg (pinned conditional in the run-shape file). Logical gates
/// SUITE/WORK/PROC and C/R/N/S/A identities bind at P23/QHTTP; no live
/// run now. Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case http/server-lifecycle checks: boot-port, boot-ok, health-url,
/// health-status, health-body, stop-ok, wait-ok, serve-zero-ok,
/// completion-ok, cleanup-clean, lifecycle-log, boot-marker,
/// serve-marker, runtime-single.
/// Facet map (server_test.go legs): boot-port pins the fixed loopback
/// port (L146: boot(18371n)); boot-ok pins the boot result (L147:
/// started.kind is "ok"); health-url pins the fetch target verbatim
/// (L149: "http://127.0.0.1:18371/health"); health-status pins the
/// status (L150: res.status is 200); health-body pins the body verbatim
/// (L150: text is "healthy"; fixture L10); stop-ok pins the owned stop
/// (L151: $canServer.stop kind is "ok"); wait-ok pins the owned wait
/// (L152: $canServer.wait kind is "ok"); serve-zero-ok pins serve(0n)
/// (L153-154: lived.kind is "ok"); completion-ok pins the owned
/// completion (L157: owned.completion.kind is "ok"); cleanup-clean pins
/// the clean owner cleanup (L157: cleanupFailed is false);
/// lifecycle-log pins the harness marker verbatim (L158: console.log
/// "compiled server lifecycle passed"); boot-marker pins the generated
/// boot export scan (L120: chunk carries "can.project.root/app::boot");
/// serve-marker pins the generated serve export scan (L124: chunk
/// carries "can.project.root/app::serve"); runtime-single pins the
/// runtime count (L134-137: exactly 1 runtime/r-* glob hit or "missing
/// runtime" fatals).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int boot_port
    bool boot_ok
    str health_url
    int health_status
    str health_body
    bool stop_ok
    bool wait_ok
    bool serve_zero_ok
    bool completion_ok
    bool cleanup_clean
    str lifecycle_log
    str boot_marker
    str serve_marker
    int runtime_single
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
