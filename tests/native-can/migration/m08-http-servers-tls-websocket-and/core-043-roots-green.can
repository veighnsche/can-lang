        seed_assert_red: context("tls/tls-roots", "seed-assert-red", "", "offline") => failed{"assert-green"}
        seed_report_red: context("tls/tls-roots", "seed-report-red", "", "offline") => failed{"report-passed"}
        seed_root_short: context("tls/tls-roots", "seed-root-short", "", "offline") => failed{"root-count"}
