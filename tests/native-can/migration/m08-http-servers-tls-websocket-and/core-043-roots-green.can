/// M08 CORE-043 "tls health: roots green, five assert roots".
/// Source: tests/integration/tls_test.go symbol
/// TestCurrentBundledTLS (L17-191).
/// Related fixture: compiler/testdata/current/http/tls.can (read at
/// L46, staged as src/main.can at L50); every count pin below grounds an
/// assert arm in that fixture (health 1, table 1, tls_material 1,
/// boot_tls 1, main 1; total 5).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): canlc assert green with a passed report carrying
/// exactly 5 roots, grounded per function in the tls.can fixture,
/// with supplied-completion and real-can evidence present.
/// The live lifecycle, chain generation and strict emission live in
/// core-043-tls-semantics.can; the production process shape lives in
/// core-043-run-shape.can.
/// Variants: none in this file (default only); lifecycle variants
/// (healthy trusted request, untrusted request, cert/chain lifecycle)
/// live in the tls-semantics file.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. openssl gates the fresh-chain
/// leg and CAN_TSC gates the optional strict tsc leg (both pinned in
/// the tls-semantics file). Logical gates SUITE/WORK/PROC and C/R/N/S/A
/// identities bind at P23; no live run now. Descriptor timeout 120000ms
/// mirrors the Go 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case tls/tls-roots checks: assert-green, report-passed,
/// root-count, fixture-name, supplied-evidence, real-evidence,
/// health-roots, table-roots, material-roots, boot-roots, main-roots.
/// Facet map (tls_test.go legs): assert-green pins the assert
/// leg (L70-73: status 0 and empty diagnostics or the test fatals);
/// report-passed pins the report leg (L75: passed true); root-count pins
/// the five roots (L75: len assertions is 5); fixture-name grounds
/// the pins in the staged fixture (L46: tls.can; L50: src/main.can);
/// supplied-evidence pins supplied completion evidence (L78:
/// supplied-completion; fixture L53-54: boot_tls stands in via
/// when-sample); real-evidence pins real native evidence (L78:
/// real-can; fixture L24-31: tls_material sample runs the real
/// bytes::from_utf8 and http::make_tls_config natives); health-roots
/// pins health (fixture L8-9: sample, 1 root); table-roots pins table
/// (fixture L13-14: sample, 1); material-roots pins tls_material
/// (fixture L24-25: sample, 1); boot-roots pins boot_tls (fixture
/// L38-39: sample, 1); main-roots pins main (fixture L61-62: sample,
/// 1).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    str fixture_name
    bool supplied_evidence
    bool real_evidence
    int health_roots
    int table_roots
    int material_roots
    int boot_roots
    int main_roots
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("tls/tls-roots", "default", "", "offline"), "assert-green" => ok "case tls/tls-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("tls/tls-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case tls/tls-roots variant default root assert-green run offline")
        different: false, true, context("tls/tls-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("tls/tls-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "5", "5", true, "case tls/tls-roots variant default root root-count run offline")
        different: 4, 5, context("tls/tls-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
