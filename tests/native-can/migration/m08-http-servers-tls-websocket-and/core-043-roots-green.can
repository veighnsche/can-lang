    asserts
        same: "tls.can", "tls.can", context("tls/tls-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "tls.can", "tls.can", true, "case tls/tls-roots variant default root fixture-name run offline")
        different: "http.can", "tls.can", context("tls/tls-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
