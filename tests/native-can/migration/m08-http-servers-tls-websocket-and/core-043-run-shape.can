        true => ok test_case("tls/tls-run", ["tls", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("run-stderr-empty"), check_ref("build-exit"), check_ref("boot-identity"), check_ref("single-runtime"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("harness-profile"), check_ref("offline-ok"), check_ref("harness-ok")], callable case_body)
