fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("tls/tls-run", "default", "", "offline") => ok
        seed_run_red: context("tls/tls-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_stderr_noisy: context("tls/tls-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_build_red: context("tls/tls-run", "seed-build-red", "", "offline") => failed{"build-exit"}
        seed_boot_drift: context("tls/tls-run", "seed-boot-drift", "", "offline") => failed{"boot-identity"}
        seed_runtime_split: context("tls/tls-run", "seed-runtime-split", "", "offline") => failed{"single-runtime"}
        seed_snapshot_drift: context("tls/tls-run", "seed-snapshot-drift", "", "offline") => failed{"snapshot-empty"}
        seed_profile_drift: context("tls/tls-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_harness_drift: context("tls/tls-run", "seed-harness-drift", "", "offline") => failed{"harness-profile"}
        seed_offline_fail: context("tls/tls-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
        seed_harness_fail: context("tls/tls-run", "seed-harness-fail", "", "offline") => failed{"harness-ok"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                failed
                ok evidence stderr_evidence => match call require_int(got.build_exit, 0, c, "build-exit")
                    failed
                    ok evidence build_evidence => match call require_text(got.boot_identity, "can.project.root/app::boot_tls", c, "boot-identity")
                        failed
                        ok evidence boot_evidence => match call require_bool(got.single_runtime, true, c, "single-runtime")
                            failed
                            ok evidence runtime_evidence => match call require_text(got.snapshot_empty, "{}", c, "snapshot-empty")
                                failed
                                ok evidence snapshot_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                    failed
                                    ok evidence profile_evidence => match call require_text(got.harness_profile, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))", c, "harness-profile")
                                        failed
                                        ok evidence harness_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                                            failed
                                            ok evidence offline_evidence => match call require_bool(got.harness_ok, true, c, "harness-ok")
                                                failed
                                                ok evidence ok_evidence => ok
