package m08core043tls
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M08 CORE-043 "tls health: trusted serve, untrusted reject, fresh chain".
/// Source: tests/integration/tls_test.go symbol
/// TestCurrentBundledTLS (L17-191).
/// Related fixture: compiler/testdata/current/http/tls.can (read at
/// L46, staged as src/main.can at L50); the lifecycle pins ground the
/// health handler (fixture L4-10: 200 "healthy"), the router (fixture
/// L11-21: GET /health), the material probe (fixture L22-31: garbage
/// key material rejects) and boot_tls (fixture L32-56: decode cert/key,
/// make the tls config, bind 127.0.0.1, serve the router over TLS).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the compiled TLS lifecycle over the owned
/// server. Boot returns ok, the trusted health fetch answers 200
/// "healthy" over the loopback https url, the fetch without the ca
/// rejects, each run mints a fresh local self-signed chain with the
/// pinned san/subject/days/alg, the emitted entry passes strict tsc
/// when CAN_TSC is set, stop and wait return ok, the owned root
/// completes clean, and the harness prints its marker.
/// The roots-green pin lives in core-043-roots-green.can; the production
/// process shape lives in core-043-run-shape.can.
/// Variants: healthy trusted request (L163-164); untrusted request
/// (L165); cert/chain lifecycle (L134-142 generation, L160-162 boot,
/// L166-171 stop/wait/completion/marker).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec + openssl;
/// requires can-bun-archive, macos-sandbox-exec, openssl. CAN_TSC gates
/// the optional strict tsc leg (pinned as strict-emission here, never
/// waived). Logical gates SUITE/WORK/PROC and C/R/N/S/A identities bind
/// at P23; no live run now. Descriptor timeout 120000ms mirrors the Go
/// 2-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case tls/tls-lifecycle checks: boot-ok, trusted-status,
/// trusted-body, trusted-url, untrusted-rejects, chain-fresh,
/// chain-san, chain-subj, chain-days, chain-alg, strict-emission,
/// stop-ok, wait-ok, owned-completion-ok, cleanup-clean,
/// lifecycle-marker.
/// Facet map (tls_test.go harness, L134-172): boot-ok pins the
/// boot result (L160-161: boot(18372n, cert, key) kind is ok);
/// trusted-status pins the trusted status (L164: 200 over the fetch
/// with tls ca); trusted-body pins the trusted body (L164:
/// "healthy"); trusted-url pins the trusted url (L163-164:
/// "https://127.0.0.1:18372/health" verbatim); untrusted-rejects pins
/// the untrusted rejection (L165: assert.rejects the fetch without
/// the ca); chain-fresh pins the fresh chain (L134-135: fresh local
/// chain per run, nothing credential-shaped committed); chain-san pins
/// the san entry (L136: san.cnf carries
/// "subjectAltName=IP:127.0.0.1" verbatim); chain-subj pins the
/// subject (L139: -subj "/CN=127.0.0.1" verbatim); chain-days pins the
/// lifetime (L139: -days 2); chain-alg pins the key algorithm (L139:
/// -newkey "rsa:2048" verbatim); strict-emission pins the optional
/// emission leg (L95-100: strict tsc over the emitted entry.ts passes
/// if and only if CAN_TSC is set); stop-ok pins the stop result
/// (L166: $canServer.stop kind is ok); wait-ok pins the wait result
/// (L167: $canServer.wait kind is ok); owned-completion-ok pins the
/// owned completion (L170: owned.completion.kind is ok);
/// cleanup-clean pins clean teardown (L170: cleanupFailed is false);
/// lifecycle-marker pins the harness marker (L171: "compiled TLS
/// lifecycle passed" verbatim; the harness prints it only after every
/// lifecycle assertion passes).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool boot_ok
    int trusted_status
    str trusted_body
    str trusted_url
    bool untrusted_rejects
    bool chain_fresh
    str chain_san
    str chain_subj
    int chain_days
    str chain_alg
    bool strict_emission
    bool stop_ok
    bool wait_ok
    bool owned_completion_ok
    bool cleanup_clean
    str lifecycle_marker
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("tls/tls-lifecycle", "default", "", "offline"), "boot-ok" => ok "case tls/tls-lifecycle variant default root boot-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("tls/tls-lifecycle", "default", "", "offline"), "boot-ok" => ok evidence("boot-ok", "true", "true", true, "case tls/tls-lifecycle variant default root boot-ok run offline")
        different: false, true, context("tls/tls-lifecycle", "default", "", "offline"), "boot-ok" => failed{"boot-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("tls/tls-lifecycle", "default", "", "offline"), "trusted-status" => ok evidence("trusted-status", "200", "200", true, "case tls/tls-lifecycle variant default root trusted-status run offline")
        different: 404, 200, context("tls/tls-lifecycle", "default", "", "offline"), "trusted-status" => failed{"trusted-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "healthy", "healthy", context("tls/tls-lifecycle", "default", "", "offline"), "trusted-body" => ok evidence("trusted-body", "healthy", "healthy", true, "case tls/tls-lifecycle variant default root trusted-body run offline")
        different: "unhealthy", "healthy", context("tls/tls-lifecycle", "default", "", "offline"), "trusted-body" => failed{"trusted-body"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
