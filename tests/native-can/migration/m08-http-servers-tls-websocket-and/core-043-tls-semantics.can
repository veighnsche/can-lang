        false => ok []
        true => ok [check("boot-ok", "boot returns ok over the fresh chain"), check("trusted-status", "trusted health fetch answers 200"), check("trusted-body", "trusted health fetch answers healthy"), check("trusted-url", "trusted fetch pins the https loopback health url"), check("untrusted-rejects", "fetch without the ca rejects"), check("chain-fresh", "each run mints a fresh local chain"), check("chain-san", "san config pins subjectAltName IP 127.0.0.1"), check("chain-subj", "openssl subject pins CN 127.0.0.1"), check("chain-days", "openssl chain lasts 2 days"), check("chain-alg", "openssl newkey pins rsa 2048"), check("strict-emission", "emitted entry passes strict tsc when CAN_TSC is set"), check("stop-ok", "server stop returns ok"), check("wait-ok", "server wait returns ok"), check("owned-completion-ok", "owned root completes ok"), check("cleanup-clean", "owned root cleans up without failure"), check("lifecycle-marker", "harness prints the compiled TLS lifecycle marker")]
