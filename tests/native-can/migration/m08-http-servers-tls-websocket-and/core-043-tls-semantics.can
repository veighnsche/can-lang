    emits {}
    given
        str case
    asserts
        known: "tls/tls-lifecycle" => ok [expected_check("boot-ok", "true"), expected_check("trusted-status", "200"), expected_check("trusted-body", "healthy"), expected_check("trusted-url", "https://127.0.0.1:18372/health"), expected_check("untrusted-rejects", "true"), expected_check("chain-fresh", "true"), expected_check("chain-san", "subjectAltName=IP:127.0.0.1"), expected_check("chain-subj", "/CN=127.0.0.1"), expected_check("chain-days", "2"), expected_check("chain-alg", "rsa:2048"), expected_check("strict-emission", "true"), expected_check("stop-ok", "true"), expected_check("wait-ok", "true"), expected_check("owned-completion-ok", "true"), expected_check("cleanup-clean", "true"), expected_check("lifecycle-marker", "compiled TLS lifecycle passed")]
        unknown: "nope" => ok []
    match case is "tls/tls-lifecycle"
        false => ok []
        true => ok [expected_check("boot-ok", "true"), expected_check("trusted-status", "200"), expected_check("trusted-body", "healthy"), expected_check("trusted-url", "https://127.0.0.1:18372/health"), expected_check("untrusted-rejects", "true"), expected_check("chain-fresh", "true"), expected_check("chain-san", "subjectAltName=IP:127.0.0.1"), expected_check("chain-subj", "/CN=127.0.0.1"), expected_check("chain-days", "2"), expected_check("chain-alg", "rsa:2048"), expected_check("strict-emission", "true"), expected_check("stop-ok", "true"), expected_check("wait-ok", "true"), expected_check("owned-completion-ok", "true"), expected_check("cleanup-clean", "true"), expected_check("lifecycle-marker", "compiled TLS lifecycle passed")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("tls/tls-lifecycle", "default", "", "offline") => ok
        seed_boot_fail: context("tls/tls-lifecycle", "seed-boot-fail", "", "offline") => failed{"boot-ok"}
        seed_status_drift: context("tls/tls-lifecycle", "seed-status-drift", "", "offline") => failed{"trusted-status"}
        seed_body_drift: context("tls/tls-lifecycle", "seed-body-drift", "", "offline") => failed{"trusted-body"}
        seed_url_drift: context("tls/tls-lifecycle", "seed-url-drift", "", "offline") => failed{"trusted-url"}
        seed_trusted_accept: context("tls/tls-lifecycle", "seed-trusted-accept", "", "offline") => failed{"untrusted-rejects"}
        seed_chain_reuse: context("tls/tls-lifecycle", "seed-chain-reuse", "", "offline") => failed{"chain-fresh"}
        seed_san_drift: context("tls/tls-lifecycle", "seed-san-drift", "", "offline") => failed{"chain-san"}
        seed_subj_drift: context("tls/tls-lifecycle", "seed-subj-drift", "", "offline") => failed{"chain-subj"}
        seed_days_drift: context("tls/tls-lifecycle", "seed-days-drift", "", "offline") => failed{"chain-days"}
        seed_alg_drift: context("tls/tls-lifecycle", "seed-alg-drift", "", "offline") => failed{"chain-alg"}
        seed_emission_lax: context("tls/tls-lifecycle", "seed-emission-lax", "", "offline") => failed{"strict-emission"}
        seed_stop_fail: context("tls/tls-lifecycle", "seed-stop-fail", "", "offline") => failed{"stop-ok"}
        seed_wait_fail: context("tls/tls-lifecycle", "seed-wait-fail", "", "offline") => failed{"wait-ok"}
        seed_completion_fail: context("tls/tls-lifecycle", "seed-completion-fail", "", "offline") => failed{"owned-completion-ok"}
        seed_cleanup_dirty: context("tls/tls-lifecycle", "seed-cleanup-dirty", "", "offline") => failed{"cleanup-clean"}
        seed_marker_drift: context("tls/tls-lifecycle", "seed-marker-drift", "", "offline") => failed{"lifecycle-marker"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.boot_ok, true, c, "boot-ok")
            failed
            ok evidence boot_evidence => match call require_int(got.trusted_status, 200, c, "trusted-status")
                failed
                ok evidence status_evidence => match call require_text(got.trusted_body, "healthy", c, "trusted-body")
                    failed
                    ok evidence body_evidence => match call require_text(got.trusted_url, "https://127.0.0.1:18372/health", c, "trusted-url")
                        failed
                        ok evidence url_evidence => match call require_bool(got.untrusted_rejects, true, c, "untrusted-rejects")
                            failed
                            ok evidence reject_evidence => match call require_bool(got.chain_fresh, true, c, "chain-fresh")
                                failed
                                ok evidence fresh_evidence => match call require_text(got.chain_san, "subjectAltName=IP:127.0.0.1", c, "chain-san")
                                    failed
                                    ok evidence san_evidence => match call require_text(got.chain_subj, "/CN=127.0.0.1", c, "chain-subj")
                                        failed
                                        ok evidence subj_evidence => match call require_int(got.chain_days, 2, c, "chain-days")
                                            failed
                                            ok evidence days_evidence => match call require_text(got.chain_alg, "rsa:2048", c, "chain-alg")
                                                failed
                                                ok evidence alg_evidence => match call require_bool(got.strict_emission, true, c, "strict-emission")
                                                    failed
                                                    ok evidence emission_evidence => match call require_bool(got.stop_ok, true, c, "stop-ok")
                                                        failed
                                                        ok evidence stop_evidence => match call require_bool(got.wait_ok, true, c, "wait-ok")
                                                            failed
                                                            ok evidence wait_evidence => match call require_bool(got.owned_completion_ok, true, c, "owned-completion-ok")
                                                                failed
                                                                ok evidence completion_evidence => match call require_bool(got.cleanup_clean, true, c, "cleanup-clean")
                                                                    failed
                                                                    ok evidence cleanup_evidence => match call require_text(got.lifecycle_marker, "compiled TLS lifecycle passed", c, "lifecycle-marker")
                                                                        failed
                                                                        ok evidence marker_evidence => ok
fn test_case descriptor
    emits {}
    given
