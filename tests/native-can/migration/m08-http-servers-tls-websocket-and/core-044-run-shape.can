        true => ok [expected_check("run-exit", "0"), expected_check("fail-needle", "0 fail"), expected_check("ev-loopback-json", "named fetch loopback decodes exact JSON"), expected_check("ev-raw-fixtures", "named fetch raw fixtures handle bodyless"), expected_check("ev-one-attempt", "native fetch makes one attempt"), expected_check("ev-stalled", "stalled native response"), expected_check("ev-decode-past", "response decode past"), expected_check("ev-nominal", "transport failures construct exact"), expected_check("ev-continuations", "native continuations finish"), expected_check("ev-late-defect", "late decoder defect"), expected_check("ev-retains", "native continuation retains captured resource"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))(allow network-outbound (remote ip \"localhost:*\"))"), expected_check("offline-ok", "true"), expected_check("staged-suites", "7"), expected_check("archive-gate", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("transport/loopback-run", "default", "", "offline") => ok
        seed_run_red: context("transport/loopback-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_fail_needle_drift: context("transport/loopback-run", "seed-fail-needle-drift", "", "offline") => failed{"fail-needle"}
        seed_ev_loopback_json_loss: context("transport/loopback-run", "seed-ev-loopback-json-loss", "", "offline") => failed{"ev-loopback-json"}
        seed_ev_raw_fixtures_loss: context("transport/loopback-run", "seed-ev-raw-fixtures-loss", "", "offline") => failed{"ev-raw-fixtures"}
        seed_ev_one_attempt_loss: context("transport/loopback-run", "seed-ev-one-attempt-loss", "", "offline") => failed{"ev-one-attempt"}
        seed_ev_stalled_loss: context("transport/loopback-run", "seed-ev-stalled-loss", "", "offline") => failed{"ev-stalled"}
        seed_ev_decode_past_loss: context("transport/loopback-run", "seed-ev-decode-past-loss", "", "offline") => failed{"ev-decode-past"}
        seed_ev_nominal_loss: context("transport/loopback-run", "seed-ev-nominal-loss", "", "offline") => failed{"ev-nominal"}
        seed_ev_continuations_loss: context("transport/loopback-run", "seed-ev-continuations-loss", "", "offline") => failed{"ev-continuations"}
        seed_ev_late_defect_loss: context("transport/loopback-run", "seed-ev-late-defect-loss", "", "offline") => failed{"ev-late-defect"}
        seed_ev_retains_loss: context("transport/loopback-run", "seed-ev-retains-loss", "", "offline") => failed{"ev-retains"}
        seed_sandbox_profile_drift: context("transport/loopback-run", "seed-sandbox-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_fail: context("transport/loopback-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
        seed_staged_suites_short: context("transport/loopback-run", "seed-staged-suites-short", "", "offline") => failed{"staged-suites"}
        seed_archive_missing: context("transport/loopback-run", "seed-archive-missing", "", "offline") => failed{"archive-gate"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence run_exit_evidence => match call require_text(got.fail_needle, "0 fail", c, "fail-needle")
                failed
                ok evidence fail_needle_evidence => match call require_text(got.ev_loopback_json, "named fetch loopback decodes exact JSON", c, "ev-loopback-json")
                    failed
                    ok evidence ev_loopback_json_evidence => match call require_text(got.ev_raw_fixtures, "named fetch raw fixtures handle bodyless", c, "ev-raw-fixtures")
                        failed
                        ok evidence ev_raw_fixtures_evidence => match call require_text(got.ev_one_attempt, "native fetch makes one attempt", c, "ev-one-attempt")
                            failed
                            ok evidence ev_one_attempt_evidence => match call require_text(got.ev_stalled, "stalled native response", c, "ev-stalled")
                                failed
                                ok evidence ev_stalled_evidence => match call require_text(got.ev_decode_past, "response decode past", c, "ev-decode-past")
                                    failed
                                    ok evidence ev_decode_past_evidence => match call require_text(got.ev_nominal, "transport failures construct exact", c, "ev-nominal")
                                        failed
                                        ok evidence ev_nominal_evidence => match call require_text(got.ev_continuations, "native continuations finish", c, "ev-continuations")
                                            failed
                                            ok evidence ev_continuations_evidence => match call require_text(got.ev_late_defect, "late decoder defect", c, "ev-late-defect")
                                                failed
                                                ok evidence ev_late_defect_evidence => match call require_text(got.ev_retains, "native continuation retains captured resource", c, "ev-retains")
                                                    failed
                                                    ok evidence ev_retains_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)(allow network-bind (local ip \"localhost:*\"))(allow network-inbound (local ip \"localhost:*\"))(allow network-outbound (remote ip \"localhost:*\"))", c, "sandbox-profile")
                                                        failed
                                                        ok evidence sandbox_profile_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                                                            failed
                                                            ok evidence offline_ok_evidence => match call require_int(got.staged_suites, 7, c, "staged-suites")
                                                                failed
                                                                ok evidence staged_suites_evidence => match call require_bool(got.archive_gate, true, c, "archive-gate")
                                                                    failed
                                                                    ok evidence archive_gate_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m08_044: "m08-044" => ok test_case("transport/loopback-run", ["transport", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("fail-needle"), check_ref("ev-loopback-json"), check_ref("ev-raw-fixtures"), check_ref("ev-one-attempt"), check_ref("ev-stalled"), check_ref("ev-decode-past"), check_ref("ev-nominal"), check_ref("ev-continuations"), check_ref("ev-late-defect"), check_ref("ev-retains"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("staged-suites"), check_ref("archive-gate")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m08-044"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("transport/loopback-run", ["transport", "m08"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("run-exit"), check_ref("fail-needle"), check_ref("ev-loopback-json"), check_ref("ev-raw-fixtures"), check_ref("ev-one-attempt"), check_ref("ev-stalled"), check_ref("ev-decode-past"), check_ref("ev-nominal"), check_ref("ev-continuations"), check_ref("ev-late-defect"), check_ref("ev-retains"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("staged-suites"), check_ref("archive-gate")], callable case_body)
