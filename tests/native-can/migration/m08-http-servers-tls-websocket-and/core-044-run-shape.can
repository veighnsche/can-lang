    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    str fail_needle
    str ev_loopback_json
    str ev_raw_fixtures
    str ev_one_attempt
    str ev_stalled
    str ev_decode_past
    str ev_nominal
    str ev_continuations
    str ev_late_defect
    str ev_retains
    str sandbox_profile
    bool offline_ok
    int staged_suites
    bool archive_gate
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("transport/loopback-run", "default", "", "offline"), "run-exit" => ok "case transport/loopback-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("transport/loopback-run", "default", "", "offline"), "offline-ok" => ok evidence("offline-ok", "true", "true", true, "case transport/loopback-run variant default root offline-ok run offline")
        different: false, true, context("transport/loopback-run", "default", "", "offline"), "offline-ok" => failed{"offline-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("transport/loopback-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case transport/loopback-run variant default root run-exit run offline")
        different: 1, 0, context("transport/loopback-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "0 fail", "0 fail", context("transport/loopback-run", "default", "", "offline"), "fail-needle" => ok evidence("fail-needle", "0 fail", "0 fail", true, "case transport/loopback-run variant default root fail-needle run offline")
        different: "1 fail", "0 fail", context("transport/loopback-run", "default", "", "offline"), "fail-needle" => failed{"fail-needle"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
