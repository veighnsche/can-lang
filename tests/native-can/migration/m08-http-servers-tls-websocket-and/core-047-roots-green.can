fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("ws/ws-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case ws/ws-roots variant default root assert-green run offline")
        different: false, true, context("ws/ws-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
