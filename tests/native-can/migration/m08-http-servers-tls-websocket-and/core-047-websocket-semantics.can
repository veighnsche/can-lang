    asserts
        known: "ws/ws-lifecycle" => ok [expected_check("boot-ok", "true"), expected_check("boot-port", "18373"), expected_check("link-ok", "true"), expected_check("link-url", "ws://127.0.0.1:18373/socket"), expected_check("protocol-empty", ""), expected_check("push-ok", "2"), expected_check("text-frame", "hi"), expected_check("push-raw-ok", "3"), expected_check("binary-frame", "1,2,3"), expected_check("bye-ok", "true"), expected_check("close-code", "1000"), expected_check("close-reason", "done"), expected_check("empty-drain", "0"), expected_check("release-ok", "true"), expected_check("strict-emission", "true"), expected_check("stop-ok", "true"), expected_check("wait-ok", "true"), expected_check("owned-completion-ok", "true"), expected_check("cleanup-clean", "true"), expected_check("lifecycle-marker", "compiled websocket lifecycle passed")]
