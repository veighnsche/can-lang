        false => ok []
        true => ok [expected_check("boot-ok", "true"), expected_check("boot-port", "18373"), expected_check("link-ok", "true"), expected_check("link-url", "ws://127.0.0.1:18373/socket"), expected_check("protocol-empty", ""), expected_check("push-ok", "2"), expected_check("text-frame", "hi"), expected_check("push-raw-ok", "3"), expected_check("binary-frame", "1,2,3"), expected_check("bye-ok", "true"), expected_check("close-code", "1000"), expected_check("close-reason", "done"), expected_check("empty-drain", "0"), expected_check("release-ok", "true"), expected_check("strict-emission", "true"), expected_check("stop-ok", "true"), expected_check("wait-ok", "true"), expected_check("owned-completion-ok", "true"), expected_check("cleanup-clean", "true"), expected_check("lifecycle-marker", "compiled websocket lifecycle passed")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("ws/ws-lifecycle", "default", "", "offline") => ok
        seed_boot_fail: context("ws/ws-lifecycle", "seed-boot-fail", "", "offline") => failed{"boot-ok"}
        seed_port_drift: context("ws/ws-lifecycle", "seed-port-drift", "", "offline") => failed{"boot-port"}
        seed_link_fail: context("ws/ws-lifecycle", "seed-link-fail", "", "offline") => failed{"link-ok"}
        seed_url_drift: context("ws/ws-lifecycle", "seed-url-drift", "", "offline") => failed{"link-url"}
        seed_protocol_drift: context("ws/ws-lifecycle", "seed-protocol-drift", "", "offline") => failed{"protocol-empty"}
        seed_push_short: context("ws/ws-lifecycle", "seed-push-short", "", "offline") => failed{"push-ok"}
        seed_text_drift: context("ws/ws-lifecycle", "seed-text-drift", "", "offline") => failed{"text-frame"}
        seed_raw_short: context("ws/ws-lifecycle", "seed-raw-short", "", "offline") => failed{"push-raw-ok"}
        seed_binary_drift: context("ws/ws-lifecycle", "seed-binary-drift", "", "offline") => failed{"binary-frame"}
        seed_bye_fail: context("ws/ws-lifecycle", "seed-bye-fail", "", "offline") => failed{"bye-ok"}
        seed_code_drift: context("ws/ws-lifecycle", "seed-code-drift", "", "offline") => failed{"close-code"}
        seed_reason_drift: context("ws/ws-lifecycle", "seed-reason-drift", "", "offline") => failed{"close-reason"}
        seed_drain_full: context("ws/ws-lifecycle", "seed-drain-full", "", "offline") => failed{"empty-drain"}
        seed_release_fail: context("ws/ws-lifecycle", "seed-release-fail", "", "offline") => failed{"release-ok"}
        seed_emission_lax: context("ws/ws-lifecycle", "seed-emission-lax", "", "offline") => failed{"strict-emission"}
        seed_stop_fail: context("ws/ws-lifecycle", "seed-stop-fail", "", "offline") => failed{"stop-ok"}
        seed_wait_fail: context("ws/ws-lifecycle", "seed-wait-fail", "", "offline") => failed{"wait-ok"}
        seed_completion_fail: context("ws/ws-lifecycle", "seed-completion-fail", "", "offline") => failed{"owned-completion-ok"}
        seed_cleanup_dirty: context("ws/ws-lifecycle", "seed-cleanup-dirty", "", "offline") => failed{"cleanup-clean"}
        seed_marker_drift: context("ws/ws-lifecycle", "seed-marker-drift", "", "offline") => failed{"lifecycle-marker"}
    match call observe(c.variant_id)
