package m08core047websocket
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M08 CORE-047 "websocket: compiled lifecycle over the owned socket".
/// Source: tests/integration/websocket_test.go symbol
/// TestCurrentBundledWebSocket (L17-203).
/// Related fixture: compiler/testdata/current/ws/socket.can (read at
/// L46, staged as src/main.can at L50); the lifecycle pins ground the
/// socket handler (fixture L74-88: ws::accept then pump until close),
/// the router (fixture L89-99: GET /socket), boot (fixture L100-116:
/// bind 127.0.0.1 then serve), link (fixture L145-158: ws::connect),
/// push (fixture L160-171: ws::send_text), push_raw (fixture L173-186:
/// bytes::from_ints then ws::send_bytes), drain (fixture L188-201:
/// stream::read_many), bye (fixture L203-213: ws::close 1000 done)
/// and release (fixture L215-225: stream::close_reader).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the compiled websocket lifecycle over the owned
/// server. Boot returns ok on 18373, link dials the ws loopback socket
/// url with an empty subprotocol, push of hi returns 2 and the first
/// drain preserves text hi, push_raw of [1,2,3] returns 3 and the second
/// drain preserves bytes 1,2,3, bye returns ok and the close drain pins
/// code 1000 reason done, the final drain is empty, release returns ok,
/// the emitted entry passes strict tsc when CAN_TSC is set, stop and
/// wait return ok, the owned root completes clean, and the harness
/// prints its marker.
/// The roots-green pin lives in core-047-roots-green.can; the production
/// process shape lives in core-047-run-shape.can.
/// Variants: text hi (push-ok + text-frame, L160-164); bytes [1,2,3]
/// (push-raw-ok + binary-frame, L165-169); close 1000 done (bye-ok +
/// close-code + close-reason, L170-174); empty drain (empty-drain,
/// L175-176).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. CAN_TSC gates the optional
/// strict tsc leg (pinned as strict-emission here, never waived).
/// Logical gates SUITE/WORK/PROC and C/R/N/S/A identities bind at P23;
/// no live run now. Descriptor timeout 120000ms mirrors the Go 2-minute
/// ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP/QWS unmet).
/// Case ws/ws-lifecycle checks: boot-ok, boot-port,
/// link-ok, link-url, protocol-empty, push-ok, text-frame, push-raw-ok,
/// binary-frame, bye-ok, close-code, close-reason, empty-drain,
/// release-ok, strict-emission, stop-ok, wait-ok, owned-completion-ok,
/// cleanup-clean, lifecycle-marker.
/// Facet map (websocket_test.go harness, L144-184): boot-ok pins the
/// boot result (L153-154: boot(18373n) kind is ok); boot-port pins the
/// loopback port (L153: 18373n verbatim); link-ok pins the dial result
/// (L156-157: link kind is ok); link-url pins the socket url (L156:
/// "ws://127.0.0.1:18373/socket" verbatim); protocol-empty pins the
/// subprotocol (L159: conn.protocol is ""); push-ok pins the text send
/// (L160-161: push kind ok and value 2n); text-frame pins the text echo
/// (L162-164: first drain length 1 with text "hi"); push-raw-ok pins
/// the binary send (L165-166: pushRaw kind ok and value 3n);
/// binary-frame pins the binary echo (L167-169: second drain length 1
/// with data [1,2,3]); bye-ok pins the close result (L170-171: bye
/// kind is ok); close-code pins the close code (L174: 1000n);
/// close-reason pins the close reason (L174: "done"); empty-drain pins
/// the final drain (L175-176: empty drain length 0); release-ok pins
/// the release result (L177: release kind is ok); strict-emission pins
/// the optional emission leg (L95-100: strict tsc over the emitted
/// entry.ts passes if and only if CAN_TSC is set); stop-ok pins the
/// stop result (L178: $canServer.stop kind is ok); wait-ok pins the
/// wait result (L179: $canServer.wait kind is ok);
/// owned-completion-ok pins the owned completion (L182:
/// owned.completion.kind is ok); cleanup-clean pins clean teardown
/// (L182: cleanupFailed is false); lifecycle-marker pins the harness
/// marker (L183: "compiled websocket lifecycle passed" verbatim; the
/// harness prints it only after every lifecycle assertion passes).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool boot_ok
    int boot_port
    bool link_ok
    str link_url
    str protocol
    int push_sent
    str text_frame
    int raw_sent
    str binary_frame
    bool bye_ok
    int close_code
    str close_reason
    int empty_count
    bool release_ok
    bool strict_emission
    bool stop_ok
    bool wait_ok
    bool owned_completion_ok
    bool cleanup_clean
    str lifecycle_marker
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
