        int expected
        context c
        str check
    asserts
        same: 18373, 18373, context("ws/ws-lifecycle", "default", "", "offline"), "boot-port" => ok evidence("boot-port", "18373", "18373", true, "case ws/ws-lifecycle variant default root boot-port run offline")
        different: 18372, 18373, context("ws/ws-lifecycle", "default", "", "offline"), "boot-port" => failed{"boot-port"}
    match observed is expected
