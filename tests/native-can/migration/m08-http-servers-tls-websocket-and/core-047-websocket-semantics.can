        str root
    asserts
        sample: context("ws/ws-lifecycle", "default", "", "offline"), "boot-ok" => ok "case ws/ws-lifecycle variant default root boot-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("ws/ws-lifecycle", "default", "", "offline"), "boot-ok" => ok evidence("boot-ok", "true", "true", true, "case ws/ws-lifecycle variant default root boot-ok run offline")
        different: false, true, context("ws/ws-lifecycle", "default", "", "offline"), "boot-ok" => failed{"boot-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
