package m09core008cli
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-008 "bundled CLI: argv, pipe, build and failure semantics".
/// Source: tests/integration/cli_test.go symbol
/// TestCurrentBundledCLI (L16-168).
/// Related fixture: compiler/testdata/current/cli/echo.can (read at L54,
/// staged as src/main.can at L58; the echo entry behind every run leg).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): argv forwarding (all eight values byte-exact),
/// hostile BUN_OPTIONS ignored, closed-pipe io::write_failed mapping,
/// cross-file call with forward initializer, build JSON identity fields,
/// static entry/type failures, runtime bounds, initializer failure,
/// domain redaction, and malformed-usage rejection.
/// The roots-green pin lives in core-008-roots-green.can; the production
/// process shape lives in core-008-run-shape.can.
/// Variants: argv Unicode/newline, --inspect, --, -e, preload-like,
/// empty, BOM, spaces (Go L78); closed pipe (L86-102); cross-module
/// forward initializer (L103-107); bad entry, static mismatch, bounds,
/// initializer, domain failure, three malformed invocations (L127-167).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 300000ms mirrors the Go 5-minute ctx (L26).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QF1 unmet).
/// Case cli/bundled-cli checks: argv-unicode, argv-inspect,
/// argv-separator, argv-eval, argv-preload, argv-empty, argv-bom,
/// argv-spaces, argv-exit, argv-stderr-empty, hostile-bun-options,
/// broken-pipe-exit, broken-pipe-identity, cross-file-output,
/// forward-initializer, build-schema, build-kind, build-id-length,
/// build-entry, bad-entry-message, current-preserved,
/// static-mismatch-diagnosed, bounds-category, bounds-no-leak,
/// startup-verify, startup-init, domain-identity, domain-secret-absent,
/// usage-count, usage-exit, usage-needle.
/// Facet map (cli_test.go legs): argv-unicode pins he-double-acute-llo
/// space emoji newline (L78 first value, Go "h\u00e9llo \U0001F600\n":
/// stdout echoes it byte-exact per L79-81); argv-inspect pins
/// "--inspect" after "--" forwarded literally (L78-81, not a flag);
/// argv-separator pins "--" forwarded as data (L78-81);
/// argv-eval pins "-e" forwarded as data (L78-81); argv-preload pins
/// "--preload=/missing.ts" forwarded literally (L78-81); argv-empty
/// pins "" with empty stdout equal to the empty argv (L78-81);
/// argv-bom pins U+FEFF + "BOM" (L78 Go "\ufeffBOM"; Can has no \u
/// escape so the pin embeds a verbatim U+FEFF); argv-spaces pins
/// "space argument" verbatim (L78-81); argv-exit pins exit 0 for all
/// eight argv runs (L79-80); argv-stderr-empty pins empty stderr for
/// all eight argv runs (L79-80); hostile-bun-options pins the exact
/// hostile entry "BUN_OPTIONS=--preload=/missing/injected.ts" (L63)
/// which the staged CLI ignores (argv loop green despite it; the
/// broken-pipe leg instead uses a bare PATH+HOME env at L93);
/// broken-pipe-exit pins exit 1 with the reader closed pre-start
/// (L86-100); broken-pipe-identity pins the catalogue mapping
/// "identity":"can.error.v2:can.std.io@1::write_failed" (L100);
/// cross-file-output pins "multi-file!" (L105-106: decorate appends
/// the forwarded suffix); forward-initializer pins the verbatim line
/// "str suffix = later" (L103: suffix resolves the later-declared
/// "!" binding); build-schema pins schemaVersion 1 (L120);
/// build-kind pins kind "can.build" (L120); build-id-length pins a
/// 64-char buildID (L120); build-entry pins entry "entry.ts" (L120);
/// bad-entry-message pins the "entry must" needle (L129: int args
/// rejects the str[] argv entry); current-preserved pins current.json
/// byte-identical after the static failure (L132-135); the static
/// mismatch leg (L137-140: args[0] replaced by true) pins exit 1
/// with empty stdout and non-empty stderr but no substring, so
/// static-mismatch-diagnosed is a bool pin; bounds-category pins
/// "category":"bounds" (L143: run with no argv faults echo args[0]);
/// bounds-no-leak pins that the diagnostic discloses neither the
/// root path nor "stack" (L146-148); startup-verify pins "build
/// verification failed" (L153: int startup = 1 / 0 at L151);
/// startup-init pins "initialization failed" (L153);
/// domain-identity pins
/// "identity":"can.error.v2:can.project.root/app::failed" (L159;
/// registry actives app::failed at L156); domain-secret-absent pins
/// "must-not-disclose" absent from the diagnostic (L159);
/// usage-count pins the three malformed shapes (L162: ["build"],
/// ["run", root, "--inspect"], ["build", root, "extra"]); usage-exit
/// pins exit 2 (L163-164); usage-needle pins "usage:" (L164).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str argv_unicode
    str argv_inspect
    str argv_separator
    str argv_eval
    str argv_preload
    str argv_empty
    str argv_bom
    str argv_spaces
    int argv_exit
    bool argv_stderr_empty
    str hostile_bun_options
    int broken_pipe_exit
    str broken_pipe_identity
    str cross_file_output
    str forward_initializer
    int build_schema
    str build_kind
    int build_id_length
    str build_entry
    str bad_entry_message
    bool current_preserved
    bool static_mismatch_diagnosed
    str bounds_category
    bool bounds_no_leak
    str startup_verify
    str startup_init
    str domain_identity
    bool domain_secret_absent
    int usage_count
    int usage_exit
    str usage_needle
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cli/bundled-cli", "default", "", "offline"), "argv-unicode" => ok "case cli/bundled-cli variant default root argv-unicode run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cli/bundled-cli", "default", "", "offline"), "argv-stderr-empty" => ok evidence("argv-stderr-empty", "true", "true", true, "case cli/bundled-cli variant default root argv-stderr-empty run offline")
        different: false, true, context("cli/bundled-cli", "default", "", "offline"), "argv-stderr-empty" => failed{"argv-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("cli/bundled-cli", "default", "", "offline"), "argv-exit" => ok evidence("argv-exit", "0", "0", true, "case cli/bundled-cli variant default root argv-exit run offline")
        different: 1, 0, context("cli/bundled-cli", "default", "", "offline"), "argv-exit" => failed{"argv-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "--inspect", "--inspect", context("cli/bundled-cli", "default", "", "offline"), "argv-inspect" => ok evidence("argv-inspect", "--inspect", "--inspect", true, "case cli/bundled-cli variant default root argv-inspect run offline")
        different: "--inspect=true", "--inspect", context("cli/bundled-cli", "default", "", "offline"), "argv-inspect" => failed{"argv-inspect"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
