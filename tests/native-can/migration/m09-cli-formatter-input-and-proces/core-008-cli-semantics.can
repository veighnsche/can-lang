fn check[] checks
    emits {}
    given
        str scope
    asserts
        m09_008: "m09-008" => ok [check("argv-unicode", "unicode/newline argv echoes byte-exact"), check("argv-inspect", "--inspect after -- forwards literally"), check("argv-separator", "-- forwards literally as data"), check("argv-eval", "-e forwards literally as data"), check("argv-preload", "preload-like argv forwards literally"), check("argv-empty", "empty argv echoes as empty stdout"), check("argv-bom", "BOM-prefixed argv echoes byte-exact"), check("argv-spaces", "spaced argv echoes verbatim"), check("argv-exit", "all eight argv runs exit 0"), check("argv-stderr-empty", "all eight argv runs keep stderr empty"), check("hostile-bun-options", "staged CLI ignores the hostile BUN_OPTIONS preload"), check("broken-pipe-exit", "closed stdout pipe exits 1"), check("broken-pipe-identity", "closed stdout pipe maps to io::write_failed"), check("cross-file-output", "cross-module decorate run prints multi-file!"), check("forward-initializer", "forward initializer resolves the later binding"), check("build-schema", "build report schemaVersion is 1"), check("build-kind", "build report kind is can.build"), check("build-id-length", "build report buildID is 64 chars"), check("build-entry", "build report entry is entry.ts"), check("bad-entry-message", "bad entry diagnostic says entry must"), check("current-preserved", "static failure preserves current.json bytes"), check("static-mismatch-diagnosed", "static mismatch exits 1 with a diagnostic"), check("bounds-category", "empty-argv run reports bounds category"), check("bounds-no-leak", "bounds diagnostic leaks no root or stack"), check("startup-verify", "initializer failure reports verification failure"), check("startup-init", "initializer failure reports initialization failure"), check("domain-identity", "domain failure reports the app::failed identity"), check("domain-secret-absent", "domain diagnostic redacts the secret payload"), check("usage-count", "three malformed shapes pinned"), check("usage-exit", "malformed invocations exit 2"), check("usage-needle", "malformed invocations print usage:")]
        other: "nope" => ok []
    match scope is "m09-008"
        false => ok []
