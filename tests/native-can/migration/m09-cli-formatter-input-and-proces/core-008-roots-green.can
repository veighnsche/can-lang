fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("cli/bundled-roots", "default", "", "offline") => ok
        seed_assert_green_drift: context("cli/bundled-roots", "seed-assert-green-drift", "", "offline") => failed{"assert-green"}
        seed_report_passed_drift: context("cli/bundled-roots", "seed-report-passed-drift", "", "offline") => failed{"report-passed"}
        seed_root_count_drift: context("cli/bundled-roots", "seed-root-count-drift", "", "offline") => failed{"root-count"}
        seed_initial_root_count_drift: context("cli/bundled-roots", "seed-initial-root-count-drift", "", "offline") => failed{"initial-root-count"}
        seed_fixture_name_drift: context("cli/bundled-roots", "seed-fixture-name-drift", "", "offline") => failed{"fixture-name"}
        seed_main_roots_drift: context("cli/bundled-roots", "seed-main-roots-drift", "", "offline") => failed{"main-roots"}
        seed_decorate_roots_drift: context("cli/bundled-roots", "seed-decorate-roots-drift", "", "offline") => failed{"decorate-roots"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.assert_green, true, c, "assert-green")
            failed
            ok evidence assert_evidence => match call require_bool(got.report_passed, true, c, "report-passed")
                failed
                ok evidence passed_evidence => match call require_int(got.root_count, 2, c, "root-count")
