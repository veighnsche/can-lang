    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, 2, 1, "echo.can", 1, 1)
        seed_assert_green_drift: "seed-assert-green-drift" => ok observation(false, true, 2, 1, "echo.can", 1, 1)
        seed_report_passed_drift: "seed-report-passed-drift" => ok observation(true, false, 2, 1, "echo.can", 1, 1)
        seed_root_count_drift: "seed-root-count-drift" => ok observation(true, true, 1, 1, "echo.can", 1, 1)
        seed_initial_root_count_drift: "seed-initial-root-count-drift" => ok observation(true, true, 2, 0, "echo.can", 1, 1)
        seed_fixture_name_drift: "seed-fixture-name-drift" => ok observation(true, true, 2, 1, "helper.can", 1, 1)
        seed_main_roots_drift: "seed-main-roots-drift" => ok observation(true, true, 2, 1, "echo.can", 0, 1)
        seed_decorate_roots_drift: "seed-decorate-roots-drift" => ok observation(true, true, 2, 1, "echo.can", 1, 0)
