/// M09 CORE-008 "bundled CLI: roots green, echo plus helper inventory".
/// Source: tests/integration/cli_test.go symbol
/// TestCurrentBundledCLI (L16-168).
/// Related fixture: compiler/testdata/current/cli/echo.can (read at L54,
/// staged as src/main.can at L58); the second staged file src/helper.can
/// is inline in the Go test (L103: forward initializer plus decorate).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): static assert inventory of the staged CLI
/// project as the green baseline: exactly 2 roots at the multi-file
/// stage (main 1 + decorate 1) and exactly 1 root at the echo-only
/// initial stage (main alone).
/// ADAPTATION (recorded, with source lines): TestCurrentBundledCLI
/// drives only canlc run/build (L59-167) and contains no assert leg, so
/// assert-green/report-passed pin the would-be canlc assert outcome over
/// the staged sources for P23 qualification; no execution is claimed
/// here (accept_after P23/QF1 unmet).
/// Facet map (cli_test.go legs plus fixture arms): assert-green pins the
/// would-be assert exit (no Go leg; P23 baseline); report-passed pins
/// the would-be report; root-count pins the multi-file total (L103-108:
/// helper.can plus the rewritten main, 1 + 1 = 2); initial-root-count
/// pins the echo-only total (L58: only src/main.can staged, main = 1);
/// fixture-name grounds the pins in the staged fixture (L54: echo.can;
/// L58: src/main.can); main-roots pins echo.can main (fixture L9:
/// sample ["hello"] => ok, 1 root; the L14 when-table row sample
/// message => ok 5 is not an assert root, matching the CORE-014
/// seal_size precedent and declaration.Assertions roots);
/// decorate-roots pins helper.can decorate (Go L103: sample "hello" =>
/// ok "hello!", 1 root; the L104 rewrite keeps the asserts block).
/// CLI behaviors live in core-008-cli-semantics.can; the production
/// process shape lives in core-008-run-shape.can.
/// Variants: none in this file (default only); the eight argv values,
/// closed pipe, cross-file run, build, failure and usage legs live in
/// the cli-semantics file.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 300000ms mirrors the Go 5-minute ctx (L26).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QF1 unmet).
/// Case cli/bundled-roots checks: assert-green, report-passed,
/// root-count, initial-root-count, fixture-name, main-roots,
/// decorate-roots.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    int initial_root_count
    str fixture_name
    int main_roots
    int decorate_roots
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cli/bundled-roots", "default", "", "offline"), "assert-green" => ok "case cli/bundled-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cli/bundled-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case cli/bundled-roots variant default root assert-green run offline")
        different: false, true, context("cli/bundled-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("cli/bundled-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "2", "2", true, "case cli/bundled-roots variant default root root-count run offline")
        different: 1, 2, context("cli/bundled-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "echo.can", "echo.can", context("cli/bundled-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "echo.can", "echo.can", true, "case cli/bundled-roots variant default root fixture-name run offline")
        different: "helper.can", "echo.can", context("cli/bundled-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
