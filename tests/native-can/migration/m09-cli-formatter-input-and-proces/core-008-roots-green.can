        "seed-report-passed-drift" => ok observation(true, false, 2, 1, "echo.can", 1, 1)
        "seed-root-count-drift" => ok observation(true, true, 1, 1, "echo.can", 1, 1)
        "seed-initial-root-count-drift" => ok observation(true, true, 2, 0, "echo.can", 1, 1)
        "seed-fixture-name-drift" => ok observation(true, true, 2, 1, "helper.can", 1, 1)
        "seed-main-roots-drift" => ok observation(true, true, 2, 1, "echo.can", 0, 1)
        "seed-decorate-roots-drift" => ok observation(true, true, 2, 1, "echo.can", 1, 0)
        _ => ok observation(true, true, 2, 1, "echo.can", 1, 1)
