                    ok evidence count_evidence => match call require_int(got.initial_root_count, 1, c, "initial-root-count")
                        failed
                        ok evidence initial_evidence => match call require_text(got.fixture_name, "echo.can", c, "fixture-name")
                            failed
                            ok evidence fixture_evidence => match call require_int(got.main_roots, 1, c, "main-roots")
                                failed
                                ok evidence main_evidence => match call require_int(got.decorate_roots, 1, c, "decorate-roots")
                                    failed
                                    ok evidence decorate_evidence => ok
