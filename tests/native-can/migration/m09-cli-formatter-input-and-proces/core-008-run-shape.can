    emits {}
    given
        str scope
    asserts
        m09_008: "m09-008" => ok [check("run-exit", "ok runs exit 0"), check("run-stderr-empty", "ok runs keep stderr empty"), check("stdout-argv-unicode", "unicode/newline stdout echoes byte-exact"), check("stdout-argv-inspect", "inspect stdout forwards literally"), check("stdout-argv-separator", "separator stdout forwards as data"), check("stdout-argv-eval", "eval stdout forwards as data"), check("stdout-argv-preload", "preload-like stdout forwards literally"), check("stdout-argv-empty", "empty stdout equals the empty argv"), check("stdout-argv-bom", "BOM stdout echoes byte-exact"), check("stdout-argv-spaces", "spaced stdout echoes verbatim"), check("stdout-cross-file", "cross-file stdout is multi-file!"), check("build-exit", "build exits 0"), check("build-stderr-empty", "build keeps stderr empty"), check("build-stdout-report", "build stdout carries the JSON report"), check("fault-exit", "fault runs exit 1"), check("fault-stdout-empty", "fault runs keep stdout empty"), check("usage-exit", "malformed invocations exit 2"), check("usage-stderr", "malformed stderr carries usage:"), check("sandbox-profile", "invocation pins the deny-network profile"), check("offline-path", "invocation clears PATH to /nonexistent"), check("symlink-launch", "CLI runs through the outside symlink"), check("offline-ok", "offline sandboxed invocation succeeds")]
        other: "nope" => ok []
