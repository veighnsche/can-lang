package m09core008run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-008 "bundled CLI: run shape, echo/fault/usage split".
/// Source: tests/integration/cli_test.go symbol
/// TestCurrentBundledCLI (L16-168).
/// Related fixture: compiler/testdata/current/cli/echo.can (the echo
/// entry behind every run leg; staged as src/main.can at L58).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the staged CLI.
/// Unlike rows with a silent entry, the echo entry emits its argv on
/// stdout by design (Go L79-81), so the non-silent stdouts are pinned
/// verbatim here (nine stdout pins) and the silence pins land where
/// silence holds: empty stderr on the ok and build paths, empty stdout
/// on the fault path.
/// ADAPTATIONS (recorded, with source lines): the build stdout carries
/// the JSON report with a nondeterministic 64-char buildID and temp-dir
/// paths (L113-122), so build-stdout-report is a bool shape pin while
/// the stable report fields live in cli-semantics; usage stdout is
/// unpinned because the Go test discards it (L163 binds out to _), so
/// no usage-stdout check is authored.
/// The roots-green pin lives in core-008-roots-green.can; argv values,
/// hostile env, pipe mapping, cross-file behavior, build fields,
/// failure needles and usage shapes live in
/// core-008-cli-semantics.can.
/// Variants: ok path (eight argv echoes plus the cross-file echo),
/// build path, fault path (broken pipe, bad entry, static mismatch,
/// bounds, startup, domain), usage path (three malformed shapes).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 300000ms mirrors the Go 5-minute ctx (L26).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QF1 unmet).
/// Case cli/bundled-run checks: run-exit, run-stderr-empty,
/// stdout-argv-unicode, stdout-argv-inspect, stdout-argv-separator,
/// stdout-argv-eval, stdout-argv-preload, stdout-argv-empty,
/// stdout-argv-bom, stdout-argv-spaces, stdout-cross-file, build-exit,
/// build-stderr-empty, build-stdout-report, fault-exit,
/// fault-stdout-empty, usage-exit, usage-stderr, sandbox-profile,
/// offline-path, symlink-launch, offline-ok.
/// Facet map (cli_test.go legs): run-exit pins exit 0 on the ok path
/// (L80: argv loop; L105: cross-file); run-stderr-empty pins empty
/// stderr on the ok path (L80, L105); stdout-argv-unicode pins the
/// verbatim echo of he-double-acute-llo space emoji newline (L78-81);
/// stdout-argv-inspect pins "--inspect" echoed after "--" (L78-81);
/// stdout-argv-separator pins "--" echoed as data (L78-81);
/// stdout-argv-eval pins "-e" echoed as data (L78-81);
/// stdout-argv-preload pins "--preload=/missing.ts" echoed (L78-81);
/// stdout-argv-empty pins empty stdout for the empty argv (L78-81);
/// stdout-argv-bom pins U+FEFF + "BOM" echoed (L78 Go "\ufeffBOM";
/// verbatim U+FEFF since Can has no \u escape); stdout-argv-spaces
/// pins "space argument" echoed (L78-81); stdout-cross-file pins
/// "multi-file!" (L105-106); build-exit pins exit 0 for build (L110);
/// build-stderr-empty pins empty build stderr (L110);
/// build-stdout-report pins that build stdout parses as the can.build
/// report (L113-122; nondeterministic buildID, see adaptation);
/// fault-exit pins exit 1 across the six fault legs (L100/L129/L138/
/// L143/L153/L159); fault-stdout-empty pins empty stdout across the
/// same six legs; usage-exit pins exit 2 (L163-164); usage-stderr
/// pins the "usage:" needle (L164); sandbox-profile pins the
/// invocation shape (L61/L91: "(version 1)(allow default)(deny
/// network*)" verbatim); offline-path pins the cleared environment
/// (L63/L93: "PATH=/nonexistent" verbatim); symlink-launch pins the
/// outside-bundle symlink invocation (L34-37 staged, L61/L91 run);
/// offline-ok pins the offline behavior (L79-83: the sandboxed
/// deny-network argv loop with hostile BUN_OPTIONS stays green).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool run_stderr_empty
    str stdout_argv_unicode
    str stdout_argv_inspect
    str stdout_argv_separator
    str stdout_argv_eval
    str stdout_argv_preload
    str stdout_argv_empty
    str stdout_argv_bom
    str stdout_argv_spaces
    str stdout_cross_file
    int build_exit
    bool build_stderr_empty
    bool build_stdout_report
    int fault_exit
    bool fault_stdout_empty
    int usage_exit
    str usage_stderr
    str sandbox_profile
    str offline_path
    bool symlink_launch
    bool offline_ok
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cli/bundled-run", "default", "", "offline"), "run-exit" => ok "case cli/bundled-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cli/bundled-run", "default", "", "offline"), "run-stderr-empty" => ok evidence("run-stderr-empty", "true", "true", true, "case cli/bundled-run variant default root run-stderr-empty run offline")
        different: false, true, context("cli/bundled-run", "default", "", "offline"), "run-stderr-empty" => failed{"run-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("cli/bundled-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case cli/bundled-run variant default root run-exit run offline")
        different: 1, 0, context("cli/bundled-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("cli/bundled-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case cli/bundled-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("cli/bundled-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
