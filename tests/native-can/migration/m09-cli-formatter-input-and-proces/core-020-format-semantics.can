    asserts
        known: "format/format-semantics" => ok [expected_check("rewrite-changed", "true"), expected_check("fn-line", "fn int tally\n"), expected_check("comment-retained", "// total with tip\n"), expected_check("seed-comment-retained", "int seed  // per cover\n"), expected_check("roots-retained", "true"), expected_check("root-identities", "app/tally#sample,app/tally#pair"), expected_check("idempotent-second-pass", "true"), expected_check("invalid-exit", "1"), expected_check("invalid-untouched", "true"), expected_check("invalid-suffix", "fn int broken(\n")]
        unknown: "nope" => ok []
    match case is "format/format-semantics"
        false => ok []
        true => ok [expected_check("rewrite-changed", "true"), expected_check("fn-line", "fn int tally\n"), expected_check("comment-retained", "// total with tip\n"), expected_check("seed-comment-retained", "int seed  // per cover\n"), expected_check("roots-retained", "true"), expected_check("root-identities", "app/tally#sample,app/tally#pair"), expected_check("idempotent-second-pass", "true"), expected_check("invalid-exit", "1"), expected_check("invalid-untouched", "true"), expected_check("invalid-suffix", "fn int broken(\n")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("format/format-semantics", "default", "", "offline") => ok
        seed_rewrite_changed_drift: context("format/format-semantics", "seed-rewrite-changed-drift", "", "offline") => failed{"rewrite-changed"}
        seed_fn_line_drift: context("format/format-semantics", "seed-fn-line-drift", "", "offline") => failed{"fn-line"}
        seed_comment_retained_drift: context("format/format-semantics", "seed-comment-retained-drift", "", "offline") => failed{"comment-retained"}
        seed_seed_comment_retained_drift: context("format/format-semantics", "seed-seed-comment-retained-drift", "", "offline") => failed{"seed-comment-retained"}
        seed_roots_retained_drift: context("format/format-semantics", "seed-roots-retained-drift", "", "offline") => failed{"roots-retained"}
        seed_root_identities_drift: context("format/format-semantics", "seed-root-identities-drift", "", "offline") => failed{"root-identities"}
        seed_idempotent_second_pass_drift: context("format/format-semantics", "seed-idempotent-second-pass-drift", "", "offline") => failed{"idempotent-second-pass"}
        seed_invalid_exit_drift: context("format/format-semantics", "seed-invalid-exit-drift", "", "offline") => failed{"invalid-exit"}
        seed_invalid_untouched_drift: context("format/format-semantics", "seed-invalid-untouched-drift", "", "offline") => failed{"invalid-untouched"}
        seed_invalid_suffix_drift: context("format/format-semantics", "seed-invalid-suffix-drift", "", "offline") => failed{"invalid-suffix"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.rewrite_changed, true, c, "rewrite-changed")
            failed
            ok evidence rewrite_evidence => match call require_text(got.fn_line, "fn int tally\n", c, "fn-line")
                failed
                ok evidence fn_evidence => match call require_text(got.comment_retained, "// total with tip\n", c, "comment-retained")
                    failed
                    ok evidence comment_evidence => match call require_text(got.seed_comment_retained, "int seed  // per cover\n", c, "seed-comment-retained")
                        failed
                        ok evidence seed_evidence => match call require_bool(got.roots_retained, true, c, "roots-retained")
                            failed
                            ok evidence retained_evidence => match call require_text(got.root_identities, "app/tally#sample,app/tally#pair", c, "root-identities")
                                failed
                                ok evidence identities_evidence => match call require_bool(got.idempotent_second_pass, true, c, "idempotent-second-pass")
                                    failed
                                    ok evidence idempotent_evidence => match call require_int(got.invalid_exit, 1, c, "invalid-exit")
                                        failed
                                        ok evidence invexit_evidence => match call require_bool(got.invalid_untouched, true, c, "invalid-untouched")
                                            failed
                                            ok evidence untouched_evidence => match call require_text(got.invalid_suffix, "fn int broken(\n", c, "invalid-suffix")
                                                failed
                                                ok evidence suffix_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m09_020: "m09-020" => ok test_case("format/format-semantics", ["format", "m09"], ["can-bun-archive"], 120000, [check_ref("rewrite-changed"), check_ref("fn-line"), check_ref("comment-retained"), check_ref("seed-comment-retained"), check_ref("roots-retained"), check_ref("root-identities"), check_ref("idempotent-second-pass"), check_ref("invalid-exit"), check_ref("invalid-untouched"), check_ref("invalid-suffix")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m09-020"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("format/format-semantics", ["format", "m09"], ["can-bun-archive"], 120000, [check_ref("rewrite-changed"), check_ref("fn-line"), check_ref("comment-retained"), check_ref("seed-comment-retained"), check_ref("roots-retained"), check_ref("root-identities"), check_ref("idempotent-second-pass"), check_ref("invalid-exit"), check_ref("invalid-untouched"), check_ref("invalid-suffix")], callable case_body)
