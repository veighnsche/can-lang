fn check[] checks
    emits {}
    given
        str scope
    asserts
        m09_020: "m09-020" => ok [check("rewrite-changed", "format rewrites the messy source instead of leaving it byte-identical"), check("fn-line", "formatted output carries the normalized fn int tally line"), check("comment-retained", "formatted output retains the total-with-tip comment"), check("seed-comment-retained", "formatted output retains the per-cover trailing comment"), check("roots-retained", "assert root identities match before and after formatting"), check("root-identities", "joined root identities pin app/tally sample and pair"), check("idempotent-second-pass", "a second format pass is byte-identical"), check("invalid-exit", "formatting syntactically invalid source exits 1"), check("invalid-untouched", "invalid source is left untouched on disk"), check("invalid-suffix", "untouched file keeps the broken-declaration suffix")]
        other: "nope" => ok []
    match scope is "m09-020"
        false => ok []
        true => ok [check("rewrite-changed", "format rewrites the messy source instead of leaving it byte-identical"), check("fn-line", "formatted output carries the normalized fn int tally line"), check("comment-retained", "formatted output retains the total-with-tip comment"), check("seed-comment-retained", "formatted output retains the per-cover trailing comment"), check("roots-retained", "assert root identities match before and after formatting"), check("root-identities", "joined root identities pin app/tally sample and pair"), check("idempotent-second-pass", "a second format pass is byte-identical"), check("invalid-exit", "formatting syntactically invalid source exits 1"), check("invalid-untouched", "invalid source is left untouched on disk"), check("invalid-suffix", "untouched file keeps the broken-declaration suffix")]
