fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("format/format-roots", "default", "", "offline") => ok
        seed_assert_green_drift: context("format/format-roots", "seed-assert-green-drift", "", "offline") => failed{"assert-green"}
        seed_report_passed_drift: context("format/format-roots", "seed-report-passed-drift", "", "offline") => failed{"report-passed"}
        seed_root_count_drift: context("format/format-roots", "seed-root-count-drift", "", "offline") => failed{"root-count"}
        seed_fixture_name_drift: context("format/format-roots", "seed-fixture-name-drift", "", "offline") => failed{"fixture-name"}
        seed_tally_roots_drift: context("format/format-roots", "seed-tally-roots-drift", "", "offline") => failed{"tally-roots"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.assert_green, true, c, "assert-green")
            failed
            ok evidence assert_evidence => match call require_bool(got.report_passed, true, c, "report-passed")
                failed
                ok evidence passed_evidence => match call require_int(got.root_count, 2, c, "root-count")
                    failed
                    ok evidence count_evidence => match call require_text(got.fixture_name, "src/main.can", c, "fixture-name")
                        failed
                        ok evidence fixture_evidence => match call require_int(got.tally_roots, 2, c, "tally-roots")
                            failed
                            ok evidence tally_evidence => ok
