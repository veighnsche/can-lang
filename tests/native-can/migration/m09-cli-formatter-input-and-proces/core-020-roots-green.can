record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("format/format-roots", "default", "", "offline"), "assert-green" => ok "case format/format-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("format/format-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case format/format-roots variant default root assert-green run offline")
        different: false, true, context("format/format-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("format/format-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "2", "2", true, "case format/format-roots variant default root root-count run offline")
        different: 1, 2, context("format/format-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "src/main.can", "src/main.can", context("format/format-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "src/main.can", "src/main.can", true, "case format/format-roots variant default root fixture-name run offline")
        different: "src/helper.can", "src/main.can", context("format/format-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, 2, "src/main.can", 2)
        seed_assert_green_drift: "seed-assert-green-drift" => ok observation(false, true, 2, "src/main.can", 2)
        seed_report_passed_drift: "seed-report-passed-drift" => ok observation(true, false, 2, "src/main.can", 2)
        seed_root_count_drift: "seed-root-count-drift" => ok observation(true, true, 1, "src/main.can", 2)
        seed_fixture_name_drift: "seed-fixture-name-drift" => ok observation(true, true, 2, "src/helper.can", 2)
        seed_tally_roots_drift: "seed-tally-roots-drift" => ok observation(true, true, 2, "src/main.can", 1)
    match variant_id
        "seed-assert-green-drift" => ok observation(false, true, 2, "src/main.can", 2)
        "seed-report-passed-drift" => ok observation(true, false, 2, "src/main.can", 2)
        "seed-root-count-drift" => ok observation(true, true, 1, "src/main.can", 2)
        "seed-fixture-name-drift" => ok observation(true, true, 2, "src/helper.can", 2)
        "seed-tally-roots-drift" => ok observation(true, true, 2, "src/main.can", 1)
        _ => ok observation(true, true, 2, "src/main.can", 2)
