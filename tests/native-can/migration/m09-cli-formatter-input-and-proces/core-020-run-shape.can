    asserts
        sample: context("format/format-run", "default", "", "offline"), "format-exit" => ok "case format/format-run variant default root format-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
