    asserts
        same: true, true, context("format/format-run", "default", "", "offline"), "assert-before-stderr-empty" => ok evidence("assert-before-stderr-empty", "true", "true", true, "case format/format-run variant default root assert-before-stderr-empty run offline")
        different: false, true, context("format/format-run", "default", "", "offline"), "assert-before-stderr-empty" => failed{"assert-before-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
