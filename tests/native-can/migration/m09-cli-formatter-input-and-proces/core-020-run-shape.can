    asserts
        same: 0, 0, context("format/format-run", "default", "", "offline"), "format-exit" => ok evidence("format-exit", "0", "0", true, "case format/format-run variant default root format-exit run offline")
        different: 1, 0, context("format/format-run", "default", "", "offline"), "format-exit" => failed{"format-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
