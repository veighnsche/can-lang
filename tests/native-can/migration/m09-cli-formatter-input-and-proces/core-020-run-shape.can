        seed_assert_before_stderr_empty_drift: "seed-assert-before-stderr-empty-drift" => ok observation(0, false, 0, true, true, 0, 0, 1)
        seed_assert_after_exit_drift: "seed-assert-after-exit-drift" => ok observation(0, true, 1, true, true, 0, 0, 1)
        seed_assert_after_stderr_empty_drift: "seed-assert-after-stderr-empty-drift" => ok observation(0, true, 0, false, true, 0, 0, 1)
        seed_assert_stdout_report_drift: "seed-assert-stdout-report-drift" => ok observation(0, true, 0, true, false, 0, 0, 1)
