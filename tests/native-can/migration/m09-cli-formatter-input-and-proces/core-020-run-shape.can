        same: "format", "format", context("format/format-run", "default", "", "offline"), "format-exit" => ok evidence("format-exit", "format", "format", true, "case format/format-run variant default root format-exit run offline")
        different: "assert", "format", context("format/format-run", "default", "", "offline"), "format-exit" => failed{"format-exit"}
    match observed is expected
