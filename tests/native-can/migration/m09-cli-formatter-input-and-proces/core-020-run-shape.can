package m09core020run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-020 "format: production run shape, assert/format exits".
/// Source: tests/integration/format_test.go symbol
/// TestFormatPreservesExecution (L35-150).
/// Related fixture: none (related_sources empty); the staged
/// src/main.can is written from the inline formatMessy const
/// (Go L15-31) at L63.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the format flow:
/// assert exits 0 with empty stderr before and after formatting, both
/// valid formats exit 0, and the invalid format exits 1.
/// This row pins no non-silent output verbatim: the Go test decodes the
/// assert JSON stdout instead of byte-comparing it, and discards the
/// format stdouts, so the stdout pins below are shape pins and the
/// silence pins land where silence holds (assert stderr empty).
/// ADAPTATIONS (recorded, with source lines): assert-stdout-report is a
/// bool shape pin because the Go test JSON-decodes the assert stdout
/// (L96-98) and requires Passed (L99) rather than pinning stdout bytes;
/// no format-stdout check is authored because the Go test binds format
/// stdout to _ on all three format legs (L117, L137, L144); no
/// format-stderr check is authored because success-leg stderr is only
/// echoed inside failure messages (L117-119, L137-139) and the invalid
/// leg discards both streams (L144 binds out and diag to _).
/// The roots-green pin lives in core-020-roots-green.can; rewrite,
/// retention, idempotence and invalid-input semantics live in
/// core-020-format-semantics.can.
/// Variants: assert before, first format, assert after, second format,
/// invalid format (one check group each; no silent-entry path exists
/// because assert stdout always carries the JSON report).
/// Environment: CAN_BUN_ARCHIVE only; the Go test stages no sandbox
/// profile and pins no sandbox shape, so requires carries just
/// can-bun-archive. Logical gates SUITE/WORK/PROC/N1 and C/R/N/S/A
/// identities bind at P23; no live run now. Descriptor timeout
/// 120000ms mirrors the Go 2-minute ctx (L41).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case format/format-run checks: assert-before-exit,
/// assert-before-stderr-empty, assert-after-exit,
/// assert-after-stderr-empty, assert-stdout-report, format-exit,
/// second-format-exit, invalid-format-exit.
/// Facet map (format_test.go legs): assert-before-exit pins exit 0 on
/// the before-format assert (L112-115); assert-before-stderr-empty pins
/// empty stderr there (L113: diag != ""); assert-after-exit pins exit 0
/// on the after-format assert (L132); assert-after-stderr-empty pins
/// empty stderr there (L132); assert-stdout-report pins that assert
/// stdout decodes as a passing JSON report (L96-101; see adaptation);
/// format-exit pins exit 0 for the first valid format (L117-119);
/// second-format-exit pins exit 0 for the idempotence pass (L137-139);
/// invalid-format-exit pins exit 1 for the invalid source (L144-146).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int assert_before_exit
    bool assert_before_stderr_empty
    int assert_after_exit
    bool assert_after_stderr_empty
    bool assert_stdout_report
    int format_exit
    int second_format_exit
    int invalid_format_exit
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
