fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("format/format-run", "default", "", "offline") => ok
        seed_assert_before_exit_drift: context("format/format-run", "seed-assert-before-exit-drift", "", "offline") => failed{"assert-before-exit"}
        seed_assert_before_stderr_empty_drift: context("format/format-run", "seed-assert-before-stderr-empty-drift", "", "offline") => failed{"assert-before-stderr-empty"}
        seed_assert_after_exit_drift: context("format/format-run", "seed-assert-after-exit-drift", "", "offline") => failed{"assert-after-exit"}
        seed_assert_after_stderr_empty_drift: context("format/format-run", "seed-assert-after-stderr-empty-drift", "", "offline") => failed{"assert-after-stderr-empty"}
        seed_assert_stdout_report_drift: context("format/format-run", "seed-assert-stdout-report-drift", "", "offline") => failed{"assert-stdout-report"}
        seed_format_exit_drift: context("format/format-run", "seed-format-exit-drift", "", "offline") => failed{"format-exit"}
        seed_second_format_exit_drift: context("format/format-run", "seed-second-format-exit-drift", "", "offline") => failed{"second-format-exit"}
        seed_invalid_format_exit_drift: context("format/format-run", "seed-invalid-format-exit-drift", "", "offline") => failed{"invalid-format-exit"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.assert_before_exit, 0, c, "assert-before-exit")
            failed
            ok evidence before_exit_evidence => match call require_bool(got.assert_before_stderr_empty, true, c, "assert-before-stderr-empty")
                failed
                ok evidence before_stderr_evidence => match call require_int(got.assert_after_exit, 0, c, "assert-after-exit")
                    failed
                    ok evidence after_exit_evidence => match call require_bool(got.assert_after_stderr_empty, true, c, "assert-after-stderr-empty")
                        failed
                        ok evidence after_stderr_evidence => match call require_bool(got.assert_stdout_report, true, c, "assert-stdout-report")
                            failed
                            ok evidence report_evidence => match call require_int(got.format_exit, 0, c, "format-exit")
                                failed
                                ok evidence format_evidence => match call require_int(got.second_format_exit, 0, c, "second-format-exit")
                                    failed
                                    ok evidence second_evidence => match call require_int(got.invalid_format_exit, 1, c, "invalid-format-exit")
                                        failed
                                        ok evidence invalid_evidence => ok
