package m09core027capture
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-027 "bundled input capture: lock digest, retime split, stale".
/// Source: tests/integration/input_capture_test.go symbol
/// TestCurrentBundledInputCapture (L46-246).
/// Related fixtures: none shipped; vendor source (L102), fixture JSON
/// (L104-108) and the lock (L119-130) are inline in the Go test.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the independently length-framed lock digest
/// binding vendor source and raw fixture trees (L24-44, L114-118), the
/// timeout 5000/6000 options-identity split with stable source/dependency
/// identity and a second staged generation (L189-211), staged raw bytes
/// (L213-232), and stale-digest rejection without lock rewrite (L234-245).
/// The roots-green pin lives in core-027-roots-green.can; the production
/// process shape lives in core-027-run-shape.can.
/// Variants: timeout 5000 (L164) and 6000 (L191); fixture bytes before
/// (L215 marker) and after mutation (L236 edited).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 240000ms mirrors the Go 4-minute ctx (L52).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QN1 unmet).
/// Case capture/bundled-capture checks: source-prefix, fixture-prefix,
/// source-path, fixture-path-load, fixture-path-fetched, fixture-target,
/// fixture-schema, timeout-first, timeout-second, options-split,
/// source-stable, deps-stable, generation-first, generation-second,
/// staged-marker, mutated-marker, raw-evidence, stale-needle,
/// stale-exit-nonzero, lock-preserved.
/// Facet map (input_capture_test.go legs): source-prefix pins the source
/// tree prefix (L114: can-source-tree-v1); fixture-prefix pins the fixture
/// tree prefix (L115: can-fixture-tree-v1); source-path pins the digested
/// vendor path (L114: lib.can); fixture-path-load pins the raw load entry
/// (L117: src/fixtures/load.json); fixture-path-fetched pins the raw
/// fetched entry (L116: src/fixtures/fetched.json); fixture-target pins
/// the fixture target (L105: can.project.dependency/vendor/helpers::load);
/// fixture-schema pins the fixture schema (L105: can.native-fixture.v1);
/// timeout-first pins 5000 (L164); timeout-second pins 6000 (L191);
/// options-split pins distinct staged options across the retime (L209-211);
/// source-stable pins fixed source identity (L205); deps-stable pins fixed
/// dependency identity (L205); generation-first pins one staged generation
/// (L179-180); generation-second pins two staged generations (L196-197);
/// staged-marker pins the captured body bytes (L215: eyJjb3VudCI6N30=);
/// mutated-marker pins the edited body bytes (L236: eyJjb3VudCI6OH0=);
/// raw-evidence pins the raw evidence needle (L172: raw-provider-fixture);
/// stale-needle pins the rejection diagnostic (L239: stale dependency
/// digest); stale-exit-nonzero pins the nonzero stale exit (L239);
/// lock-preserved pins the untouched lock bytes (L242-245).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str source_prefix
    str fixture_prefix
    str source_path
    str fixture_path_load
    str fixture_path_fetched
    str fixture_target
    str fixture_schema
    int timeout_first
    int timeout_second
    bool options_split
    bool source_stable
    bool deps_stable
    int generation_first
    int generation_second
    str staged_marker
    str mutated_marker
    str raw_evidence
    str stale_needle
    bool stale_exit_nonzero
    bool lock_preserved
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("capture/bundled-capture", "default", "", "offline"), "source-prefix" => ok "case capture/bundled-capture variant default root source-prefix run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("capture/bundled-capture", "default", "", "offline"), "options-split" => ok evidence("options-split", "true", "true", true, "case capture/bundled-capture variant default root options-split run offline")
        different: false, true, context("capture/bundled-capture", "default", "", "offline"), "options-split" => failed{"options-split"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5000, 5000, context("capture/bundled-capture", "default", "", "offline"), "timeout-first" => ok evidence("timeout-first", "5000", "5000", true, "case capture/bundled-capture variant default root timeout-first run offline")
        different: 5001, 5000, context("capture/bundled-capture", "default", "", "offline"), "timeout-first" => failed{"timeout-first"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can-source-tree-v1", "can-source-tree-v1", context("capture/bundled-capture", "default", "", "offline"), "source-prefix" => ok evidence("source-prefix", "can-source-tree-v1", "can-source-tree-v1", true, "case capture/bundled-capture variant default root source-prefix run offline")
        different: "can-source-tree-v1-drift", "can-source-tree-v1", context("capture/bundled-capture", "default", "", "offline"), "source-prefix" => failed{"source-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
