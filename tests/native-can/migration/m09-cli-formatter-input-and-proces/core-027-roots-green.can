    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    str fixture_name
    int load_helper_roots
    int load_consumer_roots
    int main_roots
    int vendor_load_roots
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("capture/bundled-roots", "default", "", "offline"), "assert-green" => ok "case capture/bundled-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("capture/bundled-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case capture/bundled-roots variant default root assert-green run offline")
        different: false, true, context("capture/bundled-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("capture/bundled-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "4", "4", true, "case capture/bundled-roots variant default root root-count run offline")
        different: 5, 4, context("capture/bundled-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "fixtures/load.json", "fixtures/load.json", context("capture/bundled-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "fixtures/load.json", "fixtures/load.json", true, "case capture/bundled-roots variant default root fixture-name run offline")
        different: "fixtures/load.json-drift", "fixtures/load.json", context("capture/bundled-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
