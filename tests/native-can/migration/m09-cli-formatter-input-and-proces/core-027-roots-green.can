        "seed-report-passed-drift" => ok observation(true, false, 4, "fixtures/load.json", 1, 1, 1, 1)
        "seed-root-count-drift" => ok observation(true, true, 3, "fixtures/load.json", 1, 1, 1, 1)
        "seed-fixture-name-drift" => ok observation(true, true, 4, "fixtures/fetched.json", 1, 1, 1, 1)
        "seed-load-helper-roots-drift" => ok observation(true, true, 4, "fixtures/load.json", 0, 1, 1, 1)
        "seed-load-consumer-roots-drift" => ok observation(true, true, 4, "fixtures/load.json", 1, 0, 1, 1)
        "seed-main-roots-drift" => ok observation(true, true, 4, "fixtures/load.json", 1, 1, 0, 1)
        "seed-vendor-load-roots-drift" => ok observation(true, true, 4, "fixtures/load.json", 1, 1, 1, 0)
        _ => ok observation(true, true, 4, "fixtures/load.json", 1, 1, 1, 1)
