    asserts
        default: "default" => ok observation(true, true, 4, "fixtures/load.json", 1, 1, 1, 1)
        seed_assert_green_drift: "seed-assert-green-drift" => ok observation(false, true, 4, "fixtures/load.json", 1, 1, 1, 1)
        seed_report_passed_drift: "seed-report-passed-drift" => ok observation(true, false, 4, "fixtures/load.json", 1, 1, 1, 1)
        seed_root_count_drift: "seed-root-count-drift" => ok observation(true, true, 3, "fixtures/load.json", 1, 1, 1, 1)
        seed_fixture_name_drift: "seed-fixture-name-drift" => ok observation(true, true, 4, "fixtures/fetched.json", 1, 1, 1, 1)
        seed_load_helper_roots_drift: "seed-load-helper-roots-drift" => ok observation(true, true, 4, "fixtures/load.json", 0, 1, 1, 1)
        seed_load_consumer_roots_drift: "seed-load-consumer-roots-drift" => ok observation(true, true, 4, "fixtures/load.json", 1, 0, 1, 1)
