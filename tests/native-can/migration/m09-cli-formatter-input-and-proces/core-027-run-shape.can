package m09core027run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-027 "bundled input capture: run shape, assert/retime/stale".
/// Source: tests/integration/input_capture_test.go symbol
/// TestCurrentBundledInputCapture (L46-246).
/// Related fixtures: none shipped; staged sources, fixture JSON and the
/// lock are inline in the Go test (L99-130).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the staged capture
/// runs. The assert entry emits its JSON report on stdout by design (Go
/// L168-177), so the non-silent stdout facts are pinned here (report flag,
/// count, raw-evidence needle) and the silence pins land where silence
/// holds: empty stderr on the assert and retime paths.
/// ADAPTATIONS (recorded, with source lines, per the CORE-014/019/040
/// precedent): the retimed-run stdout is unpinned because the Go test
/// checks only its status/diag (L191-194, no report parse); the stale-run
/// stdout is unpinned because the Go test discards it (L238 binds out to
/// _); the stale exit is a nonzero bool pin because the Go test pins no
/// exact code (L239: status == 0 fails); the full report JSON is unpinned
/// beyond passed/count/timeout/evidence (L169-177).
/// The roots-green pin lives in core-027-roots-green.can; lock digests,
/// the retime split, staged bytes and stale rejection live in
/// core-027-capture-semantics.can.
/// Variants: assert path (timeout 5000), retime path (timeout 6000),
/// stale path (fixture-only edit).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 240000ms mirrors the Go 4-minute ctx (L52).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QN1 unmet).
/// Case capture/bundled-run checks: assert-exit, assert-stderr-empty,
/// assert-report-passed, assert-count, assert-stdout-evidence, retime-exit,
/// retime-stderr-empty, stale-exit-nonzero, stale-diagnostic,
/// sandbox-profile, offline-path, assert-flag, assert-binary, sandbox-tool.
/// Facet map (input_capture_test.go legs): assert-exit pins exit 0 on the
/// capture run (L165); assert-stderr-empty pins empty assert stderr (L165);
/// assert-report-passed pins the report flag (L169); assert-count pins 4
/// assertions (L169); assert-stdout-evidence pins the raw needle in the
/// report (L172: raw-provider-fixture); retime-exit pins exit 0 on the
/// retimed run (L192); retime-stderr-empty pins empty retime stderr (L192);
/// stale-exit-nonzero pins the nonzero stale exit (L239);
/// stale-diagnostic pins the rejection needle (L239: stale dependency
/// digest); sandbox-profile pins the invocation shape (L74: the full
/// version/allow/deny-network plus localhost network-outbound profile
/// verbatim); offline-path pins the cleared environment (L80:
/// PATH=/nonexistent verbatim); assert-flag pins the timeout flag (L164:
/// --assert-timeout-ms); assert-binary pins the staged runner (L75:
/// bin/canlc); sandbox-tool pins the launcher (L78: /usr/bin/sandbox-exec).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int assert_exit
    bool assert_stderr_empty
    bool assert_report_passed
    int assert_count
    str assert_stdout_evidence
    int retime_exit
    bool retime_stderr_empty
    bool stale_exit_nonzero
    str stale_diagnostic
    str sandbox_profile
    str offline_path
    str assert_flag
    str assert_binary
    str sandbox_tool
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("capture/bundled-run", "default", "", "offline"), "assert-exit" => ok "case capture/bundled-run variant default root assert-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("capture/bundled-run", "default", "", "offline"), "assert-stderr-empty" => ok evidence("assert-stderr-empty", "true", "true", true, "case capture/bundled-run variant default root assert-stderr-empty run offline")
        different: false, true, context("capture/bundled-run", "default", "", "offline"), "assert-stderr-empty" => failed{"assert-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("capture/bundled-run", "default", "", "offline"), "assert-exit" => ok evidence("assert-exit", "0", "0", true, "case capture/bundled-run variant default root assert-exit run offline")
        different: 1, 0, context("capture/bundled-run", "default", "", "offline"), "assert-exit" => failed{"assert-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "raw-provider-fixture", "raw-provider-fixture", context("capture/bundled-run", "default", "", "offline"), "assert-stdout-evidence" => ok evidence("assert-stdout-evidence", "raw-provider-fixture", "raw-provider-fixture", true, "case capture/bundled-run variant default root assert-stdout-evidence run offline")
        different: "raw-provider-fixture-drift", "raw-provider-fixture", context("capture/bundled-run", "default", "", "offline"), "assert-stdout-evidence" => failed{"assert-stdout-evidence"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
