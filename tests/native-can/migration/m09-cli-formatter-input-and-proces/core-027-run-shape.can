fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("capture/bundled-run", "default", "", "offline") => ok
        seed_assert_exit_drift: context("capture/bundled-run", "seed-assert-exit-drift", "", "offline") => failed{"assert-exit"}
        seed_assert_stderr_empty_drift: context("capture/bundled-run", "seed-assert-stderr-empty-drift", "", "offline") => failed{"assert-stderr-empty"}
        seed_assert_report_passed_drift: context("capture/bundled-run", "seed-assert-report-passed-drift", "", "offline") => failed{"assert-report-passed"}
        seed_assert_count_drift: context("capture/bundled-run", "seed-assert-count-drift", "", "offline") => failed{"assert-count"}
        seed_assert_stdout_evidence_drift: context("capture/bundled-run", "seed-assert-stdout-evidence-drift", "", "offline") => failed{"assert-stdout-evidence"}
        seed_retime_exit_drift: context("capture/bundled-run", "seed-retime-exit-drift", "", "offline") => failed{"retime-exit"}
        seed_retime_stderr_empty_drift: context("capture/bundled-run", "seed-retime-stderr-empty-drift", "", "offline") => failed{"retime-stderr-empty"}
        seed_stale_exit_nonzero_drift: context("capture/bundled-run", "seed-stale-exit-nonzero-drift", "", "offline") => failed{"stale-exit-nonzero"}
        seed_stale_diagnostic_drift: context("capture/bundled-run", "seed-stale-diagnostic-drift", "", "offline") => failed{"stale-diagnostic"}
        seed_sandbox_profile_drift: context("capture/bundled-run", "seed-sandbox-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_path_drift: context("capture/bundled-run", "seed-offline-path-drift", "", "offline") => failed{"offline-path"}
        seed_assert_flag_drift: context("capture/bundled-run", "seed-assert-flag-drift", "", "offline") => failed{"assert-flag"}
        seed_assert_binary_drift: context("capture/bundled-run", "seed-assert-binary-drift", "", "offline") => failed{"assert-binary"}
        seed_sandbox_tool_drift: context("capture/bundled-run", "seed-sandbox-tool-drift", "", "offline") => failed{"sandbox-tool"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.assert_exit, 0, c, "assert-exit")
            failed
            ok evidence assert_exit_evidence => match call require_bool(got.assert_stderr_empty, true, c, "assert-stderr-empty")
                failed
                ok evidence assert_stderr_empty_evidence => match call require_bool(got.assert_report_passed, true, c, "assert-report-passed")
                    failed
                    ok evidence assert_report_passed_evidence => match call require_int(got.assert_count, 4, c, "assert-count")
                        failed
                        ok evidence assert_count_evidence => match call require_text(got.assert_stdout_evidence, "raw-provider-fixture", c, "assert-stdout-evidence")
                            failed
                            ok evidence assert_stdout_evidence_evidence => match call require_int(got.retime_exit, 0, c, "retime-exit")
                                failed
                                ok evidence retime_exit_evidence => match call require_bool(got.retime_stderr_empty, true, c, "retime-stderr-empty")
                                    failed
                                    ok evidence retime_stderr_empty_evidence => match call require_bool(got.stale_exit_nonzero, true, c, "stale-exit-nonzero")
                                        failed
                                        ok evidence stale_exit_nonzero_evidence => match call require_text(got.stale_diagnostic, "stale dependency digest", c, "stale-diagnostic")
                                            failed
                                            ok evidence stale_diagnostic_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)(allow network-outbound (remote ip \"localhost:*\"))", c, "sandbox-profile")
                                                failed
                                                ok evidence sandbox_profile_evidence => match call require_text(got.offline_path, "PATH=/nonexistent", c, "offline-path")
                                                    failed
                                                    ok evidence offline_path_evidence => match call require_text(got.assert_flag, "--assert-timeout-ms", c, "assert-flag")
                                                        failed
                                                        ok evidence assert_flag_evidence => match call require_text(got.assert_binary, "bin/canlc", c, "assert-binary")
                                                            failed
                                                            ok evidence assert_binary_evidence => match call require_text(got.sandbox_tool, "/usr/bin/sandbox-exec", c, "sandbox-tool")
                                                                failed
                                                                ok evidence sandbox_tool_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m09_027: "m09-027" => ok test_case("capture/bundled-run", ["capture", "m09"], ["can-bun-archive", "macos-sandbox-exec"], 240000, [check_ref("assert-exit"), check_ref("assert-stderr-empty"), check_ref("assert-report-passed"), check_ref("assert-count"), check_ref("assert-stdout-evidence"), check_ref("retime-exit"), check_ref("retime-stderr-empty"), check_ref("stale-exit-nonzero"), check_ref("stale-diagnostic"), check_ref("sandbox-profile"), check_ref("offline-path"), check_ref("assert-flag"), check_ref("assert-binary"), check_ref("sandbox-tool")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
