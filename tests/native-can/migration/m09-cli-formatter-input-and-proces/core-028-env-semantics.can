package m09core028env
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-028 "bundled input/environment: env preservation, failures, bounds".
/// Source: tests/integration/io_env_test.go symbol
/// TestCurrentBundledInputEnvironment (L15-146).
/// Related fixtures: compiler/testdata/current/cli/environment.can (the
/// env entry behind the lookup legs), input.can and input-text.can (the
/// stdin entries behind the roundtrip/bounds legs); each staged as
/// src/main.can at L75.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): original-environment lookup preserving Unicode,
/// empty and hostile BUN_OPTIONS values as data; missing/invalid names
/// failing with allocated errors; stdin bounds with fixture-consistent
/// limit mutations; and the optional strict tsc emission.
/// The roots-green pin lives in core-028-roots-green.can; the production
/// process shape lives in core-028-run-shape.can.
/// Variants: VALUE, EMPTY, BUN_OPTIONS, MISSING, lower, A=B, empty name
/// (Go L80/L85); stdin samples empty/BOM-unicode/16-wide/binary (L91-94);
/// overflow 17 (L105); bad-UTF-8 byte (L109); -1 and 1048576 limit
/// mutations (L115/L121); per-fixture subtests (L69); CAN_TSC-gated
/// strict emission (L138-142).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec, CAN_TSC optional;
/// requires can-bun-archive, macos-sandbox-exec. Logical gates
/// SUITE/WORK/PROC/N1 and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 300000ms mirrors the Go 5-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QF1 unmet).
/// Case cli/input-env checks: env-value-unicode, env-empty,
/// env-hostile-value, env-ok-exit, env-ok-stderr-empty, missing-identity,
/// invalid-identity, invalid-lower, invalid-equals, invalid-empty-name,
/// env-error-exit, env-error-stdout-empty, hostile-bun-options,
/// stdin-limit, sample-bom-text, sample-width, sample-binary-length,
/// overflow-width, overflow-identity, utf8-identity, negative-limit,
/// large-limit, large-roundtrip, mutation-from, mutation-to, tsc-strict,
/// tsc-entry, tsc-optional.
/// Facet map (io_env_test.go legs): env-value-unicode pins h-e-acute plus
/// emoji (L56 cmd env, L80 want; Go literal h + U+00E9 + U+1F600; stdout
/// equals it byte-exact per L81); env-empty pins "" (L56 "EMPTY=", L80);
/// env-hostile-value pins "--preload=/must-not-execute.ts" (L56, L80: the
/// hostile value stays data); env-ok-exit pins exit 0 (L81);
/// env-ok-stderr-empty pins empty stderr (L81); missing-identity pins
/// the http::credentials_missing error needle (L85: MISSING);
/// invalid-identity pins the env::invalid_name error needle (L85: lower,
/// A=B, empty name); invalid-lower/invalid-equals/invalid-empty-name pin
/// the three invalid-name variants verbatim (L85); env-error-exit pins
/// exit 1 (L86); env-error-stdout-empty pins empty stdout (L86);
/// hostile-bun-options pins the exact hostile entry
/// "BUN_OPTIONS=--preload=/must-not-execute.ts" (L56) which the staged
/// entry reads as data without executing; stdin-limit pins 16
/// (input.can L11/input-text.can L10, Go L91/L105); sample-bom-text pins
/// U+FEFF + h-e-acute + emoji (L91 Go escape + literal; Can has no
/// backslash-u escape so the pin embeds a verbatim U+FEFF); sample-width
/// pins the 16-byte full-width sample (L91); sample-binary-length pins
/// the 4-byte input-only binary sample (L93: 0, 255, 128, 10);
/// overflow-width pins 17 (L105); overflow-identity pins the
/// io::limit_exceeded error needle (L105/L116); utf8-identity pins the
/// codec::invalid_data error needle (L109: input-text rejects byte 255);
/// negative-limit pins -1 (L115 mutation); large-limit pins 1048576
/// (L120-121); large-roundtrip pins the 1MiB exit-0 roundtrip with
/// awaited drain (L122); mutation-from pins "sample: 16 =>" and
/// mutation-to pins "sample: -1 =>" (L115: the limit mutation rewrites
/// the fixture sample rows consistently, since run verifies first per
/// L113-114); tsc-strict pins "--strict" and tsc-entry pins "entry.ts"
/// (L139); tsc-optional pins the if-and-only-if gating on CAN_TSC (L138).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_value_unicode
    str env_empty
    str env_hostile_value
    int env_ok_exit
    bool env_ok_stderr_empty
    str missing_identity
    str invalid_identity
    str invalid_lower
    str invalid_equals
    str invalid_empty_name
    int env_error_exit
    bool env_error_stdout_empty
    str hostile_bun_options
    int stdin_limit
    str sample_bom_text
    int sample_width
    int sample_binary_length
    int overflow_width
    str overflow_identity
    str utf8_identity
    int negative_limit
    int large_limit
    bool large_roundtrip
    str mutation_from
    str mutation_to
    str tsc_strict
    str tsc_entry
    bool tsc_optional
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cli/input-env", "default", "", "offline"), "env-value-unicode" => ok "case cli/input-env variant default root env-value-unicode run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cli/input-env", "default", "", "offline"), "env-ok-stderr-empty" => ok evidence("env-ok-stderr-empty", "true", "true", true, "case cli/input-env variant default root env-ok-stderr-empty run offline")
        different: false, true, context("cli/input-env", "default", "", "offline"), "env-ok-stderr-empty" => failed{"env-ok-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("cli/input-env", "default", "", "offline"), "env-ok-exit" => ok evidence("env-ok-exit", "0", "0", true, "case cli/input-env variant default root env-ok-exit run offline")
        different: 1, 0, context("cli/input-env", "default", "", "offline"), "env-ok-exit" => failed{"env-ok-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "hé😀", "hé😀", context("cli/input-env", "default", "", "offline"), "env-value-unicode" => ok evidence("env-value-unicode", "hé😀", "hé😀", true, "case cli/input-env variant default root env-value-unicode run offline")
        different: "hé", "hé😀", context("cli/input-env", "default", "", "offline"), "env-value-unicode" => failed{"env-value-unicode"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
