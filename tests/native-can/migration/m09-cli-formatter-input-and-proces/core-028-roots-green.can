        str expected
        context c
        str check
    asserts
        same: "src/main.can", "src/main.can", context("cli/input-env-roots", "default", "", "offline"), "fixture-name" => ok evidence("fixture-name", "src/main.can", "src/main.can", true, "case cli/input-env-roots variant default root fixture-name run offline")
        different: "src/other.can", "src/main.can", context("cli/input-env-roots", "default", "", "offline"), "fixture-name" => failed{"fixture-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
