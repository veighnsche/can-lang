/// M09 CORE-028 "bundled input/environment: roots green, three-fixture inventory".
/// Source: tests/integration/io_env_test.go symbol
/// TestCurrentBundledInputEnvironment (L15-146).
/// Related fixtures: compiler/testdata/current/cli/input.can,
/// input-text.can and environment.can (read at L71, staged one at a time
/// as src/main.can at L75 across the L69 subtests).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): static assert inventory of the staged project as
/// the green baseline: exactly 1 root per stage (main alone in each of the
/// three fixtures) with the assert leg green (exit 0, empty diagnostics,
/// supplied-completion report) and the unread-stdin probe ignored.
/// ADAPTATION (recorded, with source lines): the Go assert leg (L76) pins
/// exit 0, empty stderr and the supplied-completion needle but no per-root
/// count, so root-count/subtest-count plus the per-function *-roots pins
/// record the static assert inventory for P23 qualification; no execution
/// is claimed here (accept_after P23/QF1 unmet).
/// Facet map (io_env_test.go legs plus fixture arms): assert-green pins
/// the assert exit (L76: exit 0 with empty diagnostics over the staged
/// fixture); report-passed pins the passing report; root-count pins the
/// per-stage total (L75: one src/main.can staged at a time, main = 1);
/// subtest-count pins the three subtests (L69: input, input-text,
/// environment); fixture-name grounds the pins in the staged path (L75:
/// src/main.can); input-source/input-text-source/environment-source pin
/// the cycled fixture files (L69/L71); input-roots pins input.can main
/// (fixture L9: sample [] => ok, 1 root; the L13/L18/L22 when-table rows
/// are not assert roots, matching the CORE-014 seal_size precedent and
/// declaration.Assertions roots); input-text-roots pins input-text.can
/// main (fixture L9: sample [] => ok, 1 root); environment-roots pins
/// environment.can main (fixture L9: sample ["VALUE"] => ok, 1 root);
/// assert-needle pins "supplied-completion" (L76); assert-stdin-ignored
/// pins the "must not be read" stdin probe the assert leg ignores (L76).
/// Env/input semantics live in core-028-env-semantics.can; the production
/// process shape lives in core-028-run-shape.can.
/// Variants: none in this file (default only); the env names, stdin
/// samples, mutations and strict-emission legs live in env-semantics.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec, CAN_TSC optional;
/// requires can-bun-archive, macos-sandbox-exec. Logical gates
/// SUITE/WORK/PROC/N1 and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 300000ms mirrors the Go 5-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QF1 unmet).
/// Case cli/input-env-roots checks: assert-green, report-passed,
/// root-count, subtest-count, fixture-name, input-source,
/// input-text-source, environment-source, input-roots, input-text-roots,
/// environment-roots, assert-needle, assert-stdin-ignored.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool assert_green
    bool report_passed
    int root_count
    int subtest_count
    str fixture_name
    str input_source
    str input_text_source
    str environment_source
    int input_roots
    int input_text_roots
    int environment_roots
    str assert_needle
    str assert_stdin_ignored
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cli/input-env-roots", "default", "", "offline"), "assert-green" => ok "case cli/input-env-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cli/input-env-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case cli/input-env-roots variant default root assert-green run offline")
        different: false, true, context("cli/input-env-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("cli/input-env-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "1", "1", true, "case cli/input-env-roots variant default root root-count run offline")
        different: 0, 1, context("cli/input-env-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
