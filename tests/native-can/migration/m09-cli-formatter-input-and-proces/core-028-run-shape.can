package m09core028run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-028 "bundled input/environment: run shape, emit/fault split".
/// Source: tests/integration/io_env_test.go symbol
/// TestCurrentBundledInputEnvironment (L15-146).
/// Related fixtures: compiler/testdata/current/cli/environment.can,
/// input.can and input-text.can (each staged as src/main.can at L75).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the staged
/// input/environment entries. Unlike rows with a silent entry, the env
/// entry emits the looked-up value on stdout by design (Go L81) and the
/// input entries echo stdin bytes on stdout by design (Go L101), so the
/// non-silent stdouts are pinned verbatim here (three stdout pins plus
/// the roundtrip-equality shape pin) and the silence pins land where
/// silence holds: empty stderr on the env and input-text ok paths, empty
/// stdout on the fault path.
/// ADAPTATIONS (recorded, with source lines): input.can additionally
/// mirrors stdin bytes on stderr (L98-100), so input has no stderr-empty
/// pin; stderr-mirror-input pins that mirror instead. The build stdout
/// carries a JSON report with a temp-scoped directory (L132-135), and the
/// Go test pins only build exit 0 (L129), so no build-stdout or
/// build-stderr check is authored. The 1MiB drain (L120-123) pins stdout
/// and stderr lengths (1048576 each) rather than the megabyte payload.
/// Per the accepted CORE-014/019/040 precedent, non-silent outputs are
/// pinned verbatim with the source line recorded (L80-81, L101).
/// The roots-green pin lives in core-028-roots-green.can; env values,
/// error identities, bounds and strict emission live in
/// core-028-env-semantics.can.
/// Variants: ok path (three env lookups, roundtrip samples, 1MiB drain),
/// fault path (missing/invalid env names, overflow, bad UTF-8, negative
/// limit), build path (exit 0 per subtest).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec, CAN_TSC optional;
/// requires can-bun-archive, macos-sandbox-exec. Logical gates
/// SUITE/WORK/PROC/N1 and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 300000ms mirrors the Go 5-minute ctx (L24).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QF1 unmet).
/// Case cli/input-env-run checks: run-exit, env-stderr-empty,
/// input-text-stderr-empty, stderr-mirror-input, stdout-value,
/// stdout-empty, stdout-hostile, input-sample-count,
/// input-text-sample-count, roundtrip-equal, fault-exit,
/// fault-stdout-empty, build-exit, large-stdout-length,
/// large-stderr-length, sandbox-profile, offline-path, offline-ok.
/// Facet map (io_env_test.go legs): run-exit pins exit 0 on the ok path
/// (L81: env lookups; L101: roundtrips; L122: 1MiB drain);
/// env-stderr-empty pins empty stderr on env ok runs (L81);
/// input-text-stderr-empty pins empty stderr on input-text ok runs (L97);
/// stderr-mirror-input pins the input stderr mirror (L98-100: diag equals
/// the stdin sample); stdout-value pins the Unicode value (L80-81: Go
/// literal h + U+00E9 + U+1F600); stdout-empty pins "" (L80-81);
/// stdout-hostile pins "--preload=/must-not-execute.ts" (L80-81);
/// input-sample-count pins 4 (L91-94: empty, BOM-unicode, 16-wide,
/// binary); input-text-sample-count pins 3 (L91); roundtrip-equal pins
/// byte-equality of stdout with stdin (L101); fault-exit pins exit 1
/// across the fault legs (L86/L105/L109/L116); fault-stdout-empty pins
/// empty stdout across the same legs; build-exit pins exit 0 per subtest
/// (L128-130; Go pins no build stream, see adaptation);
/// large-stdout-length and large-stderr-length pin 1048576 each (L122);
/// sandbox-profile pins the invocation shape (L49: the deny-network
/// profile verbatim); offline-path pins the cleared environment (L56:
/// "PATH=/nonexistent" verbatim); offline-ok pins the offline behavior
/// (L76-143: the sandboxed deny-network assert/run/build loop with
/// hostile BUN_OPTIONS stays green).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    bool env_stderr_empty
    bool input_text_stderr_empty
    bool stderr_mirror_input
    str stdout_value
    str stdout_empty
    str stdout_hostile
    int input_sample_count
    int input_text_sample_count
    bool roundtrip_equal
    int fault_exit
    bool fault_stdout_empty
    int build_exit
    int large_stdout_length
    int large_stderr_length
    str sandbox_profile
    str offline_path
    bool offline_ok
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cli/input-env-run", "default", "", "offline"), "run-exit" => ok "case cli/input-env-run variant default root run-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cli/input-env-run", "default", "", "offline"), "env-stderr-empty" => ok evidence("env-stderr-empty", "true", "true", true, "case cli/input-env-run variant default root env-stderr-empty run offline")
        different: false, true, context("cli/input-env-run", "default", "", "offline"), "env-stderr-empty" => failed{"env-stderr-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("cli/input-env-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case cli/input-env-run variant default root run-exit run offline")
        different: 1, 0, context("cli/input-env-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "hé😀", "hé😀", context("cli/input-env-run", "default", "", "offline"), "stdout-value" => ok evidence("stdout-value", "hé😀", "hé😀", true, "case cli/input-env-run variant default root stdout-value run offline")
        different: "hé", "hé😀", context("cli/input-env-run", "default", "", "offline"), "stdout-value" => failed{"stdout-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
