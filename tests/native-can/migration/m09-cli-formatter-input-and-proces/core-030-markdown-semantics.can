        true => ok [check("heading", "live html of # Hi prints the h1 element"), check("raw-html", "live html preserves the raw script element"), check("usage-nil", "no argv prints the usage line"), check("usage-bogus", "bogus op prints the usage line"), check("usage-arity", "bare html prints the usage line"), check("unsafe-reject", "text HTML bound as html::safe rejects"), check("emits-reject", "omitted html::invalid_url emits rejects"), check("mutation-unsafe-site", "unsafe mutation site pins the served chain call"), check("mutation-emits-site", "emits mutation site pins the page header")]
