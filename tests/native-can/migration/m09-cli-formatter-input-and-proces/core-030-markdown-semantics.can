package m09core030markdown
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-030 "markdown render: live outputs, usage, rejects".
/// Source: tests/integration/markdown_test.go symbol
/// TestCurrentMarkdownRender (L34-126).
/// Related fixture: compiler/testdata/current/markdown/main.can (read at
/// L47, staged as src/main.can at L55); the live-output pins ground the
/// raw dispatch (L63-68), the usage arms (L59-62, L69-76) and the assert
/// vectors (raw L25-26), while the mutation sites ground the served
/// chain call (L41) and the page emits header (L28-29).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): live native render outputs (heading, raw HTML
/// preserved verbatim), the exact usage line for the nil/bogus/arity
/// legs, and the two negative source mutations (text HTML bound as
/// html::safe, omitted html::invalid_url emits) with their mutation
/// sites and rejection diagnostics.
/// The roots-green pin lives in core-030-roots-green.can; the production
/// process shape lives in core-030-run-shape.can.
/// Variants: heading, raw script input, nil/bogus/incomplete usage (Go
/// L99-103); two negative source mutations (Go L104-111, rejected at
/// build per L121-124).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 360000ms mirrors the Go 6-minute ctx (L41).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case markdown/render checks: heading, raw-html, usage-nil,
/// usage-bogus, usage-arity, unsafe-reject, emits-reject,
/// mutation-unsafe-site, mutation-emits-site.
/// Facet map (markdown_test.go legs): heading pins the heading output
/// (L99: "<h1>Hi</h1>\n"; fixture L25 raw sample); raw-html pins raw
/// preservation (L100: "<script>alert(1)</script>\n" verbatim; fixture
/// L26 hostile); usage-nil pins the nil leg (L101: "usage: md html
/// <source>" with no trailing newline; fixture L73-76); usage-bogus
/// pins the unknown-op leg (L102: same usage line; fixture L69-72);
/// usage-arity pins the incomplete leg (L103: same usage line; fixture
/// L59-62); unsafe-reject pins the text-HTML diagnostic (L109/L122:
/// "chain binding type mismatch"); emits-reject pins the missing-emits
/// diagnostic (L110/L122: "undeclared escaping domain error
/// html::invalid_url"); mutation-unsafe-site pins the first mutation
/// site (fixture L41; Go L109 find needle
/// call markdown::render_safe("# Hello") as html::safe sheet);
/// mutation-emits-site pins the second mutation site (fixture L28-29;
/// Go L110 find needle "fn html::safe page\n    emits
/// {markdown::over_limit, html::invalid_url}"). The replacement-missed
/// guards (L113-115) and the nonzero-status plus needle legs (L121-124)
/// need a built bundle and stay blocked, never waived.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str heading
    str raw_html
    str usage_nil
    str usage_bogus
    str usage_arity
    str unsafe_reject
    str emits_reject
    str mutation_unsafe_site
    str mutation_emits_site
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("markdown/render", "default", "", "offline"), "heading" => ok "case markdown/render variant default root heading run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("markdown/render", "default", "", "offline"), "heading" => ok evidence("heading", "true", "true", true, "case markdown/render variant default root heading run offline")
        different: false, true, context("markdown/render", "default", "", "offline"), "heading" => failed{"heading"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 9, 9, context("markdown/render", "default", "", "offline"), "heading" => ok evidence("heading", "9", "9", true, "case markdown/render variant default root heading run offline")
        different: 8, 9, context("markdown/render", "default", "", "offline"), "heading" => failed{"heading"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "<h1>Hi</h1>\n", "<h1>Hi</h1>\n", context("markdown/render", "default", "", "offline"), "heading" => ok evidence("heading", "<h1>Hi</h1>\n", "<h1>Hi</h1>\n", true, "case markdown/render variant default root heading run offline")
        different: "<h1>Hi</h1>", "<h1>Hi</h1>\n", context("markdown/render", "default", "", "offline"), "heading" => failed{"heading"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
