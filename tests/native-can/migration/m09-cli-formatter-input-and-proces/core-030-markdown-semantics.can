    emits {}
    given
        str case
    asserts
        known: "markdown/render" => ok [expected_check("heading", "<h1>Hi</h1>\n"), expected_check("raw-html", "<script>alert(1)</script>\n"), expected_check("usage-nil", "usage: md html <source>"), expected_check("usage-bogus", "usage: md html <source>"), expected_check("usage-arity", "usage: md html <source>"), expected_check("unsafe-reject", "chain binding type mismatch"), expected_check("emits-reject", "undeclared escaping domain error html::invalid_url"), expected_check("mutation-unsafe-site", "call markdown::render_safe(\"# Hello\") as html::safe sheet"), expected_check("mutation-emits-site", "fn html::safe page\n    emits {markdown::over_limit, html::invalid_url}")]
        unknown: "nope" => ok []
