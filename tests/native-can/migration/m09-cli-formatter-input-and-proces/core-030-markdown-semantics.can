        true => ok [expected_check("heading", "<h1>Hi</h1>\n"), expected_check("raw-html", "<script>alert(1)</script>\n"), expected_check("usage-nil", "usage: md html <source>"), expected_check("usage-bogus", "usage: md html <source>"), expected_check("usage-arity", "usage: md html <source>"), expected_check("unsafe-reject", "chain binding type mismatch"), expected_check("emits-reject", "undeclared escaping domain error html::invalid_url"), expected_check("mutation-unsafe-site", "call markdown::render_safe(\"# Hello\") as html::safe sheet"), expected_check("mutation-emits-site", "fn html::safe page\n    emits {markdown::over_limit, html::invalid_url}")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("markdown/render", "default", "", "offline") => ok
        seed_heading_drift: context("markdown/render", "seed-heading-drift", "", "offline") => failed{"heading"}
        seed_rawhtml_escape: context("markdown/render", "seed-rawhtml-escape", "", "offline") => failed{"raw-html"}
        seed_usage_nil_drift: context("markdown/render", "seed-usage-nil-drift", "", "offline") => failed{"usage-nil"}
        seed_usage_bogus_drift: context("markdown/render", "seed-usage-bogus-drift", "", "offline") => failed{"usage-bogus"}
        seed_usage_arity_drift: context("markdown/render", "seed-usage-arity-drift", "", "offline") => failed{"usage-arity"}
        seed_unsafe_admitted: context("markdown/render", "seed-unsafe-admitted", "", "offline") => failed{"unsafe-reject"}
        seed_emits_admitted: context("markdown/render", "seed-emits-admitted", "", "offline") => failed{"emits-reject"}
        seed_unsafe_site_drift: context("markdown/render", "seed-unsafe-site-drift", "", "offline") => failed{"mutation-unsafe-site"}
        seed_emits_site_drift: context("markdown/render", "seed-emits-site-drift", "", "offline") => failed{"mutation-emits-site"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.heading, "<h1>Hi</h1>\n", c, "heading")
            failed
            ok evidence heading_evidence => match call require_text(got.raw_html, "<script>alert(1)</script>\n", c, "raw-html")
                failed
                ok evidence rawhtml_evidence => match call require_text(got.usage_nil, "usage: md html <source>", c, "usage-nil")
                    failed
                    ok evidence nil_evidence => match call require_text(got.usage_bogus, "usage: md html <source>", c, "usage-bogus")
                        failed
                        ok evidence bogus_evidence => match call require_text(got.usage_arity, "usage: md html <source>", c, "usage-arity")
                            failed
                            ok evidence arity_evidence => match call require_text(got.unsafe_reject, "chain binding type mismatch", c, "unsafe-reject")
                                failed
                                ok evidence unsafe_evidence => match call require_text(got.emits_reject, "undeclared escaping domain error html::invalid_url", c, "emits-reject")
                                    failed
                                    ok evidence emits_evidence => match call require_text(got.mutation_unsafe_site, "call markdown::render_safe(\"# Hello\") as html::safe sheet", c, "mutation-unsafe-site")
                                        failed
                                        ok evidence unsafe_site_evidence => match call require_text(got.mutation_emits_site, "fn html::safe page\n    emits {markdown::over_limit, html::invalid_url}", c, "mutation-emits-site")
                                            failed
                                            ok evidence emits_site_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m09_030: "m09-030" => ok test_case("markdown/render", ["markdown", "m09"], ["can-bun-archive", "macos-sandbox-exec"], 360000, [check_ref("heading"), check_ref("raw-html"), check_ref("usage-nil"), check_ref("usage-bogus"), check_ref("usage-arity"), check_ref("unsafe-reject"), check_ref("emits-reject"), check_ref("mutation-unsafe-site"), check_ref("mutation-emits-site")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m09-030"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("markdown/render", ["markdown", "m09"], ["can-bun-archive", "macos-sandbox-exec"], 360000, [check_ref("heading"), check_ref("raw-html"), check_ref("usage-nil"), check_ref("usage-bogus"), check_ref("usage-arity"), check_ref("unsafe-reject"), check_ref("emits-reject"), check_ref("mutation-unsafe-site"), check_ref("mutation-emits-site")], callable case_body)
