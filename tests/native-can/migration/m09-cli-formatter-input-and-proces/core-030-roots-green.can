    bool report_passed
    int root_count
    str fixture_name
    int emit_roots
    int raw_roots
    int page_roots
    int served_roots
    int main_roots
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("markdown/render-roots", "default", "", "offline"), "assert-green" => ok "case markdown/render-roots variant default root assert-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("markdown/render-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case markdown/render-roots variant default root assert-green run offline")
        different: false, true, context("markdown/render-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
