        seed_assert_red: context("markdown/render-roots", "seed-assert-red", "", "offline") => failed{"assert-green"}
        seed_report_red: context("markdown/render-roots", "seed-report-red", "", "offline") => failed{"report-passed"}
        seed_root_short: context("markdown/render-roots", "seed-root-short", "", "offline") => failed{"root-count"}
