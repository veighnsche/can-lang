fn check[] checks
    emits {}
    given
        str scope
    asserts
        m09_030: "m09-030" => ok [check("run-exit", "live run exits 0 on the ok path"), check("heading-stdout", "live heading run prints the h1 element"), check("rawhtml-stdout", "live raw run preserves the script element"), check("usage-stdout", "live usage legs print the usage line"), check("run-stderr-empty", "live run keeps stderr empty"), check("snapshot-empty", "entries consume the empty fd-3 snapshot"), check("sandbox-profile", "assert/build invocations pin the deny-network sandbox profile"), check("offline-ok", "offline sandboxed assert/build succeeds"), check("stage-errors", "staged project pins the error registry filename"), check("offline-env", "sandboxed invocations clear PATH")]
        other: "nope" => ok []
    match scope is "m09-030"
        false => ok []
        true => ok [check("run-exit", "live run exits 0 on the ok path"), check("heading-stdout", "live heading run prints the h1 element"), check("rawhtml-stdout", "live raw run preserves the script element"), check("usage-stdout", "live usage legs print the usage line"), check("run-stderr-empty", "live run keeps stderr empty"), check("snapshot-empty", "entries consume the empty fd-3 snapshot"), check("sandbox-profile", "assert/build invocations pin the deny-network sandbox profile"), check("offline-ok", "offline sandboxed assert/build succeeds"), check("stage-errors", "staged project pins the error registry filename"), check("offline-env", "sandboxed invocations clear PATH")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "markdown/render-run" => ok [expected_check("run-exit", "0"), expected_check("heading-stdout", "<h1>Hi</h1>\n"), expected_check("rawhtml-stdout", "<script>alert(1)</script>\n"), expected_check("usage-stdout", "usage: md html <source>"), expected_check("run-stderr-empty", "true"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("stage-errors", "can.errors.json"), expected_check("offline-env", "PATH=/nonexistent")]
        unknown: "nope" => ok []
    match case is "markdown/render-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("heading-stdout", "<h1>Hi</h1>\n"), expected_check("rawhtml-stdout", "<script>alert(1)</script>\n"), expected_check("usage-stdout", "usage: md html <source>"), expected_check("run-stderr-empty", "true"), expected_check("snapshot-empty", "{}"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-ok", "true"), expected_check("stage-errors", "can.errors.json"), expected_check("offline-env", "PATH=/nonexistent")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("markdown/render-run", "default", "", "offline") => ok
        seed_run_red: context("markdown/render-run", "seed-run-red", "", "offline") => failed{"run-exit"}
        seed_heading_drift: context("markdown/render-run", "seed-heading-drift", "", "offline") => failed{"heading-stdout"}
        seed_rawhtml_escape: context("markdown/render-run", "seed-rawhtml-escape", "", "offline") => failed{"rawhtml-stdout"}
        seed_usage_drift: context("markdown/render-run", "seed-usage-drift", "", "offline") => failed{"usage-stdout"}
        seed_stderr_noisy: context("markdown/render-run", "seed-stderr-noisy", "", "offline") => failed{"run-stderr-empty"}
        seed_snapshot_drift: context("markdown/render-run", "seed-snapshot-drift", "", "offline") => failed{"snapshot-empty"}
        seed_profile_drift: context("markdown/render-run", "seed-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_fail: context("markdown/render-run", "seed-offline-fail", "", "offline") => failed{"offline-ok"}
        seed_errors_drift: context("markdown/render-run", "seed-errors-drift", "", "offline") => failed{"stage-errors"}
        seed_env_drift: context("markdown/render-run", "seed-env-drift", "", "offline") => failed{"offline-env"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence exit_evidence => match call require_text(got.heading_stdout, "<h1>Hi</h1>\n", c, "heading-stdout")
                failed
                ok evidence heading_evidence => match call require_text(got.rawhtml_stdout, "<script>alert(1)</script>\n", c, "rawhtml-stdout")
                    failed
                    ok evidence rawhtml_evidence => match call require_text(got.usage_stdout, "usage: md html <source>", c, "usage-stdout")
                        failed
                        ok evidence usage_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                            failed
                            ok evidence stderr_evidence => match call require_text(got.snapshot_empty, "{}", c, "snapshot-empty")
                                failed
                                ok evidence snapshot_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                                    failed
                                    ok evidence profile_evidence => match call require_bool(got.offline_ok, true, c, "offline-ok")
                                        failed
                                        ok evidence offline_evidence => match call require_text(got.stage_errors, "can.errors.json", c, "stage-errors")
                                            failed
                                            ok evidence errors_evidence => match call require_text(got.offline_env, "PATH=/nonexistent", c, "offline-env")
                                                failed
                                                ok evidence env_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m09_030: "m09-030" => ok test_case("markdown/render-run", ["markdown", "m09"], ["can-bun-archive", "macos-sandbox-exec"], 360000, [check_ref("run-exit"), check_ref("heading-stdout"), check_ref("rawhtml-stdout"), check_ref("usage-stdout"), check_ref("run-stderr-empty"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("stage-errors"), check_ref("offline-env")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m09-030"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("markdown/render-run", ["markdown", "m09"], ["can-bun-archive", "macos-sandbox-exec"], 360000, [check_ref("run-exit"), check_ref("heading-stdout"), check_ref("rawhtml-stdout"), check_ref("usage-stdout"), check_ref("run-stderr-empty"), check_ref("snapshot-empty"), check_ref("sandbox-profile"), check_ref("offline-ok"), check_ref("stage-errors"), check_ref("offline-env")], callable case_body)
