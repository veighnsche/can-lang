        seed_stderr_noisy: "seed-stderr-noisy" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", false, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        seed_snapshot_drift: "seed-snapshot-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "[]", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        seed_profile_drift: "seed-profile-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)", true, "can.errors.json", "PATH=/nonexistent")
        seed_offline_fail: "seed-offline-fail" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", false, "can.errors.json", "PATH=/nonexistent")
        seed_errors_drift: "seed-errors-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.project.json", "PATH=/nonexistent")
        seed_env_drift: "seed-env-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/usr/bin")
    match variant_id
        "seed-run-red" => ok observation(1, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        "seed-heading-drift" => ok observation(0, "<h1>Hi</h1>", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        "seed-rawhtml-escape" => ok observation(0, "<h1>Hi</h1>\n", "&lt;script&gt;alert(1)&lt;/script&gt;\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        "seed-usage-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        "seed-stderr-noisy" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", false, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        "seed-snapshot-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "[]", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/nonexistent")
        "seed-profile-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)", true, "can.errors.json", "PATH=/nonexistent")
        "seed-offline-fail" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", false, "can.errors.json", "PATH=/nonexistent")
        "seed-errors-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.project.json", "PATH=/nonexistent")
        "seed-env-drift" => ok observation(0, "<h1>Hi</h1>\n", "<script>alert(1)</script>\n", "usage: md html <source>", true, "{}", "(version 1)(allow default)(deny network*)", true, "can.errors.json", "PATH=/usr/bin")
