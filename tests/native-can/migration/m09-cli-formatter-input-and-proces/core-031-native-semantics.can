        sample: context("native/declarations", "default", "", "offline"), "build-accept" => ok "case native/declarations variant default root build-accept run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("native/declarations", "default", "", "offline"), "build-accept" => ok evidence("build-accept", "true", "true", true, "case native/declarations variant default root build-accept run offline")
        different: false, true, context("native/declarations", "default", "", "offline"), "build-accept" => failed{"build-accept"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
