    asserts
        same: true, true, context("native/declarations-roots", "default", "", "offline"), "assert-green" => ok evidence("assert-green", "true", "true", true, "case native/declarations-roots variant default root assert-green run offline")
        different: false, true, context("native/declarations-roots", "default", "", "offline"), "assert-green" => failed{"assert-green"}
    match observed is expected
