        same: 0, 0, context("native/declarations-run", "default", "", "offline"), "build-exit" => ok evidence("build-exit", "0", "0", true, "case native/declarations-run variant default root build-exit run offline")
        different: 1, 0, context("native/declarations-run", "default", "", "offline"), "build-exit" => failed{"build-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
