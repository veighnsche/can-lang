        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("native/declarations-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case native/declarations-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)", "(version 1)(allow default)(deny network*)", context("native/declarations-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
