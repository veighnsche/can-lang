package m09core031run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-031 "bundled native declarations: run shape, build/reject split".
/// Source: tests/integration/native_test.go symbol
/// TestCurrentBundledNativeDeclarations (L15-87).
/// Related fixture: compiler/testdata/current/native/declarations.can
/// (staged as src/main.can at L67, rebuilt mutated at L81-82).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production process shape of the native declaration
/// checks. The green build exits 0 with empty diagnostics (L70); each of
/// the six mutated rebuilds exits nonzero with nonempty diagnostics (L83).
/// ADAPTATIONS (recorded, with source lines): the build stdout is captured
/// (L51/L69) but never asserted (L70-72 check status and diagnostics only),
/// and the reject-leg stdout is likewise unchecked (L82), so no
/// build-stdout or reject-stdout check is authored here (silent where Go is
/// silent, per the accepted CORE-014/019/040 precedent: pin verbatim only
/// what Go pins). HOME=cmd.Dir (L50), cmd.Dir=t.TempDir() (L49) and the
/// bundle prefix joined at L46 are temp-scoped, so no HOME/workdir/bundle
/// check is authored; canlc-bin pins the stable bin/canlc suffix only.
/// Command "build" (L69/L82), the sandbox profile (L46), the sandbox binary
/// (L48), the cleared PATH (L50) and the staged project files (L42-43) are
/// pinned verbatim.
/// The roots-green pin lives in core-031-roots-green.can; declaration
/// build-accept and the six mutations live in core-031-native-semantics.can.
/// Variants: green path (pristine fixture build) plus the six reject legs
/// (each mutated source rebuilds and fails).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 120000ms mirrors the Go 2-minute ctx (L22).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case native/declarations-run checks: build-exit, build-diag-empty,
/// reject-count, reject-exit-nonzero, reject-diag-nonempty, sandbox-profile,
/// sandbox-binary, offline-path, project-manifest, errors-registry,
/// command-build, canlc-bin.
/// Facet map (native_test.go legs): build-exit pins exit 0 on the pristine
/// build (L70); build-diag-empty pins empty diagnostics there (L70);
/// reject-count pins the six mutated rebuilds (L73); reject-exit-nonzero
/// pins nonzero exit on every reject leg (L83: status 0 fatals);
/// reject-diag-nonempty pins nonempty diagnostics there (L83: empty
/// diagnostics fatals); sandbox-profile pins the invocation profile (L46:
/// the deny-network profile verbatim); sandbox-binary pins
/// /usr/bin/sandbox-exec (L48); offline-path pins the cleared environment
/// (L50: "PATH=/nonexistent" verbatim); project-manifest pins the staged
/// manifest (L42 verbatim); errors-registry pins the staged registry (L43
/// verbatim); command-build pins the build command (L69/L82: run("build"));
/// canlc-bin pins the tool suffix (L46: bin/canlc under the temp bundle).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int build_exit
    bool build_diag_empty
    int reject_count
    bool reject_exit_nonzero
    bool reject_diag_nonempty
    str sandbox_profile
    str sandbox_binary
    str offline_path
    str project_manifest
    str errors_registry
    str command_build
    str canlc_bin
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("native/declarations-run", "default", "", "offline"), "build-exit" => ok "case native/declarations-run variant default root build-exit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("native/declarations-run", "default", "", "offline"), "build-diag-empty" => ok evidence("build-diag-empty", "true", "true", true, "case native/declarations-run variant default root build-diag-empty run offline")
        different: false, true, context("native/declarations-run", "default", "", "offline"), "build-diag-empty" => failed{"build-diag-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
