package m09core034process
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M09 CORE-034 "bundled process: stdio, exit, limits, kill, rejects".
/// Source: tests/integration/process_test.go symbol
/// TestCurrentBundledProcess (L48-178).
/// Related sources: runtime/test/process.test.ts (the 13 bun-trace roots
/// behind DELEGATE-017; every behavior pin below cites its root) and the
/// inline processLiveProgram fixture (L16-46), each staged as src/main.can
/// at L87.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): process stdout/stderr/stdin, exit/signal,
/// literal argv, cwd/env, limits, descendant kill and abandoned-run
/// cleanup (one load-bearing pin per runtime case); the live /bin/echo
/// entry with its options tuple; the three rejection programs with
/// their needles; and the Bun.spawn/which native delegation lowerings.
/// The roots-green pin lives in core-034-roots-green.can; the production
/// run shape lives in core-034-run-shape.can.
/// Variants: 13 runtime cases (echo, nonzero, stdin, argv, missing,
/// invalid, limits, deadline, grandchild, env-cwd, unsupplied, classify,
/// abandoned), live echo, three rejection programs.
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/WORK/PROC/N1
/// and C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 180000ms mirrors the Go 3-minute ctx (L54).
/// Delegated oracles: DELEGATE-017 (runtime/test/process.test.ts, 13
/// declarations; recorded read-only, not executed; old pass-count
/// spellings need current-contract relevance review per the delegate
/// delete_when).
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case cli/process checks: pass-needle, fail-needle, suite-path,
/// case-count, echo-stdout, echo-code, echo-stderr, nonzero-code,
/// signal-name, stdin-upper, concurrent-bytes, argv-literal,
/// missing-path, denied-operation, invalid-reason, limit-short,
/// limit-exact, deadline-ms, grandchild-deadline, env-mark, cwd-tool,
/// unsupplied-fails, classify-kind, abandoned-code, live-executable,
/// live-arg, live-cwd, live-inherit, live-out-limit, live-err-limit,
/// live-deadline, live-grace, wrong-type-name, type-needle,
/// unhandled-name, missing-arm, arm-detail, unknown-name,
/// unknown-needle, reject-span, lower-run, lower-create, lower-spawn,
/// lower-which, lower-kill, lower-detached.
/// Facet map (process_test.go legs + process.test.ts roots):
/// pass-needle pins 13 pass (Go L66); fail-needle pins 0 fail (Go L66);
/// suite-path pins runtime/test/process.test.ts (Go L61); case-count pins
/// 13 (counted test roots, ts L118-419); echo-stdout pins hello newline
/// (ts L123); echo-code pins 0 (ts L125); echo-stderr pins empty (ts
/// L124); nonzero-code pins 7 (ts L137); signal-name pins SIGTERM (ts
/// L147, code -1 at L146); stdin-upper pins HELLO (ts L163);
/// concurrent-bytes pins 200000 (ts L173); argv-literal pins a;b (ts
/// L180, unexpanded with no shell); missing-path pins
/// /nonexistent-bin-xyz (ts L191); denied-operation pins spawn (ts L213);
/// invalid-reason pins nul_byte (ts L235, representative of the ten
/// pre-spawn config rejections at ts L229-295); limit-short pins 5 (ts
/// L305); limit-exact pins 6 (ts L303); deadline-ms pins 300 (ts L311);
/// grandchild-deadline pins 500 (ts L332); env-mark pins CAN_MARK=yes
/// (ts L350); cwd-tool pins /bin/pwd (ts L365); unsupplied-fails pins
/// the blocked spawn (ts L383); classify-kind pins not_found (ts L403);
/// abandoned-code pins -1 (ts L438); live-executable pins /bin/echo,
/// live-arg pins live-proc, live-cwd pins empty, live-inherit pins true
/// and the live limits pin 100/100/5000/100 (Go L27 options tuple);
/// wrong-type-name, unhandled-name and unknown-name pin the three
/// fixtures (Go L137/L139/L141); type-needle, missing-arm, arm-detail
/// and unknown-needle pin their diagnostics (Go L138/L140/L142);
/// reject-span pins main.can (Go L138/L140/L142); the six lower-* pins
/// carry the native lowerings verbatim (Go L166/L173).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str pass_needle
    str fail_needle
    str suite_path
    int case_count
    str echo_stdout
    int echo_code
    str echo_stderr
    int nonzero_code
    str signal_name
    str stdin_upper
    int concurrent_bytes
    str argv_literal
    str missing_path
    str denied_operation
    str invalid_reason
    int limit_short
    int limit_exact
    int deadline_ms
    int grandchild_deadline
    str env_mark
    str cwd_tool
    bool unsupplied_fails
    str classify_kind
    int abandoned_code
    str live_executable
    str live_arg
    str live_cwd
    bool live_inherit
    int live_out_limit
    int live_err_limit
    int live_deadline
    int live_grace
    str wrong_type_name
    str type_needle
    str unhandled_name
    str missing_arm
    str arm_detail
    str unknown_name
    str unknown_needle
    str reject_span
    str lower_run
    str lower_create
    str lower_spawn
    str lower_which
    str lower_kill
    str lower_detached
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("cli/process", "default", "", "offline"), "pass-needle" => ok "case cli/process variant default root pass-needle run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("cli/process", "default", "", "offline"), "unsupplied-fails" => ok evidence("unsupplied-fails", "true", "true", true, "case cli/process variant default root unsupplied-fails run offline")
        different: false, true, context("cli/process", "default", "", "offline"), "unsupplied-fails" => failed{"unsupplied-fails"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 13, 13, context("cli/process", "default", "", "offline"), "case-count" => ok evidence("case-count", "13", "13", true, "case cli/process variant default root case-count run offline")
        different: 12, 13, context("cli/process", "default", "", "offline"), "case-count" => failed{"case-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "13 pass", "13 pass", context("cli/process", "default", "", "offline"), "pass-needle" => ok evidence("pass-needle", "13 pass", "13 pass", true, "case cli/process variant default root pass-needle run offline")
        different: "12 pass", "13 pass", context("cli/process", "default", "", "offline"), "pass-needle" => failed{"pass-needle"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
