        _ => ok observation(0, "live-proc\n", true, true, "(version 1)(allow default)(deny network*)", "PATH=/nonexistent", "PATH=/usr/bin:/bin", "--no-env-file", "--no-macros", "--no-install", "tools/runtime/bunfig.toml", true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m09_034: "m09-034" => ok [check("run-exit", "live run exits 0"), check("run-stdout", "live run prints live-proc newline"), check("run-stderr-empty", "live run keeps stderr empty"), check("reject-exit-nonzero", "rejection asserts exit nonzero"), check("sandbox-profile", "invocation pins the deny-network profile"), check("offline-path", "invocation clears PATH to /nonexistent"), check("qualified-path", "staged suite keeps system PATH"), check("bun-no-env-file", "staged suite passes --no-env-file"), check("bun-no-macros", "staged suite passes --no-macros"), check("bun-no-install", "staged suite passes --no-install"), check("bun-config", "staged suite pins the runtime bunfig"), check("lowered-all", "build output carries every native lowering")]
        other: "nope" => ok []
    match scope is "m09-034"
        false => ok []
        true => ok [check("run-exit", "live run exits 0"), check("run-stdout", "live run prints live-proc newline"), check("run-stderr-empty", "live run keeps stderr empty"), check("reject-exit-nonzero", "rejection asserts exit nonzero"), check("sandbox-profile", "invocation pins the deny-network profile"), check("offline-path", "invocation clears PATH to /nonexistent"), check("qualified-path", "staged suite keeps system PATH"), check("bun-no-env-file", "staged suite passes --no-env-file"), check("bun-no-macros", "staged suite passes --no-macros"), check("bun-no-install", "staged suite passes --no-install"), check("bun-config", "staged suite pins the runtime bunfig"), check("lowered-all", "build output carries every native lowering")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "cli/process-run" => ok [expected_check("run-exit", "0"), expected_check("run-stdout", "live-proc\n"), expected_check("run-stderr-empty", "true"), expected_check("reject-exit-nonzero", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-path", "PATH=/nonexistent"), expected_check("qualified-path", "PATH=/usr/bin:/bin"), expected_check("bun-no-env-file", "--no-env-file"), expected_check("bun-no-macros", "--no-macros"), expected_check("bun-no-install", "--no-install"), expected_check("bun-config", "tools/runtime/bunfig.toml"), expected_check("lowered-all", "true")]
        unknown: "nope" => ok []
    match case is "cli/process-run"
        false => ok []
        true => ok [expected_check("run-exit", "0"), expected_check("run-stdout", "live-proc\n"), expected_check("run-stderr-empty", "true"), expected_check("reject-exit-nonzero", "true"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("offline-path", "PATH=/nonexistent"), expected_check("qualified-path", "PATH=/usr/bin:/bin"), expected_check("bun-no-env-file", "--no-env-file"), expected_check("bun-no-macros", "--no-macros"), expected_check("bun-no-install", "--no-install"), expected_check("bun-config", "tools/runtime/bunfig.toml"), expected_check("lowered-all", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("cli/process-run", "default", "", "offline") => ok
        seed_run_exit: context("cli/process-run", "seed-run-exit-drift", "", "offline") => failed{"run-exit"}
        seed_run_stdout: context("cli/process-run", "seed-run-stdout-drift", "", "offline") => failed{"run-stdout"}
        seed_run_stderr_empty: context("cli/process-run", "seed-run-stderr-empty-drift", "", "offline") => failed{"run-stderr-empty"}
        seed_reject_exit_nonzero: context("cli/process-run", "seed-reject-exit-nonzero-drift", "", "offline") => failed{"reject-exit-nonzero"}
        seed_sandbox_profile: context("cli/process-run", "seed-sandbox-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_offline_path: context("cli/process-run", "seed-offline-path-drift", "", "offline") => failed{"offline-path"}
        seed_qualified_path: context("cli/process-run", "seed-qualified-path-drift", "", "offline") => failed{"qualified-path"}
        seed_bun_no_env_file: context("cli/process-run", "seed-bun-no-env-file-drift", "", "offline") => failed{"bun-no-env-file"}
        seed_bun_no_macros: context("cli/process-run", "seed-bun-no-macros-drift", "", "offline") => failed{"bun-no-macros"}
        seed_bun_no_install: context("cli/process-run", "seed-bun-no-install-drift", "", "offline") => failed{"bun-no-install"}
        seed_bun_config: context("cli/process-run", "seed-bun-config-drift", "", "offline") => failed{"bun-config"}
        seed_lowered_all: context("cli/process-run", "seed-lowered-all-drift", "", "offline") => failed{"lowered-all"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.run_exit, 0, c, "run-exit")
            failed
            ok evidence run_exit_evidence => match call require_text(got.run_stdout, "live-proc\n", c, "run-stdout")
                failed
                ok evidence run_stdout_evidence => match call require_bool(got.run_stderr_empty, true, c, "run-stderr-empty")
                    failed
                    ok evidence run_stderr_empty_evidence => match call require_bool(got.reject_exit_nonzero, true, c, "reject-exit-nonzero")
                        failed
                        ok evidence reject_exit_nonzero_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                            failed
                            ok evidence sandbox_profile_evidence => match call require_text(got.offline_path, "PATH=/nonexistent", c, "offline-path")
                                failed
                                ok evidence offline_path_evidence => match call require_text(got.qualified_path, "PATH=/usr/bin:/bin", c, "qualified-path")
                                    failed
                                    ok evidence qualified_path_evidence => match call require_text(got.bun_no_env_file, "--no-env-file", c, "bun-no-env-file")
                                        failed
                                        ok evidence bun_no_env_file_evidence => match call require_text(got.bun_no_macros, "--no-macros", c, "bun-no-macros")
                                            failed
                                            ok evidence bun_no_macros_evidence => match call require_text(got.bun_no_install, "--no-install", c, "bun-no-install")
                                                failed
                                                ok evidence bun_no_install_evidence => match call require_text(got.bun_config, "tools/runtime/bunfig.toml", c, "bun-config")
                                                    failed
                                                    ok evidence bun_config_evidence => match call require_bool(got.lowered_all, true, c, "lowered-all")
                                                        failed
                                                        ok evidence lowered_all_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m09_034: "m09-034" => ok test_case("cli/process-run", ["cli", "m09"], ["can-bun-archive", "macos-sandbox-exec"], 180000, [check_ref("run-exit"), check_ref("run-stdout"), check_ref("run-stderr-empty"), check_ref("reject-exit-nonzero"), check_ref("sandbox-profile"), check_ref("offline-path"), check_ref("qualified-path"), check_ref("bun-no-env-file"), check_ref("bun-no-macros"), check_ref("bun-no-install"), check_ref("bun-config"), check_ref("lowered-all")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m09-034"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("cli/process-run", ["cli", "m09"], ["can-bun-archive", "macos-sandbox-exec"], 180000, [check_ref("run-exit"), check_ref("run-stdout"), check_ref("run-stderr-empty"), check_ref("reject-exit-nonzero"), check_ref("sandbox-profile"), check_ref("offline-path"), check_ref("qualified-path"), check_ref("bun-no-env-file"), check_ref("bun-no-macros"), check_ref("bun-no-install"), check_ref("bun-config"), check_ref("lowered-all")], callable case_body)
