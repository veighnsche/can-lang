    asserts
        sample: context("dist/roots", "default", "", "offline"), "fixture-offline" => ok "case dist/roots variant default root fixture-offline run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/roots", "default", "", "offline"), "delegate-all-bound" => ok evidence("delegate-all-bound", "true", "true", true, "case dist/roots variant default root delegate-all-bound run offline")
        different: false, true, context("dist/roots", "default", "", "offline"), "delegate-all-bound" => failed{"delegate-all-bound"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
