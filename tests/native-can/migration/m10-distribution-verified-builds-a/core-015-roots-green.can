package m10core015roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-015 "development sidecar: roots green, staged inventory".
/// Source: tests/integration/distribution_test.go symbol
/// TestDevelopmentSidecar (L19-357); offline parser fixture
/// compiler/testdata/current/parser/offline.can; offline project fixture
/// compiler/testdata/current/project.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): static green-baseline inventory of the staged
/// fixtures the offline legs traverse: the offline parser fixture path
/// with its package/provides/uses; the offline project fixture path with
/// the 4-package resolution kind and the declaration-types kind; and the
/// delegated declaration counts (7/5/9/6/4) with the all-bound pin.
/// ADAPTATION (recorded, with source lines): the Go legs pin staged pass
/// needles (2/4/11/5 pass at L236/L246/L256/L266) without restating
/// declaration counts, so the delegate-* pins record the statically
/// counted test roots for P23 qualification (completion L45-237: 7;
/// data L4-112: 5; domain L69-380: 9; failure L19-171: 6; primitive
/// L13-65: 4); the pass needles themselves live in run-shape, and the
/// count/needle deltas stay flagged for current-contract relevance
/// review per each delegate delete_when, never waived. No execution is
/// claimed here (accept_after P23/QF2 unmet).
/// Sidecar build/launcher/mutation semantics live in
/// core-015-sidecar-semantics.can; parser/project/declaration run pins,
/// native invocation and per-declaration contracts live in
/// core-015-run-shape.can.
/// Variants: none in this file (default only); mutations live in
/// sidecar-semantics and run variants live in run-shape.
/// Environment: CAN_BUN_ARCHIVE + macOS arm64 + sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/BUILD/
/// ARCHIVE/ENV/DIAG and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L33).
/// Delegated oracles: DELEGATE-001 (runtime/completion.test.ts, 7),
/// DELEGATE-002 (runtime/data.test.ts, 5), DELEGATE-003
/// (runtime/domain.test.ts, 9), DELEGATE-004 (runtime/failure.test.ts, 6),
/// DELEGATE-005 (runtime/primitive.test.ts, 4); recorded read-only with
/// sha256 in evidence, not executed; old pass-count spellings need
/// current-contract relevance review per each delegate delete_when.
/// Execution credit: NOT claimed (accept_after P23/QF2 unmet).
/// Case dist/roots checks: fixture-offline, offline-package, 
/// offline-provides, offline-uses, fixture-project, project-packages, 
/// resolution-kind, types-kind, delegate-completion, delegate-data, 
/// delegate-domain, delegate-failure, delegate-primitive, 
/// delegate-all-bound.
/// Facet map (distribution_test.go legs plus fixtures): fixture-offline
/// pins the parser fixture path (L103); offline-package,
/// offline-provides and offline-uses pin offline/main/http (offline.can
/// L1/L2/L3); fixture-project pins the project fixture path (L124);
/// project-packages pins 4 and resolution-kind pins can.package-resolution
/// (L173); types-kind pins can.declaration-types (L216);
/// delegate-completion pins 7 (completion.test.ts L45-237);
/// delegate-data pins 5 (data.test.ts L4-112); delegate-domain pins 9
/// (domain.test.ts L69-380); delegate-failure pins 6 (failure.test.ts
/// L19-171); delegate-primitive pins 4 (primitive.test.ts L13-65);
/// delegate-all-bound pins the five-way CORE-015 binding (coverage-map
/// row CORE-015 delegated_oracles).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str fixture_offline
    str offline_package
    str offline_provides
    str offline_uses
    str fixture_project
    int project_packages
    str resolution_kind
    str types_kind
    int delegate_completion
    int delegate_data
    int delegate_domain
    int delegate_failure
    int delegate_primitive
    bool delegate_all_bound
error failed{str check}
record test_case
