fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m10_015: "m10-015" => ok test_case("dist/roots", ["dist", "m10"], ["can-bun-archive", "macos-sandbox-exec"], 120000, [check_ref("fixture-offline"), check_ref("offline-package"), check_ref("offline-provides"), check_ref("offline-uses"), check_ref("fixture-project"), check_ref("project-packages"), check_ref("resolution-kind"), check_ref("types-kind"), check_ref("delegate-completion"), check_ref("delegate-data"), check_ref("delegate-domain"), check_ref("delegate-failure"), check_ref("delegate-primitive"), check_ref("delegate-all-bound")], callable case_body)
