record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/run", "default", "", "offline"), "parse-command" => ok "case dist/run variant default root parse-command run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/run", "default", "", "offline"), "idempotent" => ok evidence("idempotent", "true", "true", true, "case dist/run variant default root idempotent run offline")
        different: false, true, context("dist/run", "default", "", "offline"), "idempotent" => failed{"idempotent"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("dist/run", "default", "", "offline"), "prim-sweep" => ok evidence("prim-sweep", "10", "10", true, "case dist/run variant default root prim-sweep run offline")
        different: 9, 10, context("dist/run", "default", "", "offline"), "prim-sweep" => failed{"prim-sweep"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "parse", "parse", context("dist/run", "default", "", "offline"), "parse-command" => ok evidence("parse-command", "parse", "parse", true, "case dist/run variant default root parse-command run offline")
        different: "parses", "parse", context("dist/run", "default", "", "offline"), "parse-command" => failed{"parse-command"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
