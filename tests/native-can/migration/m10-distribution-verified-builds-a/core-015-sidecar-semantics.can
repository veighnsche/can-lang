package m10core015sidecar
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-015 "development sidecar: build, launcher, mutations".
/// Source: tests/integration/distribution_test.go symbol
/// TestDevelopmentSidecar (L19-357).
/// Related sources: distribution/target.json (the pinned target pin)
/// and the staged bundle layout the Go legs traverse (bin/canlc,
/// runtime/bun, manifest.json, tools/runtime/check.ts).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): pinned offline build (archive env, darwin/arm64
/// target, integration version, 2-minute ctx, non-overwriting second
/// build); symlink launcher through packaged Bun (bin/canlc,
/// runtime-check, sandbox-exec deny-network profile, cleared PATH,
/// preserved env probe, present home, literal argv, 1.4.2 identity);
/// hostile ambient configs ignored (poison.ts preload needle, bunfig
/// preload key, secret never printed); source and bundle immutability;
/// and the seven mutation rejections (missing/permission/integrity/arch/
/// path sidecar, manifest, tool) with their exact codes and assets.
/// Parser, project and declaration facets plus the native declaration
/// contracts live in core-015-run-shape.can; static fixture and delegate
/// inventories live in core-015-roots-green.can.
/// Variants: sidecar missing/permission/integrity/arch/path; manifest and
/// tool corruption.
/// Environment: CAN_BUN_ARCHIVE + macOS arm64 + sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates SUITE/BUILD/
/// ARCHIVE/ENV/DIAG and C/R/N/S/A identities bind at P23; no live run
/// now. Descriptor timeout 120000ms mirrors the Go 2-minute ctx (L33).
/// Delegated oracles: none in this file (DELEGATE-001..005 counts live in
/// roots-green and per-declaration pins live in run-shape; all recorded
/// read-only, not executed).
/// Execution credit: NOT claimed (accept_after P23/QF2 unmet).
/// Case dist/sidecar checks: archive-env, target-os, target-arch, 
/// target-id, build-version, build-timeout-min, no-overwrite, 
/// launcher-path, runtime-command, sandbox-tool, sandbox-profile, 
/// offline-path, probe-name, env-probe, secret-name, secret-value, 
/// home-present, argv-first, argv-second, bun-version, 
/// executable-suffix, poison-file, poison-needle, preload-pin, 
/// source-immutable, bundle-immutable, mut-missing, mut-permission, 
/// mut-integrity, mut-arch, mut-path, mut-manifest-code, 
/// mut-manifest-asset, mut-tool-code, mut-tool-asset.
/// Facet map (distribution_test.go legs): archive-env pins CAN_BUN_ARCHIVE
/// (L21); target-os/target-arch pin darwin/arm64 (L25); target-id pins
/// bun-1.4.2-darwin-arm64-v1 (distribution/target.json L3, logged L356);
/// build-version pins integration (L35); build-timeout-min pins 2 (L33:
/// 2*time.Minute); no-overwrite pins the refusal message (L40);
/// launcher-path pins bin/canlc (L64); runtime-command pins runtime-check
/// (L69); sandbox-tool pins /usr/bin/sandbox-exec (L69); sandbox-profile
/// pins the deny-network profile verbatim (L69); offline-path pins
/// PATH=/nonexistent (L67); probe-name pins CAN_DISTRIBUTION_PROBE (L67);
/// env-probe pins preserved (L90); secret-name pins CAN_PRIVATE_SECRET
/// (L67); secret-value pins never-print-this (L67, asserted absent L93);
/// home-present pins the present home (L90); argv-first pins space
/// argument and argv-second pins --not-a-bun-flag (L90); bun-version pins
/// 1.4.2 (L90); executable-suffix pins runtime/bun (L89); poison-file
/// pins poison.ts (L50); poison-needle pins AMBIENT_PRELOAD_EXECUTED
/// (L57); preload-pin pins the bunfig preload key prefix (L59);
/// source-immutable pins the untouched source tree (L273);
/// bundle-immutable pins the untouched bundle (L270); mut-missing pins
/// CAN-DIST-MISSING (L285); mut-permission pins CAN-DIST-PERMISSION
/// (L290); mut-integrity pins CAN-DIST-INTEGRITY (L295); mut-arch pins
/// CAN-DIST-ARCH (L302); mut-path pins CAN-DIST-PATH (L309);
/// mut-manifest-code pins CAN-DIST-MANIFEST and mut-manifest-asset pins
/// manifest.json (L333/L346); mut-tool-code pins CAN-DIST-INTEGRITY and
/// mut-tool-asset pins tools/runtime/check.ts (L333/L344).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str archive_env
    str target_os
    str target_arch
    str target_id
    str build_version
    int build_timeout_min
    str no_overwrite
    str launcher_path
    str runtime_command
    str sandbox_tool
    str sandbox_profile
    str offline_path
    str probe_name
    str env_probe
    str secret_name
    str secret_value
    bool home_present
    str argv_first
    str argv_second
    str bun_version
    str executable_suffix
    str poison_file
    str poison_needle
    str preload_pin
    bool source_immutable
    bool bundle_immutable
    str mut_missing
    str mut_permission
    str mut_integrity
    str mut_arch
    str mut_path
    str mut_manifest_code
    str mut_manifest_asset
    str mut_tool_code
    str mut_tool_asset
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/sidecar", "default", "", "offline"), "archive-env" => ok "case dist/sidecar variant default root archive-env run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/sidecar", "default", "", "offline"), "home-present" => ok evidence("home-present", "true", "true", true, "case dist/sidecar variant default root home-present run offline")
        different: false, true, context("dist/sidecar", "default", "", "offline"), "home-present" => failed{"home-present"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("dist/sidecar", "default", "", "offline"), "build-timeout-min" => ok evidence("build-timeout-min", "2", "2", true, "case dist/sidecar variant default root build-timeout-min run offline")
        different: 1, 2, context("dist/sidecar", "default", "", "offline"), "build-timeout-min" => failed{"build-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("dist/sidecar", "default", "", "offline"), "archive-env" => ok evidence("archive-env", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case dist/sidecar variant default root archive-env run offline")
        different: "CAN_BUN_ARCHIVE_EMPTY", "CAN_BUN_ARCHIVE", context("dist/sidecar", "default", "", "offline"), "archive-env" => failed{"archive-env"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
