    emits {}
    given
        str case
    asserts
        known: "dist/browser-bundle" => ok [expected_check("req-bun-build", "Bun.build"), expected_check("req-target-browser", "target: \"browser\""), expected_check("req-request-kind", "can.browser-bundle-request"), expected_check("req-report-kind", "can.browser-bundle-report"), expected_check("forbid-on-resolve", "true"), expected_check("forbid-on-load", "true"), expected_check("forbid-plugins", "true"), expected_check("forbid-plugin-call", "true"), expected_check("forbid-alias-colon", "true"), expected_check("forbid-alias-call", "true"), expected_check("forbid-external", "true"), expected_check("bind-needle", "bundle manifest does not bind %s"), expected_check("omit-needle", "bundle omits %s: %v")]
        unknown: "nope" => ok []
    match case is "dist/browser-bundle"
        false => ok []
        true => ok [expected_check("req-bun-build", "Bun.build"), expected_check("req-target-browser", "target: \"browser\""), expected_check("req-request-kind", "can.browser-bundle-request"), expected_check("req-report-kind", "can.browser-bundle-report"), expected_check("forbid-on-resolve", "true"), expected_check("forbid-on-load", "true"), expected_check("forbid-plugins", "true"), expected_check("forbid-plugin-call", "true"), expected_check("forbid-alias-colon", "true"), expected_check("forbid-alias-call", "true"), expected_check("forbid-external", "true"), expected_check("bind-needle", "bundle manifest does not bind %s"), expected_check("omit-needle", "bundle omits %s: %v")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("dist/browser-bundle", "default", "", "offline") => ok
        seed_req_bun_build: context("dist/browser-bundle", "seed-req-bun-build-drift", "", "offline") => failed{"req-bun-build"}
        seed_req_target_browser: context("dist/browser-bundle", "seed-req-target-browser-drift", "", "offline") => failed{"req-target-browser"}
        seed_req_request_kind: context("dist/browser-bundle", "seed-req-request-kind-drift", "", "offline") => failed{"req-request-kind"}
        seed_req_report_kind: context("dist/browser-bundle", "seed-req-report-kind-drift", "", "offline") => failed{"req-report-kind"}
        seed_forbid_on_resolve: context("dist/browser-bundle", "seed-forbid-on-resolve-drift", "", "offline") => failed{"forbid-on-resolve"}
        seed_forbid_on_load: context("dist/browser-bundle", "seed-forbid-on-load-drift", "", "offline") => failed{"forbid-on-load"}
        seed_forbid_plugins: context("dist/browser-bundle", "seed-forbid-plugins-drift", "", "offline") => failed{"forbid-plugins"}
        seed_forbid_plugin_call: context("dist/browser-bundle", "seed-forbid-plugin-call-drift", "", "offline") => failed{"forbid-plugin-call"}
        seed_forbid_alias_colon: context("dist/browser-bundle", "seed-forbid-alias-colon-drift", "", "offline") => failed{"forbid-alias-colon"}
        seed_forbid_alias_call: context("dist/browser-bundle", "seed-forbid-alias-call-drift", "", "offline") => failed{"forbid-alias-call"}
        seed_forbid_external: context("dist/browser-bundle", "seed-forbid-external-drift", "", "offline") => failed{"forbid-external"}
        seed_bind_needle: context("dist/browser-bundle", "seed-bind-needle-drift", "", "offline") => failed{"bind-needle"}
        seed_omit_needle: context("dist/browser-bundle", "seed-omit-needle-drift", "", "offline") => failed{"omit-needle"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.req_bun_build, "Bun.build", c, "req-bun-build")
            failed
            ok evidence req_bun_build_evidence => match call require_text(got.req_target_browser, "target: \"browser\"", c, "req-target-browser")
                failed
                ok evidence req_target_browser_evidence => match call require_text(got.req_request_kind, "can.browser-bundle-request", c, "req-request-kind")
                    failed
                    ok evidence req_request_kind_evidence => match call require_text(got.req_report_kind, "can.browser-bundle-report", c, "req-report-kind")
                        failed
                        ok evidence req_report_kind_evidence => match call require_bool(got.forbid_on_resolve, true, c, "forbid-on-resolve")
                            failed
                            ok evidence forbid_on_resolve_evidence => match call require_bool(got.forbid_on_load, true, c, "forbid-on-load")
                                failed
                                ok evidence forbid_on_load_evidence => match call require_bool(got.forbid_plugins, true, c, "forbid-plugins")
                                    failed
                                    ok evidence forbid_plugins_evidence => match call require_bool(got.forbid_plugin_call, true, c, "forbid-plugin-call")
                                        failed
                                        ok evidence forbid_plugin_call_evidence => match call require_bool(got.forbid_alias_colon, true, c, "forbid-alias-colon")
                                            failed
                                            ok evidence forbid_alias_colon_evidence => match call require_bool(got.forbid_alias_call, true, c, "forbid-alias-call")
                                                failed
                                                ok evidence forbid_alias_call_evidence => match call require_bool(got.forbid_external, true, c, "forbid-external")
                                                    failed
                                                    ok evidence forbid_external_evidence => match call require_text(got.bind_needle, "bundle manifest does not bind %s", c, "bind-needle")
                                                        failed
                                                        ok evidence bind_needle_evidence => match call require_text(got.omit_needle, "bundle omits %s: %v", c, "omit-needle")
                                                            failed
                                                            ok evidence omit_needle_evidence => ok
