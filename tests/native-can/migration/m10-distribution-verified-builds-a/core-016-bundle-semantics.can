fn check[] checks
    emits {}
    given
        str scope
    asserts
        m10_016: "m10-016" => ok [check("req-bun-build", "bundle tool invokes the native Bun.build bundler"), check("req-target-browser", "bundle tool pins the browser target"), check("req-request-kind", "bundle tool speaks the browser bundle request protocol"), check("req-report-kind", "bundle tool speaks the browser bundle report protocol"), check("forbid-on-resolve", "bundle tool carries no onResolve machinery"), check("forbid-on-load", "bundle tool carries no onLoad machinery"), check("forbid-plugins", "bundle tool carries no plugins: machinery"), check("forbid-plugin-call", "bundle tool carries no plugin( machinery"), check("forbid-alias-colon", "bundle tool carries no alias: machinery"), check("forbid-alias-call", "bundle tool carries no alias( machinery"), check("forbid-external", "bundle tool carries no external: machinery"), check("bind-needle", "unbound bytes fail with the manifest binding diagnostic"), check("omit-needle", "missing bytes fail with the bundle omission diagnostic")]
        other: "nope" => ok []
    match scope is "m10-016"
        false => ok []
        true => ok [check("req-bun-build", "bundle tool invokes the native Bun.build bundler"), check("req-target-browser", "bundle tool pins the browser target"), check("req-request-kind", "bundle tool speaks the browser bundle request protocol"), check("req-report-kind", "bundle tool speaks the browser bundle report protocol"), check("forbid-on-resolve", "bundle tool carries no onResolve machinery"), check("forbid-on-load", "bundle tool carries no onLoad machinery"), check("forbid-plugins", "bundle tool carries no plugins: machinery"), check("forbid-plugin-call", "bundle tool carries no plugin( machinery"), check("forbid-alias-colon", "bundle tool carries no alias: machinery"), check("forbid-alias-call", "bundle tool carries no alias( machinery"), check("forbid-external", "bundle tool carries no external: machinery"), check("bind-needle", "unbound bytes fail with the manifest binding diagnostic"), check("omit-needle", "missing bytes fail with the bundle omission diagnostic")]
