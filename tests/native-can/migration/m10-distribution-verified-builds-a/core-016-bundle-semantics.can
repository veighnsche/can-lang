        seed_forbid_alias_call: "seed-forbid-alias-call-drift" => ok observation("Bun.build", "target: \"browser\"", "can.browser-bundle-request", "can.browser-bundle-report", true, true, true, true, true, false, true, "bundle manifest does not bind %s", "bundle omits %s: %v")
        seed_forbid_external: "seed-forbid-external-drift" => ok observation("Bun.build", "target: \"browser\"", "can.browser-bundle-request", "can.browser-bundle-report", true, true, true, true, true, true, false, "bundle manifest does not bind %s", "bundle omits %s: %v")
        seed_bind_needle: "seed-bind-needle-drift" => ok observation("Bun.build", "target: \"browser\"", "can.browser-bundle-request", "can.browser-bundle-report", true, true, true, true, true, true, true, "bundle manifest does not track %s", "bundle omits %s: %v")
        seed_omit_needle: "seed-omit-needle-drift" => ok observation("Bun.build", "target: \"browser\"", "can.browser-bundle-request", "can.browser-bundle-report", true, true, true, true, true, true, true, "bundle manifest does not bind %s", "bundle lacks %s: %v")
    match variant_id
