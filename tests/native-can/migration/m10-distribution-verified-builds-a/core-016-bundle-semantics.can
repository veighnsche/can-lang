        "seed-req-request-kind-drift" => ok observation("Bun.build", "target: \"browser\"", "can.browser-bundle-ask", "can.browser-bundle-report", true, true, true, true, true, true, true, "bundle manifest does not bind %s", "bundle omits %s: %v")
        "seed-req-report-kind-drift" => ok observation("Bun.build", "target: \"browser\"", "can.browser-bundle-request", "can.browser-bundle-result", true, true, true, true, true, true, true, "bundle manifest does not bind %s", "bundle omits %s: %v")
