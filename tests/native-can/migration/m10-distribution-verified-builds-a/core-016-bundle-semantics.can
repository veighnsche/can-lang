package m10core016bundle
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-016 "distribution ships the browser bundle tool: protocol and injection exclusions".
/// Source: tests/integration/distribution_test.go symbol
/// TestDistributionShipsBrowserBundleTool (L359-422).
/// Related source: tools/runtime/browser-bundle.ts (the native browser
/// bundler behind the required markers; every behavior pin below cites
/// its root).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the native browser bundling protocol markers
/// carried verbatim (Bun.build, the browser target, the request/report
/// kinds), the seven forbidden plugin/alias/external injection markers
/// absent, and the shipped() binding/omission diagnostics (one
/// load-bearing pin per behavior).
/// The manifest binding inventory lives in core-016-roots-green.can; the
/// production run shape lives in core-016-run-shape.can.
/// Variants: browser bundle tool content (required present, forbidden
/// absent) plus the binding diagnostics.
/// Environment: CAN_BUN_ARCHIVE pinned archive; requires
/// can-bun-archive only (this symbol invokes no sandbox-exec; the
/// darwin/arm64 admission is pinned as data in run-shape). Logical gates
/// SUITE/BUILD/ARCHIVE/ENV/DIAG and C/R/N/S/A identities bind at P23; no
/// live run now. Descriptor timeout 120000ms mirrors the Go 2-minute
/// ctx (L372).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case dist/browser-bundle checks: req-bun-build, req-target-browser,
/// req-request-kind, req-report-kind, forbid-on-resolve, forbid-on-load,
/// forbid-plugins, forbid-plugin-call, forbid-alias-colon,
/// forbid-alias-call, forbid-external, bind-needle, omit-needle.
/// Facet map (distribution_test.go legs + browser-bundle.ts roots):
/// req-bun-build pins Bun.build (Go L400; tool L93, comment L2);
/// req-target-browser pins target "browser" (Go L400; tool L96, comment
/// L2); req-request-kind pins can.browser-bundle-request (Go L400; tool
/// L20); req-report-kind pins can.browser-bundle-report (Go L400; tool
/// L127); the seven forbid-* pins record the Go L405 banned list absent
/// from the tool (verified 0 occurrences each); bind-needle pins the
/// binding diagnostic (Go L395); omit-needle pins the omission
/// diagnostic (Go L392).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str req_bun_build
    str req_target_browser
    str req_request_kind
    str req_report_kind
    bool forbid_on_resolve
    bool forbid_on_load
    bool forbid_plugins
    bool forbid_plugin_call
    bool forbid_alias_colon
    bool forbid_alias_call
    bool forbid_external
    str bind_needle
    str omit_needle
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/browser-bundle", "default", "", "offline"), "req-bun-build" => ok "case dist/browser-bundle variant default root req-bun-build run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/browser-bundle", "default", "", "offline"), "forbid-on-resolve" => ok evidence("forbid-on-resolve", "true", "true", true, "case dist/browser-bundle variant default root forbid-on-resolve run offline")
        different: false, true, context("dist/browser-bundle", "default", "", "offline"), "forbid-on-resolve" => failed{"forbid-on-resolve"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "Bun.build", "Bun.build", context("dist/browser-bundle", "default", "", "offline"), "req-bun-build" => ok evidence("req-bun-build", "Bun.build", "Bun.build", true, "case dist/browser-bundle variant default root req-bun-build run offline")
        different: "Bun.exec", "Bun.build", context("dist/browser-bundle", "default", "", "offline"), "req-bun-build" => failed{"req-bun-build"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
