    asserts
        m10_016: "m10-016" => ok test_case("dist/browser-bundle", ["dist", "m10"], ["can-bun-archive"], 120000, [check_ref("req-bun-build"), check_ref("req-target-browser"), check_ref("req-request-kind"), check_ref("req-report-kind"), check_ref("forbid-on-resolve"), check_ref("forbid-on-load"), check_ref("forbid-plugins"), check_ref("forbid-plugin-call"), check_ref("forbid-alias-colon"), check_ref("forbid-alias-call"), check_ref("forbid-external"), check_ref("bind-needle"), check_ref("omit-needle")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m10-016"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("dist/browser-bundle", ["dist", "m10"], ["can-bun-archive"], 120000, [check_ref("req-bun-build"), check_ref("req-target-browser"), check_ref("req-request-kind"), check_ref("req-report-kind"), check_ref("forbid-on-resolve"), check_ref("forbid-on-load"), check_ref("forbid-plugins"), check_ref("forbid-plugin-call"), check_ref("forbid-alias-colon"), check_ref("forbid-alias-call"), check_ref("forbid-external"), check_ref("bind-needle"), check_ref("omit-needle")], callable case_body)
