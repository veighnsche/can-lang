        same: "manifest.json", "manifest.json", context("dist/browser-bundle-roots", "default", "", "offline"), "manifest-name" => ok evidence("manifest-name", "manifest.json", "manifest.json", true, "case dist/browser-bundle-roots variant default root manifest-name run offline")
        different: "manifest.toml", "manifest.json", context("dist/browser-bundle-roots", "default", "", "offline"), "manifest-name" => failed{"manifest-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
