package m10core016roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-016 "distribution ships the browser bundle tool: manifest binding inventory".
/// Source: tests/integration/distribution_test.go symbol
/// TestDistributionShipsBrowserBundleTool (L359-422); the shipped()
/// helper (L388-398) reads each named file and fails unless its digest
/// equals the manifest entry.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the static shipped inventory as the green
/// baseline: the manifest name, the browser bundle tool path, the eight
/// named browser/assert runtime assets, the bound count through
/// shipped(), and the digest-equality binding outcome (one load-bearing
/// pin per behavior).
/// ADAPTATION (recorded, with source lines): the Go shipped() leg
/// (L394) compares each digest against distribution.Hash(data) of live
/// build bytes, which cannot run before P23; manifest-bound therefore
/// records the digest-equality outcome for P23 qualification while the
/// nine path pins record the exact inventory statically (no execution
/// is claimed here; accept_after P23 unmet).
/// Facet map (distribution_test.go legs): manifest-name pins
/// manifest.json (L378; L333/L345 share the spelling in the CORE-015
/// symbol); tool-path pins tools/runtime/browser-bundle.ts (L399);
/// asset-formats, asset-cookies, asset-csrf, asset-clock, asset-log,
/// asset-markdown and asset-assets pin the seven browser runtimes
/// (L411-417); asset-lineage pins runtime/assert/lineage.ts (L418);
/// bound-count pins the 9 shipped() reads (tool + 8 assets);
/// manifest-bound pins the digest-equality outcome (L394).
/// Protocol markers and injection exclusions live in
/// core-016-bundle-semantics.can; the production run shape lives in
/// core-016-run-shape.can.
/// Variants: browser bundle tool and named browser runtime assets (all
/// pinned).
/// Environment: CAN_BUN_ARCHIVE pinned archive; requires
/// can-bun-archive only (this symbol invokes no sandbox-exec; the
/// darwin/arm64 admission is pinned as data in run-shape). Logical gates
/// SUITE/BUILD/ARCHIVE/ENV/DIAG and C/R/N/S/A identities bind at P23; no
/// live run now. Descriptor timeout 120000ms mirrors the Go 2-minute
/// ctx (L372).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case dist/browser-bundle-roots checks: manifest-name, tool-path,
/// asset-formats, asset-cookies, asset-csrf, asset-clock, asset-log,
/// asset-markdown, asset-assets, asset-lineage, bound-count,
/// manifest-bound.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str manifest_name
    str tool_path
    str asset_formats
    str asset_cookies
    str asset_csrf
    str asset_clock
    str asset_log
    str asset_markdown
    str asset_assets
    str asset_lineage
    int bound_count
    bool manifest_bound
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/browser-bundle-roots", "default", "", "offline"), "manifest-name" => ok "case dist/browser-bundle-roots variant default root manifest-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/browser-bundle-roots", "default", "", "offline"), "manifest-bound" => ok evidence("manifest-bound", "true", "true", true, "case dist/browser-bundle-roots variant default root manifest-bound run offline")
        different: false, true, context("dist/browser-bundle-roots", "default", "", "offline"), "manifest-bound" => failed{"manifest-bound"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 9, 9, context("dist/browser-bundle-roots", "default", "", "offline"), "bound-count" => ok evidence("bound-count", "9", "9", true, "case dist/browser-bundle-roots variant default root bound-count run offline")
        different: 8, 9, context("dist/browser-bundle-roots", "default", "", "offline"), "bound-count" => failed{"bound-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
