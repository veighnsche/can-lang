package m10core036release
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-036 "offline release install/update: tamper, continuity, conflicts".
/// Source: tests/integration/release_test.go symbol
/// TestReleaseInstallUpdate (L28-358).
/// Related sources: distribution/release.go (naming, records, determinism),
/// install.go (verification order, extraction refusals, selection),
/// update.go (previous-preserved update), verify.go (bundle identity),
/// inspect.go (read-only transcript), manifest.go (pins) and
/// distribution/target.json (the pinned macOS arm64 record).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): offline signed install/update and old-version
/// continuity (one load-bearing pin per behavior); detached record,
/// payload, manifest and archive tampering reject with their exact needles;
/// failed and racing updates preserve selection and reject conflicts.
/// The roots-green pin lives in core-036-roots-green.can; the production
/// run shape lives in core-036-run-shape.can.
/// Variants: valid install/update; flipped record byte, edited zip/manifest,
/// failed update, racing installs (Go L151-354).
/// Environment: CAN_BUN_ARCHIVE + macOS arm64; requires
/// can-bun-archive, macos-arm64. Logical gates SUITE/BUILD/ARCHIVE/ENV and
/// C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 360000ms mirrors the Go 6-minute ctx (L42).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case dist/release checks: bun-version, runtime-path, launcher-path,
/// runtime-arg, deterministic, inspection-identifier, inspection-format,
/// runtime-sha, old-continuity, update-prefix, source-clean,
/// source-dir-count, record-separator, refuse-record, refuse-archive,
/// refuse-forged, refuse-symlink, refuse-escape, refuse-multi,
/// refuse-manifest, forged-target, link-target, escape-entry,
/// manifest-entry, failed-preserved, race-count, race-conflict.
/// Facet map (release_test.go legs + distribution roots): bun-version pins
/// 1.4.2 (Go L141); runtime-path pins runtime/bun (target.json L11, Go
/// L140); launcher-path pins bin/canlc (Go L311); runtime-arg pins
/// runtime-check (Go L137); deterministic pins the repeat-release digest
/// match (Go L95-98); inspection-identifier pins Identifier= (Go L88);
/// inspection-format pins Mach-O (Go L88); runtime-sha pins the 64-hex
/// runtime pin (target.json L12, Go L85); old-continuity pins the
/// unchanged old-bytes hash (Go L307-310); update-prefix pins can-rel-b-
/// (Go L301); source-clean pins the untouched source tree (Go L355-357);
/// source-dir-count pins 4 guarded dirs (Go L41); record-separator pins
/// the shasum double space (Go L158, release.go L117); refuse-record pins
/// malformed record (Go L161, release.go L156); refuse-archive pins
/// SHA-256 mismatch (Go L166, install.go L53); refuse-forged pins install
/// release (Go L167); refuse-symlink pins non-regular archive entry (Go
/// L215, install.go L172); refuse-escape pins invalid archive path (Go
/// L217, install.go L156); refuse-multi pins more than one version (Go
/// L219, install.go L165); refuse-manifest pins unsupported distribution
/// identity (Go L285, verify.go L59); forged-target pins
/// bun-9.9.9-darwin-arm64-v9 (Go L281); link-target pins /etc/passwd (Go
/// L214); escape-entry pins v/../../escape (Go L216); manifest-entry pins
/// v/manifest.json (Go L214); failed-preserved pins the kept selection
/// (Go L332-334); race-count pins 8 racers (Go L337); race-conflict pins
/// already exists (Go L342, install.go L75).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str bun_version
    str runtime_path
    str launcher_path
    str runtime_arg
    bool deterministic
    str inspection_identifier
    str inspection_format
    str runtime_sha
    bool old_continuity
    str update_prefix
    bool source_clean
    int source_dir_count
    str record_separator
    str refuse_record
    str refuse_archive
    str refuse_forged
    str refuse_symlink
    str refuse_escape
    str refuse_multi
    str refuse_manifest
    str forged_target
    str link_target
    str escape_entry
    str manifest_entry
    bool failed_preserved
    int race_count
    str race_conflict
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/release", "default", "", "offline"), "bun-version" => ok "case dist/release variant default root bun-version run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/release", "default", "", "offline"), "deterministic" => ok evidence("deterministic", "true", "true", true, "case dist/release variant default root deterministic run offline")
        different: false, true, context("dist/release", "default", "", "offline"), "deterministic" => failed{"deterministic"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("dist/release", "default", "", "offline"), "source-dir-count" => ok evidence("source-dir-count", "4", "4", true, "case dist/release variant default root source-dir-count run offline")
        different: 3, 4, context("dist/release", "default", "", "offline"), "source-dir-count" => failed{"source-dir-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "1.4.2", "1.4.2", context("dist/release", "default", "", "offline"), "bun-version" => ok evidence("bun-version", "1.4.2", "1.4.2", true, "case dist/release variant default root bun-version run offline")
        different: "1.4.2x", "1.4.2", context("dist/release", "default", "", "offline"), "bun-version" => failed{"bun-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("1.4.2", "runtime/bun", "bin/canlc", "runtime-check", true, "Identifier=", "Mach-O", "35d20dd0263e5c950194434b925454fdfa9ba6e4467da960410fa05b08a7a5b5", true, "can-rel-b-", true, 4, "  ", "malformed record", "SHA-256 mismatch", "install release", "non-regular archive entry", "invalid archive path", "more than one version", "unsupported distribution identity", "bun-9.9.9-darwin-arm64-v9", "/etc/passwd", "v/../../escape", "v/manifest.json", true, 8, "already exists")
