package m10core036roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-036 "release install/update: roots green, artifact inventory".
/// Source: tests/integration/release_test.go symbol
/// TestReleaseInstallUpdate (L28-358); treeHashes helper in
/// tests/integration/distribution_test.go (L424); pinned record in
/// distribution/target.json; release/install/update/verify/inspect in
/// distribution/release.go, install.go, update.go, verify.go, inspect.go.
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): static release/install identity inventory as the
/// green baseline: the two build versions, the release prefix, the pinned
/// target id, the archive/record/inspection suffixes, the inspection kind,
/// the install-root selection link and versions directory, and the
/// three-artifact release count.
/// ADAPTATION (recorded, with source lines): the Go test stages no Can
/// assert leg, so this file records the static naming inventory the valid
/// install path requires (release L60-63, install L103-111) for P23
/// qualification rather than an observed assert report; no execution is
/// claimed here (accept_after P23 unmet).
/// Facet map (release_test.go legs plus distribution roots):
/// build-version-a pins rel-a (Go L52); build-version-b pins rel-b (L53);
/// release-prefix pins can-rel-a- (L60); target-id pins
/// bun-1.4.2-darwin-arm64-v1 (target.json L3); archive-suffix pins .zip
/// (L61); record-suffix pins .zip.sha256 (release.go L52);
/// inspection-suffix pins .inspection.json (release.go L53);
/// inspection-kind pins can.release-inspection (inspect.go L73, Go L85);
/// selected-link pins current (install.go L96); versions-dir pins versions
/// (install.go L68); artifact-count pins 3 (release.go L50-54).
/// Release semantics live in core-036-release-semantics.can; the
/// production run shape lives in core-036-run-shape.can.
/// Variants: none in this file (default only); tamper variants, refusal
/// needles and racing conflicts live in release-semantics.
/// Environment: CAN_BUN_ARCHIVE + macOS arm64; requires
/// can-bun-archive, macos-arm64. Logical gates SUITE/BUILD/ARCHIVE/ENV and
/// C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 360000ms mirrors the Go 6-minute ctx (L42).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case dist/release-roots checks: build-version-a, build-version-b,
/// release-prefix, target-id, archive-suffix, record-suffix,
/// inspection-suffix, inspection-kind, selected-link, versions-dir,
/// artifact-count.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str build_version_a
    str build_version_b
    str release_prefix
    str target_id
    str archive_suffix
    str record_suffix
    str inspection_suffix
    str inspection_kind
    str selected_link
    str versions_dir
    int artifact_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/release-roots", "default", "", "offline"), "build-version-a" => ok "case dist/release-roots variant default root build-version-a run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/release-roots", "default", "", "offline"), "build-version-a" => ok evidence("build-version-a", "true", "true", true, "case dist/release-roots variant default root build-version-a run offline")
        different: false, true, context("dist/release-roots", "default", "", "offline"), "build-version-a" => failed{"build-version-a"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("dist/release-roots", "default", "", "offline"), "artifact-count" => ok evidence("artifact-count", "3", "3", true, "case dist/release-roots variant default root artifact-count run offline")
        different: 2, 3, context("dist/release-roots", "default", "", "offline"), "artifact-count" => failed{"artifact-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "rel-a", "rel-a", context("dist/release-roots", "default", "", "offline"), "build-version-a" => ok evidence("build-version-a", "rel-a", "rel-a", true, "case dist/release-roots variant default root build-version-a run offline")
        different: "rel-ax", "rel-a", context("dist/release-roots", "default", "", "offline"), "build-version-a" => failed{"build-version-a"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
