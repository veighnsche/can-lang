fn check[] checks
    emits {}
    given
        str scope
    asserts
        m10_036: "m10-036" => ok [check("build-version-a", "first build version is rel-a"), check("build-version-b", "second build version is rel-b"), check("release-prefix", "release base starts can-rel-a-"), check("target-id", "pinned target is bun-1.4.2-darwin-arm64-v1"), check("archive-suffix", "release archive ends .zip"), check("record-suffix", "detached record ends .zip.sha256"), check("inspection-suffix", "inspection transcript ends .inspection.json"), check("inspection-kind", "inspection kind is can.release-inspection"), check("selected-link", "selection link is named current"), check("versions-dir", "install versions live under versions"), check("artifact-count", "one release produces 3 artifacts")]
        other: "nope" => ok []
    match scope is "m10-036"
        false => ok []
        true => ok [check("build-version-a", "first build version is rel-a"), check("build-version-b", "second build version is rel-b"), check("release-prefix", "release base starts can-rel-a-"), check("target-id", "pinned target is bun-1.4.2-darwin-arm64-v1"), check("archive-suffix", "release archive ends .zip"), check("record-suffix", "detached record ends .zip.sha256"), check("inspection-suffix", "inspection transcript ends .inspection.json"), check("inspection-kind", "inspection kind is can.release-inspection"), check("selected-link", "selection link is named current"), check("versions-dir", "install versions live under versions"), check("artifact-count", "one release produces 3 artifacts")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "dist/release-roots" => ok [expected_check("build-version-a", "rel-a"), expected_check("build-version-b", "rel-b"), expected_check("release-prefix", "can-rel-a-"), expected_check("target-id", "bun-1.4.2-darwin-arm64-v1"), expected_check("archive-suffix", ".zip"), expected_check("record-suffix", ".zip.sha256"), expected_check("inspection-suffix", ".inspection.json"), expected_check("inspection-kind", "can.release-inspection"), expected_check("selected-link", "current"), expected_check("versions-dir", "versions"), expected_check("artifact-count", "3")]
        unknown: "nope" => ok []
    match case is "dist/release-roots"
        false => ok []
        true => ok [expected_check("build-version-a", "rel-a"), expected_check("build-version-b", "rel-b"), expected_check("release-prefix", "can-rel-a-"), expected_check("target-id", "bun-1.4.2-darwin-arm64-v1"), expected_check("archive-suffix", ".zip"), expected_check("record-suffix", ".zip.sha256"), expected_check("inspection-suffix", ".inspection.json"), expected_check("inspection-kind", "can.release-inspection"), expected_check("selected-link", "current"), expected_check("versions-dir", "versions"), expected_check("artifact-count", "3")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("dist/release-roots", "default", "", "offline") => ok
        seed_build_version_a: context("dist/release-roots", "seed-build-version-a-drift", "", "offline") => failed{"build-version-a"}
        seed_build_version_b: context("dist/release-roots", "seed-build-version-b-drift", "", "offline") => failed{"build-version-b"}
        seed_release_prefix: context("dist/release-roots", "seed-release-prefix-drift", "", "offline") => failed{"release-prefix"}
        seed_target_id: context("dist/release-roots", "seed-target-id-drift", "", "offline") => failed{"target-id"}
        seed_archive_suffix: context("dist/release-roots", "seed-archive-suffix-drift", "", "offline") => failed{"archive-suffix"}
        seed_record_suffix: context("dist/release-roots", "seed-record-suffix-drift", "", "offline") => failed{"record-suffix"}
        seed_inspection_suffix: context("dist/release-roots", "seed-inspection-suffix-drift", "", "offline") => failed{"inspection-suffix"}
        seed_inspection_kind: context("dist/release-roots", "seed-inspection-kind-drift", "", "offline") => failed{"inspection-kind"}
        seed_selected_link: context("dist/release-roots", "seed-selected-link-drift", "", "offline") => failed{"selected-link"}
        seed_versions_dir: context("dist/release-roots", "seed-versions-dir-drift", "", "offline") => failed{"versions-dir"}
        seed_artifact_count: context("dist/release-roots", "seed-artifact-count-drift", "", "offline") => failed{"artifact-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.build_version_a, "rel-a", c, "build-version-a")
            failed
            ok evidence build_version_a_evidence => match call require_text(got.build_version_b, "rel-b", c, "build-version-b")
                failed
                ok evidence build_version_b_evidence => match call require_text(got.release_prefix, "can-rel-a-", c, "release-prefix")
                    failed
                    ok evidence release_prefix_evidence => match call require_text(got.target_id, "bun-1.4.2-darwin-arm64-v1", c, "target-id")
                        failed
                        ok evidence target_id_evidence => match call require_text(got.archive_suffix, ".zip", c, "archive-suffix")
                            failed
                            ok evidence archive_suffix_evidence => match call require_text(got.record_suffix, ".zip.sha256", c, "record-suffix")
                                failed
                                ok evidence record_suffix_evidence => match call require_text(got.inspection_suffix, ".inspection.json", c, "inspection-suffix")
                                    failed
                                    ok evidence inspection_suffix_evidence => match call require_text(got.inspection_kind, "can.release-inspection", c, "inspection-kind")
                                        failed
                                        ok evidence inspection_kind_evidence => match call require_text(got.selected_link, "current", c, "selected-link")
                                            failed
                                            ok evidence selected_link_evidence => match call require_text(got.versions_dir, "versions", c, "versions-dir")
                                                failed
                                                ok evidence versions_dir_evidence => match call require_int(got.artifact_count, 3, c, "artifact-count")
                                                    failed
                                                    ok evidence artifact_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m10_036: "m10-036" => ok test_case("dist/release-roots", ["dist", "m10"], ["can-bun-archive", "macos-arm64"], 360000, [check_ref("build-version-a"), check_ref("build-version-b"), check_ref("release-prefix"), check_ref("target-id"), check_ref("archive-suffix"), check_ref("record-suffix"), check_ref("inspection-suffix"), check_ref("inspection-kind"), check_ref("selected-link"), check_ref("versions-dir"), check_ref("artifact-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m10-036"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("dist/release-roots", ["dist", "m10"], ["can-bun-archive", "macos-arm64"], 360000, [check_ref("build-version-a"), check_ref("build-version-b"), check_ref("release-prefix"), check_ref("target-id"), check_ref("archive-suffix"), check_ref("record-suffix"), check_ref("inspection-suffix"), check_ref("inspection-kind"), check_ref("selected-link"), check_ref("versions-dir"), check_ref("artifact-count")], callable case_body)
