        seed_release_prefix: "seed-release-prefix-drift" => ok observation("rel-a", "rel-b", "can-rel-c-", "bun-1.4.2-darwin-arm64-v1", ".zip", ".zip.sha256", ".inspection.json", "can.release-inspection", "current", "versions", 3)
        seed_target_id: "seed-target-id-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v2", ".zip", ".zip.sha256", ".inspection.json", "can.release-inspection", "current", "versions", 3)
        seed_archive_suffix: "seed-archive-suffix-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v1", ".tgz", ".zip.sha256", ".inspection.json", "can.release-inspection", "current", "versions", 3)
        seed_record_suffix: "seed-record-suffix-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v1", ".zip", ".zip.sha1", ".inspection.json", "can.release-inspection", "current", "versions", 3)
        seed_inspection_suffix: "seed-inspection-suffix-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v1", ".zip", ".zip.sha256", ".inspect.json", "can.release-inspection", "current", "versions", 3)
        seed_inspection_kind: "seed-inspection-kind-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v1", ".zip", ".zip.sha256", ".inspection.json", "can.release-review", "current", "versions", 3)
        seed_selected_link: "seed-selected-link-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v1", ".zip", ".zip.sha256", ".inspection.json", "can.release-inspection", "latest", "versions", 3)
        seed_versions_dir: "seed-versions-dir-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v1", ".zip", ".zip.sha256", ".inspection.json", "can.release-inspection", "current", "releases", 3)
