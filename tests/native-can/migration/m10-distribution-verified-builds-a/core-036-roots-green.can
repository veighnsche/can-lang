        "seed-release-prefix-drift" => ok observation("rel-a", "rel-b", "can-rel-c-", "bun-1.4.2-darwin-arm64-v1", ".zip", ".zip.sha256", ".inspection.json", "can.release-inspection", "current", "versions", 3)
        "seed-target-id-drift" => ok observation("rel-a", "rel-b", "can-rel-a-", "bun-1.4.2-darwin-arm64-v2", ".zip", ".zip.sha256", ".inspection.json", "can.release-inspection", "current", "versions", 3)
