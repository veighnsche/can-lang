fn check[] checks
    emits {}
    given
        str scope
    asserts
        m10_036: "m10-036" => ok [check("sandbox-tool", "offline runs go through sandbox-exec"), check("sandbox-profile", "sandbox profile denies network"), check("selected-binary", "offline runs use current/bin/canlc"), check("offline-path", "offline runs clear PATH"), check("home-name", "offline runs use an isolated home"), check("cwd-name", "offline runs start in an unrelated dir"), check("env-archive", "archive gate reads CAN_BUN_ARCHIVE"), check("target-os", "admitted target OS is darwin"), check("target-arch", "admitted target arch is arm64"), check("ctx-timeout-ms", "flow deadline is 360000ms"), check("install-root-name", "install leg uses install-root"), check("refuse-root-name", "refusal legs use refuse-root")]
        other: "nope" => ok []
    match scope is "m10-036"
        false => ok []
        true => ok [check("sandbox-tool", "offline runs go through sandbox-exec"), check("sandbox-profile", "sandbox profile denies network"), check("selected-binary", "offline runs use current/bin/canlc"), check("offline-path", "offline runs clear PATH"), check("home-name", "offline runs use an isolated home"), check("cwd-name", "offline runs start in an unrelated dir"), check("env-archive", "archive gate reads CAN_BUN_ARCHIVE"), check("target-os", "admitted target OS is darwin"), check("target-arch", "admitted target arch is arm64"), check("ctx-timeout-ms", "flow deadline is 360000ms"), check("install-root-name", "install leg uses install-root"), check("refuse-root-name", "refusal legs use refuse-root")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "dist/release-run" => ok [expected_check("sandbox-tool", "/usr/bin/sandbox-exec"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("selected-binary", "current/bin/canlc"), expected_check("offline-path", "PATH=/nonexistent"), expected_check("home-name", "home"), expected_check("cwd-name", "unrelated"), expected_check("env-archive", "CAN_BUN_ARCHIVE"), expected_check("target-os", "darwin"), expected_check("target-arch", "arm64"), expected_check("ctx-timeout-ms", "360000"), expected_check("install-root-name", "install-root"), expected_check("refuse-root-name", "refuse-root")]
        unknown: "nope" => ok []
    match case is "dist/release-run"
        false => ok []
        true => ok [expected_check("sandbox-tool", "/usr/bin/sandbox-exec"), expected_check("sandbox-profile", "(version 1)(allow default)(deny network*)"), expected_check("selected-binary", "current/bin/canlc"), expected_check("offline-path", "PATH=/nonexistent"), expected_check("home-name", "home"), expected_check("cwd-name", "unrelated"), expected_check("env-archive", "CAN_BUN_ARCHIVE"), expected_check("target-os", "darwin"), expected_check("target-arch", "arm64"), expected_check("ctx-timeout-ms", "360000"), expected_check("install-root-name", "install-root"), expected_check("refuse-root-name", "refuse-root")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("dist/release-run", "default", "", "offline") => ok
        seed_sandbox_tool: context("dist/release-run", "seed-sandbox-tool-drift", "", "offline") => failed{"sandbox-tool"}
        seed_sandbox_profile: context("dist/release-run", "seed-sandbox-profile-drift", "", "offline") => failed{"sandbox-profile"}
        seed_selected_binary: context("dist/release-run", "seed-selected-binary-drift", "", "offline") => failed{"selected-binary"}
        seed_offline_path: context("dist/release-run", "seed-offline-path-drift", "", "offline") => failed{"offline-path"}
        seed_home_name: context("dist/release-run", "seed-home-name-drift", "", "offline") => failed{"home-name"}
        seed_cwd_name: context("dist/release-run", "seed-cwd-name-drift", "", "offline") => failed{"cwd-name"}
        seed_env_archive: context("dist/release-run", "seed-env-archive-drift", "", "offline") => failed{"env-archive"}
        seed_target_os: context("dist/release-run", "seed-target-os-drift", "", "offline") => failed{"target-os"}
        seed_target_arch: context("dist/release-run", "seed-target-arch-drift", "", "offline") => failed{"target-arch"}
        seed_ctx_timeout_ms: context("dist/release-run", "seed-ctx-timeout-ms-drift", "", "offline") => failed{"ctx-timeout-ms"}
        seed_install_root_name: context("dist/release-run", "seed-install-root-name-drift", "", "offline") => failed{"install-root-name"}
        seed_refuse_root_name: context("dist/release-run", "seed-refuse-root-name-drift", "", "offline") => failed{"refuse-root-name"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.sandbox_tool, "/usr/bin/sandbox-exec", c, "sandbox-tool")
            failed
            ok evidence sandbox_tool_evidence => match call require_text(got.sandbox_profile, "(version 1)(allow default)(deny network*)", c, "sandbox-profile")
                failed
                ok evidence sandbox_profile_evidence => match call require_text(got.selected_binary, "current/bin/canlc", c, "selected-binary")
                    failed
                    ok evidence selected_binary_evidence => match call require_text(got.offline_path, "PATH=/nonexistent", c, "offline-path")
                        failed
                        ok evidence offline_path_evidence => match call require_text(got.home_name, "home", c, "home-name")
                            failed
                            ok evidence home_name_evidence => match call require_text(got.cwd_name, "unrelated", c, "cwd-name")
                                failed
                                ok evidence cwd_name_evidence => match call require_text(got.env_archive, "CAN_BUN_ARCHIVE", c, "env-archive")
                                    failed
                                    ok evidence env_archive_evidence => match call require_text(got.target_os, "darwin", c, "target-os")
                                        failed
                                        ok evidence target_os_evidence => match call require_text(got.target_arch, "arm64", c, "target-arch")
                                            failed
                                            ok evidence target_arch_evidence => match call require_int(got.ctx_timeout_ms, 360000, c, "ctx-timeout-ms")
                                                failed
                                                ok evidence ctx_timeout_ms_evidence => match call require_text(got.install_root_name, "install-root", c, "install-root-name")
                                                    failed
                                                    ok evidence install_root_name_evidence => match call require_text(got.refuse_root_name, "refuse-root", c, "refuse-root-name")
                                                        failed
                                                        ok evidence refuse_root_name_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m10_036: "m10-036" => ok test_case("dist/release-run", ["dist", "m10"], ["can-bun-archive", "macos-arm64"], 360000, [check_ref("sandbox-tool"), check_ref("sandbox-profile"), check_ref("selected-binary"), check_ref("offline-path"), check_ref("home-name"), check_ref("cwd-name"), check_ref("env-archive"), check_ref("target-os"), check_ref("target-arch"), check_ref("ctx-timeout-ms"), check_ref("install-root-name"), check_ref("refuse-root-name")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m10-036"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("dist/release-run", ["dist", "m10"], ["can-bun-archive", "macos-arm64"], 360000, [check_ref("sandbox-tool"), check_ref("sandbox-profile"), check_ref("selected-binary"), check_ref("offline-path"), check_ref("home-name"), check_ref("cwd-name"), check_ref("env-archive"), check_ref("target-os"), check_ref("target-arch"), check_ref("ctx-timeout-ms"), check_ref("install-root-name"), check_ref("refuse-root-name")], callable case_body)
