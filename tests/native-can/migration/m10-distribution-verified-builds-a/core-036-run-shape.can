        seed_home_name: "seed-home-name-drift" => ok observation("/usr/bin/sandbox-exec", "(version 1)(allow default)(deny network*)", "current/bin/canlc", "PATH=/nonexistent", "house", "unrelated", "CAN_BUN_ARCHIVE", "darwin", "arm64", 360000, "install-root", "refuse-root")
