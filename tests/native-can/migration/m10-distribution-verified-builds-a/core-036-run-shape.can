        seed_target_os: "seed-target-os-drift" => ok observation("/usr/bin/sandbox-exec", "(version 1)(allow default)(deny network*)", "current/bin/canlc", "PATH=/nonexistent", "home", "unrelated", "CAN_BUN_ARCHIVE", "linux", "arm64", 360000, "install-root", "refuse-root")
        seed_target_arch: "seed-target-arch-drift" => ok observation("/usr/bin/sandbox-exec", "(version 1)(allow default)(deny network*)", "current/bin/canlc", "PATH=/nonexistent", "home", "unrelated", "CAN_BUN_ARCHIVE", "darwin", "amd64", 360000, "install-root", "refuse-root")
