package m10core036run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-036 "release install/update: run shape, offline invocation".
/// Source: tests/integration/release_test.go symbol
/// TestReleaseInstallUpdate (L28-358).
/// Related fixtures: the sandbox-exec run helper (L122-132), the old-binary
/// run (L311-316), the install/refusal roots (L103/L146) and the
/// environment gate (L30-36).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production run shape of the offline install path.
/// The installed tree runs through the selected link under sandbox-exec
/// with a deny-network profile, a cleared PATH, an isolated HOME and an
/// unrelated cwd; the archive and host gates admit only the pinned macOS
/// arm64 target within the 6-minute flow deadline.
/// ADAPTATION (recorded, with source lines): Go pins no run exit or stream
/// bytes (the helper fails the test on any error at L127-131 and the
/// runtime-check assertions decode JSON at L137/L320), so this file pins
/// the invocation shape and gate literals verbatim instead of exit/stream
/// facts; the roots-green pin lives in core-036-roots-green.can and the
/// install/update behaviors live in core-036-release-semantics.can.
/// Variants: ok path (selected run, old-binary run), gate path (archive
/// skip, host fatal), refusal roots.
/// Environment: CAN_BUN_ARCHIVE + macOS arm64; requires
/// can-bun-archive, macos-arm64. Logical gates SUITE/BUILD/ARCHIVE/ENV and
/// C/R/N/S/A identities bind at P23; no live run now. Descriptor
/// timeout 360000ms mirrors the Go 6-minute ctx (L42).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case dist/release-run checks: sandbox-tool, sandbox-profile,
/// selected-binary, offline-path, home-name, cwd-name, env-archive,
/// target-os, target-arch, ctx-timeout-ms, install-root-name,
/// refuse-root-name.
/// Facet map (release_test.go legs): sandbox-tool pins
/// /usr/bin/sandbox-exec (L124); sandbox-profile pins the deny-network
/// profile verbatim (L124); selected-binary pins current/bin/canlc (L124);
/// offline-path pins PATH=/nonexistent (L126); home-name pins home (L115);
/// cwd-name pins unrelated (L116); env-archive pins CAN_BUN_ARCHIVE (L30);
/// target-os pins darwin (L34); target-arch pins arm64 (L34);
/// ctx-timeout-ms pins 360000 (L42: 6*time.Minute); install-root-name pins
/// install-root (L103); refuse-root-name pins refuse-root (L146).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str sandbox_tool
    str sandbox_profile
    str selected_binary
    str offline_path
    str home_name
    str cwd_name
    str env_archive
    str target_os
    str target_arch
    int ctx_timeout_ms
    str install_root_name
    str refuse_root_name
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/release-run", "default", "", "offline"), "sandbox-tool" => ok "case dist/release-run variant default root sandbox-tool run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/release-run", "default", "", "offline"), "sandbox-tool" => ok evidence("sandbox-tool", "true", "true", true, "case dist/release-run variant default root sandbox-tool run offline")
        different: false, true, context("dist/release-run", "default", "", "offline"), "sandbox-tool" => failed{"sandbox-tool"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 360000, 360000, context("dist/release-run", "default", "", "offline"), "ctx-timeout-ms" => ok evidence("ctx-timeout-ms", "360000", "360000", true, "case dist/release-run variant default root ctx-timeout-ms run offline")
        different: 359999, 360000, context("dist/release-run", "default", "", "offline"), "ctx-timeout-ms" => failed{"ctx-timeout-ms"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/usr/bin/sandbox-exec", "/usr/bin/sandbox-exec", context("dist/release-run", "default", "", "offline"), "sandbox-tool" => ok evidence("sandbox-tool", "/usr/bin/sandbox-exec", "/usr/bin/sandbox-exec", true, "case dist/release-run variant default root sandbox-tool run offline")
        different: "/usr/bin/sandbox-execx", "/usr/bin/sandbox-exec", context("dist/release-run", "default", "", "offline"), "sandbox-tool" => failed{"sandbox-tool"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
