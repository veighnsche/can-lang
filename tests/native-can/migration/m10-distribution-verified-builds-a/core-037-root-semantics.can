package m10core037root
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-037 "install root refusals: symlink root, empty selection".
/// Source: tests/integration/release_test.go symbol
/// TestInstallRootRefusals (L360-378).
/// Related sources: distribution/install.go (prepareRoot refusal L107-122,
/// Selection L91-105), distribution/update.go (Update L15-39) and
/// distribution/install_test.go (the sibling L91 symlink refusal leg).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): update refuses a symlink install root before
/// reading deliberately nonexistent archive/record paths (one load-bearing
/// pin per behavior: the refusal needle, the full distribution text, the
/// error predicate, the root-first ordering and the absent-input count);
/// selection on an absent empty root returns no selected version without
/// error (the empty selection plus the ok predicate); and the
/// presence-only environment gate with its skip note.
/// The roots-green pin lives in core-037-roots-green.can; the production
/// run shape lives in core-037-run-shape.can.
/// Variants: symlink root; absent root (Go L366-377).
/// Environment: CAN_BUN_ARCHIVE presence only; requires can-bun-archive.
/// Unlike TestReleaseInstallUpdate (L34) this symbol sets no darwin/arm64
/// gate. Logical gates SUITE/BUILD/ARCHIVE/ENV and C/R/N/S/A identities
/// bind at P23; no live run now. Descriptor timeout 60000ms is the harness
/// floor; Go L365 uses context.Background with no deadline.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case dist/install-root checks: refuse-needle, refuse-full,
/// selection-empty, selection-ok, update-errors, root-first, gate-env,
/// skip-note, absent-input-count.
/// Facet map (release_test.go legs + distribution roots): refuse-needle
/// pins must not be a symlink (Go L372, install.go L116); refuse-full pins
/// the install release prefix form (install.go L116); selection-empty pins
/// the empty version (Go L375, install.go L99 return "", nil);
/// selection-ok pins the nil error (Go L375); update-errors pins the
/// refusal error (Go L371-374); root-first pins the before-any-read order
/// (Go L370-374 with deliberately absent inputs); gate-env pins
/// CAN_BUN_ARCHIVE (Go L362); skip-note pins the skip text (Go L363);
/// absent-input-count pins 2 absent paths (Go L371).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str refuse_needle
    str refuse_full
    str selection_empty
    bool selection_ok
    bool update_errors
    bool root_first
    str gate_env
    str skip_note
    int absent_input_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/install-root", "default", "", "offline"), "refuse-needle" => ok "case dist/install-root variant default root refuse-needle run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/install-root", "default", "", "offline"), "selection-ok" => ok evidence("selection-ok", "true", "true", true, "case dist/install-root variant default root selection-ok run offline")
        different: false, true, context("dist/install-root", "default", "", "offline"), "selection-ok" => failed{"selection-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("dist/install-root", "default", "", "offline"), "absent-input-count" => ok evidence("absent-input-count", "2", "2", true, "case dist/install-root variant default root absent-input-count run offline")
        different: 1, 2, context("dist/install-root", "default", "", "offline"), "absent-input-count" => failed{"absent-input-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "must not be a symlink", "must not be a symlink", context("dist/install-root", "default", "", "offline"), "refuse-needle" => ok evidence("refuse-needle", "must not be a symlink", "must not be a symlink", true, "case dist/install-root variant default root refuse-needle run offline")
        different: "must be a symlink", "must not be a symlink", context("dist/install-root", "default", "", "offline"), "refuse-needle" => failed{"refuse-needle"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_refuse_needle: "seed-refuse-needle-drift" => ok observation("must be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_refuse_full: "seed-refuse-full-drift" => ok observation("must not be a symlink", "install release: root must be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_selection_empty: "seed-selection-empty-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "versions/v1", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_selection_ok: "seed-selection-ok-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", false, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_update_errors: "seed-update-errors-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, false, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_root_first: "seed-root-first-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, false, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_gate_env: "seed-gate-env-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVES", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        seed_skip_note: "seed-skip-note-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal probes", 2)
        seed_absent_input_count: "seed-absent-input-count-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 1)
    match variant_id
        "seed-refuse-needle-drift" => ok observation("must be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        "seed-refuse-full-drift" => ok observation("must not be a symlink", "install release: root must be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        "seed-selection-empty-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "versions/v1", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        "seed-selection-ok-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", false, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        "seed-update-errors-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, false, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        "seed-root-first-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, false, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        "seed-gate-env-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVES", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
        "seed-skip-note-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal probes", 2)
        "seed-absent-input-count-drift" => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 1)
        _ => ok observation("must not be a symlink", "install release: root must not be a symlink", "", true, true, true, "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for root refusal checks", 2)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m10_037: "m10-037" => ok [check("refuse-needle", "update refusal names the symlink root cause"), check("refuse-full", "full refusal text carries the install release prefix"), check("selection-empty", "absent root selects the empty version"), check("selection-ok", "absent-root selection returns no error"), check("update-errors", "update over a symlink root returns an error"), check("root-first", "root check fires before any archive is read"), check("gate-env", "row gates on CAN_BUN_ARCHIVE presence"), check("skip-note", "skip names the root refusal checks"), check("absent-input-count", "refusal uses two deliberately absent inputs")]
        other: "nope" => ok []
    match scope is "m10-037"
        false => ok []
        true => ok [check("refuse-needle", "update refusal names the symlink root cause"), check("refuse-full", "full refusal text carries the install release prefix"), check("selection-empty", "absent root selects the empty version"), check("selection-ok", "absent-root selection returns no error"), check("update-errors", "update over a symlink root returns an error"), check("root-first", "root check fires before any archive is read"), check("gate-env", "row gates on CAN_BUN_ARCHIVE presence"), check("skip-note", "skip names the root refusal checks"), check("absent-input-count", "refusal uses two deliberately absent inputs")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "dist/install-root" => ok [expected_check("refuse-needle", "must not be a symlink"), expected_check("refuse-full", "install release: root must not be a symlink"), expected_check("selection-empty", ""), expected_check("selection-ok", "true"), expected_check("update-errors", "true"), expected_check("root-first", "true"), expected_check("gate-env", "CAN_BUN_ARCHIVE"), expected_check("skip-note", "set CAN_BUN_ARCHIVE for root refusal checks"), expected_check("absent-input-count", "2")]
        unknown: "nope" => ok []
    match case is "dist/install-root"
        false => ok []
        true => ok [expected_check("refuse-needle", "must not be a symlink"), expected_check("refuse-full", "install release: root must not be a symlink"), expected_check("selection-empty", ""), expected_check("selection-ok", "true"), expected_check("update-errors", "true"), expected_check("root-first", "true"), expected_check("gate-env", "CAN_BUN_ARCHIVE"), expected_check("skip-note", "set CAN_BUN_ARCHIVE for root refusal checks"), expected_check("absent-input-count", "2")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("dist/install-root", "default", "", "offline") => ok
        seed_refuse_needle: context("dist/install-root", "seed-refuse-needle-drift", "", "offline") => failed{"refuse-needle"}
        seed_refuse_full: context("dist/install-root", "seed-refuse-full-drift", "", "offline") => failed{"refuse-full"}
        seed_selection_empty: context("dist/install-root", "seed-selection-empty-drift", "", "offline") => failed{"selection-empty"}
        seed_selection_ok: context("dist/install-root", "seed-selection-ok-drift", "", "offline") => failed{"selection-ok"}
        seed_update_errors: context("dist/install-root", "seed-update-errors-drift", "", "offline") => failed{"update-errors"}
        seed_root_first: context("dist/install-root", "seed-root-first-drift", "", "offline") => failed{"root-first"}
        seed_gate_env: context("dist/install-root", "seed-gate-env-drift", "", "offline") => failed{"gate-env"}
        seed_skip_note: context("dist/install-root", "seed-skip-note-drift", "", "offline") => failed{"skip-note"}
        seed_absent_input_count: context("dist/install-root", "seed-absent-input-count-drift", "", "offline") => failed{"absent-input-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.refuse_needle, "must not be a symlink", c, "refuse-needle")
            failed
            ok evidence refuse_needle_evidence => match call require_text(got.refuse_full, "install release: root must not be a symlink", c, "refuse-full")
                failed
                ok evidence refuse_full_evidence => match call require_text(got.selection_empty, "", c, "selection-empty")
                    failed
                    ok evidence selection_empty_evidence => match call require_bool(got.selection_ok, true, c, "selection-ok")
                        failed
                        ok evidence selection_ok_evidence => match call require_bool(got.update_errors, true, c, "update-errors")
                            failed
                            ok evidence update_errors_evidence => match call require_bool(got.root_first, true, c, "root-first")
                                failed
                                ok evidence root_first_evidence => match call require_text(got.gate_env, "CAN_BUN_ARCHIVE", c, "gate-env")
                                    failed
                                    ok evidence gate_env_evidence => match call require_text(got.skip_note, "set CAN_BUN_ARCHIVE for root refusal checks", c, "skip-note")
                                        failed
                                        ok evidence skip_note_evidence => match call require_int(got.absent_input_count, 2, c, "absent-input-count")
                                            failed
                                            ok evidence absent_input_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m10_037: "m10-037" => ok test_case("dist/install-root", ["dist", "m10"], ["can-bun-archive"], 60000, [check_ref("refuse-needle"), check_ref("refuse-full"), check_ref("selection-empty"), check_ref("selection-ok"), check_ref("update-errors"), check_ref("root-first"), check_ref("gate-env"), check_ref("skip-note"), check_ref("absent-input-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m10-037"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("dist/install-root", ["dist", "m10"], ["can-bun-archive"], 60000, [check_ref("refuse-needle"), check_ref("refuse-full"), check_ref("selection-empty"), check_ref("selection-ok"), check_ref("update-errors"), check_ref("root-first"), check_ref("gate-env"), check_ref("skip-note"), check_ref("absent-input-count")], callable case_body)
