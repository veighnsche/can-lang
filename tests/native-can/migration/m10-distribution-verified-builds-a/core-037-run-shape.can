        "seed-root-probe-drift" => ok observation("context.Background", "os.Symlink", "os.Stat", "os.Readlink", "os.IsNotExist", "filepath.Abs", "t.TempDir", "wrong root refusal", "empty root selects", true, 4, 1)
        "seed-link-read-drift" => ok observation("context.Background", "os.Symlink", "os.Lstat", "os.ReadFile", "os.IsNotExist", "filepath.Abs", "t.TempDir", "wrong root refusal", "empty root selects", true, 4, 1)
        "seed-missing-kind-drift" => ok observation("context.Background", "os.Symlink", "os.Lstat", "os.Readlink", "os.IsExist", "filepath.Abs", "t.TempDir", "wrong root refusal", "empty root selects", true, 4, 1)
        "seed-abs-call-drift" => ok observation("context.Background", "os.Symlink", "os.Lstat", "os.Readlink", "os.IsNotExist", "filepath.Rel", "t.TempDir", "wrong root refusal", "empty root selects", true, 4, 1)
