fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("dist/install-root-run", "default", "", "offline") => ok
        seed_ctx_shape: context("dist/install-root-run", "seed-ctx-shape-drift", "", "offline") => failed{"ctx-shape"}
        seed_symlink_call: context("dist/install-root-run", "seed-symlink-call-drift", "", "offline") => failed{"symlink-call"}
        seed_root_probe: context("dist/install-root-run", "seed-root-probe-drift", "", "offline") => failed{"root-probe"}
        seed_link_read: context("dist/install-root-run", "seed-link-read-drift", "", "offline") => failed{"link-read"}
        seed_missing_kind: context("dist/install-root-run", "seed-missing-kind-drift", "", "offline") => failed{"missing-kind"}
        seed_abs_call: context("dist/install-root-run", "seed-abs-call-drift", "", "offline") => failed{"abs-call"}
        seed_temp_dir: context("dist/install-root-run", "seed-temp-dir-drift", "", "offline") => failed{"temp-dir"}
        seed_refuse_fatal: context("dist/install-root-run", "seed-refuse-fatal-drift", "", "offline") => failed{"refuse-fatal"}
        seed_empty_fatal: context("dist/install-root-run", "seed-empty-fatal-drift", "", "offline") => failed{"empty-fatal"}
        seed_parallel: context("dist/install-root-run", "seed-parallel-drift", "", "offline") => failed{"parallel"}
        seed_update_arity: context("dist/install-root-run", "seed-update-arity-drift", "", "offline") => failed{"update-arity"}
        seed_selection_arity: context("dist/install-root-run", "seed-selection-arity-drift", "", "offline") => failed{"selection-arity"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.ctx_shape, "context.Background", c, "ctx-shape")
            failed
            ok evidence ctx_shape_evidence => match call require_text(got.symlink_call, "os.Symlink", c, "symlink-call")
                failed
                ok evidence symlink_call_evidence => match call require_text(got.root_probe, "os.Lstat", c, "root-probe")
                    failed
                    ok evidence root_probe_evidence => match call require_text(got.link_read, "os.Readlink", c, "link-read")
                        failed
                        ok evidence link_read_evidence => match call require_text(got.missing_kind, "os.IsNotExist", c, "missing-kind")
                            failed
                            ok evidence missing_kind_evidence => match call require_text(got.abs_call, "filepath.Abs", c, "abs-call")
                                failed
                                ok evidence abs_call_evidence => match call require_text(got.temp_dir, "t.TempDir", c, "temp-dir")
                                    failed
                                    ok evidence temp_dir_evidence => match call require_text(got.refuse_fatal, "wrong root refusal", c, "refuse-fatal")
                                        failed
                                        ok evidence refuse_fatal_evidence => match call require_text(got.empty_fatal, "empty root selects", c, "empty-fatal")
                                            failed
                                            ok evidence empty_fatal_evidence => match call require_bool(got.parallel, true, c, "parallel")
                                                failed
                                                ok evidence parallel_evidence => match call require_int(got.update_arity, 4, c, "update-arity")
                                                    failed
                                                    ok evidence update_arity_evidence => match call require_int(got.selection_arity, 1, c, "selection-arity")
                                                        failed
                                                        ok evidence selection_arity_evidence => ok
