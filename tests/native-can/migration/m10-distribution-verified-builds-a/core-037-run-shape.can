package m10core037run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-037 "install root refusals: run shape, probe/call split".
/// Source: tests/integration/release_test.go symbol
/// TestInstallRootRefusals (L360-378).
/// Related fixtures: the Background ctx (L365), the Symlink-built link root
/// (L366-369), the Update refusal call (L371-374) and the Selection empty
/// call (L375-377).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production run shape of the refusal path: the
/// Background ctx, the symlink/tempdir fixture calls, the Lstat root probe
/// ahead of any read, the Readlink selection probe with IsNotExist absence,
/// the Abs normalization, the parallel leg, both entry arities, and the two
/// fatal renderings.
/// ADAPTATION (recorded, with source lines): Go pins no run exit or stream
/// bytes (both legs fail the test on any deviation at L373/L376), so this
/// file pins the invocation shape and fatal literals verbatim instead of
/// exit/stream facts; the roots-green pin lives in
/// core-037-roots-green.can and the refusal behaviors live in
/// core-037-root-semantics.can.
/// Variants: refusal path (Update errors), empty path (Selection "" nil).
/// Environment: CAN_BUN_ARCHIVE presence only; requires can-bun-archive.
/// Unlike TestReleaseInstallUpdate (L34) this symbol sets no darwin/arm64
/// gate. Logical gates SUITE/BUILD/ARCHIVE/ENV and C/R/N/S/A identities
/// bind at P23; no live run now. Descriptor timeout 60000ms is the harness
/// floor; Go L365 uses context.Background with no deadline.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case dist/install-root-run checks: ctx-shape, symlink-call, root-probe,
/// link-read, missing-kind, abs-call, temp-dir, refuse-fatal, empty-fatal,
/// parallel, update-arity, selection-arity.
/// Facet map (release_test.go legs + distribution roots): ctx-shape pins
/// context.Background (Go L365); symlink-call pins os.Symlink (Go L367);
/// root-probe pins os.Lstat (install.go L108); link-read pins os.Readlink
/// (install.go L97); missing-kind pins os.IsNotExist (install.go L98);
/// abs-call pins filepath.Abs (install.go L92); temp-dir pins t.TempDir
/// (Go L366); refuse-fatal pins wrong root refusal (Go L373); empty-fatal
/// pins empty root selects (Go L376); parallel pins t.Parallel (Go L361);
/// update-arity pins 4 (update.go L15); selection-arity pins 1
/// (install.go L91).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str ctx_shape
    str symlink_call
    str root_probe
    str link_read
    str missing_kind
    str abs_call
    str temp_dir
    str refuse_fatal
    str empty_fatal
    bool parallel
    int update_arity
    int selection_arity
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/install-root-run", "default", "", "offline"), "ctx-shape" => ok "case dist/install-root-run variant default root ctx-shape run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/install-root-run", "default", "", "offline"), "parallel" => ok evidence("parallel", "true", "true", true, "case dist/install-root-run variant default root parallel run offline")
        different: false, true, context("dist/install-root-run", "default", "", "offline"), "parallel" => failed{"parallel"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("dist/install-root-run", "default", "", "offline"), "update-arity" => ok evidence("update-arity", "4", "4", true, "case dist/install-root-run variant default root update-arity run offline")
        different: 3, 4, context("dist/install-root-run", "default", "", "offline"), "update-arity" => failed{"update-arity"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "context.Background", "context.Background", context("dist/install-root-run", "default", "", "offline"), "ctx-shape" => ok evidence("ctx-shape", "context.Background", "context.Background", true, "case dist/install-root-run variant default root ctx-shape run offline")
        different: "context.TODO", "context.Background", context("dist/install-root-run", "default", "", "offline"), "ctx-shape" => failed{"ctx-shape"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
