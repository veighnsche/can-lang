    emits {}
    given
        str scope
    asserts
        m10_037: "m10-037" => ok [check("ctx-shape", "refusal ctx is context.Background"), check("symlink-call", "link root is built with os.Symlink"), check("root-probe", "root check stats with os.Lstat"), check("link-read", "selection reads with os.Readlink"), check("missing-kind", "absence is classified with os.IsNotExist"), check("abs-call", "selection absolutizes with filepath.Abs"), check("temp-dir", "roots live under t.TempDir"), check("refuse-fatal", "refusal leg fails as wrong root refusal"), check("empty-fatal", "empty leg fails as empty root selects"), check("parallel", "refusal test runs parallel"), check("update-arity", "Update takes ctx plus three paths"), check("selection-arity", "Selection takes one root")]
        other: "nope" => ok []
    match scope is "m10-037"
        false => ok []
        true => ok [check("ctx-shape", "refusal ctx is context.Background"), check("symlink-call", "link root is built with os.Symlink"), check("root-probe", "root check stats with os.Lstat"), check("link-read", "selection reads with os.Readlink"), check("missing-kind", "absence is classified with os.IsNotExist"), check("abs-call", "selection absolutizes with filepath.Abs"), check("temp-dir", "roots live under t.TempDir"), check("refuse-fatal", "refusal leg fails as wrong root refusal"), check("empty-fatal", "empty leg fails as empty root selects"), check("parallel", "refusal test runs parallel"), check("update-arity", "Update takes ctx plus three paths"), check("selection-arity", "Selection takes one root")]
