package m10core046build
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-046 "bundled verified build: publication gates".
/// Source: tests/integration/verified_build_test.go symbol
/// TestCurrentBundledVerifiedBuild (L22-402); failing fixture
/// projects/failing-assertion/src/main.can (root wrong),
/// pending fixture projects/pending-assertion/src/main.can,
/// plus inline staged sources (uncovered L280, sticky L292,
/// vendor L307-313, live fetch L384-385).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): every publication gate and variant of
/// the verified build: the passing publish (current selects the
/// reported generation, production ships no assertions tree or
/// runner import), the never-publish legs (wrong assertion,
/// failed rebuild, any assert run, timeout, uncovered native,
/// sticky fixture, wrong vendor assertion), the locked-vendor
/// 4-root verification, the partial selected-assert scope, and
/// the offline-build/live-run HTTP counts, each with its
/// diagnostic or invocation needle.
/// ADAPTATION (recorded, with source lines): gate outcomes are
/// recorded as static bools and needles for P23 qualification;
/// the timeout leg pins the primary timed-out needle (L271)
/// with the timeout alternative noted (either matches); the
/// selected scope pins partial with passed true (L253-256);
/// dep roots pin 4/4/0 (L351); no execution is claimed here
/// (accept_after P23/QHTTP unmet).
/// Facet map (verified_build_test.go legs): publish-green pins
/// current selecting the reported generation (L155-157);
/// production-no-assertions pins the missing assertions tree
/// (L161-164); production-no-runner pins the absent runner
/// import (L169-171); wrong-never-publishes pins the nonzero
/// wrong-assert exit with no current (L180-186);
/// rebuild-keeps-current pins the unchanged current after a
/// failing rebuild (L196-202); assert-never-publishes pins the
/// untouched current across passing, selected and failing
/// assert runs (L239-266); timeout-never-publishes pins the
/// timed-out root blocking publication (L268-276);
/// uncovered-never-publishes pins the missing-coverage failure
/// with no staging (L278-288); sticky-never-publishes pins the
/// unused-fixture harness failure (L290-298);
/// vendor-roots-verified pins the locked 4-root dependency
/// publish (L336-356); vendor-wrong-never-publishes pins the
/// wrong vendor assertion blocking with current unchanged
/// (L360-369); build-offline pins zero live requests during
/// build (L389-393); run-live-once pins exactly one live
/// request on the published run (L397-401); fail-needle pins
/// build verification failed (L181); wrong-needle pins wrong
/// (L181); selected-scope pins partial (L254); timeout-needle
/// pins timed out (L271, alt timeout); coverage-needle pins
/// assert (L283); sticky-needle pins harness violation (L293);
/// vendor-needle pins double (L364); runner-import pins
/// assert/runner (L169); sandbox-tool pins
/// /usr/bin/sandbox-exec (L89); timeout-flag pins
/// --assert-timeout-ms (L270); dep-roots pins 4 (L351);
/// dep-passed pins 4 (L351); selected-arg-count pins the three
/// selector args (L249); assert-timeout-ms pins 1000 (L270);
/// build-requests pins 0 (L390); run-requests pins 1 (L398);
/// ctx-minutes pins 6 (L29).
/// The roots-green baseline lives in
/// core-046-roots-green.can; the production run shape lives in
/// core-046-run-shape.can.
/// Variants: passing, wrong assertion, failed rebuild,
/// selected assert, timeout, uncovered native, unused fixture,
/// locked vendor mutation, live fetch (all recorded above).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates
/// SUITE/BUILD/ENV/DIAG/HTTP and C/R/N/S/A identities bind at
/// P23; no live run now. Descriptor timeout 360000ms mirrors
/// the Go 6-minute ctx (L29).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case dist/verified-build checks: publish-green,
/// production-no-assertions, production-no-runner,
/// wrong-never-publishes, rebuild-keeps-current,
/// assert-never-publishes, timeout-never-publishes,
/// uncovered-never-publishes, sticky-never-publishes,
/// vendor-roots-verified, vendor-wrong-never-publishes,
/// build-offline, run-live-once, fail-needle, wrong-needle,
/// selected-scope, timeout-needle, coverage-needle,
/// sticky-needle, vendor-needle, runner-import, sandbox-tool,
/// timeout-flag, dep-roots, dep-passed, selected-arg-count,
/// assert-timeout-ms, build-requests, run-requests,
/// ctx-minutes.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool publish_green
    bool production_no_assertions
    bool production_no_runner
    bool wrong_never_publishes
    bool rebuild_keeps_current
    bool assert_never_publishes
    bool timeout_never_publishes
    bool uncovered_never_publishes
    bool sticky_never_publishes
    bool vendor_roots_verified
    bool vendor_wrong_never_publishes
    bool build_offline
    bool run_live_once
    str fail_needle
    str wrong_needle
    str selected_scope
    str timeout_needle
    str coverage_needle
    str sticky_needle
    str vendor_needle
    str runner_import
    str sandbox_tool
    str timeout_flag
    int dep_roots
    int dep_passed
    int selected_arg_count
    int assert_timeout_ms
    int build_requests
    int run_requests
    int ctx_minutes
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/verified-build", "default", "", "offline"), "publish-green" => ok "case dist/verified-build variant default root publish-green run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/verified-build", "default", "", "offline"), "publish-green" => ok evidence("publish-green", "true", "true", true, "case dist/verified-build variant default root publish-green run offline")
        different: false, true, context("dist/verified-build", "default", "", "offline"), "publish-green" => failed{"publish-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("dist/verified-build", "default", "", "offline"), "dep-roots" => ok evidence("dep-roots", "4", "4", true, "case dist/verified-build variant default root dep-roots run offline")
        different: 0, 4, context("dist/verified-build", "default", "", "offline"), "dep-roots" => failed{"dep-roots"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "build verification failed", "build verification failed", context("dist/verified-build", "default", "", "offline"), "fail-needle" => ok evidence("fail-needle", "build verification failed", "build verification failed", true, "case dist/verified-build variant default root fail-needle run offline")
        different: "build verification failed-other", "build verification failed", context("dist/verified-build", "default", "", "offline"), "fail-needle" => failed{"fail-needle"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, true, true, true, true, true, true, true, true, true, "build verification failed", "wrong", "partial", "timed out", "assert", "harness violation", "double", "assert/runner", "/usr/bin/sandbox-exec", "--assert-timeout-ms", 4, 4, 3, 1000, 0, 1, 6)
        seed_publish_green: "seed-publish-green-drift" => ok observation(false, true, true, true, true, true, true, true, true, true, true, true, true, "build verification failed", "wrong", "partial", "timed out", "assert", "harness violation", "double", "assert/runner", "/usr/bin/sandbox-exec", "--assert-timeout-ms", 4, 4, 3, 1000, 0, 1, 6)
