package m10core046run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M10 CORE-046 "bundled verified build: run shape, pinned current".
/// Source: tests/integration/verified_build_test.go symbol
/// TestCurrentBundledVerifiedBuild (L22-402); the runAt helper
/// (L75-103) with the sandbox profile (L77), cleared env (L91)
/// and run separator (L86-88); the current reader (L104-111).
/// Disposition: RETAIN (migrate row; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): production run shape of the published
/// generations. Every published run is silent by design (exit 0,
/// empty stdout and stderr), the restored run stays on the same
/// selection, the pinned generation keeps its manifest identity
/// and entry, and the sandbox invocation shape plus the live
/// fixture contract are pinned verbatim.
/// ADAPTATION (recorded, with source lines): per the accepted
/// CORE-014/019/040 precedent, the sandbox profile (L77), the
/// cleared PATH (L91), the live payload (L380) and the fixture
/// schema (L385) are pinned verbatim with source lines
/// recorded; the pinned-manifest binding records the
/// manifestSHA256 equality (L217); no execution is claimed here
/// (accept_after P23/QHTTP unmet).
/// The roots-green baseline lives in
/// core-046-roots-green.can; publication gates and needles live
/// in core-046-build-semantics.can.
/// Variants: ok path (published run, restored run), pinned
/// survival path (manifest identity, entry), invocation shape
/// (sandbox profile, env, separator, canlc path, env gate),
/// live contract path (payload count, fixture schema).
/// Environment: CAN_BUN_ARCHIVE + macOS sandbox-exec; requires
/// can-bun-archive, macos-sandbox-exec. Logical gates
/// SUITE/BUILD/ENV/HTTP and C/R/N/S/A identities bind at P23;
/// no live run now. Descriptor timeout 360000ms mirrors the Go
/// 6-minute ctx (L29).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case dist/verified-build-run checks: run-exit, live-count,
/// run-stdout-empty, run-stderr-empty, restored-run-green,
/// restored-keeps-current, old-generation-runs,
/// pinned-manifest-bound, pinned-entry-survives,
/// build-id-field, manifest-field, current-path, builds-dir,
/// manifest-name, sandbox-profile, offline-path,
/// run-separator, env-gate, canlc-path, fixture-schema,
/// live-body.
/// Facet map (verified_build_test.go legs): run-exit pins exit
/// 0 (L173); live-count pins the live payload count 7 (L380);
/// run-stdout-empty pins the silent stdout (L173);
/// run-stderr-empty pins the empty stderr (L173);
/// restored-run-green pins the silent restored run (L229-231);
/// restored-keeps-current pins the unchanged current after the
/// restored run (L232-234); old-generation-runs pins the leased
/// old generation still running (L188-189);
/// pinned-manifest-bound pins the manifest sha equality
/// (L217-219); pinned-entry-survives pins the surviving pinned
/// entry.ts (L220-222); build-id-field pins buildID (L123);
/// manifest-field pins manifestSHA256 (L207); current-path pins
/// dist/current.json (L106); builds-dir pins dist/builds (L161);
/// manifest-name pins manifest.json (L213); sandbox-profile
/// pins the invocation profile verbatim (L77); offline-path
/// pins the cleared environment (L91: PATH=/nonexistent
/// verbatim); run-separator pins -- (L86-88); env-gate pins
/// CAN_BUN_ARCHIVE (L24); canlc-path pins bin/canlc (L78);
/// fixture-schema pins can.native-fixture.v1 (L385); live-body
/// pins {"count":7} (L380).
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int run_exit
    int live_count
    bool run_stdout_empty
    bool run_stderr_empty
    bool restored_run_green
    bool restored_keeps_current
    bool old_generation_runs
    bool pinned_manifest_bound
    bool pinned_entry_survives
    str build_id_field
    str manifest_field
    str current_path
    str builds_dir
    str manifest_name
    str sandbox_profile
    str offline_path
    str run_separator
    str env_gate
    str canlc_path
    str fixture_schema
    str live_body
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("dist/verified-build-run", "default", "", "offline"), "run-stdout-empty" => ok "case dist/verified-build-run variant default root run-stdout-empty run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("dist/verified-build-run", "default", "", "offline"), "run-stdout-empty" => ok evidence("run-stdout-empty", "true", "true", true, "case dist/verified-build-run variant default root run-stdout-empty run offline")
        different: false, true, context("dist/verified-build-run", "default", "", "offline"), "run-stdout-empty" => failed{"run-stdout-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("dist/verified-build-run", "default", "", "offline"), "run-exit" => ok evidence("run-exit", "0", "0", true, "case dist/verified-build-run variant default root run-exit run offline")
        different: 1, 0, context("dist/verified-build-run", "default", "", "offline"), "run-exit" => failed{"run-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "buildID", "buildID", context("dist/verified-build-run", "default", "", "offline"), "build-id-field" => ok evidence("build-id-field", "buildID", "buildID", true, "case dist/verified-build-run variant default root build-id-field run offline")
        different: "buildID-other", "buildID", context("dist/verified-build-run", "default", "", "offline"), "build-id-field" => failed{"build-id-field"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
