package m11core049layout
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M11 CORE-049 "raw fixture staging: destination layout and inputs-not-scenarios".
/// Source: tests/integration/raw_fixtures_test.go symbol stageRawFixtures (lines 16-36).
/// Related fixtures: compiler/testdata/current/{fetch,native,templates,wrap}/fixtures.
/// Staged projects resolve using-raw rows from src/fixtures exactly as in real projects.
/// Disposition: REPLACE_SUPPORT. The Can slice ports the staging RULES, not the
/// bytes: which entries are selected, how rewrites apply, where they land.
/// Protects (this file): staged destination src/fixtures/<name>, entry names
/// preserved, static fixtures carry no assert/scenario semantics (inputs, not
/// scenarios), and no other paths written.
/// Entry selection lives in core-049-selection.can; ordered rewrite application
/// and byte preservation live in core-049-rewrite.can.
/// Variants: fetch and other current raw-fixture areas; URL relocation is a
/// rewrite-file facet, not this one.
/// Environment: none (no gates). Capabilities FILES/NATIVE/SUITE and the
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case raw-staging/layout checks: dest-dir, name-preserved,
/// no-assert-semantics, no-extra-writes.
/// Facet map: dest-dir pins the filepath.Join("src/fixtures", entry.Name())
/// destination (raw_fixtures_test.go:35); name-preserved pins the entry name
/// carried through unchanged; no-assert-semantics pins the row's
/// inputs-not-scenarios boundary (static fixture files remain inputs; Can
/// cases own scenarios, expectations, selection and reporting);
/// no-extra-writes pins that staging writes only src/fixtures/<name> via the
/// write callback (no sibling or stray paths).
/// BOUNDARY (not this row): the stripStagedAuthorization post-pass and
/// clearStagedFixtureEnvironments (same Go file) are out of scope; the Go
/// helper stays until its delete_when gates pass (retirement_eligible=false).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool dest_dir
    bool name_preserved
    bool no_assert_semantics
    bool no_extra_writes
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("raw-staging/layout", "default", "", "offline"), "dest-dir" => ok "case raw-staging/layout variant default root dest-dir run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("raw-staging/layout", "default", "", "offline"), "dest-dir" => ok evidence("dest-dir", "true", "true", true, "case raw-staging/layout variant default root dest-dir run offline")
        different: false, true, context("raw-staging/layout", "default", "", "offline"), "dest-dir" => failed{"dest-dir"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true)
        seed_wrong_dir: "seed-wrong-dir" => ok observation(false, true, true, true)
        seed_renamed: "seed-renamed" => ok observation(true, false, true, true)
        seed_assert_in_fixture: "seed-assert-in-fixture" => ok observation(true, true, false, true)
        seed_extra_write: "seed-extra-write" => ok observation(true, true, true, false)
        seed_nothing_staged: "seed-nothing-staged" => ok observation(false, false, true, true)
    match variant_id
        "seed-wrong-dir" => ok observation(false, true, true, true)
        "seed-renamed" => ok observation(true, false, true, true)
        "seed-assert-in-fixture" => ok observation(true, true, false, true)
        "seed-extra-write" => ok observation(true, true, true, false)
        "seed-nothing-staged" => ok observation(false, false, true, true)
        _ => ok observation(true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m11_049: "m11-049" => ok [check("dest-dir", "staged entries land under src/fixtures"), check("name-preserved", "entry names are preserved"), check("no-assert-semantics", "static fixtures carry no assert or scenario semantics"), check("no-extra-writes", "staging writes only src/fixtures/<name>")]
        other: "nope" => ok []
    match scope is "m11-049"
        false => ok []
        true => ok [check("dest-dir", "staged entries land under src/fixtures"), check("name-preserved", "entry names are preserved"), check("no-assert-semantics", "static fixtures carry no assert or scenario semantics"), check("no-extra-writes", "staging writes only src/fixtures/<name>")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "raw-staging/layout" => ok [expected_check("dest-dir", "true"), expected_check("name-preserved", "true"), expected_check("no-assert-semantics", "true"), expected_check("no-extra-writes", "true")]
        unknown: "nope" => ok []
    match case is "raw-staging/layout"
        false => ok []
        true => ok [expected_check("dest-dir", "true"), expected_check("name-preserved", "true"), expected_check("no-assert-semantics", "true"), expected_check("no-extra-writes", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("raw-staging/layout", "default", "", "offline") => ok
        seed_wrong_dir: context("raw-staging/layout", "seed-wrong-dir", "", "offline") => failed{"dest-dir"}
        seed_renamed: context("raw-staging/layout", "seed-renamed", "", "offline") => failed{"name-preserved"}
        seed_assert_in_fixture: context("raw-staging/layout", "seed-assert-in-fixture", "", "offline") => failed{"no-assert-semantics"}
        seed_extra_write: context("raw-staging/layout", "seed-extra-write", "", "offline") => failed{"no-extra-writes"}
        seed_nothing_staged: context("raw-staging/layout", "seed-nothing-staged", "", "offline") => failed{"dest-dir"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.dest_dir, true, c, "dest-dir")
            failed
            ok evidence dest_dir_evidence => match call require_bool(got.name_preserved, true, c, "name-preserved")
                failed
                ok evidence name_preserved_evidence => match call require_bool(got.no_assert_semantics, true, c, "no-assert-semantics")
                    failed
                    ok evidence no_assert_semantics_evidence => match call require_bool(got.no_extra_writes, true, c, "no-extra-writes")
                        failed
                        ok evidence no_extra_writes_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m11_049: "m11-049" => ok test_case("raw-staging/layout", ["staging", "m11", "fixtures"], [], 120000, [check_ref("dest-dir"), check_ref("name-preserved"), check_ref("no-assert-semantics"), check_ref("no-extra-writes")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m11-049"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("raw-staging/layout", ["staging", "m11", "fixtures"], [], 120000, [check_ref("dest-dir"), check_ref("name-preserved"), check_ref("no-assert-semantics"), check_ref("no-extra-writes")], callable case_body)
