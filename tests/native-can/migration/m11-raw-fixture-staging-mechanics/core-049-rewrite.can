package m11core049rewrite
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M11 CORE-049 "raw fixture staging: ordered rewrites, byte preservation, relocation".
/// Source: tests/integration/raw_fixtures_test.go symbol stageRawFixtures (lines 16-36).
/// Related fixtures: compiler/testdata/current/{fetch,native,templates,wrap}/fixtures.
/// Callers pass URL-relocation pairs such as [2]string{"http://127.0.0.1:1", server.URL}.
/// Disposition: REPLACE_SUPPORT. The Can slice ports the staging RULES, not the
/// bytes: which entries are selected, how rewrites apply, where they land.
/// Protects (this file): replacement pairs applied in order, only selected
/// origin/endpoint references rewritten, all other bytes identical, URL
/// relocation applied, committed sources left pristine.
/// Entry selection lives in core-049-selection.can; destination layout and the
/// inputs-not-scenarios boundary live in core-049-layout.can.
/// Variants: fetch and other current raw-fixture areas; URL relocation.
/// Environment: none (no gates). Capabilities FILES/NATIVE/SUITE and the
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case raw-staging/rewrite checks: pairs-ordered, only-selected,
/// bytes-identical, relocation, source-pristine.
/// Facet map: pairs-ordered pins the sequential ReplaceAll loop
/// (raw_fixtures_test.go:32-34); only-selected pins that just the passed
/// origin/endpoint pairs change; bytes-identical pins exact request/response
/// bytes elsewhere (exact request comparison stays meaningful); relocation pins
/// the committed placeholder origin rewritten to the test server URL;
/// source-pristine pins that replacements touch staged copies only (the
/// "staged copies only" contract in raw_fixtures_test.go:13-15).
/// BOUNDARY (not this row): the stripStagedAuthorization post-pass and
/// clearStagedFixtureEnvironments (same Go file) are out of scope; the Go
/// helper stays until its delete_when gates pass (retirement_eligible=false).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool pairs_ordered
    bool only_selected
    bool bytes_identical
    bool relocation
    bool source_pristine
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("raw-staging/rewrite", "default", "", "offline"), "pairs-ordered" => ok "case raw-staging/rewrite variant default root pairs-ordered run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("raw-staging/rewrite", "default", "", "offline"), "pairs-ordered" => ok evidence("pairs-ordered", "true", "true", true, "case raw-staging/rewrite variant default root pairs-ordered run offline")
        different: false, true, context("raw-staging/rewrite", "default", "", "offline"), "pairs-ordered" => failed{"pairs-ordered"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, true)
        seed_unordered: "seed-unordered" => ok observation(false, true, true, true, true)
        seed_over_rewrite: "seed-over-rewrite" => ok observation(true, false, false, true, true)
        seed_bytes_drift: "seed-bytes-drift" => ok observation(true, true, false, true, true)
        seed_relocation_missing: "seed-relocation-missing" => ok observation(true, true, true, false, true)
        seed_source_mutated: "seed-source-mutated" => ok observation(true, true, true, true, false)
    match variant_id
        "seed-unordered" => ok observation(false, true, true, true, true)
        "seed-over-rewrite" => ok observation(true, false, false, true, true)
        "seed-bytes-drift" => ok observation(true, true, false, true, true)
        "seed-relocation-missing" => ok observation(true, true, true, false, true)
        "seed-source-mutated" => ok observation(true, true, true, true, false)
        _ => ok observation(true, true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m11_049: "m11-049" => ok [check("pairs-ordered", "replacement pairs apply in order"), check("only-selected", "only selected origin/endpoint references change"), check("bytes-identical", "all other request/response bytes are identical"), check("relocation", "placeholder origin is relocated to the test server URL"), check("source-pristine", "committed fixture sources are untouched")]
        other: "nope" => ok []
    match scope is "m11-049"
        false => ok []
        true => ok [check("pairs-ordered", "replacement pairs apply in order"), check("only-selected", "only selected origin/endpoint references change"), check("bytes-identical", "all other request/response bytes are identical"), check("relocation", "placeholder origin is relocated to the test server URL"), check("source-pristine", "committed fixture sources are untouched")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "raw-staging/rewrite" => ok [expected_check("pairs-ordered", "true"), expected_check("only-selected", "true"), expected_check("bytes-identical", "true"), expected_check("relocation", "true"), expected_check("source-pristine", "true")]
        unknown: "nope" => ok []
    match case is "raw-staging/rewrite"
        false => ok []
        true => ok [expected_check("pairs-ordered", "true"), expected_check("only-selected", "true"), expected_check("bytes-identical", "true"), expected_check("relocation", "true"), expected_check("source-pristine", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("raw-staging/rewrite", "default", "", "offline") => ok
        seed_unordered: context("raw-staging/rewrite", "seed-unordered", "", "offline") => failed{"pairs-ordered"}
        seed_over_rewrite: context("raw-staging/rewrite", "seed-over-rewrite", "", "offline") => failed{"only-selected"}
        seed_bytes_drift: context("raw-staging/rewrite", "seed-bytes-drift", "", "offline") => failed{"bytes-identical"}
        seed_relocation_missing: context("raw-staging/rewrite", "seed-relocation-missing", "", "offline") => failed{"relocation"}
        seed_source_mutated: context("raw-staging/rewrite", "seed-source-mutated", "", "offline") => failed{"source-pristine"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.pairs_ordered, true, c, "pairs-ordered")
            failed
            ok evidence pairs_ordered_evidence => match call require_bool(got.only_selected, true, c, "only-selected")
                failed
                ok evidence only_selected_evidence => match call require_bool(got.bytes_identical, true, c, "bytes-identical")
                    failed
                    ok evidence bytes_identical_evidence => match call require_bool(got.relocation, true, c, "relocation")
                        failed
                        ok evidence relocation_evidence => match call require_bool(got.source_pristine, true, c, "source-pristine")
                            failed
                            ok evidence source_pristine_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m11_049: "m11-049" => ok test_case("raw-staging/rewrite", ["staging", "m11", "fixtures"], [], 120000, [check_ref("pairs-ordered"), check_ref("only-selected"), check_ref("bytes-identical"), check_ref("relocation"), check_ref("source-pristine")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m11-049"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("raw-staging/rewrite", ["staging", "m11", "fixtures"], [], 120000, [check_ref("pairs-ordered"), check_ref("only-selected"), check_ref("bytes-identical"), check_ref("relocation"), check_ref("source-pristine")], callable case_body)
