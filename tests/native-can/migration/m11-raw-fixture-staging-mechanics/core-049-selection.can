package m11core049selection
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M11 CORE-049 "raw fixture staging: selection (.json only, dirs skipped, required set)".
/// Source: tests/integration/raw_fixtures_test.go symbol stageRawFixtures (lines 16-36).
/// Related fixtures: compiler/testdata/current/{fetch,native,templates,wrap}/fixtures.
/// Callers: tests/integration/{fetch,templates,judge,native,questions,generation,wrap}_test.go.
/// Disposition: REPLACE_SUPPORT. The Can slice ports the staging RULES, not the
/// bytes: which entries are selected, how rewrites apply, where they land.
/// Protects (this file): only .json entries staged, directory entries skipped,
/// required fixture set preserved (none dropped), staged count pinned (fetch 9).
/// Ordered rewrite application and byte preservation live in
/// core-049-rewrite.can; destination layout and the inputs-not-scenarios
/// boundary live in core-049-layout.can.
/// Variants: fetch (default pin) and other current raw-fixture areas; URL
/// relocation is a rewrite-file facet, not this one.
/// Environment: none (no gates). Capabilities FILES/NATIVE/SUITE and the
/// C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case raw-staging/selection checks: json-only, dirs-skipped, required-set,
/// staged-count.
/// Facet map: json-only pins the `.json` suffix gate (raw_fixtures_test.go:24);
/// dirs-skipped pins the IsDir gate (same line); required-set pins that every
/// committed .json fixture is staged (no drops); staged-count pins 9 staged
/// entries on the fetch leg (9 committed .json files; the seed-wrong-area
/// variant stages templates' 2 to show the pin is non-vacuous).
/// BOUNDARY (not this row): the stripStagedAuthorization post-pass and
/// clearStagedFixtureEnvironments (same Go file) are out of scope; the Go
/// helper stays until its delete_when gates pass (retirement_eligible=false).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int staged_count
    bool json_only
    bool dirs_skipped
    bool required_set
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("raw-staging/selection", "default", "", "offline"), "json-only" => ok "case raw-staging/selection variant default root json-only run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("raw-staging/selection", "default", "", "offline"), "json-only" => ok evidence("json-only", "true", "true", true, "case raw-staging/selection variant default root json-only run offline")
        different: false, true, context("raw-staging/selection", "default", "", "offline"), "json-only" => failed{"json-only"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 9, 9, context("raw-staging/selection", "default", "", "offline"), "staged-count" => ok evidence("staged-count", "9", "9", true, "case raw-staging/selection variant default root staged-count run offline")
        different: 8, 9, context("raw-staging/selection", "default", "", "offline"), "staged-count" => failed{"staged-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(9, true, true, true)
        seed_nonjson_staged: "seed-nonjson-staged" => ok observation(10, false, true, true)
        seed_dir_staged: "seed-dir-staged" => ok observation(10, true, false, true)
        seed_dropped_fixture: "seed-dropped-fixture" => ok observation(8, true, true, false)
        seed_wrong_area: "seed-wrong-area" => ok observation(2, true, true, true)
    match variant_id
        "seed-nonjson-staged" => ok observation(10, false, true, true)
        "seed-dir-staged" => ok observation(10, true, false, true)
        "seed-dropped-fixture" => ok observation(8, true, true, false)
        "seed-wrong-area" => ok observation(2, true, true, true)
        _ => ok observation(9, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m11_049: "m11-049" => ok [check("json-only", "only .json entries are staged"), check("dirs-skipped", "directory entries are skipped"), check("required-set", "every committed .json fixture is staged"), check("staged-count", "staged count equals the committed fetch set (9)")]
        other: "nope" => ok []
    match scope is "m11-049"
        false => ok []
        true => ok [check("json-only", "only .json entries are staged"), check("dirs-skipped", "directory entries are skipped"), check("required-set", "every committed .json fixture is staged"), check("staged-count", "staged count equals the committed fetch set (9)")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "raw-staging/selection" => ok [expected_check("json-only", "true"), expected_check("dirs-skipped", "true"), expected_check("required-set", "true"), expected_check("staged-count", "9")]
        unknown: "nope" => ok []
    match case is "raw-staging/selection"
        false => ok []
        true => ok [expected_check("json-only", "true"), expected_check("dirs-skipped", "true"), expected_check("required-set", "true"), expected_check("staged-count", "9")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("raw-staging/selection", "default", "", "offline") => ok
        seed_nonjson_staged: context("raw-staging/selection", "seed-nonjson-staged", "", "offline") => failed{"json-only"}
        seed_dir_staged: context("raw-staging/selection", "seed-dir-staged", "", "offline") => failed{"dirs-skipped"}
        seed_dropped_fixture: context("raw-staging/selection", "seed-dropped-fixture", "", "offline") => failed{"required-set"}
        seed_wrong_area: context("raw-staging/selection", "seed-wrong-area", "", "offline") => failed{"staged-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.json_only, true, c, "json-only")
            failed
            ok evidence json_only_evidence => match call require_bool(got.dirs_skipped, true, c, "dirs-skipped")
                failed
                ok evidence dirs_skipped_evidence => match call require_bool(got.required_set, true, c, "required-set")
                    failed
                    ok evidence required_set_evidence => match call require_int(got.staged_count, 9, c, "staged-count")
                        failed
                        ok evidence staged_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m11_049: "m11-049" => ok test_case("raw-staging/selection", ["staging", "m11", "fixtures"], [], 120000, [check_ref("json-only"), check_ref("dirs-skipped"), check_ref("required-set"), check_ref("staged-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m11-049"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("raw-staging/selection", ["staging", "m11", "fixtures"], [], 120000, [check_ref("json-only"), check_ref("dirs-skipped"), check_ref("required-set"), check_ref("staged-count")], callable case_body)
