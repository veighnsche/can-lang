fn check[] checks
    emits {}
    given
        str scope
    asserts
        m12_b001: "m12-b001" => ok [check("env-gate", "staging gate reads CAN_BUN_ARCHIVE"), check("skip-needle", "unset archive skips with the staged-execution message"), check("ctx-timeout-min", "row context spans 8 minutes"), check("sandbox-profile", "offline invocation pins the deny-network profile"), check("offline-path", "offline legs clear PATH to /nonexistent"), check("canlc-bin", "offline invocation runs bin/canlc"), check("build-cmd", "build leg invokes canlc build"), check("report-passed-key", "assert report carries the passed key"), check("report-assertions-key", "assert report carries the assertions key"), check("report-evidence-key", "assert report carries the evidence key"), check("evidence-needle", "real assertions carry real-can evidence"), check("account-passed", "account-search assert report passes"), check("account-nonempty", "account-search asserts at least one root"), check("account-real", "account-search has a real-can evidence row"), check("forms-passed", "form-validation assert report passes"), check("forms-nonempty", "form-validation asserts at least one root"), check("forms-real", "form-validation has a real-can evidence row"), check("dashboard-passed", "dashboard assert report passes"), check("dashboard-nonempty", "dashboard asserts at least one root"), check("dashboard-real", "dashboard has a real-can evidence row"), check("native-passed", "native-ai assert report passes"), check("native-nonempty", "native-ai asserts at least one root"), check("native-real", "native-ai has a real-can evidence row")]
        other: "nope" => ok []
