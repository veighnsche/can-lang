        seed_env_gate: "seed-env-gate-drift" => ok observation("CAN_BUN_ARCHIVE_2", "set CAN_BUN_ARCHIVE for staged application execution", 8, "(version 1)(allow default)(deny network*)", "PATH=/nonexistent", "bin/canlc", "build", "passed", "assertions", "evidence", "real-can", true, true, true, true, true, true, true, true, true, true, true, true)
