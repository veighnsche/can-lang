package m12browser001apps
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-001 "staged applications: assert report semantics".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsStaged (L273-333); offline helper canlcOfflineArgs
/// (L99-117); build helper applicationBuildArgs (L124-138).
/// Disposition: migrate (this row ports TestApplicationsStaged to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the gated assert contract shared by all four
/// staged apps: the CAN_BUN_ARCHIVE gate plus its skip message, the
/// 8-minute context, the offline sandbox invocation shape, the build
/// command, the assert report keys plus the real-can evidence needle,
/// and the per-app report predicates (passed, at least one
/// assertion, at least one real-can row).
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (8) from 8*time.Minute (L280); offline-path cites both
/// legs sharing the literal (L105 assert/build, L324 usage); the
/// per-variant predicates mirror the loop body (L298/L310) as static
/// expectations, one load-bearing pin per behavior.
/// Facet map (applications_test.go legs): env-gate pins CAN_BUN_ARCHIVE
/// (L275); skip-needle pins the skip message (L277); ctx-timeout-min
/// pins 8 (L280); sandbox-profile pins the deny-network profile (L101);
/// offline-path pins PATH=/nonexistent (L105/L324); canlc-bin pins
/// bin/canlc (L101); build-cmd pins build (L121); report-passed-key,
/// report-assertions-key and report-evidence-key pin the report keys
/// (L293/L296/L295); evidence-needle pins real-can (L304); the twelve
/// per-variant pins mirror passed (L298), len assertions (L298) and
/// real count (L310) for each loop app (L286).
/// The roots-green pin lives in browser-001-roots-green.can; the
/// production build/usage shape lives in browser-001-run-shape.can.
/// Variants: account-search, form-validation, dashboard, native-ai
/// (the L286 loop, in order); each carries passed/nonempty/real.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates CAN/BUILD/PROC/WORK/SUITE and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 480000ms mirrors the Go
/// 8-minute ctx (L280).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case browser/apps checks: env-gate, skip-needle, ctx-timeout-min,
/// sandbox-profile, offline-path, canlc-bin, build-cmd,
/// report-passed-key, report-assertions-key, report-evidence-key,
/// evidence-needle, account-passed, account-nonempty, account-real,
/// forms-passed, forms-nonempty, forms-real, dashboard-passed,
/// dashboard-nonempty, dashboard-real, native-passed, native-nonempty,
/// native-real.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_gate
    str skip_needle
    int ctx_timeout_min
    str sandbox_profile
    str offline_path
    str canlc_bin
    str build_cmd
    str report_passed_key
    str report_assertions_key
    str report_evidence_key
    str evidence_needle
    bool account_passed
    bool account_nonempty
    bool account_real
    bool forms_passed
    bool forms_nonempty
    bool forms_real
    bool dashboard_passed
    bool dashboard_nonempty
    bool dashboard_real
    bool native_passed
    bool native_nonempty
    bool native_real
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/apps", "default", "", "offline"), "env-gate" => ok "case browser/apps variant default root env-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/apps", "default", "", "offline"), "account-passed" => ok evidence("account-passed", "true", "true", true, "case browser/apps variant default root account-passed run offline")
        different: false, true, context("browser/apps", "default", "", "offline"), "account-passed" => failed{"account-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 8, 8, context("browser/apps", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "8", "8", true, "case browser/apps variant default root ctx-timeout-min run offline")
        different: 7, 8, context("browser/apps", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("browser/apps", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case browser/apps variant default root env-gate run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("browser/apps", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
