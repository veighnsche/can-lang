package m12browser001run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-001 "staged applications: build/usage run shape".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsStaged (L273-333); build helper
/// applicationBuildArgs (L124-138); snapshot helpers snapshotCredential
/// (L140-144) and snapshotMap (L145-156).
/// Disposition: migrate (this row ports TestApplicationsStaged to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the production build/usage shape of each
/// staged app: exactly one build with a nonempty ID and directory,
/// the compiled entry.ts, the disposable UNUSED snapshot input passed
/// as one file, the zero-arg runtime/bun usage run printing the
/// usage: prefix with exit 0, and the 12-char staged log truncation.
/// ADAPTATION (recorded, with source lines): the usage contract is
/// HasPrefix (L328), so usage-prefix pins the "usage: " needle rather
/// than exact stdout; snapshot-name composes "snapshot-"+id (L142)
/// with name+".json" (L151) for id UNUSED (L317); build-short pins the
/// firstID[:12] log truncation (L331); snapshot-count pins the single
/// ExtraFiles entry (L325).
/// Facet map (applications_test.go legs): build-once pins one build
/// (L313-315); build-exit pins exit 0 (L127); build-id-key and
/// build-dir-key pin buildID/directory (L131-132); build-id-nonempty
/// and build-dir-nonempty pin the nonempty report (L134); entry-name
/// pins entry.ts (L316); snapshot-name, snapshot-key and snapshot-value
/// pin the disposable input (L142/L151/L317); snapshot-count pins one
/// snapshot file (L325); bun-entry pins runtime/bun (L322); usage-args
/// pins zero CLI args (L322); usage-prefix pins "usage: " (L328);
/// usage-exit pins exit 0 (L328); build-short pins 12 (L331).
/// The roots-green pin lives in browser-001-roots-green.can; report
/// semantics live in browser-001-apps-semantics.can.
/// Variants: the same four staged apps share one usage shape (a
/// single default case; per-app divergence is not pinned because Go
/// asserts the identical usage leg per loop app).
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates CAN/BUILD/PROC/WORK/SUITE and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 480000ms mirrors the Go
/// 8-minute ctx (L280).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case browser/apps-run checks: build-once, build-exit, build-id-key,
/// build-id-nonempty, build-dir-key, build-dir-nonempty, entry-name,
/// snapshot-name, snapshot-key, snapshot-value, snapshot-count,
/// bun-entry, usage-args, usage-prefix, usage-exit, build-short.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int build_once
    int build_exit
    str build_id_key
    bool build_id_nonempty
    str build_dir_key
    bool build_dir_nonempty
    str entry_name
    str snapshot_name
    str snapshot_key
    str snapshot_value
    int snapshot_count
    str bun_entry
    int usage_args
    str usage_prefix
    int usage_exit
    int build_short
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/apps-run", "default", "", "offline"), "build-once" => ok "case browser/apps-run variant default root build-once run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/apps-run", "default", "", "offline"), "build-id-nonempty" => ok evidence("build-id-nonempty", "true", "true", true, "case browser/apps-run variant default root build-id-nonempty run offline")
        different: false, true, context("browser/apps-run", "default", "", "offline"), "build-id-nonempty" => failed{"build-id-nonempty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("browser/apps-run", "default", "", "offline"), "build-once" => ok evidence("build-once", "1", "1", true, "case browser/apps-run variant default root build-once run offline")
        different: 2, 1, context("browser/apps-run", "default", "", "offline"), "build-once" => failed{"build-once"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "buildID", "buildID", context("browser/apps-run", "default", "", "offline"), "build-id-key" => ok evidence("build-id-key", "buildID", "buildID", true, "case browser/apps-run variant default root build-id-key run offline")
        different: "buildId", "buildID", context("browser/apps-run", "default", "", "offline"), "build-id-key" => failed{"build-id-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
