        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("browser/apps-run", ["browser", "m12"], ["can-bun-archive"], 480000, [check_ref("build-once"), check_ref("build-exit"), check_ref("build-id-key"), check_ref("build-id-nonempty"), check_ref("build-dir-key"), check_ref("build-dir-nonempty"), check_ref("entry-name"), check_ref("snapshot-name"), check_ref("snapshot-key"), check_ref("snapshot-value"), check_ref("snapshot-count"), check_ref("bun-entry"), check_ref("usage-args"), check_ref("usage-prefix"), check_ref("usage-exit"), check_ref("build-short")], callable case_body)
