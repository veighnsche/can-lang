package m12browser002forms
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-002 "staged forms: validation semantics".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsStagedForms (L335-404); GET leg (L381-384) plus
/// POST validation legs (L385-392).
/// Disposition: migrate (this row ports TestApplicationsStagedForms
/// to ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the staged form-validation contract over
/// HTTP: GET /signup answers 200 with the form controls, the pinned
/// HTMX/project assets and the same-origin CSP; POST
/// /signup/validate accepts the valid name/tags pair, rejects the
/// empty name with 422, and escapes hostile markup (script payload
/// keeps the escaped needle, bold payload never echoes raw).
/// ADAPTATION (recorded, with source lines): every body assertion is
/// Contains (L361-364/L375-378), so each needle pins the exact Go
/// snippet rather than full bodies; the CSP contract is Contains on
/// the header value (L382); the bold leg pins both the raw payload
/// and the absence predicate (L388: status 200 plus no raw echo);
/// the empty-name input ("") is mechanism, pinned via its 422 plus
/// the required message (L386).
/// Facet map (applications_test.go legs): get-path/get-status pin
/// the signup route (L381); form-id, form-action, form-indicator,
/// form-disable, htmx-asset and project-asset pin the six GET
/// needles (L381); csp-header/csp-needle pin the header contract
/// (L382); validate-path pins /signup/validate (L385); valid-status,
/// valid-needle, valid-name, valid-field-name, valid-field-tags,
/// valid-tag-a and valid-tag-b pin the valid leg (L385);
/// empty-status/empty-needle pin the 422 leg (L386);
/// hostile-script-status/hostile-script-needle/hostile-script-raw
/// pin the script leg (L387); hostile-bold-status/hostile-bold-raw/
/// hostile-bold-absent pin the bold leg (L388).
/// The serve baseline lives in browser-002-roots-green.can; the
/// unknown/wrong-method run shape lives in
/// browser-002-run-shape.can.
/// Variants: GET signup, valid/empty/hostile form (unknown route and
/// wrong method live in run-shape).
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates CAN/CHILD/HTTP/WIRE/BUILD/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. Descriptor timeout
/// 360000ms mirrors the Go 6-minute ctx (L342).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case browser/forms checks: get-path, get-status, form-id,
/// form-action, form-indicator, form-disable, htmx-asset,
/// project-asset, csp-header, csp-needle, validate-path,
/// valid-status, valid-needle, valid-name, valid-field-name,
/// valid-field-tags, valid-tag-a, valid-tag-b, empty-status,
/// empty-needle, hostile-script-status, hostile-script-needle,
/// hostile-script-raw, hostile-bold-status, hostile-bold-raw,
/// hostile-bold-absent.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str get_path
    int get_status
    str form_id
    str form_action
    str form_indicator
    str form_disable
    str htmx_asset
    str project_asset
    str csp_header
    str csp_needle
    str validate_path
    int valid_status
    str valid_needle
    str valid_name
    str valid_field_name
    str valid_field_tags
    str valid_tag_a
    str valid_tag_b
    int empty_status
    str empty_needle
    int hostile_script_status
    str hostile_script_needle
    str hostile_script_raw
    int hostile_bold_status
    str hostile_bold_raw
    bool hostile_bold_absent
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/forms", "default", "", "offline"), "get-path" => ok "case browser/forms variant default root get-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/forms", "default", "", "offline"), "hostile-bold-absent" => ok evidence("hostile-bold-absent", "true", "true", true, "case browser/forms variant default root hostile-bold-absent run offline")
        different: false, true, context("browser/forms", "default", "", "offline"), "hostile-bold-absent" => failed{"hostile-bold-absent"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("browser/forms", "default", "", "offline"), "get-status" => ok evidence("get-status", "200", "200", true, "case browser/forms variant default root get-status run offline")
        different: 201, 200, context("browser/forms", "default", "", "offline"), "get-status" => failed{"get-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/signup", "/signup", context("browser/forms", "default", "", "offline"), "get-path" => ok evidence("get-path", "/signup", "/signup", true, "case browser/forms variant default root get-path run offline")
        different: "/signup-2", "/signup", context("browser/forms", "default", "", "offline"), "get-path" => failed{"get-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("/signup", 200, "id=\"signup_form\"", "hx-post=\"/signup/validate\"", "hx-indicator", "hx-disable", "/__can/assets/htmx-4.0.0.min.js", "/__can/project/", "Content-Security-Policy", "script-src 'self'", "/signup/validate", 200, "Ann tags 2", "Ann", "name", "tags", "a", "b", 422, "Name is required.", 200, "&lt;script&gt;", "<script>window.__evil=1</script>", 200, "<b>Ann</b>", true)
        seed_get_path: "seed-get-path-drift" => ok observation("/signup-2", 200, "id=\"signup_form\"", "hx-post=\"/signup/validate\"", "hx-indicator", "hx-disable", "/__can/assets/htmx-4.0.0.min.js", "/__can/project/", "Content-Security-Policy", "script-src 'self'", "/signup/validate", 200, "Ann tags 2", "Ann", "name", "tags", "a", "b", 422, "Name is required.", 200, "&lt;script&gt;", "<script>window.__evil=1</script>", 200, "<b>Ann</b>", true)
