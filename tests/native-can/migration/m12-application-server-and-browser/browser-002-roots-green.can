package m12browser002roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-002 "staged forms: roots green, serve inventory".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsStagedForms (L335-404); serve helper
/// serveApplication (L176-228) plus requirePortFree (L166-174);
/// snapshot helpers snapshotCredential (L140-144) and snapshotMap
/// (L145-156).
/// Disposition: migrate (this row ports TestApplicationsStagedForms
/// to ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the staged serve baseline for the forms
/// leg: the CAN_BUN_ARCHIVE gate, the 6-minute context, the staged
/// form-validation app, the compiled entry.ts, the disposable UNUSED
/// snapshot input, and the serve shape (port 18531 on /signup over
/// loopback via runtime/bun with PATH cleared).
/// ADAPTATION (recorded, with source lines): the context timeout
/// pins int minutes (6) from 6*time.Minute (L342); snapshot-name
/// composes "snapshot-"+id (L142) with name+".json" (L151) for id
/// UNUSED (L350) since Go builds the name at runtime; serve-base
/// pins the "http://127.0.0.1:" prefix (L194) before the port; the
/// gate predicate (L338) pins empty-means-skip without a live run
/// (accept_after P23/QHTTP unmet).
/// Facet map (applications_test.go legs): env-gate pins
/// CAN_BUN_ARCHIVE (L337); skip-needle pins the skip message (L339);
/// archive-required pins empty-means-skip (L338); ctx-timeout-min
/// pins 6 (L342); app-forms pins form-validation (L348); entry-name
/// pins entry.ts (L351); snapshot-key/snapshot-value pin the
/// disposable input (L350); snapshot-name pins the composed file
/// (L142/L151/L350); serve-port pins 18531 (L351); ready-path pins
/// /signup (L351); serve-base pins the loopback prefix (L194);
/// serve-runtime pins runtime/bun (L184); offline-path pins
/// PATH=/nonexistent (L186).
/// Form validation semantics live in
/// browser-002-forms-semantics.can; the HTTP run shape lives in
/// browser-002-run-shape.can.
/// Variants: none in this file (default only); GET/POST/unknown/
/// wrong-method predicates live in forms-semantics and run-shape.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates CAN/CHILD/HTTP/WIRE/BUILD/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. The serve leg uses the
/// bundled runtime/bun (recorded mechanism, not waived). Descriptor
/// timeout 360000ms mirrors the Go 6-minute ctx (L342).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case browser/forms-roots checks: env-gate, skip-needle,
/// archive-required, ctx-timeout-min, app-forms, entry-name,
/// snapshot-key, snapshot-value, snapshot-name, serve-port,
/// ready-path, serve-base, serve-runtime, offline-path.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_gate
    str skip_needle
    bool archive_required
    int ctx_timeout_min
    str app_forms
    str entry_name
    str snapshot_key
    str snapshot_value
    str snapshot_name
    int serve_port
    str ready_path
    str serve_base
    str serve_runtime
    str offline_path
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/forms-roots", "default", "", "offline"), "env-gate" => ok "case browser/forms-roots variant default root env-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/forms-roots", "default", "", "offline"), "archive-required" => ok evidence("archive-required", "true", "true", true, "case browser/forms-roots variant default root archive-required run offline")
        different: false, true, context("browser/forms-roots", "default", "", "offline"), "archive-required" => failed{"archive-required"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("browser/forms-roots", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "6", "6", true, "case browser/forms-roots variant default root ctx-timeout-min run offline")
        different: 5, 6, context("browser/forms-roots", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("browser/forms-roots", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case browser/forms-roots variant default root env-gate run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("browser/forms-roots", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
