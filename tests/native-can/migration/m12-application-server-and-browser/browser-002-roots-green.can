    emits {}
    given
        str scope
    asserts
        m12_b002: "m12-b002" => ok test_case("browser/forms-roots", ["browser", "m12"], ["can-bun-archive"], 360000, [check_ref("env-gate"), check_ref("skip-needle"), check_ref("archive-required"), check_ref("ctx-timeout-min"), check_ref("app-forms"), check_ref("entry-name"), check_ref("snapshot-key"), check_ref("snapshot-value"), check_ref("snapshot-name"), check_ref("serve-port"), check_ref("ready-path"), check_ref("serve-base"), check_ref("serve-runtime"), check_ref("offline-path")], callable case_body)
