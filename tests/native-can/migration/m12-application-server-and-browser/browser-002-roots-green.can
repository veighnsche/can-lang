        seed_entry_name: context("browser/forms-roots", "seed-entry-name-drift", "", "offline") => failed{"entry-name"}
        seed_snapshot_key: context("browser/forms-roots", "seed-snapshot-key-drift", "", "offline") => failed{"snapshot-key"}
