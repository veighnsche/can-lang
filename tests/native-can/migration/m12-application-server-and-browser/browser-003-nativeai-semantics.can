package m12browser003nativeai
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-003 "stubbed native-ai: stage-gate semantics".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsNativeAIStubbed (L529-599); stub helper
/// stubProviders (L406-461); runner helper runEntry (L505-527).
/// Disposition: migrate (this row ports
/// TestApplicationsNativeAIStubbed to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted evidence).
/// Protects (this file): the three variant stage gates over separated
/// streams (exit 1, empty stdout, one typed stderr code each) plus the
/// env gate and the four raw request-envelope needles.
/// ADAPTATION (recorded, with source lines): the typed codes pin bare
/// (sql::connection_failed, llm::invalid_response, ai::invalid_answer)
/// while Go wraps each as an error-code Contains needle
/// (L551/L577/L589); stdout-empty pins the empty-stdout refusal (L551,
/// L577, L589); the context timeout pins int minutes (6) from
/// 6*time.Minute (L536).
/// Facet map (applications_test.go legs): env-gate pins CAN_BUN_ARCHIVE
/// (L531); skip-needle pins the skip message (L533); ctx-timeout-min
/// pins 6 (L536); refused-exit, refused-stdout-empty and refused-error
/// pin the refusal gate (L551); badplan-exit, badplan-stdout-empty and
/// badplan-error pin the bad-plan gate (L577); badanswers-exit,
/// badanswers-stdout-empty and badanswers-error pin the bad-answers
/// gate (L589); env-draft, env-pick, env-likely and env-rate pin the
/// instructions raw-body needles (L562).
/// The stub-roots pin lives in browser-003-roots-green.can; call order
/// plus the run shape live in browser-003-run-shape.can.
/// Variants: refusal, bad plan, bad answers (each carries its own
/// exit/stdout-empty/error gate in this file; modes flip at L574/L586).
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates CAN/PROC/HTTP/WIRE/FAULT/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. QHTTP is unmet (accept
/// gate). The stub legs additionally run compiled entry.ts under the
/// bundled runtime/bun (recorded mechanism, not waived). Descriptor
/// timeout 360000ms mirrors the Go 6-minute ctx (L536).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case browser/nativeai checks: env-gate, skip-needle,
/// ctx-timeout-min, refused-exit, refused-stdout-empty, refused-error,
/// badplan-exit, badplan-stdout-empty, badplan-error, badanswers-exit,
/// badanswers-stdout-empty, badanswers-error, env-draft, env-pick,
/// env-likely, env-rate.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_gate
    str skip_needle
    int ctx_timeout_min
    int refused_exit
    bool refused_stdout_empty
    str refused_error
    int badplan_exit
    bool badplan_stdout_empty
    str badplan_error
    int badanswers_exit
    bool badanswers_stdout_empty
    str badanswers_error
    str env_draft
    str env_pick
    str env_likely
    str env_rate
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/nativeai", "default", "", "offline"), "env-gate" => ok "case browser/nativeai variant default root env-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/nativeai", "default", "", "offline"), "refused-stdout-empty" => ok evidence("refused-stdout-empty", "true", "true", true, "case browser/nativeai variant default root refused-stdout-empty run offline")
        different: false, true, context("browser/nativeai", "default", "", "offline"), "refused-stdout-empty" => failed{"refused-stdout-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("browser/nativeai", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "6", "6", true, "case browser/nativeai variant default root ctx-timeout-min run offline")
        different: 5, 6, context("browser/nativeai", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("browser/nativeai", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case browser/nativeai variant default root env-gate run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("browser/nativeai", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
