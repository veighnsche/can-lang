    emits {}
    given
        str scope
    asserts
        m12_b003: "m12-b003" => ok [check("env-gate", "row gates on CAN_BUN_ARCHIVE"), check("skip-needle", "unset archive skips with the staged message"), check("ctx-timeout-min", "row context spans 6 minutes"), check("refused-exit", "refused run exits 1"), check("refused-stdout-empty", "refused run keeps stdout empty"), check("refused-error", "refused run surfaces sql::connection_failed"), check("badplan-exit", "bad plan run exits 1"), check("badplan-stdout-empty", "bad plan run keeps stdout empty"), check("badplan-error", "bad plan run surfaces llm::invalid_response"), check("badanswers-exit", "bad answers run exits 1"), check("badanswers-stdout-empty", "bad answers run keeps stdout empty"), check("badanswers-error", "bad answers run surfaces ai::invalid_answer"), check("env-draft", "stub sees the Draft instruction envelope"), check("env-pick", "stub sees the Pick instruction envelope"), check("env-likely", "stub sees the Likely instruction envelope"), check("env-rate", "stub sees the Rate instruction envelope")]
        other: "nope" => ok []
    match scope is "m12-b003"
        false => ok []
        true => ok [check("env-gate", "row gates on CAN_BUN_ARCHIVE"), check("skip-needle", "unset archive skips with the staged message"), check("ctx-timeout-min", "row context spans 6 minutes"), check("refused-exit", "refused run exits 1"), check("refused-stdout-empty", "refused run keeps stdout empty"), check("refused-error", "refused run surfaces sql::connection_failed"), check("badplan-exit", "bad plan run exits 1"), check("badplan-stdout-empty", "bad plan run keeps stdout empty"), check("badplan-error", "bad plan run surfaces llm::invalid_response"), check("badanswers-exit", "bad answers run exits 1"), check("badanswers-stdout-empty", "bad answers run keeps stdout empty"), check("badanswers-error", "bad answers run surfaces ai::invalid_answer"), check("env-draft", "stub sees the Draft instruction envelope"), check("env-pick", "stub sees the Pick instruction envelope"), check("env-likely", "stub sees the Likely instruction envelope"), check("env-rate", "stub sees the Rate instruction envelope")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "browser/nativeai" => ok [expected_check("env-gate", "CAN_BUN_ARCHIVE"), expected_check("skip-needle", "set CAN_BUN_ARCHIVE for staged application execution"), expected_check("ctx-timeout-min", "6"), expected_check("refused-exit", "1"), expected_check("refused-stdout-empty", "true"), expected_check("refused-error", "sql::connection_failed"), expected_check("badplan-exit", "1"), expected_check("badplan-stdout-empty", "true"), expected_check("badplan-error", "llm::invalid_response"), expected_check("badanswers-exit", "1"), expected_check("badanswers-stdout-empty", "true"), expected_check("badanswers-error", "ai::invalid_answer"), expected_check("env-draft", "\"instructions\":\"Draft\""), expected_check("env-pick", "\"instructions\":\"Pick\""), expected_check("env-likely", "\"instructions\":\"Likely\""), expected_check("env-rate", "\"instructions\":\"Rate\"")]
        unknown: "nope" => ok []
    match case is "browser/nativeai"
        false => ok []
        true => ok [expected_check("env-gate", "CAN_BUN_ARCHIVE"), expected_check("skip-needle", "set CAN_BUN_ARCHIVE for staged application execution"), expected_check("ctx-timeout-min", "6"), expected_check("refused-exit", "1"), expected_check("refused-stdout-empty", "true"), expected_check("refused-error", "sql::connection_failed"), expected_check("badplan-exit", "1"), expected_check("badplan-stdout-empty", "true"), expected_check("badplan-error", "llm::invalid_response"), expected_check("badanswers-exit", "1"), expected_check("badanswers-stdout-empty", "true"), expected_check("badanswers-error", "ai::invalid_answer"), expected_check("env-draft", "\"instructions\":\"Draft\""), expected_check("env-pick", "\"instructions\":\"Pick\""), expected_check("env-likely", "\"instructions\":\"Likely\""), expected_check("env-rate", "\"instructions\":\"Rate\"")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("browser/nativeai", "default", "", "offline") => ok
        seed_env_gate: context("browser/nativeai", "seed-env-gate-drift", "", "offline") => failed{"env-gate"}
        seed_skip_needle: context("browser/nativeai", "seed-skip-needle-drift", "", "offline") => failed{"skip-needle"}
        seed_ctx_timeout_min: context("browser/nativeai", "seed-ctx-timeout-min-drift", "", "offline") => failed{"ctx-timeout-min"}
        seed_refused_exit: context("browser/nativeai", "seed-refused-exit-drift", "", "offline") => failed{"refused-exit"}
        seed_refused_stdout_empty: context("browser/nativeai", "seed-refused-stdout-empty-drift", "", "offline") => failed{"refused-stdout-empty"}
        seed_refused_error: context("browser/nativeai", "seed-refused-error-drift", "", "offline") => failed{"refused-error"}
        seed_badplan_exit: context("browser/nativeai", "seed-badplan-exit-drift", "", "offline") => failed{"badplan-exit"}
        seed_badplan_stdout_empty: context("browser/nativeai", "seed-badplan-stdout-empty-drift", "", "offline") => failed{"badplan-stdout-empty"}
        seed_badplan_error: context("browser/nativeai", "seed-badplan-error-drift", "", "offline") => failed{"badplan-error"}
        seed_badanswers_exit: context("browser/nativeai", "seed-badanswers-exit-drift", "", "offline") => failed{"badanswers-exit"}
        seed_badanswers_stdout_empty: context("browser/nativeai", "seed-badanswers-stdout-empty-drift", "", "offline") => failed{"badanswers-stdout-empty"}
        seed_badanswers_error: context("browser/nativeai", "seed-badanswers-error-drift", "", "offline") => failed{"badanswers-error"}
        seed_env_draft: context("browser/nativeai", "seed-env-draft-drift", "", "offline") => failed{"env-draft"}
        seed_env_pick: context("browser/nativeai", "seed-env-pick-drift", "", "offline") => failed{"env-pick"}
        seed_env_likely: context("browser/nativeai", "seed-env-likely-drift", "", "offline") => failed{"env-likely"}
        seed_env_rate: context("browser/nativeai", "seed-env-rate-drift", "", "offline") => failed{"env-rate"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.env_gate, "CAN_BUN_ARCHIVE", c, "env-gate")
            failed
            ok evidence env_gate_evidence => match call require_text(got.skip_needle, "set CAN_BUN_ARCHIVE for staged application execution", c, "skip-needle")
                failed
                ok evidence skip_needle_evidence => match call require_int(got.ctx_timeout_min, 6, c, "ctx-timeout-min")
                    failed
                    ok evidence ctx_timeout_min_evidence => match call require_int(got.refused_exit, 1, c, "refused-exit")
                        failed
