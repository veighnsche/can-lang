fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("browser/nativeai-roots", "default", "", "offline") => ok
        seed_req_method: context("browser/nativeai-roots", "seed-req-method-drift", "", "offline") => failed{"req-method"}
        seed_auth_header: context("browser/nativeai-roots", "seed-auth-header-drift", "", "offline") => failed{"auth-header"}
        seed_bearer_scheme: context("browser/nativeai-roots", "seed-bearer-scheme-drift", "", "offline") => failed{"bearer-scheme"}
        seed_content_header: context("browser/nativeai-roots", "seed-content-header-drift", "", "offline") => failed{"content-header"}
        seed_content_json: context("browser/nativeai-roots", "seed-content-json-drift", "", "offline") => failed{"content-json"}
        seed_header_diag: context("browser/nativeai-roots", "seed-header-diag-drift", "", "offline") => failed{"header-diag"}
        seed_mode_ok: context("browser/nativeai-roots", "seed-mode-ok-drift", "", "offline") => failed{"mode-ok"}
        seed_mode_badplan: context("browser/nativeai-roots", "seed-mode-badplan-drift", "", "offline") => failed{"mode-badplan"}
        seed_mode_badanswers: context("browser/nativeai-roots", "seed-mode-badanswers-drift", "", "offline") => failed{"mode-badanswers"}
        seed_app_native: context("browser/nativeai-roots", "seed-app-native-drift", "", "offline") => failed{"app-native"}
        seed_oracle_src: context("browser/nativeai-roots", "seed-oracle-src-drift", "", "offline") => failed{"oracle-src"}
        seed_oracle_fixtures: context("browser/nativeai-roots", "seed-oracle-fixtures-drift", "", "offline") => failed{"oracle-fixtures"}
        seed_rewrite_from: context("browser/nativeai-roots", "seed-rewrite-from-drift", "", "offline") => failed{"rewrite-from"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.req_method, "POST", c, "req-method")
            failed
            ok evidence req_method_evidence => match call require_text(got.auth_header, "Authorization", c, "auth-header")
                failed
                ok evidence auth_header_evidence => match call require_text(got.bearer_scheme, "Bearer ", c, "bearer-scheme")
                    failed
                    ok evidence bearer_scheme_evidence => match call require_text(got.content_header, "Content-Type", c, "content-header")
                        failed
                        ok evidence content_header_evidence => match call require_text(got.content_json, "application/json", c, "content-json")
                            failed
                            ok evidence content_json_evidence => match call require_text(got.header_diag, "invalid provider request headers", c, "header-diag")
                                failed
                                ok evidence header_diag_evidence => match call require_text(got.mode_ok, "ok", c, "mode-ok")
                                    failed
                                    ok evidence mode_ok_evidence => match call require_text(got.mode_badplan, "bad-plan", c, "mode-badplan")
                                        failed
                                        ok evidence mode_badplan_evidence => match call require_text(got.mode_badanswers, "bad-answers", c, "mode-badanswers")
                                            failed
                                            ok evidence mode_badanswers_evidence => match call require_text(got.app_native, "native-ai", c, "app-native")
                                                failed
                                                ok evidence app_native_evidence => match call require_text(got.oracle_src, "src/oracles/oracles.can", c, "oracle-src")
                                                    failed
                                                    ok evidence oracle_src_evidence => match call require_text(got.oracle_fixtures, "src/oracles/fixtures", c, "oracle-fixtures")
                                                        failed
                                                        ok evidence oracle_fixtures_evidence => match call require_text(got.rewrite_from, "http://127.0.0.1:1", c, "rewrite-from")
                                                            failed
                                                            ok evidence rewrite_from_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m12_b003: "m12-b003" => ok test_case("browser/nativeai-roots", ["browser", "m12"], ["can-bun-archive"], 360000, [check_ref("req-method"), check_ref("auth-header"), check_ref("bearer-scheme"), check_ref("content-header"), check_ref("content-json"), check_ref("header-diag"), check_ref("mode-ok"), check_ref("mode-badplan"), check_ref("mode-badanswers"), check_ref("app-native"), check_ref("oracle-src"), check_ref("oracle-fixtures"), check_ref("rewrite-from")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m12-b003"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("browser/nativeai-roots", ["browser", "m12"], ["can-bun-archive"], 360000, [check_ref("req-method"), check_ref("auth-header"), check_ref("bearer-scheme"), check_ref("content-header"), check_ref("content-json"), check_ref("header-diag"), check_ref("mode-ok"), check_ref("mode-badplan"), check_ref("mode-badanswers"), check_ref("app-native"), check_ref("oracle-src"), check_ref("oracle-fixtures"), check_ref("rewrite-from")], callable case_body)
