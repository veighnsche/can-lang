package m12browser003roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-003 "stubbed native-ai: stub roots green".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsNativeAIStubbed (L529-599); stub helper
/// stubProviders (L406-461); rewrite helpers rewriteEndpoints
/// (L490-503) and rewriteFixtureEndpoints (L466-488).
/// Disposition: migrate (this row ports
/// TestApplicationsNativeAIStubbed to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted evidence).
/// Protects (this file): the stub-provider roots green: the POST
/// method, the Authorization/Content-Type header contract, the
/// application/json media type, the invalid-headers diagnostic, the
/// three stub modes, the staged native-ai app, and the oracle
/// endpoint-rewrite roots (source, fixtures, loopback placeholder).
/// SECRET POLICY (binding): the L430 Authorization check pins the
/// "Authorization" field name plus the "Bearer " scheme prefix only;
/// the credential token bytes are never pinned, quoted, or rendered
/// here, and authored files assert zero occurrences of those bytes
/// (verified programmatically with counts only, never printed).
/// Facet map (applications_test.go legs): req-method pins POST (L430);
/// auth-header pins Authorization (L430); bearer-scheme pins the
/// Bearer scheme prefix (L430); content-header pins Content-Type
/// (L430); content-json pins application/json (L430/L457);
/// header-diag pins the invalid-headers diagnostic (L431); mode-ok
/// pins ok (L423); mode-badplan pins bad-plan (L446/L574);
/// mode-badanswers pins bad-answers (L451/L586); app-native pins
/// native-ai (L544); oracle-src pins src/oracles/oracles.can (L545);
/// oracle-fixtures pins src/oracles/fixtures (L546); rewrite-from pins
/// http://127.0.0.1:1 (L545/L546).
/// Stage gates and typed errors plus envelope needles live in
/// browser-003-nativeai-semantics.can; call order plus the run shape
/// live in browser-003-run-shape.can.
/// Variants: none in this file (default only); refusal, bad plan and
/// bad answers select stub modes whose gates live in semantics/run.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates CAN/PROC/HTTP/WIRE/FAULT/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. QHTTP is unmet (accept
/// gate). The stub legs additionally run compiled entry.ts under the
/// bundled runtime/bun (recorded mechanism, not waived). Descriptor
/// timeout 360000ms mirrors the Go 6-minute ctx (L536).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case browser/nativeai-roots checks: req-method, auth-header,
/// bearer-scheme, content-header, content-json, header-diag, mode-ok,
/// mode-badplan, mode-badanswers, app-native, oracle-src,
/// oracle-fixtures, rewrite-from.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str req_method
    str auth_header
    str bearer_scheme
    str content_header
    str content_json
    str header_diag
    str mode_ok
    str mode_badplan
    str mode_badanswers
    str app_native
    str oracle_src
    str oracle_fixtures
    str rewrite_from
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/nativeai-roots", "default", "", "offline"), "req-method" => ok "case browser/nativeai-roots variant default root req-method run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/nativeai-roots", "default", "", "offline"), "req-method" => ok evidence("req-method", "true", "true", true, "case browser/nativeai-roots variant default root req-method run offline")
        different: false, true, context("browser/nativeai-roots", "default", "", "offline"), "req-method" => failed{"req-method"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("browser/nativeai-roots", "default", "", "offline"), "req-method" => ok evidence("req-method", "1", "1", true, "case browser/nativeai-roots variant default root req-method run offline")
        different: 0, 1, context("browser/nativeai-roots", "default", "", "offline"), "req-method" => failed{"req-method"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "POST", "POST", context("browser/nativeai-roots", "default", "", "offline"), "req-method" => ok evidence("req-method", "POST", "POST", true, "case browser/nativeai-roots variant default root req-method run offline")
        different: "GET", "POST", context("browser/nativeai-roots", "default", "", "offline"), "req-method" => failed{"req-method"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
