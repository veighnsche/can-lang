    emits {}
    given
        str scope
    asserts
        m12_b003: "m12-b003" => ok [check("req-method", "stub requires POST provider requests"), check("auth-header", "stub checks the Authorization header field"), check("bearer-scheme", "stub requires the Bearer authorization scheme"), check("content-header", "stub checks the Content-Type header field"), check("content-json", "provider legs use application/json"), check("header-diag", "bad provider headers raise the headers diagnostic"), check("mode-ok", "stub starts in ok mode"), check("mode-badplan", "stub bad-plan mode selects the empty plan"), check("mode-badanswers", "stub bad-answers mode selects the bad judgment"), check("app-native", "row stages the native-ai app"), check("oracle-src", "endpoint rewrite covers the oracles source"), check("oracle-fixtures", "endpoint rewrite covers the oracles fixtures"), check("rewrite-from", "endpoint rewrite replaces the loopback placeholder")]
        other: "nope" => ok []
    match scope is "m12-b003"
        false => ok []
        true => ok [check("req-method", "stub requires POST provider requests"), check("auth-header", "stub checks the Authorization header field"), check("bearer-scheme", "stub requires the Bearer authorization scheme"), check("content-header", "stub checks the Content-Type header field"), check("content-json", "provider legs use application/json"), check("header-diag", "bad provider headers raise the headers diagnostic"), check("mode-ok", "stub starts in ok mode"), check("mode-badplan", "stub bad-plan mode selects the empty plan"), check("mode-badanswers", "stub bad-answers mode selects the bad judgment"), check("app-native", "row stages the native-ai app"), check("oracle-src", "endpoint rewrite covers the oracles source"), check("oracle-fixtures", "endpoint rewrite covers the oracles fixtures"), check("rewrite-from", "endpoint rewrite replaces the loopback placeholder")]
