package m12browser003run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-003 "stubbed native-ai: call order and run shape".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsNativeAIStubbed (L529-599); runner helper runEntry
/// (L505-527); snapshot helper snapshotMap (L145-156).
/// Disposition: migrate (this row ports
/// TestApplicationsNativeAIStubbed to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted evidence).
/// Protects (this file): the stub call order and cumulative counts per
/// variant (2 then 3 then 5 with the exact path at each position) plus
/// the compiled-CLI run shape: the triage-refused snapshot keys, the
/// single snapshot file, the Ann argument, entry.ts, runtime/bun and
/// the cleared PATH.
/// SINGLE PIN SITE (recorded): /responses and /systemone pin ONLY in
/// this file as ordered calls (L555/L581/L595); the stub-serve lines
/// (L439/L449) are cited as mechanism, never re-pinned. Snapshot-name
/// composes "triage-refused" (L549) with name plus .json (L151);
/// snapshot VALUES are never pinned (key names only); the token value
/// bytes assert zero occurrences in authored files (counts only, never
/// printed). Snapshot-count pins the single ExtraFiles entry (L515).
/// Facet map (applications_test.go legs): refused-calls pins 2 (L555);
/// call-first and call-second pin /responses then /systemone (L555);
/// badplan-calls pins 3 (L581); badplan-third pins /responses (L581);
/// badanswers-calls pins 5 (L595); badanswers-fourth and
/// badanswers-fifth pin /responses then /systemone (L595);
/// snapshot-name, snapshot-key-triage and snapshot-key-token pin the
/// refused input (L549/L151); snapshot-count pins one file (L515);
/// run-arg pins Ann (L550); entry-name pins entry.ts (L548);
/// bun-entry pins runtime/bun (L512); offline-path pins
/// PATH=/nonexistent (L514).
/// The stub-roots pin lives in browser-003-roots-green.can; stage gates
/// plus envelope needles live in browser-003-nativeai-semantics.can.
/// Variants: refusal (2 calls), bad plan (3 calls), bad answers (5
/// calls); counts are cumulative across the three runEntry legs.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates CAN/PROC/HTTP/WIRE/FAULT/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. QHTTP is unmet (accept
/// gate). Descriptor timeout 360000ms mirrors the Go 6-minute ctx
/// (L536).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QHTTP unmet).
/// Case browser/nativeai-run checks: refused-calls, call-first,
/// call-second, badplan-calls, badplan-third, badanswers-calls,
/// badanswers-fourth, badanswers-fifth, snapshot-name,
/// snapshot-key-triage, snapshot-key-token, snapshot-count, run-arg,
/// entry-name, bun-entry, offline-path.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int refused_calls
    str call_first
    str call_second
    int badplan_calls
    str badplan_third
    int badanswers_calls
    str badanswers_fourth
    str badanswers_fifth
    str snapshot_name
    str snapshot_key_triage
    str snapshot_key_token
    int snapshot_count
    str run_arg
    str entry_name
    str bun_entry
    str offline_path
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/nativeai-run", "default", "", "offline"), "refused-calls" => ok "case browser/nativeai-run variant default root refused-calls run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/nativeai-run", "default", "", "offline"), "refused-calls" => ok evidence("refused-calls", "true", "true", true, "case browser/nativeai-run variant default root refused-calls run offline")
        different: false, true, context("browser/nativeai-run", "default", "", "offline"), "refused-calls" => failed{"refused-calls"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("browser/nativeai-run", "default", "", "offline"), "refused-calls" => ok evidence("refused-calls", "2", "2", true, "case browser/nativeai-run variant default root refused-calls run offline")
        different: 1, 2, context("browser/nativeai-run", "default", "", "offline"), "refused-calls" => failed{"refused-calls"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
