        str expected
        context c
        str check
    asserts
        same: "/responses", "/responses", context("browser/nativeai-run", "default", "", "offline"), "call-first" => ok evidence("call-first", "/responses", "/responses", true, "case browser/nativeai-run variant default root call-first run offline")
        different: "/responses-2", "/responses", context("browser/nativeai-run", "default", "", "offline"), "call-first" => failed{"call-first"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
