package m12browser004live
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-004 "live applications: HTTP live semantics".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsLive (L601-770); seed helper applicationSeed
/// (L252-271); serve helper serveApplication (L176-228).
/// Disposition: migrate (this row ports TestApplicationsLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the gated live HTTP contract of the
/// accounts and dashboard legs: both environment gates plus their
/// skip messages, the 10-minute context, the accounts page/search
/// needles, the hostile-query escaped/absent pair, the three
/// malformed probes plus their 422 needle, the validate ok/blank
/// pair, the summary/unknown/wrong-method routes, the dropped-table
/// 503 pair shared by both legs, and the dashboard page/data
/// needles.
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (10) from 10*time.Minute (L611); the hx needles pin
/// the backtick contents (L636/L704); the hostile-absent pin names
/// the forbidden literal (L646) whose assertion is absence; the
/// wrong-method leg reuses the search-path literal (L677); the
/// dropped pair covers both the accounts (L687) and dashboard (L715)
/// legs.
/// Facet map (applications_test.go legs): env-gate pins
/// CAN_BUN_ARCHIVE (L602); skip-needle pins the skip message (L604);
/// db-gate pins CAN_TEST_POSTGRES_URL (L606); db-skip-needle pins
/// the live-checks skip (L608); ctx-timeout-min pins 10 (L611);
/// accounts-page-status/needle/trigger pin the accounts page
/// (L636); search-path/status/needle/item pin search Ann
/// (L639/L641); hostile-path plus hostile-escaped/absent pin the
/// hostile query (L644/L646); search-probe-count plus the three
/// probe paths plus probe-status/needle pin the malformed probes
/// (L649/L652); validate-path plus ok/blank status/needles pin
/// validation (L656/L658/L661/L663); summary-path/status pin the
/// summary leg (L666/L668); missing-path plus unknown-route-status
/// pin the unknown route (L671/L673); wrong-method-status pins 405
/// (L680); dropped-status/needle pin the outage pair (L687/L715);
/// dashboard-page-status/needle/trigger pin the dashboard page
/// (L704); dashboard-data-path/status/needle pin the data leg
/// (L707/L709).
/// Seed/reseed inventory lives in browser-004-roots-green.can; the
/// triage run shape lives in browser-004-run-shape.can.
/// Variants: account-search and dashboard HTTP legs here (triage in
/// run-shape); dropped-table and hostile input via the dropped and
/// hostile/probe pins.
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates CAN/BUILD/PROC/WORK/SUITE and C/R/N/S/A identities
/// bind at P23; no live run now. Descriptor timeout 600000ms
/// mirrors the Go 10-minute ctx (L611).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case browser/live checks: env-gate, skip-needle, db-gate,
/// db-skip-needle, ctx-timeout-min, accounts-page-status,
/// accounts-page-needle, accounts-page-trigger, search-path,
/// search-ok-status, search-ok-needle, search-ok-item,
/// hostile-path, search-hostile-escaped, search-hostile-absent,
/// search-probe-count, search-probe-first, search-probe-bare,
/// search-probe-dup, search-probe-status, search-probe-needle,
/// validate-path, validate-ok-status, validate-ok-needle,
/// validate-blank-status, validate-blank-needle, summary-path,
/// summary-status, missing-path, unknown-route-status,
/// wrong-method-status, dropped-status, dropped-needle,
/// dashboard-page-status, dashboard-page-needle,
/// dashboard-page-trigger, dashboard-data-path,
/// dashboard-data-status, dashboard-data-needle.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_gate
    str skip_needle
    str db_gate
    str db_skip_needle
    int ctx_timeout_min
    int accounts_page_status
    str accounts_page_needle
    str accounts_page_trigger
    str search_path
    int search_ok_status
    str search_ok_needle
    str search_ok_item
    str hostile_path
    str search_hostile_escaped
    str search_hostile_absent
    int search_probe_count
    str search_probe_first
    str search_probe_bare
    str search_probe_dup
    int search_probe_status
    str search_probe_needle
    str validate_path
    int validate_ok_status
    str validate_ok_needle
    int validate_blank_status
    str validate_blank_needle
    str summary_path
    int summary_status
    str missing_path
    int unknown_route_status
    int wrong_method_status
    int dropped_status
    str dropped_needle
    int dashboard_page_status
    str dashboard_page_needle
    str dashboard_page_trigger
    str dashboard_data_path
    int dashboard_data_status
    str dashboard_data_needle
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/live", "default", "", "offline"), "env-gate" => ok "case browser/live variant default root env-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/live", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "true", "true", true, "case browser/live variant default root env-gate run offline")
        different: false, true, context("browser/live", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("browser/live", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "10", "10", true, "case browser/live variant default root ctx-timeout-min run offline")
        different: 11, 10, context("browser/live", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("browser/live", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case browser/live variant default root env-gate run offline")
        different: "CAN_BUN_ARCHIVE-2", "CAN_BUN_ARCHIVE", context("browser/live", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for staged application execution", "CAN_TEST_POSTGRES_URL", "set CAN_TEST_POSTGRES_URL to a disposable PostgreSQL for live application checks", 10, 200, "hx-get=\"/accounts/search\"", "hx-trigger=\"change\"", "/accounts/search?query=Ann", 200, "Ann", "<li>", "/accounts/search?query=%3Cem%3E", "&lt;em&gt;", "<em>Hax</em>", 3, "/accounts/search?query=", "/accounts/search", "/accounts/search?query=a&query=b", 422, "Enter a search term.", "/accounts/validate", 200, "Ann", 422, "Name is required.", "/dashboard/summary", 200, "/missing", 404, 405, 503, "Temporarily unavailable.", 200, "hx-get=\"/dashboard/data\"", "hx-trigger=\"every 5000ms\"", "/dashboard/data", 200, "3 accounts 3 recent")
