package m12browser004roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-004 "live applications: roots green, seed inventory".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsLive (L601-770); seed helper applicationSeed
/// (L252-271); snapshot helpers snapshotCredential (L140-144) and
/// snapshotMap (L145-156); rewrite helpers rewriteEndpoints
/// (L490-503) and rewriteFixtureEndpoints (L466-488).
/// Disposition: migrate (this row ports TestApplicationsLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): static live inventory as the green
/// baseline: the seed SQL plus driver paths, the bun runner, the
/// setup/teardown modes, the seed row counts, the seed report keys,
/// the seed database-URL env prefix, the three staged app names,
/// the snapshot names/keys plus the test-only token, the serve
/// ports plus ready paths, and the triage endpoint rewrite triple.
/// ADAPTATION (recorded, with source lines): the Go seed counts are
/// JSON floats (7.0/3.0/2.0, L623), pinned here as int 7/3/2; the
/// seed-env-prefix pins the "CAN_TEST_POSTGRES_URL=" assignment
/// prefix (L258); the triage token pins the dummy test-only value
/// (L731), never a real credential; the stub provider internals
/// (paths/bodies ledger, fixtures, auth) belong to BROWSER-003 and
/// are not pinned here.
/// Facet map (applications_test.go legs): seed-sql and seed-driver
/// pin the seed inputs (L254/L255); seed-runner pins runtime/bun
/// (L256); seed-mode-setup and seed-mode-teardown pin the modes
/// (L621/L684, reused L690/L712/L718/L756/L762/L768);
/// seed-accounts/dashboard/triage pin 7/3/2 (L623);
/// server-version-key pins serverVersion (L622); seed-error-key
/// pins error (L267); seed-env-prefix pins the URL export (L258);
/// app-accounts/dashboard/triage pin the staged names
/// (L629/L697/L727); snapshot-accounts/dashboard/triage keys pin
/// the credential keys (L631/L699/L731); snapshot-triage-name pins
/// triage-live (L731); snapshot-token-key/value pin the test token
/// (L731); port-accounts/dashboard pin 18532/18533 (L632/L700);
/// ready-accounts/dashboard pin the ready paths (L632/L700);
/// rewrite-source/fixtures/from pin the endpoint rewrite
/// (L728/L729).
/// HTTP semantics live in browser-004-live-semantics.can; the triage
/// run shape lives in browser-004-run-shape.can.
/// Variants: none in this file beyond the inventory (default only);
/// the per-leg HTTP and triage predicates live in the sibling
/// slices.
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates CAN/BUILD/PROC/WORK/SUITE and C/R/N/S/A identities
/// bind at P23; no live run now. Descriptor timeout 600000ms
/// mirrors the Go 10-minute ctx (L611).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case browser/live-roots checks: seed-sql, seed-driver,
/// seed-runner, seed-mode-setup, seed-mode-teardown, seed-accounts,
/// seed-dashboard, seed-triage, server-version-key, seed-error-key,
/// seed-env-prefix, app-accounts, app-dashboard, app-triage,
/// snapshot-accounts-key, snapshot-dashboard-key,
/// snapshot-triage-name, snapshot-triage-key, snapshot-token-key,
/// snapshot-token-value, port-accounts, port-dashboard,
/// ready-accounts, ready-dashboard, rewrite-source,
/// rewrite-fixtures, rewrite-from.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str seed_sql
    str seed_driver
    str seed_runner
    str seed_mode_setup
    str seed_mode_teardown
    int seed_accounts
    int seed_dashboard
    int seed_triage
    str server_version_key
    str seed_error_key
    str seed_env_prefix
    str app_accounts
    str app_dashboard
    str app_triage
    str snapshot_accounts_key
    str snapshot_dashboard_key
    str snapshot_triage_name
    str snapshot_triage_key
    str snapshot_token_key
    str snapshot_token_value
    int port_accounts
    int port_dashboard
    str ready_accounts
    str ready_dashboard
    str rewrite_source
    str rewrite_fixtures
    str rewrite_from
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/live-roots", "default", "", "offline"), "seed-sql" => ok "case browser/live-roots variant default root seed-sql run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/live-roots", "default", "", "offline"), "seed-sql" => ok evidence("seed-sql", "true", "true", true, "case browser/live-roots variant default root seed-sql run offline")
        different: false, true, context("browser/live-roots", "default", "", "offline"), "seed-sql" => failed{"seed-sql"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 7, 7, context("browser/live-roots", "default", "", "offline"), "seed-accounts" => ok evidence("seed-accounts", "7", "7", true, "case browser/live-roots variant default root seed-accounts run offline")
        different: 8, 7, context("browser/live-roots", "default", "", "offline"), "seed-accounts" => failed{"seed-accounts"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "tests/integration/testdata/applications/seed.sql", "tests/integration/testdata/applications/seed.sql", context("browser/live-roots", "default", "", "offline"), "seed-sql" => ok evidence("seed-sql", "tests/integration/testdata/applications/seed.sql", "tests/integration/testdata/applications/seed.sql", true, "case browser/live-roots variant default root seed-sql run offline")
        different: "tests/integration/testdata/applications/seed.sql-2", "tests/integration/testdata/applications/seed.sql", context("browser/live-roots", "default", "", "offline"), "seed-sql" => failed{"seed-sql"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
