package m12browser004run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M12 BROWSER-004 "live applications: triage/reseed run shape".
/// Source: tests/integration/applications_test.go symbol
/// TestApplicationsLive triage subtest (L724-766) plus the reseed
/// legs (L690-693/L718-721/L762-765) and the closing log (L768-769);
/// run helper runEntry (L505-527).
/// Disposition: migrate (this row ports TestApplicationsLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the triage production run shape: the Ann
/// argument, the exit-0 empty-diagnostics green, the triage report
/// keys plus the vip/ship/0.9/2/2 values, the exactly-2
/// raw-provider call sequence, the dropped-table unavailable shape,
/// the three reseed counts, and the closing live log needle.
/// ADAPTATION (recorded, with source lines): the triage score is a
/// Go float (0.9, L747), pinned here as its exact source spelling
/// (str) since Can record vocabulary is str/int/bool; the provider
/// pin covers only the call count (L753 len check), since this row
/// asserts no per-path order (order belongs to BROWSER-003);
/// log-needle pins the "live applications: " prefix of the staged
/// log format (L769).
/// Facet map (applications_test.go legs): triage-arg pins Ann
/// (L732); triage-exit and triage-diag-empty pin the green run
/// (L734); triage-keyword/level/score/total/recent keys pin the
/// report keys (L738-742); triage-keyword/level/score/total/recent
/// pin vip/ship/0.9/2/2 (L747); provider-calls pins 2 (L753);
/// triage-dropped-output/exit/diag-empty pin the unavailable shape
/// (L759); reseed-accounts/dashboard/triage pin 7/3/2
/// (L691/L719/L763); log-needle pins the live log (L769).
/// HTTP semantics live in browser-004-live-semantics.can; the
/// seed inventory lives in browser-004-roots-green.can.
/// Variants: triage here (accounts/dashboard HTTP in
/// live-semantics); dropped-table via the triage-dropped pins plus
/// the shared reseed counts.
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates CAN/BUILD/PROC/WORK/SUITE and C/R/N/S/A identities
/// bind at P23; no live run now. Descriptor timeout 600000ms
/// mirrors the Go 10-minute ctx (L611).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case browser/live-run checks: triage-arg, triage-exit,
/// triage-diag-empty, triage-keyword-key, triage-keyword,
/// triage-level-key, triage-level, triage-score-key, triage-score,
/// triage-total-key, triage-total, triage-recent-key,
/// triage-recent, provider-calls, triage-dropped-output,
/// triage-dropped-exit, triage-dropped-diag-empty, reseed-accounts,
/// reseed-dashboard, reseed-triage, log-needle.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str triage_arg
    int triage_exit
    bool triage_diag_empty
    str triage_keyword_key
    str triage_keyword
    str triage_level_key
    str triage_level
    str triage_score_key
    str triage_score
    str triage_total_key
    int triage_total
    str triage_recent_key
    int triage_recent
    int provider_calls
    str triage_dropped_output
    int triage_dropped_exit
    bool triage_dropped_diag_empty
    int reseed_accounts
    int reseed_dashboard
    int reseed_triage
    str log_needle
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("browser/live-run", "default", "", "offline"), "triage-arg" => ok "case browser/live-run variant default root triage-arg run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("browser/live-run", "default", "", "offline"), "triage-diag-empty" => ok evidence("triage-diag-empty", "true", "true", true, "case browser/live-run variant default root triage-diag-empty run offline")
        different: false, true, context("browser/live-run", "default", "", "offline"), "triage-diag-empty" => failed{"triage-diag-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("browser/live-run", "default", "", "offline"), "triage-exit" => ok evidence("triage-exit", "0", "0", true, "case browser/live-run variant default root triage-exit run offline")
        different: 1, 0, context("browser/live-run", "default", "", "offline"), "triage-exit" => failed{"triage-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "Ann", "Ann", context("browser/live-run", "default", "", "offline"), "triage-arg" => ok evidence("triage-arg", "Ann", "Ann", true, "case browser/live-run variant default root triage-arg run offline")
        different: "Ann-2", "Ann", context("browser/live-run", "default", "", "offline"), "triage-arg" => failed{"triage-arg"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
