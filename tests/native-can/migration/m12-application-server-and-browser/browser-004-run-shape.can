    emits {}
    given
        str scope
    asserts
        m12_b004: "m12-b004" => ok [check("triage-arg", "triage run passes Ann"), check("triage-exit", "triage run exits 0"), check("triage-diag-empty", "triage run keeps diagnostics empty"), check("triage-keyword-key", "triage report carries the keyword key"), check("triage-keyword", "triage report pins vip"), check("triage-level-key", "triage report carries the level key"), check("triage-level", "triage report pins ship"), check("triage-score-key", "triage report carries the score key"), check("triage-score", "triage report pins 0.9"), check("triage-total-key", "triage report carries the total key"), check("triage-total", "triage report pins total 2"), check("triage-recent-key", "triage report carries the recent key"), check("triage-recent", "triage report pins recent 2"), check("provider-calls", "triage makes exactly 2 provider calls"), check("triage-dropped-output", "dropped triage prints unavailable"), check("triage-dropped-exit", "dropped triage still exits 0"), check("triage-dropped-diag-empty", "dropped triage keeps diagnostics empty"), check("reseed-accounts", "accounts reseed restores 7"), check("reseed-dashboard", "dashboard reseed restores 3"), check("reseed-triage", "triage reseed restores 2"), check("log-needle", "live log names the live applications")]
        other: "nope" => ok []
    match scope is "m12-b004"
        false => ok []
        true => ok [check("triage-arg", "triage run passes Ann"), check("triage-exit", "triage run exits 0"), check("triage-diag-empty", "triage run keeps diagnostics empty"), check("triage-keyword-key", "triage report carries the keyword key"), check("triage-keyword", "triage report pins vip"), check("triage-level-key", "triage report carries the level key"), check("triage-level", "triage report pins ship"), check("triage-score-key", "triage report carries the score key"), check("triage-score", "triage report pins 0.9"), check("triage-total-key", "triage report carries the total key"), check("triage-total", "triage report pins total 2"), check("triage-recent-key", "triage report carries the recent key"), check("triage-recent", "triage report pins recent 2"), check("provider-calls", "triage makes exactly 2 provider calls"), check("triage-dropped-output", "dropped triage prints unavailable"), check("triage-dropped-exit", "dropped triage still exits 0"), check("triage-dropped-diag-empty", "dropped triage keeps diagnostics empty"), check("reseed-accounts", "accounts reseed restores 7"), check("reseed-dashboard", "dashboard reseed restores 3"), check("reseed-triage", "triage reseed restores 2"), check("log-needle", "live log names the live applications")]
