package m22history001queries
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-001 "SQL queries: assert report and descriptor semantics".
/// Source: tests/integration/sql_test.go symbol TestCurrentSQLQueries
/// (L46-177); manifest sqlQueriesManifest (L17-22); staging helper
/// writeSQLQueriesProject (L24-44); assert leg (L81-88).
/// Disposition: migrate (this row ports TestCurrentSQLQueries to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the gated assert contract plus the five
/// descriptor bindings: the CAN_BUN_ARCHIVE gate plus its skip
/// message, the 4-minute context, the offline sandbox invocation
/// shape, the assert command with exit 0, the report keys plus the
/// nine-root count, the five descriptor names in manifest order, the
/// four bound cardinalities (one/optional/many/execute), the
/// postgresql dialect, and the row_limit_parameter pin.
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (4) from 4*time.Minute (L51); per-descriptor pins
/// mirror the L18-22 manifest rows as static expectations, one
/// load-bearing pin per behavior.
/// Facet map (sql_test.go legs): env-gate pins CAN_BUN_ARCHIVE (L47);
/// skip-needle pins the skip message (L49); ctx-timeout-min pins 4
/// (L51); sandbox-profile pins the deny-network profile (L64);
/// offline-path pins PATH=/nonexistent (L68); canlc-bin pins
/// bin/canlc (L64); assert-cmd pins assert (L81); assert-exit pins
/// exit 0 (L82); report-passed, report-passed-key,
/// report-assertions-key and report-root-count pin the report
/// predicate (L86); desc-count plus desc-by-id/desc-by-term/desc-rows
/// /desc-add/desc-cover pin the five manifest names in order
/// (L18-22); card-one/card-optional/card-many/card-execute pin the
/// bound cardinalities (L18-21); dialect pins postgresql (L18);
/// row-limit-param pins 2 (L18).
/// The roots-green pin lives in history-001-roots-green.can; the
/// build/emitted/negative shape lives in history-001-run-shape.can.
/// Variants: none in this file (default only); the four negative
/// manifests live in run-shape.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates SUITE/CAN/BUILD/DIAG/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 240000ms mirrors the Go
/// 4-minute ctx (L51).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/queries checks: env-gate, skip-needle,
/// ctx-timeout-min, sandbox-profile, offline-path, canlc-bin,
/// assert-cmd, assert-exit, report-passed, report-passed-key,
/// report-assertions-key, report-root-count, desc-count, desc-by-id,
/// desc-by-term, desc-rows, desc-add, desc-cover, card-one,
/// card-optional, card-many, card-execute, dialect, row-limit-param.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_gate
    str skip_needle
    int ctx_timeout_min
    str sandbox_profile
    str offline_path
    str canlc_bin
    str assert_cmd
    int assert_exit
    bool report_passed
    str report_passed_key
    str report_assertions_key
    int report_root_count
    int desc_count
    str desc_by_id
    str desc_by_term
    str desc_rows
    str desc_add
    str desc_cover
    str card_one
    str card_optional
    str card_many
    str card_execute
    str dialect
    int row_limit_param
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/queries", "default", "", "offline"), "env-gate" => ok "case history/queries variant default root env-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/queries", "default", "", "offline"), "report-passed" => ok evidence("report-passed", "true", "true", true, "case history/queries variant default root report-passed run offline")
        different: false, true, context("history/queries", "default", "", "offline"), "report-passed" => failed{"report-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/queries", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "4", "4", true, "case history/queries variant default root ctx-timeout-min run offline")
        different: 3, 4, context("history/queries", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("history/queries", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case history/queries variant default root env-gate run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("history/queries", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
