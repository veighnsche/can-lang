    str neg_param_type
    str neg_row_type
    str neg_undeclared
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/queries-run", "default", "", "offline"), "build-cmd" => ok "case history/queries-run variant default root build-cmd run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/queries-run", "default", "", "offline"), "rebuild-same" => ok evidence("rebuild-same", "true", "true", true, "case history/queries-run variant default root rebuild-same run offline")
        different: false, true, context("history/queries-run", "default", "", "offline"), "rebuild-same" => failed{"rebuild-same"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/queries-run", "default", "", "offline"), "program-count" => ok evidence("program-count", "1", "1", true, "case history/queries-run variant default root program-count run offline")
        different: 2, 1, context("history/queries-run", "default", "", "offline"), "program-count" => failed{"program-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "build", "build", context("history/queries-run", "default", "", "offline"), "build-cmd" => ok evidence("build-cmd", "build", "build", true, "case history/queries-run variant default root build-cmd run offline")
        different: "compile", "build", context("history/queries-run", "default", "", "offline"), "build-cmd" => failed{"build-cmd"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
