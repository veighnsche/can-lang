package m22history002live
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-002 "live SQL queries: answer and error semantics".
/// Source: tests/integration/sql_test.go symbol TestCurrentSQLQueriesLive
/// (L186-347); query legs ok (L306-313) and fault (L314-321) with the
/// sixteen answer vectors (L324-345).
/// Disposition: migrate (this row ports TestCurrentSQLQueriesLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the sixteen compiled-CLI answers over the
/// live PostgreSQL 17 seed: one/optional/many/execute plus bytes and
/// nullable cover rows, with row-missing, row-count, row-limit,
/// duplicate, hostile bound input and refused connection staying
/// distinct error codes.
/// ADAPTATION (recorded, with source lines): fault codes pin bare
/// (sql::row_missing and siblings) while Go wraps each want as a
/// Contains needle error-colon-plus-code-plus-quote (L318); the
/// wrap prefix itself pins in history-002-run-shape.can; the hostile
/// leg pins its none stdout (L338) with the hostile term cited in
/// the check title; the none vector repeats for by-term-none and
/// hostile-term because Go asserts the identical stdout twice.
/// Facet map (sql_test.go legs): close-ok pins closed (L324);
/// by-id-hit pins the Bob row (L325); by-id-missing pins
/// sql::row_missing (L326); by-term-hit pins the some envelope
/// (L327); by-term-none pins the none envelope (L328);
/// by-term-ambiguous pins sql::row_count (L329); rows-limited pins
/// the Jason/Mason pair (L330); rows-over-limit pins sql::row_limit
/// (L331); add-first pins 1 (L332); add-duplicate pins
/// sql::constraint_failed (L333); cover-bytes-some pins the bytes
/// plus some-n row (L334); cover-empty-none pins the empty bytes
/// plus none row (L335); cover-missing pins sql::row_missing
/// (L336); hostile-term pins the none stdout for the hostile bind
/// (L338, term %' OR '1'='1); rows-full pins all seven rows (L339);
/// refused-error pins sql::connection_failed (L343).
/// The roots-green pin lives in history-002-roots-green.can; the
/// fd-3 delivery plus ok/fault run shape lives in
/// history-002-run-shape.can.
/// Variants: by_id present/missing, by_term present/none/ambiguous/
/// hostile, rows limited/full, add first/duplicate, cover bytes and
/// nullable, refused port (all sixteen legs in Go order).
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK/ENV and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1/QF1
/// are unmet. Descriptor timeout 360000ms mirrors the Go 6-minute
/// ctx (L207).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QF1 unmet).
/// Case history/live-queries checks: close-ok, by-id-hit,
/// by-id-missing, by-term-hit, by-term-none, by-term-ambiguous,
/// rows-limited, rows-over-limit, add-first, add-duplicate,
/// cover-bytes-some, cover-empty-none, cover-missing, hostile-term,
/// rows-full, refused-error.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str close_ok
    str by_id_hit
    str by_id_missing
    str by_term_hit
    str by_term_none
    str by_term_ambiguous
    str rows_limited
    str rows_over_limit
    str add_first
    str add_duplicate
    str cover_bytes_some
    str cover_empty_none
    str cover_missing
    str hostile_term
    str rows_full
    str refused_error
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/live-queries", "default", "", "offline"), "close-ok" => ok "case history/live-queries variant default root close-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/live-queries", "default", "", "offline"), "close-ok" => ok evidence("close-ok", "true", "true", true, "case history/live-queries variant default root close-ok run offline")
        different: false, true, context("history/live-queries", "default", "", "offline"), "close-ok" => failed{"close-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/live-queries", "default", "", "offline"), "close-ok" => ok evidence("close-ok", "0", "0", true, "case history/live-queries variant default root close-ok run offline")
        different: 1, 0, context("history/live-queries", "default", "", "offline"), "close-ok" => failed{"close-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "closed", "closed", context("history/live-queries", "default", "", "offline"), "close-ok" => ok evidence("close-ok", "closed", "closed", true, "case history/live-queries variant default root close-ok run offline")
        different: "closed_2", "closed", context("history/live-queries", "default", "", "offline"), "close-ok" => failed{"close-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("closed", "{\"id\":4,\"display_name\":\"Bob\"}", "sql::row_missing", "{\"case\":\"option::some<app::account_row>\",\"value\":{\"value\":{\"id\":4,\"display_name\":\"Bob\"}}}", "{\"case\":\"option::none\",\"value\":{}}", "sql::row_count", "[{\"id\":2,\"display_name\":\"Jason\"},{\"id\":3,\"display_name\":\"Mason\"}]", "sql::row_limit", "1", "sql::constraint_failed", "1[65,66]{\"case\":\"option::some<str>\",\"value\":{\"value\":\"n\"}}", "2[]{\"case\":\"option::none\",\"value\":{}}", "sql::row_missing", "{\"case\":\"option::none\",\"value\":{}}", "[{\"id\":1,\"display_name\":\"Ann\"},{\"id\":2,\"display_name\":\"Jason\"},{\"id\":3,\"display_name\":\"Mason\"},{\"id\":4,\"display_name\":\"Bob\"},{\"id\":5,\"display_name\":\"O'Brien\"},{\"id\":6,\"display_name\":\"Zoë\"},{\"id\":7,\"display_name\":\"Zed\"}]", "sql::connection_failed")
        seed_close_ok: "seed-close-ok-drift" => ok observation("open", "{\"id\":4,\"display_name\":\"Bob\"}", "sql::row_missing", "{\"case\":\"option::some<app::account_row>\",\"value\":{\"value\":{\"id\":4,\"display_name\":\"Bob\"}}}", "{\"case\":\"option::none\",\"value\":{}}", "sql::row_count", "[{\"id\":2,\"display_name\":\"Jason\"},{\"id\":3,\"display_name\":\"Mason\"}]", "sql::row_limit", "1", "sql::constraint_failed", "1[65,66]{\"case\":\"option::some<str>\",\"value\":{\"value\":\"n\"}}", "2[]{\"case\":\"option::none\",\"value\":{}}", "sql::row_missing", "{\"case\":\"option::none\",\"value\":{}}", "[{\"id\":1,\"display_name\":\"Ann\"},{\"id\":2,\"display_name\":\"Jason\"},{\"id\":3,\"display_name\":\"Mason\"},{\"id\":4,\"display_name\":\"Bob\"},{\"id\":5,\"display_name\":\"O'Brien\"},{\"id\":6,\"display_name\":\"Zoë\"},{\"id\":7,\"display_name\":\"Zed\"}]", "sql::connection_failed")
