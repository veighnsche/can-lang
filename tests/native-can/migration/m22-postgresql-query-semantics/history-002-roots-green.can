package m22history002roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-002 "live SQL queries: roots green, seed inventory".
/// Source: tests/integration/sql_test.go symbol TestCurrentSQLQueriesLive
/// (L186-347); env gates (L187-194); live context (L207); seed and
/// driver paths (L235-236); setup report (L255-262); teardown defer
/// (L263); seed schema tests/integration/testdata/sql/queries.sql.
/// Disposition: migrate (this row ports TestCurrentSQLQueriesLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the static live baseline as the green root:
/// both environment gates plus skip messages, the live context, the
/// seed/driver fixture paths, the setup and teardown driver modes,
/// the PostgreSQL 17 version prefix, the six-account/two-cover seed
/// counts, and the two seed table names.
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (6) from 6*time.Minute (L207); setup counts pin int
/// (6/2) from the float64 report comparison (L260); teardown-mode
/// pins the deferred drive teardown (L263), which runs on both
/// success and failure.
/// Facet map (sql_test.go legs): env-archive pins CAN_BUN_ARCHIVE
/// (L187); skip-archive pins the staged-query skip (L189);
/// env-postgres-url pins CAN_TEST_POSTGRES_URL (L191);
/// skip-postgres-url pins the disposable-database skip (L193);
/// ctx-timeout-min pins 6 (L207); seed-path pins queries.sql (L235);
/// driver-path pins queries-driver.ts (L236); driver-setup-mode pins
/// setup (L255); driver-teardown-mode pins teardown (L263);
/// version-prefix pins PostgreSQL 17. (L257); seed-accounts pins 6
/// and seed-cover pins 2 (L260); accounts-table and cover-table pin
/// the seed tables (queries.sql L9/L21).
/// Answer semantics live in history-002-live-semantics.can; the fd-3
/// delivery plus ok/fault run shape lives in
/// history-002-run-shape.can.
/// Variants: none in this file (default only); the sixteen query
/// variants live in live-semantics.
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK/ENV and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1/QF1
/// are unmet. Descriptor timeout 360000ms mirrors the Go 6-minute
/// ctx (L207).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QF1 unmet).
/// Case history/live-roots checks: env-archive, skip-archive,
/// env-postgres-url, skip-postgres-url, ctx-timeout-min, seed-path,
/// driver-path, driver-setup-mode, driver-teardown-mode,
/// version-prefix, seed-accounts, seed-cover, accounts-table,
/// cover-table.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_archive
    str skip_archive
    str env_postgres_url
    str skip_postgres_url
    int ctx_timeout_min
    str seed_path
    str driver_path
    str driver_setup_mode
    str driver_teardown_mode
    str version_prefix
    int seed_accounts
    int seed_cover
    str accounts_table
    str cover_table
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/live-roots", "default", "", "offline"), "env-archive" => ok "case history/live-roots variant default root env-archive run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/live-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "true", "true", true, "case history/live-roots variant default root env-archive run offline")
        different: false, true, context("history/live-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/live-roots", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "6", "6", true, "case history/live-roots variant default root ctx-timeout-min run offline")
        different: 7, 6, context("history/live-roots", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
