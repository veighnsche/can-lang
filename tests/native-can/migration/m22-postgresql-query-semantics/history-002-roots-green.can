    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("history/live-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case history/live-roots variant default root env-archive run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("history/live-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
