        true => ok [check("sandbox-profile", "live build pins the deny-network profile"), check("canlc-bin", "live build runs bin/canlc"), check("build-cmd", "live leg invokes canlc build"), check("offline-path", "live legs clear PATH to /nonexistent"), check("bun-entry", "driver and CLI run under runtime/bun"), check("entry-name", "compiled entry is entry.ts"), check("snapshot-key", "snapshot carries the CAN_TEST_POSTGRES key"), check("snapshot-fd", "credential snapshot arrives on fd 3"), check("snapshot-count", "CLI run passes one snapshot file"), check("snapshot-mode", "snapshot file lands mode 0600"), check("cli-env-count", "CLI environment holds two entries"), check("cli-env-clean", "CLI environment never carries the URL"), check("driver-env-has-url", "driver environment carries the URL"), check("ok-exit", "ok legs exit 0"), check("ok-diag-empty", "ok legs keep diagnostics empty"), check("fault-exit", "fault legs exit 1"), check("fault-stdout-empty", "fault legs keep stdout empty"), check("fault-needle", "fault legs wrap the code as error colon"), check("refused-value", "refusal uses the dummy postgres value"), check("live-check-count", "live run performs sixteen checks")]
fn expected_check[] expected_vector
    emits {}
    given
