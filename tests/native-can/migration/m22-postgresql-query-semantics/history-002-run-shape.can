package m22history002run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-002 "live SQL queries: fd-3 delivery and run shape".
/// Source: tests/integration/sql_test.go symbol TestCurrentSQLQueriesLive
/// (L186-347); live build leg (L222-234); snapshot helper snapshotFor
/// (L265-277); run helper run with fd-3 ExtraFiles (L280-304); ok
/// (L306-313) and fault (L314-321) contracts; refused leg (L341-345).
/// Disposition: migrate (this row ports TestCurrentSQLQueriesLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live run shape: the sandboxed build
/// invocation, the fd-3 snapshot credential delivery (key, fd
/// number, file count, mode, CLI env without the URL versus driver
/// env with it), the ok/fault exit and stream contracts, the fault
/// error-colon wrap, the dummy refused value, and the sixteen-check
/// total.
/// ADAPTATION (recorded, with source lines): snapshot-fd pins 3 from
/// the fd-3 comment plus single ExtraFiles entry (L282/L292); the
/// file mode pins the exact source spelling 0600 (L273); cli-env-clean
/// pins true for the URL travelling only in the snapshot, never the
/// environment (L290-291); driver-env-has-url pins true for the
/// driver env carrying CAN_TEST_POSTGRES_URL (L241); fault-needle
/// pins the backtick error-colon prefix while Go appends want plus
/// the closing quote (L318); live-check-count pins 16 from ten ok
/// plus five fault plus one refused leg (L324-345).
/// Facet map (sql_test.go legs): sandbox-profile pins the deny-network
/// profile (L222); canlc-bin pins bin/canlc (L222); build-cmd pins
/// build (L222); offline-path pins PATH=/nonexistent (L224/L291);
/// bun-entry pins runtime/bun (L239/L288); entry-name pins entry.ts
/// (L288); snapshot-key pins CAN_TEST_POSTGRES (L267); snapshot-fd
/// pins 3 (L282/L292); snapshot-count pins 1 (L292); snapshot-mode
/// pins 0600 (L273); cli-env-count pins 2 (L291); cli-env-clean pins
/// URL-absent (L290-291); driver-env-has-url pins URL-present (L241);
/// ok-exit pins 0 and ok-diag-empty pins empty (L310); fault-exit
/// pins 1 and fault-stdout-empty pins empty (L318); fault-needle
/// pins the error-colon wrap (L318); refused-value pins the dummy
/// postgres value (L279); live-check-count pins 16 (L305-345).
/// The roots-green pin lives in history-002-roots-green.can; answer
/// semantics live in history-002-live-semantics.can.
/// Variants: the sixteen query legs share one delivery and contract
/// shape (a single default case; per-leg answers pin in
/// live-semantics).
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK/ENV and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1/QF1
/// are unmet. Descriptor timeout 360000ms mirrors the Go 6-minute
/// ctx (L207).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QF1 unmet).
/// Case history/live-run checks: sandbox-profile, canlc-bin,
/// build-cmd, offline-path, bun-entry, entry-name, snapshot-key,
/// snapshot-fd, snapshot-count, snapshot-mode, cli-env-count,
/// cli-env-clean, driver-env-has-url, ok-exit, ok-diag-empty,
/// fault-exit, fault-stdout-empty, fault-needle, refused-value,
/// live-check-count.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str sandbox_profile
    str canlc_bin
    str build_cmd
    str offline_path
    str bun_entry
    str entry_name
    str snapshot_key
    int snapshot_fd
    int snapshot_count
    str snapshot_mode
    int cli_env_count
    bool cli_env_clean
    bool driver_env_has_url
    int ok_exit
    bool ok_diag_empty
    int fault_exit
    bool fault_stdout_empty
    str fault_needle
    str refused_value
    int live_check_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/live-run", "default", "", "offline"), "sandbox-profile" => ok "case history/live-run variant default root sandbox-profile run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/live-run", "default", "", "offline"), "cli-env-clean" => ok evidence("cli-env-clean", "true", "true", true, "case history/live-run variant default root cli-env-clean run offline")
        different: false, true, context("history/live-run", "default", "", "offline"), "cli-env-clean" => failed{"cli-env-clean"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/live-run", "default", "", "offline"), "snapshot-fd" => ok evidence("snapshot-fd", "3", "3", true, "case history/live-run variant default root snapshot-fd run offline")
        different: 4, 3, context("history/live-run", "default", "", "offline"), "snapshot-fd" => failed{"snapshot-fd"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("history/live-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case history/live-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)(deny network*)_2", "(version 1)(allow default)(deny network*)", context("history/live-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
