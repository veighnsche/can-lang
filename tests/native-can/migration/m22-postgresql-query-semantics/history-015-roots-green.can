package m22history015roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-015 "queries-driver.ts: fixture inventory, roots green".
/// Source: tests/integration/testdata/sql/queries-driver.ts symbol
/// queries-driver.ts (L49-56 version/count/report legs, L60 teardown
/// report); related fixture tests/integration/testdata/sql/queries.sql
/// (L7-31; retained by HISTORY-020, read here for row counts only).
/// Disposition: migrate (this row ports queries-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the static inventory as the green baseline:
/// the two fixture tables, their seeded row counts, the version and
/// count queries, the count key, the setup report keys, and the
/// teardown report green (dropped key plus true).
/// ADAPTATION (recorded, with source lines): accounts-rows (6) counts
/// the sql L15-20 value rows and cover-rows (2) counts the sql L28-29
/// value rows (counts, not source literals); the escaped/non-ASCII row
/// values (quoted quote, accented name, bytea escapes) are deliberately
/// not pinned as literals here (count pins avoid encoding drift; value
/// semantics belong to HISTORY-001/002).
/// Facet map (queries-driver.ts legs): accounts-table pins
/// can_i35_accounts (driver L54; sql L8); cover-table pins
/// can_i35_cover (driver L55; sql L7); accounts-rows pins 6 (sql
/// L15-20; observed by L54); cover-rows pins 2 (sql L28-29; observed
/// by L55); version-query pins SELECT version() (L49); version-prefix
/// pins PostgreSQL 17. (L51); accounts-query pins the L54 count query;
/// cover-query pins the L55 count query; count-key pins count (L54-55);
/// report-version-key, report-accounts-key and report-cover-key pin
/// serverVersion/accounts/cover (L56); dropped-key pins dropped (L60);
/// dropped-value pins true (L60).
/// Seed semantics live in history-015-seed-semantics.can; the
/// invocation/run shape lives in history-015-run-shape.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in queries-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/queries-roots checks: accounts-table, cover-table,
/// accounts-rows, cover-rows, version-query, version-prefix,
/// accounts-query, cover-query, count-key, report-version-key,
/// report-accounts-key, report-cover-key, dropped-key, dropped-value.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str accounts_table
    str cover_table
    int accounts_rows
    int cover_rows
    str version_query
    str version_prefix
    str accounts_query
    str cover_query
    str count_key
    str report_version_key
    str report_accounts_key
    str report_cover_key
    str dropped_key
    bool dropped_value
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/queries-roots", "default", "", "offline"), "accounts-table" => ok "case history/queries-roots variant default root accounts-table run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/queries-roots", "default", "", "offline"), "dropped-value" => ok evidence("dropped-value", "true", "true", true, "case history/queries-roots variant default root dropped-value run offline")
        different: false, true, context("history/queries-roots", "default", "", "offline"), "dropped-value" => failed{"dropped-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/queries-roots", "default", "", "offline"), "accounts-rows" => ok evidence("accounts-rows", "6", "6", true, "case history/queries-roots variant default root accounts-rows run offline")
        different: 7, 6, context("history/queries-roots", "default", "", "offline"), "accounts-rows" => failed{"accounts-rows"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can_i35_accounts", "can_i35_accounts", context("history/queries-roots", "default", "", "offline"), "accounts-table" => ok evidence("accounts-table", "can_i35_accounts", "can_i35_accounts", true, "case history/queries-roots variant default root accounts-table run offline")
        different: "can_i35_accounts2", "can_i35_accounts", context("history/queries-roots", "default", "", "offline"), "accounts-table" => failed{"accounts-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
