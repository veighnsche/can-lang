fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/queries-roots", "default", "", "offline") => ok
        seed_accounts_table: context("history/queries-roots", "seed-accounts-table-drift", "", "offline") => failed{"accounts-table"}
        seed_cover_table: context("history/queries-roots", "seed-cover-table-drift", "", "offline") => failed{"cover-table"}
        seed_accounts_rows: context("history/queries-roots", "seed-accounts-rows-drift", "", "offline") => failed{"accounts-rows"}
        seed_cover_rows: context("history/queries-roots", "seed-cover-rows-drift", "", "offline") => failed{"cover-rows"}
        seed_version_query: context("history/queries-roots", "seed-version-query-drift", "", "offline") => failed{"version-query"}
        seed_version_prefix: context("history/queries-roots", "seed-version-prefix-drift", "", "offline") => failed{"version-prefix"}
        seed_accounts_query: context("history/queries-roots", "seed-accounts-query-drift", "", "offline") => failed{"accounts-query"}
        seed_cover_query: context("history/queries-roots", "seed-cover-query-drift", "", "offline") => failed{"cover-query"}
        seed_count_key: context("history/queries-roots", "seed-count-key-drift", "", "offline") => failed{"count-key"}
        seed_report_version_key: context("history/queries-roots", "seed-report-version-key-drift", "", "offline") => failed{"report-version-key"}
        seed_report_accounts_key: context("history/queries-roots", "seed-report-accounts-key-drift", "", "offline") => failed{"report-accounts-key"}
        seed_report_cover_key: context("history/queries-roots", "seed-report-cover-key-drift", "", "offline") => failed{"report-cover-key"}
        seed_dropped_key: context("history/queries-roots", "seed-dropped-key-drift", "", "offline") => failed{"dropped-key"}
        seed_dropped_value: context("history/queries-roots", "seed-dropped-value-drift", "", "offline") => failed{"dropped-value"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.accounts_table, "can_i35_accounts", c, "accounts-table")
            failed
            ok evidence accounts_table_evidence => match call require_text(got.cover_table, "can_i35_cover", c, "cover-table")
                failed
                ok evidence cover_table_evidence => match call require_int(got.accounts_rows, 6, c, "accounts-rows")
                    failed
                    ok evidence accounts_rows_evidence => match call require_int(got.cover_rows, 2, c, "cover-rows")
                        failed
                        ok evidence cover_rows_evidence => match call require_text(got.version_query, "SELECT version()", c, "version-query")
                            failed
                            ok evidence version_query_evidence => match call require_text(got.version_prefix, "PostgreSQL 17.", c, "version-prefix")
                                failed
                                ok evidence version_prefix_evidence => match call require_text(got.accounts_query, "SELECT COUNT(*)::int AS count FROM can_i35_accounts", c, "accounts-query")
                                    failed
                                    ok evidence accounts_query_evidence => match call require_text(got.cover_query, "SELECT COUNT(*)::int AS count FROM can_i35_cover", c, "cover-query")
                                        failed
                                        ok evidence cover_query_evidence => match call require_text(got.count_key, "count", c, "count-key")
                                            failed
                                            ok evidence count_key_evidence => match call require_text(got.report_version_key, "serverVersion", c, "report-version-key")
                                                failed
                                                ok evidence report_version_key_evidence => match call require_text(got.report_accounts_key, "accounts", c, "report-accounts-key")
                                                    failed
                                                    ok evidence report_accounts_key_evidence => match call require_text(got.report_cover_key, "cover", c, "report-cover-key")
                                                        failed
                                                        ok evidence report_cover_key_evidence => match call require_text(got.dropped_key, "dropped", c, "dropped-key")
                                                            failed
                                                            ok evidence dropped_key_evidence => match call require_bool(got.dropped_value, true, c, "dropped-value")
                                                                failed
                                                                ok evidence dropped_value_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m22_h015: "m22-h015" => ok test_case("history/queries-roots", ["history", "m22"], ["can-test-postgres-url"], 0, [check_ref("accounts-table"), check_ref("cover-table"), check_ref("accounts-rows"), check_ref("cover-rows"), check_ref("version-query"), check_ref("version-prefix"), check_ref("accounts-query"), check_ref("cover-query"), check_ref("count-key"), check_ref("report-version-key"), check_ref("report-accounts-key"), check_ref("report-cover-key"), check_ref("dropped-key"), check_ref("dropped-value")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m22-h015"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/queries-roots", ["history", "m22"], ["can-test-postgres-url"], 0, [check_ref("accounts-table"), check_ref("cover-table"), check_ref("accounts-rows"), check_ref("cover-rows"), check_ref("version-query"), check_ref("version-prefix"), check_ref("accounts-query"), check_ref("cover-query"), check_ref("count-key"), check_ref("report-version-key"), check_ref("report-accounts-key"), check_ref("report-cover-key"), check_ref("dropped-key"), check_ref("dropped-value")], callable case_body)
