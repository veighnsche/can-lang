package m22history015seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-015 "queries-driver.ts: ten-statement seed shape semantics".
/// Source: tests/integration/testdata/sql/queries-driver.ts symbol
/// queries-driver.ts (L26-48 seed parse/shape/setup legs); related
/// fixture tests/integration/testdata/sql/queries.sql (L7-31 ten
/// statements in seed order).
/// Disposition: migrate (this row ports queries-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the seed-file shape contract: the comment
/// filter and statement split, the ten-statement count gate, the ten
/// per-position kind pins in seed order, both refusal messages, and
/// the setup/teardown apply counts.
/// ADAPTATION (recorded, with source lines): the setup-apply pin (8)
/// counts the L46 array elements and teardown-drops (2) counts the
/// L58-59 awaits (counts, not source literals, per the M12 app-count
/// precedent); the kind pins mirror startsWith prefixes (L37-41), not
/// full statements; count-message pins the static template prefix
/// (L33).
/// Facet map (queries-driver.ts legs): stmt-count pins 10 (L33);
/// comment-prefix pins -- (L28); stmt-split pins ; (L30); s1-reset-cover
/// and s2-reset-accounts pin DROP TABLE (L37; sql L7-8);
/// s3-create-accounts pins CREATE TABLE (L38; sql L9);
/// s4-truncate-accounts pins TRUNCATE (L38; sql L13);
/// s5-insert-accounts pins INSERT INTO (L39; sql L14);
/// s6-create-cover pins CREATE TABLE (L39; sql L21);
/// s7-truncate-cover pins TRUNCATE (L40; sql L26); s8-insert-cover pins
/// INSERT INTO (L40; sql L27); s9-drop-cover and s10-drop-accounts pin
/// DROP TABLE (L41; sql L30-31); count-message pins the L33 template
/// prefix; shape-refusal pins the L43 refusal; setup-apply pins 8
/// (L46); teardown-drops pins 2 (L58-59).
/// The roots-green pin lives in history-015-roots-green.can; the
/// invocation/run shape lives in history-015-run-shape.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in queries-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/queries-seed checks: stmt-count, comment-prefix,
/// stmt-split, s1-reset-cover, s2-reset-accounts, s3-create-accounts,
/// s4-truncate-accounts, s5-insert-accounts, s6-create-cover,
/// s7-truncate-cover, s8-insert-cover, s9-drop-cover,
/// s10-drop-accounts, count-message, shape-refusal, setup-apply,
/// teardown-drops.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int stmt_count
    str comment_prefix
    str stmt_split
    str s1_reset_cover
    str s2_reset_accounts
    str s3_create_accounts
    str s4_truncate_accounts
    str s5_insert_accounts
    str s6_create_cover
    str s7_truncate_cover
    str s8_insert_cover
    str s9_drop_cover
    str s10_drop_accounts
    str count_message
    str shape_refusal
    int setup_apply
    int teardown_drops
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/queries-seed", "default", "", "offline"), "stmt-count" => ok "case history/queries-seed variant default root stmt-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/queries-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "true", "true", true, "case history/queries-seed variant default root stmt-count run offline")
        different: false, true, context("history/queries-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("history/queries-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "10", "10", true, "case history/queries-seed variant default root stmt-count run offline")
        different: 11, 10, context("history/queries-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "--", "--", context("history/queries-seed", "default", "", "offline"), "comment-prefix" => ok evidence("comment-prefix", "--", "--", true, "case history/queries-seed variant default root comment-prefix run offline")
        different: "--2", "--", context("history/queries-seed", "default", "", "offline"), "comment-prefix" => failed{"comment-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
