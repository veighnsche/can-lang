fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/queries-seed", "default", "", "offline") => ok
        seed_stmt_count: context("history/queries-seed", "seed-stmt-count-drift", "", "offline") => failed{"stmt-count"}
        seed_comment_prefix: context("history/queries-seed", "seed-comment-prefix-drift", "", "offline") => failed{"comment-prefix"}
        seed_stmt_split: context("history/queries-seed", "seed-stmt-split-drift", "", "offline") => failed{"stmt-split"}
        seed_s1_reset_cover: context("history/queries-seed", "seed-s1-reset-cover-drift", "", "offline") => failed{"s1-reset-cover"}
        seed_s2_reset_accounts: context("history/queries-seed", "seed-s2-reset-accounts-drift", "", "offline") => failed{"s2-reset-accounts"}
        seed_s3_create_accounts: context("history/queries-seed", "seed-s3-create-accounts-drift", "", "offline") => failed{"s3-create-accounts"}
        seed_s4_truncate_accounts: context("history/queries-seed", "seed-s4-truncate-accounts-drift", "", "offline") => failed{"s4-truncate-accounts"}
        seed_s5_insert_accounts: context("history/queries-seed", "seed-s5-insert-accounts-drift", "", "offline") => failed{"s5-insert-accounts"}
        seed_s6_create_cover: context("history/queries-seed", "seed-s6-create-cover-drift", "", "offline") => failed{"s6-create-cover"}
        seed_s7_truncate_cover: context("history/queries-seed", "seed-s7-truncate-cover-drift", "", "offline") => failed{"s7-truncate-cover"}
        seed_s8_insert_cover: context("history/queries-seed", "seed-s8-insert-cover-drift", "", "offline") => failed{"s8-insert-cover"}
        seed_s9_drop_cover: context("history/queries-seed", "seed-s9-drop-cover-drift", "", "offline") => failed{"s9-drop-cover"}
        seed_s10_drop_accounts: context("history/queries-seed", "seed-s10-drop-accounts-drift", "", "offline") => failed{"s10-drop-accounts"}
        seed_count_message: context("history/queries-seed", "seed-count-message-drift", "", "offline") => failed{"count-message"}
        seed_shape_refusal: context("history/queries-seed", "seed-shape-refusal-drift", "", "offline") => failed{"shape-refusal"}
        seed_setup_apply: context("history/queries-seed", "seed-setup-apply-drift", "", "offline") => failed{"setup-apply"}
        seed_teardown_drops: context("history/queries-seed", "seed-teardown-drops-drift", "", "offline") => failed{"teardown-drops"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.stmt_count, 10, c, "stmt-count")
            failed
            ok evidence stmt_count_evidence => match call require_text(got.comment_prefix, "--", c, "comment-prefix")
                failed
                ok evidence comment_prefix_evidence => match call require_text(got.stmt_split, ";", c, "stmt-split")
                    failed
