fn check[] checks
    emits {}
    given
        str scope
    asserts
        m22_h015: "m22-h015" => ok [check("stmt-count", "seed file holds exactly 10 statements"), check("comment-prefix", "seed parse filters -- comment lines"), check("stmt-split", "seed parse splits statements on ;"), check("s1-reset-cover", "seed statement 1 resets the cover table"), check("s2-reset-accounts", "seed statement 2 resets the accounts table"), check("s3-create-accounts", "seed statement 3 creates the accounts table"), check("s4-truncate-accounts", "seed statement 4 truncates accounts"), check("s5-insert-accounts", "seed statement 5 inserts accounts rows"), check("s6-create-cover", "seed statement 6 creates the cover table"), check("s7-truncate-cover", "seed statement 7 truncates cover"), check("s8-insert-cover", "seed statement 8 inserts cover rows"), check("s9-drop-cover", "seed statement 9 drops the cover table"), check("s10-drop-accounts", "seed statement 10 drops the accounts table"), check("count-message", "wrong statement count refuses with the count message"), check("shape-refusal", "changed seed shape refuses setup/teardown"), check("setup-apply", "setup applies the first 8 statements"), check("teardown-drops", "teardown runs the 2 drop statements")]
        other: "nope" => ok []
    match scope is "m22-h015"
        false => ok []
        true => ok [check("stmt-count", "seed file holds exactly 10 statements"), check("comment-prefix", "seed parse filters -- comment lines"), check("stmt-split", "seed parse splits statements on ;"), check("s1-reset-cover", "seed statement 1 resets the cover table"), check("s2-reset-accounts", "seed statement 2 resets the accounts table"), check("s3-create-accounts", "seed statement 3 creates the accounts table"), check("s4-truncate-accounts", "seed statement 4 truncates accounts"), check("s5-insert-accounts", "seed statement 5 inserts accounts rows"), check("s6-create-cover", "seed statement 6 creates the cover table"), check("s7-truncate-cover", "seed statement 7 truncates cover"), check("s8-insert-cover", "seed statement 8 inserts cover rows"), check("s9-drop-cover", "seed statement 9 drops the cover table"), check("s10-drop-accounts", "seed statement 10 drops the accounts table"), check("count-message", "wrong statement count refuses with the count message"), check("shape-refusal", "changed seed shape refuses setup/teardown"), check("setup-apply", "setup applies the first 8 statements"), check("teardown-drops", "teardown runs the 2 drop statements")]
