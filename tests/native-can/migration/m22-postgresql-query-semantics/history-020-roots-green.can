package m22history020roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-020 "queries.sql: schema and seed rows byte truth".
/// Source: tests/integration/testdata/sql/queries.sql (1103 bytes,
/// 31 lines, md5 9037f078f06699af8be14e1acf85d648).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the schema and seed values: both table
/// names, all five column-definition lines verbatim (leading
/// 2-space indents and trailing commas included), the expected
/// starting row counts (6 accounts, 2 cover), the five ASCII
/// accounts rows verbatim, and md5 pins for the non-ASCII and
/// backslash rows (L20, L28-29).
/// ADAPTATION (recorded, with source lines): verbatim pins cover
/// printable-ASCII lines only; L20 carries a non-ASCII name byte
/// sequence (Zo..) and L28-29 carry backslash escapes, so those
/// three rows pin md5 over the exact line bytes including the
/// trailing newline (sed -n '<line>p' queries.sql | md5) instead
/// of literals. Both id column lines (L10, L22) are byte-identical
/// in the fixture and pin the same text at two positions.
/// Facet map (queries.sql legs): accounts-table pins
/// can_i35_accounts (L8); cover-table pins can_i35_cover (L7);
/// id-col-accounts pins the L10 line; name-col the L11 line;
/// id-col-cover the L22 line; payload-col the L23 line; note-col
/// the L24 line; accounts-rows pins 6 (L15-20); cover-rows pins
/// 2 (L28-29); row-ann pins the L15 line; row-jason the L16
/// line; row-mason the L17 line; row-bob the L18 line;
/// row-obrien the L19 line; row-zoe-md5 the L20 digest;
/// row-cover1-md5 the L28 digest; row-cover2-md5 the L29 digest.
/// Seed semantics live in history-020-seed-semantics.can; the
/// invocation/run shape lives in history-020-run-shape.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/fixture-roots checks: accounts-table, cover-table,
/// id-col-accounts, name-col, id-col-cover, payload-col, note-col,
/// accounts-rows, cover-rows, row-ann, row-jason, row-mason,
/// row-bob, row-obrien, row-zoe-md5, row-cover1-md5,
/// row-cover2-md5.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str accounts_table
    str cover_table
    str id_col_accounts
    str name_col
    str id_col_cover
    str payload_col
    str note_col
    int accounts_rows
    int cover_rows
    str row_ann
    str row_jason
    str row_mason
    str row_bob
    str row_obrien
    str row_zoe_md5
    str row_cover1_md5
    str row_cover2_md5
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/fixture-roots", "default", "", "offline"), "accounts-table" => ok "case history/fixture-roots variant default root accounts-table run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/fixture-roots", "default", "", "offline"), "accounts-table" => ok evidence("accounts-table", "true", "true", true, "case history/fixture-roots variant default root accounts-table run offline")
        different: false, true, context("history/fixture-roots", "default", "", "offline"), "accounts-table" => failed{"accounts-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/fixture-roots", "default", "", "offline"), "accounts-rows" => ok evidence("accounts-rows", "6", "6", true, "case history/fixture-roots variant default root accounts-rows run offline")
        different: 7, 6, context("history/fixture-roots", "default", "", "offline"), "accounts-rows" => failed{"accounts-rows"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can_i35_accounts", "can_i35_accounts", context("history/fixture-roots", "default", "", "offline"), "accounts-table" => ok evidence("accounts-table", "can_i35_accounts", "can_i35_accounts", true, "case history/fixture-roots variant default root accounts-table run offline")
        different: "can_i35_accounts2", "can_i35_accounts", context("history/fixture-roots", "default", "", "offline"), "accounts-table" => failed{"accounts-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("can_i35_accounts", "can_i35_cover", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  payload bytea NOT NULL,", "  note text NULL", 6, 2, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0", "2b1404cefc4d8c550ab00f2c63cf11c9", "620a5e79f9e35546abd1e6bb286cab73")
        seed_accounts_table: "seed-accounts-table-drift" => ok observation("can_i35_accounts2", "can_i35_cover", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  payload bytea NOT NULL,", "  note text NULL", 6, 2, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0", "2b1404cefc4d8c550ab00f2c63cf11c9", "620a5e79f9e35546abd1e6bb286cab73")
