    emits {}
    given
        str scope
    asserts
        m22_h020: "m22-h020" => ok [check("s1-line", "statement 1 line is byte-exact"), check("s2-line", "statement 2 line is byte-exact"), check("s3-head", "statement 3 head line is byte-exact"), check("s4-line", "statement 4 line is byte-exact"), check("s5-head", "statement 5 head line is byte-exact"), check("s6-head", "statement 6 head line is byte-exact"), check("s7-line", "statement 7 line is byte-exact"), check("s8-head", "statement 8 head line is byte-exact"), check("s9-line", "statement 9 line is byte-exact"), check("s10-line", "statement 10 line is byte-exact"), check("stmt-terms", "exactly 10 lines end in a statement terminator"), check("drop-count", "DROP TABLE occurs exactly 4 times"), check("create-count", "CREATE TABLE occurs exactly 2 times")]
