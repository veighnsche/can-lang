package m22history020run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-020 "queries.sql: statement order and head shape".
/// Source: tests/integration/testdata/sql/queries.sql (1103 bytes,
/// 31 lines, md5 9037f078f06699af8be14e1acf85d648).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the statement order and head shape: the
/// verbatim head line of each of the 10 statements in seed order
/// (full text for single-line statements, first line for the four
/// multi-line bodies), the terminator-line count, and the DROP/
/// CREATE occurrence cross-checks.
/// ADAPTATION (recorded, with source lines): stmt-terms counts
/// lines ending in ; (10), not raw ; bytes (11: the L2 header
/// comment carries one extra semicolon, which must not count as
/// a terminator). Multi-line bodies pin their head line here;
/// their full bytes pin by md5 in history-020-seed-semantics.can.
/// Facet map (queries.sql legs): s1-line pins the L7 drop;
/// s2-line the L8 drop; s3-head the L9 create head; s4-line the
/// L13 truncate; s5-head the L14 insert head; s6-head the L21
/// create head; s7-line the L26 truncate; s8-head the L27 insert
/// head; s9-line the L30 drop; s10-line the L31 drop; stmt-terms
/// pins 10 lines ending in ;; drop-count pins 4 DROP TABLE
/// occurrences (L7-8, L30-31); create-count pins 2 CREATE TABLE
/// occurrences (L9, L21).
/// Seed semantics live in history-020-seed-semantics.can; the
/// roots-green pin lives in history-020-roots-green.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/fixture-run checks: s1-line, s2-line, s3-head,
/// s4-line, s5-head, s6-head, s7-line, s8-head, s9-line, s10-line,
/// stmt-terms, drop-count, create-count.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str s1_line
    str s2_line
    str s3_head
    str s4_line
    str s5_head
    str s6_head
    str s7_line
    str s8_head
    str s9_line
    str s10_line
    int stmt_terms
    int drop_count
    int create_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/fixture-run", "default", "", "offline"), "s1-line" => ok "case history/fixture-run variant default root s1-line run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/fixture-run", "default", "", "offline"), "s1-line" => ok evidence("s1-line", "true", "true", true, "case history/fixture-run variant default root s1-line run offline")
        different: false, true, context("history/fixture-run", "default", "", "offline"), "s1-line" => failed{"s1-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("history/fixture-run", "default", "", "offline"), "stmt-terms" => ok evidence("stmt-terms", "10", "10", true, "case history/fixture-run variant default root stmt-terms run offline")
        different: 11, 10, context("history/fixture-run", "default", "", "offline"), "stmt-terms" => failed{"stmt-terms"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "DROP TABLE IF EXISTS can_i35_cover;", "DROP TABLE IF EXISTS can_i35_cover;", context("history/fixture-run", "default", "", "offline"), "s1-line" => ok evidence("s1-line", "DROP TABLE IF EXISTS can_i35_cover;", "DROP TABLE IF EXISTS can_i35_cover;", true, "case history/fixture-run variant default root s1-line run offline")
        different: "DROP TABLE IF EXISTS can_i35_cover;2", "DROP TABLE IF EXISTS can_i35_cover;", context("history/fixture-run", "default", "", "offline"), "s1-line" => failed{"s1-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
