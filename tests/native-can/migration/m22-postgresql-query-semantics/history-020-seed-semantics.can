package m22history020seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M22 HISTORY-020 "queries.sql: statement inventory byte truth".
/// Source: tests/integration/testdata/sql/queries.sql (1103 bytes,
/// 31 lines, md5 9037f078f06699af8be14e1acf85d648).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the static statement inventory: the file
/// size/line/hash envelope, the 6-line header comment count, the
/// 10-statement count, and one md5 pin per statement in seed order
/// (L7, L8, L9-12, L13, L14-20, L21-25, L26, L27-29, L30, L31).
/// ADAPTATION (recorded, with source lines): each sN-md5 pins md5
/// over that statement's exact line-span bytes including every
/// trailing newline, reproduced by sed -n '<range>p' queries.sql
/// | md5 (single-line statements equal their line md5; multi-line
/// spans cover the embedded newlines and 2-space indents, so any
/// whitespace drift breaks the pin). Verbatim single-line text
/// lives in history-020-run-shape.can; column lines and seed rows
/// live in history-020-roots-green.can.
/// Facet map (queries.sql legs): stmt-count pins 10 (L7-31);
/// comment-lines pins 6 (L1-6); total-lines pins 31; file-bytes
/// pins 1103; file-md5 pins the whole-file digest; s1-md5 pins
/// the L7 drop; s2-md5 the L8 drop; s3-md5 the L9-12 create;
/// s4-md5 the L13 truncate; s5-md5 the L14-20 insert; s6-md5 the
/// L21-25 create; s7-md5 the L26 truncate; s8-md5 the L27-29
/// insert; s9-md5 the L30 drop; s10-md5 the L31 drop.
/// The roots-green pin lives in history-020-roots-green.can; the
/// invocation/run shape lives in history-020-run-shape.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/fixture-seed checks: stmt-count, comment-lines,
/// total-lines, file-bytes, file-md5, s1-md5, s2-md5, s3-md5,
/// s4-md5, s5-md5, s6-md5, s7-md5, s8-md5, s9-md5, s10-md5.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int stmt_count
    int comment_lines
    int total_lines
    int file_bytes
    str file_md5
    str s1_md5
    str s2_md5
    str s3_md5
    str s4_md5
    str s5_md5
    str s6_md5
    str s7_md5
    str s8_md5
    str s9_md5
    str s10_md5
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/fixture-seed", "default", "", "offline"), "stmt-count" => ok "case history/fixture-seed variant default root stmt-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/fixture-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "true", "true", true, "case history/fixture-seed variant default root stmt-count run offline")
        different: false, true, context("history/fixture-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("history/fixture-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "10", "10", true, "case history/fixture-seed variant default root stmt-count run offline")
        different: 11, 10, context("history/fixture-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "9037f078f06699af8be14e1acf85d648", "9037f078f06699af8be14e1acf85d648", context("history/fixture-seed", "default", "", "offline"), "file-md5" => ok evidence("file-md5", "9037f078f06699af8be14e1acf85d648", "9037f078f06699af8be14e1acf85d648", true, "case history/fixture-seed variant default root file-md5 run offline")
        different: "0037f078f06699af8be14e1acf85d648", "9037f078f06699af8be14e1acf85d648", context("history/fixture-seed", "default", "", "offline"), "file-md5" => failed{"file-md5"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
