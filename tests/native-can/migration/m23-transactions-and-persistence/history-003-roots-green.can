fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m23_h003: "m23-h003" => ok test_case("history/tx-roots", ["history", "m23"], ["can-bun-archive"], 240000, [check_ref("fixture-path"), check_ref("project-name"), check_ref("errors-name"), check_ref("errors-empty"), check_ref("entry-src"), check_ref("source-root-key"), check_ref("error-registry-key"), check_ref("param-search-type"), check_ref("param-id-type"), check_ref("row-account-type"), check_ref("assert-exit"), check_ref("assert-diag-empty")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m23-h003"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/tx-roots", ["history", "m23"], ["can-bun-archive"], 240000, [check_ref("fixture-path"), check_ref("project-name"), check_ref("errors-name"), check_ref("errors-empty"), check_ref("entry-src"), check_ref("source-root-key"), check_ref("error-registry-key"), check_ref("param-search-type"), check_ref("param-id-type"), check_ref("row-account-type"), check_ref("assert-exit"), check_ref("assert-diag-empty")], callable case_body)
