package m23history003roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-003 "SQL transactions: roots green, staged inventory".
/// Source: tests/integration/sql_test.go manifest sqlTransactionsManifest
/// (L349-351) plus staging helper writeSQLTransactionsProject
/// (L353-373); fixture compiler/testdata/current/sql/transactions.can;
/// assert leg (L410-417).
/// Disposition: migrate (this row ports TestCurrentSQLTransactions to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): static staged inventory as the green
/// baseline: the transactions.can fixture path, the can.project.json
/// and can.errors.json names, the empty starting error registry, the
/// src/main.can entry, the source_root/error_registry manifest keys,
/// the parameter and row type bindings, and the assert leg green
/// (exit 0, empty diagnostics).
/// ADAPTATION (recorded, with source lines): the empty registry pins
/// the exact L371 JSON bytes; type bindings pin the manifest spellings
/// (L350-351) rather than the fixture record bodies; the assert
/// exit/diag predicates (L411) pin the leg green without claiming a
/// live run (accept_after P23 unmet).
/// Facet map (sql_test.go legs): fixture-path pins transactions.can
/// (L356); project-name pins can.project.json (L370); errors-name pins
/// can.errors.json (L371); errors-empty pins the empty registry
/// (L371); entry-src pins src/main.can (L372); source-root-key and
/// error-registry-key pin the manifest keys (L349); param-search-type
/// pins app::search_parameters (L350); param-id-type pins
/// app::id_parameters (L351); row-account-type pins app::account_row
/// (L350-351); assert-exit pins exit 0 (L411); assert-diag-empty pins
/// empty diagnostics (L411).
/// Report/descriptor semantics live in
/// history-003-tx-semantics.can; the build/emitted/negative
/// shape lives in history-003-run-shape.can.
/// Variants: none in this file (default only); descriptor
/// cardinalities live in tx-semantics.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates SUITE/CAN/BUILD/DIAG/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 240000ms mirrors the Go
/// 4-minute ctx (L380).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/tx-roots checks: fixture-path, project-name,
/// errors-name, errors-empty, entry-src, source-root-key,
/// error-registry-key, param-search-type, param-id-type,
/// row-account-type, assert-exit, assert-diag-empty.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str fixture_path
    str project_name
    str errors_name
    str errors_empty
    str entry_src
    str source_root_key
    str error_registry_key
    str param_search_type
    str param_id_type
    str row_account_type
    int assert_exit
    bool assert_diag_empty
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/tx-roots", "default", "", "offline"), "fixture-path" => ok "case history/tx-roots variant default root fixture-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/tx-roots", "default", "", "offline"), "assert-diag-empty" => ok evidence("assert-diag-empty", "true", "true", true, "case history/tx-roots variant default root assert-diag-empty run offline")
        different: false, true, context("history/tx-roots", "default", "", "offline"), "assert-diag-empty" => failed{"assert-diag-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/tx-roots", "default", "", "offline"), "assert-exit" => ok evidence("assert-exit", "0", "0", true, "case history/tx-roots variant default root assert-exit run offline")
        different: 1, 0, context("history/tx-roots", "default", "", "offline"), "assert-exit" => failed{"assert-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "compiler/testdata/current/sql/transactions.can", "compiler/testdata/current/sql/transactions.can", context("history/tx-roots", "default", "", "offline"), "fixture-path" => ok evidence("fixture-path", "compiler/testdata/current/sql/transactions.can", "compiler/testdata/current/sql/transactions.can", true, "case history/tx-roots variant default root fixture-path run offline")
        different: "compiler/testdata/current/sql/other.can", "compiler/testdata/current/sql/transactions.can", context("history/tx-roots", "default", "", "offline"), "fixture-path" => failed{"fixture-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
