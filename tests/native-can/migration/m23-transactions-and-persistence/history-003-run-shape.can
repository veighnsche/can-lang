fn check[] checks
    emits {}
    given
        str scope
    asserts
        m23_h003: "m23-h003" => ok [check("build-cmd", "build leg invokes canlc build"), check("build-id-key", "build report carries the buildID key"), check("build-dir-key", "build report carries the directory key"), check("rebuild-same", "rebuild keeps the same build identity"), check("relocated-same", "relocated build keeps the same build identity"), check("state-path", "emitted state lands at program/state.ts"), check("emit-txns", "emitted state creates the SQL transactions"), check("emit-tx-freeze", "emitted state freezes the transaction runner"), check("emit-with-tx", "emitted state wires withTransaction commit"), check("emit-tx-get", "emitted state pins the tx_get descriptor"), check("emit-query-one", "emitted state wires queryOne"), check("emit-execute", "emitted state wires execute"), check("emit-id-shape", "emitted state pins the int id shape"), check("program-glob", "program units glob packages/*/*.ts"), check("program-count", "exactly one program unit emits"), check("unit-tx-run", "emitted unit runs the transaction"), check("unit-query-0", "emitted unit runs query zero"), check("unit-query-1", "emitted unit runs query one"), check("unit-open", "emitted unit opens pools"), check("unit-close", "emitted unit closes pools"), check("tsc-gate", "strict TypeScript gate reads CAN_TSC"), check("tsc-strict", "strict TypeScript leg passes --strict"), check("neg-count", "four invalid descriptor variants are rejected"), check("neg-cardinality", "wrong cardinality is rejected"), check("neg-param-type", "missing parameter type is rejected"), check("neg-row-type", "row type mismatch is rejected"), check("neg-undeclared", "undeclared descriptor is rejected")]
        other: "nope" => ok []
