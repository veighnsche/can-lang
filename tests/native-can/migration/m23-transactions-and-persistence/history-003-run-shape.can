package m23history003run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-003 "SQL transactions: build/emitted/negative run shape".
/// Source: tests/integration/sql_test.go symbol TestCurrentSQLTransactions
/// (L375-509); build helper buildAt (L418-432); identity legs
/// (L433-445); emitted state/unit needles (L446-478); optional
/// strict TypeScript leg (L479-484); negative manifests (L485-508).
/// Disposition: migrate (this row ports TestCurrentSQLTransactions to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the build/emit/negative shape: the build
/// command with buildID/directory keys, repeated and relocated build
/// identity, the program/state.ts path plus its seven emitted
/// transaction wiring needles, the single packages/*/*.ts program
/// unit with its transaction/query/pool calls, the optional CAN_TSC
/// strict leg, and the four negative manifests with their rejection
/// needles.
/// ADAPTATION (recorded, with source lines): rebuild-same and
/// relocated-same pin the L435/L443 equality predicates as bool
/// expectations; emit needles pin the exact L451-456/L471-473 source
/// spellings; tsc pins record the optional leg (CAN_TSC unset skips)
/// without claiming a live run (accept_after P23 unmet); negative
/// needles pin the L490-493 want strings.
/// Facet map (sql_test.go legs): build-cmd pins build (L420);
/// build-id-key and build-dir-key pin buildID/directory (L425-426);
/// rebuild-same pins the rebuild predicate (L435-436);
/// relocated-same pins the relocated predicate (L443-444); state-path
/// pins program/state.ts (L446); emit-txns, emit-tx-freeze,
/// emit-with-tx, emit-tx-get, emit-query-one, emit-execute and
/// emit-id-shape pin the state needles (L451-456); program-glob pins
/// packages/*/*.ts (L462); program-count pins one unit (L463);
/// unit-tx-run, unit-query-0, unit-query-1, unit-open and unit-close
/// pin the unit calls (L471-473); tsc-gate pins CAN_TSC (L479);
/// tsc-strict pins --strict (L480); neg-count pins four negatives
/// (L485); neg-cardinality, neg-param-type, neg-row-type and
/// neg-undeclared pin the rejection needles (L490-493).
/// Report/descriptor semantics live in
/// history-003-tx-semantics.can; the roots-green pin lives in
/// history-003-roots-green.can.
/// Variants: negative manifest cardinality, parameter type, row type,
/// undeclared (the L485 table, in order); each carries its rejection
/// needle.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive;
/// CAN_TSC optional.
/// Logical gates SUITE/CAN/BUILD/DIAG/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 240000ms mirrors the Go
/// 4-minute ctx (L380).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/tx-run checks: build-cmd, build-id-key,
/// build-dir-key, rebuild-same, relocated-same, state-path,
/// emit-txns, emit-tx-freeze, emit-with-tx, emit-tx-get,
/// emit-query-one, emit-execute, emit-id-shape, program-glob,
/// program-count, unit-tx-run, unit-query-0, unit-query-1, unit-open,
/// unit-close, tsc-gate, tsc-strict, neg-count, neg-cardinality,
/// neg-param-type, neg-row-type, neg-undeclared.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str build_cmd
    str build_id_key
    str build_dir_key
    bool rebuild_same
    bool relocated_same
    str state_path
    str emit_txns
    str emit_tx_freeze
    str emit_with_tx
    str emit_tx_get
    str emit_query_one
    str emit_execute
    str emit_id_shape
    str program_glob
    int program_count
    str unit_tx_run
    str unit_query_0
    str unit_query_1
    str unit_open
    str unit_close
    str tsc_gate
    str tsc_strict
    int neg_count
    str neg_cardinality
    str neg_param_type
    str neg_row_type
    str neg_undeclared
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/tx-run", "default", "", "offline"), "build-cmd" => ok "case history/tx-run variant default root build-cmd run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/tx-run", "default", "", "offline"), "rebuild-same" => ok evidence("rebuild-same", "true", "true", true, "case history/tx-run variant default root rebuild-same run offline")
        different: false, true, context("history/tx-run", "default", "", "offline"), "rebuild-same" => failed{"rebuild-same"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/tx-run", "default", "", "offline"), "program-count" => ok evidence("program-count", "1", "1", true, "case history/tx-run variant default root program-count run offline")
        different: 2, 1, context("history/tx-run", "default", "", "offline"), "program-count" => failed{"program-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "build", "build", context("history/tx-run", "default", "", "offline"), "build-cmd" => ok evidence("build-cmd", "build", "build", true, "case history/tx-run variant default root build-cmd run offline")
        different: "compile", "build", context("history/tx-run", "default", "", "offline"), "build-cmd" => failed{"build-cmd"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
