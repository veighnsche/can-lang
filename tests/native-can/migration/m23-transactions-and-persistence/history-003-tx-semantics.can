package m23history003tx
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-003 "SQL transactions: assert report and descriptor semantics".
/// Source: tests/integration/sql_test.go symbol TestCurrentSQLTransactions
/// (L375-509); manifest sqlTransactionsManifest (L349-351); staging helper
/// writeSQLTransactionsProject (L353-373); assert leg (L410-417); fixture
/// compiler/testdata/current/sql/transactions.can (twelve assert roots).
/// Disposition: migrate (this row ports TestCurrentSQLTransactions to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the gated assert contract, the two descriptor
/// bindings, and the twelve supplied assertion roots: the
/// CAN_BUN_ARCHIVE gate plus its skip message, the 4-minute context,
/// the offline sandbox invocation shape, the assert command with exit
/// 0, the report keys plus the twelve-root count, the two descriptor
/// names in manifest order, the two bound cardinalities
/// (execute/one), the postgresql dialect, the row_limit_parameter pin,
/// and each root fn::assert name with its expected verdict.
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (4) from 4*time.Minute (L380); per-descriptor pins
/// mirror the L350-351 manifest rows as static expectations, one
/// load-bearing pin per behavior; each root pin joins the fixture fn
/// name, assert name and verdict line as "fn::assert => verdict".
/// Facet map (sql_test.go legs): env-gate pins CAN_BUN_ARCHIVE (L376);
/// skip-needle pins the skip message (L378); ctx-timeout-min pins 4
/// (L380); sandbox-profile pins the deny-network profile (L393);
/// offline-path pins PATH=/nonexistent (L397); canlc-bin pins
/// bin/canlc (L393); assert-cmd pins assert (L410); assert-exit pins
/// exit 0 (L411); report-passed, report-passed-key,
/// report-assertions-key and report-root-count pin the report
/// predicate (L415); desc-count plus desc-tx-add/desc-tx-get pin the
/// two manifest names in order (L350-351); card-execute/card-one pin
/// the bound cardinalities (L350-351); dialect pins postgresql
/// (L350); row-limit-param pins 2 (L351); root-decide-add,
/// root-decide-rollback, root-decide-fetch-sample,
/// root-decide-fetch-missing, root-decide-inner, root-decide-nested,
/// root-run-add, root-run-rollback, root-run-fetch, root-run-nested,
/// root-main-empty and root-main-badop pin the twelve fixture assert
/// roots with their expected verdicts.
/// The roots-green pin lives in history-003-roots-green.can; the
/// build/emitted/negative shape lives in history-003-run-shape.can.
/// Variants: none in this file (default only); the four negative
/// manifests live in run-shape.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates SUITE/CAN/BUILD/DIAG/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 240000ms mirrors the Go
/// 4-minute ctx (L380).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/tx checks: env-gate, skip-needle,
/// ctx-timeout-min, sandbox-profile, offline-path, canlc-bin,
/// assert-cmd, assert-exit, report-passed, report-passed-key,
/// report-assertions-key, report-root-count, desc-count, desc-tx-add,
/// desc-tx-get, card-execute, card-one, dialect, row-limit-param,
/// root-decide-add, root-decide-rollback, root-decide-fetch-sample,
/// root-decide-fetch-missing, root-decide-inner, root-decide-nested,
/// root-run-add, root-run-rollback, root-run-fetch, root-run-nested,
/// root-main-empty, root-main-badop.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_gate
    str skip_needle
    int ctx_timeout_min
    str sandbox_profile
    str offline_path
    str canlc_bin
    str assert_cmd
    int assert_exit
    bool report_passed
    str report_passed_key
    str report_assertions_key
    int report_root_count
    int desc_count
    str desc_tx_add
    str desc_tx_get
    str card_execute
    str card_one
    str dialect
    int row_limit_param
    str root_decide_add
    str root_decide_rollback
    str root_decide_fetch_sample
    str root_decide_fetch_missing
    str root_decide_inner
    str root_decide_nested
    str root_run_add
    str root_run_rollback
    str root_run_fetch
    str root_run_nested
    str root_main_empty
    str root_main_badop
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/tx", "default", "", "offline"), "env-gate" => ok "case history/tx variant default root env-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/tx", "default", "", "offline"), "report-passed" => ok evidence("report-passed", "true", "true", true, "case history/tx variant default root report-passed run offline")
        different: false, true, context("history/tx", "default", "", "offline"), "report-passed" => failed{"report-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/tx", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "4", "4", true, "case history/tx variant default root ctx-timeout-min run offline")
        different: 3, 4, context("history/tx", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("history/tx", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case history/tx variant default root env-gate run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("history/tx", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
