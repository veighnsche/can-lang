package m23history004live
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-004 "live SQL transactions: commit and rollback semantics".
/// Source: tests/integration/sql_test.go symbol TestCurrentSQLTransactionsLive
/// (L518-677); ok (L636-643) and fault (L644-651) contracts with the
/// thirteen answer vectors (L655-675).
/// Disposition: migrate (this row ports TestCurrentSQLTransactionsLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the thirteen compiled-CLI answers over the
/// live PostgreSQL 17 seed: commit persistence versus rollback absence,
/// sequence ids 7/8/9/10 distinguishing committed, conflicting and
/// rolled-back writes, with invalid codec input, nested fallback
/// rollback and refused connection staying distinct outcomes.
/// ADAPTATION (recorded, with source lines): fault codes pin bare
/// (codec::invalid_data and sql::connection_failed) while Go wraps each
/// want as a Contains needle error-colon-plus-code-plus-quote (L648,
/// L673); the wrap prefix itself pins in history-004-run-shape.can; the
/// nested leg pins its -1 fallback stdout (L669) with the inner 7 it
/// replaces cited as the seed drift (L666-668); commit and rollback
/// args pass strconv.Quote strings (L657/L659-661/L672), cited in the
/// check titles by bare name.
/// NOTE (source discrepancy): the transactions.sql seed comment says the
/// later Yara commit takes 9, but the test comment (L652-654) plus the
/// legs (L662-664) say Yara lands at 10 with 8 and 9 both absent; the
/// legs pin here and the stale seed comment does not.
/// Facet map (sql_test.go legs): fetch-hit pins the Bob id (L655);
/// fetch-missing pins zero rows (L656); commit-first pins 1 (L657);
/// fetch-committed pins the committed Zed id (L658);
/// commit-duplicate pins 0 (L659); rollback-absent pins 1 (L660);
/// commit-yara pins 1 (L661); fetch-yara pins the Yara id (L662);
/// fetch-conflict-gap pins zero rows for id 8 (L663);
/// fetch-rollback-gap pins zero rows for id 9 (L664);
/// fetch-invalid pins codec::invalid_data (L665); nested-fallback pins
/// -1 (L669); refused-error pins sql::connection_failed (L673).
/// The roots-green pin lives in history-004-roots-green.can; the
/// fd-3 delivery plus ok/fault run shape lives in
/// history-004-run-shape.can.
/// Variants: fetch present/missing/committed/gap, commit first/
/// duplicate/Yara, rollback absent, nested fallback, refused port (all
/// thirteen legs in Go order).
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK/ENV and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1/QF1
/// are unmet. Descriptor timeout 360000ms mirrors the Go 6-minute
/// ctx (L539).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QF1 unmet).
/// Case history/live-transactions checks: fetch-hit, fetch-missing,
/// commit-first, fetch-committed, commit-duplicate, rollback-absent,
/// commit-yara, fetch-yara, fetch-conflict-gap, fetch-rollback-gap,
/// fetch-invalid, nested-fallback, refused-error.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str fetch_hit
    str fetch_missing
    str commit_first
    str fetch_committed
    str commit_duplicate
    str rollback_absent
    str commit_yara
    str fetch_yara
    str fetch_conflict_gap
    str fetch_rollback_gap
    str fetch_invalid
    str nested_fallback
    str refused_error
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body

fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/live-transactions", "default", "", "offline"), "fetch-hit" => ok "case history/live-transactions variant default root fetch-hit run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/live-transactions", "default", "", "offline"), "fetch-hit" => ok evidence("fetch-hit", "true", "true", true, "case history/live-transactions variant default root fetch-hit run offline")
        different: false, true, context("history/live-transactions", "default", "", "offline"), "fetch-hit" => failed{"fetch-hit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/live-transactions", "default", "", "offline"), "fetch-hit" => ok evidence("fetch-hit", "0", "0", true, "case history/live-transactions variant default root fetch-hit run offline")
        different: 1, 0, context("history/live-transactions", "default", "", "offline"), "fetch-hit" => failed{"fetch-hit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "4", "4", context("history/live-transactions", "default", "", "offline"), "fetch-hit" => ok evidence("fetch-hit", "4", "4", true, "case history/live-transactions variant default root fetch-hit run offline")
        different: "4_2", "4", context("history/live-transactions", "default", "", "offline"), "fetch-hit" => failed{"fetch-hit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_fetch_hit: "seed-fetch-hit-drift" => ok observation("5", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_fetch_missing: "seed-fetch-missing-drift" => ok observation("4", "1", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_commit_first: "seed-commit-first-drift" => ok observation("4", "0", "2", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_fetch_committed: "seed-fetch-committed-drift" => ok observation("4", "0", "1", "6", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_commit_duplicate: "seed-commit-duplicate-drift" => ok observation("4", "0", "1", "7", "1", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_rollback_absent: "seed-rollback-absent-drift" => ok observation("4", "0", "1", "7", "0", "0", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_commit_yara: "seed-commit-yara-drift" => ok observation("4", "0", "1", "7", "0", "1", "2", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_fetch_yara: "seed-fetch-yara-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "11", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_fetch_conflict_gap: "seed-fetch-conflict-gap-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "1", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_fetch_rollback_gap: "seed-fetch-rollback-gap-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "1", "codec::invalid_data", "-1", "sql::connection_failed")
        seed_fetch_invalid: "seed-fetch-invalid-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::other", "-1", "sql::connection_failed")
        seed_nested_fallback: "seed-nested-fallback-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "7", "sql::connection_failed")
        seed_refused_error: "seed-refused-error-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::other")
    match variant_id
        "seed-fetch-hit-drift" => ok observation("5", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-fetch-missing-drift" => ok observation("4", "1", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-commit-first-drift" => ok observation("4", "0", "2", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-fetch-committed-drift" => ok observation("4", "0", "1", "6", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-commit-duplicate-drift" => ok observation("4", "0", "1", "7", "1", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-rollback-absent-drift" => ok observation("4", "0", "1", "7", "0", "0", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-commit-yara-drift" => ok observation("4", "0", "1", "7", "0", "1", "2", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-fetch-yara-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "11", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-fetch-conflict-gap-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "1", "0", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-fetch-rollback-gap-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "1", "codec::invalid_data", "-1", "sql::connection_failed")
        "seed-fetch-invalid-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::other", "-1", "sql::connection_failed")
        "seed-nested-fallback-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "7", "sql::connection_failed")
        "seed-refused-error-drift" => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::other")
        _ => ok observation("4", "0", "1", "7", "0", "1", "1", "10", "0", "0", "codec::invalid_data", "-1", "sql::connection_failed")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m23_h004: "m23-h004" => ok [check("fetch-hit", "fetch 4 returns the Bob id"), check("fetch-missing", "fetch 999 returns zero rows"), check("commit-first", "commit Zed inserts one row"), check("fetch-committed", "fetch 7 returns the committed Zed id"), check("commit-duplicate", "commit Zed again inserts zero rows"), check("rollback-absent", "rollback TxNo reports one rolled-back row"), check("commit-yara", "commit Yara inserts one row"), check("fetch-yara", "fetch 10 returns the Yara id"), check("fetch-conflict-gap", "fetch 8 returns zero rows for the consumed id"), check("fetch-rollback-gap", "fetch 9 returns zero rows for the rolled-back id"), check("fetch-invalid", "fetch abc refuses codec invalid_data"), check("nested-fallback", "nested attempt falls back to minus one"), check("refused-error", "refused commit refuses connection_failed")]
        other: "nope" => ok []
    match scope is "m23-h004"
        false => ok []
        true => ok [check("fetch-hit", "fetch 4 returns the Bob id"), check("fetch-missing", "fetch 999 returns zero rows"), check("commit-first", "commit Zed inserts one row"), check("fetch-committed", "fetch 7 returns the committed Zed id"), check("commit-duplicate", "commit Zed again inserts zero rows"), check("rollback-absent", "rollback TxNo reports one rolled-back row"), check("commit-yara", "commit Yara inserts one row"), check("fetch-yara", "fetch 10 returns the Yara id"), check("fetch-conflict-gap", "fetch 8 returns zero rows for the consumed id"), check("fetch-rollback-gap", "fetch 9 returns zero rows for the rolled-back id"), check("fetch-invalid", "fetch abc refuses codec invalid_data"), check("nested-fallback", "nested attempt falls back to minus one"), check("refused-error", "refused commit refuses connection_failed")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/live-transactions" => ok [expected_check("fetch-hit", "4"), expected_check("fetch-missing", "0"), expected_check("commit-first", "1"), expected_check("fetch-committed", "7"), expected_check("commit-duplicate", "0"), expected_check("rollback-absent", "1"), expected_check("commit-yara", "1"), expected_check("fetch-yara", "10"), expected_check("fetch-conflict-gap", "0"), expected_check("fetch-rollback-gap", "0"), expected_check("fetch-invalid", "codec::invalid_data"), expected_check("nested-fallback", "-1"), expected_check("refused-error", "sql::connection_failed")]
        unknown: "nope" => ok []
    match case is "history/live-transactions"
        false => ok []
        true => ok [expected_check("fetch-hit", "4"), expected_check("fetch-missing", "0"), expected_check("commit-first", "1"), expected_check("fetch-committed", "7"), expected_check("commit-duplicate", "0"), expected_check("rollback-absent", "1"), expected_check("commit-yara", "1"), expected_check("fetch-yara", "10"), expected_check("fetch-conflict-gap", "0"), expected_check("fetch-rollback-gap", "0"), expected_check("fetch-invalid", "codec::invalid_data"), expected_check("nested-fallback", "-1"), expected_check("refused-error", "sql::connection_failed")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/live-transactions", "default", "", "offline") => ok
        seed_fetch_hit: context("history/live-transactions", "seed-fetch-hit-drift", "", "offline") => failed{"fetch-hit"}
        seed_fetch_missing: context("history/live-transactions", "seed-fetch-missing-drift", "", "offline") => failed{"fetch-missing"}
        seed_commit_first: context("history/live-transactions", "seed-commit-first-drift", "", "offline") => failed{"commit-first"}
        seed_fetch_committed: context("history/live-transactions", "seed-fetch-committed-drift", "", "offline") => failed{"fetch-committed"}
        seed_commit_duplicate: context("history/live-transactions", "seed-commit-duplicate-drift", "", "offline") => failed{"commit-duplicate"}
        seed_rollback_absent: context("history/live-transactions", "seed-rollback-absent-drift", "", "offline") => failed{"rollback-absent"}
        seed_commit_yara: context("history/live-transactions", "seed-commit-yara-drift", "", "offline") => failed{"commit-yara"}
        seed_fetch_yara: context("history/live-transactions", "seed-fetch-yara-drift", "", "offline") => failed{"fetch-yara"}
        seed_fetch_conflict_gap: context("history/live-transactions", "seed-fetch-conflict-gap-drift", "", "offline") => failed{"fetch-conflict-gap"}
        seed_fetch_rollback_gap: context("history/live-transactions", "seed-fetch-rollback-gap-drift", "", "offline") => failed{"fetch-rollback-gap"}
        seed_fetch_invalid: context("history/live-transactions", "seed-fetch-invalid-drift", "", "offline") => failed{"fetch-invalid"}
        seed_nested_fallback: context("history/live-transactions", "seed-nested-fallback-drift", "", "offline") => failed{"nested-fallback"}
        seed_refused_error: context("history/live-transactions", "seed-refused-error-drift", "", "offline") => failed{"refused-error"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.fetch_hit, "4", c, "fetch-hit")
            failed
            ok evidence fetch_hit_evidence => match call require_text(got.fetch_missing, "0", c, "fetch-missing")
                failed
                ok evidence fetch_missing_evidence => match call require_text(got.commit_first, "1", c, "commit-first")
                    failed
                    ok evidence commit_first_evidence => match call require_text(got.fetch_committed, "7", c, "fetch-committed")
                        failed
                        ok evidence fetch_committed_evidence => match call require_text(got.commit_duplicate, "0", c, "commit-duplicate")
                            failed
                            ok evidence commit_duplicate_evidence => match call require_text(got.rollback_absent, "1", c, "rollback-absent")
                                failed
                                ok evidence rollback_absent_evidence => match call require_text(got.commit_yara, "1", c, "commit-yara")
                                    failed
                                    ok evidence commit_yara_evidence => match call require_text(got.fetch_yara, "10", c, "fetch-yara")
                                        failed
                                        ok evidence fetch_yara_evidence => match call require_text(got.fetch_conflict_gap, "0", c, "fetch-conflict-gap")
                                            failed
                                            ok evidence fetch_conflict_gap_evidence => match call require_text(got.fetch_rollback_gap, "0", c, "fetch-rollback-gap")
                                                failed
                                                ok evidence fetch_rollback_gap_evidence => match call require_text(got.fetch_invalid, "codec::invalid_data", c, "fetch-invalid")
                                                    failed
                                                    ok evidence fetch_invalid_evidence => match call require_text(got.nested_fallback, "-1", c, "nested-fallback")
                                                        failed
                                                        ok evidence nested_fallback_evidence => match call require_text(got.refused_error, "sql::connection_failed", c, "refused-error")
                                                            failed
                                                            ok evidence refused_error_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m23_h004: "m23-h004" => ok test_case("history/live-transactions", ["history", "m23"], ["can-bun-archive", "can-test-postgres-url"], 360000, [check_ref("fetch-hit"), check_ref("fetch-missing"), check_ref("commit-first"), check_ref("fetch-committed"), check_ref("commit-duplicate"), check_ref("rollback-absent"), check_ref("commit-yara"), check_ref("fetch-yara"), check_ref("fetch-conflict-gap"), check_ref("fetch-rollback-gap"), check_ref("fetch-invalid"), check_ref("nested-fallback"), check_ref("refused-error")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m23-h004"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/live-transactions", ["history", "m23"], ["can-bun-archive", "can-test-postgres-url"], 360000, [check_ref("fetch-hit"), check_ref("fetch-missing"), check_ref("commit-first"), check_ref("fetch-committed"), check_ref("commit-duplicate"), check_ref("rollback-absent"), check_ref("commit-yara"), check_ref("fetch-yara"), check_ref("fetch-conflict-gap"), check_ref("fetch-rollback-gap"), check_ref("fetch-invalid"), check_ref("nested-fallback"), check_ref("refused-error")], callable case_body)
