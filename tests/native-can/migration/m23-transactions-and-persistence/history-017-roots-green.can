    asserts
        m23_h017: "m23-h017" => ok [check("accounts-table", "accounts fixture table is can_i38_accounts"), check("accounts-rows", "accounts seed carries 6 rows"), check("version-query", "setup reads the server version"), check("version-prefix", "test database must be PostgreSQL 17"), check("accounts-query", "setup counts the accounts rows"), check("count-key", "count query aliases the count key"), check("report-version-key", "setup report carries serverVersion"), check("report-accounts-key", "setup report carries accounts"), check("dropped-key", "teardown report carries dropped"), check("dropped-value", "teardown report drops true")]
        other: "nope" => ok []
    match scope is "m23-h017"
        false => ok []
        true => ok [check("accounts-table", "accounts fixture table is can_i38_accounts"), check("accounts-rows", "accounts seed carries 6 rows"), check("version-query", "setup reads the server version"), check("version-prefix", "test database must be PostgreSQL 17"), check("accounts-query", "setup counts the accounts rows"), check("count-key", "count query aliases the count key"), check("report-version-key", "setup report carries serverVersion"), check("report-accounts-key", "setup report carries accounts"), check("dropped-key", "teardown report carries dropped"), check("dropped-value", "teardown report drops true")]
