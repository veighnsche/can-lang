        known: "history/transactions-roots" => ok [expected_check("accounts-table", "can_i38_accounts"), expected_check("accounts-rows", "6"), expected_check("version-query", "SELECT version()"), expected_check("version-prefix", "PostgreSQL 17."), expected_check("accounts-query", "SELECT COUNT(*)::int AS count FROM can_i38_accounts"), expected_check("count-key", "count"), expected_check("report-version-key", "serverVersion"), expected_check("report-accounts-key", "accounts"), expected_check("dropped-key", "dropped"), expected_check("dropped-value", "true")]
