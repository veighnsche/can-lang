package m23history017roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-017 "transactions-driver.ts: fixture inventory, roots green".
/// Source: tests/integration/testdata/sql/transactions-driver.ts symbol
/// transactions-driver.ts (L47-56 version/count/report legs); related
/// fixture tests/integration/testdata/sql/transactions.sql (L10-23;
/// retained by HISTORY-022, read here for row counts only).
/// Disposition: migrate (this row ports transactions-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the static inventory as the green baseline:
/// the fixture table, its seeded row count, the version and count
/// queries, the count key, the setup report keys, and the teardown
/// report green (dropped key plus true).
/// ADAPTATION (recorded, with source lines): accounts-rows (6) counts
/// the sql L17-22 value rows (counts, not source literals); the
/// escaped/non-ASCII row values (quoted quote, accented name) are
/// deliberately not pinned as literals here (count pins avoid encoding
/// drift; value semantics belong to HISTORY-022/live rows).
/// Facet map (transactions-driver.ts legs): accounts-table pins
/// can_i38_accounts (driver L52; sql L10); accounts-rows pins 6 (sql
/// L17-22; observed by L52); version-query pins SELECT version()
/// (L47); version-prefix pins PostgreSQL 17. (L49); accounts-query
/// pins the L52 count query; count-key pins count (L52);
/// report-version-key and report-accounts-key pin
/// serverVersion/accounts (L53); dropped-key pins dropped (L56);
/// dropped-value pins true (L56).
/// Seed semantics live in history-017-seed-semantics.can; the
/// invocation/run shape lives in history-017-run-shape.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in transactions-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/transactions-roots checks: accounts-table,
/// accounts-rows, version-query, version-prefix, accounts-query,
/// count-key, report-version-key, report-accounts-key, dropped-key,
/// dropped-value.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str accounts_table
    int accounts_rows
    str version_query
    str version_prefix
    str accounts_query
    str count_key
    str report_version_key
    str report_accounts_key
    str dropped_key
    bool dropped_value
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/transactions-roots", "default", "", "offline"), "accounts-table" => ok "case history/transactions-roots variant default root accounts-table run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/transactions-roots", "default", "", "offline"), "dropped-value" => ok evidence("dropped-value", "true", "true", true, "case history/transactions-roots variant default root dropped-value run offline")
        different: false, true, context("history/transactions-roots", "default", "", "offline"), "dropped-value" => failed{"dropped-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/transactions-roots", "default", "", "offline"), "accounts-rows" => ok evidence("accounts-rows", "6", "6", true, "case history/transactions-roots variant default root accounts-rows run offline")
        different: 7, 6, context("history/transactions-roots", "default", "", "offline"), "accounts-rows" => failed{"accounts-rows"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can_i38_accounts", "can_i38_accounts", context("history/transactions-roots", "default", "", "offline"), "accounts-table" => ok evidence("accounts-table", "can_i38_accounts", "can_i38_accounts", true, "case history/transactions-roots variant default root accounts-table run offline")
        different: "can_i38_accounts2", "can_i38_accounts", context("history/transactions-roots", "default", "", "offline"), "accounts-table" => failed{"accounts-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        seed_accounts_table: "seed-accounts-table-drift" => ok observation("can_i38_accounts2", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        seed_accounts_rows: "seed-accounts-rows-drift" => ok observation("can_i38_accounts", 5, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        seed_version_query: "seed-version-query-drift" => ok observation("can_i38_accounts", 6, "SELECT version", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        seed_version_prefix: "seed-version-prefix-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 16.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        seed_accounts_query: "seed-accounts-query-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts2", "count", "serverVersion", "accounts", "dropped", true)
        seed_count_key: "seed-count-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "cnt", "serverVersion", "accounts", "dropped", true)
        seed_report_version_key: "seed-report-version-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverversion", "accounts", "dropped", true)
        seed_report_accounts_key: "seed-report-accounts-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "account", "dropped", true)
        seed_dropped_key: "seed-dropped-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "drop", true)
        seed_dropped_value: "seed-dropped-value-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", false)
    match variant_id
        "seed-accounts-table-drift" => ok observation("can_i38_accounts2", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        "seed-accounts-rows-drift" => ok observation("can_i38_accounts", 5, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        "seed-version-query-drift" => ok observation("can_i38_accounts", 6, "SELECT version", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        "seed-version-prefix-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 16.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
        "seed-accounts-query-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts2", "count", "serverVersion", "accounts", "dropped", true)
        "seed-count-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "cnt", "serverVersion", "accounts", "dropped", true)
        "seed-report-version-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverversion", "accounts", "dropped", true)
        "seed-report-accounts-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "account", "dropped", true)
        "seed-dropped-key-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "drop", true)
        "seed-dropped-value-drift" => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", false)
        _ => ok observation("can_i38_accounts", 6, "SELECT version()", "PostgreSQL 17.", "SELECT COUNT(*)::int AS count FROM can_i38_accounts", "count", "serverVersion", "accounts", "dropped", true)
