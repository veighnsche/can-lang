package m23history017run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-017 "transactions-driver.ts: invocation/run shape".
/// Source: tests/integration/testdata/sql/transactions-driver.ts symbol
/// transactions-driver.ts (L15-21 arg/env legs, L44/L55 apply order,
/// L50 version refusal, L63-65 error leg).
/// Disposition: migrate (this row ports transactions-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the invocation/run shape: the two modes and
/// their argv positions, the env gate, every refusal message, the URL
/// guards, the version slice/refusal, the setup/teardown statement
/// order, and the error report shape.
/// ADAPTATION (recorded, with source lines): setup-first/setup-last/
/// teardown-only pin the L34 destructured binding names at their
/// L44/L55 use sites (scenario statement identities, not SQL text);
/// url-space pins the single-space needle of the L21 includes guard;
/// unknown-mode and version-refusal pin static template prefixes
/// (L18/L50).
/// Facet map (transactions-driver.ts legs): mode-setup pins setup
/// (L15/L18/L43); mode-teardown pins teardown (L15/L18/L54); mode-arg
/// pins 2 (L15); seed-arg pins 3 (L16); env-gate pins
/// CAN_TEST_POSTGRES_URL (L17); unknown-mode pins the L18 template
/// prefix; missing-seed pins the L19 message; unset-db pins the L20
/// message; url-space pins the space needle (L21); url-scheme pins
/// postgres (L21); url-refusal pins the L21 message; version-slice
/// pins 80 (L50); version-refusal pins the L50 template prefix;
/// setup-first pins resetAccounts (L34/L44); setup-last pins
/// insertAccounts (L34/L44); teardown-only pins dropAccounts (L34/L55);
/// error-key pins error (L64); error-exit pins 1 (L65).
/// Seed semantics live in history-017-seed-semantics.can; the
/// roots-green pin lives in history-017-roots-green.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in transactions-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/transactions-run checks: mode-setup, mode-teardown,
/// mode-arg, seed-arg, env-gate, unknown-mode, missing-seed, unset-db,
/// url-space, url-scheme, url-refusal, version-slice, version-refusal,
/// setup-first, setup-last, teardown-only, error-key, error-exit.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str mode_setup
    str mode_teardown
    int mode_arg
    int seed_arg
    str env_gate
    str unknown_mode
    str missing_seed
    str unset_db
    str url_space
    str url_scheme
    str url_refusal
    int version_slice
    str version_refusal
    str setup_first
    str setup_last
    str teardown_only
    str error_key
    int error_exit
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/transactions-run", "default", "", "offline"), "mode-setup" => ok "case history/transactions-run variant default root mode-setup run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/transactions-run", "default", "", "offline"), "mode-setup" => ok evidence("mode-setup", "true", "true", true, "case history/transactions-run variant default root mode-setup run offline")
        different: false, true, context("history/transactions-run", "default", "", "offline"), "mode-setup" => failed{"mode-setup"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/transactions-run", "default", "", "offline"), "mode-arg" => ok evidence("mode-arg", "2", "2", true, "case history/transactions-run variant default root mode-arg run offline")
        different: 3, 2, context("history/transactions-run", "default", "", "offline"), "mode-arg" => failed{"mode-arg"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "setup", "setup", context("history/transactions-run", "default", "", "offline"), "mode-setup" => ok evidence("mode-setup", "setup", "setup", true, "case history/transactions-run variant default root mode-setup run offline")
        different: "setup2", "setup", context("history/transactions-run", "default", "", "offline"), "mode-setup" => failed{"mode-setup"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
