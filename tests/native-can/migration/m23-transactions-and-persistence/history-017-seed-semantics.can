package m23history017seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-017 "transactions-driver.ts: five-statement seed shape semantics".
/// Source: tests/integration/testdata/sql/transactions-driver.ts symbol
/// transactions-driver.ts (L26-42 seed parse/shape/setup legs); related
/// fixture tests/integration/testdata/sql/transactions.sql (L10-23 five
/// statements in seed order).
/// Disposition: migrate (this row ports transactions-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the seed-file shape contract: the comment
/// filter and statement split, the five-statement count gate, the five
/// per-position kind pins in seed order, both refusal messages, and
/// the setup/teardown apply counts.
/// ADAPTATION (recorded, with source lines): the setup-apply pin (4)
/// counts the L44 array elements and teardown-drops (1) counts the
/// L55 await (counts, not source literals, per the M12 app-count
/// precedent); the kind pins mirror startsWith prefixes (L37-39), not
/// full statements; count-message pins the static template prefix
/// (L33).
/// Facet map (transactions-driver.ts legs): stmt-count pins 5 (L33);
/// comment-prefix pins -- (L28); stmt-split pins ; (L30);
/// s1-reset-accounts pins DROP TABLE (L37; sql L10);
/// s2-create-accounts pins CREATE TABLE (L38; sql L11);
/// s3-truncate-accounts pins TRUNCATE (L38; sql L15);
/// s4-insert-accounts pins INSERT INTO (L39; sql L16); s5-drop-accounts
/// pins DROP TABLE (L39; sql L23); count-message pins the L33 template
/// prefix; shape-refusal pins the L41 refusal; setup-apply pins 4
/// (L44); teardown-drops pins 1 (L55).
/// The roots-green pin lives in history-017-roots-green.can; the
/// invocation/run shape lives in history-017-run-shape.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in transactions-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/transactions-seed checks: stmt-count, comment-prefix,
/// stmt-split, s1-reset-accounts, s2-create-accounts,
/// s3-truncate-accounts, s4-insert-accounts, s5-drop-accounts,
/// count-message, shape-refusal, setup-apply, teardown-drops.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int stmt_count
    str comment_prefix
    str stmt_split
    str s1_reset_accounts
    str s2_create_accounts
    str s3_truncate_accounts
    str s4_insert_accounts
    str s5_drop_accounts
    str count_message
    str shape_refusal
    int setup_apply
    int teardown_drops
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/transactions-seed", "default", "", "offline"), "stmt-count" => ok "case history/transactions-seed variant default root stmt-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/transactions-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "true", "true", true, "case history/transactions-seed variant default root stmt-count run offline")
        different: false, true, context("history/transactions-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("history/transactions-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "5", "5", true, "case history/transactions-seed variant default root stmt-count run offline")
        different: 6, 5, context("history/transactions-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "--", "--", context("history/transactions-seed", "default", "", "offline"), "comment-prefix" => ok evidence("comment-prefix", "--", "--", true, "case history/transactions-seed variant default root comment-prefix run offline")
        different: "--2", "--", context("history/transactions-seed", "default", "", "offline"), "comment-prefix" => failed{"comment-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
