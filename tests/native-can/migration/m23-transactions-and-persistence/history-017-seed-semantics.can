    asserts
        known: "history/transactions-seed" => ok [expected_check("stmt-count", "5"), expected_check("comment-prefix", "--"), expected_check("stmt-split", ";"), expected_check("s1-reset-accounts", "DROP TABLE"), expected_check("s2-create-accounts", "CREATE TABLE"), expected_check("s3-truncate-accounts", "TRUNCATE"), expected_check("s4-insert-accounts", "INSERT INTO"), expected_check("s5-drop-accounts", "DROP TABLE"), expected_check("count-message", "seed file must hold 5 statements, saw "), expected_check("shape-refusal", "seed file shape changed; refusing to run setup/teardown"), expected_check("setup-apply", "4"), expected_check("teardown-drops", "1")]
        unknown: "nope" => ok []
    match case is "history/transactions-seed"
        false => ok []
        true => ok [expected_check("stmt-count", "5"), expected_check("comment-prefix", "--"), expected_check("stmt-split", ";"), expected_check("s1-reset-accounts", "DROP TABLE"), expected_check("s2-create-accounts", "CREATE TABLE"), expected_check("s3-truncate-accounts", "TRUNCATE"), expected_check("s4-insert-accounts", "INSERT INTO"), expected_check("s5-drop-accounts", "DROP TABLE"), expected_check("count-message", "seed file must hold 5 statements, saw "), expected_check("shape-refusal", "seed file shape changed; refusing to run setup/teardown"), expected_check("setup-apply", "4"), expected_check("teardown-drops", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/transactions-seed", "default", "", "offline") => ok
        seed_stmt_count: context("history/transactions-seed", "seed-stmt-count-drift", "", "offline") => failed{"stmt-count"}
        seed_comment_prefix: context("history/transactions-seed", "seed-comment-prefix-drift", "", "offline") => failed{"comment-prefix"}
        seed_stmt_split: context("history/transactions-seed", "seed-stmt-split-drift", "", "offline") => failed{"stmt-split"}
        seed_s1_reset_accounts: context("history/transactions-seed", "seed-s1-reset-accounts-drift", "", "offline") => failed{"s1-reset-accounts"}
        seed_s2_create_accounts: context("history/transactions-seed", "seed-s2-create-accounts-drift", "", "offline") => failed{"s2-create-accounts"}
        seed_s3_truncate_accounts: context("history/transactions-seed", "seed-s3-truncate-accounts-drift", "", "offline") => failed{"s3-truncate-accounts"}
        seed_s4_insert_accounts: context("history/transactions-seed", "seed-s4-insert-accounts-drift", "", "offline") => failed{"s4-insert-accounts"}
        seed_s5_drop_accounts: context("history/transactions-seed", "seed-s5-drop-accounts-drift", "", "offline") => failed{"s5-drop-accounts"}
        seed_count_message: context("history/transactions-seed", "seed-count-message-drift", "", "offline") => failed{"count-message"}
        seed_shape_refusal: context("history/transactions-seed", "seed-shape-refusal-drift", "", "offline") => failed{"shape-refusal"}
        seed_setup_apply: context("history/transactions-seed", "seed-setup-apply-drift", "", "offline") => failed{"setup-apply"}
        seed_teardown_drops: context("history/transactions-seed", "seed-teardown-drops-drift", "", "offline") => failed{"teardown-drops"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.stmt_count, 5, c, "stmt-count")
            failed
            ok evidence stmt_count_evidence => match call require_text(got.comment_prefix, "--", c, "comment-prefix")
                failed
                ok evidence comment_prefix_evidence => match call require_text(got.stmt_split, ";", c, "stmt-split")
                    failed
                    ok evidence stmt_split_evidence => match call require_text(got.s1_reset_accounts, "DROP TABLE", c, "s1-reset-accounts")
                        failed
                        ok evidence s1_reset_accounts_evidence => match call require_text(got.s2_create_accounts, "CREATE TABLE", c, "s2-create-accounts")
                            failed
                            ok evidence s2_create_accounts_evidence => match call require_text(got.s3_truncate_accounts, "TRUNCATE", c, "s3-truncate-accounts")
                                failed
                                ok evidence s3_truncate_accounts_evidence => match call require_text(got.s4_insert_accounts, "INSERT INTO", c, "s4-insert-accounts")
                                    failed
                                    ok evidence s4_insert_accounts_evidence => match call require_text(got.s5_drop_accounts, "DROP TABLE", c, "s5-drop-accounts")
                                        failed
                                        ok evidence s5_drop_accounts_evidence => match call require_text(got.count_message, "seed file must hold 5 statements, saw ", c, "count-message")
                                            failed
                                            ok evidence count_message_evidence => match call require_text(got.shape_refusal, "seed file shape changed; refusing to run setup/teardown", c, "shape-refusal")
                                                failed
                                                ok evidence shape_refusal_evidence => match call require_int(got.setup_apply, 4, c, "setup-apply")
                                                    failed
                                                    ok evidence setup_apply_evidence => match call require_int(got.teardown_drops, 1, c, "teardown-drops")
                                                        failed
                                                        ok evidence teardown_drops_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m23_h017: "m23-h017" => ok test_case("history/transactions-seed", ["history", "m23"], ["can-test-postgres-url"], 0, [check_ref("stmt-count"), check_ref("comment-prefix"), check_ref("stmt-split"), check_ref("s1-reset-accounts"), check_ref("s2-create-accounts"), check_ref("s3-truncate-accounts"), check_ref("s4-insert-accounts"), check_ref("s5-drop-accounts"), check_ref("count-message"), check_ref("shape-refusal"), check_ref("setup-apply"), check_ref("teardown-drops")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m23-h017"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/transactions-seed", ["history", "m23"], ["can-test-postgres-url"], 0, [check_ref("stmt-count"), check_ref("comment-prefix"), check_ref("stmt-split"), check_ref("s1-reset-accounts"), check_ref("s2-create-accounts"), check_ref("s3-truncate-accounts"), check_ref("s4-insert-accounts"), check_ref("s5-drop-accounts"), check_ref("count-message"), check_ref("shape-refusal"), check_ref("setup-apply"), check_ref("teardown-drops")], callable case_body)
