fn check[] checks
    emits {}
    given
        str scope
    asserts
        m23_h017: "m23-h017" => ok [check("stmt-count", "seed file holds exactly 5 statements"), check("comment-prefix", "seed parse filters -- comment lines"), check("stmt-split", "seed parse splits statements on ;"), check("s1-reset-accounts", "seed statement 1 resets the accounts table"), check("s2-create-accounts", "seed statement 2 creates the accounts table"), check("s3-truncate-accounts", "seed statement 3 truncates accounts"), check("s4-insert-accounts", "seed statement 4 inserts accounts rows"), check("s5-drop-accounts", "seed statement 5 drops the accounts table"), check("count-message", "wrong statement count refuses with the count message"), check("shape-refusal", "changed seed shape refuses setup/teardown"), check("setup-apply", "setup applies the first 4 statements"), check("teardown-drops", "teardown runs the 1 drop statement")]
        other: "nope" => ok []
    match scope is "m23-h017"
        false => ok []
        true => ok [check("stmt-count", "seed file holds exactly 5 statements"), check("comment-prefix", "seed parse filters -- comment lines"), check("stmt-split", "seed parse splits statements on ;"), check("s1-reset-accounts", "seed statement 1 resets the accounts table"), check("s2-create-accounts", "seed statement 2 creates the accounts table"), check("s3-truncate-accounts", "seed statement 3 truncates accounts"), check("s4-insert-accounts", "seed statement 4 inserts accounts rows"), check("s5-drop-accounts", "seed statement 5 drops the accounts table"), check("count-message", "wrong statement count refuses with the count message"), check("shape-refusal", "changed seed shape refuses setup/teardown"), check("setup-apply", "setup applies the first 4 statements"), check("teardown-drops", "teardown runs the 1 drop statement")]
