package m23history022roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M23 HISTORY-022 "transactions.sql: schema and seed rows byte truth".
/// Source: tests/integration/testdata/sql/transactions.sql (961
/// bytes, 23 lines, md5 dc8e13a82f81b0bd5ab70e939a733eb5).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the schema and seed values: the table
/// name, both column-definition lines verbatim (leading 2-space
/// indents and trailing comma included), the expected starting row
/// count (6 accounts), the five ASCII seed rows verbatim, and an
/// md5 pin for the non-ASCII row (L22).
/// ADAPTATION (recorded, with source lines): verbatim pins cover
/// printable-ASCII lines only; L22 carries a non-ASCII name byte
/// sequence (Zo + U+00EB as UTF-8 C3 AB), so that row pins md5
/// over the exact line bytes including the trailing newline
/// (sed -n '22p' transactions.sql | md5) instead of a literal.
/// Facet map (transactions.sql legs): accounts-table pins
/// can_i38_accounts (L10); id-col pins the L12 line; name-col
/// the L13 line; accounts-rows pins 6 (L17-22); row-ann pins
/// the L17 line; row-jason the L18 line; row-mason the L19
/// line; row-bob the L20 line; row-obrien the L21 line;
/// row-zoe-md5 the L22 digest.
/// Seed semantics live in history-022-seed-semantics.can; the
/// invocation/run shape lives in history-022-run-shape.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/transactions-roots checks: accounts-table, id-col,
/// name-col, accounts-rows, row-ann, row-jason, row-mason,
/// row-bob, row-obrien, row-zoe-md5.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str accounts_table
    str id_col
    str name_col
    int accounts_rows
    str row_ann
    str row_jason
    str row_mason
    str row_bob
    str row_obrien
    str row_zoe_md5
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/transactions-roots", "default", "", "offline"), "accounts-table" => ok "case history/transactions-roots variant default root accounts-table run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/transactions-roots", "default", "", "offline"), "accounts-table" => ok evidence("accounts-table", "true", "true", true, "case history/transactions-roots variant default root accounts-table run offline")
        different: false, true, context("history/transactions-roots", "default", "", "offline"), "accounts-table" => failed{"accounts-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/transactions-roots", "default", "", "offline"), "accounts-rows" => ok evidence("accounts-rows", "6", "6", true, "case history/transactions-roots variant default root accounts-rows run offline")
        different: 7, 6, context("history/transactions-roots", "default", "", "offline"), "accounts-rows" => failed{"accounts-rows"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can_i38_accounts", "can_i38_accounts", context("history/transactions-roots", "default", "", "offline"), "accounts-table" => ok evidence("accounts-table", "can_i38_accounts", "can_i38_accounts", true, "case history/transactions-roots variant default root accounts-table run offline")
        different: "can_i38_accounts2", "can_i38_accounts", context("history/transactions-roots", "default", "", "offline"), "accounts-table" => failed{"accounts-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_accounts_table: "seed-accounts-table-drift" => ok observation("can_i38_accounts2", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_id_col: "seed-id-col-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,2", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_name_col: "seed-name-col-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE2", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_accounts_rows: "seed-accounts-rows-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 5, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_row_ann: "seed-row-ann-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),2", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_row_jason: "seed-row-jason-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),2", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_row_mason: "seed-row-mason-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),2", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_row_bob: "seed-row-bob-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),2", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        seed_row_obrien: "seed-row-obrien-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),2", "6854f67df857eb67dabd1246ca95eaa0")
        seed_row_zoe_md5: "seed-row-zoe-md5-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "0854f67df857eb67dabd1246ca95eaa0")
    match variant_id
        "seed-accounts-table-drift" => ok observation("can_i38_accounts2", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-id-col-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,2", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-name-col-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE2", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-accounts-rows-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 5, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-row-ann-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),2", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-row-jason-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),2", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-row-mason-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),2", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-row-bob-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),2", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-row-obrien-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),2", "6854f67df857eb67dabd1246ca95eaa0")
        "seed-row-zoe-md5-drift" => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "0854f67df857eb67dabd1246ca95eaa0")
        _ => ok observation("can_i38_accounts", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", "  display_name text NOT NULL UNIQUE", 6, "  ('Ann'),", "  ('Jason'),", "  ('Mason'),", "  ('Bob'),", "  ('O''Brien'),", "6854f67df857eb67dabd1246ca95eaa0")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m23_h022: "m23-h022" => ok [check("accounts-table", "accounts fixture table is can_i38_accounts"), check("id-col", "accounts id column line is byte-exact"), check("name-col", "accounts display_name column line is byte-exact"), check("accounts-rows", "accounts seed carries 6 rows"), check("row-ann", "accounts seed row 1 is byte-exact"), check("row-jason", "accounts seed row 2 is byte-exact"), check("row-mason", "accounts seed row 3 is byte-exact"), check("row-bob", "accounts seed row 4 is byte-exact"), check("row-obrien", "accounts seed row 5 is byte-exact"), check("row-zoe-md5", "accounts seed row 6 bytes hash to the pinned md5")]
        other: "nope" => ok []
    match scope is "m23-h022"
        false => ok []
        true => ok [check("accounts-table", "accounts fixture table is can_i38_accounts"), check("id-col", "accounts id column line is byte-exact"), check("name-col", "accounts display_name column line is byte-exact"), check("accounts-rows", "accounts seed carries 6 rows"), check("row-ann", "accounts seed row 1 is byte-exact"), check("row-jason", "accounts seed row 2 is byte-exact"), check("row-mason", "accounts seed row 3 is byte-exact"), check("row-bob", "accounts seed row 4 is byte-exact"), check("row-obrien", "accounts seed row 5 is byte-exact"), check("row-zoe-md5", "accounts seed row 6 bytes hash to the pinned md5")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/transactions-roots" => ok [expected_check("accounts-table", "can_i38_accounts"), expected_check("id-col", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,"), expected_check("name-col", "  display_name text NOT NULL UNIQUE"), expected_check("accounts-rows", "6"), expected_check("row-ann", "  ('Ann'),"), expected_check("row-jason", "  ('Jason'),"), expected_check("row-mason", "  ('Mason'),"), expected_check("row-bob", "  ('Bob'),"), expected_check("row-obrien", "  ('O''Brien'),"), expected_check("row-zoe-md5", "6854f67df857eb67dabd1246ca95eaa0")]
        unknown: "nope" => ok []
    match case is "history/transactions-roots"
        false => ok []
        true => ok [expected_check("accounts-table", "can_i38_accounts"), expected_check("id-col", "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,"), expected_check("name-col", "  display_name text NOT NULL UNIQUE"), expected_check("accounts-rows", "6"), expected_check("row-ann", "  ('Ann'),"), expected_check("row-jason", "  ('Jason'),"), expected_check("row-mason", "  ('Mason'),"), expected_check("row-bob", "  ('Bob'),"), expected_check("row-obrien", "  ('O''Brien'),"), expected_check("row-zoe-md5", "6854f67df857eb67dabd1246ca95eaa0")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/transactions-roots", "default", "", "offline") => ok
        seed_accounts_table: context("history/transactions-roots", "seed-accounts-table-drift", "", "offline") => failed{"accounts-table"}
        seed_id_col: context("history/transactions-roots", "seed-id-col-drift", "", "offline") => failed{"id-col"}
        seed_name_col: context("history/transactions-roots", "seed-name-col-drift", "", "offline") => failed{"name-col"}
        seed_accounts_rows: context("history/transactions-roots", "seed-accounts-rows-drift", "", "offline") => failed{"accounts-rows"}
        seed_row_ann: context("history/transactions-roots", "seed-row-ann-drift", "", "offline") => failed{"row-ann"}
        seed_row_jason: context("history/transactions-roots", "seed-row-jason-drift", "", "offline") => failed{"row-jason"}
        seed_row_mason: context("history/transactions-roots", "seed-row-mason-drift", "", "offline") => failed{"row-mason"}
        seed_row_bob: context("history/transactions-roots", "seed-row-bob-drift", "", "offline") => failed{"row-bob"}
        seed_row_obrien: context("history/transactions-roots", "seed-row-obrien-drift", "", "offline") => failed{"row-obrien"}
        seed_row_zoe_md5: context("history/transactions-roots", "seed-row-zoe-md5-drift", "", "offline") => failed{"row-zoe-md5"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.accounts_table, "can_i38_accounts", c, "accounts-table")
            failed
            ok evidence accounts_table_evidence => match call require_text(got.id_col, "  id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,", c, "id-col")
                failed
                ok evidence id_col_evidence => match call require_text(got.name_col, "  display_name text NOT NULL UNIQUE", c, "name-col")
                    failed
                    ok evidence name_col_evidence => match call require_int(got.accounts_rows, 6, c, "accounts-rows")
                        failed
                        ok evidence accounts_rows_evidence => match call require_text(got.row_ann, "  ('Ann'),", c, "row-ann")
                            failed
                            ok evidence row_ann_evidence => match call require_text(got.row_jason, "  ('Jason'),", c, "row-jason")
                                failed
                                ok evidence row_jason_evidence => match call require_text(got.row_mason, "  ('Mason'),", c, "row-mason")
                                    failed
                                    ok evidence row_mason_evidence => match call require_text(got.row_bob, "  ('Bob'),", c, "row-bob")
                                        failed
                                        ok evidence row_bob_evidence => match call require_text(got.row_obrien, "  ('O''Brien'),", c, "row-obrien")
                                            failed
                                            ok evidence row_obrien_evidence => match call require_text(got.row_zoe_md5, "6854f67df857eb67dabd1246ca95eaa0", c, "row-zoe-md5")
                                                failed
                                                ok evidence row_zoe_md5_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m23_h022: "m23-h022" => ok test_case("history/transactions-roots", ["history", "m23"], [], 0, [check_ref("accounts-table"), check_ref("id-col"), check_ref("name-col"), check_ref("accounts-rows"), check_ref("row-ann"), check_ref("row-jason"), check_ref("row-mason"), check_ref("row-bob"), check_ref("row-obrien"), check_ref("row-zoe-md5")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m23-h022"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/transactions-roots", ["history", "m23"], [], 0, [check_ref("accounts-table"), check_ref("id-col"), check_ref("name-col"), check_ref("accounts-rows"), check_ref("row-ann"), check_ref("row-jason"), check_ref("row-mason"), check_ref("row-bob"), check_ref("row-obrien"), check_ref("row-zoe-md5")], callable case_body)
