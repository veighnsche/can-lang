fn check[] checks
    emits {}
    given
        str scope
    asserts
        m23_h022: "m23-h022" => ok [check("stmt-count", "seed file holds exactly 5 statements"), check("comment-lines", "seed file carries a 9-line header comment"), check("total-lines", "seed file holds exactly 23 lines"), check("file-bytes", "seed file is exactly 961 bytes"), check("file-md5", "seed file bytes hash to the pinned md5"), check("s1-md5", "statement 1 bytes hash to the pinned md5"), check("s2-md5", "statement 2 bytes hash to the pinned md5"), check("s3-md5", "statement 3 bytes hash to the pinned md5"), check("s4-md5", "statement 4 bytes hash to the pinned md5"), check("s5-md5", "statement 5 bytes hash to the pinned md5")]
        other: "nope" => ok []
    match scope is "m23-h022"
        false => ok []
        true => ok [check("stmt-count", "seed file holds exactly 5 statements"), check("comment-lines", "seed file carries a 9-line header comment"), check("total-lines", "seed file holds exactly 23 lines"), check("file-bytes", "seed file is exactly 961 bytes"), check("file-md5", "seed file bytes hash to the pinned md5"), check("s1-md5", "statement 1 bytes hash to the pinned md5"), check("s2-md5", "statement 2 bytes hash to the pinned md5"), check("s3-md5", "statement 3 bytes hash to the pinned md5"), check("s4-md5", "statement 4 bytes hash to the pinned md5"), check("s5-md5", "statement 5 bytes hash to the pinned md5")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/transactions-seed" => ok [expected_check("stmt-count", "5"), expected_check("comment-lines", "9"), expected_check("total-lines", "23"), expected_check("file-bytes", "961"), expected_check("file-md5", "dc8e13a82f81b0bd5ab70e939a733eb5"), expected_check("s1-md5", "030333756efd3d75b3c02f619bbc202f"), expected_check("s2-md5", "d902be2a1ca4c4a09c61459ee84add4d"), expected_check("s3-md5", "3c9bb9031e568dc68a238c6579923f29"), expected_check("s4-md5", "c8d2d59fbfedee459d27547c02c7b249"), expected_check("s5-md5", "ecddceed57bfe4891872e423f62c56a7")]
        unknown: "nope" => ok []
    match case is "history/transactions-seed"
        false => ok []
        true => ok [expected_check("stmt-count", "5"), expected_check("comment-lines", "9"), expected_check("total-lines", "23"), expected_check("file-bytes", "961"), expected_check("file-md5", "dc8e13a82f81b0bd5ab70e939a733eb5"), expected_check("s1-md5", "030333756efd3d75b3c02f619bbc202f"), expected_check("s2-md5", "d902be2a1ca4c4a09c61459ee84add4d"), expected_check("s3-md5", "3c9bb9031e568dc68a238c6579923f29"), expected_check("s4-md5", "c8d2d59fbfedee459d27547c02c7b249"), expected_check("s5-md5", "ecddceed57bfe4891872e423f62c56a7")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/transactions-seed", "default", "", "offline") => ok
        seed_stmt_count: context("history/transactions-seed", "seed-stmt-count-drift", "", "offline") => failed{"stmt-count"}
        seed_comment_lines: context("history/transactions-seed", "seed-comment-lines-drift", "", "offline") => failed{"comment-lines"}
        seed_total_lines: context("history/transactions-seed", "seed-total-lines-drift", "", "offline") => failed{"total-lines"}
        seed_file_bytes: context("history/transactions-seed", "seed-file-bytes-drift", "", "offline") => failed{"file-bytes"}
        seed_file_md5: context("history/transactions-seed", "seed-file-md5-drift", "", "offline") => failed{"file-md5"}
        seed_s1_md5: context("history/transactions-seed", "seed-s1-md5-drift", "", "offline") => failed{"s1-md5"}
        seed_s2_md5: context("history/transactions-seed", "seed-s2-md5-drift", "", "offline") => failed{"s2-md5"}
        seed_s3_md5: context("history/transactions-seed", "seed-s3-md5-drift", "", "offline") => failed{"s3-md5"}
        seed_s4_md5: context("history/transactions-seed", "seed-s4-md5-drift", "", "offline") => failed{"s4-md5"}
        seed_s5_md5: context("history/transactions-seed", "seed-s5-md5-drift", "", "offline") => failed{"s5-md5"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.stmt_count, 5, c, "stmt-count")
            failed
            ok evidence stmt_count_evidence => match call require_int(got.comment_lines, 9, c, "comment-lines")
                failed
                ok evidence comment_lines_evidence => match call require_int(got.total_lines, 23, c, "total-lines")
                    failed
                    ok evidence total_lines_evidence => match call require_int(got.file_bytes, 961, c, "file-bytes")
                        failed
                        ok evidence file_bytes_evidence => match call require_text(got.file_md5, "dc8e13a82f81b0bd5ab70e939a733eb5", c, "file-md5")
                            failed
                            ok evidence file_md5_evidence => match call require_text(got.s1_md5, "030333756efd3d75b3c02f619bbc202f", c, "s1-md5")
                                failed
                                ok evidence s1_md5_evidence => match call require_text(got.s2_md5, "d902be2a1ca4c4a09c61459ee84add4d", c, "s2-md5")
                                    failed
                                    ok evidence s2_md5_evidence => match call require_text(got.s3_md5, "3c9bb9031e568dc68a238c6579923f29", c, "s3-md5")
                                        failed
                                        ok evidence s3_md5_evidence => match call require_text(got.s4_md5, "c8d2d59fbfedee459d27547c02c7b249", c, "s4-md5")
                                            failed
                                            ok evidence s4_md5_evidence => match call require_text(got.s5_md5, "ecddceed57bfe4891872e423f62c56a7", c, "s5-md5")
                                                failed
                                                ok evidence s5_md5_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m23_h022: "m23-h022" => ok test_case("history/transactions-seed", ["history", "m23"], [], 0, [check_ref("stmt-count"), check_ref("comment-lines"), check_ref("total-lines"), check_ref("file-bytes"), check_ref("file-md5"), check_ref("s1-md5"), check_ref("s2-md5"), check_ref("s3-md5"), check_ref("s4-md5"), check_ref("s5-md5")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m23-h022"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/transactions-seed", ["history", "m23"], [], 0, [check_ref("stmt-count"), check_ref("comment-lines"), check_ref("total-lines"), check_ref("file-bytes"), check_ref("file-md5"), check_ref("s1-md5"), check_ref("s2-md5"), check_ref("s3-md5"), check_ref("s4-md5"), check_ref("s5-md5")], callable case_body)
