package m24history005desc
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-005 "SQL descriptors: assert report and descriptor semantics".
/// Source: tests/integration/sql_descriptors_test.go symbol TestCurrentSQLDescriptors
/// (L45-171); manifest sqlDescriptorsManifest (L16-21); staging helper
/// writeSQLDescriptorsProject (L23-43); assert leg (L80-87); run leg
/// (L88-91); fixture compiler/testdata/current/sql/descriptors.can (one
/// assert root).
/// Disposition: migrate (this row ports TestCurrentSQLDescriptors to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the gated assert/run contract, the five
/// descriptor bindings, and the supplied assertion root: the
/// CAN_BUN_ARCHIVE gate plus its skip message, the 4-minute context,
/// the offline sandbox invocation shape, the assert command with exit
/// 0, the run command with exit 0, the report keys plus the one-root
/// count, the five descriptor names in manifest order, the three bound
/// cardinalities (many/one/execute), the postgresql dialect, the
/// row_limit_parameter pin, and the root fn::assert name with its
/// expected verdict.
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (4) from 4*time.Minute (L50); per-descriptor pins
/// mirror the L16-21 manifest rows as static expectations, one
/// load-bearing pin per behavior; the root pin joins the fixture fn
/// name, assert name and verdict line as "fn::assert => verdict".
/// Facet map (sql_descriptors_test.go legs): env-gate pins CAN_BUN_ARCHIVE (L46);
/// skip-needle pins the skip message (L48); ctx-timeout-min pins 4
/// (L50); sandbox-profile pins the deny-network profile (L63);
/// offline-path pins PATH=/nonexistent (L67); canlc-bin pins
/// bin/canlc (L63); assert-cmd pins assert (L80); assert-exit pins
/// exit 0 (L81); run-cmd pins run (L88); run-exit pins exit 0 (L89);
/// report-passed, report-passed-key,
/// report-assertions-key and report-root-count pin the report
/// predicate (L85); desc-count plus desc-search/desc-repeat/desc-by-id/
/// desc-add/desc-commented pin the five manifest names in order
/// (L17-21); card-many/card-one/card-execute pin the bound
/// cardinalities (L17-21); dialect pins postgresql (L17); row-limit-param
/// pins 2 (L17); root-main-empty pins the fixture assert root with
/// its expected verdict.
/// The roots-green pin lives in history-005-roots-green.can; the
/// build/emitted/negative shape lives in history-005-run-shape.can.
/// Variants: none in this file (default only); the twelve negative
/// manifests live in run-shape.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates SUITE/CAN/BUILD/DIAG/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 240000ms mirrors the Go
/// 4-minute ctx (L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/desc checks: env-gate, skip-needle,
/// ctx-timeout-min, sandbox-profile, offline-path, canlc-bin,
/// assert-cmd, assert-exit, run-cmd, run-exit, report-passed,
/// report-passed-key, report-assertions-key, report-root-count,
/// desc-count, desc-search, desc-repeat, desc-by-id, desc-add,
/// desc-commented, card-many, card-one, card-execute, dialect,
/// row-limit-param, root-main-empty.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_gate
    str skip_needle
    int ctx_timeout_min
    str sandbox_profile
    str offline_path
    str canlc_bin
    str assert_cmd
    int assert_exit
    str run_cmd
    int run_exit
    bool report_passed
    str report_passed_key
    str report_assertions_key
    int report_root_count
    int desc_count
    str desc_search
    str desc_repeat
    str desc_by_id
    str desc_add
    str desc_commented
    str card_many
    str card_one
    str card_execute
    str dialect
    int row_limit_param
    str root_main_empty
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/desc", "default", "", "offline"), "env-gate" => ok "case history/desc variant default root env-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/desc", "default", "", "offline"), "report-passed" => ok evidence("report-passed", "true", "true", true, "case history/desc variant default root report-passed run offline")
        different: false, true, context("history/desc", "default", "", "offline"), "report-passed" => failed{"report-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/desc", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "4", "4", true, "case history/desc variant default root ctx-timeout-min run offline")
        different: 3, 4, context("history/desc", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("history/desc", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case history/desc variant default root env-gate run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("history/desc", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
