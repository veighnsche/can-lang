package m24history005roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-005 "SQL descriptors: roots green, staged inventory".
/// Source: tests/integration/sql_descriptors_test.go manifest
/// sqlDescriptorsManifest (L16-21) plus staging helper
/// writeSQLDescriptorsProject (L23-43); fixture
/// compiler/testdata/current/sql/descriptors.can; assert leg (L80-87);
/// run leg (L88-91).
/// Disposition: migrate (this row ports TestCurrentSQLDescriptors to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): static staged inventory as the green
/// baseline: the descriptors.can fixture path, the can.project.json
/// and can.errors.json names, the empty starting error registry, the
/// src/main.can entry, the source_root/error_registry manifest keys,
/// the parameter and row type bindings, and the assert/run legs green
/// (exit 0, empty diagnostics).
/// ADAPTATION (recorded, with source lines): the empty registry pins
/// the exact L41 JSON bytes; type bindings pin the manifest spellings
/// (L17-21) rather than the fixture record bodies; the assert/run
/// exit/diag predicates (L81/L89) pin the legs green without claiming
/// a live run (accept_after P23 unmet).
/// Facet map (sql_descriptors_test.go legs): fixture-path pins
/// descriptors.can (L26); project-name pins can.project.json (L40);
/// errors-name pins can.errors.json (L41); errors-empty pins the empty
/// registry (L41); entry-src pins src/main.can (L42); source-root-key
/// and error-registry-key pin the manifest keys (L16);
/// param-search-type pins app::search_parameters (L17); param-id-type
/// pins app::id_parameters (L19); row-account-type pins
/// app::account_row (L17-21); assert-exit/run-exit pin exit 0
/// (L81/L89); assert-diag-empty/run-diag-empty pin empty diagnostics
/// (L81/L89).
/// Report/descriptor semantics live in
/// history-005-desc-semantics.can; the build/emitted/negative
/// shape lives in history-005-run-shape.can.
/// Variants: none in this file (default only); descriptor
/// cardinalities live in desc-semantics.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive.
/// Logical gates SUITE/CAN/BUILD/DIAG/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 240000ms mirrors the Go
/// 4-minute ctx (L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/desc-roots checks: fixture-path, project-name,
/// errors-name, errors-empty, entry-src, source-root-key,
/// error-registry-key, param-search-type, param-id-type,
/// row-account-type, assert-exit, assert-diag-empty, run-exit,
/// run-diag-empty.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str fixture_path
    str project_name
    str errors_name
    str errors_empty
    str entry_src
    str source_root_key
    str error_registry_key
    str param_search_type
    str param_id_type
    str row_account_type
    int assert_exit
    bool assert_diag_empty
    int run_exit
    bool run_diag_empty
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
