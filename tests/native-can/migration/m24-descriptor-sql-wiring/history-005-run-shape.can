package m24history005run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-005 "SQL descriptors: build/emitted/negative run shape".
/// Source: tests/integration/sql_descriptors_test.go symbol
/// TestCurrentSQLDescriptors (L45-171); build helper buildAt (L92-106);
/// identity legs (L107-119); emitted state needles (L120-128); optional
/// strict TypeScript leg (L129-134); negative manifests (L135-170).
/// Disposition: migrate (this row ports TestCurrentSQLDescriptors to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the build/emit/negative shape: the build
/// command with buildID/directory keys, repeated and relocated build
/// identity, the program/state.ts path plus its five emitted
/// descriptor wiring needles, the optional CAN_TSC strict leg, and
/// the twelve negative manifests with their rejection needles.
/// ADAPTATION (recorded, with source lines): rebuild-same and
/// relocated-same pin the L109/L117 equality predicates as bool
/// expectations; emit needles pin the exact L124 source spellings;
/// tsc pins record the optional leg (CAN_TSC unset skips) without
/// claiming a live run (accept_after P23 unmet); negative needles pin
/// the L147-158 want strings.
/// Facet map (sql_descriptors_test.go legs): build-cmd pins build
/// (L94); build-id-key and build-dir-key pin buildID/directory
/// (L99-100); rebuild-same pins the rebuild predicate (L109);
/// relocated-same pins the relocated predicate (L117); state-path pins
/// program/state.ts (L120); emit-sql, emit-search, emit-param,
/// emit-limit and emit-version pin the state needles (L124); tsc-gate
/// pins CAN_TSC (L129); tsc-strict pins --strict (L130); neg-count
/// pins twelve negatives (L142); neg-unbounded, neg-returning,
/// neg-multi, neg-gap, neg-extra, neg-shared, neg-literal, neg-order,
/// neg-nonscalar, neg-unknown, neg-exec-limit and neg-syntax pin the
/// rejection needles (L147-158).
/// Report/descriptor semantics live in
/// history-005-desc-semantics.can; the roots-green pin lives in
/// history-005-roots-green.can.
/// Variants: the twelve negative descriptor cases (the L142 table, in
/// order); each carries its rejection needle.
/// Environment: CAN_BUN_ARCHIVE gate; requires can-bun-archive;
/// CAN_TSC optional.
/// Logical gates SUITE/CAN/BUILD/DIAG/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. The offline legs additionally use
/// /usr/bin/sandbox-exec plus the bundled runtime/bun (recorded
/// mechanism, not waived). Descriptor timeout 240000ms mirrors the Go
/// 4-minute ctx (L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/desc-run checks: build-cmd, build-id-key,
/// build-dir-key, rebuild-same, relocated-same, state-path, emit-sql,
/// emit-search, emit-param, emit-limit, emit-version, tsc-gate,
/// tsc-strict, neg-count, neg-unbounded, neg-returning, neg-multi,
/// neg-gap, neg-extra, neg-shared, neg-literal, neg-order,
/// neg-nonscalar, neg-unknown, neg-exec-limit, neg-syntax.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str build_cmd
    str build_id_key
    str build_dir_key
    bool rebuild_same
    bool relocated_same
    str state_path
    str emit_sql
    str emit_search
    str emit_param
    str emit_limit
    str emit_version
    str tsc_gate
    str tsc_strict
    int neg_count
    str neg_unbounded
    str neg_returning
    str neg_multi
    str neg_gap
    str neg_extra
    str neg_shared
    str neg_literal
    str neg_order
    str neg_nonscalar
    str neg_unknown
    str neg_exec_limit
    str neg_syntax
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/desc-run", "default", "", "offline"), "build-cmd" => ok "case history/desc-run variant default root build-cmd run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/desc-run", "default", "", "offline"), "rebuild-same" => ok evidence("rebuild-same", "true", "true", true, "case history/desc-run variant default root rebuild-same run offline")
        different: false, true, context("history/desc-run", "default", "", "offline"), "rebuild-same" => failed{"rebuild-same"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 12, 12, context("history/desc-run", "default", "", "offline"), "neg-count" => ok evidence("neg-count", "12", "12", true, "case history/desc-run variant default root neg-count run offline")
        different: 11, 12, context("history/desc-run", "default", "", "offline"), "neg-count" => failed{"neg-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "build", "build", context("history/desc-run", "default", "", "offline"), "build-cmd" => ok evidence("build-cmd", "build", "build", true, "case history/desc-run variant default root build-cmd run offline")
        different: "compile", "build", context("history/desc-run", "default", "", "offline"), "build-cmd" => failed{"build-cmd"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("build", "buildID", "directory", true, true, "program/state.ts", "$canSQL=$canCreateSQLDescriptors(", "\"search_accounts\":{\"dialect\":\"postgresql\",\"cardinality\":\"many\"", "{\"param\":1}", "\"limit\":2", "\"version\":170007", "CAN_TSC", "--strict", 12, "unbounded SELECT", "RETURNING", "2 statements", "is not used", "no declared parameter", "appears 2 times", "must be $1", "manifest lists", "non-SQL type", "not declared", "cannot declare", "syntax error")
        seed_build_cmd: "seed-build-cmd-drift" => ok observation("compile", "buildID", "directory", true, true, "program/state.ts", "$canSQL=$canCreateSQLDescriptors(", "\"search_accounts\":{\"dialect\":\"postgresql\",\"cardinality\":\"many\"", "{\"param\":1}", "\"limit\":2", "\"version\":170007", "CAN_TSC", "--strict", 12, "unbounded SELECT", "RETURNING", "2 statements", "is not used", "no declared parameter", "appears 2 times", "must be $1", "manifest lists", "non-SQL type", "not declared", "cannot declare", "syntax error")
