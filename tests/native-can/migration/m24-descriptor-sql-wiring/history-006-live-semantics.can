    asserts
        default: "default" => ok observation("6 rows", "[\"%o%\",\"%o%\",10]", "[\"%\",100]", "[Jason, Mason]", "[O'Brien]", "[Zoë]", "0 rows", "0 rows", "6 rows", "[Jason, Mason, Bob, O'Brien, Zoë]", "Bob", "0 rows", "count 1", "[Q'ueen]", "7 rows", "2 rows")
        seed_setup_seed: "seed-setup-seed-drift" => ok observation("5 rows", "[\"%o%\",\"%o%\",10]", "[\"%\",100]", "[Jason, Mason]", "[O'Brien]", "[Zoë]", "0 rows", "0 rows", "6 rows", "[Jason, Mason, Bob, O'Brien, Zoë]", "Bob", "0 rows", "count 1", "[Q'ueen]", "7 rows", "2 rows")
