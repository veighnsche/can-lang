package m24history006live
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-006 "live SQL descriptors: template and row semantics".
/// Source: tests/integration/sql_descriptors_test.go symbol
/// TestCurrentSQLDescriptorsLive (L184-282); driver
/// tests/integration/testdata/sql/descriptors-driver.ts (L60-183)
/// with sixteen pass legs (L100-165).
/// Disposition: migrate (this row ports TestCurrentSQLDescriptorsLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the sixteen live descriptor answers: setup
/// seed rows, repeat and comment template expansion, search like/
/// quote/unicode rows, hostile or/stacked values staying inert with
/// the table surviving, repeat binding once, by-id one/missing,
/// insert count plus round trip, comment literal rows, bound LIMIT.
/// ADAPTATION (recorded, with source lines): repeat-expansion pins
/// the JSON output without spaces while Go spells the source array
/// with spaces (driver L116); comment-expansion pins without spaces
/// (driver L121); search and repeat legs pin the bracket-join detail
/// from assertNames (driver L47-53) while Go spells want arrays with
/// quotes (driver L126-128/L140/L157); by-id-one pins bare Bob while
/// Go checks id 4 plus display (driver L142-146); insert-execute pins
/// count 1 while Go checks added.count (driver L155).
/// Facet map (driver legs): setup-seed pins 6 rows (L100);
/// repeat-expansion pins repeated percent-o (L115-119);
/// comment-expansion pins percent plus 100 (L120-124); search-like
/// pins Jason and Mason (L126); search-quote pins O'Brien (L127);
/// search-unicode pins Zoe with diaeresis (L128); injection-or pins
/// 0 rows (L130-132); injection-stacked pins 0 rows (L133-135);
/// table-survives pins 6 rows (L136-138); repeat-binds-once pins
/// five rows (L140); by-id-one pins Bob (L142-146); by-id-missing
/// pins 0 rows (L147-149); insert-execute pins count 1 (L151-156);
/// insert-round-trip pins quoted queen (L157); comment-literal pins
/// 7 rows (L159-161); limit-bound pins 2 rows (L163-165).
/// The roots-green pin lives in history-006-roots-green.can; the
/// fd-3 delivery plus run shape lives in
/// history-006-run-shape.can.
/// Variants: all sixteen driver legs in Go order (setup, expansion,
/// search, injection, binding, by-id, insert, comment, limit).
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK/ENV and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1
/// are unmet. Descriptor timeout 240000ms mirrors the Go 4-minute
/// ctx (sql_descriptors_test.go L205).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/live-descriptors checks: setup-seed,
/// repeat-expansion, comment-expansion, search-like, search-quote,
/// search-unicode, injection-or, injection-stacked, table-survives,
/// repeat-binds-once, by-id-one, by-id-missing, insert-execute,
/// insert-round-trip, comment-literal, limit-bound.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str setup_seed
    str repeat_expansion
    str comment_expansion
    str search_like
    str search_quote
    str search_unicode
    str injection_or
    str injection_stacked
    str table_survives
    str repeat_binds_once
    str by_id_one
    str by_id_missing
    str insert_execute
    str insert_round_trip
    str comment_literal
    str limit_bound
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/live-descriptors", "default", "", "offline"), "setup-seed" => ok "case history/live-descriptors variant default root setup-seed run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/live-descriptors", "default", "", "offline"), "setup-seed" => ok evidence("setup-seed", "true", "true", true, "case history/live-descriptors variant default root setup-seed run offline")
        different: false, true, context("history/live-descriptors", "default", "", "offline"), "setup-seed" => failed{"setup-seed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/live-descriptors", "default", "", "offline"), "setup-seed" => ok evidence("setup-seed", "0", "0", true, "case history/live-descriptors variant default root setup-seed run offline")
        different: 1, 0, context("history/live-descriptors", "default", "", "offline"), "setup-seed" => failed{"setup-seed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "6 rows", "6 rows", context("history/live-descriptors", "default", "", "offline"), "setup-seed" => ok evidence("setup-seed", "6 rows", "6 rows", true, "case history/live-descriptors variant default root setup-seed run offline")
        different: "6 rows_2", "6 rows", context("history/live-descriptors", "default", "", "offline"), "setup-seed" => failed{"setup-seed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
