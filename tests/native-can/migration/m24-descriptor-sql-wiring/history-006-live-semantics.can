fn check[] checks
    emits {}
    given
        str scope
    asserts
        m24_h006: "m24-h006" => ok [check("setup-seed", "setup seed loads six rows"), check("repeat-expansion", "repeat template repeats bound value twice"), check("comment-expansion", "comment template ignores hidden nine"), check("search-like", "search son finds Jason and Mason"), check("search-quote", "search quote finds O'Brien"), check("search-unicode", "search unicode finds Zoe row"), check("injection-or", "injection or matches zero rows"), check("injection-stacked", "stacked injection matches zero rows"), check("table-survives", "table survives injection with six rows"), check("repeat-binds-once", "repeat binds once finds five rows"), check("by-id-one", "by id four returns Bob"), check("by-id-missing", "by id missing returns zero rows"), check("insert-execute", "insert execute reports count one"), check("insert-round-trip", "insert round trip finds queen row"), check("comment-literal", "comment literal scans seven rows"), check("limit-bound", "bound limit returns two rows")]
        other: "nope" => ok []
    match scope is "m24-h006"
        false => ok []
        true => ok [check("setup-seed", "setup seed loads six rows"), check("repeat-expansion", "repeat template repeats bound value twice"), check("comment-expansion", "comment template ignores hidden nine"), check("search-like", "search son finds Jason and Mason"), check("search-quote", "search quote finds O'Brien"), check("search-unicode", "search unicode finds Zoe row"), check("injection-or", "injection or matches zero rows"), check("injection-stacked", "stacked injection matches zero rows"), check("table-survives", "table survives injection with six rows"), check("repeat-binds-once", "repeat binds once finds five rows"), check("by-id-one", "by id four returns Bob"), check("by-id-missing", "by id missing returns zero rows"), check("insert-execute", "insert execute reports count one"), check("insert-round-trip", "insert round trip finds queen row"), check("comment-literal", "comment literal scans seven rows"), check("limit-bound", "bound limit returns two rows")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/live-descriptors" => ok [expected_check("setup-seed", "6 rows"), expected_check("repeat-expansion", "[\"%o%\",\"%o%\",10]"), expected_check("comment-expansion", "[\"%\",100]"), expected_check("search-like", "[Jason, Mason]"), expected_check("search-quote", "[O'Brien]"), expected_check("search-unicode", "[Zoë]"), expected_check("injection-or", "0 rows"), expected_check("injection-stacked", "0 rows"), expected_check("table-survives", "6 rows"), expected_check("repeat-binds-once", "[Jason, Mason, Bob, O'Brien, Zoë]"), expected_check("by-id-one", "Bob"), expected_check("by-id-missing", "0 rows"), expected_check("insert-execute", "count 1"), expected_check("insert-round-trip", "[Q'ueen]"), expected_check("comment-literal", "7 rows"), expected_check("limit-bound", "2 rows")]
        unknown: "nope" => ok []
    match case is "history/live-descriptors"
        false => ok []
        true => ok [expected_check("setup-seed", "6 rows"), expected_check("repeat-expansion", "[\"%o%\",\"%o%\",10]"), expected_check("comment-expansion", "[\"%\",100]"), expected_check("search-like", "[Jason, Mason]"), expected_check("search-quote", "[O'Brien]"), expected_check("search-unicode", "[Zoë]"), expected_check("injection-or", "0 rows"), expected_check("injection-stacked", "0 rows"), expected_check("table-survives", "6 rows"), expected_check("repeat-binds-once", "[Jason, Mason, Bob, O'Brien, Zoë]"), expected_check("by-id-one", "Bob"), expected_check("by-id-missing", "0 rows"), expected_check("insert-execute", "count 1"), expected_check("insert-round-trip", "[Q'ueen]"), expected_check("comment-literal", "7 rows"), expected_check("limit-bound", "2 rows")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/live-descriptors", "default", "", "offline") => ok
        seed_setup_seed: context("history/live-descriptors", "seed-setup-seed-drift", "", "offline") => failed{"setup-seed"}
        seed_repeat_expansion: context("history/live-descriptors", "seed-repeat-expansion-drift", "", "offline") => failed{"repeat-expansion"}
        seed_comment_expansion: context("history/live-descriptors", "seed-comment-expansion-drift", "", "offline") => failed{"comment-expansion"}
        seed_search_like: context("history/live-descriptors", "seed-search-like-drift", "", "offline") => failed{"search-like"}
        seed_search_quote: context("history/live-descriptors", "seed-search-quote-drift", "", "offline") => failed{"search-quote"}
        seed_search_unicode: context("history/live-descriptors", "seed-search-unicode-drift", "", "offline") => failed{"search-unicode"}
        seed_injection_or: context("history/live-descriptors", "seed-injection-or-drift", "", "offline") => failed{"injection-or"}
        seed_injection_stacked: context("history/live-descriptors", "seed-injection-stacked-drift", "", "offline") => failed{"injection-stacked"}
        seed_table_survives: context("history/live-descriptors", "seed-table-survives-drift", "", "offline") => failed{"table-survives"}
        seed_repeat_binds_once: context("history/live-descriptors", "seed-repeat-binds-once-drift", "", "offline") => failed{"repeat-binds-once"}
        seed_by_id_one: context("history/live-descriptors", "seed-by-id-one-drift", "", "offline") => failed{"by-id-one"}
        seed_by_id_missing: context("history/live-descriptors", "seed-by-id-missing-drift", "", "offline") => failed{"by-id-missing"}
        seed_insert_execute: context("history/live-descriptors", "seed-insert-execute-drift", "", "offline") => failed{"insert-execute"}
        seed_insert_round_trip: context("history/live-descriptors", "seed-insert-round-trip-drift", "", "offline") => failed{"insert-round-trip"}
        seed_comment_literal: context("history/live-descriptors", "seed-comment-literal-drift", "", "offline") => failed{"comment-literal"}
        seed_limit_bound: context("history/live-descriptors", "seed-limit-bound-drift", "", "offline") => failed{"limit-bound"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.setup_seed, "6 rows", c, "setup-seed")
            failed
            ok evidence setup_seed_evidence => match call require_text(got.repeat_expansion, "[\"%o%\",\"%o%\",10]", c, "repeat-expansion")
                failed
                ok evidence repeat_expansion_evidence => match call require_text(got.comment_expansion, "[\"%\",100]", c, "comment-expansion")
                    failed
                    ok evidence comment_expansion_evidence => match call require_text(got.search_like, "[Jason, Mason]", c, "search-like")
                        failed
                        ok evidence search_like_evidence => match call require_text(got.search_quote, "[O'Brien]", c, "search-quote")
                            failed
                            ok evidence search_quote_evidence => match call require_text(got.search_unicode, "[Zoë]", c, "search-unicode")
                                failed
                                ok evidence search_unicode_evidence => match call require_text(got.injection_or, "0 rows", c, "injection-or")
                                    failed
                                    ok evidence injection_or_evidence => match call require_text(got.injection_stacked, "0 rows", c, "injection-stacked")
                                        failed
                                        ok evidence injection_stacked_evidence => match call require_text(got.table_survives, "6 rows", c, "table-survives")
                                            failed
