package m24history006roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-006 "live SQL descriptors: roots green, seed inventory".
/// Source: tests/integration/sql_descriptors_test.go symbol
/// TestCurrentSQLDescriptorsLive (L184-282); env gates (L185-192);
/// live context (L205); fixture read (L26); seed and driver paths
/// (L244-245); seed tests/integration/testdata/sql/descriptors.sql;
/// driver tests/integration/testdata/sql/descriptors-driver.ts.
/// Disposition: migrate (this row ports TestCurrentSQLDescriptorsLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the static live baseline as the green root:
/// both environment gates plus skip messages, the live context, the
/// fixture path, the seed/driver fixture paths, the four-statement
/// create/truncate/insert/drop shape, the six-row seed count, the
/// seed table name, and the PostgreSQL 17 version prefix.
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (4) from 4*time.Minute (L205); the seed count pins int
/// (6) from the driver 6-rows detail (driver L100) plus the six
/// INSERT names (descriptors.sql L10-16); the statement count pins
/// int (4) from the driver length check (driver L91).
/// Facet map (legs): env-archive pins CAN_BUN_ARCHIVE (L185);
/// skip-archive pins the staged-descriptor skip (L187);
/// env-postgres-url pins CAN_TEST_POSTGRES_URL (L189);
/// skip-postgres-url pins the disposable-database skip (L191);
/// ctx-timeout-min pins 4 (L205); seed-path pins descriptors.sql
/// (L245); driver-path pins descriptors-driver.ts (L244);
/// seed-statements pins 4 (driver L91); seed-create pins CREATE
/// TABLE (driver L93; descriptors.sql L5); seed-truncate pins
/// TRUNCATE (driver L93; descriptors.sql L9); seed-insert pins
/// INSERT INTO (driver L93; descriptors.sql L10); seed-drop pins
/// DROP TABLE (driver L93; descriptors.sql L17); seed-rows pins 6
/// (driver L100); seed-table pins can_i37_accounts (descriptors.sql
/// L5); version-prefix pins PostgreSQL 17. (L270; driver L79);
/// fixture-path pins descriptors.can (L26).
/// Answer semantics live in history-006-live-semantics.can; the fd-3
/// delivery plus run shape lives in
/// history-006-run-shape.can.
/// Variants: none in this file (default only); the sixteen
/// descriptor legs live in live-semantics.
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK/ENV and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1
/// are unmet. Descriptor timeout 240000ms mirrors the Go 4-minute
/// ctx (L205).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/live-desc-roots checks: env-archive, skip-archive,
/// env-postgres-url, skip-postgres-url, ctx-timeout-min, seed-path,
/// driver-path, seed-statements, seed-create, seed-truncate,
/// seed-insert, seed-drop, seed-rows, seed-table, version-prefix,
/// fixture-path.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_archive
    str skip_archive
    str env_postgres_url
    str skip_postgres_url
    int ctx_timeout_min
    str seed_path
    str driver_path
    int seed_statements
    str seed_create
    str seed_truncate
    str seed_insert
    str seed_drop
    int seed_rows
    str seed_table
    str version_prefix
    str fixture_path
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/live-desc-roots", "default", "", "offline"), "env-archive" => ok "case history/live-desc-roots variant default root env-archive run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/live-desc-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "true", "true", true, "case history/live-desc-roots variant default root env-archive run offline")
        different: false, true, context("history/live-desc-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/live-desc-roots", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "4", "4", true, "case history/live-desc-roots variant default root ctx-timeout-min run offline")
        different: 5, 4, context("history/live-desc-roots", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("history/live-desc-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case history/live-desc-roots variant default root env-archive run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("history/live-desc-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
