package m24history006run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-006 "live SQL descriptors: fd-3 delivery and run shape".
/// Source: tests/integration/sql_descriptors_test.go symbol
/// TestCurrentSQLDescriptorsLive (L184-282); live build leg (L220-226);
/// neutral snapshot (L233-242); driver invocation (L244-252);
/// report validation (L256-281); driver refusal (driver L67).
/// Disposition: migrate (this row ports TestCurrentSQLDescriptorsLive to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live run shape: the sandboxed build
/// invocation, the neutral fd-3 snapshot delivery (file, content, fd
/// number, file count, mode, build env without the URL versus driver
/// env with it), the driver arg count, the empty-stderr contract, the
/// refusal plus noise plus no-checks plus fail/log diagnostics, and
/// the sixteen-check total.
/// ADAPTATION (recorded, with source lines): snapshot-fd pins 3 from
/// the fd-3 doc comment (L233) plus single ExtraFiles entry (L249);
/// the file mode pins the exact source spelling 0600 (L236); the
/// snapshot content pins the neutral empty object (L236);
/// build-env-clean pins true for the URL travelling only in the
/// driver env, never the build env (L222/L248); driver-env-has-url
/// pins true for the driver env carrying CAN_TEST_POSTGRES_URL
/// (L248); driver-arg-count pins 2 from driver plus build dir plus
/// seed argv (L246); driver-diag-empty pins true from the Len check
/// (L256); live-check-count pins 16 from the sixteen driver pass
/// legs (driver L100-165).
/// Facet map (legs): sandbox-profile pins the deny-network profile
/// (L220); canlc-bin pins bin/canlc (L220); build-cmd pins build
/// (L220); offline-path pins PATH=/nonexistent (L222/L248);
/// bun-entry pins runtime/bun (L246); snapshot-file pins
/// snapshot.json (L235); snapshot-content pins the empty object
/// (L236); snapshot-mode pins 0600 (L236); snapshot-fd pins 3
/// (L233/L249); snapshot-count pins 1 (L249); build-env-count pins
/// 2 (L222); build-env-clean pins URL-absent (L222/L248);
/// driver-env-count pins 3 (L248); driver-env-has-url pins
/// URL-present (L248); driver-arg-count pins 2 (L246);
/// driver-diag-empty pins empty stderr (L256); refuse-url-msg pins
/// the non-postgres refusal (driver L67); no-checks-msg pins the
/// empty-report failure (L274); live-fail-fmt pins the per-check
/// wrap (L278); live-log-fmt pins the success log (L281);
/// noise-fmt pins the stderr-noise failure (L257); live-check-count
/// pins 16 (driver L100-165).
/// The roots-green pin lives in history-006-roots-green.can; answer
/// semantics live in history-006-live-semantics.can.
/// Variants: the sixteen descriptor legs share one delivery and
/// contract shape (a single default case; per-leg answers pin in
/// live-semantics).
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_POSTGRES_URL gates;
/// requires can-bun-archive and can-test-postgres-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK/ENV and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1
/// are unmet. Descriptor timeout 240000ms mirrors the Go 4-minute
/// ctx (L205).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/live-desc-run checks: sandbox-profile, canlc-bin,
/// build-cmd, offline-path, bun-entry, snapshot-file,
/// snapshot-content, snapshot-mode, snapshot-fd, snapshot-count,
/// build-env-count, build-env-clean, driver-env-count,
/// driver-env-has-url, driver-arg-count, driver-diag-empty,
/// refuse-url-msg, no-checks-msg, live-fail-fmt, live-log-fmt,
/// noise-fmt, live-check-count.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str sandbox_profile
    str canlc_bin
    str build_cmd
    str offline_path
    str bun_entry
    str snapshot_file
    str snapshot_content
    str snapshot_mode
    int snapshot_fd
    int snapshot_count
    int build_env_count
    bool build_env_clean
    int driver_env_count
    bool driver_env_has_url
    int driver_arg_count
    bool driver_diag_empty
    str refuse_url_msg
    str no_checks_msg
    str live_fail_fmt
    str live_log_fmt
    str noise_fmt
    int live_check_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/live-desc-run", "default", "", "offline"), "sandbox-profile" => ok "case history/live-desc-run variant default root sandbox-profile run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/live-desc-run", "default", "", "offline"), "build-env-clean" => ok evidence("build-env-clean", "true", "true", true, "case history/live-desc-run variant default root build-env-clean run offline")
        different: false, true, context("history/live-desc-run", "default", "", "offline"), "build-env-clean" => failed{"build-env-clean"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/live-desc-run", "default", "", "offline"), "snapshot-fd" => ok evidence("snapshot-fd", "3", "3", true, "case history/live-desc-run variant default root snapshot-fd run offline")
        different: 4, 3, context("history/live-desc-run", "default", "", "offline"), "snapshot-fd" => failed{"snapshot-fd"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", context("history/live-desc-run", "default", "", "offline"), "sandbox-profile" => ok evidence("sandbox-profile", "(version 1)(allow default)(deny network*)", "(version 1)(allow default)(deny network*)", true, "case history/live-desc-run variant default root sandbox-profile run offline")
        different: "(version 1)(allow default)(deny network*)_2", "(version 1)(allow default)(deny network*)", context("history/live-desc-run", "default", "", "offline"), "sandbox-profile" => failed{"sandbox-profile"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
