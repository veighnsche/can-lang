package m24history011roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-011 "descriptors-driver.ts: state import, expansion, roots".
/// Source: tests/integration/testdata/sql/descriptors-driver.ts symbol
/// descriptors-driver.ts (L69-74 state import, L102-106 descriptor
/// declares, L115-124 structural expansion, L77-81 version gate, L100
/// setup report); fixture tests/integration/testdata/sql/descriptors.sql
/// retained by HISTORY-018, read here for fixture roots only.
/// Disposition: migrate (this row ports descriptors-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the emitted-state import assertions, the five
/// descriptor names, the placeholder-expansion rules (repeated $1 repeats
/// the value, the comment $9 binds nothing), the version gate, the
/// report version key, and the setup-seed green detail.
/// ADAPTATION (recorded, with source lines): repeat/comment input and
/// values pins use the JSON.stringify comparison form (L116/L121, the
/// driver's own equality format); state-path pins the program/state.ts
/// suffix of the L69 file URL; declare-owner pins the empty-string owner
/// (L102-106); version-refusal pins the static template prefix (L80).
/// Facet map (descriptors-driver.ts legs): state-path pins
/// program/state.ts (L69); state-scheme pins file:// (L69); init-name
/// pins $canInitialize (L70/L73); table-name pins $canSQL (L71/L74);
/// declare-owner pins "" (L102-106); desc-search pins search_accounts
/// (L102); desc-repeat pins repeat_search (L103); desc-by-id pins
/// account_by_id (L104); desc-add pins add_account (L105);
/// desc-commented pins commented_search (L106); repeat-input pins
/// ["%o%",10] (L115); repeat-values pins ["%o%","%o%",10] (L116);
/// comment-input and comment-values pin ["%",100] (L120-121);
/// version-query pins SELECT version() (L77); version-prefix pins
/// PostgreSQL 17. (L79); version-slice pins 80 (L80); version-refusal
/// pins the L80 template prefix; report-version-key pins serverVersion
/// (L167); setup-detail pins "6 rows" (L100).
/// Seed semantics live in history-011-seed-semantics.can; the
/// invocation/run shape lives in history-011-run-shape.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in descriptors-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/descriptors-roots checks: state-path, state-scheme,
/// init-name, table-name, declare-owner, desc-search, desc-repeat,
/// desc-by-id, desc-add, desc-commented, repeat-input, repeat-values,
/// comment-input, comment-values, version-query, version-prefix,
/// version-slice, version-refusal, report-version-key, setup-detail.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str state_path
    str state_scheme
    str init_name
    str table_name
    str declare_owner
    str desc_search
    str desc_repeat
    str desc_by_id
    str desc_add
    str desc_commented
    str repeat_input
    str repeat_values
    str comment_input
    str comment_values
    str version_query
    str version_prefix
    int version_slice
    str version_refusal
    str report_version_key
    str setup_detail
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/descriptors-roots", "default", "", "offline"), "state-path" => ok "case history/descriptors-roots variant default root state-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/descriptors-roots", "default", "", "offline"), "state-path" => ok evidence("state-path", "true", "true", true, "case history/descriptors-roots variant default root state-path run offline")
        different: false, true, context("history/descriptors-roots", "default", "", "offline"), "state-path" => failed{"state-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 80, 80, context("history/descriptors-roots", "default", "", "offline"), "version-slice" => ok evidence("version-slice", "80", "80", true, "case history/descriptors-roots variant default root version-slice run offline")
        different: 79, 80, context("history/descriptors-roots", "default", "", "offline"), "version-slice" => failed{"version-slice"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "program/state.ts", "program/state.ts", context("history/descriptors-roots", "default", "", "offline"), "state-path" => ok evidence("state-path", "program/state.ts", "program/state.ts", true, "case history/descriptors-roots variant default root state-path run offline")
        different: "program/state2.ts", "program/state.ts", context("history/descriptors-roots", "default", "", "offline"), "state-path" => failed{"state-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
