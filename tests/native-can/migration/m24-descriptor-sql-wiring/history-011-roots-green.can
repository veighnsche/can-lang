fn check[] checks
    emits {}
    given
        str scope
    asserts
        m24_h011: "m24-h011" => ok [check("state-path", "emitted state imports from program/state.ts"), check("state-scheme", "state import builds a file:// URL"), check("init-name", "state import initializes via $canInitialize"), check("table-name", "descriptor table reads $canSQL"), check("declare-owner", "descriptors declare under the empty owner"), check("desc-search", "search descriptor is search_accounts"), check("desc-repeat", "repeat descriptor is repeat_search"), check("desc-by-id", "by-id descriptor is account_by_id"), check("desc-add", "add descriptor is add_account"), check("desc-commented", "commented descriptor is commented_search"), check("repeat-input", "repeat expansion binds %o% and 10"), check("repeat-values", "repeated $1 repeats the same prepared value"), check("comment-input", "comment expansion binds % and 100"), check("comment-values", "the comment $9 never becomes a binding site"), check("version-query", "setup reads the server version"), check("version-prefix", "test database must be PostgreSQL 17"), check("version-slice", "version refusal truncates to 80 chars"), check("version-refusal", "unexpected version refuses with its prefix"), check("report-version-key", "setup report carries serverVersion"), check("setup-detail", "setup seed passes with 6 rows")]
        other: "nope" => ok []
