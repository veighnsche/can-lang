package m24history011run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-011 "descriptors-driver.ts: invocation and named rows".
/// Source: tests/integration/testdata/sql/descriptors-driver.ts symbol
/// descriptors-driver.ts (L55-67 arg/env/report legs, L126-165 named
/// query legs, L177-183 harness/exit legs).
/// Disposition: migrate (this row ports descriptors-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the invocation shape (argv positions, env gate,
/// every refusal message, URL guards, harness name, exit code), the
/// report checks key, every named expected row list and count decision
/// with exact values, the two hostile bound payloads, and the by-id keys.
/// ADAPTATION (recorded, with source lines): row-list pins use the pass
/// detail join format [a, b] (L52 assertNames detail); count pins mirror
/// the N rows / count 1 detail literals (L132-L165); url-space pins the
/// single-space needle of the L67 includes guard; hostile payloads pin
/// verbatim (L130/L133, the bound-value security contract); search terms
/// and limits are cited in check titles, expected values pin in fields.
/// Facet map (descriptors-driver.ts legs): build-arg pins 2 (L61);
/// seed-arg pins 3 (L62); env-gate pins CAN_TEST_POSTGRES_URL (L63);
/// missing-build pins the L64 message; missing-seed pins the L65 message;
/// unset-db pins the L66 message; url-space pins the space needle (L67);
/// url-scheme pins postgres (L67); url-refusal pins the L67 message;
/// report-checks pins checks (L55); harness-name pins harness (L178);
/// error-exit pins 1 (L181/L183); search-like pins [Jason, Mason] (L126);
/// search-quote pins [O'Brien] (L127); search-unicode pins [Zoë] (L128);
/// injection-or and injection-stacked pin 0 rows (L132/L135);
/// survives-injection pins 6 rows (L138); repeat-once pins the five
/// o-rows (L140); by-id-one pins Bob (L146); by-id-missing pins 0 rows
/// (L149); insert-execute pins count 1 (L156); insert-round-trip pins
/// [Q'ueen] (L157); comment-literal pins 7 rows (L161); limit-bound pins
/// 2 rows (L165); hostile-or-input pins the L130 payload;
/// hostile-stacked-input pins the L133 payload; by-id-key pins 4 (L142);
/// missing-key pins 999 (L147).
/// Seed semantics live in history-011-seed-semantics.can; the
/// roots-green pin lives in history-011-roots-green.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in descriptors-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/descriptors-run checks: build-arg, seed-arg, env-gate,
/// missing-build, missing-seed, unset-db, url-space, url-scheme,
/// url-refusal, report-checks, harness-name, error-exit, search-like,
/// search-quote, search-unicode, injection-or, injection-stacked,
/// survives-injection, repeat-once, by-id-one, by-id-missing,
/// insert-execute, insert-round-trip, comment-literal, limit-bound,
/// hostile-or-input, hostile-stacked-input, by-id-key, missing-key.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int build_arg
    int seed_arg
    str env_gate
    str missing_build
    str missing_seed
    str unset_db
    str url_space
    str url_scheme
    str url_refusal
    str report_checks
    str harness_name
    int error_exit
    str search_like
    str search_quote
    str search_unicode
    str injection_or
    str injection_stacked
    str survives_injection
    str repeat_once
    str by_id_one
    str by_id_missing
    str insert_execute
    str insert_round_trip
    str comment_literal
    str limit_bound
    str hostile_or_input
    str hostile_stacked_input
    int by_id_key
    int missing_key
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/descriptors-run", "default", "", "offline"), "build-arg" => ok "case history/descriptors-run variant default root build-arg run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/descriptors-run", "default", "", "offline"), "build-arg" => ok evidence("build-arg", "true", "true", true, "case history/descriptors-run variant default root build-arg run offline")
        different: false, true, context("history/descriptors-run", "default", "", "offline"), "build-arg" => failed{"build-arg"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/descriptors-run", "default", "", "offline"), "build-arg" => ok evidence("build-arg", "2", "2", true, "case history/descriptors-run variant default root build-arg run offline")
        different: 1, 2, context("history/descriptors-run", "default", "", "offline"), "build-arg" => failed{"build-arg"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", context("history/descriptors-run", "default", "", "offline"), "env-gate" => ok evidence("env-gate", "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", true, "case history/descriptors-run variant default root env-gate run offline")
        different: "CAN_TEST_POSTGRES_URL2", "CAN_TEST_POSTGRES_URL", context("history/descriptors-run", "default", "", "offline"), "env-gate" => failed{"env-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(2, 3, "CAN_TEST_POSTGRES_URL", "missing build directory argument", "missing seed path argument", "set CAN_TEST_POSTGRES_URL to the disposable test database", " ", "postgres", "refusing non-postgres test URL", "checks", "harness", 1, "[Jason, Mason]", "[O'Brien]", "[Zoë]", "0 rows", "0 rows", "6 rows", "[Jason, Mason, Bob, O'Brien, Zoë]", "Bob", "0 rows", "count 1", "[Q'ueen]", "7 rows", "2 rows", "%' OR '1'='1", "'; DROP TABLE can_i37_accounts;--", 4, 999)
        seed_build_arg: "seed-build-arg-drift" => ok observation(1, 3, "CAN_TEST_POSTGRES_URL", "missing build directory argument", "missing seed path argument", "set CAN_TEST_POSTGRES_URL to the disposable test database", " ", "postgres", "refusing non-postgres test URL", "checks", "harness", 1, "[Jason, Mason]", "[O'Brien]", "[Zoë]", "0 rows", "0 rows", "6 rows", "[Jason, Mason, Bob, O'Brien, Zoë]", "Bob", "0 rows", "count 1", "[Q'ueen]", "7 rows", "2 rows", "%' OR '1'='1", "'; DROP TABLE can_i37_accounts;--", 4, 999)
