fn check[] checks
    emits {}
    given
        str scope
    asserts
        m24_h011: "m24-h011" => ok [check("stmt-count", "seed file holds exactly 4 statements"), check("comment-prefix", "seed parse filters -- comment lines"), check("line-split", "seed parse splits lines on LF before filtering"), check("stmt-split", "seed parse splits statements on ;"), check("s1-create", "seed statement 1 creates the accounts table"), check("s2-truncate", "seed statement 2 truncates accounts"), check("s3-insert", "seed statement 3 inserts accounts rows"), check("s4-drop", "seed statement 4 drops the accounts table"), check("count-message", "wrong statement count refuses with the count message"), check("shape-refusal", "changed seed shape refuses setup/teardown"), check("setup-apply", "setup applies the 3 create/truncate/insert statements"), check("teardown-drops", "teardown runs the 1 drop statement"), check("setup-first", "setup starts with the create binding"), check("setup-mid", "setup middles with the truncate binding"), check("setup-last", "setup ends with the insert binding"), check("teardown-only", "teardown drops the drop binding only")]
        other: "nope" => ok []
    match scope is "m24-h011"
        false => ok []
        true => ok [check("stmt-count", "seed file holds exactly 4 statements"), check("comment-prefix", "seed parse filters -- comment lines"), check("line-split", "seed parse splits lines on LF before filtering"), check("stmt-split", "seed parse splits statements on ;"), check("s1-create", "seed statement 1 creates the accounts table"), check("s2-truncate", "seed statement 2 truncates accounts"), check("s3-insert", "seed statement 3 inserts accounts rows"), check("s4-drop", "seed statement 4 drops the accounts table"), check("count-message", "wrong statement count refuses with the count message"), check("shape-refusal", "changed seed shape refuses setup/teardown"), check("setup-apply", "setup applies the 3 create/truncate/insert statements"), check("teardown-drops", "teardown runs the 1 drop statement"), check("setup-first", "setup starts with the create binding"), check("setup-mid", "setup middles with the truncate binding"), check("setup-last", "setup ends with the insert binding"), check("teardown-only", "teardown drops the drop binding only")]
