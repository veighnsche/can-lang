        true => ok test_case("history/descriptors-seed", ["history", "m24"], ["can-test-postgres-url"], 0, [check_ref("stmt-count"), check_ref("comment-prefix"), check_ref("line-split"), check_ref("stmt-split"), check_ref("s1-create"), check_ref("s2-truncate"), check_ref("s3-insert"), check_ref("s4-drop"), check_ref("count-message"), check_ref("shape-refusal"), check_ref("setup-apply"), check_ref("teardown-drops"), check_ref("setup-first"), check_ref("setup-mid"), check_ref("setup-last"), check_ref("teardown-only")], callable case_body)
