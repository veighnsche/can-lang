package m24history011seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-011 "descriptors-driver.ts: four-statement seed shape".
/// Source: tests/integration/testdata/sql/descriptors-driver.ts symbol
/// descriptors-driver.ts (L83-95 seed parse/shape legs, L92/L97/L169 setup
/// and drop bindings); related fixture
/// tests/integration/testdata/sql/descriptors.sql (L5-17 four statements
/// in seed order).
/// Disposition: migrate (this row ports descriptors-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the seed-file shape contract: the LF line split,
/// the comment filter and statement split, the four-statement count gate,
/// the four per-position kind pins in seed order, both refusal messages,
/// the setup/teardown apply counts, and the four setup/drop binding names.
/// ADAPTATION (recorded, with source lines): the setup-apply pin (3)
/// counts the L97 array elements and teardown-drops (1) counts the
/// L169 await (counts, not source literals, per the M12 app-count
/// precedent); the kind pins mirror startsWith prefixes (L93), not
/// full statements; count-message pins the static template prefix
/// (L91); setup-first/setup-mid/setup-last/teardown-only pin the L92
/// destructured binding names at their L97/L169 use sites (scenario
/// statement identities, not SQL text).
/// Facet map (descriptors-driver.ts legs): stmt-count pins 4 (L91);
/// comment-prefix pins -- (L86); line-split pins LF (L85/L87);
/// stmt-split pins ; (L88); s1-create pins CREATE TABLE (L93; sql L5);
/// s2-truncate pins TRUNCATE (L93; sql L9); s3-insert pins
/// INSERT INTO (L93; sql L10); s4-drop pins DROP TABLE (L93; sql L17);
/// count-message pins the L91 template prefix; shape-refusal pins the
/// L94 refusal; setup-apply pins 3 (L97); teardown-drops pins 1 (L169);
/// setup-first/setup-mid/setup-last pin create/truncate/insert (L92/L97);
/// teardown-only pins drop (L92/L169).
/// The roots-green pin lives in history-011-roots-green.can; the
/// invocation/run shape lives in history-011-run-shape.can.
/// Variants: none (single seed/teardown scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_POSTGRES_URL;
/// see related Go case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in descriptors-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/descriptors-seed checks: stmt-count, comment-prefix,
/// line-split, stmt-split, s1-create, s2-truncate, s3-insert, s4-drop,
/// count-message, shape-refusal, setup-apply, teardown-drops, setup-first,
/// setup-mid, setup-last, teardown-only.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int stmt_count
    str comment_prefix
    str line_split
    str stmt_split
    str s1_create
    str s2_truncate
    str s3_insert
    str s4_drop
    str count_message
    str shape_refusal
    int setup_apply
    int teardown_drops
    str setup_first
    str setup_mid
    str setup_last
    str teardown_only
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
