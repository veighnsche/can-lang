package m24history018run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-018 "descriptors.sql: statement order and head shape".
/// Source: tests/integration/testdata/sql/descriptors.sql (615
/// bytes, 17 lines, md5 6c0774a06d4a87271ff1a9078953cb9c).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the statement order and head shape: the
/// verbatim head line of each of the 4 statements in seed order
/// (full text for single-line statements, first line for the two
/// multi-line bodies), the terminator-line count, and the
/// DROP/CREATE/TRUNCATE/INSERT occurrence cross-checks.
/// ADAPTATION (recorded, with source lines): stmt-terms counts
/// lines ending in ; (4), not raw ; bytes (6: the L2 and L4 header
/// comments carry one extra semicolon each, which must not count
/// as terminators). Multi-line bodies pin their head line here;
/// their full bytes pin by md5 in
/// history-018-seed-semantics.can.
/// Facet map (descriptors.sql legs): s1-head pins the L5 create
/// head; s2-line the L9 truncate; s3-head the L10 insert head;
/// s4-line the L17 drop; stmt-terms pins 4 lines ending in ;;
/// drop-count pins 1 DROP TABLE occurrence (L17); create-count
/// pins 1 CREATE TABLE occurrence (L5); truncate-count pins 1
/// TRUNCATE occurrence (L9); insert-count pins 1 INSERT INTO
/// occurrence (L10).
/// Seed semantics live in history-018-seed-semantics.can; the
/// roots-green pin lives in history-018-roots-green.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/descriptors-run checks: s1-head, s2-line,
/// s3-head, s4-line, stmt-terms, drop-count, create-count,
/// truncate-count, insert-count.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str s1_head
    str s2_line
    str s3_head
    str s4_line
    int stmt_terms
    int drop_count
    int create_count
    int truncate_count
    int insert_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/descriptors-run", "default", "", "offline"), "s1-head" => ok "case history/descriptors-run variant default root s1-head run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/descriptors-run", "default", "", "offline"), "s1-head" => ok evidence("s1-head", "true", "true", true, "case history/descriptors-run variant default root s1-head run offline")
        different: false, true, context("history/descriptors-run", "default", "", "offline"), "s1-head" => failed{"s1-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/descriptors-run", "default", "", "offline"), "stmt-terms" => ok evidence("stmt-terms", "4", "4", true, "case history/descriptors-run variant default root stmt-terms run offline")
        different: 5, 4, context("history/descriptors-run", "default", "", "offline"), "stmt-terms" => failed{"stmt-terms"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CREATE TABLE IF NOT EXISTS can_i37_accounts (", "CREATE TABLE IF NOT EXISTS can_i37_accounts (", context("history/descriptors-run", "default", "", "offline"), "s1-head" => ok evidence("s1-head", "CREATE TABLE IF NOT EXISTS can_i37_accounts (", "CREATE TABLE IF NOT EXISTS can_i37_accounts (", true, "case history/descriptors-run variant default root s1-head run offline")
        different: "CREATE TABLE IF NOT EXISTS can_i37_accounts (2", "CREATE TABLE IF NOT EXISTS can_i37_accounts (", context("history/descriptors-run", "default", "", "offline"), "s1-head" => failed{"s1-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
        seed_s1_head: "seed-s1-head-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (2", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
        seed_s2_line: "seed-s2-line-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;2", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
        seed_s3_head: "seed-s3-head-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES2", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
        seed_s4_line: "seed-s4-line-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;2", 4, 1, 1, 1, 1)
        seed_stmt_terms: "seed-stmt-terms-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 3, 1, 1, 1, 1)
        seed_drop_count: "seed-drop-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 0, 1, 1, 1)
        seed_create_count: "seed-create-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 0, 1, 1)
        seed_truncate_count: "seed-truncate-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 0, 1)
        seed_insert_count: "seed-insert-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 0)
    match variant_id
        "seed-s1-head-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (2", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
        "seed-s2-line-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;2", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
        "seed-s3-head-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES2", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
        "seed-s4-line-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;2", 4, 1, 1, 1, 1)
        "seed-stmt-terms-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 3, 1, 1, 1, 1)
        "seed-drop-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 0, 1, 1, 1)
        "seed-create-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 0, 1, 1)
        "seed-truncate-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 0, 1)
        "seed-insert-count-drift" => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 0)
        _ => ok observation("CREATE TABLE IF NOT EXISTS can_i37_accounts (", "TRUNCATE can_i37_accounts RESTART IDENTITY;", "INSERT INTO can_i37_accounts (display_name) VALUES", "DROP TABLE can_i37_accounts;", 4, 1, 1, 1, 1)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m24_h018: "m24-h018" => ok [check("s1-head", "statement 1 head line is byte-exact"), check("s2-line", "statement 2 line is byte-exact"), check("s3-head", "statement 3 head line is byte-exact"), check("s4-line", "statement 4 line is byte-exact"), check("stmt-terms", "exactly 4 lines end in a statement terminator"), check("drop-count", "DROP TABLE occurs exactly 1 time"), check("create-count", "CREATE TABLE occurs exactly 1 time"), check("truncate-count", "TRUNCATE occurs exactly 1 time"), check("insert-count", "INSERT INTO occurs exactly 1 time")]
        other: "nope" => ok []
    match scope is "m24-h018"
        false => ok []
        true => ok [check("s1-head", "statement 1 head line is byte-exact"), check("s2-line", "statement 2 line is byte-exact"), check("s3-head", "statement 3 head line is byte-exact"), check("s4-line", "statement 4 line is byte-exact"), check("stmt-terms", "exactly 4 lines end in a statement terminator"), check("drop-count", "DROP TABLE occurs exactly 1 time"), check("create-count", "CREATE TABLE occurs exactly 1 time"), check("truncate-count", "TRUNCATE occurs exactly 1 time"), check("insert-count", "INSERT INTO occurs exactly 1 time")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/descriptors-run" => ok [expected_check("s1-head", "CREATE TABLE IF NOT EXISTS can_i37_accounts ("), expected_check("s2-line", "TRUNCATE can_i37_accounts RESTART IDENTITY;"), expected_check("s3-head", "INSERT INTO can_i37_accounts (display_name) VALUES"), expected_check("s4-line", "DROP TABLE can_i37_accounts;"), expected_check("stmt-terms", "4"), expected_check("drop-count", "1"), expected_check("create-count", "1"), expected_check("truncate-count", "1"), expected_check("insert-count", "1")]
        unknown: "nope" => ok []
    match case is "history/descriptors-run"
        false => ok []
        true => ok [expected_check("s1-head", "CREATE TABLE IF NOT EXISTS can_i37_accounts ("), expected_check("s2-line", "TRUNCATE can_i37_accounts RESTART IDENTITY;"), expected_check("s3-head", "INSERT INTO can_i37_accounts (display_name) VALUES"), expected_check("s4-line", "DROP TABLE can_i37_accounts;"), expected_check("stmt-terms", "4"), expected_check("drop-count", "1"), expected_check("create-count", "1"), expected_check("truncate-count", "1"), expected_check("insert-count", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/descriptors-run", "default", "", "offline") => ok
        seed_s1_head: context("history/descriptors-run", "seed-s1-head-drift", "", "offline") => failed{"s1-head"}
        seed_s2_line: context("history/descriptors-run", "seed-s2-line-drift", "", "offline") => failed{"s2-line"}
        seed_s3_head: context("history/descriptors-run", "seed-s3-head-drift", "", "offline") => failed{"s3-head"}
        seed_s4_line: context("history/descriptors-run", "seed-s4-line-drift", "", "offline") => failed{"s4-line"}
        seed_stmt_terms: context("history/descriptors-run", "seed-stmt-terms-drift", "", "offline") => failed{"stmt-terms"}
        seed_drop_count: context("history/descriptors-run", "seed-drop-count-drift", "", "offline") => failed{"drop-count"}
        seed_create_count: context("history/descriptors-run", "seed-create-count-drift", "", "offline") => failed{"create-count"}
        seed_truncate_count: context("history/descriptors-run", "seed-truncate-count-drift", "", "offline") => failed{"truncate-count"}
        seed_insert_count: context("history/descriptors-run", "seed-insert-count-drift", "", "offline") => failed{"insert-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.s1_head, "CREATE TABLE IF NOT EXISTS can_i37_accounts (", c, "s1-head")
            failed
            ok evidence s1_head_evidence => match call require_text(got.s2_line, "TRUNCATE can_i37_accounts RESTART IDENTITY;", c, "s2-line")
                failed
                ok evidence s2_line_evidence => match call require_text(got.s3_head, "INSERT INTO can_i37_accounts (display_name) VALUES", c, "s3-head")
                    failed
                    ok evidence s3_head_evidence => match call require_text(got.s4_line, "DROP TABLE can_i37_accounts;", c, "s4-line")
                        failed
                        ok evidence s4_line_evidence => match call require_int(got.stmt_terms, 4, c, "stmt-terms")
                            failed
                            ok evidence stmt_terms_evidence => match call require_int(got.drop_count, 1, c, "drop-count")
                                failed
                                ok evidence drop_count_evidence => match call require_int(got.create_count, 1, c, "create-count")
                                    failed
                                    ok evidence create_count_evidence => match call require_int(got.truncate_count, 1, c, "truncate-count")
                                        failed
                                        ok evidence truncate_count_evidence => match call require_int(got.insert_count, 1, c, "insert-count")
                                            failed
                                            ok evidence insert_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m24_h018: "m24-h018" => ok test_case("history/descriptors-run", ["history", "m24"], [], 0, [check_ref("s1-head"), check_ref("s2-line"), check_ref("s3-head"), check_ref("s4-line"), check_ref("stmt-terms"), check_ref("drop-count"), check_ref("create-count"), check_ref("truncate-count"), check_ref("insert-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m24-h018"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/descriptors-run", ["history", "m24"], [], 0, [check_ref("s1-head"), check_ref("s2-line"), check_ref("s3-head"), check_ref("s4-line"), check_ref("stmt-terms"), check_ref("drop-count"), check_ref("create-count"), check_ref("truncate-count"), check_ref("insert-count")], callable case_body)
