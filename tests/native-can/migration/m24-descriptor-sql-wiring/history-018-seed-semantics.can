package m24history018seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M24 HISTORY-018 "descriptors.sql: statement inventory byte truth".
/// Source: tests/integration/testdata/sql/descriptors.sql (615
/// bytes, 17 lines, md5 6c0774a06d4a87271ff1a9078953cb9c).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the static statement inventory: the file
/// size/line/hash envelope, the 4-line header comment count, the
/// 4-statement count, and one md5 pin per statement in seed order
/// (L5-8, L9, L10-16, L17).
/// ADAPTATION (recorded, with source lines): each sN-md5 pins md5
/// over that statement's exact line-span bytes including every
/// trailing newline, reproduced by sed -n '<range>p'
/// descriptors.sql | md5 (single-line statements equal their line
/// md5; multi-line spans cover the embedded newlines and 2-space
/// indents, so any whitespace drift breaks the pin). Every drift
/// seed flips the first digest char to 0 (no pinned digest starts
/// with 0). Verbatim single-line text lives in
/// history-018-run-shape.can; column lines and seed rows live in
/// history-018-roots-green.can.
/// Facet map (descriptors.sql legs): stmt-count pins 4 (L5-17);
/// comment-lines pins 4 (L1-4); total-lines pins 17; file-bytes
/// pins 615; file-md5 pins the whole-file digest; s1-md5 pins
/// the L5-8 create; s2-md5 the L9 truncate; s3-md5 the L10-16
/// insert; s4-md5 the L17 drop.
/// The roots-green pin lives in history-018-roots-green.can; the
/// invocation/run shape lives in history-018-run-shape.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/descriptors-seed checks: stmt-count,
/// comment-lines, total-lines, file-bytes, file-md5, s1-md5,
/// s2-md5, s3-md5, s4-md5.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int stmt_count
    int comment_lines
    int total_lines
    int file_bytes
    str file_md5
    str s1_md5
    str s2_md5
    str s3_md5
    str s4_md5
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/descriptors-seed", "default", "", "offline"), "stmt-count" => ok "case history/descriptors-seed variant default root stmt-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/descriptors-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "true", "true", true, "case history/descriptors-seed variant default root stmt-count run offline")
        different: false, true, context("history/descriptors-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/descriptors-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "4", "4", true, "case history/descriptors-seed variant default root stmt-count run offline")
        different: 5, 4, context("history/descriptors-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "6c0774a06d4a87271ff1a9078953cb9c", "6c0774a06d4a87271ff1a9078953cb9c", context("history/descriptors-seed", "default", "", "offline"), "file-md5" => ok evidence("file-md5", "6c0774a06d4a87271ff1a9078953cb9c", "6c0774a06d4a87271ff1a9078953cb9c", true, "case history/descriptors-seed variant default root file-md5 run offline")
        different: "6c0774a06d4a87271ff1a9078953cb9c2", "6c0774a06d4a87271ff1a9078953cb9c", context("history/descriptors-seed", "default", "", "offline"), "file-md5" => failed{"file-md5"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_stmt_count: "seed-stmt-count-drift" => ok observation(3, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_comment_lines: "seed-comment-lines-drift" => ok observation(4, 3, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_total_lines: "seed-total-lines-drift" => ok observation(4, 4, 16, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_file_bytes: "seed-file-bytes-drift" => ok observation(4, 4, 17, 614, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_file_md5: "seed-file-md5-drift" => ok observation(4, 4, 17, 615, "0c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_s1_md5: "seed-s1-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "06824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_s2_md5: "seed-s2-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "06485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_s3_md5: "seed-s3-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "082d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        seed_s4_md5: "seed-s4-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "085b46478e4d2d8550834b28b6349c0b")
    match variant_id
        "seed-stmt-count-drift" => ok observation(3, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-comment-lines-drift" => ok observation(4, 3, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-total-lines-drift" => ok observation(4, 4, 16, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-file-bytes-drift" => ok observation(4, 4, 17, 614, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-file-md5-drift" => ok observation(4, 4, 17, 615, "0c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-s1-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "06824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-s2-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "06485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-s3-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "082d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
        "seed-s4-md5-drift" => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "085b46478e4d2d8550834b28b6349c0b")
        _ => ok observation(4, 4, 17, 615, "6c0774a06d4a87271ff1a9078953cb9c", "56824878b29b918794ac4489f9e024e0", "16485bcaf72587177af69a4546ed4149", "e82d27635c813b45b9172c66dc3d4037", "785b46478e4d2d8550834b28b6349c0b")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m24_h018: "m24-h018" => ok [check("stmt-count", "seed file holds exactly 4 statements"), check("comment-lines", "seed file carries a 4-line header comment"), check("total-lines", "seed file holds exactly 17 lines"), check("file-bytes", "seed file is exactly 615 bytes"), check("file-md5", "seed file bytes hash to the pinned md5"), check("s1-md5", "statement 1 bytes hash to the pinned md5"), check("s2-md5", "statement 2 bytes hash to the pinned md5"), check("s3-md5", "statement 3 bytes hash to the pinned md5"), check("s4-md5", "statement 4 bytes hash to the pinned md5")]
        other: "nope" => ok []
    match scope is "m24-h018"
        false => ok []
        true => ok [check("stmt-count", "seed file holds exactly 4 statements"), check("comment-lines", "seed file carries a 4-line header comment"), check("total-lines", "seed file holds exactly 17 lines"), check("file-bytes", "seed file is exactly 615 bytes"), check("file-md5", "seed file bytes hash to the pinned md5"), check("s1-md5", "statement 1 bytes hash to the pinned md5"), check("s2-md5", "statement 2 bytes hash to the pinned md5"), check("s3-md5", "statement 3 bytes hash to the pinned md5"), check("s4-md5", "statement 4 bytes hash to the pinned md5")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/descriptors-seed" => ok [expected_check("stmt-count", "4"), expected_check("comment-lines", "4"), expected_check("total-lines", "17"), expected_check("file-bytes", "615"), expected_check("file-md5", "6c0774a06d4a87271ff1a9078953cb9c"), expected_check("s1-md5", "56824878b29b918794ac4489f9e024e0"), expected_check("s2-md5", "16485bcaf72587177af69a4546ed4149"), expected_check("s3-md5", "e82d27635c813b45b9172c66dc3d4037"), expected_check("s4-md5", "785b46478e4d2d8550834b28b6349c0b")]
        unknown: "nope" => ok []
    match case is "history/descriptors-seed"
        false => ok []
        true => ok [expected_check("stmt-count", "4"), expected_check("comment-lines", "4"), expected_check("total-lines", "17"), expected_check("file-bytes", "615"), expected_check("file-md5", "6c0774a06d4a87271ff1a9078953cb9c"), expected_check("s1-md5", "56824878b29b918794ac4489f9e024e0"), expected_check("s2-md5", "16485bcaf72587177af69a4546ed4149"), expected_check("s3-md5", "e82d27635c813b45b9172c66dc3d4037"), expected_check("s4-md5", "785b46478e4d2d8550834b28b6349c0b")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/descriptors-seed", "default", "", "offline") => ok
        seed_stmt_count: context("history/descriptors-seed", "seed-stmt-count-drift", "", "offline") => failed{"stmt-count"}
        seed_comment_lines: context("history/descriptors-seed", "seed-comment-lines-drift", "", "offline") => failed{"comment-lines"}
        seed_total_lines: context("history/descriptors-seed", "seed-total-lines-drift", "", "offline") => failed{"total-lines"}
        seed_file_bytes: context("history/descriptors-seed", "seed-file-bytes-drift", "", "offline") => failed{"file-bytes"}
        seed_file_md5: context("history/descriptors-seed", "seed-file-md5-drift", "", "offline") => failed{"file-md5"}
        seed_s1_md5: context("history/descriptors-seed", "seed-s1-md5-drift", "", "offline") => failed{"s1-md5"}
        seed_s2_md5: context("history/descriptors-seed", "seed-s2-md5-drift", "", "offline") => failed{"s2-md5"}
        seed_s3_md5: context("history/descriptors-seed", "seed-s3-md5-drift", "", "offline") => failed{"s3-md5"}
        seed_s4_md5: context("history/descriptors-seed", "seed-s4-md5-drift", "", "offline") => failed{"s4-md5"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.stmt_count, 4, c, "stmt-count")
            failed
            ok evidence stmt_count_evidence => match call require_int(got.comment_lines, 4, c, "comment-lines")
                failed
                ok evidence comment_lines_evidence => match call require_int(got.total_lines, 17, c, "total-lines")
                    failed
                    ok evidence total_lines_evidence => match call require_int(got.file_bytes, 615, c, "file-bytes")
                        failed
                        ok evidence file_bytes_evidence => match call require_text(got.file_md5, "6c0774a06d4a87271ff1a9078953cb9c", c, "file-md5")
                            failed
                            ok evidence file_md5_evidence => match call require_text(got.s1_md5, "56824878b29b918794ac4489f9e024e0", c, "s1-md5")
                                failed
                                ok evidence s1_md5_evidence => match call require_text(got.s2_md5, "16485bcaf72587177af69a4546ed4149", c, "s2-md5")
                                    failed
                                    ok evidence s2_md5_evidence => match call require_text(got.s3_md5, "e82d27635c813b45b9172c66dc3d4037", c, "s3-md5")
                                        failed
                                        ok evidence s3_md5_evidence => match call require_text(got.s4_md5, "785b46478e4d2d8550834b28b6349c0b", c, "s4-md5")
                                            failed
                                            ok evidence s4_md5_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m24_h018: "m24-h018" => ok test_case("history/descriptors-seed", ["history", "m24"], [], 0, [check_ref("stmt-count"), check_ref("comment-lines"), check_ref("total-lines"), check_ref("file-bytes"), check_ref("file-md5"), check_ref("s1-md5"), check_ref("s2-md5"), check_ref("s3-md5"), check_ref("s4-md5")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m24-h018"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/descriptors-seed", ["history", "m24"], [], 0, [check_ref("stmt-count"), check_ref("comment-lines"), check_ref("total-lines"), check_ref("file-bytes"), check_ref("file-md5"), check_ref("s1-md5"), check_ref("s2-md5"), check_ref("s3-md5"), check_ref("s4-md5")], callable case_body)
