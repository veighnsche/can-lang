package m25history007lock
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-007 "F02 locking: skip/nowait/ordinary/NO KEY semantics".
/// Source: tests/integration/sql_f02_test.go symbol
/// TestF02LiveLockingAndReturning (L21-159); locking verdicts
/// (L106-129); locking report struct (L58-77).
/// Disposition: migrate (this row ports TestF02LiveLockingAndReturning
/// to ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the PostgreSQL locking probe: tx1 claims 4
/// rows, tx2 SKIP LOCKED sees 0 under contention, NOWAIT classifies
/// to sql::query_failed/query_rows/55P03 outside a transaction and
/// carries 55P03 inside one, tx1 commits ok, and after release the
/// ordinary plus NO KEY reads see 4 each; the fifteen locking report
/// keys; and the six exact locking diagnostic texts.
/// ADAPTATION (recorded, with source lines): the int verdict pins
/// mirror the L110/L113/L126 inequality predicates as the wanted
/// counts (4/0/4); the in-txn leg pins the L120 Contains needle
/// (55P03) rather than a full classification record; diagnostic
/// pins quote the exact L111/L114/L118/L121/L124/L127 Fatalf
/// formats.
/// Facet map (sql_f02_test.go legs): tx1-claimed pins 4 (L110);
/// tx2-skipped pins 0 (L113); nowait-outcome/nowait-name/
/// nowait-operation/nowait-code pin domain/sql::query_failed/
/// query_rows/55P03 (L116-117); nowait-in-txn-needle pins 55P03
/// (L120); tx1-commit pins ok (L123); after-release/blocking/
/// nokey pin 4 each (L126); tx1-claimed-key/tx2-skipped-key/
/// nowait-key/nowait-in-txn-key/tx1-commit-key/after-release-key/
/// blocking-key/nokey-key pin the locking keys (L59-60/L68/L72-76);
/// outcome-key/name-key/payload-key/operation-key/code-key pin the
/// classification keys (L62-67); query-key/txn-key pin the in-txn
/// keys (L70-71); the six *-diag pins quote the locking Fatalf
/// formats (L111/L114/L118/L121/L124/L127).
/// The roots-green pin lives in history-007-roots-green.can; the
/// invocation plus identity/cost/mysql shape lives in
/// history-007-run-shape.can.
/// Variants: PG locking modes (skip/nowait/ordinary/no-key legs).
/// Environment: CAN_TEST_POSTGRES_URL plus bun on PATH gates;
/// requires can-test-postgres-url and bun; CAN_TEST_MYSQL_URL is
/// optional (mysql-optional leg only).
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 240000ms mirrors the Go 4-minute ctx (L42).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/f02-lock checks: tx1-claimed,
/// tx2-skipped, nowait-outcome, nowait-name, nowait-operation,
/// nowait-code, nowait-in-txn-needle, tx1-commit, after-release,
/// blocking, nokey, tx1-claimed-key, tx2-skipped-key, nowait-key,
/// nowait-in-txn-key, tx1-commit-key, after-release-key,
/// blocking-key, nokey-key, outcome-key, name-key, payload-key,
/// operation-key, code-key, query-key, txn-key, tx1-claimed-diag,
/// tx2-skipped-diag, nowait-diag, nowait-in-txn-diag,
/// tx1-commit-diag, after-release-diag.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int tx1_claimed
    int tx2_skipped
    str nowait_outcome
    str nowait_name
    str nowait_operation
    str nowait_code
    str nowait_in_txn_needle
    str tx1_commit
    int after_release
    int blocking
    int nokey
    str tx1_claimed_key
    str tx2_skipped_key
    str nowait_key
    str nowait_in_txn_key
    str tx1_commit_key
    str after_release_key
    str blocking_key
    str nokey_key
    str outcome_key
    str name_key
    str payload_key
    str operation_key
    str code_key
    str query_key
    str txn_key
    str tx1_claimed_diag
    str tx2_skipped_diag
    str nowait_diag
    str nowait_in_txn_diag
    str tx1_commit_diag
    str after_release_diag
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f02-lock", "default", "", "offline"), "tx1-claimed" => ok "case history/f02-lock variant default root tx1-claimed run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f02-lock", "default", "", "offline"), "tx1-claimed" => ok evidence("tx1-claimed", "true", "true", true, "case history/f02-lock variant default root tx1-claimed run offline")
        different: false, true, context("history/f02-lock", "default", "", "offline"), "tx1-claimed" => failed{"tx1-claimed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/f02-lock", "default", "", "offline"), "tx1-claimed" => ok evidence("tx1-claimed", "4", "4", true, "case history/f02-lock variant default root tx1-claimed run offline")
        different: 5, 4, context("history/f02-lock", "default", "", "offline"), "tx1-claimed" => failed{"tx1-claimed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "domain", "domain", context("history/f02-lock", "default", "", "offline"), "nowait-outcome" => ok evidence("nowait-outcome", "domain", "domain", true, "case history/f02-lock variant default root nowait-outcome run offline")
        different: "error", "domain", context("history/f02-lock", "default", "", "offline"), "nowait-outcome" => failed{"nowait-outcome"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(4, 0, "domain", "sql::query_failed", "query_rows", "55P03", "55P03", "ok", 4, 4, 4, "tx1_claimed", "tx2_skipped_count", "tx2_nowait", "tx2_nowait_in_txn", "tx1_commit", "tx2_after_release", "blocking_for_update_count", "nokey_count", "outcome", "name", "payload", "operation", "code", "query", "txn", "tx1 claimed %v rows, want 4", "tx2 skip-locked saw %v rows under contention, want 0", "nowait classification %+v, want sql::query_failed/query_rows/55P03", "in-txn nowait query %q, want a 55P03 classification", "tx1 commit %q, want ok", "after=%v blocking=%v nokey=%v, want 4 each")
        seed_tx1_claimed: "seed-tx1-claimed-drift" => ok observation(5, 0, "domain", "sql::query_failed", "query_rows", "55P03", "55P03", "ok", 4, 4, 4, "tx1_claimed", "tx2_skipped_count", "tx2_nowait", "tx2_nowait_in_txn", "tx1_commit", "tx2_after_release", "blocking_for_update_count", "nokey_count", "outcome", "name", "payload", "operation", "code", "query", "txn", "tx1 claimed %v rows, want 4", "tx2 skip-locked saw %v rows under contention, want 0", "nowait classification %+v, want sql::query_failed/query_rows/55P03", "in-txn nowait query %q, want a 55P03 classification", "tx1 commit %q, want ok", "after=%v blocking=%v nokey=%v, want 4 each")
        seed_tx2_skipped: "seed-tx2-skipped-drift" => ok observation(4, 1, "domain", "sql::query_failed", "query_rows", "55P03", "55P03", "ok", 4, 4, 4, "tx1_claimed", "tx2_skipped_count", "tx2_nowait", "tx2_nowait_in_txn", "tx1_commit", "tx2_after_release", "blocking_for_update_count", "nokey_count", "outcome", "name", "payload", "operation", "code", "query", "txn", "tx1 claimed %v rows, want 4", "tx2 skip-locked saw %v rows under contention, want 0", "nowait classification %+v, want sql::query_failed/query_rows/55P03", "in-txn nowait query %q, want a 55P03 classification", "tx1 commit %q, want ok", "after=%v blocking=%v nokey=%v, want 4 each")
