package m25history007roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-007 "F02 live probe: roots green, report inventory".
/// Source: tests/integration/sql_f02_test.go symbol
/// TestF02LiveLockingAndReturning (L21-159); env gates (L22-29);
/// redaction (L30-40); live context (L42); driver path (L44);
/// report struct (L55-96); version gate (L103-105).
/// Disposition: migrate (this row ports TestF02LiveLockingAndReturning
/// to ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the static live baseline as the green root:
/// both PostgreSQL/bun gates plus skip messages, the redaction
/// markers, the live context, the source-root hop, the driver path,
/// the optional MySQL gate, the report error/version keys, the
/// PostgreSQL 17 prefix, and the six report section keys.
/// ADAPTATION (recorded, with source lines): the context timeout
/// pins int minutes (4) from 4*time.Minute (L42); the redaction
/// markers pin the structural dummy values (L31/L35), never a
/// secret; the section keys pin the L77/L82/L87/L90/L94/L95 json
/// tags.
/// Facet map (legs): env-postgres-url pins CAN_TEST_POSTGRES_URL
/// (L22); skip-postgres-url pins the disposable-database skip
/// (L24); bun-tool pins bun (L26); skip-bun pins the missing-bun
/// skip (L28); redact-url/redact-password pin the dummy markers
/// (L31/L35); ctx-timeout-min pins 4 (L42); source-root-rel pins
/// ../.. (L41); driver-path pins f02-live-driver.ts (L44);
/// env-mysql-url pins CAN_TEST_MYSQL_URL (L48);
/// report-error-key/report-version-key pin error/serverVersion
/// (L56-57); version-prefix pins PostgreSQL 17. (L103);
/// locking-key/cost-key/ambiguity-key/returning-oracle-key/
/// keyed-key/mysql-key pin the report sections
/// (L77/L82/L87/L90/L94/L95). Driver internals belong to
/// HISTORY-012 (f02-live-driver.ts), not this row.
/// Locking semantics live in history-007-lock-semantics.can; the
/// invocation plus identity/cost/mysql shape lives in
/// history-007-run-shape.can.
/// Variants: none in this file (default only); PG locking modes
/// live in lock-semantics; writer/RETURNING/MySQL/timing legs
/// live in run-shape.
/// Environment: CAN_TEST_POSTGRES_URL plus bun on PATH gates;
/// requires can-test-postgres-url and bun; CAN_TEST_MYSQL_URL is
/// optional (mysql-optional leg only).
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 240000ms mirrors the Go 4-minute ctx (L42).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/f02-roots checks: env-postgres-url,
/// skip-postgres-url, bun-tool, skip-bun, redact-url,
/// redact-password, ctx-timeout-min, source-root-rel, driver-path,
/// env-mysql-url, report-error-key, report-version-key,
/// version-prefix, locking-key, cost-key, ambiguity-key,
/// returning-oracle-key, keyed-key, mysql-key.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_postgres_url
    str skip_postgres_url
    str bun_tool
    str skip_bun
    str redact_url
    str redact_password
    int ctx_timeout_min
    str source_root_rel
    str driver_path
    str env_mysql_url
    str report_error_key
    str report_version_key
    str version_prefix
    str locking_key
    str cost_key
    str ambiguity_key
    str returning_oracle_key
    str keyed_key
    str mysql_key
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f02-roots", "default", "", "offline"), "env-postgres-url" => ok "case history/f02-roots variant default root env-postgres-url run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f02-roots", "default", "", "offline"), "env-postgres-url" => ok evidence("env-postgres-url", "true", "true", true, "case history/f02-roots variant default root env-postgres-url run offline")
        different: false, true, context("history/f02-roots", "default", "", "offline"), "env-postgres-url" => failed{"env-postgres-url"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/f02-roots", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "4", "4", true, "case history/f02-roots variant default root ctx-timeout-min run offline")
        different: 5, 4, context("history/f02-roots", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", context("history/f02-roots", "default", "", "offline"), "env-postgres-url" => ok evidence("env-postgres-url", "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", true, "case history/f02-roots variant default root env-postgres-url run offline")
        different: "CAN_TEST_POSTGRES_URL_2", "CAN_TEST_POSTGRES_URL", context("history/f02-roots", "default", "", "offline"), "env-postgres-url" => failed{"env-postgres-url"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
