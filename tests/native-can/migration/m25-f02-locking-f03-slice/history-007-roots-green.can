        seed_redact_password: context("history/f02-roots", "seed-redact-password-drift", "", "offline") => failed{"redact-password"}
        seed_ctx_timeout_min: context("history/f02-roots", "seed-ctx-timeout-min-drift", "", "offline") => failed{"ctx-timeout-min"}
        seed_source_root_rel: context("history/f02-roots", "seed-source-root-rel-drift", "", "offline") => failed{"source-root-rel"}
        seed_driver_path: context("history/f02-roots", "seed-driver-path-drift", "", "offline") => failed{"driver-path"}
        seed_env_mysql_url: context("history/f02-roots", "seed-env-mysql-url-drift", "", "offline") => failed{"env-mysql-url"}
        seed_report_error_key: context("history/f02-roots", "seed-report-error-key-drift", "", "offline") => failed{"report-error-key"}
        seed_report_version_key: context("history/f02-roots", "seed-report-version-key-drift", "", "offline") => failed{"report-version-key"}
        seed_version_prefix: context("history/f02-roots", "seed-version-prefix-drift", "", "offline") => failed{"version-prefix"}
        seed_locking_key: context("history/f02-roots", "seed-locking-key-drift", "", "offline") => failed{"locking-key"}
        seed_cost_key: context("history/f02-roots", "seed-cost-key-drift", "", "offline") => failed{"cost-key"}
        seed_ambiguity_key: context("history/f02-roots", "seed-ambiguity-key-drift", "", "offline") => failed{"ambiguity-key"}
        seed_returning_oracle_key: context("history/f02-roots", "seed-returning-oracle-key-drift", "", "offline") => failed{"returning-oracle-key"}
        seed_keyed_key: context("history/f02-roots", "seed-keyed-key-drift", "", "offline") => failed{"keyed-key"}
        seed_mysql_key: context("history/f02-roots", "seed-mysql-key-drift", "", "offline") => failed{"mysql-key"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.env_postgres_url, "CAN_TEST_POSTGRES_URL", c, "env-postgres-url")
            failed
            ok evidence env_postgres_url_evidence => match call require_text(got.skip_postgres_url, "set CAN_TEST_POSTGRES_URL to a disposable PostgreSQL for the F02 live probe", c, "skip-postgres-url")
                failed
                ok evidence skip_postgres_url_evidence => match call require_text(got.bun_tool, "bun", c, "bun-tool")
                    failed
                    ok evidence bun_tool_evidence => match call require_text(got.skip_bun, "bun is not on PATH for the F02 live probe", c, "skip-bun")
                        failed
                        ok evidence skip_bun_evidence => match call require_text(got.redact_url, "<redacted-url>", c, "redact-url")
                            failed
                            ok evidence redact_url_evidence => match call require_text(got.redact_password, "<redacted-password>", c, "redact-password")
                                failed
                                ok evidence redact_password_evidence => match call require_int(got.ctx_timeout_min, 4, c, "ctx-timeout-min")
                                    failed
                                    ok evidence ctx_timeout_min_evidence => match call require_text(got.source_root_rel, "../..", c, "source-root-rel")
                                        failed
                                        ok evidence source_root_rel_evidence => match call require_text(got.driver_path, "tests/integration/testdata/sql/f02-live-driver.ts", c, "driver-path")
                                            failed
                                            ok evidence driver_path_evidence => match call require_text(got.env_mysql_url, "CAN_TEST_MYSQL_URL", c, "env-mysql-url")
                                                failed
                                                ok evidence env_mysql_url_evidence => match call require_text(got.report_error_key, "error", c, "report-error-key")
                                                    failed
                                                    ok evidence report_error_key_evidence => match call require_text(got.report_version_key, "serverVersion", c, "report-version-key")
                                                        failed
                                                        ok evidence report_version_key_evidence => match call require_text(got.version_prefix, "PostgreSQL 17.", c, "version-prefix")
                                                            failed
                                                            ok evidence version_prefix_evidence => match call require_text(got.locking_key, "locking", c, "locking-key")
                                                                failed
                                                                ok evidence locking_key_evidence => match call require_text(got.cost_key, "cost", c, "cost-key")
                                                                    failed
                                                                    ok evidence cost_key_evidence => match call require_text(got.ambiguity_key, "ambiguity", c, "ambiguity-key")
                                                                        failed
                                                                        ok evidence ambiguity_key_evidence => match call require_text(got.returning_oracle_key, "returning_oracle", c, "returning-oracle-key")
                                                                            failed
                                                                            ok evidence returning_oracle_key_evidence => match call require_text(got.keyed_key, "keyed_control", c, "keyed-key")
                                                                                failed
                                                                                ok evidence keyed_key_evidence => match call require_text(got.mysql_key, "mysql", c, "mysql-key")
                                                                                    failed
                                                                                    ok evidence mysql_key_evidence => ok
