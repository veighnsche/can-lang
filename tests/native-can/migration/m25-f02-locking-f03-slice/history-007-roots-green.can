fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/f02-roots", "default", "", "offline") => ok
        seed_env_postgres_url: context("history/f02-roots", "seed-env-postgres-url-drift", "", "offline") => failed{"env-postgres-url"}
        seed_skip_postgres_url: context("history/f02-roots", "seed-skip-postgres-url-drift", "", "offline") => failed{"skip-postgres-url"}
