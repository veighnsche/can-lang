package m25history007run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-007 "F02 live probe: invocation and identity/cost/mysql".
/// Source: tests/integration/sql_f02_test.go symbol
/// TestF02LiveLockingAndReturning (L21-159); driver invocation
/// (L45-54); cost leg (L130-134); ambiguity leg (L135-142); keyed
/// control (L143-147); MySQL leg (L148-158).
/// Disposition: migrate (this row ports TestF02LiveLockingAndReturning
/// to ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live run shape: the bun driver argv
/// with temp workdir and combined output, the three-entry base env
/// with PATH/HOME prefixes plus the optional MySQL append, the
/// cost/ambiguity/oracle/keyed/mysql report keys, the recorded
/// (not thresholded) timing contract, the 8/8/unidentifiable
/// ambiguity verdict, the 1-row RETURNING oracle, the 16-writer
/// keyed verdict, the MySQL INSERT RETURNING rejection, and the
/// exact driver/report/log diagnostic texts.
/// ADAPTATION (recorded, with source lines): driver-arg-count pins
/// 2 from bun plus driver argv (L45); workdir-temp pins true from
/// t.TempDir (L46); driver-env-base-count pins 3 from the
/// PATH/HOME/URL entries (L47); mysql-optional pins true for the
/// conditional append (L48-50); timing-not-thresholded pins true
/// for the reported-not-gated timing (L130-133); the
/// cost-*-required pins mirror the L132 presence predicate
/// without inventing a threshold.
/// Facet map (legs): driver-arg-count pins 2 (L45); workdir-temp
/// pins the temp dir (L46); driver-output-fn pins CombinedOutput
/// (L51); driver-env-base-count pins 3 (L47); env-path-prefix/
/// env-home-prefix pin PATH=/HOME= (L47); mysql-optional pins the
/// conditional append (L48-50); cost-iterations-key/cost-can-key/
/// cost-returning-key pin the cost keys (L79-81);
/// cost-iterations-required/cost-can-required/cost-returning-required
/// pin the presence predicate (L132); timing-not-thresholded pins
/// the recorded timing (L130-133); cost-diag pins the cost Fatalf
/// (L133); ambiguity-inserts/ambiguity-candidates pin 8/8 and
/// ambiguity-identifiable pins false (L137); the ambiguity *-key
/// pins name the ambiguity keys (L84-86); ambiguity-diag pins the
/// ambiguity Fatalf (L138); returning-rows pins 1 (L140);
/// returning-rows-key pins rows (L89); returning-diag pins the
/// oracle Fatalf (L141); keyed-writers/keyed-all-own pin 16/true
/// (L145); keyed-writers-key/keyed-all-own-key pin the keyed keys
/// (L92-93); keyed-diag pins the keyed Fatalf (L146);
/// insert-returning-key/rejected-key pin the mysql keys (L151-152);
/// mysql-rejected pins true (L152); mysql-diag pins the mysql
/// Fatalf (L153); driver-fail-diag/invalid-report-diag/
/// driver-error-diag/unexpected-db-diag pin the driver/report
/// Fatalf formats (L53/L98/L101/L104); live-log-fmt/
/// live-log-skipped-fmt pin the success logs (L155/L157);
/// version-split-needle pins " on " (L155/L157).
/// The roots-green pin lives in history-007-roots-green.can;
/// locking semantics live in history-007-lock-semantics.can.
/// Variants: ambiguous 8 writers, keyed 16 writers, raw RETURNING,
/// optional MySQL, timing evidence only (one default case; the PG
/// locking modes live in lock-semantics).
/// Environment: CAN_TEST_POSTGRES_URL plus bun on PATH gates;
/// requires can-test-postgres-url and bun; CAN_TEST_MYSQL_URL is
/// optional (mysql-optional leg only).
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 240000ms mirrors the Go 4-minute ctx (L42).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/f02-run checks: driver-arg-count,
/// workdir-temp, driver-output-fn, driver-env-base-count,
/// env-path-prefix, env-home-prefix, mysql-optional,
/// cost-iterations-key, cost-can-key, cost-returning-key,
/// cost-iterations-required, cost-can-required,
/// cost-returning-required, timing-not-thresholded, cost-diag,
/// ambiguity-inserts, ambiguity-candidates,
/// ambiguity-identifiable, ambiguity-inserts-key,
/// ambiguity-candidates-key, ambiguity-identifiable-key,
/// ambiguity-diag, returning-rows, returning-rows-key,
/// returning-diag, keyed-writers, keyed-all-own,
/// keyed-writers-key, keyed-all-own-key, keyed-diag,
/// insert-returning-key, rejected-key, mysql-rejected, mysql-diag,
/// driver-fail-diag, invalid-report-diag, driver-error-diag,
/// unexpected-db-diag, live-log-fmt, live-log-skipped-fmt,
/// version-split-needle.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int driver_arg_count
    bool workdir_temp
    str driver_output_fn
    int driver_env_base_count
    str env_path_prefix
    str env_home_prefix
    bool mysql_optional
    str cost_iterations_key
    str cost_can_key
    str cost_returning_key
    bool cost_iterations_required
    bool cost_can_required
    bool cost_returning_required
    bool timing_not_thresholded
    str cost_diag
    int ambiguity_inserts
    int ambiguity_candidates
    bool ambiguity_identifiable
    str ambiguity_inserts_key
    str ambiguity_candidates_key
    str ambiguity_identifiable_key
    str ambiguity_diag
    int returning_rows
    str returning_rows_key
    str returning_diag
    int keyed_writers
    bool keyed_all_own
    str keyed_writers_key
    str keyed_all_own_key
    str keyed_diag
    str insert_returning_key
    str rejected_key
    bool mysql_rejected
    str mysql_diag
    str driver_fail_diag
    str invalid_report_diag
    str driver_error_diag
    str unexpected_db_diag
    str live_log_fmt
    str live_log_skipped_fmt
    str version_split_needle
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f02-run", "default", "", "offline"), "driver-arg-count" => ok "case history/f02-run variant default root driver-arg-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f02-run", "default", "", "offline"), "workdir-temp" => ok evidence("workdir-temp", "true", "true", true, "case history/f02-run variant default root workdir-temp run offline")
        different: false, true, context("history/f02-run", "default", "", "offline"), "workdir-temp" => failed{"workdir-temp"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/f02-run", "default", "", "offline"), "driver-arg-count" => ok evidence("driver-arg-count", "2", "2", true, "case history/f02-run variant default root driver-arg-count run offline")
        different: 3, 2, context("history/f02-run", "default", "", "offline"), "driver-arg-count" => failed{"driver-arg-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CombinedOutput", "CombinedOutput", context("history/f02-run", "default", "", "offline"), "driver-output-fn" => ok evidence("driver-output-fn", "CombinedOutput", "CombinedOutput", true, "case history/f02-run variant default root driver-output-fn run offline")
        different: "Output", "CombinedOutput", context("history/f02-run", "default", "", "offline"), "driver-output-fn" => failed{"driver-output-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(2, true, "CombinedOutput", 3, "PATH=", "HOME=", true, "iterations", "can_txn_insert_plus_refetch_ms", "raw_single_returning_ms", true, true, true, true, "cost leg missing measurements %+v", 8, 8, false, "concurrent_identical_inserts", "refetch_candidate_rows", "writer_identifiable", "ambiguity leg %+v, want 8 inserts/8 candidates/unidentifiable", 1, "rows", "returning oracle rows %v, want 1", 16, true, "writers", "all_refetched_own_row", "keyed control %+v, want 16 writers all exact", "insert_returning", "rejected", true, "mysql insert_returning %+v, want a rejection record", "f02 driver: %v %s", "invalid f02 report %v %s", "f02 driver: %s", "unexpected live database %q", "f02 live: PG %s, mysql %v", "f02 live: PG %s, mysql skipped (%v)", " on ")
