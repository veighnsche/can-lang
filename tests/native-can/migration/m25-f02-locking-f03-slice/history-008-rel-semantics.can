package m25history008rel
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-008 "F03 live relational slice: answer semantics".
/// Source: tests/integration/sql_f03_test.go symbol
/// TestF03LiveRelationalSlice (L24-242); driver
/// tests/integration/testdata/sql/f03-live-driver.ts (L271-557)
/// with seven report parts (L295-532).
/// Disposition: migrate (this row ports TestF03LiveRelationalSlice to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live relational answers: single/multi
/// RETURNING rows with bigint identity, do-nothing first/repeat rows,
/// native 23505 conflict errno plus constraint, duplicate/absent/
/// two-row/wide error vocabulary outcomes and names, poisoned first/
/// followup outcomes with 25P02, poisoned txn ok plus replay, eight/
/// eight/one lookup settlement with race-digest winner and no poison,
/// seven encoding roundtrips, SQLite single/multi rows, MySQL 1064
/// errno plus eight-writer ownership mapping.
/// ADAPTATION (recorded, with source lines): single-rows pins int (1)
/// from the Go float compare (L154) plus driver length (driver L299);
/// multi/conflict-first/conflict-repeat/tworow-actual/settlement/
/// sqlite/mysql counts pin int from Go float compares (L157/L160/
/// L178/L205/L218/L233) plus driver lengths; single-id-type pins
/// bigint from the Go string compare (L154) plus driver typeof
/// (driver L300); duplicate/absent/tworow/wide/first/followup
/// outcomes pin domain from the Go verdicts (L171/L175/L178/L181/
/// L189/L192) plus driver outcomeOf (driver L268-269); txn-outcome
/// pins ok from the Go verdict (L196) plus driver outcomeOf;
/// replay-ok pins true from the Go guard (L199) plus driver
/// replay_ok (driver L373); saw-poisoned pins false from the Go
/// guard (L208) plus driver saw_25P02 (driver L423); encoding legs
/// pin true from the Go guard (L214) plus driver flags (driver
/// L437-455); mysql-errno pins int (1064) from the Go float compare
/// (L229) plus driver errno (driver L475).
/// Facet map (Go verdict legs): single-rows/single-id-type pin 1/
/// bigint (L154-155); multi-rows pins 3 (L157-158);
/// conflict-first-rows/conflict-repeat-rows pin 1/0 (L160-161);
/// conflict-errno/conflict-constraint pin 23505 plus the deliveries
/// pkey (L163-164); duplicate-outcome/duplicate-name pin
/// domain/sql::constraint_failed (L171) plus the pkey (L172);
/// absent-outcome/absent-name pin domain/sql::row_missing (L175);
/// tworow-outcome/tworow-name/tworow-actual pin domain/
/// sql::row_count/2 (L178); wide-outcome/wide-name/wide-reason pin
/// domain/sql::schema_mismatch/extra_column (L181);
/// first-outcome/first-name pin domain/sql::constraint_failed
/// (L189); followup-outcome/followup-name/followup-code pin domain/
/// sql::query_failed/25P02 (L192-193); txn-outcome pins ok (L196);
/// replay-ok pins true (L199); writers/settled/accepted pin 8/8/1
/// (L205); winner-digest/saw-poisoned pin race-digest/false (L208);
/// null-audit-none/minor-unit/ms-epoch/set-audit/json-codec/
/// int64-max/int64-min pin true (L214); sqlite-single/sqlite-multi
/// pin 1/3 (L218); mysql-errno pins 1064 (L229);
/// mysql-writers/mysql-all-own/mysql-distinct pin 8/true/8 (L233).
/// The roots-green pin lives in history-008-roots-green.can; the
/// run shape plus diagnostics live in
/// history-008-run-shape.can.
/// Variants: PG RETURNING, error vocabulary, aborted transaction
/// plus replay, eight-writer race, encoding edges, SQLite, optional
/// MySQL (all in Go order).
/// Environment: CAN_TEST_POSTGRES_URL plus bun on PATH gates;
/// CAN_TEST_MYSQL_URL is optional; requires can-test-postgres-url
/// and bun-on-path.
/// Logical gates SUITE/CAN/DB/NATIVE/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. Accept gates P23/QD1 (plus
/// QN1/QD2/QD3/QD4) are unmet. F03 timeout 240000ms mirrors the Go
/// 4-minute ctx (sql_f03_test.go L45).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/f03-rel checks: single-rows, single-id-type,
/// multi-rows, conflict-first-rows, conflict-repeat-rows,
/// conflict-errno, conflict-constraint, duplicate-outcome,
/// duplicate-name, duplicate-constraint, absent-outcome,
/// absent-name, tworow-outcome, tworow-name, tworow-actual,
/// wide-outcome, wide-name, wide-reason, first-outcome,
/// first-name, followup-outcome, followup-name, followup-code,
/// txn-outcome, replay-ok, writers, settled, accepted,
/// winner-digest, saw-poisoned, null-audit-none, minor-unit,
/// ms-epoch, set-audit, json-codec, int64-max, int64-min,
/// sqlite-single, sqlite-multi, mysql-errno, mysql-writers,
/// mysql-all-own, mysql-distinct.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int single_rows
    str single_id_type
    int multi_rows
    int conflict_first_rows
    int conflict_repeat_rows
    str conflict_errno
    str conflict_constraint
    str duplicate_outcome
    str duplicate_name
    str duplicate_constraint
    str absent_outcome
    str absent_name
    str tworow_outcome
    str tworow_name
    int tworow_actual
    str wide_outcome
    str wide_name
    str wide_reason
    str first_outcome
    str first_name
    str followup_outcome
    str followup_name
    str followup_code
    str txn_outcome
    bool replay_ok
    int writers
    int settled
    int accepted
    str winner_digest
    bool saw_poisoned
    bool null_audit_none
    bool minor_unit
    bool ms_epoch
    bool set_audit
    bool json_codec
    bool int64_max
    bool int64_min
    int sqlite_single
    int sqlite_multi
    int mysql_errno
    int mysql_writers
    bool mysql_all_own
    int mysql_distinct
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f03-rel", "default", "", "offline"), "single-rows" => ok "case history/f03-rel variant default root single-rows run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f03-rel", "default", "", "offline"), "replay-ok" => ok evidence("replay-ok", "true", "true", true, "case history/f03-rel variant default root replay-ok run offline")
        different: false, true, context("history/f03-rel", "default", "", "offline"), "replay-ok" => failed{"replay-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/f03-rel", "default", "", "offline"), "single-rows" => ok evidence("single-rows", "1", "1", true, "case history/f03-rel variant default root single-rows run offline")
        different: 2, 1, context("history/f03-rel", "default", "", "offline"), "single-rows" => failed{"single-rows"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "bigint", "bigint", context("history/f03-rel", "default", "", "offline"), "single-id-type" => ok evidence("single-id-type", "bigint", "bigint", true, "case history/f03-rel variant default root single-id-type run offline")
        different: "bigint_2", "bigint", context("history/f03-rel", "default", "", "offline"), "single-id-type" => failed{"single-id-type"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
