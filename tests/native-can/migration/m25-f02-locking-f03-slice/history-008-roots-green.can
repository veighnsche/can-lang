package m25history008roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-008 "F03 live relational slice: roots green".
/// Source: tests/integration/sql_f03_test.go symbol
/// TestF03LiveRelationalSlice (L24-52); env gates (L25-32); redact
/// helper (L33-43); live context (L45); driver path (L47);
/// driver tests/integration/testdata/sql/f03-live-driver.ts
/// (L37-52 env gates; L273-283 setup DDL).
/// Disposition: migrate (this row ports TestF03LiveRelationalSlice to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the static live baseline as the green root:
/// both environment gates plus skip messages, the bun gate plus skip,
/// the driver path, the live context, the PostgreSQL 17 version
/// prefix, the provision placeholder plus database, the five table
/// names, the gen identity shape, both redact sentinels, the MySQL
/// skip marker, the SQLite memory name, and the driver seed values
/// (absent id, pair payload, single payload, conflict key, race key,
/// money minor units, epoch instants, int64 edges, unicode note).
/// ADAPTATION (recorded, with source lines): the context timeout pins
/// int minutes (4) from 4*time.Minute (L45); the absent id pins int
/// (424242) from the driver probe (driver L328); the money minor
/// units pin int (1099) from the driver seed (driver L339); epoch
/// and int64 edge pins use str spellings (driver L339/L431/L448)
/// because fixed-width literal edges are out of scope for this
/// offline pin; the version pin keeps the exact Go prefix spelling
/// (L146); redact sentinels pin the dummy refusal literals only
/// (L34/L38), never a secret value.
/// Facet map (legs): env-postgres-url pins CAN_TEST_POSTGRES_URL
/// (L25); skip-postgres-url pins the F03 probe skip (L27); bun-bin
/// pins bun (L29); skip-bun pins the PATH skip (L31); env-mysql-url
/// pins CAN_TEST_MYSQL_URL (L51); driver-path pins
/// f03-live-driver.ts (L47); ctx-timeout-min pins 4 (L45);
/// version-prefix pins PostgreSQL 17. (L146);
/// provision-placeholder pins <db> (L20; driver L47);
/// provision-db pins can_f03 (L21; driver L47); table-deliveries
/// pins f03_deliveries (driver L281); table-gen pins f03_gen
/// (driver L282); table-money pins f03_money (driver L283);
/// table-mygen pins f03_mygen (driver L466); table-lite pins
/// f03_lite (driver L526); gen-identity pins the always identity
/// (driver L282); redact-url pins the URL sentinel (L34);
/// redact-password pins the password sentinel (L38); mysql-skip
/// pins skipped:no-mysql-url (driver L461); sqlite-mem pins
/// :memory: (driver L523); absent-id pins 424242 (driver L328);
/// pair-payload pins pair (driver L331); seed-price-minor pins
/// 1099 (driver L339); seed-recorded-ms pins 1727222400000
/// (driver L339); seed-audit-ms pins 1727222500000 (driver L431);
/// int64-max-value pins 9223372036854775807 (driver L448);
/// int64-min-value pins -9223372036854775808 (driver L448);
/// json-note pins the unicode note (driver L427); single-payload
/// pins one (driver L298); conflict-key pins d0 (driver L303);
/// race-key pins race (driver L389).
/// Answer semantics live in history-008-rel-semantics.can; the run
/// shape plus diagnostics live in
/// history-008-run-shape.can.
/// Variants: none in this file (default only); the seven report
/// parts live in rel-semantics.
/// Environment: CAN_TEST_POSTGRES_URL plus bun on PATH gates;
/// CAN_TEST_MYSQL_URL is optional; requires can-test-postgres-url
/// and bun-on-path.
/// Logical gates SUITE/CAN/DB/NATIVE/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. Accept gates P23/QD1 (plus
/// QN1/QD2/QD3/QD4) are unmet. F03 timeout 240000ms mirrors the Go
/// 4-minute ctx (L45).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/f03-roots checks: env-postgres-url,
/// skip-postgres-url, bun-bin, skip-bun, env-mysql-url,
/// driver-path, ctx-timeout-min, version-prefix,
/// provision-placeholder, provision-db, table-deliveries,
/// table-gen, table-money, table-mygen, table-lite, gen-identity,
/// redact-url, redact-password, mysql-skip, sqlite-mem, absent-id,
/// pair-payload, seed-price-minor, seed-recorded-ms, seed-audit-ms,
/// int64-max-value, int64-min-value, json-note, single-payload,
/// conflict-key, race-key.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_postgres_url
    str skip_postgres_url
    str bun_bin
    str skip_bun
    str env_mysql_url
    str driver_path
    int ctx_timeout_min
    str version_prefix
    str provision_placeholder
    str provision_db
    str table_deliveries
    str table_gen
    str table_money
    str table_mygen
    str table_lite
    str gen_identity
    str redact_url
    str redact_password
    str mysql_skip
    str sqlite_mem
    int absent_id
    str pair_payload
    int seed_price_minor
    str seed_recorded_ms
    str seed_audit_ms
    str int64_max_value
    str int64_min_value
    str json_note
    str single_payload
    str conflict_key
    str race_key
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f03-roots", "default", "", "offline"), "env-postgres-url" => ok "case history/f03-roots variant default root env-postgres-url run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f03-roots", "default", "", "offline"), "env-postgres-url" => ok evidence("env-postgres-url", "true", "true", true, "case history/f03-roots variant default root env-postgres-url run offline")
        different: false, true, context("history/f03-roots", "default", "", "offline"), "env-postgres-url" => failed{"env-postgres-url"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/f03-roots", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "4", "4", true, "case history/f03-roots variant default root ctx-timeout-min run offline")
        different: 5, 4, context("history/f03-roots", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", context("history/f03-roots", "default", "", "offline"), "env-postgres-url" => ok evidence("env-postgres-url", "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", true, "case history/f03-roots variant default root env-postgres-url run offline")
        different: "CAN_TEST_POSTGRES_URL_2", "CAN_TEST_POSTGRES_URL", context("history/f03-roots", "default", "", "offline"), "env-postgres-url" => failed{"env-postgres-url"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
