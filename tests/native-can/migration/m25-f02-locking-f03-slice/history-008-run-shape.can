package m25history008run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-008 "F03 live relational slice: run shape".
/// Source: tests/integration/sql_f03_test.go symbol
/// TestF03LiveRelationalSlice (L24-242); driver launch (L47-54);
/// report validation (L140-148); verdict legs (L149-241); driver
/// refusal (driver L39-46); owned-run guard (driver L537-538).
/// Disposition: migrate (this row ports TestF03LiveRelationalSlice to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live run shape: the bun driver launch
/// (base env count, optional MySQL entry, argv count, temp workdir,
/// HOME binding, combined output), every Go fatal plus log
/// diagnostic spelling, both driver refusal diagnostics, the owned
/// run guard, the raw pool widths, the pool close timeout, and the
/// unexpected-ok admission marker.
/// ADAPTATION (recorded, with source lines): base-env-count pins 3
/// from the three slice entries PATH/HOME/URL (L50);
/// mysql-extra-count pins 1 from the single conditional append
/// (L51-52), so the MySQL run carries 4 entries; driver-arg-count
/// pins 1 from binary plus driver argv (L48); workdir-temp pins true
/// from t.TempDir (L49); home-is-workdir pins true from HOME plus
/// cmd.Dir (L50); combined-output pins the method name (L54);
/// pg-pool-max pins 8 from max 8 (driver L274); mysql-pool-max pins
/// 4 from max 4 (driver L463); close-timeout-ms pins 5000 from the
/// 5000n closes (driver L515/L534); diagnostic pins keep exact Go
/// Fatalf/Logf spellings (L56/L141/L144/L147/L155-234/L236/L239)
/// and driver literals (driver L40/L44/L309/L538).
/// Facet map (legs): base-env-count pins 3 (L50);
/// mysql-extra-count pins 1 (L51-52); driver-arg-count pins 1
/// (L48); workdir-temp pins the temp dir (L49); home-is-workdir
/// pins HOME binding (L50); combined-output pins CombinedOutput
/// (L54); fatal-driver-err pins the launch wrap (L56);
/// fatal-report pins the decode wrap (L141); fatal-driver-msg pins
/// the error-field wrap (L144); fatal-db pins the version gate
/// (L147); fatal-single pins the 1/bigint want (L155);
/// fatal-multi pins the 3 want (L158); fatal-do-nothing pins the
/// 1/0 want (L161); fatal-conflict pins the 23505 want (L164);
/// fatal-duplicate pins the constraint want (L173); fatal-absent
/// pins the row-missing want (L176); fatal-tworow pins the row
/// count want (L179); fatal-wide pins the schema want (L182);
/// fatal-poison-first pins the poison want (L190); fatal-followup
/// pins the 25P02 want (L194); fatal-txn pins the ok want (L197);
/// fatal-replay pins the replay want (L200); fatal-settle pins
/// the 8/8/1 want (L206); fatal-winner pins the digest want
/// (L209); fatal-encodings pins the roundtrip want (L215);
/// fatal-sqlite pins the 1/3 want (L219); fatal-mysql-ret pins
/// the rejection want (L227); fatal-mysql-errno pins the 1064
/// want (L230); fatal-mysql-map pins the 8-exact want (L234);
/// log-live pins the success log (L236); log-skipped pins the
/// skip log (L239); refuse-url-msg pins the non-postgres refusal
/// (driver L44); refuse-missing-msg pins the missing-URL demand
/// (driver L40); owned-run-msg pins the owned guard (driver L538);
/// pg-pool-max pins 8 (driver L274); mysql-pool-max pins 4
/// (driver L463); close-timeout-ms pins 5000 (driver L515/L534);
/// unexpected-ok pins the admission marker (driver L309).
/// The roots-green pin lives in history-008-roots-green.can; answer
/// semantics live in history-008-rel-semantics.can.
/// Variants: the seven report parts share one launch and diagnostic
/// shape (a single default case; per-leg answers pin in
/// rel-semantics).
/// Environment: CAN_TEST_POSTGRES_URL plus bun on PATH gates;
/// CAN_TEST_MYSQL_URL is optional; requires can-test-postgres-url
/// and bun-on-path.
/// Logical gates SUITE/CAN/DB/NATIVE/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. Accept gates P23/QD1 (plus
/// QN1/QD2/QD3/QD4) are unmet. F03 timeout 240000ms mirrors the Go
/// 4-minute ctx (L45).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/f03-run checks: base-env-count, mysql-extra-count,
/// driver-arg-count, workdir-temp, home-is-workdir,
/// combined-output, fatal-driver-err, fatal-report,
/// fatal-driver-msg, fatal-db, fatal-single, fatal-multi,
/// fatal-do-nothing, fatal-conflict, fatal-duplicate,
/// fatal-absent, fatal-tworow, fatal-wide, fatal-poison-first,
/// fatal-followup, fatal-txn, fatal-replay, fatal-settle,
/// fatal-winner, fatal-encodings, fatal-sqlite, fatal-mysql-ret,
/// fatal-mysql-errno, fatal-mysql-map, log-live, log-skipped,
/// refuse-url-msg, refuse-missing-msg, owned-run-msg, pg-pool-max,
/// mysql-pool-max, close-timeout-ms, unexpected-ok.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int base_env_count
    int mysql_extra_count
    int driver_arg_count
    bool workdir_temp
    bool home_is_workdir
    str combined_output
    str fatal_driver_err
    str fatal_report
    str fatal_driver_msg
    str fatal_db
    str fatal_single
    str fatal_multi
    str fatal_do_nothing
    str fatal_conflict
    str fatal_duplicate
    str fatal_absent
    str fatal_tworow
    str fatal_wide
    str fatal_poison_first
    str fatal_followup
    str fatal_txn
    str fatal_replay
    str fatal_settle
    str fatal_winner
    str fatal_encodings
    str fatal_sqlite
    str fatal_mysql_ret
    str fatal_mysql_errno
    str fatal_mysql_map
    str log_live
    str log_skipped
    str refuse_url_msg
    str refuse_missing_msg
    str owned_run_msg
    int pg_pool_max
    int mysql_pool_max
    int close_timeout_ms
    str unexpected_ok
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f03-run", "default", "", "offline"), "base-env-count" => ok "case history/f03-run variant default root base-env-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f03-run", "default", "", "offline"), "workdir-temp" => ok evidence("workdir-temp", "true", "true", true, "case history/f03-run variant default root workdir-temp run offline")
        different: false, true, context("history/f03-run", "default", "", "offline"), "workdir-temp" => failed{"workdir-temp"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/f03-run", "default", "", "offline"), "base-env-count" => ok evidence("base-env-count", "3", "3", true, "case history/f03-run variant default root base-env-count run offline")
        different: 4, 3, context("history/f03-run", "default", "", "offline"), "base-env-count" => failed{"base-env-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CombinedOutput", "CombinedOutput", context("history/f03-run", "default", "", "offline"), "combined-output" => ok evidence("combined-output", "CombinedOutput", "CombinedOutput", true, "case history/f03-run variant default root combined-output run offline")
        different: "CombinedOutput_2", "CombinedOutput", context("history/f03-run", "default", "", "offline"), "combined-output" => failed{"combined-output"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
