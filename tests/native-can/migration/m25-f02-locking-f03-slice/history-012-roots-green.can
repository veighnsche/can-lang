fn check[] checks
    emits {}
    given
        str scope
    asserts
        m25_h012: "m25-h012" => ok [check("card-many", "claim legs read many rows"), check("card-execute", "insert legs execute"), check("card-one", "keyed refetch reads one row"), check("kind-select", "query legs are SelectStmt"), check("kind-insert", "write legs are InsertStmt"), check("seg-skip", "skip leg locks skipping locked rows"), check("seg-block", "block leg takes a plain row lock"), check("seg-nowait", "nowait leg fails fast on locks"), check("seg-nokey", "nokey leg skips locked rows"), check("seg-ins-claim", "claim insert targets f02_claims"), check("seg-ins-gen", "gen insert targets f02_gen"), check("params-worker", "claim legs bind worker"), check("params-worker-payload", "claim writes bind worker payload"), check("params-payload", "gen legs bind payload"), check("limit-claim", "claim legs cap at limit 2"), check("limit-keyed", "keyed refetch caps at limit 3"), check("limit-exec", "execute legs pin limit 0"), check("pool-open", "each pool opens five connections"), check("lock-worker", "seed and contention use worker w"), check("seed-vector", "seed writes four payloads"), check("seed-fail", "failed seeds refuse"), check("gate-polls", "tx1 gate polls two hundred times"), check("gate-sleep", "tx1 gate sleeps twenty ms"), check("gate-fail", "unclaimed tx1 refuses"), check("query-limit", "locking reads cap at ten rows"), check("ok-name", "success compares against ok"), check("unexpected-ok", "racy reads must never report unexpected ok"), check("domain-outcome", "nowait failures surface as domain"), check("tx-fail-prefix", "failed transactions prefix tx-failed"), check("nokey-fail-prefix", "failed reads prefix failed"), check("lock-tx1", "report records tx1 claimed"), check("lock-skipped", "report records skipped count"), check("lock-nowait", "report records nowait outcome"), check("lock-nowait-txn", "report records in-txn nowait"), check("lock-tx1-commit", "report records tx1 commit"), check("lock-after", "report records post-release count"), check("lock-blocking", "report records blocking count"), check("lock-nokey", "report records nokey count")]
        other: "nope" => ok []
    match scope is "m25-h012"
        false => ok []
        true => ok [check("card-many", "claim legs read many rows"), check("card-execute", "insert legs execute"), check("card-one", "keyed refetch reads one row"), check("kind-select", "query legs are SelectStmt"), check("kind-insert", "write legs are InsertStmt"), check("seg-skip", "skip leg locks skipping locked rows"), check("seg-block", "block leg takes a plain row lock"), check("seg-nowait", "nowait leg fails fast on locks"), check("seg-nokey", "nokey leg skips locked rows"), check("seg-ins-claim", "claim insert targets f02_claims"), check("seg-ins-gen", "gen insert targets f02_gen"), check("params-worker", "claim legs bind worker"), check("params-worker-payload", "claim writes bind worker payload"), check("params-payload", "gen legs bind payload"), check("limit-claim", "claim legs cap at limit 2"), check("limit-keyed", "keyed refetch caps at limit 3"), check("limit-exec", "execute legs pin limit 0"), check("pool-open", "each pool opens five connections"), check("lock-worker", "seed and contention use worker w"), check("seed-vector", "seed writes four payloads"), check("seed-fail", "failed seeds refuse"), check("gate-polls", "tx1 gate polls two hundred times"), check("gate-sleep", "tx1 gate sleeps twenty ms"), check("gate-fail", "unclaimed tx1 refuses"), check("query-limit", "locking reads cap at ten rows"), check("ok-name", "success compares against ok"), check("unexpected-ok", "racy reads must never report unexpected ok"), check("domain-outcome", "nowait failures surface as domain"), check("tx-fail-prefix", "failed transactions prefix tx-failed"), check("nokey-fail-prefix", "failed reads prefix failed"), check("lock-tx1", "report records tx1 claimed"), check("lock-skipped", "report records skipped count"), check("lock-nowait", "report records nowait outcome"), check("lock-nowait-txn", "report records in-txn nowait"), check("lock-tx1-commit", "report records tx1 commit"), check("lock-after", "report records post-release count"), check("lock-blocking", "report records blocking count"), check("lock-nokey", "report records nokey count")]
