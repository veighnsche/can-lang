package m25history012roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-012 "f02-live-driver.ts: table detail and locking".
/// Source: tests/integration/testdata/sql/f02-live-driver.ts symbol
/// f02-live-driver.ts (L93-130 entry detail, L207 pool legs, L217-234
/// open/seed legs, L236-288 locking probe).
/// Disposition: migrate (this row ports f02-live-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the three cardinalities, both statement
/// kinds, the four locking suffixes, both insert heads, the three
/// params vectors, the three pinned limits, the pool open size, the
/// contention worker, the four-payload seed vector, the seed refusal,
/// the tx1 gate polls and sleep, the gate refusal, the locking read
/// cap, the ok and domain outcome tokens, both failure prefixes, and
/// the eight locking report keys.
/// ADAPTATION (recorded, with source lines): params pins use the
/// exact L95-130 array-literal bytes including quotes and brackets;
/// seed-vector pins the exact L229 array-literal bytes; seg-block
/// pins the L99 suffix, which is also a prefix of the skip/nowait
/// suffixes (honest substring count 3, quoted-exact count 1);
/// limit pins mirror the L95-130 limit literals (claim/get-gen 2,
/// keyed 3, execute 0); totals mirror limits except ins_gen and are
/// cited, not pinned; plan roots share the descriptor p/r roots and
/// are cited, not pinned; lock-tx1 pins the L242 key shared with the
/// L246-247 gate legs.
/// Facet map (f02-live-driver.ts legs): card-many pins many
/// (L93/L98/L103/L108/L123); card-execute pins execute (L113/L128);
/// card-one pins one (L118); kind-select pins SelectStmt (x6);
/// kind-insert pins InsertStmt (L113/L128); seg-skip pins the L94
/// suffix; seg-block pins the L99 suffix; seg-nowait pins the L104
/// suffix; seg-nokey pins the L109 suffix; seg-ins-claim pins the
/// L114 head; seg-ins-gen pins the L129 head; params-worker pins
/// the L95 vector; params-worker-payload pins the L115/L120 vector;
/// params-payload pins the L125/L130 vector; limit-claim pins 2;
/// limit-keyed pins 3 (L120); limit-exec pins 0; pool-open pins 5
/// (L217-218); lock-worker pins w (L227/L231); seed-vector pins the
/// L229 vector; seed-fail pins the L233 prefix; gate-polls pins 200
/// and gate-sleep pins 20 (L246); gate-fail pins the L247 message;
/// query-limit pins 10 (10n x7); ok-name pins ok (L195);
/// unexpected-ok pins the L259/L265 token; domain-outcome pins
/// domain (L260); tx-fail-prefix pins tx-failed: (x3);
/// nokey-fail-prefix pins failed: (L287); lock-tx1 pins tx1_claimed
/// (L242); lock-skipped pins tx2_skipped_count (L253); lock-nowait
/// pins tx2_nowait (L258); lock-nowait-txn pins tx2_nowait_in_txn
/// (L268); lock-tx1-commit pins tx1_commit (L271); lock-after pins
/// tx2_after_release (L276); lock-blocking pins
/// blocking_for_update_count (L283); lock-nokey pins nokey_count
/// (L287).
/// Gates, table identities and fixture DDL live in
/// history-012-seed-semantics.can; races, report fields, MySQL legs
/// and exit shape live in history-012-run-shape.can.
/// Variants: none (single locking/race scenario; row lists none).
/// Environment: disposable PostgreSQL named by CAN_TEST_POSTGRES_URL
/// plus optional MySQL named by CAN_TEST_MYSQL_URL; see related Go
/// case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in f02-live-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/f02-roots checks: card-many, card-execute, card-one, kind-select, kind-insert, seg-skip, seg-block, seg-nowait, seg-nokey, seg-ins-claim, seg-ins-gen, params-worker, params-worker-payload, params-payload, limit-claim, limit-keyed, limit-exec, pool-open, lock-worker, seed-vector, seed-fail, gate-polls, gate-sleep, gate-fail, query-limit, ok-name, unexpected-ok, domain-outcome, tx-fail-prefix, nokey-fail-prefix, lock-tx1, lock-skipped, lock-nowait, lock-nowait-txn, lock-tx1-commit, lock-after, lock-blocking, lock-nokey.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str card_many
    str card_execute
    str card_one
    str kind_select
    str kind_insert
    str seg_skip
    str seg_block
    str seg_nowait
    str seg_nokey
    str seg_ins_claim
    str seg_ins_gen
    str params_worker
    str params_worker_payload
    str params_payload
    int limit_claim
    int limit_keyed
    int limit_exec
    int pool_open
    str lock_worker
    str seed_vector
    str seed_fail
    int gate_polls
    int gate_sleep
    str gate_fail
    int query_limit
    str ok_name
    str unexpected_ok
    str domain_outcome
    str tx_fail_prefix
    str nokey_fail_prefix
    str lock_tx1
    str lock_skipped
    str lock_nowait
    str lock_nowait_txn
    str lock_tx1_commit
    str lock_after
    str lock_blocking
    str lock_nokey
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f02-roots", "default", "", "offline"), "card-many" => ok "case history/f02-roots variant default root card-many run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f02-roots", "default", "", "offline"), "card-many" => ok evidence("card-many", "true", "true", true, "case history/f02-roots variant default root card-many run offline")
        different: false, true, context("history/f02-roots", "default", "", "offline"), "card-many" => failed{"card-many"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/f02-roots", "default", "", "offline"), "limit-claim" => ok evidence("limit-claim", "2", "2", true, "case history/f02-roots variant default root limit-claim run offline")
        different: 3, 2, context("history/f02-roots", "default", "", "offline"), "limit-claim" => failed{"limit-claim"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "many", "many", context("history/f02-roots", "default", "", "offline"), "card-many" => ok evidence("card-many", "many", "many", true, "case history/f02-roots variant default root card-many run offline")
        different: "many2", "many", context("history/f02-roots", "default", "", "offline"), "card-many" => failed{"card-many"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("many", "execute", "one", "SelectStmt", "InsertStmt", " FOR UPDATE SKIP LOCKED", " FOR UPDATE", " FOR UPDATE NOWAIT", " FOR NO KEY UPDATE SKIP LOCKED", "INSERT INTO f02_claims (worker, payload) VALUES (", "INSERT INTO f02_gen (payload) VALUES (", "[\"worker\"]", "[\"worker\", \"payload\"]", "[\"payload\"]", 2, 3, 0, 5, "w", "[\"a\", \"b\", \"c\", \"d\"]", "seed failed: ", 200, 20, "tx1 never claimed", 10, "ok", "unexpected-ok", "domain", "tx-failed:", "failed:", "tx1_claimed", "tx2_skipped_count", "tx2_nowait", "tx2_nowait_in_txn", "tx1_commit", "tx2_after_release", "blocking_for_update_count", "nokey_count")
