fn check[] checks
    emits {}
    given
        str scope
    asserts
        m25_h012: "m25-h012" => ok [check("cost-n", "cost leg iterates sixty keys"), check("cost-prefix", "cost keys carry the cost prefix"), check("cost-worker", "cost leg writes under cost"), check("ret-prefix", "raw leg prefixes ret"), check("cost-fail", "failed cost legs refuse"), check("refetch-mismatch", "wrong refetch refuses"), check("amb-k", "ambiguity races eight writers"), check("amb-same", "ambiguity writers share same"), check("amb-limit", "ambiguity refetch caps at one hundred"), check("truncate-gen", "ambiguity resets f02_gen"), check("amb-fail", "failed ambiguity inserts refuse"), check("race-m", "keyed control races sixteen writers"), check("race-prefix", "keyed keys carry the race prefix"), check("race-worker", "keyed leg writes under race"), check("returning-tail", "oracle legs return id"), check("fixed-digits", "timings fix one decimal"), check("top-server-version", "report carries serverVersion"), check("top-locking", "report carries locking"), check("top-cost", "report carries cost"), check("top-ambiguity", "report carries ambiguity"), check("top-oracle", "report carries returning_oracle"), check("top-keyed", "report carries keyed_control"), check("top-mysql", "report carries mysql"), check("cost-iterations", "cost reports iterations"), check("cost-can-ms", "cost reports can txn ms"), check("cost-raw-ms", "cost reports raw ms"), check("amb-inserts", "ambiguity reports writer count"), check("amb-cands", "ambiguity reports candidates"), check("amb-ident", "ambiguity reports identifiability"), check("oracle-rows", "oracle reports rows"), check("keyed-writers", "keyed control reports writers"), check("keyed-all", "keyed control reports refetch success"), check("mysql-skip", "missing mysql skips"), check("mysql-adapter", "mysql leg uses the mysql adapter"), check("mysql-create", "mysql probe creates f02_ret"), check("mysql-admitted", "mysql returning may admit"), check("mysql-rejected", "mysql returning may reject"), check("mysql-insert-returning", "mysql reports insert_returning"), check("owned-fail", "failed owned runs refuse"), check("error-exit", "harness failures exit 1")]
        other: "nope" => ok []
