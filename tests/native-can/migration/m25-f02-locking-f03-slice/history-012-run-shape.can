package m25history012run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-012 "f02-live-driver.ts: races, report, mysql, exit".
/// Source: tests/integration/testdata/sql/f02-live-driver.ts symbol
/// f02-live-driver.ts (L290-317 cost legs, L319-337 ambiguity legs,
/// L339-356 keyed legs, L313-377 report legs, L358-382 MySQL legs,
/// L384-406 close/exit legs).
/// Disposition: migrate (this row ports f02-live-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the cost iteration count, prefixes and
/// worker, both cost refusals, the ambiguity writer count, shared
/// payload, refetch cap, truncate reset and refusal, the keyed writer
/// count, prefix and worker, the RETURNING tail, the timing decimal
/// fix, all seven top-level report keys, all cost/ambiguity/oracle/
/// keyed subkeys, the MySQL skip/admit/reject legs with table and
/// report key, the owned-run refusal, and the harness exit code.
/// ADAPTATION (recorded, with source lines): cost-n/amb-k/race-m pin
/// the L291/L321/L340 literals N/K/M; fixed-digits pins the L315-316
/// toFixed take (1); returning-tail pins the L310/L336/L368 tail,
/// the only RETURNING text in descriptors reach (raw oracle legs
/// only, per the L10 header); mysql-rejected pins the L372 boolean;
/// error-exit pins 1 across the L37/L41 exits and the L405 exitCode;
/// timing values are unpinned by construction (wall clock); only
/// field names, iteration counts and the decimal fix pin here.
/// Facet map (f02-live-driver.ts legs): cost-n pins 60 (L291);
/// cost-prefix pins cost- (L292); cost-worker pins cost (L297/L300);
/// ret-prefix pins ret- (L310); cost-fail pins the L305 prefix;
/// refetch-mismatch pins the L302 message; amb-k pins 8 (L321);
/// amb-same pins same (L324/L329/L336); amb-limit pins 100 (L329);
/// truncate-gen pins the L320 reset; amb-fail pins the L327 message;
/// race-m pins 16 (L340); race-prefix pins race- (L343); race-worker
/// pins race (L345/L348); returning-tail pins RETURNING id (x3);
/// fixed-digits pins 1 (L315-316); top-server-version pins
/// serverVersion (L210/L377); top-locking pins locking (L288);
/// top-cost pins cost (L313); top-ambiguity pins ambiguity (L331);
/// top-oracle pins returning_oracle (L337); top-keyed pins
/// keyed_control (L353); top-mysql pins mysql (L360/L377);
/// cost-iterations pins iterations and cost-can-ms/cost-raw-ms pin
/// the L315-316 ms keys; amb-inserts/amb-cands/amb-ident pin the
/// L332-334 keys; oracle-rows pins rows (L337);
/// keyed-writers/keyed-all pin the L354-355 keys; mysql-skip pins
/// the L360 skip; mysql-adapter pins mysql (L362); mysql-create pins
/// the L365 table; mysql-admitted pins admitted (L369);
/// mysql-rejected pins true (L372); mysql-insert-returning pins
/// insert_returning (L377); owned-fail pins the L389 message;
/// error-exit pins 1 (L37/L41/L405).
/// Gates, table identities and fixture DDL live in
/// history-012-seed-semantics.can; descriptor detail and contention
/// control live in history-012-roots-green.can.
/// Variants: none (single locking/race scenario; row lists none).
/// Environment: disposable PostgreSQL named by CAN_TEST_POSTGRES_URL
/// plus optional MySQL named by CAN_TEST_MYSQL_URL; see related Go
/// case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in f02-live-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/f02-run checks: cost-n, cost-prefix, cost-worker, ret-prefix, cost-fail, refetch-mismatch, amb-k, amb-same, amb-limit, truncate-gen, amb-fail, race-m, race-prefix, race-worker, returning-tail, fixed-digits, top-server-version, top-locking, top-cost, top-ambiguity, top-oracle, top-keyed, top-mysql, cost-iterations, cost-can-ms, cost-raw-ms, amb-inserts, amb-cands, amb-ident, oracle-rows, keyed-writers, keyed-all, mysql-skip, mysql-adapter, mysql-create, mysql-admitted, mysql-rejected, mysql-insert-returning, owned-fail, error-exit.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int cost_n
    str cost_prefix
    str cost_worker
    str ret_prefix
    str cost_fail
    str refetch_mismatch
    int amb_k
    str amb_same
    int amb_limit
    str truncate_gen
    str amb_fail
    int race_m
    str race_prefix
    str race_worker
    str returning_tail
    int fixed_digits
    str top_server_version
    str top_locking
    str top_cost
    str top_ambiguity
    str top_oracle
    str top_keyed
    str top_mysql
    str cost_iterations
    str cost_can_ms
    str cost_raw_ms
    str amb_inserts
    str amb_cands
    str amb_ident
    str oracle_rows
    str keyed_writers
    str keyed_all
    str mysql_skip
    str mysql_adapter
    str mysql_create
    str mysql_admitted
    bool mysql_rejected
    str mysql_insert_returning
    str owned_fail
    int error_exit
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f02-run", "default", "", "offline"), "cost-n" => ok "case history/f02-run variant default root cost-n run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f02-run", "default", "", "offline"), "cost-n" => ok evidence("cost-n", "true", "true", true, "case history/f02-run variant default root cost-n run offline")
        different: false, true, context("history/f02-run", "default", "", "offline"), "cost-n" => failed{"cost-n"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 60, 60, context("history/f02-run", "default", "", "offline"), "cost-n" => ok evidence("cost-n", "60", "60", true, "case history/f02-run variant default root cost-n run offline")
        different: 61, 60, context("history/f02-run", "default", "", "offline"), "cost-n" => failed{"cost-n"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "cost-", "cost-", context("history/f02-run", "default", "", "offline"), "cost-prefix" => ok evidence("cost-prefix", "cost-", "cost-", true, "case history/f02-run variant default root cost-prefix run offline")
        different: "cost2-", "cost-", context("history/f02-run", "default", "", "offline"), "cost-prefix" => failed{"cost-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(60, "cost-", "cost", "ret-", "cost leg failed: ", "refetch mismatch", 8, "same", 100, "TRUNCATE f02_gen", "ambiguity inserts failed", 16, "race-", "race", "RETURNING id", 1, "serverVersion", "locking", "cost", "ambiguity", "returning_oracle", "keyed_control", "mysql", "iterations", "can_txn_insert_plus_refetch_ms", "raw_single_returning_ms", "concurrent_identical_inserts", "refetch_candidate_rows", "writer_identifiable", "rows", "writers", "all_refetched_own_row", "skipped:no-mysql-url", "mysql", "CREATE TABLE IF NOT EXISTS f02_ret (id BIGINT AUTO_INCREMENT PRIMARY KEY, payload TEXT)", "admitted", true, "insert_returning", "owned run failed", 1)
        seed_cost_n: "seed-cost-n-drift" => ok observation(61, "cost-", "cost", "ret-", "cost leg failed: ", "refetch mismatch", 8, "same", 100, "TRUNCATE f02_gen", "ambiguity inserts failed", 16, "race-", "race", "RETURNING id", 1, "serverVersion", "locking", "cost", "ambiguity", "returning_oracle", "keyed_control", "mysql", "iterations", "can_txn_insert_plus_refetch_ms", "raw_single_returning_ms", "concurrent_identical_inserts", "refetch_candidate_rows", "writer_identifiable", "rows", "writers", "all_refetched_own_row", "skipped:no-mysql-url", "mysql", "CREATE TABLE IF NOT EXISTS f02_ret (id BIGINT AUTO_INCREMENT PRIMARY KEY, payload TEXT)", "admitted", true, "insert_returning", "owned run failed", 1)
        seed_cost_prefix: "seed-cost-prefix-drift" => ok observation(60, "cost2-", "cost", "ret-", "cost leg failed: ", "refetch mismatch", 8, "same", 100, "TRUNCATE f02_gen", "ambiguity inserts failed", 16, "race-", "race", "RETURNING id", 1, "serverVersion", "locking", "cost", "ambiguity", "returning_oracle", "keyed_control", "mysql", "iterations", "can_txn_insert_plus_refetch_ms", "raw_single_returning_ms", "concurrent_identical_inserts", "refetch_candidate_rows", "writer_identifiable", "rows", "writers", "all_refetched_own_row", "skipped:no-mysql-url", "mysql", "CREATE TABLE IF NOT EXISTS f02_ret (id BIGINT AUTO_INCREMENT PRIMARY KEY, payload TEXT)", "admitted", true, "insert_returning", "owned run failed", 1)
