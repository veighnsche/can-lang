package m25history012seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-012 "f02-live-driver.ts: gates, table identities, fixture".
/// Source: tests/integration/testdata/sql/f02-live-driver.ts symbol
/// f02-live-driver.ts (L33-48 env/template legs, L88-95 claim-head
/// legs, L92-131 table keys, L170-171 txn leaves, L209-214
/// version/DDL legs).
/// Disposition: migrate (this row ports f02-live-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the PG/MySQL env gates, both refusal
/// messages, the db placeholder and can_f02 resolution, the pool env
/// key, the claim select head and order-limit tail, the eight table
/// names in build order, the empty declare owner, the postgresql
/// dialect, the pinned table version, both txn leaves, the version
/// query and word-take, and the four fixture DDL statements.
/// ADAPTATION (recorded, with source lines): desc-count counts the
/// L92-131 table keys (8, per the M12 app-count precedent); version
/// pins the L95-130 version literal shared by all eight entries;
/// claim-tail pins the L89 tail bytes, which L124 reuses verbatim
/// for the gen select; drop legs pin the L211-212 texts shared with
/// teardown/catch (L391-392/L397-398); version-take pins the L210
/// slice take (0, 2); mysql-env pins the L34 gate name only, the
/// optional legs live in history-012-run-shape.can.
/// Facet map (f02-live-driver.ts legs): pg-env pins
/// CAN_TEST_POSTGRES_URL (L33); mysql-env pins CAN_TEST_MYSQL_URL
/// (L34); unset-pg pins the L36 message; url-scheme pins postgres
/// (L39); url-refusal pins the L40 message; db-needle pins <db> and
/// db-name pins can_f02 (L43/L46-47; L5); env-key pins F02_PG (L135);
/// claim-head pins the L88 head; claim-tail pins the L89 tail;
/// desc-count pins 8; desc-skip/block/nowait/nokey pins the four
/// locking names (L92/97/102/107); desc-ins-claim pins ins_claim
/// (L112); desc-get-claim pins get_claim_by_payload (L117);
/// desc-get-gen pins get_by_payload (L122); desc-ins-gen pins
/// ins_gen (L127); declare-owner pins the empty owner (L219-226);
/// dialect pins postgresql; version pins 170007; commit-leaf and
/// rollback-leaf pin the L170-171 leaves; version-query pins the
/// L209 query; version-take pins 2 (L210); drop-claims/drop-gen pin
/// the L211-212 drops; create-claims/create-gen pin the L213-214
/// creates.
/// Descriptor detail and contention control live in
/// history-012-roots-green.can; races, report fields, MySQL legs and
/// exit shape live in history-012-run-shape.can.
/// Variants: none (single locking/race scenario; row lists none).
/// Environment: disposable PostgreSQL named by CAN_TEST_POSTGRES_URL
/// plus optional MySQL named by CAN_TEST_MYSQL_URL; see related Go
/// case gates; requires can-test-postgres-url.
/// R/N/C/S/A identities identified in evidence; S/A bind at P23; no
/// live run now. Descriptor timeout 0 records that the driver pins no
/// timeout (no ctx/deadline leg in f02-live-driver.ts).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/f02-seed checks: pg-env, mysql-env, unset-pg, url-scheme, url-refusal, db-needle, db-name, env-key, claim-head, claim-tail, desc-count, desc-skip, desc-block, desc-nowait, desc-nokey, desc-ins-claim, desc-get-claim, desc-get-gen, desc-ins-gen, declare-owner, dialect, version, commit-leaf, rollback-leaf, version-query, version-take, drop-claims, drop-gen, create-claims, create-gen.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str pg_env
    str mysql_env
    str unset_pg
    str url_scheme
    str url_refusal
    str db_needle
    str db_name
    str env_key
    str claim_head
    str claim_tail
    int desc_count
    str desc_skip
    str desc_block
    str desc_nowait
    str desc_nokey
    str desc_ins_claim
    str desc_get_claim
    str desc_get_gen
    str desc_ins_gen
    str declare_owner
    str dialect
    int version
    str commit_leaf
    str rollback_leaf
    str version_query
    int version_take
    str drop_claims
    str drop_gen
    str create_claims
    str create_gen
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f02-seed", "default", "", "offline"), "pg-env" => ok "case history/f02-seed variant default root pg-env run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f02-seed", "default", "", "offline"), "pg-env" => ok evidence("pg-env", "true", "true", true, "case history/f02-seed variant default root pg-env run offline")
        different: false, true, context("history/f02-seed", "default", "", "offline"), "pg-env" => failed{"pg-env"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 8, 8, context("history/f02-seed", "default", "", "offline"), "desc-count" => ok evidence("desc-count", "8", "8", true, "case history/f02-seed variant default root desc-count run offline")
        different: 7, 8, context("history/f02-seed", "default", "", "offline"), "desc-count" => failed{"desc-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", context("history/f02-seed", "default", "", "offline"), "pg-env" => ok evidence("pg-env", "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", true, "case history/f02-seed variant default root pg-env run offline")
        different: "CAN_TEST_POSTGRES_URL2", "CAN_TEST_POSTGRES_URL", context("history/f02-seed", "default", "", "offline"), "pg-env" => failed{"pg-env"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
