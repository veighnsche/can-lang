        seed_single_rows_key: "seed-single-rows-key-drift" => ok observation("single_row", "single_id_type", "multi_rows", "conflict_first_rows", "conflict_repeat_rows", "unexpected-ok", "rejected", "errno", "constraint", "duplicate_insert", "absent_one", "two_row_one", "wide_decode", 424242, 7, "first_outcome", "followup_outcome", "txn_outcome", "replay_ok", "d0", "d1", "app::sql_commit_leaf", "app::sql_rollback_leaf", "skipped:no-mysql-url", "admitted", 8, "insert_returning", "all_own_row", "distinct_ids")
