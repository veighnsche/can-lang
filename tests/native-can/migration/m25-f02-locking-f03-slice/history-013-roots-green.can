package m25history013roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-013 "f03-live-driver.ts: returning, vocab, abort".
/// Source: tests/integration/testdata/sql/f03-live-driver.ts symbol
/// f03-live-driver.ts (L178-179 leaves, L295-374 PG legs, L458-520
/// MySQL leg); executed by tests/integration/sql_f03_test.go.
/// Disposition: migrate (this row ports f03-live-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the raw PG RETURNING report keys and the
/// conflict rejection shape, the four error-vocabulary keys with
/// the absent/wide lookup ids, the abort/replay keys with the
/// poison/replay delivery ids and commit/rollback leaves, and the
/// MySQL skip/admit decisions with writer count and mapping keys.
/// ADAPTATION (recorded, with source lines): key pins mirror the
/// report-field names (returning./vocab./aborted./mysql.); id pins
/// mirror the exact lookup/insert literals (424242 at L328, 7 at
/// L339/342, d0 at L303/308/324/352, d1 at L365); mysql-writers
/// mirrors K (L494); admitted/skipped pin the verbatim decision
/// literals (L461/L470).
/// Facet map (f03-live-driver.ts legs): single-rows-key pins
/// single_rows (L299); single-id-type-key pins single_id_type
/// (L300); multi-rows-key pins multi_rows (L302);
/// conflict-first-key pins conflict_first_rows (L305);
/// conflict-repeat-key pins conflict_repeat_rows (L306);
/// conflict-unexpected pins unexpected-ok (L309); rejected-key pins
/// rejected (L312); errno-key pins errno (L313); constraint-key pins
/// constraint (L314); vocab-duplicate-key pins duplicate_insert
/// (L326); vocab-absent-key pins absent_one (L330);
/// vocab-two-row-key pins two_row_one (L336); vocab-wide-key pins
/// wide_decode (L344); absent-id pins 424242 (L328); wide-id pins 7
/// (L339); abort-first-key pins first_outcome (L354);
/// abort-followup-key pins followup_outcome (L358); abort-txn-key
/// pins txn_outcome (L361); replay-key pins replay_ok (L373);
/// abort-poison-id pins d0 (L352); replay-id pins d1 (L365);
/// commit-leaf pins app::sql_commit_leaf (L178); rollback-leaf pins
/// app::sql_rollback_leaf (L179); mysql-skipped pins
/// skipped:no-mysql-url (L461); mysql-admitted pins admitted (L470);
/// mysql-writers pins 8 (L494); insert-returning-key pins
/// insert_returning (L512); mapping-all-own-key pins all_own_row
/// (L513); mapping-ids-key pins distinct_ids (L513).
/// Seed semantics live in history-013-seed-semantics.can; the
/// invocation/run shape lives in history-013-run-shape.can.
/// Variants: mysql leg runs only when CAN_TEST_MYSQL_URL is set
/// (else skipped:no-mysql-url); PG legs always run.
/// Environment: disposable databases named by CAN_TEST_POSTGRES_URL
/// (required) and CAN_TEST_MYSQL_URL (optional); requires
/// can-test-postgres-url and bun; sqlite legs run in memory.
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 240000ms mirrors the Go 4-minute ctx
/// (sql_f03_test.go L45).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/f03-roots checks: single-rows-key,
/// single-id-type-key, multi-rows-key, conflict-first-key,
/// conflict-repeat-key, conflict-unexpected, rejected-key,
/// errno-key, constraint-key, vocab-duplicate-key, vocab-absent-key,
/// vocab-two-row-key, vocab-wide-key, absent-id, wide-id,
/// abort-first-key, abort-followup-key, abort-txn-key, replay-key,
/// abort-poison-id, replay-id, commit-leaf, rollback-leaf,
/// mysql-skipped, mysql-admitted, mysql-writers,
/// insert-returning-key, mapping-all-own-key, mapping-ids-key.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str single_rows_key
    str single_id_type_key
    str multi_rows_key
    str conflict_first_key
    str conflict_repeat_key
    str conflict_unexpected
    str rejected_key
    str errno_key
    str constraint_key
    str vocab_duplicate_key
    str vocab_absent_key
    str vocab_two_row_key
    str vocab_wide_key
    int absent_id
    int wide_id
    str abort_first_key
    str abort_followup_key
    str abort_txn_key
    str replay_key
    str abort_poison_id
    str replay_id
    str commit_leaf
    str rollback_leaf
    str mysql_skipped
    str mysql_admitted
    int mysql_writers
    str insert_returning_key
    str mapping_all_own_key
    str mapping_ids_key
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f03-roots", "default", "", "offline"), "single-rows-key" => ok "case history/f03-roots variant default root single-rows-key run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f03-roots", "default", "", "offline"), "single-rows-key" => ok evidence("single-rows-key", "true", "true", true, "case history/f03-roots variant default root single-rows-key run offline")
        different: false, true, context("history/f03-roots", "default", "", "offline"), "single-rows-key" => failed{"single-rows-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 424242, 424242, context("history/f03-roots", "default", "", "offline"), "absent-id" => ok evidence("absent-id", "424242", "424242", true, "case history/f03-roots variant default root absent-id run offline")
        different: 424243, 424242, context("history/f03-roots", "default", "", "offline"), "absent-id" => failed{"absent-id"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "single_rows", "single_rows", context("history/f03-roots", "default", "", "offline"), "single-rows-key" => ok evidence("single-rows-key", "single_rows", "single_rows", true, "case history/f03-roots variant default root single-rows-key run offline")
        different: "single_row", "single_rows", context("history/f03-roots", "default", "", "offline"), "single-rows-key" => failed{"single-rows-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
