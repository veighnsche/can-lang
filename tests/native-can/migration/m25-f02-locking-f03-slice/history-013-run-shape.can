package m25history013run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-013 "f03-live-driver.ts: invocation and race".
/// Source: tests/integration/testdata/sql/f03-live-driver.ts symbol
/// f03-live-driver.ts (L37-52 env legs, L276-277 version leg,
/// L376-424 race leg, L426-456 encoding legs, L522-532 sqlite leg,
/// L554-557 harness leg); executed by
/// tests/integration/sql_f03_test.go.
/// Disposition: migrate (this row ports f03-live-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the invocation shape (env gates, refusals,
/// placeholder, exit), the server-version split, the lookup-first
/// race decisions with exact ids/digest/states/code, the blessed
/// encoding fixtures with exact values, the sqlite shape, and the
/// seven report section keys.
/// ADAPTATION (recorded, with source lines): url-scheme pins the
/// startsWith needle (L43); db pins mirror the replace literals
/// (L47/L51); version pins mirror the split/slice literals (L277);
/// int64 pins use the digit strings (the driver binds bigint
/// literals at L448/454-455, pinned here as str); enc-note pins the
/// doc note verbatim (L427); race states pin verbatim (L393/403/405).
/// Facet map (f03-live-driver.ts legs): env-pg-gate pins
/// CAN_TEST_POSTGRES_URL (L37); env-my-gate pins CAN_TEST_MYSQL_URL
/// (L38); unset-db pins the L40 message; url-scheme pins postgres
/// (L43); url-refusal pins the L44 message; db-placeholder pins
/// <db> (L47); db-name pins can_f03 (L47); error-exit pins 1
/// (L41/L45/L556); env-pg-key pins F03_PG (L142); env-my-key pins
/// F03_MY (L143); version-split pins the space needle (L277);
/// version-words pins 2 (L277); report-version-key pins
/// serverVersion (L277); race-writers pins 8 (L381); race-id pins
/// race (L389); race-digest pins race-digest (L393); race-accepted
/// pins accepted (L405); race-duplicate pins duplicate (L393);
/// race-conflict pins conflict (L393); race-lost pins lost-race
/// (L403); race-code pins 25P02 (L384); race-winner-key pins
/// winner_digest (L422); writers-key pins writers (L421/L513);
/// enc-minor pins 1099 (L427); enc-recorded pins 1727222400000
/// (L439); enc-audit pins 1727222500000 (L445); enc-max pins the
/// max digits (L454); enc-min pins the min digits (L455); enc-note
/// pins the unicode note (L427); sqlite-memory pins :memory: (L523);
/// sqlite-version-key pins version (L529); report-returning-key pins
/// returning_native (L317); report-vocab-key pins error_vocab
/// (L345); report-aborted-key pins aborted_txn (L374);
/// report-lookup-key pins lookup_first (L420); report-encodings-key
/// pins encodings (L456); report-mysql-key pins mysql (L461);
/// report-sqlite-key pins sqlite (L529).
/// Seed semantics live in history-013-seed-semantics.can; the
/// roots-green pin lives in history-013-roots-green.can.
/// Variants: mysql leg runs only when CAN_TEST_MYSQL_URL is set
/// (else skipped:no-mysql-url); PG/sqlite legs always run.
/// Environment: disposable databases named by CAN_TEST_POSTGRES_URL
/// (required) and CAN_TEST_MYSQL_URL (optional); requires
/// can-test-postgres-url and bun; sqlite legs run in memory.
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 240000ms mirrors the Go 4-minute ctx
/// (sql_f03_test.go L45).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/f03-run checks: env-pg-gate, env-my-gate, unset-db,
/// url-scheme, url-refusal, db-placeholder, db-name, error-exit,
/// env-pg-key, env-my-key, version-split, version-words,
/// report-version-key, race-writers, race-id, race-digest,
/// race-accepted, race-duplicate, race-conflict, race-lost,
/// race-code, race-winner-key, writers-key, enc-minor, enc-recorded,
/// enc-audit, enc-max, enc-min, enc-note, sqlite-memory,
/// sqlite-version-key, report-returning-key, report-vocab-key,
/// report-aborted-key, report-lookup-key, report-encodings-key,
/// report-mysql-key, report-sqlite-key.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_pg_gate
    str env_my_gate
    str unset_db
    str url_scheme
    str url_refusal
    str db_placeholder
    str db_name
    int error_exit
    str env_pg_key
    str env_my_key
    str version_split
    int version_words
    str report_version_key
    int race_writers
    str race_id
    str race_digest
    str race_accepted
    str race_duplicate
    str race_conflict
    str race_lost
    str race_code
    str race_winner_key
    str writers_key
    int enc_minor
    int enc_recorded
    int enc_audit
    str enc_max
    str enc_min
    str enc_note
    str sqlite_memory
    str sqlite_version_key
    str report_returning_key
    str report_vocab_key
    str report_aborted_key
    str report_lookup_key
    str report_encodings_key
    str report_mysql_key
    str report_sqlite_key
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f03-run", "default", "", "offline"), "env-pg-gate" => ok "case history/f03-run variant default root env-pg-gate run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f03-run", "default", "", "offline"), "env-pg-gate" => ok evidence("env-pg-gate", "true", "true", true, "case history/f03-run variant default root env-pg-gate run offline")
        different: false, true, context("history/f03-run", "default", "", "offline"), "env-pg-gate" => failed{"env-pg-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/f03-run", "default", "", "offline"), "error-exit" => ok evidence("error-exit", "1", "1", true, "case history/f03-run variant default root error-exit run offline")
        different: 0, 1, context("history/f03-run", "default", "", "offline"), "error-exit" => failed{"error-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", context("history/f03-run", "default", "", "offline"), "env-pg-gate" => ok evidence("env-pg-gate", "CAN_TEST_POSTGRES_URL", "CAN_TEST_POSTGRES_URL", true, "case history/f03-run variant default root env-pg-gate run offline")
        different: "CAN_TEST_POSTGRES_URL2", "CAN_TEST_POSTGRES_URL", context("history/f03-run", "default", "", "offline"), "env-pg-gate" => failed{"env-pg-gate"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("CAN_TEST_POSTGRES_URL", "CAN_TEST_MYSQL_URL", "set CAN_TEST_POSTGRES_URL to the disposable test database", "postgres", "refusing non-postgres test URL", "<db>", "can_f03", 1, "F03_PG", "F03_MY", " ", 2, "serverVersion", 8, "race", "race-digest", "accepted", "duplicate", "conflict", "lost-race", "25P02", "winner_digest", "writers", 1099, 1727222400000, 1727222500000, "9223372036854775807", "-9223372036854775808", "café ☃ \"quoted\"", ":memory:", "version", "returning_native", "error_vocab", "aborted_txn", "lookup_first", "encodings", "mysql", "sqlite")
        seed_env_pg_gate: "seed-env-pg-gate-drift" => ok observation("CAN_TEST_POSTGRES_URL2", "CAN_TEST_MYSQL_URL", "set CAN_TEST_POSTGRES_URL to the disposable test database", "postgres", "refusing non-postgres test URL", "<db>", "can_f03", 1, "F03_PG", "F03_MY", " ", 2, "serverVersion", 8, "race", "race-digest", "accepted", "duplicate", "conflict", "lost-race", "25P02", "winner_digest", "writers", 1099, 1727222400000, 1727222500000, "9223372036854775807", "-9223372036854775808", "café ☃ \"quoted\"", ":memory:", "version", "returning_native", "error_vocab", "aborted_txn", "lookup_first", "encodings", "mysql", "sqlite")
