package m25history013seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M25 HISTORY-013 "f03-live-driver.ts: descriptor table build".
/// Source: tests/integration/testdata/sql/f03-live-driver.ts symbol
/// f03-live-driver.ts (L92-140 descriptor table, L287-293/L479-480
/// declare sites, L278-283 fixture DDL); executed by
/// tests/integration/sql_f03_test.go.
/// Disposition: migrate (this row ports f03-live-driver.ts to ordinary
/// Can functions; the old TS script stays until the integrator retires
/// it after every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the runtime-style descriptor table build:
/// the nine descriptor names in table order, the postgres/mysql
/// version stamps, the two dialect pins, the empty declare owner,
/// and the three fixture DDL table names.
/// ADAPTATION (recorded, with source lines): version pins mirror the
/// per-entry version literals (170007 x7 PG at L97-127, 80011 x2
/// MySQL at L132/137); dialect pins mirror the per-entry dialect
/// literals; owner pins the L93 empty-string table key; DDL pins
/// mirror the CREATE TABLE names (L281-283), not full statements.
/// Facet map (f03-live-driver.ts legs): desc-delivery-by-id pins
/// delivery_by_id (L94); desc-delivery-insert pins delivery_insert
/// (L99); desc-gen-insert pins gen_insert (L104); desc-gen-one pins
/// gen_by_payload_one (L109); desc-money-insert pins money_insert
/// (L114); desc-money-by-id pins money_by_id (L119); desc-money-wide
/// pins money_wide (L124); desc-my-insert pins my_gen_insert (L129);
/// desc-my-last-id pins my_gen_by_last_id (L134); pg-version pins
/// 170007 (L97); mysql-version pins 80011 (L132); pg-dialect pins
/// postgresql (L95); mysql-dialect pins mysql (L130);
/// declare-owner pins the empty owner (L93); ddl-deliveries/
/// ddl-gen/ddl-money pin f03_deliveries/f03_gen/f03_money
/// (L281-283).
/// The roots-green pin lives in history-013-roots-green.can; the
/// invocation/run shape lives in history-013-run-shape.can.
/// Variants: none (single live scenario; row lists none).
/// Environment: disposable databases named by CAN_TEST_POSTGRES_URL
/// (required) and CAN_TEST_MYSQL_URL (optional); requires
/// can-test-postgres-url and bun; sqlite legs run in memory.
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 240000ms mirrors the Go 4-minute ctx
/// (sql_f03_test.go L45).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/f03-seed checks: desc-delivery-by-id,
/// desc-delivery-insert, desc-gen-insert, desc-gen-one,
/// desc-money-insert, desc-money-by-id, desc-money-wide,
/// desc-my-insert, desc-my-last-id, pg-version, mysql-version,
/// pg-dialect, mysql-dialect, declare-owner, ddl-deliveries,
/// ddl-gen, ddl-money.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str desc_delivery_by_id
    str desc_delivery_insert
    str desc_gen_insert
    str desc_gen_one
    str desc_money_insert
    str desc_money_by_id
    str desc_money_wide
    str desc_my_insert
    str desc_my_last_id
    int pg_version
    int mysql_version
    str pg_dialect
    str mysql_dialect
    str declare_owner
    str ddl_deliveries
    str ddl_gen
    str ddl_money
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/f03-seed", "default", "", "offline"), "desc-delivery-by-id" => ok "case history/f03-seed variant default root desc-delivery-by-id run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/f03-seed", "default", "", "offline"), "desc-delivery-by-id" => ok evidence("desc-delivery-by-id", "true", "true", true, "case history/f03-seed variant default root desc-delivery-by-id run offline")
        different: false, true, context("history/f03-seed", "default", "", "offline"), "desc-delivery-by-id" => failed{"desc-delivery-by-id"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 170007, 170007, context("history/f03-seed", "default", "", "offline"), "pg-version" => ok evidence("pg-version", "170007", "170007", true, "case history/f03-seed variant default root pg-version run offline")
        different: 170008, 170007, context("history/f03-seed", "default", "", "offline"), "pg-version" => failed{"pg-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "delivery_by_id", "delivery_by_id", context("history/f03-seed", "default", "", "offline"), "desc-delivery-by-id" => ok evidence("desc-delivery-by-id", "delivery_by_id", "delivery_by_id", true, "case history/f03-seed variant default root desc-delivery-by-id run offline")
        different: "delivery_by_ids", "delivery_by_id", context("history/f03-seed", "default", "", "offline"), "desc-delivery-by-id" => failed{"desc-delivery-by-id"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
