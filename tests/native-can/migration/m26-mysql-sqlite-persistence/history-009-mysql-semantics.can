package m26history009mysql
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-009 "MySQL persistence: separate-process proofs".
/// Source: tests/integration/mysql_test.go symbol
/// TestCurrentMySQLPersistence (L43-170); ok helper (L139-146);
/// fault helper (L147-154); legs (L159-168).
/// Disposition: migrate (this row ports
/// TestCurrentMySQLPersistence to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted evidence).
/// Protects (this file): the ten separate-process legs in Go order:
/// ping ok, add-7 ok, get-7 readback, get-999 row-missing,
/// duplicate add-8 constraint failure, txcommit-8 ok, get-8 kept
/// readback, txabort-9 ok, get-9 row-missing, get-abc invalid-data
/// rejection. Each leg pins its op, id arg, body arg where the argv
/// carries one, wanted stdout or error name, and exit status.
/// ADAPTATION (recorded, with source lines): body-arg pins keep the
/// strconv.Quote argv spelling with quotes (L160/L163/L164/L166),
/// so add legs carry `"remember"` and commit/abort legs carry
/// `"kept"`/`"gone"`; id args pin str because argv carries
/// "7"/"8"/"9"/"999"/"abc" (L159-168); want pins hold stdout for
/// ok legs ("mysql-ok"/"1"/row JSON, L143) and error names for
/// fault legs (L151); exits pin int 0 for ok and 1 for fault
/// (L143/L151).
/// Facet map (legs): ping-op/ping-want/ping-exit pin ping/
/// mysql-ok/0 (L159); add7-op/add7-id/add7-body/add7-want/
/// add7-exit pin add/7/`"remember"`/1/0 (L160); get7-op/get7-id/
/// get7-want/get7-exit pin get/7/`{"id":7,"body":"remember"}`/0
/// (L161); get999-op/get999-id/get999-error/get999-exit pin get/
/// 999/sql::row_missing/1 (L162); add8dup-op/add8dup-id/
/// add8dup-body/add8dup-error/add8dup-exit pin add/8/`"remember"`/
/// sql::constraint_failed/1 (L163); txcommit-op/txcommit-id/
/// txcommit-body/txcommit-want/txcommit-exit pin txcommit/8/
/// `"kept"`/1/0 (L164); get8-op/get8-id/get8-want/get8-exit pin
/// get/8/`{"id":8,"body":"kept"}`/0 (L165); txabort-op/txabort-id/
/// txabort-body/txabort-want/txabort-exit pin txabort/9/`"gone"`/
/// 1/0 (L166); get9-op/get9-id/get9-error/get9-exit pin get/9/
/// sql::row_missing/1 (L167); getabc-op/getabc-id/getabc-error/
/// getabc-exit pin get/abc/codec::invalid_data/1 (L168).
/// The roots-green pin lives in history-009-roots-green.can; the
/// run shape plus diagnostics live in
/// history-009-run-shape.can.
/// Variants: ping, add/read, missing/duplicate, commit/abort,
/// invalid codec (all in Go order).
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_MYSQL_URL gates;
/// requires can-bun-archive and can-test-mysql-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1
/// (plus QF1) are unmet. Slice timeout 360000ms mirrors the Go
/// 6-minute slice (mysql_test.go L53).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/mysql-sem checks: ping-op, ping-want, ping-exit,
/// add7-op, add7-id, add7-body, add7-want, add7-exit, get7-op,
/// get7-id, get7-want, get7-exit, get999-op, get999-id,
/// get999-error, get999-exit, add8dup-op, add8dup-id,
/// add8dup-body, add8dup-error, add8dup-exit, txcommit-op,
/// txcommit-id, txcommit-body, txcommit-want, txcommit-exit,
/// get8-op, get8-id, get8-want, get8-exit, txabort-op, txabort-id,
/// txabort-body, txabort-want, txabort-exit, get9-op, get9-id,
/// get9-error, get9-exit, getabc-op, getabc-id, getabc-error,
/// getabc-exit.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str ping_op
    str ping_want
    int ping_exit
    str add7_op
    str add7_id
    str add7_body
    str add7_want
    int add7_exit
    str get7_op
    str get7_id
    str get7_want
    int get7_exit
    str get999_op
    str get999_id
    str get999_error
    int get999_exit
    str add8dup_op
    str add8dup_id
    str add8dup_body
    str add8dup_error
    int add8dup_exit
    str txcommit_op
    str txcommit_id
    str txcommit_body
    str txcommit_want
    int txcommit_exit
    str get8_op
    str get8_id
    str get8_want
    int get8_exit
    str txabort_op
    str txabort_id
    str txabort_body
    str txabort_want
    int txabort_exit
    str get9_op
    str get9_id
    str get9_error
    int get9_exit
    str getabc_op
    str getabc_id
    str getabc_error
    int getabc_exit
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-sem", "default", "", "offline"), "ping-op" => ok "case history/mysql-sem variant default root ping-op run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-sem", "default", "", "offline"), "ping-op" => ok evidence("ping-op", "true", "true", true, "case history/mysql-sem variant default root ping-op run offline")
        different: false, true, context("history/mysql-sem", "default", "", "offline"), "ping-op" => failed{"ping-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/mysql-sem", "default", "", "offline"), "ping-exit" => ok evidence("ping-exit", "0", "0", true, "case history/mysql-sem variant default root ping-exit run offline")
        different: 1, 0, context("history/mysql-sem", "default", "", "offline"), "ping-exit" => failed{"ping-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "ping", "ping", context("history/mysql-sem", "default", "", "offline"), "ping-op" => ok evidence("ping-op", "ping", "ping", true, "case history/mysql-sem variant default root ping-op run offline")
        different: "ping_2", "ping", context("history/mysql-sem", "default", "", "offline"), "ping-op" => failed{"ping-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("ping", "mysql-ok", 0, "add", "7", "\"remember\"", "1", 0, "get", "7", "{\"id\":7,\"body\":\"remember\"}", 0, "get", "999", "sql::row_missing", 1, "add", "8", "\"remember\"", "sql::constraint_failed", 1, "txcommit", "8", "\"kept\"", "1", 0, "get", "8", "{\"id\":8,\"body\":\"kept\"}", 0, "txabort", "9", "\"gone\"", "1", 0, "get", "9", "sql::row_missing", 1, "get", "abc", "codec::invalid_data", 1)
        seed_ping_op: "seed-ping-op-drift" => ok observation("add", "mysql-ok", 0, "add", "7", "\"remember\"", "1", 0, "get", "7", "{\"id\":7,\"body\":\"remember\"}", 0, "get", "999", "sql::row_missing", 1, "add", "8", "\"remember\"", "sql::constraint_failed", 1, "txcommit", "8", "\"kept\"", "1", 0, "get", "8", "{\"id\":8,\"body\":\"kept\"}", 0, "txabort", "9", "\"gone\"", "1", 0, "get", "9", "sql::row_missing", 1, "get", "abc", "codec::invalid_data", 1)
        seed_ping_want: "seed-ping-want-drift" => ok observation("ping", "mysql-ok_2", 0, "add", "7", "\"remember\"", "1", 0, "get", "7", "{\"id\":7,\"body\":\"remember\"}", 0, "get", "999", "sql::row_missing", 1, "add", "8", "\"remember\"", "sql::constraint_failed", 1, "txcommit", "8", "\"kept\"", "1", 0, "get", "8", "{\"id\":8,\"body\":\"kept\"}", 0, "txabort", "9", "\"gone\"", "1", 0, "get", "9", "sql::row_missing", 1, "get", "abc", "codec::invalid_data", 1)
        seed_ping_exit: "seed-ping-exit-drift" => ok observation("ping", "mysql-ok", 1, "add", "7", "\"remember\"", "1", 0, "get", "7", "{\"id\":7,\"body\":\"remember\"}", 0, "get", "999", "sql::row_missing", 1, "add", "8", "\"remember\"", "sql::constraint_failed", 1, "txcommit", "8", "\"kept\"", "1", 0, "get", "8", "{\"id\":8,\"body\":\"kept\"}", 0, "txabort", "9", "\"gone\"", "1", 0, "get", "9", "sql::row_missing", 1, "get", "abc", "codec::invalid_data", 1)
