package m26history009roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-009 "MySQL persistence: roots green".
/// Source: tests/integration/mysql_test.go symbol
/// TestCurrentMySQLPersistence (L21-41 staging; L43-53 gates;
/// L85-112 setup plus snapshot); fixture
/// compiler/testdata/current/sql/mysql.can; seed
/// tests/integration/testdata/sql/mysql-seed.sql.
/// Disposition: migrate (this row ports
/// TestCurrentMySQLPersistence to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted evidence).
/// Protects (this file): the static baseline as the green root:
/// both environment gates plus skip messages, the 6-minute live
/// slice, the fixture path, the full SQL manifest (sources root,
/// registry, both query keys, dialects, statements, params,
/// param and row shapes, cardinalities, row-limit param), the
/// three staged files plus blank registry and modes, the
/// snapshot file plus key and mode, the credential variable,
/// fd 3, the seed and driver paths, the setup mode, both seed
/// statements plus count, the notes table, pool width plus
/// close timeout, the setup report keys plus empty-notes gate,
/// and the source-root marker.
/// ADAPTATION (recorded, with source lines): the slice span pins
/// int minutes (6) from 6*time.Minute (L53); mode pins keep the
/// Go octal spellings "0700"/"0600" as str (L31/L34/L112); the
/// insert-params pin joins ["id","body"] as "id,body" (L18);
/// seed-statement pins drop the ";" separators the setup splits
/// on (seed L1-2); fd-number pins 3 from the fd-3 snapshot note
/// (L104) plus the single ExtraFiles entry (L125); all
/// credential pins are structural only (file, key, mode, fd),
/// never a secret value.
/// Facet map (legs): env-archive pins CAN_BUN_ARCHIVE (L44);
/// skip-archive pins the staged archive skip (L46);
/// env-mysql-url pins CAN_TEST_MYSQL_URL (L48); skip-mysql-url
/// pins the staged URL skip (L50); ctx-timeout-min pins 6 (L53);
/// fixture-path pins mysql.can (L24); manifest-source-root and
/// manifest-error-registry pin src and can.errors.json (L17);
/// manifest-add-key pins note_add (L18); manifest-add-dialect
/// and manifest-add-stmt pin mysql plus the INSERT (L18);
/// manifest-add-params pins id,body order (L18);
/// manifest-add-param-type and manifest-add-row-type pin
/// app::note_insert and app::note_row (L18); manifest-add-card
/// pins execute (L18); manifest-by-id-key pins note_by_id (L19);
/// manifest-by-id-dialect and manifest-by-id-stmt pin mysql plus
/// the SELECT (L19); manifest-by-id-params pins id (L19);
/// manifest-by-id-param-type and manifest-by-id-row-type pin
/// app::id_parameters and app::note_row (L19);
/// manifest-by-id-card pins one (L19); manifest-row-limit pins
/// 2 (L19); project-file pins can.project.json (L38);
/// errors-file pins can.errors.json (L39); errors-blank pins the
/// blank registry (L39); main-file pins src/main.can (L40);
/// dir-mode pins 0700 (L31); file-mode pins 0600 (L34);
/// snapshot-file pins snapshot.json (L107); snapshot-key pins
/// CAN_TEST_MYSQL (L108); credential-variable pins
/// CAN_TEST_MYSQL (L158); fd-number pins 3 (L104/L125);
/// seed-path pins mysql-seed.sql (L85); driver-path pins
/// mysql-driver.ts (L86); setup-mode pins setup (L87);
/// seed-reset pins the DROP (seed L1); seed-create pins the
/// CREATE with unique body (seed L2); seed-stmt-count pins 2;
/// table-name pins notes; pool-width pins 2 and close-timeout
/// pins 1000 (mysql.can); version-key pins serverVersion (L95);
/// notes-key pins notes (L96); notes-empty pins 0 (L101);
/// source-rel pins ../.. (L23/L52); snapshot-mode pins 0600
/// (L112).
/// Answer legs live in history-009-mysql-semantics.can; the run
/// shape plus diagnostics live in
/// history-009-run-shape.can.
/// Variants: none in this file (default only); the ten legs live
/// in mysql-semantics.
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_MYSQL_URL gates;
/// requires can-bun-archive and can-test-mysql-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1
/// (plus QF1) are unmet. Slice timeout 360000ms mirrors the Go
/// 6-minute slice (mysql_test.go L53).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/mysql-roots checks: env-archive, skip-archive,
/// env-mysql-url, skip-mysql-url, ctx-timeout-min, fixture-path,
/// manifest-source-root, manifest-error-registry,
/// manifest-add-key, manifest-add-dialect, manifest-add-stmt,
/// manifest-add-params, manifest-add-param-type,
/// manifest-add-row-type, manifest-add-card, manifest-by-id-key,
/// manifest-by-id-dialect, manifest-by-id-stmt,
/// manifest-by-id-params, manifest-by-id-param-type,
/// manifest-by-id-row-type, manifest-by-id-card,
/// manifest-row-limit, project-file, errors-file, errors-blank,
/// main-file, dir-mode, file-mode, snapshot-file, snapshot-key,
/// credential-variable, fd-number, seed-path, driver-path,
/// setup-mode, seed-reset, seed-create, seed-stmt-count,
/// table-name, pool-width, close-timeout, version-key,
/// notes-key, notes-empty, source-rel, snapshot-mode.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_archive
    str skip_archive
    str env_mysql_url
    str skip_mysql_url
    int ctx_timeout_min
    str fixture_path
    str manifest_source_root
    str manifest_error_registry
    str manifest_add_key
    str manifest_add_dialect
    str manifest_add_stmt
    str manifest_add_params
    str manifest_add_param_type
    str manifest_add_row_type
    str manifest_add_card
    str manifest_by_id_key
    str manifest_by_id_dialect
    str manifest_by_id_stmt
    str manifest_by_id_params
    str manifest_by_id_param_type
    str manifest_by_id_row_type
    str manifest_by_id_card
    int manifest_row_limit
    str project_file
    str errors_file
    str errors_blank
    str main_file
    str dir_mode
    str file_mode
    str snapshot_file
    str snapshot_key
    str credential_variable
    int fd_number
    str seed_path
    str driver_path
    str setup_mode
    str seed_reset
    str seed_create
    int seed_stmt_count
    str table_name
    int pool_width
    int close_timeout
    str version_key
    str notes_key
    str notes_empty
    str source_rel
    str snapshot_mode
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-roots", "default", "", "offline"), "env-archive" => ok "case history/mysql-roots variant default root env-archive run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "true", "true", true, "case history/mysql-roots variant default root env-archive run offline")
        different: false, true, context("history/mysql-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/mysql-roots", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "6", "6", true, "case history/mysql-roots variant default root ctx-timeout-min run offline")
        different: 7, 6, context("history/mysql-roots", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("history/mysql-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case history/mysql-roots variant default root env-archive run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("history/mysql-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
