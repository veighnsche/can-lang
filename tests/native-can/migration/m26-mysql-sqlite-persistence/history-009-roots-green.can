fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h009: "m26-h009" => ok [check("env-archive", "staging gate reads CAN_BUN_ARCHIVE"), check("skip-archive", "unset archive skips with staged message"), check("env-mysql-url", "staging gate reads CAN_TEST_MYSQL_URL"), check("skip-mysql-url", "unset URL skips with staged message"), check("ctx-timeout-min", "live slice spans 6 minutes"), check("fixture-path", "project seeds from mysql.can fixture"), check("manifest-source-root", "manifest roots sources at src"), check("manifest-error-registry", "manifest names can.errors.json registry"), check("manifest-add-key", "manifest keys the insert note_add"), check("manifest-add-dialect", "insert leg targets mysql dialect"), check("manifest-add-stmt", "insert statement writes id plus body"), check("manifest-add-params", "insert params order id then body"), check("manifest-add-param-type", "insert params decode as note_insert"), check("manifest-add-row-type", "insert rows decode as note_row"), check("manifest-add-card", "insert leg runs execute cardinality"), check("manifest-by-id-key", "manifest keys the lookup note_by_id"), check("manifest-by-id-dialect", "lookup leg targets mysql dialect"), check("manifest-by-id-stmt", "lookup statement filters id with limit"), check("manifest-by-id-params", "lookup params carry id only"), check("manifest-by-id-param-type", "lookup params decode as id_parameters"), check("manifest-by-id-row-type", "lookup rows decode as note_row"), check("manifest-by-id-card", "lookup leg runs one cardinality"), check("manifest-row-limit", "lookup binds row limit param 2"), check("project-file", "project writes can.project.json"), check("errors-file", "project writes can.errors.json"), check("errors-blank", "error registry starts blank"), check("main-file", "project seeds src/main.can"), check("dir-mode", "project dirs pin mode 0700"), check("file-mode", "project files pin mode 0600"), check("snapshot-file", "credential snapshot pins snapshot.json"), check("snapshot-key", "snapshot keys the mysql credential"), check("credential-variable", "legs name variable CAN_TEST_MYSQL"), check("fd-number", "credential arrives on fd 3"), check("seed-path", "setup applies mysql-seed.sql"), check("driver-path", "setup runs mysql-driver.ts"), check("setup-mode", "driver runs in setup mode"), check("seed-reset", "seed resets the notes table"), check("seed-create", "seed creates notes with unique body"), check("seed-stmt-count", "seed holds two statements"), check("table-name", "legs share the notes table"), check("pool-width", "pools open width two"), check("close-timeout", "pools close within 1000ms"), check("version-key", "setup reports serverVersion"), check("notes-key", "setup reports notes count"), check("notes-empty", "fresh seed holds zero notes"), check("source-rel", "project resolves root via dotdot"), check("snapshot-mode", "snapshot pins mode 0600")]
        other: "nope" => ok []
