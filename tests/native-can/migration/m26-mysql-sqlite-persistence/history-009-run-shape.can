package m26history009run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-009 "MySQL persistence: run shape".
/// Source: tests/integration/mysql_test.go symbol
/// TestCurrentMySQLPersistence (L68-77 offline plus build;
/// L85-102 setup; L115-154 run plus ok/fault helpers; L169 log).
/// Disposition: migrate (this row ports
/// TestCurrentMySQLPersistence to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted evidence).
/// Protects (this file): the run shape: the offline assert leg,
/// the sandboxed build leg, the setup leg, the per-leg run
/// helper (bun entry, env, one extra file, exit-code split),
/// the ok and fault gates, every Go fatal plus log diagnostic
/// spelling, the fault needle, the check counter root, and the
/// workdir plus HOME plus PATH bindings.
/// ADAPTATION (recorded, with source lines): build-env-count
/// pins 2 from the PATH/HOME slice (L74); setup-env-count pins
/// 3 from PATH/HOME/URL (L89); run-env-count pins 2 from
/// PATH/HOME with no URL (L124), since the credential arrives
/// via the snapshot file; run-extra-count pins 1 from the
/// single ExtraFiles entry (L125), which lands on fd 3;
/// setup-arg-count pins 3 from driver plus setup plus seed
/// (L87); ok-empty-diag and fault-empty-out pin true from the
/// diag != "" and out != "" gates (L143/L151); home-is-workdir
/// pins true from HOME plus cmd.Dir (L73-74/L88-89/L123-124);
/// workdir-temp pins true from t.TempDir (L59/L64); diagnostic
/// pins keep exact Go Fatalf/Logf spellings (L70/L77/L83/L92/
/// L99/L102/L144/L152/L169).
/// Facet map (legs): offline-cmd pins assert (L68);
/// sandbox-bin pins /usr/bin/sandbox-exec (L72);
/// sandbox-profile pins the deny-network profile (L72);
/// canlc-rel pins bin/canlc (L72); build-op pins build (L72);
/// build-env-count pins 2 (L74); build-output pins
/// CombinedOutput (L75); build-dir-key pins directory (L80);
/// setup-bun-rel pins runtime/bun (L87); setup-arg-count pins 3
/// (L87); setup-env-count pins 3 (L89); run-bun-rel pins
/// runtime/bun (L122); run-entry pins entry.ts (L122);
/// run-env-count pins 2 (L124); run-extra-count pins 1 (L125);
/// ok-exit pins 0 (L143); fault-exit pins 1 (L151);
/// ok-empty-diag pins the empty-diag gate (L143);
/// fault-empty-out pins the empty-stdout gate (L151);
/// fault-needle pins `"error":"` (L151); fault-needle-suffix
/// pins the closing quote (L151); checks-start pins 0 (L138);
/// fatal-offline pins the assert wrap (L70); fatal-build pins
/// the build wrap (L77); fatal-build-report pins the decode
/// wrap (L83); fatal-setup pins the setup wrap (L92);
/// fatal-setup-report pins the setup decode wrap (L99);
/// fatal-seed-notes pins the seed gate (L102); fatal-live-ok
/// pins the ok wrap (L144); fatal-live-fault pins the fault
/// wrap (L152); log-live pins the success log (L169);
/// home-is-workdir pins HOME binding (L73-74); path-none pins
/// PATH=/nonexistent (L74); workdir-temp pins the temp dirs
/// (L59/L64); exit-source pins ExitCode (L130-134).
/// The roots-green pin lives in history-009-roots-green.can;
/// answer legs live in history-009-mysql-semantics.can.
/// Variants: the ten legs share one launch and diagnostic
/// shape (a single default case; per-leg answers pin in
/// mysql-semantics).
/// Environment: CAN_BUN_ARCHIVE plus CAN_TEST_MYSQL_URL gates;
/// requires can-bun-archive and can-test-mysql-url.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates P23/QD1
/// (plus QF1) are unmet. Slice timeout 360000ms mirrors the Go
/// 6-minute slice (mysql_test.go L53).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/mysql-run checks: offline-cmd, sandbox-bin,
/// sandbox-profile, canlc-rel, build-op, build-env-count,
/// build-output, build-dir-key, setup-bun-rel, setup-arg-count,
/// setup-env-count, run-bun-rel, run-entry, run-env-count,
/// run-extra-count, ok-exit, fault-exit, ok-empty-diag,
/// fault-empty-out, fault-needle, fault-needle-suffix,
/// checks-start, fatal-offline, fatal-build, fatal-build-report,
/// fatal-setup, fatal-setup-report, fatal-seed-notes,
/// fatal-live-ok, fatal-live-fault, log-live, home-is-workdir,
/// path-none, workdir-temp, exit-source.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str offline_cmd
    str sandbox_bin
    str sandbox_profile
    str canlc_rel
    str build_op
    int build_env_count
    str build_output
    str build_dir_key
    str setup_bun_rel
    int setup_arg_count
    int setup_env_count
    str run_bun_rel
    str run_entry
    int run_env_count
    int run_extra_count
    int ok_exit
    int fault_exit
    bool ok_empty_diag
    bool fault_empty_out
    str fault_needle
    str fault_needle_suffix
    int checks_start
    str fatal_offline
    str fatal_build
    str fatal_build_report
    str fatal_setup
    str fatal_setup_report
    str fatal_seed_notes
    str fatal_live_ok
    str fatal_live_fault
    str log_live
    bool home_is_workdir
    str path_none
    bool workdir_temp
    str exit_source
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-run", "default", "", "offline"), "offline-cmd" => ok "case history/mysql-run variant default root offline-cmd run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-run", "default", "", "offline"), "ok-empty-diag" => ok evidence("ok-empty-diag", "true", "true", true, "case history/mysql-run variant default root ok-empty-diag run offline")
        different: false, true, context("history/mysql-run", "default", "", "offline"), "ok-empty-diag" => failed{"ok-empty-diag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/mysql-run", "default", "", "offline"), "build-env-count" => ok evidence("build-env-count", "2", "2", true, "case history/mysql-run variant default root build-env-count run offline")
        different: 3, 2, context("history/mysql-run", "default", "", "offline"), "build-env-count" => failed{"build-env-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "assert", "assert", context("history/mysql-run", "default", "", "offline"), "offline-cmd" => ok evidence("offline-cmd", "assert", "assert", true, "case history/mysql-run variant default root offline-cmd run offline")
        different: "assert_2", "assert", context("history/mysql-run", "default", "", "offline"), "offline-cmd" => failed{"offline-cmd"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
