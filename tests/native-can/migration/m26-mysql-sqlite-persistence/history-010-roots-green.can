package m26history010roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-010 "SQLite persistence: roots green".
/// Source: tests/integration/sqlite_test.go symbol
/// TestCurrentSQLitePersistence (L43-162); env gate (L45-48);
/// manifest (L17-19); project writer (L21-41); live ctx
/// (L50); owned paths (L82-84); fixture
/// compiler/testdata/current/sql/sqlite.can; seed
/// tests/integration/testdata/sql/sqlite-seed.sql (L1-2);
/// driver setup guard
/// (tests/integration/testdata/sql/sqlite-driver.ts L31).
/// Disposition: migrate (this row ports
/// TestCurrentSQLitePersistence to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static live baseline as the green
/// root: the archive gate plus skip, the 6-minute ctx, the SQL
/// manifest (root, registry, both ops, dialect, statements,
/// shapes, limit slot, param/row records, param lists), the
/// staged project files plus empty registry, the owned db/seed/
/// driver names, the two seed statements plus table, the CLI op
/// vocabulary plus usage spellings, the file open modes plus
/// timeouts, and the nine leg input values.
/// ADAPTATION (recorded, with source lines): the ctx timeout
/// pins int minutes (6) from 6*time.Minute (L50); the seed
/// count pins int (2) from the driver guard (driver L31); open
/// modes pin the rwc/rw spellings (fixture L38/L62);
/// busy/close timeouts pin ms ints (5000/1000); the invalid id
/// pins the abc spelling (L160) as str since the CLI arg never
/// decodes; only the CAN_BUN_ARCHIVE key name plus skip wording
/// is pinned, never a credential value (Go L102: SQLite opens
/// read no credentials).
/// Facet map (static baseline): env-archive pins CAN_BUN_ARCHIVE
/// (L45); skip-archive pins the staged skip (L47);
/// ctx-timeout-min pins 6 (L50); manifest-source-root pins src
/// (L17); manifest-error-registry pins can.errors.json (L17);
/// fixture-path pins compiler/testdata/current/sql/sqlite.can
/// (L24); project-manifest pins can.project.json (L38);
/// project-errors pins can.errors.json (L39); project-main pins
/// src/main.can (L40); errors-registry pins the empty registry
/// (L39); op-note-add pins note_add (L18); op-note-by-id pins
/// note_by_id (L19); dialect pins sqlite (L18/L19); stmt-add pins
/// the insert (L18); stmt-by-id pins the select (L19); card-add
/// pins execute (L18); card-by-id pins one (L19); row-limit-param
/// pins 2 (L19); param-type-add pins app::note_insert (L18);
/// param-type-by-id pins app::id_parameters (L19); row-type pins
/// app::note_row (L18/L19); params-add pins id plus body (L18);
/// params-by-id pins id (L19); db-name pins notes.sqlite (L82);
/// seed-name pins sqlite-seed.sql (L83); driver-name pins
/// sqlite-driver.ts (L84); seed-drop pins the drop (seed L1);
/// seed-create pins the create (seed L2); table-notes pins notes
/// (seed L1/L2); seed-stmt-count pins 2 (driver L31); cli-mem
/// pins mem (fixture L170); cli-add pins add (fixture L179);
/// cli-get pins get (fixture L201); cli-txcommit pins txcommit
/// (fixture L224); cli-txabort pins txabort (fixture L245);
/// usage-top pins the dispatcher usage (fixture L266/L273);
/// usage-add pins the add usage (fixture L180); usage-get pins
/// the get usage (fixture L202); usage-txcommit pins the commit
/// usage (fixture L225); usage-txabort pins the abort usage
/// (fixture L246); open-mode-write pins rwc (fixture
/// L38/L122/L146); open-mode-read pins rw (fixture L62);
/// busy-timeout-ms pins 5000 (fixture L38/L62/L122/L146);
/// pool-close-ms pins 1000 (fixture L24/L49/L76/L132/L156);
/// leg-add-id pins 7 (L152); leg-add-body pins remember (L152);
/// leg-missing-id pins 999 (L154); leg-dup-id pins 8 (L155);
/// leg-commit-id pins 8 (L156); leg-commit-body pins kept (L156);
/// leg-abort-id pins 9 (L158); leg-abort-body pins gone (L158);
/// leg-invalid-id pins abc (L160).
/// Answer semantics live in history-010-sqlite-semantics.can;
/// the run shape plus diagnostics live in
/// history-010-run-shape.can.
/// Variants: none in this file (default only); the five live
/// variants pin in sqlite-semantics.
/// Environment: CAN_BUN_ARCHIVE gates; requires can-bun-archive.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates
/// P23/QD1 (plus QF1) are unmet. Timeout 360000ms mirrors the
/// Go 6-minute ctx (sqlite_test.go L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/sqlite-roots checks: env-archive, skip-archive,
/// ctx-timeout-min, manifest-source-root,
/// manifest-error-registry, fixture-path, project-manifest,
/// project-errors, project-main, errors-registry, op-note-add,
/// op-note-by-id, dialect, stmt-add, stmt-by-id, card-add,
/// card-by-id, row-limit-param, param-type-add, param-type-by-id,
/// row-type, params-add, params-by-id, db-name, seed-name,
/// driver-name, seed-drop, seed-create, table-notes,
/// seed-stmt-count, cli-mem, cli-add, cli-get, cli-txcommit,
/// cli-txabort, usage-top, usage-add, usage-get, usage-txcommit,
/// usage-txabort, open-mode-write, open-mode-read,
/// busy-timeout-ms, pool-close-ms, leg-add-id, leg-add-body,
/// leg-missing-id, leg-dup-id, leg-commit-id, leg-commit-body,
/// leg-abort-id, leg-abort-body, leg-invalid-id.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_archive
    str skip_archive
    int ctx_timeout_min
    str manifest_source_root
    str manifest_error_registry
    str fixture_path
    str project_manifest
    str project_errors
    str project_main
    str errors_registry
    str op_note_add
    str op_note_by_id
    str dialect
    str stmt_add
    str stmt_by_id
    str card_add
    str card_by_id
    int row_limit_param
    str param_type_add
    str param_type_by_id
    str row_type
    str params_add
    str params_by_id
    str db_name
    str seed_name
    str driver_name
    str seed_drop
    str seed_create
    str table_notes
    int seed_stmt_count
    str cli_mem
    str cli_add
    str cli_get
    str cli_txcommit
    str cli_txabort
    str usage_top
    str usage_add
    str usage_get
    str usage_txcommit
    str usage_txabort
    str open_mode_write
    str open_mode_read
    int busy_timeout_ms
    int pool_close_ms
    int leg_add_id
    str leg_add_body
    int leg_missing_id
    int leg_dup_id
    int leg_commit_id
    str leg_commit_body
    int leg_abort_id
    str leg_abort_body
    str leg_invalid_id
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/sqlite-roots", "default", "", "offline"), "env-archive" => ok "case history/sqlite-roots variant default root env-archive run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/sqlite-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "true", "true", true, "case history/sqlite-roots variant default root env-archive run offline")
        different: false, true, context("history/sqlite-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/sqlite-roots", "default", "", "offline"), "ctx-timeout-min" => ok evidence("ctx-timeout-min", "6", "6", true, "case history/sqlite-roots variant default root ctx-timeout-min run offline")
        different: 5, 6, context("history/sqlite-roots", "default", "", "offline"), "ctx-timeout-min" => failed{"ctx-timeout-min"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("history/sqlite-roots", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case history/sqlite-roots variant default root env-archive run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("history/sqlite-roots", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
