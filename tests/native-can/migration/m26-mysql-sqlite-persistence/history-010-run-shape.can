package m26history010run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-010 "SQLite persistence: run shape".
/// Source: tests/integration/sqlite_test.go symbol
/// TestCurrentSQLitePersistence (L43-162); offline leg
/// (L65-68); build launch (L69-81); setup launch (L85-101);
/// snapshot plus run closure (L102-130); ok/fault guards
/// (L132-147); success log (L161); driver refusals plus
/// report (tests/integration/testdata/sql/sqlite-driver.ts
/// L17-43).
/// Disposition: migrate (this row ports
/// TestCurrentSQLitePersistence to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the offline assert
/// leg, the sandboxed build launch (binary, profile, verb, env,
/// workdir, combined output, report key), the bun setup launch
/// (runtime, mode, arg count, env), the fd-3 empty snapshot
/// delivery (name, bytes, owner-only modes, extra-file count,
/// fd number, temp dirs, entry name, run env), the sqlite
/// adapter, every Go fatal plus log diagnostic spelling, the
/// fault matcher (error key plus closing quote), the five
/// driver refusal wordings, both setup report keys, both
/// seed-shape prefixes, and both driver selects.
/// ADAPTATION (recorded, with source lines): env counts pin 2
/// from the PATH/HOME slice pairs (L71/L87/L117);
/// setup-arg-count pins 4 from driver plus setup plus db plus
/// seed after bun (L85); snapshot-fd pins 3 since the single
/// ExtraFiles entry lands on fd 3 (L118); home-is-workdir pins
/// true from cmd.Dir plus HOME (L70-71); modes pin the
/// 0600/0700 spellings structurally (L31/L34/L105); the mode
/// and count refusals pin the static template heads before
/// their dynamic values (driver L17/L31).
/// Facet map (launch plus diagnostics): assert-cmd pins assert
/// (L65); assert-status pins 0 (L66); assert-diag-empty pins true
/// (L66); sandbox-bin pins /usr/bin/sandbox-exec (L69);
/// sandbox-profile pins the deny-network profile (L69); canlc-bin
/// pins bin/canlc (L69); build-subcmd pins build (L69);
/// build-env-count pins 2 (L71); path-env pins PATH=/nonexistent
/// (L71/L87/L117); home-prefix pins HOME= (L71/L87/L117);
/// home-is-workdir pins true (L70-71); combined-output pins
/// CombinedOutput (L72/L88); build-report-key pins directory
/// (L77); bun-runtime pins runtime/bun (L85/L115); setup-mode
/// pins setup (L85); setup-arg-count pins 4 (L85);
/// setup-env-count pins 2 (L87); snapshot-name pins snapshot.json
/// (L104); snapshot-bytes pins {} (L105); snapshot-mode pins 0600
/// (L34/L105); stage-dir-mode pins 0700 (L31); extra-files-count
/// pins 1 (L118); snapshot-fd pins 3 (L118); temp-dir-count pins
/// 2 (L56/L61); entry-name pins entry.ts (L115); run-env-count
/// pins 2 (L117); driver-adapter pins sqlite (driver L21);
/// fatal-assert pins the assert wrap (L67); fatal-build pins the
/// build wrap (L74); fatal-build-report pins the decode wrap
/// (L80); fatal-setup pins the setup wrap (L90);
/// fatal-setup-report pins the decode wrap (L97);
/// fatal-seed-notes pins the seed want (L100); fatal-live pins
/// the leg wrap (L137/L145); log-live pins the success log
/// (L161); fault-needle pins the error key (L144); fault-suffix
/// pins the closing quote (L144); unknown-mode-prefix pins the
/// mode head (driver L17); refuse-db-path pins the path demand
/// (driver L18); refuse-seed-path pins the seed demand (driver
/// L19); refuse-seed-count pins the count demand (driver L31);
/// refuse-seed-shape pins the shape refusal (driver L34);
/// refuse-version pins the version demand (driver L41);
/// report-lib-key pins libraryVersion (L93; driver L43);
/// report-notes-key pins notes (L94; driver L43);
/// driver-drop-prefix pins DROP TABLE (driver L33);
/// driver-create-prefix pins CREATE TABLE (driver L33);
/// version-query pins the version select (driver L39);
/// count-query pins the count select (driver L42).
/// Answer semantics live in history-010-sqlite-semantics.can;
/// the roots-green pin lives in history-010-roots-green.can.
/// Variants: the five live variants share one launch and
/// diagnostic shape (a single default case; per-leg answers
/// pin in sqlite-semantics).
/// Environment: CAN_BUN_ARCHIVE gates; requires can-bun-archive.
/// Logical gates SUITE/CAN/PROC/CHILD/DB/WORK and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gates
/// P23/QD1 (plus QF1) are unmet. Timeout 360000ms mirrors the
/// Go 6-minute ctx (sqlite_test.go L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1 unmet).
/// Case history/sqlite-run checks: assert-cmd, assert-status,
/// assert-diag-empty, sandbox-bin, sandbox-profile, canlc-bin,
/// build-subcmd, build-env-count, path-env, home-prefix,
/// home-is-workdir, combined-output, build-report-key,
/// bun-runtime, setup-mode, setup-arg-count, setup-env-count,
/// snapshot-name, snapshot-bytes, snapshot-mode, stage-dir-mode,
/// extra-files-count, snapshot-fd, temp-dir-count, entry-name,
/// run-env-count, driver-adapter, fatal-assert, fatal-build,
/// fatal-build-report, fatal-setup, fatal-setup-report,
/// fatal-seed-notes, fatal-live, log-live, fault-needle,
/// fault-suffix, unknown-mode-prefix, refuse-db-path,
/// refuse-seed-path, refuse-seed-count, refuse-seed-shape,
/// refuse-version, report-lib-key, report-notes-key,
/// driver-drop-prefix, driver-create-prefix, version-query,
/// count-query.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str assert_cmd
    int assert_status
    bool assert_diag_empty
    str sandbox_bin
    str sandbox_profile
    str canlc_bin
    str build_subcmd
    int build_env_count
    str path_env
    str home_prefix
    bool home_is_workdir
    str combined_output
    str build_report_key
    str bun_runtime
    str setup_mode
    int setup_arg_count
    int setup_env_count
    str snapshot_name
    str snapshot_bytes
    str snapshot_mode
    str stage_dir_mode
    int extra_files_count
    int snapshot_fd
    int temp_dir_count
    str entry_name
    int run_env_count
    str driver_adapter
    str fatal_assert
    str fatal_build
    str fatal_build_report
    str fatal_setup
    str fatal_setup_report
    str fatal_seed_notes
    str fatal_live
    str log_live
    str fault_needle
    str fault_suffix
    str unknown_mode_prefix
    str refuse_db_path
    str refuse_seed_path
    str refuse_seed_count
    str refuse_seed_shape
    str refuse_version
    str report_lib_key
    str report_notes_key
    str driver_drop_prefix
    str driver_create_prefix
    str version_query
    str count_query
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/sqlite-run", "default", "", "offline"), "assert-cmd" => ok "case history/sqlite-run variant default root assert-cmd run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/sqlite-run", "default", "", "offline"), "assert-diag-empty" => ok evidence("assert-diag-empty", "true", "true", true, "case history/sqlite-run variant default root assert-diag-empty run offline")
        different: false, true, context("history/sqlite-run", "default", "", "offline"), "assert-diag-empty" => failed{"assert-diag-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/sqlite-run", "default", "", "offline"), "assert-status" => ok evidence("assert-status", "0", "0", true, "case history/sqlite-run variant default root assert-status run offline")
        different: 1, 0, context("history/sqlite-run", "default", "", "offline"), "assert-status" => failed{"assert-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "assert", "assert", context("history/sqlite-run", "default", "", "offline"), "assert-cmd" => ok evidence("assert-cmd", "assert", "assert", true, "case history/sqlite-run variant default root assert-cmd run offline")
        different: "assert_2", "assert", context("history/sqlite-run", "default", "", "offline"), "assert-cmd" => failed{"assert-cmd"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
