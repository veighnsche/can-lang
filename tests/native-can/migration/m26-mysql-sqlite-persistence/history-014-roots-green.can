fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m26_h014: "m26-h014" => ok test_case("history/mysql-roots", ["history", "m26"], ["can-test-mysql-url", "bun"], 360000, [check_ref("version-query"), check_ref("version-key"), check_ref("version-missing"), check_ref("version-default"), check_ref("notes-query"), check_ref("notes-from"), check_ref("notes-key"), check_ref("notes-default"), check_ref("report-version-key"), check_ref("report-notes-key"), check_ref("notes-empty"), check_ref("static-template"), check_ref("close-op"), check_ref("report-op"), check_ref("count-type"), check_ref("version-fn"), check_ref("count-fn")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
