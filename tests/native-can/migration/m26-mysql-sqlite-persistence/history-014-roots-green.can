package m26history014roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-014 "mysql-driver.ts: version and empty-notes roots".
/// Source: tests/integration/testdata/sql/mysql-driver.ts symbol
/// mysql-driver.ts (L39-43 version/notes legs); executed by
/// tests/integration/mysql_test.go.
/// Disposition: migrate (this row ports mysql-driver.ts to
/// ordinary Can functions; the old TS script stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the server-version leg (query, key,
/// empty refusal, default), the empty-notes leg (count query,
/// FROM/decoded keys, missing default, zero-notes decision),
/// the JSON report keys, and the template/close/stringify
/// operators.
/// ADAPTATION (recorded, with source lines): notes-empty pins the
/// Go caller "0" decision (mysql_test.go L101); version-default
/// pins the L40 `?? ""`; notes-default pins the L43 `?? -1`;
/// notes-from pins FROM notes (L42) to keep the table pin
/// distinct from the report key; static-template pins the
/// adapter name; report-op pins stringify; count-type pins the
/// decoded bigint type.
/// Facet map (mysql-driver.ts legs): version-query pins SELECT
/// VERSION() AS version (L39); version-key pins version
/// (L39/L40); version-missing pins the L41 message;
/// version-default pins empty (L40); notes-query pins SELECT
/// COUNT(*) AS count FROM notes (L42); notes-from pins FROM
/// notes (L42); notes-key pins count (L42); notes-default pins
/// -1 (L43); report-version-key pins serverVersion (L40/L43);
/// report-notes-key pins notes (L43); notes-empty pins 0 (Go
/// L101); static-template pins staticTemplate (L08/L37/L39/L42);
/// close-op pins close (L45); report-op pins stringify (L43);
/// count-type pins bigint (L42); version-fn pins VERSION()
/// (L39); count-fn pins COUNT(*) (L42).
/// Seed semantics live in history-014-seed-semantics.can; the
/// invocation/run shape lives in history-014-run-shape.can.
/// Variants: none (single setup scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_MYSQL_URL
/// (required); requires can-test-mysql-url and bun.
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 360000ms mirrors the Go 6-minute ctx
/// (mysql_test.go L53).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/mysql-roots checks: version-query, version-key,
/// version-missing, version-default, notes-query, notes-from,
/// notes-key, notes-default, report-version-key,
/// report-notes-key, notes-empty, static-template, close-op,
/// report-op, count-type, version-fn, count-fn.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str version_query
    str version_key
    str version_missing
    str version_default
    str notes_query
    str notes_from
    str notes_key
    int notes_default
    str report_version_key
    str report_notes_key
    str notes_empty
    str static_template
    str close_op
    str report_op
    str count_type
    str version_fn
    str count_fn
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-roots", "default", "", "offline"), "version-query" => ok "case history/mysql-roots variant default root version-query run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-roots", "default", "", "offline"), "version-query" => ok evidence("version-query", "true", "true", true, "case history/mysql-roots variant default root version-query run offline")
        different: false, true, context("history/mysql-roots", "default", "", "offline"), "version-query" => failed{"version-query"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: -1, -1, context("history/mysql-roots", "default", "", "offline"), "notes-default" => ok evidence("notes-default", "-1", "-1", true, "case history/mysql-roots variant default root notes-default run offline")
        different: 0, -1, context("history/mysql-roots", "default", "", "offline"), "notes-default" => failed{"notes-default"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "SELECT VERSION() AS version", "SELECT VERSION() AS version", context("history/mysql-roots", "default", "", "offline"), "version-query" => ok evidence("version-query", "SELECT VERSION() AS version", "SELECT VERSION() AS version", true, "case history/mysql-roots variant default root version-query run offline")
        different: "SELECT VERSION() AS versions", "SELECT VERSION() AS version", context("history/mysql-roots", "default", "", "offline"), "version-query" => failed{"version-query"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
