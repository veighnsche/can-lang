        seed_version_fn: context("history/mysql-roots", "seed-version-fn-drift", "", "offline") => failed{"version-fn"}
        seed_count_fn: context("history/mysql-roots", "seed-count-fn-drift", "", "offline") => failed{"count-fn"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.version_query, "SELECT VERSION() AS version", c, "version-query")
            failed
            ok evidence version_query_evidence => match call require_text(got.version_key, "version", c, "version-key")
