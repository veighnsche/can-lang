        false => ok []
        true => ok [check("version-query", "version leg selects VERSION"), check("version-key", "version row pins the version key"), check("version-missing", "empty version refuses"), check("version-default", "missing version defaults empty"), check("notes-query", "notes leg counts notes"), check("notes-from", "count reads FROM notes"), check("notes-key", "count row pins the count key"), check("notes-default", "missing count defaults -1"), check("report-version-key", "report carries serverVersion"), check("report-notes-key", "report carries notes"), check("notes-empty", "live seed leaves zero notes"), check("static-template", "queries run as static templates"), check("close-op", "setup always closes the pool"), check("report-op", "report carries stringified JSON"), check("count-type", "count decodes as bigint"), check("version-fn", "version calls VERSION"), check("count-fn", "count calls COUNT star")]
