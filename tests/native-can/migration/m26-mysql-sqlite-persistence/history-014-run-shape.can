        true => ok [expected_check("mode-setup", "setup"), expected_check("mode-arg", "2"), expected_check("seed-arg", "3"), expected_check("unknown-mode", "unknown mode "), expected_check("missing-seed", "missing seed path argument"), expected_check("env-gate", "CAN_TEST_MYSQL_URL"), expected_check("env-unset", "CAN_TEST_MYSQL_URL is not set"), expected_check("sql-adapter", "mysql"), expected_check("sql-max", "1"), expected_check("sql-bigint", "true"), expected_check("sql-tls", "true"), expected_check("error-exit", "1"), expected_check("bun-import", "bun"), expected_check("sql-import", "SQL"), expected_check("seed-read", "Bun"), expected_check("argv-needle", "argv"), expected_check("process-op", "process"), expected_check("exit-op", "exit"), expected_check("harness-id", "B1-03")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/mysql-run", "default", "", "offline") => ok
        seed_mode_setup: context("history/mysql-run", "seed-mode-setup-drift", "", "offline") => failed{"mode-setup"}
        seed_mode_arg: context("history/mysql-run", "seed-mode-arg-drift", "", "offline") => failed{"mode-arg"}
        seed_seed_arg: context("history/mysql-run", "seed-seed-arg-drift", "", "offline") => failed{"seed-arg"}
        seed_unknown_mode: context("history/mysql-run", "seed-unknown-mode-drift", "", "offline") => failed{"unknown-mode"}
        seed_missing_seed: context("history/mysql-run", "seed-missing-seed-drift", "", "offline") => failed{"missing-seed"}
        seed_env_gate: context("history/mysql-run", "seed-env-gate-drift", "", "offline") => failed{"env-gate"}
        seed_env_unset: context("history/mysql-run", "seed-env-unset-drift", "", "offline") => failed{"env-unset"}
        seed_sql_adapter: context("history/mysql-run", "seed-sql-adapter-drift", "", "offline") => failed{"sql-adapter"}
        seed_sql_max: context("history/mysql-run", "seed-sql-max-drift", "", "offline") => failed{"sql-max"}
        seed_sql_bigint: context("history/mysql-run", "seed-sql-bigint-drift", "", "offline") => failed{"sql-bigint"}
        seed_sql_tls: context("history/mysql-run", "seed-sql-tls-drift", "", "offline") => failed{"sql-tls"}
        seed_error_exit: context("history/mysql-run", "seed-error-exit-drift", "", "offline") => failed{"error-exit"}
        seed_bun_import: context("history/mysql-run", "seed-bun-import-drift", "", "offline") => failed{"bun-import"}
        seed_sql_import: context("history/mysql-run", "seed-sql-import-drift", "", "offline") => failed{"sql-import"}
        seed_seed_read: context("history/mysql-run", "seed-seed-read-drift", "", "offline") => failed{"seed-read"}
        seed_argv_needle: context("history/mysql-run", "seed-argv-needle-drift", "", "offline") => failed{"argv-needle"}
        seed_process_op: context("history/mysql-run", "seed-process-op-drift", "", "offline") => failed{"process-op"}
        seed_exit_op: context("history/mysql-run", "seed-exit-op-drift", "", "offline") => failed{"exit-op"}
        seed_harness_id: context("history/mysql-run", "seed-harness-id-drift", "", "offline") => failed{"harness-id"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.mode_setup, "setup", c, "mode-setup")
            failed
            ok evidence mode_setup_evidence => match call require_int(got.mode_arg, 2, c, "mode-arg")
                failed
                ok evidence mode_arg_evidence => match call require_int(got.seed_arg, 3, c, "seed-arg")
                    failed
                    ok evidence seed_arg_evidence => match call require_text(got.unknown_mode, "unknown mode ", c, "unknown-mode")
                        failed
                        ok evidence unknown_mode_evidence => match call require_text(got.missing_seed, "missing seed path argument", c, "missing-seed")
                            failed
                            ok evidence missing_seed_evidence => match call require_text(got.env_gate, "CAN_TEST_MYSQL_URL", c, "env-gate")
                                failed
