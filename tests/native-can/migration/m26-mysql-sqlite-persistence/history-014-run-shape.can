package m26history014run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-014 "mysql-driver.ts: invocation and run shape".
/// Source: tests/integration/testdata/sql/mysql-driver.ts symbol
/// mysql-driver.ts (L01-21 invocation/pool legs, L47-49 failure
/// leg); executed by tests/integration/mysql_test.go.
/// Disposition: migrate (this row ports mysql-driver.ts to
/// ordinary Can functions; the old TS script stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the setup-mode gate with argv shapes,
/// the mode/path/env refusal needles, the SQL pool options,
/// the bun/SQL import shape, the process/exit operators, and
/// the harness identity.
/// ADAPTATION (recorded, with source lines): unknown-mode pins
/// the template prefix before the interpolation (L17, trailing
/// space kept); mode-arg/seed-arg pin the argv indices (L14/L15);
/// sql-max pins max 1 (L21); sql-bigint/sql-tls pin the true
/// flags (L21); error-exit pins exit 1 (L49); bun-import pins
/// the lowercase module name while seed-read pins the capital
/// Bun reader (L06/L23); harness-id pins the B1-03 comment
/// (L01).
/// Facet map (mysql-driver.ts legs): mode-setup pins setup
/// (L17); mode-arg pins 2 (L14); seed-arg pins 3 (L15);
/// unknown-mode pins the L17 prefix; missing-seed pins the L18
/// message; env-gate pins CAN_TEST_MYSQL_URL (L16); env-unset
/// pins the L19 message; sql-adapter pins mysql (L21); sql-max
/// pins 1 (L21); sql-bigint pins true (L21); sql-tls pins true
/// (L21); error-exit pins 1 (L49); bun-import pins bun (L06);
/// sql-import pins SQL (L06); seed-read pins Bun (L23);
/// argv-needle pins argv (L14/L15); process-op pins process
/// (L14/L15/L16/L49); exit-op pins exit (L49); harness-id pins
/// B1-03 (L01).
/// Seed semantics live in history-014-seed-semantics.can; the
/// roots-green pin lives in history-014-roots-green.can.
/// Variants: none (single setup scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_MYSQL_URL
/// (required); requires can-test-mysql-url and bun.
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 360000ms mirrors the Go 6-minute ctx
/// (mysql_test.go L53).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/mysql-run checks: mode-setup, mode-arg, seed-arg,
/// unknown-mode, missing-seed, env-gate, env-unset, sql-adapter,
/// sql-max, sql-bigint, sql-tls, error-exit, bun-import,
/// sql-import, seed-read, argv-needle, process-op, exit-op,
/// harness-id.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str mode_setup
    int mode_arg
    int seed_arg
    str unknown_mode
    str missing_seed
    str env_gate
    str env_unset
    str sql_adapter
    int sql_max
    bool sql_bigint
    bool sql_tls
    int error_exit
    str bun_import
    str sql_import
    str seed_read
    str argv_needle
    str process_op
    str exit_op
    str harness_id
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-run", "default", "", "offline"), "mode-setup" => ok "case history/mysql-run variant default root mode-setup run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-run", "default", "", "offline"), "sql-bigint" => ok evidence("sql-bigint", "true", "true", true, "case history/mysql-run variant default root sql-bigint run offline")
        different: false, true, context("history/mysql-run", "default", "", "offline"), "sql-bigint" => failed{"sql-bigint"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/mysql-run", "default", "", "offline"), "mode-arg" => ok evidence("mode-arg", "2", "2", true, "case history/mysql-run variant default root mode-arg run offline")
        different: 3, 2, context("history/mysql-run", "default", "", "offline"), "mode-arg" => failed{"mode-arg"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "setup", "setup", context("history/mysql-run", "default", "", "offline"), "mode-setup" => ok evidence("mode-setup", "setup", "setup", true, "case history/mysql-run variant default root mode-setup run offline")
        different: "setups", "setup", context("history/mysql-run", "default", "", "offline"), "mode-setup" => failed{"mode-setup"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
