fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h014: "m26-h014" => ok [check("mode-setup", "driver runs the setup mode"), check("mode-arg", "mode reads argv 2"), check("seed-arg", "seed path reads argv 3"), check("unknown-mode", "other modes refuse"), check("missing-seed", "empty seed path refuses"), check("env-gate", "url reads CAN_TEST_MYSQL_URL"), check("env-unset", "unset url refuses"), check("sql-adapter", "pool uses the mysql adapter"), check("sql-max", "pool opens one connection"), check("sql-bigint", "pool decodes bigint"), check("sql-tls", "pool requires tls"), check("error-exit", "failure exits 1"), check("bun-import", "driver imports from bun"), check("sql-import", "driver imports SQL"), check("seed-read", "seed reads through Bun"), check("argv-needle", "args read argv"), check("process-op", "driver uses process"), check("exit-op", "failure calls exit"), check("harness-id", "harness pins B1-03")]
        other: "nope" => ok []
    match scope is "m26-h014"
        false => ok []
        true => ok [check("mode-setup", "driver runs the setup mode"), check("mode-arg", "mode reads argv 2"), check("seed-arg", "seed path reads argv 3"), check("unknown-mode", "other modes refuse"), check("missing-seed", "empty seed path refuses"), check("env-gate", "url reads CAN_TEST_MYSQL_URL"), check("env-unset", "unset url refuses"), check("sql-adapter", "pool uses the mysql adapter"), check("sql-max", "pool opens one connection"), check("sql-bigint", "pool decodes bigint"), check("sql-tls", "pool requires tls"), check("error-exit", "failure exits 1"), check("bun-import", "driver imports from bun"), check("sql-import", "driver imports SQL"), check("seed-read", "seed reads through Bun"), check("argv-needle", "args read argv"), check("process-op", "driver uses process"), check("exit-op", "failure calls exit"), check("harness-id", "harness pins B1-03")]
