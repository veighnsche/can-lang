    asserts
        default: "default" => ok observation("\n", "--", ";", 2, "DROP TABLE IF EXISTS notes", "CREATE TABLE notes (id BIGINT PRIMARY KEY, body VARCHAR(255) UNIQUE)", "DROP TABLE", "CREATE TABLE", "seed file shape changed; refusing to run setup", "seed file must hold 2 statements, saw ", "notes", "", "trimStart", "startsWith", "split", "join", "length")
        seed_line_split: "seed-line-split-drift" => ok observation("\n\n", "--", ";", 2, "DROP TABLE IF EXISTS notes", "CREATE TABLE notes (id BIGINT PRIMARY KEY, body VARCHAR(255) UNIQUE)", "DROP TABLE", "CREATE TABLE", "seed file shape changed; refusing to run setup", "seed file must hold 2 statements, saw ", "notes", "", "trimStart", "startsWith", "split", "join", "length")
