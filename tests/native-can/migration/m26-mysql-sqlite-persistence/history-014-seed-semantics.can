package m26history014seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-014 "mysql-driver.ts: two-statement seed pipeline".
/// Source: tests/integration/testdata/sql/mysql-driver.ts symbol
/// mysql-driver.ts (L23-35 seed pipeline, L31-34 guards); seed
/// bytes from tests/integration/testdata/sql/mysql-seed.sql;
/// executed by tests/integration/mysql_test.go.
/// Disposition: migrate (this row ports mysql-driver.ts to
/// ordinary Can functions; the old TS script stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the line/comment/statement split
/// pipeline, the two kind-ordered seed statements in apply
/// order, the count and shape guards, and the pipeline
/// operator needles.
/// ADAPTATION (recorded, with source lines): line-split pins the
/// newline needle (driver source `"\n"` at L25/L27); stmt-split
/// pins the semicolon (L28); reset/create statements pin the
/// post-split trimmed forms (semicolons stripped by L28-30),
/// verified by replaying the split on mysql-seed.sql; kind pins
/// mirror the startsWith needles (L33); count-prefix pins the
/// template prefix before the interpolation (L31); empty-tail
/// pins the L30 `!== ""` filter; operator pins mirror the
/// method names (trimStart/startsWith/split/join/length).
/// Facet map (mysql-driver.ts legs): line-split pins newline
/// (L25, L27); comment-needle pins -- (L26); stmt-split pins ;
/// (L28); stmt-count pins 2 (L31); reset-stmt pins the DROP
/// statement (seed L01); create-stmt pins the CREATE statement
/// (seed L02); reset-kind pins DROP TABLE (L33); create-kind
/// pins CREATE TABLE (L33); shape-refusal pins the L34 message;
/// count-prefix pins the L31 template prefix; seed-table pins
/// notes; empty-tail pins the empty filter (L30); comment-trim
/// pins trimStart (L26); starts-with pins startsWith (L26/L33);
/// split-op pins split (L25/L28); join-op pins join (L27);
/// length-guard pins length (L31).
/// The roots-green pin lives in history-014-roots-green.can; the
/// invocation/run shape lives in history-014-run-shape.can.
/// Variants: none (single setup scenario; row lists none).
/// Environment: disposable database named by CAN_TEST_MYSQL_URL
/// (required); requires can-test-mysql-url and bun.
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 360000ms mirrors the Go 6-minute ctx
/// (mysql_test.go L53).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/mysql-seed checks: line-split, comment-needle,
/// stmt-split, stmt-count, reset-stmt, create-stmt, reset-kind,
/// create-kind, shape-refusal, count-prefix, seed-table,
/// empty-tail, comment-trim, starts-with, split-op, join-op,
/// length-guard.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str line_split
    str comment_needle
    str stmt_split
    int stmt_count
    str reset_stmt
    str create_stmt
    str reset_kind
    str create_kind
    str shape_refusal
    str count_prefix
    str seed_table
    str empty_tail
    str comment_trim
    str starts_with
    str split_op
    str join_op
    str length_guard
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-seed", "default", "", "offline"), "line-split" => ok "case history/mysql-seed variant default root line-split run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-seed", "default", "", "offline"), "line-split" => ok evidence("line-split", "true", "true", true, "case history/mysql-seed variant default root line-split run offline")
        different: false, true, context("history/mysql-seed", "default", "", "offline"), "line-split" => failed{"line-split"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/mysql-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "2", "2", true, "case history/mysql-seed variant default root stmt-count run offline")
        different: 3, 2, context("history/mysql-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "\n", "\n", context("history/mysql-seed", "default", "", "offline"), "line-split" => ok evidence("line-split", "\n", "\n", true, "case history/mysql-seed variant default root line-split run offline")
        different: "\n\n", "\n", context("history/mysql-seed", "default", "", "offline"), "line-split" => failed{"line-split"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
