fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h014: "m26-h014" => ok [check("line-split", "seed splits lines on newline"), check("comment-needle", "seed drops dash-dash comment lines"), check("stmt-split", "seed splits statements on semicolon"), check("stmt-count", "seed holds 2 statements"), check("reset-stmt", "reset statement drops notes"), check("create-stmt", "create statement builds notes"), check("reset-kind", "reset starts with DROP TABLE"), check("create-kind", "create starts with CREATE TABLE"), check("shape-refusal", "shape drift refuses setup"), check("count-prefix", "count drift names the saw count"), check("seed-table", "seed targets the notes table"), check("empty-tail", "empty tail parts are dropped"), check("comment-trim", "comment test trims line starts"), check("starts-with", "shape test uses startsWith"), check("split-op", "pipeline splits twice"), check("join-op", "pipeline rejoins lines"), check("length-guard", "count guard reads length")]
        other: "nope" => ok []
    match scope is "m26-h014"
        false => ok []
        true => ok [check("line-split", "seed splits lines on newline"), check("comment-needle", "seed drops dash-dash comment lines"), check("stmt-split", "seed splits statements on semicolon"), check("stmt-count", "seed holds 2 statements"), check("reset-stmt", "reset statement drops notes"), check("create-stmt", "create statement builds notes"), check("reset-kind", "reset starts with DROP TABLE"), check("create-kind", "create starts with CREATE TABLE"), check("shape-refusal", "shape drift refuses setup"), check("count-prefix", "count drift names the saw count"), check("seed-table", "seed targets the notes table"), check("empty-tail", "empty tail parts are dropped"), check("comment-trim", "comment test trims line starts"), check("starts-with", "shape test uses startsWith"), check("split-op", "pipeline splits twice"), check("join-op", "pipeline rejoins lines"), check("length-guard", "count guard reads length")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/mysql-seed" => ok [expected_check("line-split", "\n"), expected_check("comment-needle", "--"), expected_check("stmt-split", ";"), expected_check("stmt-count", "2"), expected_check("reset-stmt", "DROP TABLE IF EXISTS notes"), expected_check("create-stmt", "CREATE TABLE notes (id BIGINT PRIMARY KEY, body VARCHAR(255) UNIQUE)"), expected_check("reset-kind", "DROP TABLE"), expected_check("create-kind", "CREATE TABLE"), expected_check("shape-refusal", "seed file shape changed; refusing to run setup"), expected_check("count-prefix", "seed file must hold 2 statements, saw "), expected_check("seed-table", "notes"), expected_check("empty-tail", ""), expected_check("comment-trim", "trimStart"), expected_check("starts-with", "startsWith"), expected_check("split-op", "split"), expected_check("join-op", "join"), expected_check("length-guard", "length")]
        unknown: "nope" => ok []
    match case is "history/mysql-seed"
        false => ok []
        true => ok [expected_check("line-split", "\n"), expected_check("comment-needle", "--"), expected_check("stmt-split", ";"), expected_check("stmt-count", "2"), expected_check("reset-stmt", "DROP TABLE IF EXISTS notes"), expected_check("create-stmt", "CREATE TABLE notes (id BIGINT PRIMARY KEY, body VARCHAR(255) UNIQUE)"), expected_check("reset-kind", "DROP TABLE"), expected_check("create-kind", "CREATE TABLE"), expected_check("shape-refusal", "seed file shape changed; refusing to run setup"), expected_check("count-prefix", "seed file must hold 2 statements, saw "), expected_check("seed-table", "notes"), expected_check("empty-tail", ""), expected_check("comment-trim", "trimStart"), expected_check("starts-with", "startsWith"), expected_check("split-op", "split"), expected_check("join-op", "join"), expected_check("length-guard", "length")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/mysql-seed", "default", "", "offline") => ok
        seed_line_split: context("history/mysql-seed", "seed-line-split-drift", "", "offline") => failed{"line-split"}
        seed_comment_needle: context("history/mysql-seed", "seed-comment-needle-drift", "", "offline") => failed{"comment-needle"}
        seed_stmt_split: context("history/mysql-seed", "seed-stmt-split-drift", "", "offline") => failed{"stmt-split"}
        seed_stmt_count: context("history/mysql-seed", "seed-stmt-count-drift", "", "offline") => failed{"stmt-count"}
        seed_reset_stmt: context("history/mysql-seed", "seed-reset-stmt-drift", "", "offline") => failed{"reset-stmt"}
        seed_create_stmt: context("history/mysql-seed", "seed-create-stmt-drift", "", "offline") => failed{"create-stmt"}
        seed_reset_kind: context("history/mysql-seed", "seed-reset-kind-drift", "", "offline") => failed{"reset-kind"}
        seed_create_kind: context("history/mysql-seed", "seed-create-kind-drift", "", "offline") => failed{"create-kind"}
        seed_shape_refusal: context("history/mysql-seed", "seed-shape-refusal-drift", "", "offline") => failed{"shape-refusal"}
        seed_count_prefix: context("history/mysql-seed", "seed-count-prefix-drift", "", "offline") => failed{"count-prefix"}
        seed_seed_table: context("history/mysql-seed", "seed-seed-table-drift", "", "offline") => failed{"seed-table"}
        seed_empty_tail: context("history/mysql-seed", "seed-empty-tail-drift", "", "offline") => failed{"empty-tail"}
        seed_comment_trim: context("history/mysql-seed", "seed-comment-trim-drift", "", "offline") => failed{"comment-trim"}
        seed_starts_with: context("history/mysql-seed", "seed-starts-with-drift", "", "offline") => failed{"starts-with"}
        seed_split_op: context("history/mysql-seed", "seed-split-op-drift", "", "offline") => failed{"split-op"}
        seed_join_op: context("history/mysql-seed", "seed-join-op-drift", "", "offline") => failed{"join-op"}
        seed_length_guard: context("history/mysql-seed", "seed-length-guard-drift", "", "offline") => failed{"length-guard"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.line_split, "\n", c, "line-split")
            failed
            ok evidence line_split_evidence => match call require_text(got.comment_needle, "--", c, "comment-needle")
                failed
                ok evidence comment_needle_evidence => match call require_text(got.stmt_split, ";", c, "stmt-split")
                    failed
                    ok evidence stmt_split_evidence => match call require_int(got.stmt_count, 2, c, "stmt-count")
                        failed
                        ok evidence stmt_count_evidence => match call require_text(got.reset_stmt, "DROP TABLE IF EXISTS notes", c, "reset-stmt")
                            failed
                            ok evidence reset_stmt_evidence => match call require_text(got.create_stmt, "CREATE TABLE notes (id BIGINT PRIMARY KEY, body VARCHAR(255) UNIQUE)", c, "create-stmt")
                                failed
                                ok evidence create_stmt_evidence => match call require_text(got.reset_kind, "DROP TABLE", c, "reset-kind")
                                    failed
                                    ok evidence reset_kind_evidence => match call require_text(got.create_kind, "CREATE TABLE", c, "create-kind")
                                        failed
                                        ok evidence create_kind_evidence => match call require_text(got.shape_refusal, "seed file shape changed; refusing to run setup", c, "shape-refusal")
                                            failed
