package m26history016roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-016 "sqlite-driver.ts: version and notes".
/// Source: tests/integration/testdata/sql/sqlite-driver.ts
/// sqlite-driver.ts (L39-43 version and notes probes);
/// executed by tests/integration/sqlite_test.go, which parses
/// the JSON report (L92-97) and requires notes == "0"
/// (L99-101).
/// Disposition: migrate (this row ports sqlite-driver.ts to
/// ordinary Can functions; the old TS script stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the sqlite_version() probe with its
/// row key, empty fallback and refusal; the notes COUNT(*)
/// probe with its row key and -1 fallback; the report key
/// names; and the empty-notes expected-result decision.
/// ADAPTATION (recorded, with source lines): version-fallback
/// pins the L40 ?? "" fallback; count-fallback pins the L43
/// ?? -1 fallback; report keys pin the L43 JSON names, which
/// the Go harness also binds (sqlite_test.go L93-94);
/// notes-empty pins the Go "0" decision (sqlite_test.go L99),
/// not a driver literal.
/// Facet map (sqlite-driver.ts legs): version-query pins the
/// L39 SELECT; version-key pins version (L39-40);
/// version-fallback pins the empty fallback (L40); version-msg
/// pins the L41 refusal; notes-query pins the L42 SELECT;
/// count-key pins count (L42); count-fallback pins -1 (L43);
/// report-version-key pins libraryVersion (L43);
/// report-notes-key pins notes (L43); notes-empty pins the Go
/// zero-notes decision (sqlite_test.go L99); notes-table pins
/// notes (L42).
/// Seed semantics live in history-016-seed-semantics.can; the
/// invocation/run shape lives in history-016-run-shape.can.
/// Variants: none (single setup scenario; row lists none).
/// Environment: disposable SQLite file database plus the fixed
/// seed file; requires can-bun-archive and bun; no CAN_TEST_*
/// URL is read (setup env is PATH/HOME only, sqlite_test.go
/// L87).
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. Accept gates P23/QD1/QD2 are
/// unmet.
/// Descriptor timeout 360000ms mirrors the Go 6-minute ctx
/// (sqlite_test.go L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2
/// unmet).
/// Case history/sqlite-driver-roots checks: version-query,
/// version-key, version-fallback, version-msg, notes-query,
/// count-key, count-fallback, report-version-key,
/// report-notes-key, notes-empty, notes-table.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str version_query
    str version_key
    str version_fallback
    str version_msg
    str notes_query
    str count_key
    int count_fallback
    str report_version_key
    str report_notes_key
    str notes_empty
    str notes_table
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/sqlite-driver-roots", "default", "", "offline"), "version-query" => ok "case history/sqlite-driver-roots variant default root version-query run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/sqlite-driver-roots", "default", "", "offline"), "version-query" => ok evidence("version-query", "true", "true", true, "case history/sqlite-driver-roots variant default root version-query run offline")
        different: false, true, context("history/sqlite-driver-roots", "default", "", "offline"), "version-query" => failed{"version-query"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: -1, -1, context("history/sqlite-driver-roots", "default", "", "offline"), "count-fallback" => ok evidence("count-fallback", "-1", "-1", true, "case history/sqlite-driver-roots variant default root count-fallback run offline")
        different: -2, -1, context("history/sqlite-driver-roots", "default", "", "offline"), "count-fallback" => failed{"count-fallback"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "SELECT sqlite_version() AS version", "SELECT sqlite_version() AS version", context("history/sqlite-driver-roots", "default", "", "offline"), "version-query" => ok evidence("version-query", "SELECT sqlite_version() AS version", "SELECT sqlite_version() AS version", true, "case history/sqlite-driver-roots variant default root version-query run offline")
        different: "SELECT sqlite_version() AS versions", "SELECT sqlite_version() AS version", context("history/sqlite-driver-roots", "default", "", "offline"), "version-query" => failed{"version-query"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        seed_version_query: "seed-version-query-drift" => ok observation("SELECT sqlite_version() AS versions", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        seed_version_key: "seed-version-key-drift" => ok observation("SELECT sqlite_version() AS version", "versions", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        seed_version_fallback: "seed-version-fallback-drift" => ok observation("SELECT sqlite_version() AS version", "version", "?", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        seed_version_msg: "seed-version-msg-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library versions", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        seed_notes_query: "seed-notes-query-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notess", "count", -1, "libraryVersion", "notes", "0", "notes")
        seed_count_key: "seed-count-key-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "counts", -1, "libraryVersion", "notes", "0", "notes")
        seed_count_fallback: "seed-count-fallback-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -2, "libraryVersion", "notes", "0", "notes")
        seed_report_version_key: "seed-report-version-key-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersions", "notes", "0", "notes")
        seed_report_notes_key: "seed-report-notes-key-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notess", "0", "notes")
        seed_notes_empty: "seed-notes-empty-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "1", "notes")
        seed_notes_table: "seed-notes-table-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notess")
    match variant_id
        "seed-version-query-drift" => ok observation("SELECT sqlite_version() AS versions", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        "seed-version-key-drift" => ok observation("SELECT sqlite_version() AS version", "versions", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        "seed-version-fallback-drift" => ok observation("SELECT sqlite_version() AS version", "version", "?", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        "seed-version-msg-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library versions", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
        "seed-notes-query-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notess", "count", -1, "libraryVersion", "notes", "0", "notes")
        "seed-count-key-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "counts", -1, "libraryVersion", "notes", "0", "notes")
        "seed-count-fallback-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -2, "libraryVersion", "notes", "0", "notes")
        "seed-report-version-key-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersions", "notes", "0", "notes")
        "seed-report-notes-key-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notess", "0", "notes")
        "seed-notes-empty-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "1", "notes")
        "seed-notes-table-drift" => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notess")
        _ => ok observation("SELECT sqlite_version() AS version", "version", "", "missing sqlite library version", "SELECT COUNT(*) AS count FROM notes", "count", -1, "libraryVersion", "notes", "0", "notes")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h016: "m26-h016" => ok [check("version-query", "library version query selects sqlite_version"), check("version-key", "version row reads the version key"), check("version-fallback", "missing version row falls back to empty"), check("version-msg", "empty library version refuses setup"), check("notes-query", "notes probe counts rows in notes"), check("count-key", "count row reads the count key"), check("count-fallback", "missing count row falls back to -1"), check("report-version-key", "setup report carries libraryVersion"), check("report-notes-key", "setup report carries notes"), check("notes-empty", "fresh seed reports zero notes"), check("notes-table", "notes probe targets notes")]
        other: "nope" => ok []
    match scope is "m26-h016"
        false => ok []
        true => ok [check("version-query", "library version query selects sqlite_version"), check("version-key", "version row reads the version key"), check("version-fallback", "missing version row falls back to empty"), check("version-msg", "empty library version refuses setup"), check("notes-query", "notes probe counts rows in notes"), check("count-key", "count row reads the count key"), check("count-fallback", "missing count row falls back to -1"), check("report-version-key", "setup report carries libraryVersion"), check("report-notes-key", "setup report carries notes"), check("notes-empty", "fresh seed reports zero notes"), check("notes-table", "notes probe targets notes")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/sqlite-driver-roots" => ok [expected_check("version-query", "SELECT sqlite_version() AS version"), expected_check("version-key", "version"), expected_check("version-fallback", ""), expected_check("version-msg", "missing sqlite library version"), expected_check("notes-query", "SELECT COUNT(*) AS count FROM notes"), expected_check("count-key", "count"), expected_check("count-fallback", "-1"), expected_check("report-version-key", "libraryVersion"), expected_check("report-notes-key", "notes"), expected_check("notes-empty", "0"), expected_check("notes-table", "notes")]
        unknown: "nope" => ok []
    match case is "history/sqlite-driver-roots"
        false => ok []
        true => ok [expected_check("version-query", "SELECT sqlite_version() AS version"), expected_check("version-key", "version"), expected_check("version-fallback", ""), expected_check("version-msg", "missing sqlite library version"), expected_check("notes-query", "SELECT COUNT(*) AS count FROM notes"), expected_check("count-key", "count"), expected_check("count-fallback", "-1"), expected_check("report-version-key", "libraryVersion"), expected_check("report-notes-key", "notes"), expected_check("notes-empty", "0"), expected_check("notes-table", "notes")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/sqlite-driver-roots", "default", "", "offline") => ok
        seed_version_query: context("history/sqlite-driver-roots", "seed-version-query-drift", "", "offline") => failed{"version-query"}
        seed_version_key: context("history/sqlite-driver-roots", "seed-version-key-drift", "", "offline") => failed{"version-key"}
        seed_version_fallback: context("history/sqlite-driver-roots", "seed-version-fallback-drift", "", "offline") => failed{"version-fallback"}
        seed_version_msg: context("history/sqlite-driver-roots", "seed-version-msg-drift", "", "offline") => failed{"version-msg"}
        seed_notes_query: context("history/sqlite-driver-roots", "seed-notes-query-drift", "", "offline") => failed{"notes-query"}
        seed_count_key: context("history/sqlite-driver-roots", "seed-count-key-drift", "", "offline") => failed{"count-key"}
        seed_count_fallback: context("history/sqlite-driver-roots", "seed-count-fallback-drift", "", "offline") => failed{"count-fallback"}
        seed_report_version_key: context("history/sqlite-driver-roots", "seed-report-version-key-drift", "", "offline") => failed{"report-version-key"}
        seed_report_notes_key: context("history/sqlite-driver-roots", "seed-report-notes-key-drift", "", "offline") => failed{"report-notes-key"}
        seed_notes_empty: context("history/sqlite-driver-roots", "seed-notes-empty-drift", "", "offline") => failed{"notes-empty"}
        seed_notes_table: context("history/sqlite-driver-roots", "seed-notes-table-drift", "", "offline") => failed{"notes-table"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.version_query, "SELECT sqlite_version() AS version", c, "version-query")
            failed
            ok evidence version_query_evidence => match call require_text(got.version_key, "version", c, "version-key")
                failed
                ok evidence version_key_evidence => match call require_text(got.version_fallback, "", c, "version-fallback")
                    failed
                    ok evidence version_fallback_evidence => match call require_text(got.version_msg, "missing sqlite library version", c, "version-msg")
                        failed
                        ok evidence version_msg_evidence => match call require_text(got.notes_query, "SELECT COUNT(*) AS count FROM notes", c, "notes-query")
                            failed
                            ok evidence notes_query_evidence => match call require_text(got.count_key, "count", c, "count-key")
                                failed
                                ok evidence count_key_evidence => match call require_int(got.count_fallback, -1, c, "count-fallback")
                                    failed
                                    ok evidence count_fallback_evidence => match call require_text(got.report_version_key, "libraryVersion", c, "report-version-key")
                                        failed
                                        ok evidence report_version_key_evidence => match call require_text(got.report_notes_key, "notes", c, "report-notes-key")
                                            failed
                                            ok evidence report_notes_key_evidence => match call require_text(got.notes_empty, "0", c, "notes-empty")
                                                failed
                                                ok evidence notes_empty_evidence => match call require_text(got.notes_table, "notes", c, "notes-table")
                                                    failed
                                                    ok evidence notes_table_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m26_h016: "m26-h016" => ok test_case("history/sqlite-driver-roots", ["history", "m26"], ["can-bun-archive", "bun"], 360000, [check_ref("version-query"), check_ref("version-key"), check_ref("version-fallback"), check_ref("version-msg"), check_ref("notes-query"), check_ref("count-key"), check_ref("count-fallback"), check_ref("report-version-key"), check_ref("report-notes-key"), check_ref("notes-empty"), check_ref("notes-table")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m26-h016"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/sqlite-driver-roots", ["history", "m26"], ["can-bun-archive", "bun"], 360000, [check_ref("version-query"), check_ref("version-key"), check_ref("version-fallback"), check_ref("version-msg"), check_ref("notes-query"), check_ref("count-key"), check_ref("count-fallback"), check_ref("report-version-key"), check_ref("report-notes-key"), check_ref("notes-empty"), check_ref("notes-table")], callable case_body)
