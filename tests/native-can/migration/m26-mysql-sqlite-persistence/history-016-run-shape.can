package m26history016run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-016 "sqlite-driver.ts: invocation and errors".
/// Source: tests/integration/testdata/sql/sqlite-driver.ts
/// sqlite-driver.ts (L6 import, L14-21 argv and client setup,
/// L45 close, L47-49 catch and exit); invoked by
/// tests/integration/sqlite_test.go as
/// `bun driver setup db seed` (sqlite_test.go L85).
/// Disposition: migrate (this row ports sqlite-driver.ts to
/// ordinary Can functions; the old TS script stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the argv index shape, the setup-only
/// mode gate with its refusal prefix, the two missing-argument
/// refusals, the sqlite client construction, the bun runtime
/// pin, and the failure exit code.
/// ADAPTATION (recorded, with source lines): unknown-mode pins
/// the static template prefix before the interpolated mode
/// (L17); argv pins mirror the process.argv indices (L14-16);
/// sql-runtime pins the L6 import source, matching the Go-side
/// bun launcher (sqlite_test.go L85).
/// Facet map (sqlite-driver.ts legs): argv-mode pins 2 (L14);
/// argv-db pins 3 (L15); argv-seed pins 4 (L16); mode-setup pins
/// setup (L17); unknown-mode pins the L17 refusal prefix;
/// db-missing-msg pins the L18 refusal; seed-missing-msg pins
/// the L19 refusal; sql-adapter pins sqlite (L21);
/// filename-key pins filename (L21); safe-integers pins true
/// (L21); sql-runtime pins bun (L6); error-exit pins 1 (L49).
/// Seed semantics live in history-016-seed-semantics.can; the
/// roots-green pin lives in history-016-roots-green.can.
/// Variants: none (single setup scenario; row lists none).
/// Environment: disposable SQLite file database plus the fixed
/// seed file; requires can-bun-archive and bun; no CAN_TEST_*
/// URL is read (setup env is PATH/HOME only, sqlite_test.go
/// L87).
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. Accept gates P23/QD1/QD2 are
/// unmet.
/// Descriptor timeout 360000ms mirrors the Go 6-minute ctx
/// (sqlite_test.go L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2
/// unmet).
/// Case history/sqlite-driver-run checks: argv-mode, argv-db,
/// argv-seed, mode-setup, unknown-mode, db-missing-msg,
/// seed-missing-msg, sql-adapter, filename-key, safe-integers,
/// sql-runtime, error-exit.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int argv_mode
    int argv_db
    int argv_seed
    str mode_setup
    str unknown_mode
    str db_missing_msg
    str seed_missing_msg
    str sql_adapter
    str filename_key
    bool safe_integers
    str sql_runtime
    int error_exit
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/sqlite-driver-run", "default", "", "offline"), "argv-mode" => ok "case history/sqlite-driver-run variant default root argv-mode run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/sqlite-driver-run", "default", "", "offline"), "argv-mode" => ok evidence("argv-mode", "true", "true", true, "case history/sqlite-driver-run variant default root argv-mode run offline")
        different: false, true, context("history/sqlite-driver-run", "default", "", "offline"), "argv-mode" => failed{"argv-mode"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/sqlite-driver-run", "default", "", "offline"), "argv-mode" => ok evidence("argv-mode", "2", "2", true, "case history/sqlite-driver-run variant default root argv-mode run offline")
        different: 1, 2, context("history/sqlite-driver-run", "default", "", "offline"), "argv-mode" => failed{"argv-mode"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "setup", "setup", context("history/sqlite-driver-run", "default", "", "offline"), "mode-setup" => ok evidence("mode-setup", "setup", "setup", true, "case history/sqlite-driver-run variant default root mode-setup run offline")
        different: "setups", "setup", context("history/sqlite-driver-run", "default", "", "offline"), "mode-setup" => failed{"mode-setup"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        seed_argv_mode: "seed-argv-mode-drift" => ok observation(1, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        seed_argv_db: "seed-argv-db-drift" => ok observation(2, 2, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        seed_argv_seed: "seed-argv-seed-drift" => ok observation(2, 3, 5, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        seed_mode_setup: "seed-mode-setup-drift" => ok observation(2, 3, 4, "setups", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        seed_unknown_mode: "seed-unknown-mode-drift" => ok observation(2, 3, 4, "setup", "unknown modes ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        seed_db_missing_msg: "seed-db-missing-msg-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path arguments", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        seed_seed_missing_msg: "seed-seed-missing-msg-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path arguments", "sqlite", "filename", true, "bun", 1)
        seed_sql_adapter: "seed-sql-adapter-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlites", "filename", true, "bun", 1)
        seed_filename_key: "seed-filename-key-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filenames", true, "bun", 1)
        seed_safe_integers: "seed-safe-integers-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", false, "bun", 1)
        seed_sql_runtime: "seed-sql-runtime-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "buns", 1)
        seed_error_exit: "seed-error-exit-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 0)
    match variant_id
        "seed-argv-mode-drift" => ok observation(1, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        "seed-argv-db-drift" => ok observation(2, 2, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        "seed-argv-seed-drift" => ok observation(2, 3, 5, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        "seed-mode-setup-drift" => ok observation(2, 3, 4, "setups", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        "seed-unknown-mode-drift" => ok observation(2, 3, 4, "setup", "unknown modes ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        "seed-db-missing-msg-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path arguments", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
        "seed-seed-missing-msg-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path arguments", "sqlite", "filename", true, "bun", 1)
        "seed-sql-adapter-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlites", "filename", true, "bun", 1)
        "seed-filename-key-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filenames", true, "bun", 1)
        "seed-safe-integers-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", false, "bun", 1)
        "seed-sql-runtime-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "buns", 1)
        "seed-error-exit-drift" => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 0)
        _ => ok observation(2, 3, 4, "setup", "unknown mode ", "missing database path argument", "missing seed path argument", "sqlite", "filename", true, "bun", 1)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h016: "m26-h016" => ok [check("argv-mode", "mode arrives on argv 2"), check("argv-db", "database path arrives on argv 3"), check("argv-seed", "seed path arrives on argv 4"), check("mode-setup", "setup is the only accepted mode"), check("unknown-mode", "unknown mode refusal names the mode"), check("db-missing-msg", "empty database path refuses"), check("seed-missing-msg", "empty seed path refuses"), check("sql-adapter", "client opens the sqlite adapter"), check("filename-key", "client takes the database filename"), check("safe-integers", "client reads safe integers"), check("sql-runtime", "driver runs on the bun runtime"), check("error-exit", "setup failure exits 1")]
        other: "nope" => ok []
    match scope is "m26-h016"
        false => ok []
        true => ok [check("argv-mode", "mode arrives on argv 2"), check("argv-db", "database path arrives on argv 3"), check("argv-seed", "seed path arrives on argv 4"), check("mode-setup", "setup is the only accepted mode"), check("unknown-mode", "unknown mode refusal names the mode"), check("db-missing-msg", "empty database path refuses"), check("seed-missing-msg", "empty seed path refuses"), check("sql-adapter", "client opens the sqlite adapter"), check("filename-key", "client takes the database filename"), check("safe-integers", "client reads safe integers"), check("sql-runtime", "driver runs on the bun runtime"), check("error-exit", "setup failure exits 1")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/sqlite-driver-run" => ok [expected_check("argv-mode", "2"), expected_check("argv-db", "3"), expected_check("argv-seed", "4"), expected_check("mode-setup", "setup"), expected_check("unknown-mode", "unknown mode "), expected_check("db-missing-msg", "missing database path argument"), expected_check("seed-missing-msg", "missing seed path argument"), expected_check("sql-adapter", "sqlite"), expected_check("filename-key", "filename"), expected_check("safe-integers", "true"), expected_check("sql-runtime", "bun"), expected_check("error-exit", "1")]
        unknown: "nope" => ok []
    match case is "history/sqlite-driver-run"
        false => ok []
        true => ok [expected_check("argv-mode", "2"), expected_check("argv-db", "3"), expected_check("argv-seed", "4"), expected_check("mode-setup", "setup"), expected_check("unknown-mode", "unknown mode "), expected_check("db-missing-msg", "missing database path argument"), expected_check("seed-missing-msg", "missing seed path argument"), expected_check("sql-adapter", "sqlite"), expected_check("filename-key", "filename"), expected_check("safe-integers", "true"), expected_check("sql-runtime", "bun"), expected_check("error-exit", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/sqlite-driver-run", "default", "", "offline") => ok
        seed_argv_mode: context("history/sqlite-driver-run", "seed-argv-mode-drift", "", "offline") => failed{"argv-mode"}
        seed_argv_db: context("history/sqlite-driver-run", "seed-argv-db-drift", "", "offline") => failed{"argv-db"}
        seed_argv_seed: context("history/sqlite-driver-run", "seed-argv-seed-drift", "", "offline") => failed{"argv-seed"}
        seed_mode_setup: context("history/sqlite-driver-run", "seed-mode-setup-drift", "", "offline") => failed{"mode-setup"}
        seed_unknown_mode: context("history/sqlite-driver-run", "seed-unknown-mode-drift", "", "offline") => failed{"unknown-mode"}
        seed_db_missing_msg: context("history/sqlite-driver-run", "seed-db-missing-msg-drift", "", "offline") => failed{"db-missing-msg"}
        seed_seed_missing_msg: context("history/sqlite-driver-run", "seed-seed-missing-msg-drift", "", "offline") => failed{"seed-missing-msg"}
        seed_sql_adapter: context("history/sqlite-driver-run", "seed-sql-adapter-drift", "", "offline") => failed{"sql-adapter"}
        seed_filename_key: context("history/sqlite-driver-run", "seed-filename-key-drift", "", "offline") => failed{"filename-key"}
        seed_safe_integers: context("history/sqlite-driver-run", "seed-safe-integers-drift", "", "offline") => failed{"safe-integers"}
        seed_sql_runtime: context("history/sqlite-driver-run", "seed-sql-runtime-drift", "", "offline") => failed{"sql-runtime"}
        seed_error_exit: context("history/sqlite-driver-run", "seed-error-exit-drift", "", "offline") => failed{"error-exit"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.argv_mode, 2, c, "argv-mode")
            failed
            ok evidence argv_mode_evidence => match call require_int(got.argv_db, 3, c, "argv-db")
                failed
                ok evidence argv_db_evidence => match call require_int(got.argv_seed, 4, c, "argv-seed")
                    failed
                    ok evidence argv_seed_evidence => match call require_text(got.mode_setup, "setup", c, "mode-setup")
                        failed
                        ok evidence mode_setup_evidence => match call require_text(got.unknown_mode, "unknown mode ", c, "unknown-mode")
                            failed
                            ok evidence unknown_mode_evidence => match call require_text(got.db_missing_msg, "missing database path argument", c, "db-missing-msg")
                                failed
                                ok evidence db_missing_msg_evidence => match call require_text(got.seed_missing_msg, "missing seed path argument", c, "seed-missing-msg")
                                    failed
                                    ok evidence seed_missing_msg_evidence => match call require_text(got.sql_adapter, "sqlite", c, "sql-adapter")
                                        failed
                                        ok evidence sql_adapter_evidence => match call require_text(got.filename_key, "filename", c, "filename-key")
                                            failed
                                            ok evidence filename_key_evidence => match call require_bool(got.safe_integers, true, c, "safe-integers")
                                                failed
                                                ok evidence safe_integers_evidence => match call require_text(got.sql_runtime, "bun", c, "sql-runtime")
                                                    failed
                                                    ok evidence sql_runtime_evidence => match call require_int(got.error_exit, 1, c, "error-exit")
                                                        failed
                                                        ok evidence error_exit_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m26_h016: "m26-h016" => ok test_case("history/sqlite-driver-run", ["history", "m26"], ["can-bun-archive", "bun"], 360000, [check_ref("argv-mode"), check_ref("argv-db"), check_ref("argv-seed"), check_ref("mode-setup"), check_ref("unknown-mode"), check_ref("db-missing-msg"), check_ref("seed-missing-msg"), check_ref("sql-adapter"), check_ref("filename-key"), check_ref("safe-integers"), check_ref("sql-runtime"), check_ref("error-exit")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m26-h016"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/sqlite-driver-run", ["history", "m26"], ["can-bun-archive", "bun"], 360000, [check_ref("argv-mode"), check_ref("argv-db"), check_ref("argv-seed"), check_ref("mode-setup"), check_ref("unknown-mode"), check_ref("db-missing-msg"), check_ref("seed-missing-msg"), check_ref("sql-adapter"), check_ref("filename-key"), check_ref("safe-integers"), check_ref("sql-runtime"), check_ref("error-exit")], callable case_body)
