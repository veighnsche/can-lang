package m26history016seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-016 "sqlite-driver.ts: seed split and shape".
/// Source: tests/integration/testdata/sql/sqlite-driver.ts
/// sqlite-driver.ts (L23-35 split and shape gates); seed bytes
/// from tests/integration/testdata/sql/sqlite-seed.sql (L1-2);
/// executed by tests/integration/sqlite_test.go via
/// `bun driver setup db seed` (sqlite_test.go L85).
/// Disposition: migrate (this row ports sqlite-driver.ts to
/// ordinary Can functions; the old TS script stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the seed split algorithm (newline
/// split, dash-comment filter, newline join, semicolon split,
/// trim, empty-part filter), the two-statement count gate with
/// its refusal prefix, the kind-ordered DROP/CREATE gates with
/// the shape refusal, and the two replayed seed statements.
/// ADAPTATION (recorded, with source lines): count-msg pins the
/// static template prefix before the interpolated seen count
/// (L31); reset-stmt/create-stmt pin the trimmed post-split
/// statements (semicolons stripped by the L28 split), not the
/// raw seed lines; seed-table pins the notes name threaded
/// through seed and probe (seed L1-2, driver L42).
/// Facet map (sqlite-driver.ts legs): split-lines pins the L25
/// newline needle; comment-needle pins -- (L26); join-lines pins
/// the L27 newline needle; split-stmt pins ; (L28); empty-part
/// pins the L30 filter needle; stmt-count pins 2 (L31);
/// count-msg pins the L31 refusal prefix; reset-kind pins
/// DROP TABLE (L33); create-kind pins CREATE TABLE (L33);
/// shape-msg pins the L34 refusal; reset-stmt pins the seed L1
/// drop replay; create-stmt pins the seed L2 fixture replay;
/// seed-table pins notes (seed L1-2).
/// The roots-green pin lives in history-016-roots-green.can;
/// the invocation/run shape lives in history-016-run-shape.can.
/// Variants: none (single setup scenario; row lists none).
/// Environment: disposable SQLite file database plus the fixed
/// seed file; requires can-bun-archive and bun; no CAN_TEST_*
/// URL is read (setup env is PATH/HOME only, sqlite_test.go
/// L87). HISTORY-021 owns the seed file itself; this row pins
/// only the two statements the driver contract replays.
/// Logical gates SUITE/CAN/DB/WORK and C/R/N/S/A identities
/// bind at P23; no live run now. Accept gates P23/QD1/QD2 are
/// unmet.
/// Descriptor timeout 360000ms mirrors the Go 6-minute ctx
/// (sqlite_test.go L50).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2
/// unmet).
/// Case history/sqlite-driver-seed checks: split-lines,
/// comment-needle, join-lines, split-stmt, empty-part,
/// stmt-count, count-msg, reset-kind, create-kind, shape-msg,
/// reset-stmt, create-stmt, seed-table.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str split_lines
    str comment_needle
    str join_lines
    str split_stmt
    str empty_part
    int stmt_count
    str count_msg
    str reset_kind
    str create_kind
    str shape_msg
    str reset_stmt
    str create_stmt
    str seed_table
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/sqlite-driver-seed", "default", "", "offline"), "split-lines" => ok "case history/sqlite-driver-seed variant default root split-lines run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/sqlite-driver-seed", "default", "", "offline"), "split-lines" => ok evidence("split-lines", "true", "true", true, "case history/sqlite-driver-seed variant default root split-lines run offline")
        different: false, true, context("history/sqlite-driver-seed", "default", "", "offline"), "split-lines" => failed{"split-lines"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/sqlite-driver-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "2", "2", true, "case history/sqlite-driver-seed variant default root stmt-count run offline")
        different: 3, 2, context("history/sqlite-driver-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "\n", "\n", context("history/sqlite-driver-seed", "default", "", "offline"), "split-lines" => ok evidence("split-lines", "\n", "\n", true, "case history/sqlite-driver-seed variant default root split-lines run offline")
        different: "\n\n", "\n", context("history/sqlite-driver-seed", "default", "", "offline"), "split-lines" => failed{"split-lines"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
