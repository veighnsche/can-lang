    emits {}
    given
        str case
    asserts
        known: "history/sqlite-driver-seed" => ok [expected_check("split-lines", "\n"), expected_check("comment-needle", "--"), expected_check("join-lines", "\n"), expected_check("split-stmt", ";"), expected_check("empty-part", ""), expected_check("stmt-count", "2"), expected_check("count-msg", "seed file must hold 2 statements, saw "), expected_check("reset-kind", "DROP TABLE"), expected_check("create-kind", "CREATE TABLE"), expected_check("shape-msg", "seed file shape changed; refusing to run setup"), expected_check("reset-stmt", "DROP TABLE IF EXISTS notes"), expected_check("create-stmt", "CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT UNIQUE)"), expected_check("seed-table", "notes")]
        unknown: "nope" => ok []
    match case is "history/sqlite-driver-seed"
        false => ok []
        true => ok [expected_check("split-lines", "\n"), expected_check("comment-needle", "--"), expected_check("join-lines", "\n"), expected_check("split-stmt", ";"), expected_check("empty-part", ""), expected_check("stmt-count", "2"), expected_check("count-msg", "seed file must hold 2 statements, saw "), expected_check("reset-kind", "DROP TABLE"), expected_check("create-kind", "CREATE TABLE"), expected_check("shape-msg", "seed file shape changed; refusing to run setup"), expected_check("reset-stmt", "DROP TABLE IF EXISTS notes"), expected_check("create-stmt", "CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT UNIQUE)"), expected_check("seed-table", "notes")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/sqlite-driver-seed", "default", "", "offline") => ok
        seed_split_lines: context("history/sqlite-driver-seed", "seed-split-lines-drift", "", "offline") => failed{"split-lines"}
        seed_comment_needle: context("history/sqlite-driver-seed", "seed-comment-needle-drift", "", "offline") => failed{"comment-needle"}
        seed_join_lines: context("history/sqlite-driver-seed", "seed-join-lines-drift", "", "offline") => failed{"join-lines"}
        seed_split_stmt: context("history/sqlite-driver-seed", "seed-split-stmt-drift", "", "offline") => failed{"split-stmt"}
        seed_empty_part: context("history/sqlite-driver-seed", "seed-empty-part-drift", "", "offline") => failed{"empty-part"}
        seed_stmt_count: context("history/sqlite-driver-seed", "seed-stmt-count-drift", "", "offline") => failed{"stmt-count"}
        seed_count_msg: context("history/sqlite-driver-seed", "seed-count-msg-drift", "", "offline") => failed{"count-msg"}
        seed_reset_kind: context("history/sqlite-driver-seed", "seed-reset-kind-drift", "", "offline") => failed{"reset-kind"}
        seed_create_kind: context("history/sqlite-driver-seed", "seed-create-kind-drift", "", "offline") => failed{"create-kind"}
        seed_shape_msg: context("history/sqlite-driver-seed", "seed-shape-msg-drift", "", "offline") => failed{"shape-msg"}
        seed_reset_stmt: context("history/sqlite-driver-seed", "seed-reset-stmt-drift", "", "offline") => failed{"reset-stmt"}
        seed_create_stmt: context("history/sqlite-driver-seed", "seed-create-stmt-drift", "", "offline") => failed{"create-stmt"}
        seed_seed_table: context("history/sqlite-driver-seed", "seed-seed-table-drift", "", "offline") => failed{"seed-table"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.split_lines, "\n", c, "split-lines")
            failed
            ok evidence split_lines_evidence => match call require_text(got.comment_needle, "--", c, "comment-needle")
                failed
                ok evidence comment_needle_evidence => match call require_text(got.join_lines, "\n", c, "join-lines")
                    failed
                    ok evidence join_lines_evidence => match call require_text(got.split_stmt, ";", c, "split-stmt")
                        failed
                        ok evidence split_stmt_evidence => match call require_text(got.empty_part, "", c, "empty-part")
                            failed
                            ok evidence empty_part_evidence => match call require_int(got.stmt_count, 2, c, "stmt-count")
                                failed
                                ok evidence stmt_count_evidence => match call require_text(got.count_msg, "seed file must hold 2 statements, saw ", c, "count-msg")
                                    failed
                                    ok evidence count_msg_evidence => match call require_text(got.reset_kind, "DROP TABLE", c, "reset-kind")
                                        failed
                                        ok evidence reset_kind_evidence => match call require_text(got.create_kind, "CREATE TABLE", c, "create-kind")
                                            failed
                                            ok evidence create_kind_evidence => match call require_text(got.shape_msg, "seed file shape changed; refusing to run setup", c, "shape-msg")
                                                failed
                                                ok evidence shape_msg_evidence => match call require_text(got.reset_stmt, "DROP TABLE IF EXISTS notes", c, "reset-stmt")
                                                    failed
                                                    ok evidence reset_stmt_evidence => match call require_text(got.create_stmt, "CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT UNIQUE)", c, "create-stmt")
                                                        failed
                                                        ok evidence create_stmt_evidence => match call require_text(got.seed_table, "notes", c, "seed-table")
                                                            failed
                                                            ok evidence seed_table_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m26_h016: "m26-h016" => ok test_case("history/sqlite-driver-seed", ["history", "m26"], ["can-bun-archive", "bun"], 360000, [check_ref("split-lines"), check_ref("comment-needle"), check_ref("join-lines"), check_ref("split-stmt"), check_ref("empty-part"), check_ref("stmt-count"), check_ref("count-msg"), check_ref("reset-kind"), check_ref("create-kind"), check_ref("shape-msg"), check_ref("reset-stmt"), check_ref("create-stmt"), check_ref("seed-table")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m26-h016"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/sqlite-driver-seed", ["history", "m26"], ["can-bun-archive", "bun"], 360000, [check_ref("split-lines"), check_ref("comment-needle"), check_ref("join-lines"), check_ref("split-stmt"), check_ref("empty-part"), check_ref("stmt-count"), check_ref("count-msg"), check_ref("reset-kind"), check_ref("create-kind"), check_ref("shape-msg"), check_ref("reset-stmt"), check_ref("create-stmt"), check_ref("seed-table")], callable case_body)
