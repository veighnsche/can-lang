fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h016: "m26-h016" => ok [check("split-lines", "seed text splits into lines on newline"), check("comment-needle", "comment lines start with double dash"), check("join-lines", "kept lines rejoin on newline"), check("split-stmt", "seed text splits into statements on semicolon"), check("empty-part", "empty parts filter out"), check("stmt-count", "seed file must hold 2 statements"), check("count-msg", "count refusal names the seen count"), check("reset-kind", "first statement is the DROP TABLE reset"), check("create-kind", "second statement is the CREATE TABLE fixture"), check("shape-msg", "shape refusal stops setup"), check("reset-stmt", "reset replays the seed drop"), check("create-stmt", "create replays the seed fixture"), check("seed-table", "seed fixture targets notes")]
        other: "nope" => ok []
    match scope is "m26-h016"
        false => ok []
        true => ok [check("split-lines", "seed text splits into lines on newline"), check("comment-needle", "comment lines start with double dash"), check("join-lines", "kept lines rejoin on newline"), check("split-stmt", "seed text splits into statements on semicolon"), check("empty-part", "empty parts filter out"), check("stmt-count", "seed file must hold 2 statements"), check("count-msg", "count refusal names the seen count"), check("reset-kind", "first statement is the DROP TABLE reset"), check("create-kind", "second statement is the CREATE TABLE fixture"), check("shape-msg", "shape refusal stops setup"), check("reset-stmt", "reset replays the seed drop"), check("create-stmt", "create replays the seed fixture"), check("seed-table", "seed fixture targets notes")]
