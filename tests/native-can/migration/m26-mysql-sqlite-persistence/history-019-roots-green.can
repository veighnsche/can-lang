        known: "history/mysql-seed-schema" => ok [expected_check("schema-table", "notes"), expected_check("column-count", "2"), expected_check("id-column", "id"), expected_check("body-column", "body"), expected_check("id-type", "BIGINT"), expected_check("body-type", "VARCHAR(255)"), expected_check("id-key", "PRIMARY KEY"), expected_check("body-key", "UNIQUE"), expected_check("id-def", "id BIGINT PRIMARY KEY"), expected_check("body-def", "body VARCHAR(255) UNIQUE"), expected_check("column-list", "id BIGINT PRIMARY KEY, body VARCHAR(255) UNIQUE"), expected_check("col-sep", ", "), expected_check("varchar-width", "255"), expected_check("def-open", "("), expected_check("def-close", ")"), expected_check("starting-notes", "0"), expected_check("seed-rows", "")]
        unknown: "nope" => ok []
    match case is "history/mysql-seed-schema"
        false => ok []
        true => ok [expected_check("schema-table", "notes"), expected_check("column-count", "2"), expected_check("id-column", "id"), expected_check("body-column", "body"), expected_check("id-type", "BIGINT"), expected_check("body-type", "VARCHAR(255)"), expected_check("id-key", "PRIMARY KEY"), expected_check("body-key", "UNIQUE"), expected_check("id-def", "id BIGINT PRIMARY KEY"), expected_check("body-def", "body VARCHAR(255) UNIQUE"), expected_check("column-list", "id BIGINT PRIMARY KEY, body VARCHAR(255) UNIQUE"), expected_check("col-sep", ", "), expected_check("varchar-width", "255"), expected_check("def-open", "("), expected_check("def-close", ")"), expected_check("starting-notes", "0"), expected_check("seed-rows", "")]
