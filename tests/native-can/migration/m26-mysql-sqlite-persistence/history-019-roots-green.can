fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h019: "m26-h019" => ok [check("schema-table", "schema builds the notes table"), check("column-count", "notes holds 2 columns"), check("id-column", "first column is id"), check("body-column", "second column is body"), check("id-type", "id pins BIGINT"), check("body-type", "body pins VARCHAR 255"), check("id-key", "id pins PRIMARY KEY"), check("body-key", "body pins UNIQUE"), check("id-def", "id definition is verbatim"), check("body-def", "body definition is verbatim"), check("column-list", "column list is verbatim"), check("col-sep", "columns split on comma space"), check("varchar-width", "body width pins 255"), check("def-open", "column list opens with paren"), check("def-close", "column list closes with paren"), check("starting-notes", "seed leaves zero notes"), check("seed-rows", "seed carries no row values")]
        other: "nope" => ok []
    match scope is "m26-h019"
        false => ok []
        true => ok [check("schema-table", "schema builds the notes table"), check("column-count", "notes holds 2 columns"), check("id-column", "first column is id"), check("body-column", "second column is body"), check("id-type", "id pins BIGINT"), check("body-type", "body pins VARCHAR 255"), check("id-key", "id pins PRIMARY KEY"), check("body-key", "body pins UNIQUE"), check("id-def", "id definition is verbatim"), check("body-def", "body definition is verbatim"), check("column-list", "column list is verbatim"), check("col-sep", "columns split on comma space"), check("varchar-width", "body width pins 255"), check("def-open", "column list opens with paren"), check("def-close", "column list closes with paren"), check("starting-notes", "seed leaves zero notes"), check("seed-rows", "seed carries no row values")]
