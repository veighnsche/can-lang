package m26history019roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-019 "mysql-seed.sql: schema and starting rows".
/// Source: tests/integration/testdata/sql/mysql-seed.sql
/// (L02 CREATE leg); named consumer
/// tests/integration/testdata/sql/mysql-driver.ts (setup
/// mode applies both statements, then reports serverVersion
/// and the notes count).
/// Disposition: retain_fixture (this row keeps the fixture
/// as data plus Can accountability pins; the .sql file stays
/// and no driver is ported or deleted here).
/// Protects (this file): the notes schema (table, columns,
/// types, keys, verbatim definitions), the definition shape,
/// and the starting-state assumption (zero notes, no seed
/// row values).
/// ADAPTATION (recorded, with source bytes): id-def,
/// body-def and column-list pin verbatim definition text from
/// seed L02; col-sep pins the comma-space splitter;
/// varchar-width pins int 255 from VARCHAR(255); starting-
/// notes pins int 0 (empty schema, no INSERTs; the Go harness
/// expects the 0 spelling); seed-rows pins empty (the file
/// carries no row values).
/// Facet map (mysql-seed.sql schema): schema-table pins
/// notes; column-count pins 2; id-column pins id;
/// body-column pins body; id-type pins BIGINT; body-type pins
/// VARCHAR(255); id-key pins PRIMARY KEY; body-key pins
/// UNIQUE; id-def pins the id definition; body-def pins the
/// body definition; column-list pins the paren body;
/// col-sep pins comma-space; varchar-width pins 255;
/// def-open pins (; def-close pins ); starting-notes pins 0;
/// seed-rows pins empty.
/// Statement bytes live in history-019-seed-semantics.can;
/// the fixture identity lives in history-019-run-shape.can.
/// Variants: none (row lists none).
/// Environment: none (row lists no gates); requires [] and no
/// database contact.
/// Logical gates SUITE/CAN and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 60000ms is an offline static-check
/// budget; the row has no live leg and no Go ctx to mirror.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/mysql-seed-schema checks: schema-table,
/// column-count, id-column, body-column, id-type, body-type,
/// id-key, body-key, id-def, body-def, column-list, col-sep,
/// varchar-width, def-open, def-close, starting-notes,
/// seed-rows.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str schema_table
    int column_count
    str id_column
    str body_column
    str id_type
    str body_type
    str id_key
    str body_key
    str id_def
    str body_def
    str column_list
    str col_sep
    int varchar_width
    str def_open
    str def_close
    int starting_notes
    str seed_rows
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-seed-schema", "default", "", "offline"), "schema-table" => ok "case history/mysql-seed-schema variant default root schema-table run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-seed-schema", "default", "", "offline"), "schema-table" => ok evidence("schema-table", "true", "true", true, "case history/mysql-seed-schema variant default root schema-table run offline")
        different: false, true, context("history/mysql-seed-schema", "default", "", "offline"), "schema-table" => failed{"schema-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/mysql-seed-schema", "default", "", "offline"), "column-count" => ok evidence("column-count", "2", "2", true, "case history/mysql-seed-schema variant default root column-count run offline")
        different: 3, 2, context("history/mysql-seed-schema", "default", "", "offline"), "column-count" => failed{"column-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "notes", "notes", context("history/mysql-seed-schema", "default", "", "offline"), "schema-table" => ok evidence("schema-table", "notes", "notes", true, "case history/mysql-seed-schema variant default root schema-table run offline")
        different: "notess", "notes", context("history/mysql-seed-schema", "default", "", "offline"), "schema-table" => failed{"schema-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
