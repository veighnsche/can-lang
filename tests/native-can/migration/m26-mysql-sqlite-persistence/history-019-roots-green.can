                                                        failed
                                                        ok evidence col_sep_evidence => match call require_int(got.varchar_width, 255, c, "varchar-width")
                                                            failed
                                                            ok evidence varchar_width_evidence => match call require_text(got.def_open, "(", c, "def-open")
                                                                failed
                                                                ok evidence def_open_evidence => match call require_text(got.def_close, ")", c, "def-close")
                                                                    failed
                                                                    ok evidence def_close_evidence => match call require_int(got.starting_notes, 0, c, "starting-notes")
                                                                        failed
                                                                        ok evidence starting_notes_evidence => match call require_text(got.seed_rows, "", c, "seed-rows")
                                                                            failed
                                                                            ok evidence seed_rows_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m26_h019: "m26-h019" => ok test_case("history/mysql-seed-schema", ["history", "m26"], [], 60000, [check_ref("schema-table"), check_ref("column-count"), check_ref("id-column"), check_ref("body-column"), check_ref("id-type"), check_ref("body-type"), check_ref("id-key"), check_ref("body-key"), check_ref("id-def"), check_ref("body-def"), check_ref("column-list"), check_ref("col-sep"), check_ref("varchar-width"), check_ref("def-open"), check_ref("def-close"), check_ref("starting-notes"), check_ref("seed-rows")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
