package m26history019run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-019 "mysql-seed.sql: fixture identity".
/// Source: tests/integration/testdata/sql/mysql-seed.sql
/// (fixture bytes); named consumer
/// tests/integration/testdata/sql/mysql-driver.ts (setup
/// mode applies both statements, then reports serverVersion
/// and the notes count).
/// Disposition: retain_fixture (this row keeps the fixture
/// as data plus Can accountability pins; the .sql file stays
/// and no driver is ported or deleted here).
/// Protects (this file): the fixture identity (path, file,
/// dialect), the named consumer endpoint (driver, setup mode,
/// seed arg), and the consumed byte layout (terminator
/// counts, line spans, statement offsets).
/// ADAPTATION (recorded, with source bytes): fixture-path,
/// fixture-dir, fixture-file and fixture-suffix pin the
/// checked-in path; consumer-file, consumer-mode and seed-var
/// pin the driver endpoint (setup mode, argv seed path);
/// apply-count pins the driver [reset, create] pair length;
/// reset-line-bytes (28) and create-line-bytes (70) pin the
/// newline-inclusive line spans (28 + 70 = 98); reset-offset
/// (0) and create-offset (28) pin the statement byte offsets;
/// fixture-dialect pins mysql (BIGINT, not sqlite INTEGER).
/// Facet map (fixture identity): fixture-path pins the seed
/// path; fixture-dir pins the sql dir; fixture-file pins
/// mysql-seed.sql; fixture-suffix pins .sql; consumer-file
/// pins mysql-driver.ts; consumer-mode pins setup; seed-var
/// pins seedPath; apply-count pins 2; semicolon-count pins 2;
/// newline-count pins 2; table-refs pins 2; reset-line-bytes
/// pins 28; create-line-bytes pins 70; reset-offset pins 0;
/// create-offset pins 28; table-word pins TABLE;
/// fixture-dialect pins mysql.
/// Statement bytes live in history-019-seed-semantics.can;
/// the schema pin lives in history-019-roots-green.can.
/// Variants: none (row lists none).
/// Environment: none (row lists no gates); requires [] and no
/// database contact.
/// Logical gates SUITE/CAN and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 60000ms is an offline static-check
/// budget; the row has no live leg and no Go ctx to mirror.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/mysql-seed-run checks: fixture-path,
/// fixture-dir, fixture-file, fixture-suffix, consumer-file,
/// consumer-mode, seed-var, apply-count, semicolon-count,
/// newline-count, table-refs, reset-line-bytes,
/// create-line-bytes, reset-offset, create-offset,
/// table-word, fixture-dialect.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str fixture_path
    str fixture_dir
    str fixture_file
    str fixture_suffix
    str consumer_file
    str consumer_mode
    str seed_var
    int apply_count
    int semicolon_count
    int newline_count
    int table_refs
    int reset_line_bytes
    int create_line_bytes
    int reset_offset
    int create_offset
    str table_word
    str fixture_dialect
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-seed-run", "default", "", "offline"), "fixture-path" => ok "case history/mysql-seed-run variant default root fixture-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-seed-run", "default", "", "offline"), "fixture-path" => ok evidence("fixture-path", "true", "true", true, "case history/mysql-seed-run variant default root fixture-path run offline")
        different: false, true, context("history/mysql-seed-run", "default", "", "offline"), "fixture-path" => failed{"fixture-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/mysql-seed-run", "default", "", "offline"), "apply-count" => ok evidence("apply-count", "2", "2", true, "case history/mysql-seed-run variant default root apply-count run offline")
        different: 3, 2, context("history/mysql-seed-run", "default", "", "offline"), "apply-count" => failed{"apply-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "mysql-seed.sql", "mysql-seed.sql", context("history/mysql-seed-run", "default", "", "offline"), "fixture-file" => ok evidence("fixture-file", "mysql-seed.sql", "mysql-seed.sql", true, "case history/mysql-seed-run variant default root fixture-file run offline")
        different: "mysql-seed2.sql", "mysql-seed.sql", context("history/mysql-seed-run", "default", "", "offline"), "fixture-file" => failed{"fixture-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
