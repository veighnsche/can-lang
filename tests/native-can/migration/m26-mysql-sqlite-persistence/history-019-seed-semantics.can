    emits {}
    given
        str scope
    asserts
        m26_h019: "m26-h019" => ok [check("stmt-count", "seed holds 2 statements"), check("line-count", "seed holds 2 lines"), check("byte-count", "seed is 98 bytes"), check("seed-md5", "seed md5 pins all bytes"), check("reset-line", "reset line drops notes verbatim"), check("create-line", "create line builds notes verbatim"), check("stmt-order", "reset applies before create"), check("stmt-term", "statements end with semicolon"), check("line-term", "lines end with newline"), check("trailing-newline", "file ends with newline"), check("reset-kind", "reset starts with DROP TABLE"), check("create-kind", "create starts with CREATE TABLE"), check("seed-table", "seed targets the notes table"), check("if-exists", "reset keeps IF EXISTS"), check("insert-count", "seed holds no INSERT rows"), check("drop-count", "seed holds 1 DROP"), check("create-count", "seed holds 1 CREATE")]
        other: "nope" => ok []
    match scope is "m26-h019"
        false => ok []
        true => ok [check("stmt-count", "seed holds 2 statements"), check("line-count", "seed holds 2 lines"), check("byte-count", "seed is 98 bytes"), check("seed-md5", "seed md5 pins all bytes"), check("reset-line", "reset line drops notes verbatim"), check("create-line", "create line builds notes verbatim"), check("stmt-order", "reset applies before create"), check("stmt-term", "statements end with semicolon"), check("line-term", "lines end with newline"), check("trailing-newline", "file ends with newline"), check("reset-kind", "reset starts with DROP TABLE"), check("create-kind", "create starts with CREATE TABLE"), check("seed-table", "seed targets the notes table"), check("if-exists", "reset keeps IF EXISTS"), check("insert-count", "seed holds no INSERT rows"), check("drop-count", "seed holds 1 DROP"), check("create-count", "seed holds 1 CREATE")]
