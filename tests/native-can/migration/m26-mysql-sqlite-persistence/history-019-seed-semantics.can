package m26history019seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-019 "mysql-seed.sql: statement bytes".
/// Source: tests/integration/testdata/sql/mysql-seed.sql
/// (L01-02, 98 bytes); named consumer
/// tests/integration/testdata/sql/mysql-driver.ts (setup
/// mode applies both statements, then reports serverVersion
/// and the notes count).
/// Disposition: retain_fixture (this row keeps the fixture
/// as data plus Can accountability pins; the .sql file stays
/// and no driver is ported or deleted here).
/// Protects (this file): the verbatim statement bytes (count,
/// order, exact line text), the terminators, the byte/md5
/// identity, the statement kinds, and the no-DML shape.
/// ADAPTATION (recorded, with source bytes): reset-line and
/// create-line pin the raw fixture lines WITH their semicolon
/// terminators (HISTORY-014 pins the post-split trimmed forms
/// without them); stmt-order pins the apply order verified by
/// splitting live bytes on semicolon (DROP first, CREATE
/// second); line-term pins the newline needle; byte-count and
/// seed-md5 pin the whole-file identity (98 bytes, md5
/// 7e3688a2854cee363394c6e9e7f9d83e); trailing-newline pins
/// the final newline; insert-count pins zero INSERTs.
/// Facet map (mysql-seed.sql bytes): stmt-count pins 2 (L01
/// plus L02); line-count pins 2; byte-count pins 98;
/// seed-md5 pins the file md5; reset-line pins L01 verbatim;
/// create-line pins L02 verbatim; stmt-order pins
/// reset-then-create; stmt-term pins ; (x2); line-term pins
/// newline (x2); trailing-newline pins true; reset-kind pins
/// DROP TABLE; create-kind pins CREATE TABLE; seed-table pins
/// notes; if-exists pins IF EXISTS; insert-count pins 0;
/// drop-count pins 1; create-count pins 1.
/// The schema pin lives in history-019-roots-green.can; the
/// fixture identity lives in history-019-run-shape.can.
/// Variants: none (row lists none).
/// Environment: none (row lists no gates); requires [] and no
/// database contact.
/// Logical gates SUITE/CAN and C/R/N/S/A identities bind at
/// P23; no live run now. Accept gates P23/QD1/QD2 are unmet.
/// Descriptor timeout 60000ms is an offline static-check
/// budget; the row has no live leg and no Go ctx to mirror.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23/QD1/QD2 unmet).
/// Case history/mysql-seed-file checks: stmt-count,
/// line-count, byte-count, seed-md5, reset-line, create-line,
/// stmt-order, stmt-term, line-term, trailing-newline,
/// reset-kind, create-kind, seed-table, if-exists,
/// insert-count, drop-count, create-count.
/// Shared old files untouched; retirement is a later integrator decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int stmt_count
    int line_count
    int byte_count
    str seed_md5
    str reset_line
    str create_line
    str stmt_order
    str stmt_term
    str line_term
    bool trailing_newline
    str reset_kind
    str create_kind
    str seed_table
    str if_exists
    int insert_count
    int drop_count
    int create_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/mysql-seed-file", "default", "", "offline"), "stmt-count" => ok "case history/mysql-seed-file variant default root stmt-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/mysql-seed-file", "default", "", "offline"), "trailing-newline" => ok evidence("trailing-newline", "true", "true", true, "case history/mysql-seed-file variant default root trailing-newline run offline")
        different: false, true, context("history/mysql-seed-file", "default", "", "offline"), "trailing-newline" => failed{"trailing-newline"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/mysql-seed-file", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "2", "2", true, "case history/mysql-seed-file variant default root stmt-count run offline")
        different: 3, 2, context("history/mysql-seed-file", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: ";", ";", context("history/mysql-seed-file", "default", "", "offline"), "stmt-term" => ok evidence("stmt-term", ";", ";", true, "case history/mysql-seed-file variant default root stmt-term run offline")
        different: ";;", ";", context("history/mysql-seed-file", "default", "", "offline"), "stmt-term" => failed{"stmt-term"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
