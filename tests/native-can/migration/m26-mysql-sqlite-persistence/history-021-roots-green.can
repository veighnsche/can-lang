package m26history021roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-021 "sqlite-seed.sql: schema and starting rows byte truth".
/// Source: tests/integration/testdata/sql/sqlite-seed.sql (91 bytes,
/// 2 lines, md5 cba9709c6b216c1c13aedcff452c1677).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the schema and starting state: the notes
/// table name and its two mentions, the 2-column count, both
/// column definitions verbatim, the INTEGER/TEXT types, the
/// PRIMARY KEY/UNIQUE constraints, the full parenthesized column
/// list, the single separating comma, and the zero starting-row
/// verdict (the fixture carries no INSERT, so applying it leaves
/// notes empty).
/// ADAPTATION (recorded, with source lines): column pins are exact
/// substrings of the L2 CREATE line (no leading indent exists in
/// this single-line fixture, unlike the indented multi-line
/// HISTORY-020/022 fixtures); create-cols pins the whole paren
/// span; comma-count pins the one 2c byte; notes-rows pins int 0
/// from the absence of INSERT (run-shape pins the INSERT verb
/// count 0). The Go empty-seed gate (sqlite_test.go L99-101:
/// setup.Notes != "0") corroborates the zero-row assumption;
/// harness bytes are owned by HISTORY-010, driver bytes by
/// HISTORY-016, and neither is pinned here.
/// Facet map (sqlite-seed.sql legs): seed-table pins notes (L1,
/// L2); table-mentions pins 2; col-count pins 2 (L2); id-col pins
/// the id definition; body-col the body definition; id-type pins
/// INTEGER; body-type pins TEXT; id-constraint pins PRIMARY KEY;
/// body-constraint pins UNIQUE; create-cols pins the L2 paren
/// span; comma-count pins 1; notes-rows pins 0.
/// Seed semantics live in history-021-seed-semantics.can; the
/// invocation/run shape lives in history-021-run-shape.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/sqlite-fixture-roots checks: seed-table,
/// table-mentions, col-count, id-col, body-col, id-type,
/// body-type, id-constraint, body-constraint, create-cols,
/// comma-count, notes-rows.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str seed_table
    int table_mentions
    int col_count
    str id_col
    str body_col
    str id_type
    str body_type
    str id_constraint
    str body_constraint
    str create_cols
    int comma_count
    int notes_rows
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/sqlite-fixture-roots", "default", "", "offline"), "seed-table" => ok "case history/sqlite-fixture-roots variant default root seed-table run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/sqlite-fixture-roots", "default", "", "offline"), "seed-table" => ok evidence("seed-table", "true", "true", true, "case history/sqlite-fixture-roots variant default root seed-table run offline")
        different: false, true, context("history/sqlite-fixture-roots", "default", "", "offline"), "seed-table" => failed{"seed-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/sqlite-fixture-roots", "default", "", "offline"), "table-mentions" => ok evidence("table-mentions", "2", "2", true, "case history/sqlite-fixture-roots variant default root table-mentions run offline")
        different: 3, 2, context("history/sqlite-fixture-roots", "default", "", "offline"), "table-mentions" => failed{"table-mentions"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "notes", "notes", context("history/sqlite-fixture-roots", "default", "", "offline"), "seed-table" => ok evidence("seed-table", "notes", "notes", true, "case history/sqlite-fixture-roots variant default root seed-table run offline")
        different: "notess", "notes", context("history/sqlite-fixture-roots", "default", "", "offline"), "seed-table" => failed{"seed-table"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_seed_table: "seed-seed-table-drift" => ok observation("notess", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_table_mentions: "seed-table-mentions-drift" => ok observation("notes", 3, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_col_count: "seed-col-count-drift" => ok observation("notes", 2, 3, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_id_col: "seed-id-col-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEYs", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_body_col: "seed-body-col-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUEs", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_id_type: "seed-id-type-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGERS", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_body_type: "seed-body-type-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXTS", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_id_constraint: "seed-id-constraint-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEYs", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_body_constraint: "seed-body-constraint-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUES", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        seed_create_cols: "seed-create-cols-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)s", 1, 0)
        seed_comma_count: "seed-comma-count-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 2, 0)
        seed_notes_rows: "seed-notes-rows-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 1)
    match variant_id
        "seed-seed-table-drift" => ok observation("notess", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-table-mentions-drift" => ok observation("notes", 3, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-col-count-drift" => ok observation("notes", 2, 3, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-id-col-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEYs", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-body-col-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUEs", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-id-type-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGERS", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-body-type-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXTS", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-id-constraint-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEYs", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-body-constraint-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUES", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
        "seed-create-cols-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)s", 1, 0)
        "seed-comma-count-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 2, 0)
        "seed-notes-rows-drift" => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 1)
        _ => ok observation("notes", 2, 2, "id INTEGER PRIMARY KEY", "body TEXT UNIQUE", "INTEGER", "TEXT", "PRIMARY KEY", "UNIQUE", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", 1, 0)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h021: "m26-h021" => ok [check("seed-table", "seed targets the notes table"), check("table-mentions", "notes occurs exactly twice"), check("col-count", "create lists exactly 2 columns"), check("id-col", "id column definition is byte-exact"), check("body-col", "body column definition is byte-exact"), check("id-type", "id column uses INTEGER"), check("body-type", "body column uses TEXT"), check("id-constraint", "id column pins PRIMARY KEY"), check("body-constraint", "body column pins UNIQUE"), check("create-cols", "create column list is byte-exact"), check("comma-count", "column list carries exactly 1 comma"), check("notes-rows", "seed leaves zero starting rows")]
        other: "nope" => ok []
    match scope is "m26-h021"
        false => ok []
        true => ok [check("seed-table", "seed targets the notes table"), check("table-mentions", "notes occurs exactly twice"), check("col-count", "create lists exactly 2 columns"), check("id-col", "id column definition is byte-exact"), check("body-col", "body column definition is byte-exact"), check("id-type", "id column uses INTEGER"), check("body-type", "body column uses TEXT"), check("id-constraint", "id column pins PRIMARY KEY"), check("body-constraint", "body column pins UNIQUE"), check("create-cols", "create column list is byte-exact"), check("comma-count", "column list carries exactly 1 comma"), check("notes-rows", "seed leaves zero starting rows")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/sqlite-fixture-roots" => ok [expected_check("seed-table", "notes"), expected_check("table-mentions", "2"), expected_check("col-count", "2"), expected_check("id-col", "id INTEGER PRIMARY KEY"), expected_check("body-col", "body TEXT UNIQUE"), expected_check("id-type", "INTEGER"), expected_check("body-type", "TEXT"), expected_check("id-constraint", "PRIMARY KEY"), expected_check("body-constraint", "UNIQUE"), expected_check("create-cols", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)"), expected_check("comma-count", "1"), expected_check("notes-rows", "0")]
        unknown: "nope" => ok []
    match case is "history/sqlite-fixture-roots"
        false => ok []
        true => ok [expected_check("seed-table", "notes"), expected_check("table-mentions", "2"), expected_check("col-count", "2"), expected_check("id-col", "id INTEGER PRIMARY KEY"), expected_check("body-col", "body TEXT UNIQUE"), expected_check("id-type", "INTEGER"), expected_check("body-type", "TEXT"), expected_check("id-constraint", "PRIMARY KEY"), expected_check("body-constraint", "UNIQUE"), expected_check("create-cols", "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)"), expected_check("comma-count", "1"), expected_check("notes-rows", "0")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/sqlite-fixture-roots", "default", "", "offline") => ok
        seed_seed_table: context("history/sqlite-fixture-roots", "seed-seed-table-drift", "", "offline") => failed{"seed-table"}
        seed_table_mentions: context("history/sqlite-fixture-roots", "seed-table-mentions-drift", "", "offline") => failed{"table-mentions"}
        seed_col_count: context("history/sqlite-fixture-roots", "seed-col-count-drift", "", "offline") => failed{"col-count"}
        seed_id_col: context("history/sqlite-fixture-roots", "seed-id-col-drift", "", "offline") => failed{"id-col"}
        seed_body_col: context("history/sqlite-fixture-roots", "seed-body-col-drift", "", "offline") => failed{"body-col"}
        seed_id_type: context("history/sqlite-fixture-roots", "seed-id-type-drift", "", "offline") => failed{"id-type"}
        seed_body_type: context("history/sqlite-fixture-roots", "seed-body-type-drift", "", "offline") => failed{"body-type"}
        seed_id_constraint: context("history/sqlite-fixture-roots", "seed-id-constraint-drift", "", "offline") => failed{"id-constraint"}
        seed_body_constraint: context("history/sqlite-fixture-roots", "seed-body-constraint-drift", "", "offline") => failed{"body-constraint"}
        seed_create_cols: context("history/sqlite-fixture-roots", "seed-create-cols-drift", "", "offline") => failed{"create-cols"}
        seed_comma_count: context("history/sqlite-fixture-roots", "seed-comma-count-drift", "", "offline") => failed{"comma-count"}
        seed_notes_rows: context("history/sqlite-fixture-roots", "seed-notes-rows-drift", "", "offline") => failed{"notes-rows"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.seed_table, "notes", c, "seed-table")
            failed
            ok evidence seed_table_evidence => match call require_int(got.table_mentions, 2, c, "table-mentions")
                failed
                ok evidence table_mentions_evidence => match call require_int(got.col_count, 2, c, "col-count")
                    failed
                    ok evidence col_count_evidence => match call require_text(got.id_col, "id INTEGER PRIMARY KEY", c, "id-col")
                        failed
                        ok evidence id_col_evidence => match call require_text(got.body_col, "body TEXT UNIQUE", c, "body-col")
                            failed
                            ok evidence body_col_evidence => match call require_text(got.id_type, "INTEGER", c, "id-type")
                                failed
                                ok evidence id_type_evidence => match call require_text(got.body_type, "TEXT", c, "body-type")
                                    failed
                                    ok evidence body_type_evidence => match call require_text(got.id_constraint, "PRIMARY KEY", c, "id-constraint")
                                        failed
                                        ok evidence id_constraint_evidence => match call require_text(got.body_constraint, "UNIQUE", c, "body-constraint")
                                            failed
                                            ok evidence body_constraint_evidence => match call require_text(got.create_cols, "(id INTEGER PRIMARY KEY, body TEXT UNIQUE)", c, "create-cols")
                                                failed
                                                ok evidence create_cols_evidence => match call require_int(got.comma_count, 1, c, "comma-count")
                                                    failed
                                                    ok evidence comma_count_evidence => match call require_int(got.notes_rows, 0, c, "notes-rows")
                                                        failed
                                                        ok evidence notes_rows_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m26_h021: "m26-h021" => ok test_case("history/sqlite-fixture-roots", ["history", "m26"], [], 0, [check_ref("seed-table"), check_ref("table-mentions"), check_ref("col-count"), check_ref("id-col"), check_ref("body-col"), check_ref("id-type"), check_ref("body-type"), check_ref("id-constraint"), check_ref("body-constraint"), check_ref("create-cols"), check_ref("comma-count"), check_ref("notes-rows")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m26-h021"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/sqlite-fixture-roots", ["history", "m26"], [], 0, [check_ref("seed-table"), check_ref("table-mentions"), check_ref("col-count"), check_ref("id-col"), check_ref("body-col"), check_ref("id-type"), check_ref("body-type"), check_ref("id-constraint"), check_ref("body-constraint"), check_ref("create-cols"), check_ref("comma-count"), check_ref("notes-rows")], callable case_body)
