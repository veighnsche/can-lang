package m26history021seed
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M26 HISTORY-021 "sqlite-seed.sql: statement inventory byte truth".
/// Source: tests/integration/testdata/sql/sqlite-seed.sql (91 bytes,
/// 2 lines, md5 cba9709c6b216c1c13aedcff452c1677).
/// Disposition: retain_fixture (support row; the SQL file stays as
/// data and this slice holds it accountable byte for byte; only the
/// integrator may retire the shared old file after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the static statement inventory: the file
/// size/line/hash envelope, the zero comment-line count, the
/// 2-statement count, one md5 pin per statement in seed order (L1,
/// L2), the per-statement line-span byte lengths, and the
/// trailing-newline verdict.
/// ADAPTATION (recorded, with source lines): each sN-md5 pins md5
/// over that statement's exact line bytes including the trailing
/// newline, reproduced by sed -n '<line>p' sqlite-seed.sql | md5;
/// sN-bytes pins the same span length (28/63); ends-newline pins
/// the final 0a byte as bool. Md5 drifts flip the first digest
/// char to 0. Verbatim statement text lives in
/// history-021-run-shape.can; table/column lines and starting rows
/// live in history-021-roots-green.can. The driver split guard
/// (sqlite-driver.ts L31: statements.length !== 2) corroborates
/// the count and the Go seed path (sqlite_test.go L83) names the
/// consumer; neither driver nor harness bytes are pinned here
/// (HISTORY-016 owns the driver, HISTORY-010 the harness).
/// Facet map (sqlite-seed.sql legs): stmt-count pins 2 (L1-2);
/// comment-lines pins 0 (no -- line); total-lines pins 2;
/// file-bytes pins 91; file-md5 pins the whole-file digest; s1-md5
/// pins the L1 drop; s2-md5 the L2 create; s1-bytes pins 28;
/// s2-bytes pins 63; ends-newline pins true.
/// The roots-green pin lives in history-021-roots-green.can; the
/// invocation/run shape lives in history-021-run-shape.can.
/// Variants: none (row lists none; static fixture, one shape).
/// Environment: none (row lists no environment gates; descriptor
/// requires [] and timeout 0 record that no timed or gated leg
/// exists for this static input).
/// R/N/C/S/A identities identified in evidence; S/A bind at QD1;
/// no live run now. Descriptor timeout 0 records that the fixture
/// pins no timeout (no ctx/deadline leg in a static SQL file).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (support row; static fixture
/// accountability only; if_retained_accept_after QD1 unmet).
/// Case history/sqlite-fixture-seed checks: stmt-count,
/// comment-lines, total-lines, file-bytes, file-md5, s1-md5,
/// s2-md5, s1-bytes, s2-bytes, ends-newline.
/// Shared old files untouched; retirement is a later integrator
/// decision.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int stmt_count
    int comment_lines
    int total_lines
    int file_bytes
    str file_md5
    str s1_md5
    str s2_md5
    int s1_bytes
    int s2_bytes
    bool ends_newline
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/sqlite-fixture-seed", "default", "", "offline"), "stmt-count" => ok "case history/sqlite-fixture-seed variant default root stmt-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/sqlite-fixture-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "true", "true", true, "case history/sqlite-fixture-seed variant default root stmt-count run offline")
        different: false, true, context("history/sqlite-fixture-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/sqlite-fixture-seed", "default", "", "offline"), "stmt-count" => ok evidence("stmt-count", "2", "2", true, "case history/sqlite-fixture-seed variant default root stmt-count run offline")
        different: 3, 2, context("history/sqlite-fixture-seed", "default", "", "offline"), "stmt-count" => failed{"stmt-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "cba9709c6b216c1c13aedcff452c1677", "cba9709c6b216c1c13aedcff452c1677", context("history/sqlite-fixture-seed", "default", "", "offline"), "file-md5" => ok evidence("file-md5", "cba9709c6b216c1c13aedcff452c1677", "cba9709c6b216c1c13aedcff452c1677", true, "case history/sqlite-fixture-seed variant default root file-md5 run offline")
        different: "0ba9709c6b216c1c13aedcff452c1677", "cba9709c6b216c1c13aedcff452c1677", context("history/sqlite-fixture-seed", "default", "", "offline"), "file-md5" => failed{"file-md5"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_stmt_count: "seed-stmt-count-drift" => ok observation(3, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_comment_lines: "seed-comment-lines-drift" => ok observation(2, 1, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_total_lines: "seed-total-lines-drift" => ok observation(2, 0, 3, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_file_bytes: "seed-file-bytes-drift" => ok observation(2, 0, 2, 92, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_file_md5: "seed-file-md5-drift" => ok observation(2, 0, 2, 91, "0ba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_s1_md5: "seed-s1-md5-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "05c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_s2_md5: "seed-s2-md5-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "04e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        seed_s1_bytes: "seed-s1-bytes-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 29, 63, true)
        seed_s2_bytes: "seed-s2-bytes-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 64, true)
        seed_ends_newline: "seed-ends-newline-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, false)
    match variant_id
        "seed-stmt-count-drift" => ok observation(3, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        "seed-comment-lines-drift" => ok observation(2, 1, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        "seed-total-lines-drift" => ok observation(2, 0, 3, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        "seed-file-bytes-drift" => ok observation(2, 0, 2, 92, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        "seed-file-md5-drift" => ok observation(2, 0, 2, 91, "0ba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        "seed-s1-md5-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "05c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        "seed-s2-md5-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "04e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
        "seed-s1-bytes-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 29, 63, true)
        "seed-s2-bytes-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 64, true)
        "seed-ends-newline-drift" => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, false)
        _ => ok observation(2, 0, 2, 91, "cba9709c6b216c1c13aedcff452c1677", "75c835f8005b57173310c6fd8cd091e7", "44e247778d7e2e10b8e6ac4478942b4a", 28, 63, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m26_h021: "m26-h021" => ok [check("stmt-count", "seed file holds exactly 2 statements"), check("comment-lines", "seed file carries no comment lines"), check("total-lines", "seed file holds exactly 2 lines"), check("file-bytes", "seed file is exactly 91 bytes"), check("file-md5", "seed file bytes hash to the pinned md5"), check("s1-md5", "statement 1 bytes hash to the pinned md5"), check("s2-md5", "statement 2 bytes hash to the pinned md5"), check("s1-bytes", "statement 1 line span is exactly 28 bytes"), check("s2-bytes", "statement 2 line span is exactly 63 bytes"), check("ends-newline", "seed file ends in a trailing newline")]
        other: "nope" => ok []
    match scope is "m26-h021"
        false => ok []
        true => ok [check("stmt-count", "seed file holds exactly 2 statements"), check("comment-lines", "seed file carries no comment lines"), check("total-lines", "seed file holds exactly 2 lines"), check("file-bytes", "seed file is exactly 91 bytes"), check("file-md5", "seed file bytes hash to the pinned md5"), check("s1-md5", "statement 1 bytes hash to the pinned md5"), check("s2-md5", "statement 2 bytes hash to the pinned md5"), check("s1-bytes", "statement 1 line span is exactly 28 bytes"), check("s2-bytes", "statement 2 line span is exactly 63 bytes"), check("ends-newline", "seed file ends in a trailing newline")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/sqlite-fixture-seed" => ok [expected_check("stmt-count", "2"), expected_check("comment-lines", "0"), expected_check("total-lines", "2"), expected_check("file-bytes", "91"), expected_check("file-md5", "cba9709c6b216c1c13aedcff452c1677"), expected_check("s1-md5", "75c835f8005b57173310c6fd8cd091e7"), expected_check("s2-md5", "44e247778d7e2e10b8e6ac4478942b4a"), expected_check("s1-bytes", "28"), expected_check("s2-bytes", "63"), expected_check("ends-newline", "true")]
        unknown: "nope" => ok []
    match case is "history/sqlite-fixture-seed"
        false => ok []
        true => ok [expected_check("stmt-count", "2"), expected_check("comment-lines", "0"), expected_check("total-lines", "2"), expected_check("file-bytes", "91"), expected_check("file-md5", "cba9709c6b216c1c13aedcff452c1677"), expected_check("s1-md5", "75c835f8005b57173310c6fd8cd091e7"), expected_check("s2-md5", "44e247778d7e2e10b8e6ac4478942b4a"), expected_check("s1-bytes", "28"), expected_check("s2-bytes", "63"), expected_check("ends-newline", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/sqlite-fixture-seed", "default", "", "offline") => ok
        seed_stmt_count: context("history/sqlite-fixture-seed", "seed-stmt-count-drift", "", "offline") => failed{"stmt-count"}
        seed_comment_lines: context("history/sqlite-fixture-seed", "seed-comment-lines-drift", "", "offline") => failed{"comment-lines"}
        seed_total_lines: context("history/sqlite-fixture-seed", "seed-total-lines-drift", "", "offline") => failed{"total-lines"}
        seed_file_bytes: context("history/sqlite-fixture-seed", "seed-file-bytes-drift", "", "offline") => failed{"file-bytes"}
        seed_file_md5: context("history/sqlite-fixture-seed", "seed-file-md5-drift", "", "offline") => failed{"file-md5"}
        seed_s1_md5: context("history/sqlite-fixture-seed", "seed-s1-md5-drift", "", "offline") => failed{"s1-md5"}
        seed_s2_md5: context("history/sqlite-fixture-seed", "seed-s2-md5-drift", "", "offline") => failed{"s2-md5"}
        seed_s1_bytes: context("history/sqlite-fixture-seed", "seed-s1-bytes-drift", "", "offline") => failed{"s1-bytes"}
        seed_s2_bytes: context("history/sqlite-fixture-seed", "seed-s2-bytes-drift", "", "offline") => failed{"s2-bytes"}
        seed_ends_newline: context("history/sqlite-fixture-seed", "seed-ends-newline-drift", "", "offline") => failed{"ends-newline"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.stmt_count, 2, c, "stmt-count")
            failed
            ok evidence stmt_count_evidence => match call require_int(got.comment_lines, 0, c, "comment-lines")
                failed
                ok evidence comment_lines_evidence => match call require_int(got.total_lines, 2, c, "total-lines")
                    failed
                    ok evidence total_lines_evidence => match call require_int(got.file_bytes, 91, c, "file-bytes")
                        failed
                        ok evidence file_bytes_evidence => match call require_text(got.file_md5, "cba9709c6b216c1c13aedcff452c1677", c, "file-md5")
                            failed
                            ok evidence file_md5_evidence => match call require_text(got.s1_md5, "75c835f8005b57173310c6fd8cd091e7", c, "s1-md5")
                                failed
                                ok evidence s1_md5_evidence => match call require_text(got.s2_md5, "44e247778d7e2e10b8e6ac4478942b4a", c, "s2-md5")
                                    failed
                                    ok evidence s2_md5_evidence => match call require_int(got.s1_bytes, 28, c, "s1-bytes")
                                        failed
                                        ok evidence s1_bytes_evidence => match call require_int(got.s2_bytes, 63, c, "s2-bytes")
                                            failed
                                            ok evidence s2_bytes_evidence => match call require_bool(got.ends_newline, true, c, "ends-newline")
                                                failed
                                                ok evidence ends_newline_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m26_h021: "m26-h021" => ok test_case("history/sqlite-fixture-seed", ["history", "m26"], [], 0, [check_ref("stmt-count"), check_ref("comment-lines"), check_ref("total-lines"), check_ref("file-bytes"), check_ref("file-md5"), check_ref("s1-md5"), check_ref("s2-md5"), check_ref("s1-bytes"), check_ref("s2-bytes"), check_ref("ends-newline")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m26-h021"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/sqlite-fixture-seed", ["history", "m26"], [], 0, [check_ref("stmt-count"), check_ref("comment-lines"), check_ref("total-lines"), check_ref("file-bytes"), check_ref("file-md5"), check_ref("s1-md5"), check_ref("s2-md5"), check_ref("s1-bytes"), check_ref("s2-bytes"), check_ref("ends-newline")], callable case_body)
