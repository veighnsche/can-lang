package m27history023provenance
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M27 HISTORY-023 "owner-setup green: report shape and real-Can provenance".
/// Source: tests/failure-conventions/owner_test.go symbol TestOwnerSetupGreen
/// plus harness requireGreen/requireRealCan (tests/failure-conventions/).
/// Related fixtures: tests/failure-conventions/owner-setup/ (asserted project).
/// Disposition: RETAIN. The green leg observes the assert report (exit 0,
/// decoded report passed, every entry passed) and real-Can provenance (every
/// root carries "real-can" evidence).
/// Protects (this file): exit-zero, report-passed, real-can-count pins.
/// Per-root green flags live in history-023-roots-green.can; the private
/// factory boundary and trap values live in
/// history-023-factory-boundary.can.
/// Variants: positive owner project only. Tainted, forged-owner, sneak and
/// repair variants belong to HISTORY-024/025/026/027, not this row.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case owner-setup/report-provenance checks: exit-zero, report-passed,
/// real-can-count.
/// Facet map: exit-zero pins canlc assert exit status 0; report-passed pins
/// the decoded can.assertion-report passed flag with every entry passed;
/// real-can-count pins requireRealCan (all 14 roots carry "real-can").
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int exit_code
    bool report_passed
    int real_can_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("owner-setup/report-provenance", "default", "", "offline"), "exit-zero" => ok "case owner-setup/report-provenance variant default root exit-zero run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("owner-setup/report-provenance", "default", "", "offline"), "report-passed" => ok evidence("report-passed", "true", "true", true, "case owner-setup/report-provenance variant default root report-passed run offline")
        different: false, true, context("owner-setup/report-provenance", "default", "", "offline"), "report-passed" => failed{"report-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 14, 14, context("owner-setup/report-provenance", "default", "", "offline"), "real-can-count" => ok evidence("real-can-count", "14", "14", true, "case owner-setup/report-provenance variant default root real-can-count run offline")
        different: 13, 14, context("owner-setup/report-provenance", "default", "", "offline"), "real-can-count" => failed{"real-can-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, true, 14)
        seed_nonzero_exit: "seed-nonzero-exit" => ok observation(1, false, 0)
        seed_report_fail: "seed-report-fail" => ok observation(0, false, 14)
        seed_provenance_gap: "seed-provenance-gap" => ok observation(0, true, 13)
    match variant_id
        "seed-nonzero-exit" => ok observation(1, false, 0)
        "seed-report-fail" => ok observation(0, false, 14)
        "seed-provenance-gap" => ok observation(0, true, 13)
        _ => ok observation(0, true, 14)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m27_023: "m27-023" => ok [check("exit-zero", "canlc assert exits 0"), check("report-passed", "decoded assert report passed"), check("real-can-count", "all 14 roots carry real-can evidence")]
        other: "nope" => ok []
    match scope is "m27-023"
        false => ok []
        true => ok [check("exit-zero", "canlc assert exits 0"), check("report-passed", "decoded assert report passed"), check("real-can-count", "all 14 roots carry real-can evidence")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "owner-setup/report-provenance" => ok [expected_check("exit-zero", "0"), expected_check("report-passed", "true"), expected_check("real-can-count", "14")]
        unknown: "nope" => ok []
    match case is "owner-setup/report-provenance"
        false => ok []
        true => ok [expected_check("exit-zero", "0"), expected_check("report-passed", "true"), expected_check("real-can-count", "14")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("owner-setup/report-provenance", "default", "", "offline") => ok
        seed_nonzero_exit: context("owner-setup/report-provenance", "seed-nonzero-exit", "", "offline") => failed{"exit-zero"}
        seed_report_fail: context("owner-setup/report-provenance", "seed-report-fail", "", "offline") => failed{"report-passed"}
        seed_provenance_gap: context("owner-setup/report-provenance", "seed-provenance-gap", "", "offline") => failed{"real-can-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.exit_code, 0, c, "exit-zero")
            failed
            ok evidence exit_evidence => match call require_bool(got.report_passed, true, c, "report-passed")
                failed
                ok evidence passed_evidence => match call require_int(got.real_can_count, 14, c, "real-can-count")
                    failed
                    ok evidence provenance_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m27_023: "m27-023" => ok test_case("owner-setup/report-provenance", ["owner", "m27"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-zero"), check_ref("report-passed"), check_ref("real-can-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m27-023"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("owner-setup/report-provenance", ["owner", "m27"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-zero"), check_ref("report-passed"), check_ref("real-can-count")], callable case_body)
