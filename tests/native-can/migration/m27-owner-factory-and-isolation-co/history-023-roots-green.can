package m27history023roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M27 HISTORY-023 "owner-setup green: all 14 pre-extraction roots pass".
/// Source: tests/failure-conventions/owner_test.go symbol TestOwnerSetupGreen.
/// Related fixtures: tests/failure-conventions/owner-setup/ (ids, handler, app).
/// Disposition: RETAIN. Green owner-setup roots are live: the owner-accepting
/// tier_for helper is tested through the private fixture_id factory with trap
/// kind/message probes and every pre-extraction root retained.
/// Protects (this file): all 14 roots green plus the exact root-count pin.
/// Report shape and real-Can provenance live in
/// history-023-report-provenance.can; the private factory boundary and trap
/// values live in history-023-factory-boundary.can.
/// Variants: positive owner project only. Tainted, forged-owner, sneak and
/// repair variants belong to HISTORY-024/025/026/027, not this row.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case owner-setup/green-roots checks: root-count, ids-parse-good,
/// ids-parse-bad, ids-value-good, tier-for-gold, tier-for-silver,
/// tier-for-bronze, handle-gold, handle-silver, handle-bronze, handle-bad,
/// factory-unit, trap-kind-green, trap-message-green, app-empty.
/// Root map (owner-setup fixture asserts in TestOwnerSetupGreen order):
/// ids::parse good/bad, ids::value good, handler::tier_for gold/silver/bronze,
/// handler::handle_tier gold/silver/bronze/bad, handler::fixture_id unit,
/// handler::trap_kind kind, handler::trap_message text, app::main empty.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int root_count
    bool ids_parse_good
    bool ids_parse_bad
    bool ids_value_good
    bool tier_for_gold
    bool tier_for_silver
    bool tier_for_bronze
    bool handle_gold
    bool handle_silver
    bool handle_bronze
    bool handle_bad
    bool factory_unit
    bool trap_kind_green
    bool trap_message_green
    bool app_empty
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("owner-setup/green-roots", "default", "", "offline"), "root-count" => ok "case owner-setup/green-roots variant default root root-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("owner-setup/green-roots", "default", "", "offline"), "handle-bad" => ok evidence("handle-bad", "true", "true", true, "case owner-setup/green-roots variant default root handle-bad run offline")
        different: false, true, context("owner-setup/green-roots", "default", "", "offline"), "handle-bad" => failed{"handle-bad"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 14, 14, context("owner-setup/green-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "14", "14", true, "case owner-setup/green-roots variant default root root-count run offline")
        different: 13, 14, context("owner-setup/green-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(14, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        seed_count_short: "seed-count-short" => ok observation(13, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        seed_ids_parse_good_fail: "seed-ids-parse-good-fail" => ok observation(14, false, true, true, true, true, true, true, true, true, true, true, true, true, true)
        seed_handle_bad_fail: "seed-handle-bad-fail" => ok observation(14, true, true, true, true, true, true, true, true, true, false, true, true, true, true)
    match variant_id
        "seed-count-short" => ok observation(13, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        "seed-ids-parse-good-fail" => ok observation(14, false, true, true, true, true, true, true, true, true, true, true, true, true, true)
        "seed-handle-bad-fail" => ok observation(14, true, true, true, true, true, true, true, true, true, false, true, true, true, true)
        _ => ok observation(14, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m27_023: "m27-023" => ok [check("root-count", "assert report carries exactly 14 roots"), check("ids-parse-good", "ids::parse good root green"), check("ids-parse-bad", "ids::parse bad root green"), check("ids-value-good", "ids::value good root green"), check("tier-for-gold", "handler::tier_for gold root green"), check("tier-for-silver", "handler::tier_for silver root green"), check("tier-for-bronze", "handler::tier_for bronze root green"), check("handle-gold", "handler::handle_tier gold root green"), check("handle-silver", "handler::handle_tier silver root green"), check("handle-bronze", "handler::handle_tier bronze root green"), check("handle-bad", "handler::handle_tier bad root green"), check("factory-unit", "handler::fixture_id unit root green"), check("trap-kind-green", "handler::trap_kind kind root green"), check("trap-message-green", "handler::trap_message text root green"), check("app-empty", "app::main empty root green")]
        other: "nope" => ok []
    match scope is "m27-023"
        false => ok []
        true => ok [check("root-count", "assert report carries exactly 14 roots"), check("ids-parse-good", "ids::parse good root green"), check("ids-parse-bad", "ids::parse bad root green"), check("ids-value-good", "ids::value good root green"), check("tier-for-gold", "handler::tier_for gold root green"), check("tier-for-silver", "handler::tier_for silver root green"), check("tier-for-bronze", "handler::tier_for bronze root green"), check("handle-gold", "handler::handle_tier gold root green"), check("handle-silver", "handler::handle_tier silver root green"), check("handle-bronze", "handler::handle_tier bronze root green"), check("handle-bad", "handler::handle_tier bad root green"), check("factory-unit", "handler::fixture_id unit root green"), check("trap-kind-green", "handler::trap_kind kind root green"), check("trap-message-green", "handler::trap_message text root green"), check("app-empty", "app::main empty root green")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "owner-setup/green-roots" => ok [expected_check("root-count", "14"), expected_check("ids-parse-good", "true"), expected_check("ids-parse-bad", "true"), expected_check("ids-value-good", "true"), expected_check("tier-for-gold", "true"), expected_check("tier-for-silver", "true"), expected_check("tier-for-bronze", "true"), expected_check("handle-gold", "true"), expected_check("handle-silver", "true"), expected_check("handle-bronze", "true"), expected_check("handle-bad", "true"), expected_check("factory-unit", "true"), expected_check("trap-kind-green", "true"), expected_check("trap-message-green", "true"), expected_check("app-empty", "true")]
        unknown: "nope" => ok []
    match case is "owner-setup/green-roots"
        false => ok []
        true => ok [expected_check("root-count", "14"), expected_check("ids-parse-good", "true"), expected_check("ids-parse-bad", "true"), expected_check("ids-value-good", "true"), expected_check("tier-for-gold", "true"), expected_check("tier-for-silver", "true"), expected_check("tier-for-bronze", "true"), expected_check("handle-gold", "true"), expected_check("handle-silver", "true"), expected_check("handle-bronze", "true"), expected_check("handle-bad", "true"), expected_check("factory-unit", "true"), expected_check("trap-kind-green", "true"), expected_check("trap-message-green", "true"), expected_check("app-empty", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("owner-setup/green-roots", "default", "", "offline") => ok
        seed_count_short: context("owner-setup/green-roots", "seed-count-short", "", "offline") => failed{"root-count"}
        seed_ids_parse_good_fail: context("owner-setup/green-roots", "seed-ids-parse-good-fail", "", "offline") => failed{"ids-parse-good"}
        seed_handle_bad_fail: context("owner-setup/green-roots", "seed-handle-bad-fail", "", "offline") => failed{"handle-bad"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.root_count, 14, c, "root-count")
            failed
            ok evidence count_evidence => match call require_bool(got.ids_parse_good, true, c, "ids-parse-good")
                failed
                ok evidence ids_parse_good_evidence => match call require_bool(got.ids_parse_bad, true, c, "ids-parse-bad")
                    failed
                    ok evidence ids_parse_bad_evidence => match call require_bool(got.ids_value_good, true, c, "ids-value-good")
                        failed
                        ok evidence ids_value_good_evidence => match call require_bool(got.tier_for_gold, true, c, "tier-for-gold")
                            failed
                            ok evidence tier_for_gold_evidence => match call require_bool(got.tier_for_silver, true, c, "tier-for-silver")
                                failed
                                ok evidence tier_for_silver_evidence => match call require_bool(got.tier_for_bronze, true, c, "tier-for-bronze")
                                    failed
                                    ok evidence tier_for_bronze_evidence => match call require_bool(got.handle_gold, true, c, "handle-gold")
                                        failed
                                        ok evidence handle_gold_evidence => match call require_bool(got.handle_silver, true, c, "handle-silver")
                                            failed
                                            ok evidence handle_silver_evidence => match call require_bool(got.handle_bronze, true, c, "handle-bronze")
                                                failed
                                                ok evidence handle_bronze_evidence => match call require_bool(got.handle_bad, true, c, "handle-bad")
                                                    failed
                                                    ok evidence handle_bad_evidence => match call require_bool(got.factory_unit, true, c, "factory-unit")
                                                        failed
                                                        ok evidence factory_unit_evidence => match call require_bool(got.trap_kind_green, true, c, "trap-kind-green")
                                                            failed
                                                            ok evidence trap_kind_green_evidence => match call require_bool(got.trap_message_green, true, c, "trap-message-green")
                                                                failed
                                                                ok evidence trap_message_green_evidence => match call require_bool(got.app_empty, true, c, "app-empty")
                                                                    failed
                                                                    ok evidence app_empty_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m27_023: "m27-023" => ok test_case("owner-setup/green-roots", ["owner", "m27"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("root-count"), check_ref("ids-parse-good"), check_ref("ids-parse-bad"), check_ref("ids-value-good"), check_ref("tier-for-gold"), check_ref("tier-for-silver"), check_ref("tier-for-bronze"), check_ref("handle-gold"), check_ref("handle-silver"), check_ref("handle-bronze"), check_ref("handle-bad"), check_ref("factory-unit"), check_ref("trap-kind-green"), check_ref("trap-message-green"), check_ref("app-empty")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m27-023"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("owner-setup/green-roots", ["owner", "m27"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("root-count"), check_ref("ids-parse-good"), check_ref("ids-parse-bad"), check_ref("ids-value-good"), check_ref("tier-for-gold"), check_ref("tier-for-silver"), check_ref("tier-for-bronze"), check_ref("handle-gold"), check_ref("handle-silver"), check_ref("handle-bronze"), check_ref("handle-bad"), check_ref("factory-unit"), check_ref("trap-kind-green"), check_ref("trap-message-green"), check_ref("app-empty")], callable case_body)
