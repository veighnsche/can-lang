package m27history024roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M27 HISTORY-024 "owner-negative fails closed: only the tainted row fails".
/// Source: tests/failure-conventions/owner_test.go symbol TestOwnerNegativeFailsClosed.
/// Related fixtures: tests/failure-conventions/owner-negative/ (ids, handler, app).
/// Disposition: RETAIN. The tainted tier_for row feeds a rejecting factory input
/// through the private fixture_id factory; the suite fails closed with only that
/// row failing and every pre-extraction root retained green.
/// Protects (this file): exactly 15 roots, the tainted row failed, and each of
/// the other 14 roots green (only-tainted-fails isolation).
/// Report shape and failure provenance live in
/// history-024-report-provenance.can; the two located fault frames live in
/// history-024-fault-frames.can.
/// Variants: tainted owner project only. Green-setup (023), forged-owner (025),
/// sneak (026) and repair (027) variants are other rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case owner-negative/roots-fails-closed checks: root-count, ids-parse-good,
/// ids-parse-bad, ids-value-good, tier-for-gold, tier-for-silver,
/// tier-for-bronze, tainted-fails, handle-gold, handle-silver, handle-bronze,
/// handle-bad, factory-unit, trap-kind-green, trap-message-green, app-empty.
/// Root map (owner-negative fixture asserts in TestOwnerNegativeFailsClosed order):
/// ids::parse good/bad, ids::value good, handler::tier_for gold/silver/bronze
/// plus the tainted row, handler::handle_tier gold/silver/bronze/bad,
/// handler::fixture_id unit, handler::trap_kind kind, handler::trap_message text,
/// app::main empty. Tainted root id: can.project.root/handler::tier_for:tainted.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int root_count
    bool ids_parse_good
    bool ids_parse_bad
    bool ids_value_good
    bool tier_for_gold
    bool tier_for_silver
    bool tier_for_bronze
    bool tainted_failed
    bool handle_gold
    bool handle_silver
    bool handle_bronze
    bool handle_bad
    bool factory_unit
    bool trap_kind_green
    bool trap_message_green
    bool app_empty
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("owner-negative/roots-fails-closed", "default", "", "offline"), "root-count" => ok "case owner-negative/roots-fails-closed variant default root root-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("owner-negative/roots-fails-closed", "default", "", "offline"), "tainted-fails" => ok evidence("tainted-fails", "true", "true", true, "case owner-negative/roots-fails-closed variant default root tainted-fails run offline")
        different: false, true, context("owner-negative/roots-fails-closed", "default", "", "offline"), "tainted-fails" => failed{"tainted-fails"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 15, 15, context("owner-negative/roots-fails-closed", "default", "", "offline"), "root-count" => ok evidence("root-count", "15", "15", true, "case owner-negative/roots-fails-closed variant default root root-count run offline")
        different: 14, 15, context("owner-negative/roots-fails-closed", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(15, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        seed_count_short: "seed-count-short" => ok observation(14, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        seed_tainted_passed: "seed-tainted-passed" => ok observation(15, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true)
        seed_unrelated_fail: "seed-unrelated-fail" => ok observation(15, true, true, true, true, true, true, true, true, true, true, false, true, true, true, true)
    match variant_id
        "seed-count-short" => ok observation(14, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        "seed-tainted-passed" => ok observation(15, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true)
        "seed-unrelated-fail" => ok observation(15, true, true, true, true, true, true, true, true, true, true, false, true, true, true, true)
        _ => ok observation(15, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
