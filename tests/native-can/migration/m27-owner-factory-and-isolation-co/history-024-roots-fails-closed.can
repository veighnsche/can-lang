        true => ok [check("root-count", "assert report carries exactly 15 roots"), check("ids-parse-good", "ids::parse good root green"), check("ids-parse-bad", "ids::parse bad root green"), check("ids-value-good", "ids::value good root green"), check("tier-for-gold", "handler::tier_for gold root green"), check("tier-for-silver", "handler::tier_for silver root green"), check("tier-for-bronze", "handler::tier_for bronze root green"), check("tainted-fails", "handler::tier_for tainted row fails closed"), check("handle-gold", "handler::handle_tier gold root green"), check("handle-silver", "handler::handle_tier silver root green"), check("handle-bronze", "handler::handle_tier bronze root green"), check("handle-bad", "handler::handle_tier bad root green"), check("factory-unit", "handler::fixture_id unit root green"), check("trap-kind-green", "handler::trap_kind kind root green"), check("trap-message-green", "handler::trap_message text root green"), check("app-empty", "app::main empty root green")]
