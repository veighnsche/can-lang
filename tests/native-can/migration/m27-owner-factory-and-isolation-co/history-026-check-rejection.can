package m27history026rejection
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M27 HISTORY-026 "factory private to package: check-phase rejection outcome".
/// Source: tests/failure-conventions/owner_test.go symbol TestFactoryPrivateToPackage
/// (outcome predicates at owner_test.go:121) plus harness assertOutcome
/// (tests/failure-conventions/harness_test.go).
/// Related fixtures: tests/failure-conventions/owner-setup/ plus the injected
/// src/sneak/sneak.can (asserted project).
/// Disposition: RETAIN. Unlike the green (023) and tainted (024) legs, the
/// sneak leg observes a compiler rejection, not an assert report: the suite
/// fails with no decoded report at all.
/// Protects (this file): exit-nonzero, report-absent, and phase-check pins.
/// The injected sneak shape lives in history-026-sneak-shape.can; the
/// "handler::fixture_id is private" diagnostic pin lives in
/// history-026-diagnostic-text.can.
/// Variants: sneak-injected owner project only. Green-setup (023), tainted
/// frames (024), forged-owner (025) and repair (027) variants are other rows,
/// not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case owner-sneak/check-rejection checks: exit-nonzero, report-absent,
/// phase-check.
/// Facet map: exit-nonzero pins the Go `Status != 0` predicate without
/// over-pinning an exact code (exit_code stays observed evidence);
/// report-absent pins that no can.assertion-report decodes (Report == nil),
/// the inverted polarity of the 024 report-present check; phase-check pins
/// the rejection phase "check" (no report means rejection before assert
/// execution, carrying a compiler diagnostic instead).
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int exit_code
    bool exit_nonzero
    bool report_absent
    str rejection_phase
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("owner-sneak/check-rejection", "default", "", "offline"), "exit-nonzero" => ok "case owner-sneak/check-rejection variant default root exit-nonzero run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("owner-sneak/check-rejection", "default", "", "offline"), "report-absent" => ok evidence("report-absent", "true", "true", true, "case owner-sneak/check-rejection variant default root report-absent run offline")
        different: false, true, context("owner-sneak/check-rejection", "default", "", "offline"), "report-absent" => failed{"report-absent"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "check", "check", context("owner-sneak/check-rejection", "default", "", "offline"), "phase-check" => ok evidence("phase-check", "check", "check", true, "case owner-sneak/check-rejection variant default root phase-check run offline")
        different: "assert", "check", context("owner-sneak/check-rejection", "default", "", "offline"), "phase-check" => failed{"phase-check"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(1, true, true, "check")
        seed_suite_passed: "seed-suite-passed" => ok observation(0, false, false, "assert")
        seed_report_present: "seed-report-present" => ok observation(1, true, false, "check")
        seed_phase_drift: "seed-phase-drift" => ok observation(1, true, true, "assert")
    match variant_id
        "seed-suite-passed" => ok observation(0, false, false, "assert")
        "seed-report-present" => ok observation(1, true, false, "check")
        "seed-phase-drift" => ok observation(1, true, true, "assert")
        _ => ok observation(1, true, true, "check")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m27_026: "m27-026" => ok [check("exit-nonzero", "canlc assert exits nonzero on the sneak project"), check("report-absent", "no decoded assert report on the sneak project"), check("phase-check", "rejection happens at the check phase")]
        other: "nope" => ok []
    match scope is "m27-026"
        false => ok []
        true => ok [check("exit-nonzero", "canlc assert exits nonzero on the sneak project"), check("report-absent", "no decoded assert report on the sneak project"), check("phase-check", "rejection happens at the check phase")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "owner-sneak/check-rejection" => ok [expected_check("exit-nonzero", "true"), expected_check("report-absent", "true"), expected_check("phase-check", "check")]
        unknown: "nope" => ok []
    match case is "owner-sneak/check-rejection"
        false => ok []
        true => ok [expected_check("exit-nonzero", "true"), expected_check("report-absent", "true"), expected_check("phase-check", "check")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("owner-sneak/check-rejection", "default", "", "offline") => ok
        seed_suite_passed: context("owner-sneak/check-rejection", "seed-suite-passed", "", "offline") => failed{"exit-nonzero"}
        seed_report_present: context("owner-sneak/check-rejection", "seed-report-present", "", "offline") => failed{"report-absent"}
        seed_phase_drift: context("owner-sneak/check-rejection", "seed-phase-drift", "", "offline") => failed{"phase-check"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.exit_nonzero, true, c, "exit-nonzero")
            failed
            ok evidence exit_evidence => match call require_bool(got.report_absent, true, c, "report-absent")
                failed
                ok evidence absent_evidence => match call require_text(got.rejection_phase, "check", c, "phase-check")
                    failed
                    ok evidence phase_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m27_026: "m27-026" => ok test_case("owner-sneak/check-rejection", ["owner", "m27", "sneak"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-absent"), check_ref("phase-check")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m27-026"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("owner-sneak/check-rejection", ["owner", "m27", "sneak"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-absent"), check_ref("phase-check")], callable case_body)
