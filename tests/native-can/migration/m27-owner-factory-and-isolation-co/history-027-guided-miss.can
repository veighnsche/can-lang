package m27history027miss
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M27 HISTORY-027 "guided repair: partial-repair check rejection".
/// Source: tests/failure-conventions/owner_test.go symbol TestFactoryRepairGuided
/// (phase-1 predicates at owner_test.go:205-206 for status/report and :208
/// for the guided needle) plus retireConstructor (owner_test.go:132-191,
/// withFactoryArm=false leg).
/// Related fixtures: tests/failure-conventions/owner-setup/ staged then
/// repaired without the factory arm (ids::retired added to the registry,
/// ids provides, parse emits/match, handle_tier emits/rows/match, but no
/// `ids::retired => relay call fixture_id(1 / 0)` arm in handler.can).
/// Disposition: RETAIN. The partial leg observes a compiler-guided
/// rejection, not an assert report: the check names the new error.
/// Protects (this file): exit-nonzero, report-absent, diagnostic-present,
/// needle-exact, and streams-combined pins for the partial repair.
/// The full-repair green outcome (16 roots) lives in
/// history-027-repair-green.can; the extracted-helper snapshot identity
/// lives in history-027-helper-stable.can.
/// Variants: incomplete repair only (withFactoryArm=false). The complete
/// repair is the sibling file in this row, not this one; green-setup (023),
/// tainted frames (024), forged-owner (025) and sneak (026) variants are
/// other rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case owner-repair/guided-miss checks: exit-nonzero, report-absent,
/// diagnostic-present, needle-exact, streams-combined.
/// Facet map: exit-nonzero pins the Go `Status != 0` predicate without
/// over-pinning an exact code (exit_code stays observed evidence);
/// report-absent pins that no can.assertion-report decodes (Report == nil);
/// diagnostic-present pins that the combined output contains the needle
/// (owner_test.go:208 `strings.Contains`); needle-exact pins the exact
/// needle text "missing completion arm for ids::retired";
/// streams-combined pins the observation method (stdout and stderr are
/// both scanned, mirroring the Go `outcome.Stdout+outcome.Stderr`
/// concatenation). No full-output golden is pinned: the Go test pins the
/// substring only.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int exit_code
    bool exit_nonzero
    bool report_absent
    bool diagnostic_present
    str needle
    bool streams_combined
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("owner-repair/guided-miss", "default", "", "offline"), "exit-nonzero" => ok "case owner-repair/guided-miss variant default root exit-nonzero run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("owner-repair/guided-miss", "default", "", "offline"), "report-absent" => ok evidence("report-absent", "true", "true", true, "case owner-repair/guided-miss variant default root report-absent run offline")
        different: false, true, context("owner-repair/guided-miss", "default", "", "offline"), "report-absent" => failed{"report-absent"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "missing completion arm for ids::retired", "missing completion arm for ids::retired", context("owner-repair/guided-miss", "default", "", "offline"), "needle-exact" => ok evidence("needle-exact", "missing completion arm for ids::retired", "missing completion arm for ids::retired", true, "case owner-repair/guided-miss variant default root needle-exact run offline")
        different: "missing completion arm for ids::invalid", "missing completion arm for ids::retired", context("owner-repair/guided-miss", "default", "", "offline"), "needle-exact" => failed{"needle-exact"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(1, true, true, true, "missing completion arm for ids::retired", true)
        seed_suite_passed: "seed-suite-passed" => ok observation(0, false, false, false, "", false)
        seed_report_present: "seed-report-present" => ok observation(1, true, false, true, "missing completion arm for ids::retired", true)
        seed_diagnostic_missing: "seed-diagnostic-missing" => ok observation(1, true, true, false, "missing completion arm for ids::retired", true)
        seed_needle_drift: "seed-needle-drift" => ok observation(1, true, true, true, "missing completion arm for ids::invalid", true)
        seed_output_empty: "seed-output-empty" => ok observation(1, true, true, false, "", true)
        seed_single_stream: "seed-single-stream" => ok observation(1, true, true, true, "missing completion arm for ids::retired", false)
    match variant_id
        "seed-suite-passed" => ok observation(0, false, false, false, "", false)
        "seed-report-present" => ok observation(1, true, false, true, "missing completion arm for ids::retired", true)
        "seed-diagnostic-missing" => ok observation(1, true, true, false, "missing completion arm for ids::retired", true)
        "seed-needle-drift" => ok observation(1, true, true, true, "missing completion arm for ids::invalid", true)
        "seed-output-empty" => ok observation(1, true, true, false, "", true)
        "seed-single-stream" => ok observation(1, true, true, true, "missing completion arm for ids::retired", false)
        _ => ok observation(1, true, true, true, "missing completion arm for ids::retired", true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m27_027: "m27-027" => ok [check("exit-nonzero", "canlc assert exits nonzero on the partial repair"), check("report-absent", "no decoded assert report on the partial repair"), check("diagnostic-present", "combined output names the missing completion arm"), check("needle-exact", "diagnostic needle is missing completion arm for ids::retired"), check("streams-combined", "stdout and stderr are both scanned")]
        other: "nope" => ok []
    match scope is "m27-027"
        false => ok []
        true => ok [check("exit-nonzero", "canlc assert exits nonzero on the partial repair"), check("report-absent", "no decoded assert report on the partial repair"), check("diagnostic-present", "combined output names the missing completion arm"), check("needle-exact", "diagnostic needle is missing completion arm for ids::retired"), check("streams-combined", "stdout and stderr are both scanned")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "owner-repair/guided-miss" => ok [expected_check("exit-nonzero", "true"), expected_check("report-absent", "true"), expected_check("diagnostic-present", "true"), expected_check("needle-exact", "missing completion arm for ids::retired"), expected_check("streams-combined", "true")]
        unknown: "nope" => ok []
    match case is "owner-repair/guided-miss"
        false => ok []
        true => ok [expected_check("exit-nonzero", "true"), expected_check("report-absent", "true"), expected_check("diagnostic-present", "true"), expected_check("needle-exact", "missing completion arm for ids::retired"), expected_check("streams-combined", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("owner-repair/guided-miss", "default", "", "offline") => ok
        seed_suite_passed: context("owner-repair/guided-miss", "seed-suite-passed", "", "offline") => failed{"exit-nonzero"}
        seed_report_present: context("owner-repair/guided-miss", "seed-report-present", "", "offline") => failed{"report-absent"}
        seed_diagnostic_missing: context("owner-repair/guided-miss", "seed-diagnostic-missing", "", "offline") => failed{"diagnostic-present"}
        seed_needle_drift: context("owner-repair/guided-miss", "seed-needle-drift", "", "offline") => failed{"needle-exact"}
        seed_output_empty: context("owner-repair/guided-miss", "seed-output-empty", "", "offline") => failed{"diagnostic-present"}
        seed_single_stream: context("owner-repair/guided-miss", "seed-single-stream", "", "offline") => failed{"streams-combined"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.exit_nonzero, true, c, "exit-nonzero")
            failed
            ok evidence exit_evidence => match call require_bool(got.report_absent, true, c, "report-absent")
                failed
                ok evidence absent_evidence => match call require_bool(got.diagnostic_present, true, c, "diagnostic-present")
                    failed
                    ok evidence present_evidence => match call require_text(got.needle, "missing completion arm for ids::retired", c, "needle-exact")
                        failed
                        ok evidence needle_evidence => match call require_bool(got.streams_combined, true, c, "streams-combined")
                            failed
                            ok evidence streams_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m27_027: "m27-027" => ok test_case("owner-repair/guided-miss", ["owner", "m27", "repair"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-absent"), check_ref("diagnostic-present"), check_ref("needle-exact"), check_ref("streams-combined")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m27-027"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("owner-repair/guided-miss", ["owner", "m27", "repair"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-absent"), check_ref("diagnostic-present"), check_ref("needle-exact"), check_ref("streams-combined")], callable case_body)
