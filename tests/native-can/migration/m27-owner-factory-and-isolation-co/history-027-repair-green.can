package m27history027green
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M27 HISTORY-027 "guided repair: full-repair green suite".
/// Source: tests/failure-conventions/owner_test.go symbol TestFactoryRepairGuided
/// (phase-2 predicates at owner_test.go:217-221: requireGreen plus exactly
/// 16 roots) plus retireConstructor (owner_test.go:132-191,
/// withFactoryArm=true leg: the `ids::retired => relay call fixture_id(1 / 0)`
/// arm is added at owner_test.go:166-171).
/// Related fixtures: tests/failure-conventions/owner-setup/ staged then
/// fully repaired. The 16 roots are the 14 pre-repair roots (owner-setup
/// green, HISTORY-023) plus the two repair-added rows: `big: 150 =>
/// retired{150}` in ids parse asserts (owner_test.go:160) and `retired:
/// 150 => ids::retired{150}` in handle_tier asserts (owner_test.go:182).
/// Disposition: RETAIN. The full leg observes a green assert report with
/// an exact root count, the inverted polarity of the guided-miss leg.
/// Protects (this file): exit-zero, report-present, roots-sixteen, and
/// suite-passed pins for the full repair.
/// The partial-repair guided rejection lives in
/// history-027-guided-miss.can; the extracted-helper snapshot identity
/// lives in history-027-helper-stable.can.
/// Variants: complete repair only (withFactoryArm=true). The incomplete
/// repair is the sibling file in this row, not this one; green-setup (023),
/// tainted frames (024), forged-owner (025) and sneak (026) variants are
/// other rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case owner-repair/repair-green checks: exit-zero, report-present,
/// roots-sixteen, suite-passed.
/// Facet map: exit-zero pins the Go green predicate (requireGreen:
/// status 0); report-present pins that a can.assertion-report decodes,
/// the inverted polarity of the guided-miss report-absent check;
/// roots-sixteen pins the exact assertion-vector length 16
/// (owner_test.go:218 `wantRoots = 16`; root_count stays observed
/// evidence); suite-passed pins the decoded report Passed flag. No
/// per-root golden is pinned: the Go test pins the count only.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int exit_code
    bool exit_zero
    bool report_present
    int root_count
    bool roots_sixteen
    bool suite_passed
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("owner-repair/repair-green", "default", "", "offline"), "exit-zero" => ok "case owner-repair/repair-green variant default root exit-zero run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("owner-repair/repair-green", "default", "", "offline"), "report-present" => ok evidence("report-present", "true", "true", true, "case owner-repair/repair-green variant default root report-present run offline")
        different: false, true, context("owner-repair/repair-green", "default", "", "offline"), "report-present" => failed{"report-present"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "green", "green", context("owner-repair/repair-green", "default", "", "offline"), "suite-passed" => ok evidence("suite-passed", "green", "green", true, "case owner-repair/repair-green variant default root suite-passed run offline")
        different: "red", "green", context("owner-repair/repair-green", "default", "", "offline"), "suite-passed" => failed{"suite-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, true, true, 16, true, true)
        seed_suite_failed: "seed-suite-failed" => ok observation(1, false, true, 16, true, false)
        seed_report_absent: "seed-report-absent" => ok observation(0, true, false, 0, false, false)
        seed_roots_drift: "seed-roots-drift" => ok observation(0, true, true, 14, false, true)
        seed_roots_missing: "seed-roots-missing" => ok observation(0, true, true, 0, false, true)
        seed_suite_unpassed: "seed-suite-unpassed" => ok observation(0, true, true, 16, true, false)
    match variant_id
        "seed-suite-failed" => ok observation(1, false, true, 16, true, false)
        "seed-report-absent" => ok observation(0, true, false, 0, false, false)
        "seed-roots-drift" => ok observation(0, true, true, 14, false, true)
        "seed-roots-missing" => ok observation(0, true, true, 0, false, true)
        "seed-suite-unpassed" => ok observation(0, true, true, 16, true, false)
        _ => ok observation(0, true, true, 16, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m27_027: "m27-027" => ok [check("exit-zero", "canlc assert exits zero on the full repair"), check("report-present", "a decoded assert report exists on the full repair"), check("roots-sixteen", "the full repair yields exactly 16 roots"), check("suite-passed", "the decoded report passes on the full repair")]
        other: "nope" => ok []
    match scope is "m27-027"
        false => ok []
        true => ok [check("exit-zero", "canlc assert exits zero on the full repair"), check("report-present", "a decoded assert report exists on the full repair"), check("roots-sixteen", "the full repair yields exactly 16 roots"), check("suite-passed", "the decoded report passes on the full repair")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "owner-repair/repair-green" => ok [expected_check("exit-zero", "true"), expected_check("report-present", "true"), expected_check("roots-sixteen", "true"), expected_check("suite-passed", "true")]
        unknown: "nope" => ok []
    match case is "owner-repair/repair-green"
        false => ok []
        true => ok [expected_check("exit-zero", "true"), expected_check("report-present", "true"), expected_check("roots-sixteen", "true"), expected_check("suite-passed", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("owner-repair/repair-green", "default", "", "offline") => ok
        seed_suite_failed: context("owner-repair/repair-green", "seed-suite-failed", "", "offline") => failed{"exit-zero"}
        seed_report_absent: context("owner-repair/repair-green", "seed-report-absent", "", "offline") => failed{"report-present"}
        seed_roots_drift: context("owner-repair/repair-green", "seed-roots-drift", "", "offline") => failed{"roots-sixteen"}
        seed_roots_missing: context("owner-repair/repair-green", "seed-roots-missing", "", "offline") => failed{"roots-sixteen"}
        seed_suite_unpassed: context("owner-repair/repair-green", "seed-suite-unpassed", "", "offline") => failed{"suite-passed"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.exit_zero, true, c, "exit-zero")
            failed
            ok evidence exit_evidence => match call require_bool(got.report_present, true, c, "report-present")
                failed
                ok evidence present_evidence => match call require_bool(got.roots_sixteen, true, c, "roots-sixteen")
                    failed
                    ok evidence roots_evidence => match call require_bool(got.suite_passed, true, c, "suite-passed")
                        failed
                        ok evidence passed_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m27_027: "m27-027" => ok test_case("owner-repair/repair-green", ["owner", "m27", "repair"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-zero"), check_ref("report-present"), check_ref("roots-sixteen"), check_ref("suite-passed")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m27-027"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("owner-repair/repair-green", ["owner", "m27", "repair"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-zero"), check_ref("report-present"), check_ref("roots-sixteen"), check_ref("suite-passed")], callable case_body)
