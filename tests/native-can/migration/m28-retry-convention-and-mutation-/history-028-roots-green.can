package m28history028roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-028 "retry green: all 35 result-data roots pass".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestRetryConventionGreen (lines 14-26: stageProject "retry",
/// requireGreen, requireRealCan, wantRoots 35).
/// Related fixtures: tests/failure-conventions/retry/ (retry, profiles,
/// billing, app packages).
/// Disposition: MIGRATE. The shared result-data retry helper serves two
/// unrelated failure sets through one generic outcome; every one of the 35
/// assert rows across the four fixture packages is green.
/// Protects (this file): all 35 roots green plus the exact root-count pin.
/// Report shape and real-Can provenance live in
/// history-028-report-provenance.can; the shared-helper mechanics (FIFO
/// bound, failure sets, capture/re-raise, traces, fault transparency) live
/// in history-028-retry-mechanism.can.
/// Variants: positive retry project only (profiles + billing). Fixed-bound,
/// no-retry/over-attempt mutants and add-error legs are sibling M28 rows,
/// not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case retry/green-roots checks: root-count, helper-retry-green,
/// helper-canned-green, helper-tag-green, profiles-load-green,
/// profiles-adapter-green, profiles-fetch-green, profiles-reraise-green,
/// profiles-traced-green, profiles-roundtrip-green, profiles-fault-green,
/// billing-quote-green, billing-adapter-green, billing-fetch-green,
/// billing-reraise-green, app-empty.
/// Root map (retry fixture asserts; 5 helper + 18 profiles + 11 billing +
/// 1 app = 35, counted from the checked-in fixture sources):
/// retry::retry direct/single, retry::canned good/bad, retry::tag sample;
/// profiles::load hit/gone/shut, profiles::load_outcome hit/gone/shut,
/// profiles::fetch_profile flaky/down/first_try, profiles::read_profile
/// steady/locked/recover, profiles::fetch_traced traced_ok/traced_down,
/// profiles::read_traced roundtrip/roundtrip_denied, profiles::blast unit,
/// profiles::blast_kind kind; billing::quote sample/big/corrupt,
/// billing::quote_outcome decoded/too_big/bad_blob, billing::fetch_quote
/// flaky/down/first_try, billing::read_quote steady/refused; app::main empty.
/// Checks group by assert-owning function (H027 precedent: the Go test pins
/// the count only); every one of the 35 rows is named above and green below.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int root_count
    bool helper_retry_green
    bool helper_canned_green
    bool helper_tag_green
    bool profiles_load_green
    bool profiles_adapter_green
    bool profiles_fetch_green
    bool profiles_reraise_green
    bool profiles_traced_green
    bool profiles_roundtrip_green
    bool profiles_fault_green
    bool billing_quote_green
    bool billing_adapter_green
    bool billing_fetch_green
    bool billing_reraise_green
    bool app_empty
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("retry/green-roots", "default", "", "offline"), "root-count" => ok "case retry/green-roots variant default root root-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("retry/green-roots", "default", "", "offline"), "app-empty" => ok evidence("app-empty", "true", "true", true, "case retry/green-roots variant default root app-empty run offline")
        different: false, true, context("retry/green-roots", "default", "", "offline"), "app-empty" => failed{"app-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 35, 35, context("retry/green-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "35", "35", true, "case retry/green-roots variant default root root-count run offline")
        different: 34, 35, context("retry/green-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(35, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        seed_count_short: "seed-count-short" => ok observation(34, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        seed_helper_retry_fail: "seed-helper-retry-fail" => ok observation(35, false, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        seed_billing_reraise_fail: "seed-billing-reraise-fail" => ok observation(35, true, true, true, true, true, true, true, true, true, true, true, true, true, false, true)
    match variant_id
        "seed-count-short" => ok observation(34, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        "seed-helper-retry-fail" => ok observation(35, false, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        "seed-billing-reraise-fail" => ok observation(35, true, true, true, true, true, true, true, true, true, true, true, true, true, false, true)
        _ => ok observation(35, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
