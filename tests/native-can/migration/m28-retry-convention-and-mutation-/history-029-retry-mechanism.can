package m28history029mechanism
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-029 "retry-fixed green: fixed-bound mechanism (per-domain
/// bounds, explicit emits, layered consumer)".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestRetryFixedGreen (lines 28-31 doc comment: per-domain retry logic with
/// explicit emits bounds over the same two loaders, including one layered
/// bound-repetition consumer).
/// Related fixtures: tests/failure-conventions/retry-fixed/src/profiles/
/// profiles.can, tests/failure-conventions/retry-fixed/src/billing/
/// billing.can.
/// Disposition: MIGRATE. The mechanism file pins the static contracts that
/// make the 15 green roots meaningful: the same attempt logic rewritten per
/// domain because the emits bound cannot abstract over the error set.
/// Protects (this file): profiles::retry_load carries emits {unavailable,
/// forbidden} (profiles.can:28-29) while billing::retry_quote carries emits
/// {over_limit, codec::invalid_data} (billing.can:28-29), the same attempt
/// logic rewritten per domain (profiles.can:26-27); every fixed consumer
/// names its full bound verbatim in emits; profiles::read_via_service
/// repeats the store bound verbatim (profiles.can:54-57) and forwards arm by
/// arm (profiles.can:63-66); both retry entry points run with bound 2
/// (read_via_service calls retry_load(key, 2), profiles.can:63; both retry
/// assert rows pass remaining 2) and relay with remaining - 1 while
/// remaining > 1 (profiles.can:47-52, billing.can:44-49); terminal arms
/// rebuild error values with identity and payloads intact
/// (profiles.can:48/51, billing.can:45/48).
/// Per-function green flags live in history-029-roots-green.can; report shape
/// and provenance live in history-029-report-provenance.can.
/// Variants: positive retry-fixed project only (profiles + billing). The
/// shared-helper convention (H028), the no-retry/over-attempt mutants and
/// the add-error legs are sibling M28 rows: this file pins the green fixed
/// mechanism, not their rejections.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case retry-fixed/retry-mechanism checks: per-domain-bounds,
/// explicit-emits, layered-consumer, profiles-bound-two, billing-bound-two,
/// arms-faithful, profiles-bound.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool per_domain_bounds
    bool explicit_emits
    bool layered_consumer
    bool profiles_bound_two
    bool billing_bound_two
    bool arms_faithful
    str profiles_bound
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("retry-fixed/retry-mechanism", "default", "", "offline"), "per-domain-bounds" => ok "case retry-fixed/retry-mechanism variant default root per-domain-bounds run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("retry-fixed/retry-mechanism", "default", "", "offline"), "arms-faithful" => ok evidence("arms-faithful", "true", "true", true, "case retry-fixed/retry-mechanism variant default root arms-faithful run offline")
        different: false, true, context("retry-fixed/retry-mechanism", "default", "", "offline"), "arms-faithful" => failed{"arms-faithful"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "unavailable, forbidden", "unavailable, forbidden", context("retry-fixed/retry-mechanism", "default", "", "offline"), "profiles-bound" => ok evidence("profiles-bound", "unavailable, forbidden", "unavailable, forbidden", true, "case retry-fixed/retry-mechanism variant default root profiles-bound run offline")
        different: "unavailable", "unavailable, forbidden", context("retry-fixed/retry-mechanism", "default", "", "offline"), "profiles-bound" => failed{"profiles-bound"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, true, true, "unavailable, forbidden")
        seed_shared_helper: "seed-shared-helper" => ok observation(false, true, true, true, true, true, "unavailable, forbidden")
        seed_layered_strip: "seed-layered-strip" => ok observation(true, true, false, true, true, true, "unavailable, forbidden")
        seed_bound_drift: "seed-bound-drift" => ok observation(true, true, true, false, true, true, "unavailable, forbidden")
        seed_bound_missing: "seed-bound-missing" => ok observation(true, true, true, true, true, true, "")
    match variant_id
        "seed-shared-helper" => ok observation(false, true, true, true, true, true, "unavailable, forbidden")
        "seed-layered-strip" => ok observation(true, true, false, true, true, true, "unavailable, forbidden")
        "seed-bound-drift" => ok observation(true, true, true, false, true, true, "unavailable, forbidden")
        "seed-bound-missing" => ok observation(true, true, true, true, true, true, "")
        _ => ok observation(true, true, true, true, true, true, "unavailable, forbidden")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_029: "m28-029" => ok [check("per-domain-bounds", "retry logic is rewritten per domain over unrelated emits bounds"), check("explicit-emits", "each fixed consumer names its full bound verbatim in emits"), check("layered-consumer", "read_via_service repeats the store bound and forwards arm by arm"), check("profiles-bound-two", "profiles retry relays with bound 2 over two queued outcomes"), check("billing-bound-two", "billing retry relays with bound 2 over two queued outcomes"), check("arms-faithful", "terminal arms rebuild error values with identity and payloads intact"), check("profiles-bound", "profiles fixed bound pins unavailable plus forbidden")]
        other: "nope" => ok []
    match scope is "m28-029"
        false => ok []
        true => ok [check("per-domain-bounds", "retry logic is rewritten per domain over unrelated emits bounds"), check("explicit-emits", "each fixed consumer names its full bound verbatim in emits"), check("layered-consumer", "read_via_service repeats the store bound and forwards arm by arm"), check("profiles-bound-two", "profiles retry relays with bound 2 over two queued outcomes"), check("billing-bound-two", "billing retry relays with bound 2 over two queued outcomes"), check("arms-faithful", "terminal arms rebuild error values with identity and payloads intact"), check("profiles-bound", "profiles fixed bound pins unavailable plus forbidden")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "retry-fixed/retry-mechanism" => ok [expected_check("per-domain-bounds", "true"), expected_check("explicit-emits", "true"), expected_check("layered-consumer", "true"), expected_check("profiles-bound-two", "true"), expected_check("billing-bound-two", "true"), expected_check("arms-faithful", "true"), expected_check("profiles-bound", "unavailable, forbidden")]
        unknown: "nope" => ok []
    match case is "retry-fixed/retry-mechanism"
        false => ok []
        true => ok [expected_check("per-domain-bounds", "true"), expected_check("explicit-emits", "true"), expected_check("layered-consumer", "true"), expected_check("profiles-bound-two", "true"), expected_check("billing-bound-two", "true"), expected_check("arms-faithful", "true"), expected_check("profiles-bound", "unavailable, forbidden")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("retry-fixed/retry-mechanism", "default", "", "offline") => ok
        seed_shared_helper: context("retry-fixed/retry-mechanism", "seed-shared-helper", "", "offline") => failed{"per-domain-bounds"}
        seed_layered_strip: context("retry-fixed/retry-mechanism", "seed-layered-strip", "", "offline") => failed{"layered-consumer"}
        seed_bound_drift: context("retry-fixed/retry-mechanism", "seed-bound-drift", "", "offline") => failed{"profiles-bound-two"}
        seed_bound_missing: context("retry-fixed/retry-mechanism", "seed-bound-missing", "", "offline") => failed{"profiles-bound"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.per_domain_bounds, true, c, "per-domain-bounds")
            failed
            ok evidence bounds_evidence => match call require_bool(got.explicit_emits, true, c, "explicit-emits")
                failed
                ok evidence emits_evidence => match call require_bool(got.layered_consumer, true, c, "layered-consumer")
                    failed
                    ok evidence layered_evidence => match call require_bool(got.profiles_bound_two, true, c, "profiles-bound-two")
                        failed
                        ok evidence profiles_bound_two_evidence => match call require_bool(got.billing_bound_two, true, c, "billing-bound-two")
                            failed
                            ok evidence billing_bound_two_evidence => match call require_bool(got.arms_faithful, true, c, "arms-faithful")
                                failed
                                ok evidence arms_evidence => match call require_text(got.profiles_bound, "unavailable, forbidden", c, "profiles-bound")
                                    failed
                                    ok evidence bound_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_029: "m28-029" => ok test_case("retry-fixed/retry-mechanism", ["retry-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("per-domain-bounds"), check_ref("explicit-emits"), check_ref("layered-consumer"), check_ref("profiles-bound-two"), check_ref("billing-bound-two"), check_ref("arms-faithful"), check_ref("profiles-bound")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-029"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("retry-fixed/retry-mechanism", ["retry-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("per-domain-bounds"), check_ref("explicit-emits"), check_ref("layered-consumer"), check_ref("profiles-bound-two"), check_ref("billing-bound-two"), check_ref("arms-faithful"), check_ref("profiles-bound")], callable case_body)
