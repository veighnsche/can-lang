package m28history029roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-029 "retry-fixed green: all 15 fixed-bound roots pass".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestRetryFixedGreen (lines 28-43: stageProject "retry-fixed",
/// requireGreen, requireRealCan, wantRoots 15).
/// Related fixtures: tests/failure-conventions/retry-fixed/ (profiles,
/// billing, app packages; no shared helper package).
/// Disposition: MIGRATE. The fixed-bound comparison leg rewrites the retry
/// logic per domain over explicit emits bounds; every one of the 15 assert
/// rows across the three fixture packages is green.
/// Protects (this file): all 15 roots green plus the exact root-count pin.
/// Report shape and real-Can provenance live in
/// history-029-report-provenance.can; the fixed-bound mechanics (per-domain
/// bounds, explicit emits, layered consumer) live in
/// history-029-retry-mechanism.can.
/// Variants: positive retry-fixed project only (profiles + billing). The
/// result-data/shared-helper leg (H028), the no-retry/over-attempt mutants
/// and the add-error legs are sibling M28 rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case retry-fixed/green-roots checks: root-count, profiles-load-green,
/// profiles-retry-green, profiles-layered-green, billing-quote-green,
/// billing-retry-green, app-empty.
/// Root map (retry-fixed fixture asserts; 8 profiles + 6 billing + 1 app =
/// 15, counted from the checked-in fixture sources):
/// profiles::load hit/gone/shut, profiles::retry_load flaky/down/first_try,
/// profiles::read_via_service steady/locked; billing::quote
/// sample/big/corrupt, billing::retry_quote flaky/down/first_try; app::main
/// empty.
/// Checks group by assert-owning function (H027 precedent: the Go test pins
/// the count only); every one of the 15 rows is named above and green below.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int root_count
    bool profiles_load_green
    bool profiles_retry_green
    bool profiles_layered_green
    bool billing_quote_green
    bool billing_retry_green
    bool app_empty
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("retry-fixed/green-roots", "default", "", "offline"), "root-count" => ok "case retry-fixed/green-roots variant default root root-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("retry-fixed/green-roots", "default", "", "offline"), "app-empty" => ok evidence("app-empty", "true", "true", true, "case retry-fixed/green-roots variant default root app-empty run offline")
        different: false, true, context("retry-fixed/green-roots", "default", "", "offline"), "app-empty" => failed{"app-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 15, 15, context("retry-fixed/green-roots", "default", "", "offline"), "root-count" => ok evidence("root-count", "15", "15", true, "case retry-fixed/green-roots variant default root root-count run offline")
        different: 14, 15, context("retry-fixed/green-roots", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(15, true, true, true, true, true, true)
        seed_count_short: "seed-count-short" => ok observation(14, true, true, true, true, true, true)
        seed_profiles_retry_fail: "seed-profiles-retry-fail" => ok observation(15, true, false, true, true, true, true)
        seed_billing_retry_fail: "seed-billing-retry-fail" => ok observation(15, true, true, true, true, false, true)
    match variant_id
        "seed-count-short" => ok observation(14, true, true, true, true, true, true)
        "seed-profiles-retry-fail" => ok observation(15, true, false, true, true, true, true)
        "seed-billing-retry-fail" => ok observation(15, true, true, true, true, false, true)
        _ => ok observation(15, true, true, true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_029: "m28-029" => ok [check("root-count", "assert report carries exactly 15 roots"), check("profiles-load-green", "profiles::load hit/gone/shut roots green"), check("profiles-retry-green", "profiles::retry_load flaky/down/first_try roots green"), check("profiles-layered-green", "profiles::read_via_service steady/locked roots green"), check("billing-quote-green", "billing::quote sample/big/corrupt roots green"), check("billing-retry-green", "billing::retry_quote flaky/down/first_try roots green"), check("app-empty", "app::main empty root green")]
        other: "nope" => ok []
    match scope is "m28-029"
        false => ok []
        true => ok [check("root-count", "assert report carries exactly 15 roots"), check("profiles-load-green", "profiles::load hit/gone/shut roots green"), check("profiles-retry-green", "profiles::retry_load flaky/down/first_try roots green"), check("profiles-layered-green", "profiles::read_via_service steady/locked roots green"), check("billing-quote-green", "billing::quote sample/big/corrupt roots green"), check("billing-retry-green", "billing::retry_quote flaky/down/first_try roots green"), check("app-empty", "app::main empty root green")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "retry-fixed/green-roots" => ok [expected_check("root-count", "15"), expected_check("profiles-load-green", "true"), expected_check("profiles-retry-green", "true"), expected_check("profiles-layered-green", "true"), expected_check("billing-quote-green", "true"), expected_check("billing-retry-green", "true"), expected_check("app-empty", "true")]
        unknown: "nope" => ok []
    match case is "retry-fixed/green-roots"
        false => ok []
        true => ok [expected_check("root-count", "15"), expected_check("profiles-load-green", "true"), expected_check("profiles-retry-green", "true"), expected_check("profiles-layered-green", "true"), expected_check("billing-quote-green", "true"), expected_check("billing-retry-green", "true"), expected_check("app-empty", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("retry-fixed/green-roots", "default", "", "offline") => ok
        seed_count_short: context("retry-fixed/green-roots", "seed-count-short", "", "offline") => failed{"root-count"}
        seed_profiles_retry_fail: context("retry-fixed/green-roots", "seed-profiles-retry-fail", "", "offline") => failed{"profiles-retry-green"}
        seed_billing_retry_fail: context("retry-fixed/green-roots", "seed-billing-retry-fail", "", "offline") => failed{"billing-retry-green"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.root_count, 15, c, "root-count")
            failed
            ok evidence count_evidence => match call require_bool(got.profiles_load_green, true, c, "profiles-load-green")
                failed
                ok evidence profiles_load_green_evidence => match call require_bool(got.profiles_retry_green, true, c, "profiles-retry-green")
                    failed
                    ok evidence profiles_retry_green_evidence => match call require_bool(got.profiles_layered_green, true, c, "profiles-layered-green")
                        failed
                        ok evidence profiles_layered_green_evidence => match call require_bool(got.billing_quote_green, true, c, "billing-quote-green")
                            failed
                            ok evidence billing_quote_green_evidence => match call require_bool(got.billing_retry_green, true, c, "billing-retry-green")
                                failed
                                ok evidence billing_retry_green_evidence => match call require_bool(got.app_empty, true, c, "app-empty")
                                    failed
                                    ok evidence app_empty_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_029: "m28-029" => ok test_case("retry-fixed/green-roots", ["retry-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("root-count"), check_ref("profiles-load-green"), check_ref("profiles-retry-green"), check_ref("profiles-layered-green"), check_ref("billing-quote-green"), check_ref("billing-retry-green"), check_ref("app-empty")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-029"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("retry-fixed/green-roots", ["retry-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("root-count"), check_ref("profiles-load-green"), check_ref("profiles-retry-green"), check_ref("profiles-layered-green"), check_ref("billing-quote-green"), check_ref("billing-retry-green"), check_ref("app-empty")], callable case_body)
