package m28history030provenance
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-030 "no-retry mutant: report shape, exit-nonzero and
/// remainder-green".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestRetryNoRetryMutantFails (lines 45-87) plus harness runAssert
/// (tests/failure-conventions/).
/// Related fixtures: tests/failure-conventions/retry-negative/ (asserted
/// mutant project).
/// Disposition: MIGRATE. The mutant leg observes the assert report (canlc
/// assert exits nonzero, decoded report not passed), the report naming
/// exactly the eleven failing roots, and every one of the 24 remaining roots
/// passing.
/// Protects (this file): exit-nonzero, report-failed, names-eleven,
/// remainder-green pins.
/// The failing-eleven groups live in history-030-failing-eleven.can; the
/// mutant mechanics live in history-030-mutant-mechanism.can.
/// Variants: eleven named roots, unused fixture. The result-data green leg
/// (H028), the fixed-bound green leg (H029), the over-attempt mutant and the
/// add-error legs are sibling M28 rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case no-retry/report-provenance checks: exit-nonzero, report-failed,
/// names-eleven, remainder-green.
/// Facet map: exit-nonzero pins canlc assert nonzero status
/// (retry_test.go:55); report-failed pins the decoded can.assertion-report
/// not passed with the eleven failing entries; names-eleven pins the report
/// naming exactly the eleven wantFail root IDs (retry_test.go:58-70);
/// remainder-green pins every non-oracle entry passed (retry_test.go:82-84),
/// 24 of 35 total roots.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool exited_nonzero
    bool report_failed
    int named_fail_count
    bool remainder_green
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("no-retry/report-provenance", "default", "", "offline"), "exit-nonzero" => ok "case no-retry/report-provenance variant default root exit-nonzero run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("no-retry/report-provenance", "default", "", "offline"), "report-failed" => ok evidence("report-failed", "true", "true", true, "case no-retry/report-provenance variant default root report-failed run offline")
        different: false, true, context("no-retry/report-provenance", "default", "", "offline"), "report-failed" => failed{"report-failed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 11, 11, context("no-retry/report-provenance", "default", "", "offline"), "names-eleven" => ok evidence("names-eleven", "11", "11", true, "case no-retry/report-provenance variant default root names-eleven run offline")
        different: 10, 11, context("no-retry/report-provenance", "default", "", "offline"), "names-eleven" => failed{"names-eleven"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, 11, true)
        seed_zero_exit: "seed-zero-exit" => ok observation(false, true, 11, true)
        seed_report_pass: "seed-report-pass" => ok observation(true, false, 11, true)
        seed_ten_named: "seed-ten-named" => ok observation(true, true, 10, true)
        seed_remainder_fail: "seed-remainder-fail" => ok observation(true, true, 11, false)
    match variant_id
        "seed-zero-exit" => ok observation(false, true, 11, true)
        "seed-report-pass" => ok observation(true, false, 11, true)
        "seed-ten-named" => ok observation(true, true, 10, true)
        "seed-remainder-fail" => ok observation(true, true, 11, false)
        _ => ok observation(true, true, 11, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_030: "m28-030" => ok [check("exit-nonzero", "canlc assert exits nonzero"), check("report-failed", "decoded assert report not passed"), check("names-eleven", "report names exactly the eleven failing roots"), check("remainder-green", "all 24 non-oracle roots pass")]
        other: "nope" => ok []
    match scope is "m28-030"
        false => ok []
        true => ok [check("exit-nonzero", "canlc assert exits nonzero"), check("report-failed", "decoded assert report not passed"), check("names-eleven", "report names exactly the eleven failing roots"), check("remainder-green", "all 24 non-oracle roots pass")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "no-retry/report-provenance" => ok [expected_check("exit-nonzero", "true"), expected_check("report-failed", "true"), expected_check("names-eleven", "11"), expected_check("remainder-green", "true")]
        unknown: "nope" => ok []
    match case is "no-retry/report-provenance"
        false => ok []
        true => ok [expected_check("exit-nonzero", "true"), expected_check("report-failed", "true"), expected_check("names-eleven", "11"), expected_check("remainder-green", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("no-retry/report-provenance", "default", "", "offline") => ok
        seed_zero_exit: context("no-retry/report-provenance", "seed-zero-exit", "", "offline") => failed{"exit-nonzero"}
        seed_report_pass: context("no-retry/report-provenance", "seed-report-pass", "", "offline") => failed{"report-failed"}
        seed_ten_named: context("no-retry/report-provenance", "seed-ten-named", "", "offline") => failed{"names-eleven"}
        seed_remainder_fail: context("no-retry/report-provenance", "seed-remainder-fail", "", "offline") => failed{"remainder-green"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.exited_nonzero, true, c, "exit-nonzero")
            failed
            ok evidence exit_evidence => match call require_bool(got.report_failed, true, c, "report-failed")
                failed
                ok evidence failed_evidence => match call require_int(got.named_fail_count, 11, c, "names-eleven")
                    failed
                    ok evidence names_evidence => match call require_bool(got.remainder_green, true, c, "remainder-green")
                        failed
                        ok evidence remainder_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_030: "m28-030" => ok test_case("no-retry/report-provenance", ["no-retry", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-failed"), check_ref("names-eleven"), check_ref("remainder-green")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-030"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("no-retry/report-provenance", ["no-retry", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-failed"), check_ref("names-eleven"), check_ref("remainder-green")], callable case_body)
