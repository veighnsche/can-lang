package m28history031mechanism
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-031 "over-attempt mutant: two-row queue shape, mutated bound,
/// FIFO consumption, third-attempt exhaustion".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestRetryOverAttemptFails (lines 89-90 doc comment: three attempts
/// against two queued rows fail with missing fixture; lines 96-98
/// replaceOnce bound 2->3 on the profiles load_outcome consumer).
/// Related fixtures: tests/failure-conventions/retry/src/profiles/
/// profiles.can (load_outcome when-block lines 44-65: two rows per oracle
/// label; fetch_profile line 82: the single mutated relay site),
/// tests/failure-conventions/retry/src/billing/billing.can (quote_outcome
/// consumers stay at bound 2, line 72).
/// Disposition: MIGRATE. The mechanism file pins the static contracts that
/// make the four precise failures meaningful: each oracle label queues
/// exactly two fixture rows while the mutated profiles consumers relay
/// bound 3.
/// Protects (this file): every oracle label queues exactly two when-rows
/// (profiles load_outcome when-block: down/flaky/locked/recover/traced_ok/
/// traced_down/roundtrip/roundtrip_denied doubled); the mutated bound is 3
/// (profiles.can:82 relay, the only replaceOnce site; billing and blast
/// callables keep bound 2); attempts consume rows in FIFO order; the third
/// attempt finds no row and observes missing fixture; roots that resolve on
/// the second attempt (flaky, recover, traced_ok, roundtrip) stay green.
/// The exhausted-roots groups live in history-031-exhausted-roots.can;
/// report shape and remainder-green live in
/// history-031-report-provenance.can.
/// Variants: mutated retry count (bound 3 vs queued 2). The result-data
/// green leg (H028), the fixed-bound green leg (H029), the no-retry mutant
/// (H030) and the add-error legs are sibling M28 rows: this file pins the
/// over-attempt mechanism, not their outcomes.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case over-attempt/over-attempt-mechanism checks: queue-depth-two,
/// mutated-bound, fifo-order, third-missing, resolve-green.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int queued_rows
    int attempt_bound
    bool fifo_order
    bool third_missing
    bool resolve_green
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("over-attempt/over-attempt-mechanism", "default", "", "offline"), "queue-depth-two" => ok "case over-attempt/over-attempt-mechanism variant default root queue-depth-two run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("over-attempt/over-attempt-mechanism", "default", "", "offline"), "resolve-green" => ok evidence("resolve-green", "true", "true", true, "case over-attempt/over-attempt-mechanism variant default root resolve-green run offline")
        different: false, true, context("over-attempt/over-attempt-mechanism", "default", "", "offline"), "resolve-green" => failed{"resolve-green"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("over-attempt/over-attempt-mechanism", "default", "", "offline"), "queue-depth-two" => ok evidence("queue-depth-two", "2", "2", true, "case over-attempt/over-attempt-mechanism variant default root queue-depth-two run offline")
        different: 1, 2, context("over-attempt/over-attempt-mechanism", "default", "", "offline"), "queue-depth-two" => failed{"queue-depth-two"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(2, 3, true, true, true)
        seed_single_queued: "seed-single-queued" => ok observation(1, 3, true, true, true)
        seed_bound_two: "seed-bound-two" => ok observation(2, 2, true, true, true)
        seed_unordered: "seed-unordered" => ok observation(2, 3, false, true, true)
        seed_third_row: "seed-third-row" => ok observation(2, 3, true, false, true)
        seed_resolve_fail: "seed-resolve-fail" => ok observation(2, 3, true, true, false)
    match variant_id
        "seed-single-queued" => ok observation(1, 3, true, true, true)
        "seed-bound-two" => ok observation(2, 2, true, true, true)
        "seed-unordered" => ok observation(2, 3, false, true, true)
        "seed-third-row" => ok observation(2, 3, true, false, true)
        "seed-resolve-fail" => ok observation(2, 3, true, true, false)
        _ => ok observation(2, 3, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_031: "m28-031" => ok [check("queue-depth-two", "each oracle label queues exactly two when-rows"), check("mutated-bound", "profiles consumers relay bound 3"), check("fifo-order", "attempts consume queued rows in FIFO order"), check("third-missing", "the third attempt finds no row and observes missing fixture"), check("resolve-green", "resolve-on-second-attempt roots stay green")]
        other: "nope" => ok []
    match scope is "m28-031"
        false => ok []
        true => ok [check("queue-depth-two", "each oracle label queues exactly two when-rows"), check("mutated-bound", "profiles consumers relay bound 3"), check("fifo-order", "attempts consume queued rows in FIFO order"), check("third-missing", "the third attempt finds no row and observes missing fixture"), check("resolve-green", "resolve-on-second-attempt roots stay green")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "over-attempt/over-attempt-mechanism" => ok [expected_check("queue-depth-two", "2"), expected_check("mutated-bound", "3"), expected_check("fifo-order", "true"), expected_check("third-missing", "true"), expected_check("resolve-green", "true")]
        unknown: "nope" => ok []
    match case is "over-attempt/over-attempt-mechanism"
        false => ok []
        true => ok [expected_check("queue-depth-two", "2"), expected_check("mutated-bound", "3"), expected_check("fifo-order", "true"), expected_check("third-missing", "true"), expected_check("resolve-green", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("over-attempt/over-attempt-mechanism", "default", "", "offline") => ok
        seed_single_queued: context("over-attempt/over-attempt-mechanism", "seed-single-queued", "", "offline") => failed{"queue-depth-two"}
        seed_bound_two: context("over-attempt/over-attempt-mechanism", "seed-bound-two", "", "offline") => failed{"mutated-bound"}
        seed_unordered: context("over-attempt/over-attempt-mechanism", "seed-unordered", "", "offline") => failed{"fifo-order"}
        seed_third_row: context("over-attempt/over-attempt-mechanism", "seed-third-row", "", "offline") => failed{"third-missing"}
        seed_resolve_fail: context("over-attempt/over-attempt-mechanism", "seed-resolve-fail", "", "offline") => failed{"resolve-green"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.queued_rows, 2, c, "queue-depth-two")
            failed
            ok evidence depth_evidence => match call require_int(got.attempt_bound, 3, c, "mutated-bound")
                failed
                ok evidence bound_evidence => match call require_bool(got.fifo_order, true, c, "fifo-order")
                    failed
                    ok evidence order_evidence => match call require_bool(got.third_missing, true, c, "third-missing")
                        failed
                        ok evidence third_evidence => match call require_bool(got.resolve_green, true, c, "resolve-green")
                            failed
                            ok evidence resolve_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_031: "m28-031" => ok test_case("over-attempt/over-attempt-mechanism", ["over-attempt", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("queue-depth-two"), check_ref("mutated-bound"), check_ref("fifo-order"), check_ref("third-missing"), check_ref("resolve-green")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-031"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("over-attempt/over-attempt-mechanism", ["over-attempt", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("queue-depth-two"), check_ref("mutated-bound"), check_ref("fifo-order"), check_ref("third-missing"), check_ref("resolve-green")], callable case_body)
