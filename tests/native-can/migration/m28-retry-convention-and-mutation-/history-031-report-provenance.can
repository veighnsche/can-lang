package m28history031provenance
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-031 "over-attempt mutant: report shape, exit-nonzero and
/// remainder-green".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestRetryOverAttemptFails (lines 91-126) plus harness runAssert
/// (tests/failure-conventions/).
/// Related fixtures: tests/failure-conventions/retry/ (asserted mutant
/// project: bound 2->3 in src/profiles/profiles.can).
/// Disposition: MIGRATE. The mutant leg observes the assert report (canlc
/// assert exits nonzero, decoded report not passed), the report naming
/// exactly the four exhausted roots, and every one of the 31 remaining roots
/// passing.
/// Protects (this file): exit-nonzero, report-failed, names-four,
/// remainder-green pins.
/// The exhausted-roots groups live in history-031-exhausted-roots.can; the
/// over-attempt mechanics live in history-031-over-attempt-mechanism.can.
/// Variants: mutated retry count (bound 3 vs queued 2). The result-data
/// green leg (H028), the fixed-bound green leg (H029), the no-retry mutant
/// (H030) and the add-error legs are sibling M28 rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case over-attempt/report-provenance checks: exit-nonzero, report-failed,
/// names-four, remainder-green.
/// Facet map: exit-nonzero pins canlc assert nonzero status
/// (retry_test.go:100); report-failed pins the decoded can.assertion-report
/// not passed with the four failing entries; names-four pins the report
/// naming exactly the four exhausted root IDs (retry_test.go:115-120);
/// remainder-green pins every non-exhausted entry passed
/// (retry_test.go:104-106 seen-map shape plus the green remainder),
/// 31 of 35 total roots.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool exited_nonzero
    bool report_failed
    int named_fail_count
    bool remainder_green
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("over-attempt/report-provenance", "default", "", "offline"), "exit-nonzero" => ok "case over-attempt/report-provenance variant default root exit-nonzero run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("over-attempt/report-provenance", "default", "", "offline"), "report-failed" => ok evidence("report-failed", "true", "true", true, "case over-attempt/report-provenance variant default root report-failed run offline")
        different: false, true, context("over-attempt/report-provenance", "default", "", "offline"), "report-failed" => failed{"report-failed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("over-attempt/report-provenance", "default", "", "offline"), "names-four" => ok evidence("names-four", "4", "4", true, "case over-attempt/report-provenance variant default root names-four run offline")
        different: 3, 4, context("over-attempt/report-provenance", "default", "", "offline"), "names-four" => failed{"names-four"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, 4, true)
        seed_zero_exit: "seed-zero-exit" => ok observation(false, true, 4, true)
        seed_report_pass: "seed-report-pass" => ok observation(true, false, 4, true)
        seed_three_named: "seed-three-named" => ok observation(true, true, 3, true)
        seed_remainder_fail: "seed-remainder-fail" => ok observation(true, true, 4, false)
    match variant_id
        "seed-zero-exit" => ok observation(false, true, 4, true)
        "seed-report-pass" => ok observation(true, false, 4, true)
        "seed-three-named" => ok observation(true, true, 3, true)
        "seed-remainder-fail" => ok observation(true, true, 4, false)
        _ => ok observation(true, true, 4, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_031: "m28-031" => ok [check("exit-nonzero", "canlc assert exits nonzero"), check("report-failed", "decoded assert report not passed"), check("names-four", "report names exactly the four exhausted roots"), check("remainder-green", "all 31 non-exhausted roots pass")]
        other: "nope" => ok []
    match scope is "m28-031"
        false => ok []
        true => ok [check("exit-nonzero", "canlc assert exits nonzero"), check("report-failed", "decoded assert report not passed"), check("names-four", "report names exactly the four exhausted roots"), check("remainder-green", "all 31 non-exhausted roots pass")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "over-attempt/report-provenance" => ok [expected_check("exit-nonzero", "true"), expected_check("report-failed", "true"), expected_check("names-four", "4"), expected_check("remainder-green", "true")]
        unknown: "nope" => ok []
    match case is "over-attempt/report-provenance"
        false => ok []
        true => ok [expected_check("exit-nonzero", "true"), expected_check("report-failed", "true"), expected_check("names-four", "4"), expected_check("remainder-green", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("over-attempt/report-provenance", "default", "", "offline") => ok
        seed_zero_exit: context("over-attempt/report-provenance", "seed-zero-exit", "", "offline") => failed{"exit-nonzero"}
        seed_report_pass: context("over-attempt/report-provenance", "seed-report-pass", "", "offline") => failed{"report-failed"}
        seed_three_named: context("over-attempt/report-provenance", "seed-three-named", "", "offline") => failed{"names-four"}
        seed_remainder_fail: context("over-attempt/report-provenance", "seed-remainder-fail", "", "offline") => failed{"remainder-green"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.exited_nonzero, true, c, "exit-nonzero")
            failed
            ok evidence exit_evidence => match call require_bool(got.report_failed, true, c, "report-failed")
                failed
                ok evidence failed_evidence => match call require_int(got.named_fail_count, 4, c, "names-four")
                    failed
                    ok evidence names_evidence => match call require_bool(got.remainder_green, true, c, "remainder-green")
                        failed
                        ok evidence remainder_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_031: "m28-031" => ok test_case("over-attempt/report-provenance", ["over-attempt", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-failed"), check_ref("names-four"), check_ref("remainder-green")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-031"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("over-attempt/report-provenance", ["over-attempt", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-nonzero"), check_ref("report-failed"), check_ref("names-four"), check_ref("remainder-green")], callable case_body)
