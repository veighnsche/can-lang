package m28history032mechanism
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-032 "add-error surgery: isolation mechanism (byte-identical
/// unrelated files, surgery scope, suspended-leg facets)".
/// Source: tests/failure-conventions/retry_test.go symbols
/// addSuspendedToResultData (lines 131-279: the 17-site suspended surgery)
/// and TestAddErrorIsolationResultData (lines 285-305: snapshotFiles
/// before/after plus requireUnchanged over can.project.json,
/// src/app/main.can, src/retry/retry.can and src/billing/billing.can).
/// Related fixtures: tests/failure-conventions/retry/can.errors.json,
/// tests/failure-conventions/retry/src/profiles/profiles.can (the two
/// changed files), and the four requireUnchanged paths (the byte-identical
/// files).
/// Disposition: MIGRATE. The mechanism file pins the static contracts that
/// make the 40 green roots meaningful: the surgery touches exactly the
/// registry plus profiles sources, every unrelated file stays byte-identical,
/// and the new suspended leg is plumbed end to end (registered, emitted,
/// adapted).
/// Protects (this file): app-identical, retry-identical,
/// billing-identical and manifest-identical pin the four requireUnchanged
/// paths byte-identical across the surgery snapshots (retry_test.go:298-303);
/// surgery-scope pins the changed set to exactly can.errors.json plus
/// src/profiles/profiles.can (the only two paths named by the 17
/// replaceOnce sites, retry_test.go:133-277); suspended-registered pins the
/// registry gain of profiles::suspended (retry_test.go:133-135);
/// suspended-emitted pins the load_failure variant arm plus the load,
/// read_profile and read_traced emits gains (retry_test.go:147-158,
/// 211-225, 245-258); suspended-adapted pins the load_outcome adapter arm
/// plus the read_profile and read_traced re-raise arms rebuilding the
/// suspended value with identity and payload intact (retry_test.go:187-196,
/// 233-244, 266-277).
/// Per-function green flags live in history-032-roots-green.can; report shape
/// and provenance live in history-032-report-provenance.can.
/// Variants: add-error surgery on the result-data project only (profiles
/// gains a third error). The green legs (H028/H029), the no-retry/over-attempt
/// mutants (H030/H031) and the fixed-bound add-error leg are sibling M28
/// rows, not this one: this file pins surgical isolation, not their edits.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case add-error/isolation-mechanism checks: app-identical,
/// retry-identical, billing-identical, manifest-identical, surgery-scope,
/// suspended-registered, suspended-emitted, suspended-adapted.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool app_identical
    bool retry_identical
    bool billing_identical
    bool manifest_identical
    str changed_scope
    bool suspended_registered
    bool suspended_emitted
    bool suspended_adapted
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("add-error/isolation-mechanism", "default", "", "offline"), "app-identical" => ok "case add-error/isolation-mechanism variant default root app-identical run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("add-error/isolation-mechanism", "default", "", "offline"), "app-identical" => ok evidence("app-identical", "true", "true", true, "case add-error/isolation-mechanism variant default root app-identical run offline")
        different: false, true, context("add-error/isolation-mechanism", "default", "", "offline"), "app-identical" => failed{"app-identical"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can.errors.json + src/profiles/profiles.can", "can.errors.json + src/profiles/profiles.can", context("add-error/isolation-mechanism", "default", "", "offline"), "surgery-scope" => ok evidence("surgery-scope", "can.errors.json + src/profiles/profiles.can", "can.errors.json + src/profiles/profiles.can", true, "case add-error/isolation-mechanism variant default root surgery-scope run offline")
        different: "", "can.errors.json + src/profiles/profiles.can", context("add-error/isolation-mechanism", "default", "", "offline"), "surgery-scope" => failed{"surgery-scope"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
        seed_app_drift: "seed-app-drift" => ok observation(false, true, true, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
        seed_retry_drift: "seed-retry-drift" => ok observation(true, false, true, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
        seed_billing_drift: "seed-billing-drift" => ok observation(true, true, false, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
        seed_scope_creep: "seed-scope-creep" => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can + src/billing/billing.can", true, true, true)
        seed_scope_missing: "seed-scope-missing" => ok observation(true, true, true, true, "", true, true, true)
        seed_leg_unregistered: "seed-leg-unregistered" => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can", false, false, false)
        seed_leg_unadapted: "seed-leg-unadapted" => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can", true, true, false)
    match variant_id
        "seed-app-drift" => ok observation(false, true, true, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
        "seed-retry-drift" => ok observation(true, false, true, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
        "seed-billing-drift" => ok observation(true, true, false, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
        "seed-scope-creep" => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can + src/billing/billing.can", true, true, true)
        "seed-scope-missing" => ok observation(true, true, true, true, "", true, true, true)
        "seed-leg-unregistered" => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can", false, false, false)
        "seed-leg-unadapted" => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can", true, true, false)
        _ => ok observation(true, true, true, true, "can.errors.json + src/profiles/profiles.can", true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_032: "m28-032" => ok [check("app-identical", "src/app/main.can byte-identical across the surgery"), check("retry-identical", "src/retry/retry.can byte-identical across the surgery"), check("billing-identical", "src/billing/billing.can byte-identical across the surgery"), check("manifest-identical", "can.project.json byte-identical across the surgery"), check("surgery-scope", "changed set is exactly can.errors.json plus src/profiles/profiles.can"), check("suspended-registered", "registry gains profiles::suspended"), check("suspended-emitted", "load_failure variant plus load/read_profile/read_traced emits gain suspended"), check("suspended-adapted", "adapter and re-raise arms rebuild the suspended value intact")]
        other: "nope" => ok []
    match scope is "m28-032"
        false => ok []
        true => ok [check("app-identical", "src/app/main.can byte-identical across the surgery"), check("retry-identical", "src/retry/retry.can byte-identical across the surgery"), check("billing-identical", "src/billing/billing.can byte-identical across the surgery"), check("manifest-identical", "can.project.json byte-identical across the surgery"), check("surgery-scope", "changed set is exactly can.errors.json plus src/profiles/profiles.can"), check("suspended-registered", "registry gains profiles::suspended"), check("suspended-emitted", "load_failure variant plus load/read_profile/read_traced emits gain suspended"), check("suspended-adapted", "adapter and re-raise arms rebuild the suspended value intact")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "add-error/isolation-mechanism" => ok [expected_check("app-identical", "true"), expected_check("retry-identical", "true"), expected_check("billing-identical", "true"), expected_check("manifest-identical", "true"), expected_check("surgery-scope", "can.errors.json + src/profiles/profiles.can"), expected_check("suspended-registered", "true"), expected_check("suspended-emitted", "true"), expected_check("suspended-adapted", "true")]
        unknown: "nope" => ok []
    match case is "add-error/isolation-mechanism"
        false => ok []
        true => ok [expected_check("app-identical", "true"), expected_check("retry-identical", "true"), expected_check("billing-identical", "true"), expected_check("manifest-identical", "true"), expected_check("surgery-scope", "can.errors.json + src/profiles/profiles.can"), expected_check("suspended-registered", "true"), expected_check("suspended-emitted", "true"), expected_check("suspended-adapted", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("add-error/isolation-mechanism", "default", "", "offline") => ok
        seed_app_drift: context("add-error/isolation-mechanism", "seed-app-drift", "", "offline") => failed{"app-identical"}
        seed_retry_drift: context("add-error/isolation-mechanism", "seed-retry-drift", "", "offline") => failed{"retry-identical"}
        seed_billing_drift: context("add-error/isolation-mechanism", "seed-billing-drift", "", "offline") => failed{"billing-identical"}
        seed_scope_creep: context("add-error/isolation-mechanism", "seed-scope-creep", "", "offline") => failed{"surgery-scope"}
        seed_scope_missing: context("add-error/isolation-mechanism", "seed-scope-missing", "", "offline") => failed{"surgery-scope"}
        seed_leg_unregistered: context("add-error/isolation-mechanism", "seed-leg-unregistered", "", "offline") => failed{"suspended-registered"}
        seed_leg_unadapted: context("add-error/isolation-mechanism", "seed-leg-unadapted", "", "offline") => failed{"suspended-adapted"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.app_identical, true, c, "app-identical")
            failed
            ok evidence app_evidence => match call require_bool(got.retry_identical, true, c, "retry-identical")
                failed
                ok evidence retry_evidence => match call require_bool(got.billing_identical, true, c, "billing-identical")
                    failed
                    ok evidence billing_evidence => match call require_bool(got.manifest_identical, true, c, "manifest-identical")
                        failed
                        ok evidence manifest_evidence => match call require_text(got.changed_scope, "can.errors.json + src/profiles/profiles.can", c, "surgery-scope")
                            failed
                            ok evidence scope_evidence => match call require_bool(got.suspended_registered, true, c, "suspended-registered")
                                failed
                                ok evidence registered_evidence => match call require_bool(got.suspended_emitted, true, c, "suspended-emitted")
                                    failed
                                    ok evidence emitted_evidence => match call require_bool(got.suspended_adapted, true, c, "suspended-adapted")
                                        failed
                                        ok evidence adapted_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_032: "m28-032" => ok test_case("add-error/isolation-mechanism", ["add-error", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("app-identical"), check_ref("retry-identical"), check_ref("billing-identical"), check_ref("manifest-identical"), check_ref("surgery-scope"), check_ref("suspended-registered"), check_ref("suspended-emitted"), check_ref("suspended-adapted")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-032"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("add-error/isolation-mechanism", ["add-error", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("app-identical"), check_ref("retry-identical"), check_ref("billing-identical"), check_ref("manifest-identical"), check_ref("surgery-scope"), check_ref("suspended-registered"), check_ref("suspended-emitted"), check_ref("suspended-adapted")], callable case_body)
