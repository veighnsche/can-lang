    emits {}
    given
        str case
    asserts
        known: "add-error/roots-green" => ok [expected_check("root-count", "40"), expected_check("helper-retry-green", "true"), expected_check("helper-canned-green", "true"), expected_check("helper-tag-green", "true"), expected_check("profiles-load-green", "true"), expected_check("profiles-adapter-green", "true"), expected_check("profiles-fetch-green", "true"), expected_check("profiles-reraise-green", "true"), expected_check("profiles-traced-green", "true"), expected_check("profiles-roundtrip-green", "true"), expected_check("profiles-fault-green", "true"), expected_check("billing-quote-green", "true"), expected_check("billing-adapter-green", "true"), expected_check("billing-fetch-green", "true"), expected_check("billing-reraise-green", "true"), expected_check("app-empty", "true"), expected_check("suspended-leg-green", "true")]
