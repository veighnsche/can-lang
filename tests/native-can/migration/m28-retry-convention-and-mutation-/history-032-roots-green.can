    match case is "add-error/roots-green"
        false => ok []
        true => ok [expected_check("root-count", "40"), expected_check("helper-retry-green", "true"), expected_check("helper-canned-green", "true"), expected_check("helper-tag-green", "true"), expected_check("profiles-load-green", "true"), expected_check("profiles-adapter-green", "true"), expected_check("profiles-fetch-green", "true"), expected_check("profiles-reraise-green", "true"), expected_check("profiles-traced-green", "true"), expected_check("profiles-roundtrip-green", "true"), expected_check("profiles-fault-green", "true"), expected_check("billing-quote-green", "true"), expected_check("billing-adapter-green", "true"), expected_check("billing-fetch-green", "true"), expected_check("billing-reraise-green", "true"), expected_check("app-empty", "true"), expected_check("suspended-leg-green", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("add-error/roots-green", "default", "", "offline") => ok
        seed_thirty_five: context("add-error/roots-green", "seed-thirty-five", "", "offline") => failed{"root-count"}
        seed_thirty_nine: context("add-error/roots-green", "seed-thirty-nine", "", "offline") => failed{"root-count"}
        seed_suspended_red: context("add-error/roots-green", "seed-suspended-red", "", "offline") => failed{"suspended-leg-green"}
        seed_billing_reraise_fail: context("add-error/roots-green", "seed-billing-reraise-fail", "", "offline") => failed{"billing-reraise-green"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.root_count, 40, c, "root-count")
            failed
            ok evidence count_evidence => match call require_bool(got.helper_retry_green, true, c, "helper-retry-green")
                failed
                ok evidence helper_retry_green_evidence => match call require_bool(got.helper_canned_green, true, c, "helper-canned-green")
                    failed
                    ok evidence helper_canned_green_evidence => match call require_bool(got.helper_tag_green, true, c, "helper-tag-green")
                        failed
                        ok evidence helper_tag_green_evidence => match call require_bool(got.profiles_load_green, true, c, "profiles-load-green")
                            failed
                            ok evidence profiles_load_green_evidence => match call require_bool(got.profiles_adapter_green, true, c, "profiles-adapter-green")
                                failed
                                ok evidence profiles_adapter_green_evidence => match call require_bool(got.profiles_fetch_green, true, c, "profiles-fetch-green")
                                    failed
                                    ok evidence profiles_fetch_green_evidence => match call require_bool(got.profiles_reraise_green, true, c, "profiles-reraise-green")
                                        failed
                                        ok evidence profiles_reraise_green_evidence => match call require_bool(got.profiles_traced_green, true, c, "profiles-traced-green")
                                            failed
                                            ok evidence profiles_traced_green_evidence => match call require_bool(got.profiles_roundtrip_green, true, c, "profiles-roundtrip-green")
                                                failed
                                                ok evidence profiles_roundtrip_green_evidence => match call require_bool(got.profiles_fault_green, true, c, "profiles-fault-green")
                                                    failed
                                                    ok evidence profiles_fault_green_evidence => match call require_bool(got.billing_quote_green, true, c, "billing-quote-green")
                                                        failed
                                                        ok evidence billing_quote_green_evidence => match call require_bool(got.billing_adapter_green, true, c, "billing-adapter-green")
                                                            failed
                                                            ok evidence billing_adapter_green_evidence => match call require_bool(got.billing_fetch_green, true, c, "billing-fetch-green")
                                                                failed
                                                                ok evidence billing_fetch_green_evidence => match call require_bool(got.billing_reraise_green, true, c, "billing-reraise-green")
                                                                    failed
                                                                    ok evidence billing_reraise_green_evidence => match call require_bool(got.app_empty, true, c, "app-empty")
                                                                        failed
                                                                        ok evidence app_empty_evidence => match call require_bool(got.suspended_leg_green, true, c, "suspended-leg-green")
                                                                            failed
                                                                            ok evidence suspended_leg_green_evidence => ok
