    emits {}
    given
        str scope
    asserts
        m28_032: "m28-032" => ok test_case("add-error/roots-green", ["add-error", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("root-count"), check_ref("helper-retry-green"), check_ref("helper-canned-green"), check_ref("helper-tag-green"), check_ref("profiles-load-green"), check_ref("profiles-adapter-green"), check_ref("profiles-fetch-green"), check_ref("profiles-reraise-green"), check_ref("profiles-traced-green"), check_ref("profiles-roundtrip-green"), check_ref("profiles-fault-green"), check_ref("billing-quote-green"), check_ref("billing-adapter-green"), check_ref("billing-fetch-green"), check_ref("billing-reraise-green"), check_ref("app-empty"), check_ref("suspended-leg-green")], callable case_body)
