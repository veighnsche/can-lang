package m28history032roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-032 "add-error surgery: all 40 result-data roots pass".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestAddErrorIsolationResultData (lines 285-305: stageProject "retry",
/// addSuspendedToResultData lines 131-279, wantRoots 40) plus
/// requireUnchanged over can.project.json, src/app/main.can,
/// src/retry/retry.can and src/billing/billing.can (lines 298-303).
/// Related fixtures: tests/failure-conventions/retry/ (retry, profiles,
/// billing, app packages).
/// Disposition: MIGRATE. The add-error leg applies the 17-site suspended
/// surgery (1 registry site plus 16 profiles.can sites) to a staged copy of
/// the H028 retry project: profiles gains a third error plus its adapter
/// arm, loader behavior and roots, and every one of the 40 assert rows
/// across the four fixture packages is green.
/// Protects (this file): all 40 roots green plus the exact root-count pin
/// and the new suspended-leg green group.
/// Report shape and real-Can provenance live in
/// history-032-report-provenance.can; the surgical-isolation mechanics
/// (byte-identical unrelated files, surgery scope, suspended-leg facets)
/// live in history-032-isolation-mechanism.can.
/// Variants: add-error surgery on the result-data project only. The green
/// legs (H028/H029), the no-retry/over-attempt mutants (H030/H031) and the
/// fixed-bound add-error leg are sibling M28 rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case add-error/roots-green checks: root-count, helper-retry-green,
/// helper-canned-green, helper-tag-green, profiles-load-green,
/// profiles-adapter-green, profiles-fetch-green, profiles-reraise-green,
/// profiles-traced-green, profiles-roundtrip-green, profiles-fault-green,
/// billing-quote-green, billing-adapter-green, billing-fetch-green,
/// billing-reraise-green, app-empty, suspended-leg-green.
/// Root map (retry fixture asserts after surgery; 5 helper + 23 profiles +
/// 11 billing + 1 app = 40: the 35 H028 rows plus 5 surgery rows, counted
/// from the checked-in fixture sources and the replaceOnce right-hand
/// sides in retry_test.go:159-265):
/// retry::retry direct/single, retry::canned good/bad, retry::tag sample;
/// profiles::load hit/gone/shut/paused, profiles::load_outcome
/// hit/gone/shut/paused, profiles::fetch_profile flaky/down/first_try/on_hold,
/// profiles::read_profile steady/locked/recover/shelved,
/// profiles::fetch_traced traced_ok/traced_down (no new row),
/// profiles::read_traced roundtrip/roundtrip_denied/shelved_deep,
/// profiles::blast unit, profiles::blast_kind kind; billing::quote
/// sample/big/corrupt, billing::quote_outcome decoded/too_big/bad_blob,
/// billing::fetch_quote flaky/down/first_try, billing::read_quote
/// steady/refused; app::main empty.
/// Checks group by assert-owning function (H027 precedent: the Go test pins
/// the count only); every one of the 40 rows is named above and green below.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int root_count
    bool helper_retry_green
    bool helper_canned_green
    bool helper_tag_green
    bool profiles_load_green
    bool profiles_adapter_green
    bool profiles_fetch_green
    bool profiles_reraise_green
    bool profiles_traced_green
    bool profiles_roundtrip_green
    bool profiles_fault_green
    bool billing_quote_green
    bool billing_adapter_green
    bool billing_fetch_green
    bool billing_reraise_green
    bool app_empty
    bool suspended_leg_green
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("add-error/roots-green", "default", "", "offline"), "root-count" => ok "case add-error/roots-green variant default root root-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("add-error/roots-green", "default", "", "offline"), "app-empty" => ok evidence("app-empty", "true", "true", true, "case add-error/roots-green variant default root app-empty run offline")
        different: false, true, context("add-error/roots-green", "default", "", "offline"), "app-empty" => failed{"app-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 40, 40, context("add-error/roots-green", "default", "", "offline"), "root-count" => ok evidence("root-count", "40", "40", true, "case add-error/roots-green variant default root root-count run offline")
        different: 35, 40, context("add-error/roots-green", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(40, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        seed_thirty_five: "seed-thirty-five" => ok observation(35, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        seed_thirty_nine: "seed-thirty-nine" => ok observation(39, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        seed_suspended_red: "seed-suspended-red" => ok observation(40, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        seed_billing_reraise_fail: "seed-billing-reraise-fail" => ok observation(40, true, true, true, true, true, true, true, true, true, true, true, true, true, false, true, true)
    match variant_id
        "seed-thirty-five" => ok observation(35, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        "seed-thirty-nine" => ok observation(39, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
        "seed-suspended-red" => ok observation(40, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false)
        "seed-billing-reraise-fail" => ok observation(40, true, true, true, true, true, true, true, true, true, true, true, true, true, false, true, true)
        _ => ok observation(40, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true)
