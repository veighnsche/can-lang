    asserts
        m28_032: "m28-032" => ok [check("root-count", "assert report carries exactly 40 roots"), check("helper-retry-green", "retry::retry direct/single roots green"), check("helper-canned-green", "retry::canned good/bad roots green"), check("helper-tag-green", "retry::tag sample root green"), check("profiles-load-green", "profiles::load hit/gone/shut/paused roots green"), check("profiles-adapter-green", "profiles::load_outcome hit/gone/shut/paused roots green"), check("profiles-fetch-green", "profiles::fetch_profile flaky/down/first_try/on_hold roots green"), check("profiles-reraise-green", "profiles::read_profile steady/locked/recover/shelved roots green"), check("profiles-traced-green", "profiles::fetch_traced traced_ok/traced_down roots green"), check("profiles-roundtrip-green", "profiles::read_traced roundtrip/roundtrip_denied/shelved_deep roots green"), check("profiles-fault-green", "profiles::blast unit and blast_kind kind roots green"), check("billing-quote-green", "billing::quote sample/big/corrupt roots green"), check("billing-adapter-green", "billing::quote_outcome decoded/too_big/bad_blob roots green"), check("billing-fetch-green", "billing::fetch_quote flaky/down/first_try roots green"), check("billing-reraise-green", "billing::read_quote steady/refused roots green"), check("app-empty", "app::main empty root green"), check("suspended-leg-green", "suspended leg: load/load_outcome paused, fetch_profile on_hold, read_profile shelved, read_traced shelved_deep roots green")]
        other: "nope" => ok []
    match scope is "m28-032"
        false => ok []
        true => ok [check("root-count", "assert report carries exactly 40 roots"), check("helper-retry-green", "retry::retry direct/single roots green"), check("helper-canned-green", "retry::canned good/bad roots green"), check("helper-tag-green", "retry::tag sample root green"), check("profiles-load-green", "profiles::load hit/gone/shut/paused roots green"), check("profiles-adapter-green", "profiles::load_outcome hit/gone/shut/paused roots green"), check("profiles-fetch-green", "profiles::fetch_profile flaky/down/first_try/on_hold roots green"), check("profiles-reraise-green", "profiles::read_profile steady/locked/recover/shelved roots green"), check("profiles-traced-green", "profiles::fetch_traced traced_ok/traced_down roots green"), check("profiles-roundtrip-green", "profiles::read_traced roundtrip/roundtrip_denied/shelved_deep roots green"), check("profiles-fault-green", "profiles::blast unit and blast_kind kind roots green"), check("billing-quote-green", "billing::quote sample/big/corrupt roots green"), check("billing-adapter-green", "billing::quote_outcome decoded/too_big/bad_blob roots green"), check("billing-fetch-green", "billing::fetch_quote flaky/down/first_try roots green"), check("billing-reraise-green", "billing::read_quote steady/refused roots green"), check("app-empty", "app::main empty root green"), check("suspended-leg-green", "suspended leg: load/load_outcome paused, fetch_profile on_hold, read_profile shelved, read_traced shelved_deep roots green")]
