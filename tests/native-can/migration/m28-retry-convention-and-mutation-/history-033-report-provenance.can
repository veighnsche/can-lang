package m28history033provenance
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-033 "add-error surgery: report shape and real-Can provenance".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestAddErrorIsolationFixed (lines 411-430) plus harness
/// requireGreen/requireRealCan (tests/failure-conventions/).
/// Related fixtures: tests/failure-conventions/retry-fixed/ (asserted
/// project after the 13-site suspended surgery).
/// Disposition: MIGRATE. The fixed-bound add-error leg observes the assert
/// report over the surgically edited project (exit 0, decoded report
/// passed, every entry passed) and real-Can provenance (every root carries
/// "real-can" evidence), with the 18-entry count pinned.
/// Protects (this file): exit-zero, report-passed, green-count and
/// real-can-count pins.
/// Per-function green flags live in history-033-roots-green.can; the
/// surgical-isolation mechanics live in
/// history-033-isolation-mechanism.can.
/// Variants: add-error surgery on the fixed-bound project only. The green
/// legs (H028/H029), the no-retry/over-attempt mutants (H030/H031) and the
/// result-data add-error leg (H032) are sibling M28 rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case add-error-fixed/report-provenance checks: exit-zero, report-passed,
/// green-count, real-can-count.
/// Facet map: exit-zero pins canlc assert exit status 0; report-passed pins
/// the decoded can.assertion-report passed flag with every entry passed;
/// green-count pins exactly 18 report entries (15 pre-surgery plus the 3
/// suspended-leg rows); real-can-count pins requireRealCan (all 18 roots
/// carry "real-can").
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int exit_code
    bool report_passed
    int green_count
    int real_can_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("add-error-fixed/report-provenance", "default", "", "offline"), "exit-zero" => ok "case add-error-fixed/report-provenance variant default root exit-zero run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("add-error-fixed/report-provenance", "default", "", "offline"), "report-passed" => ok evidence("report-passed", "true", "true", true, "case add-error-fixed/report-provenance variant default root report-passed run offline")
        different: false, true, context("add-error-fixed/report-provenance", "default", "", "offline"), "report-passed" => failed{"report-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 18, 18, context("add-error-fixed/report-provenance", "default", "", "offline"), "green-count" => ok evidence("green-count", "18", "18", true, "case add-error-fixed/report-provenance variant default root green-count run offline")
        different: 15, 18, context("add-error-fixed/report-provenance", "default", "", "offline"), "green-count" => failed{"green-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(0, true, 18, 18)
        seed_nonzero_exit: "seed-nonzero-exit" => ok observation(1, false, 0, 0)
        seed_report_fail: "seed-report-fail" => ok observation(0, false, 18, 18)
        seed_count_fifteen: "seed-count-fifteen" => ok observation(0, true, 15, 15)
        seed_count_seventeen: "seed-count-seventeen" => ok observation(0, true, 17, 17)
        seed_provenance_gap: "seed-provenance-gap" => ok observation(0, true, 18, 17)
    match variant_id
        "seed-nonzero-exit" => ok observation(1, false, 0, 0)
        "seed-report-fail" => ok observation(0, false, 18, 18)
        "seed-count-fifteen" => ok observation(0, true, 15, 15)
        "seed-count-seventeen" => ok observation(0, true, 17, 17)
        "seed-provenance-gap" => ok observation(0, true, 18, 17)
        _ => ok observation(0, true, 18, 18)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_033: "m28-033" => ok [check("exit-zero", "canlc assert exits 0"), check("report-passed", "decoded assert report passed"), check("green-count", "assert report carries exactly 18 green entries"), check("real-can-count", "all 18 roots carry real-can evidence")]
        other: "nope" => ok []
    match scope is "m28-033"
        false => ok []
        true => ok [check("exit-zero", "canlc assert exits 0"), check("report-passed", "decoded assert report passed"), check("green-count", "assert report carries exactly 18 green entries"), check("real-can-count", "all 18 roots carry real-can evidence")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "add-error-fixed/report-provenance" => ok [expected_check("exit-zero", "0"), expected_check("report-passed", "true"), expected_check("green-count", "18"), expected_check("real-can-count", "18")]
        unknown: "nope" => ok []
    match case is "add-error-fixed/report-provenance"
        false => ok []
        true => ok [expected_check("exit-zero", "0"), expected_check("report-passed", "true"), expected_check("green-count", "18"), expected_check("real-can-count", "18")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("add-error-fixed/report-provenance", "default", "", "offline") => ok
        seed_nonzero_exit: context("add-error-fixed/report-provenance", "seed-nonzero-exit", "", "offline") => failed{"exit-zero"}
        seed_report_fail: context("add-error-fixed/report-provenance", "seed-report-fail", "", "offline") => failed{"report-passed"}
        seed_count_fifteen: context("add-error-fixed/report-provenance", "seed-count-fifteen", "", "offline") => failed{"green-count"}
        seed_count_seventeen: context("add-error-fixed/report-provenance", "seed-count-seventeen", "", "offline") => failed{"green-count"}
        seed_provenance_gap: context("add-error-fixed/report-provenance", "seed-provenance-gap", "", "offline") => failed{"real-can-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.exit_code, 0, c, "exit-zero")
            failed
            ok evidence exit_evidence => match call require_bool(got.report_passed, true, c, "report-passed")
                failed
                ok evidence passed_evidence => match call require_int(got.green_count, 18, c, "green-count")
                    failed
                    ok evidence green_evidence => match call require_int(got.real_can_count, 18, c, "real-can-count")
                        failed
                        ok evidence provenance_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_033: "m28-033" => ok test_case("add-error-fixed/report-provenance", ["add-error-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-zero"), check_ref("report-passed"), check_ref("green-count"), check_ref("real-can-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-033"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("add-error-fixed/report-provenance", ["add-error-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("exit-zero"), check_ref("report-passed"), check_ref("green-count"), check_ref("real-can-count")], callable case_body)
