package m28history033roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M28 HISTORY-033 "add-error surgery: all 18 fixed-bound roots pass".
/// Source: tests/failure-conventions/retry_test.go symbol
/// TestAddErrorIsolationFixed (lines 411-430: stageProject "retry-fixed",
/// addSuspendedToFixed lines 309-406, wantRoots 18) plus
/// requireUnchanged over can.project.json, src/app/main.can and
/// src/billing/billing.can (lines 424-428; the fixed project has no
/// shared helper package, so no retry path is pinned).
/// Related fixtures: tests/failure-conventions/retry-fixed/ (profiles,
/// billing, app packages).
/// Disposition: MIGRATE. The fixed-bound add-error leg applies the 13-site
/// suspended surgery (1 registry site plus 12 profiles.can sites) to a
/// staged copy of the H029 retry-fixed project: profiles gains a third
/// error plus its fixed-bound retry arm, loader behavior and roots, and
/// every one of the 18 assert rows across the three fixture packages is
/// green.
/// Protects (this file): all 18 roots green plus the exact root-count pin
/// and the new suspended-leg green group.
/// Report shape and real-Can provenance live in
/// history-033-report-provenance.can; the surgical-isolation mechanics
/// (byte-identical unrelated files, surgery scope, suspended-leg facets)
/// live in history-033-isolation-mechanism.can.
/// Variants: add-error surgery on the fixed-bound project only. The green
/// legs (H028/H029), the no-retry/over-attempt mutants (H030/H031) and the
/// result-data add-error leg (H032) are sibling M28 rows, not this one.
/// Environment: CONV_BUNDLE or CAN_BUN_ARCHIVE; requires
/// conv-bundle-or-can-bun-archive. Logical gates SUITE/DIAG/FAULT and C/R/N/S/A
/// identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (accept_after P23).
/// Case add-error-fixed/roots-green checks: root-count,
/// profiles-load-green, profiles-retry-green, profiles-layered-green,
/// billing-quote-green, billing-retry-green, app-empty, suspended-leg-green.
/// Root map (retry-fixed fixture asserts after surgery; 11 profiles +
/// 6 billing + 1 app = 18: the 15 H029 rows plus 3 surgery rows, counted
/// from the checked-in fixture sources and the replaceOnce right-hand
/// sides in retry_test.go:329-394):
/// profiles::load hit/gone/shut/paused, profiles::retry_load
/// flaky/down/first_try/paused, profiles::read_via_service
/// steady/locked/shelved; billing::quote sample/big/corrupt,
/// billing::retry_quote flaky/down/first_try; app::main empty.
/// Checks group by assert-owning function (H027 precedent: the Go test pins
/// the count only); every one of the 18 rows is named above and green below.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int root_count
    bool profiles_load_green
    bool profiles_retry_green
    bool profiles_layered_green
    bool billing_quote_green
    bool billing_retry_green
    bool app_empty
    bool suspended_leg_green
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("add-error-fixed/roots-green", "default", "", "offline"), "root-count" => ok "case add-error-fixed/roots-green variant default root root-count run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("add-error-fixed/roots-green", "default", "", "offline"), "app-empty" => ok evidence("app-empty", "true", "true", true, "case add-error-fixed/roots-green variant default root app-empty run offline")
        different: false, true, context("add-error-fixed/roots-green", "default", "", "offline"), "app-empty" => failed{"app-empty"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 18, 18, context("add-error-fixed/roots-green", "default", "", "offline"), "root-count" => ok evidence("root-count", "18", "18", true, "case add-error-fixed/roots-green variant default root root-count run offline")
        different: 15, 18, context("add-error-fixed/roots-green", "default", "", "offline"), "root-count" => failed{"root-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(18, true, true, true, true, true, true, true)
        seed_fifteen: "seed-fifteen" => ok observation(15, true, true, true, true, true, true, false)
        seed_seventeen: "seed-seventeen" => ok observation(17, true, true, true, true, true, true, true)
        seed_suspended_red: "seed-suspended-red" => ok observation(18, true, true, true, true, true, true, false)
        seed_billing_retry_fail: "seed-billing-retry-fail" => ok observation(18, true, true, true, true, false, true, true)
    match variant_id
        "seed-fifteen" => ok observation(15, true, true, true, true, true, true, false)
        "seed-seventeen" => ok observation(17, true, true, true, true, true, true, true)
        "seed-suspended-red" => ok observation(18, true, true, true, true, true, true, false)
        "seed-billing-retry-fail" => ok observation(18, true, true, true, true, false, true, true)
        _ => ok observation(18, true, true, true, true, true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m28_033: "m28-033" => ok [check("root-count", "assert report carries exactly 18 roots"), check("profiles-load-green", "profiles::load hit/gone/shut/paused roots green"), check("profiles-retry-green", "profiles::retry_load flaky/down/first_try/paused roots green"), check("profiles-layered-green", "profiles::read_via_service steady/locked/shelved roots green"), check("billing-quote-green", "billing::quote sample/big/corrupt roots green"), check("billing-retry-green", "billing::retry_quote flaky/down/first_try roots green"), check("app-empty", "app::main empty root green"), check("suspended-leg-green", "suspended leg: load paused, retry_load paused, read_via_service shelved roots green")]
        other: "nope" => ok []
    match scope is "m28-033"
        false => ok []
        true => ok [check("root-count", "assert report carries exactly 18 roots"), check("profiles-load-green", "profiles::load hit/gone/shut/paused roots green"), check("profiles-retry-green", "profiles::retry_load flaky/down/first_try/paused roots green"), check("profiles-layered-green", "profiles::read_via_service steady/locked/shelved roots green"), check("billing-quote-green", "billing::quote sample/big/corrupt roots green"), check("billing-retry-green", "billing::retry_quote flaky/down/first_try roots green"), check("app-empty", "app::main empty root green"), check("suspended-leg-green", "suspended leg: load paused, retry_load paused, read_via_service shelved roots green")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "add-error-fixed/roots-green" => ok [expected_check("root-count", "18"), expected_check("profiles-load-green", "true"), expected_check("profiles-retry-green", "true"), expected_check("profiles-layered-green", "true"), expected_check("billing-quote-green", "true"), expected_check("billing-retry-green", "true"), expected_check("app-empty", "true"), expected_check("suspended-leg-green", "true")]
        unknown: "nope" => ok []
    match case is "add-error-fixed/roots-green"
        false => ok []
        true => ok [expected_check("root-count", "18"), expected_check("profiles-load-green", "true"), expected_check("profiles-retry-green", "true"), expected_check("profiles-layered-green", "true"), expected_check("billing-quote-green", "true"), expected_check("billing-retry-green", "true"), expected_check("app-empty", "true"), expected_check("suspended-leg-green", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("add-error-fixed/roots-green", "default", "", "offline") => ok
        seed_fifteen: context("add-error-fixed/roots-green", "seed-fifteen", "", "offline") => failed{"root-count"}
        seed_seventeen: context("add-error-fixed/roots-green", "seed-seventeen", "", "offline") => failed{"root-count"}
        seed_suspended_red: context("add-error-fixed/roots-green", "seed-suspended-red", "", "offline") => failed{"suspended-leg-green"}
        seed_billing_retry_fail: context("add-error-fixed/roots-green", "seed-billing-retry-fail", "", "offline") => failed{"billing-retry-green"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.root_count, 18, c, "root-count")
            failed
            ok evidence count_evidence => match call require_bool(got.profiles_load_green, true, c, "profiles-load-green")
                failed
                ok evidence profiles_load_green_evidence => match call require_bool(got.profiles_retry_green, true, c, "profiles-retry-green")
                    failed
                    ok evidence profiles_retry_green_evidence => match call require_bool(got.profiles_layered_green, true, c, "profiles-layered-green")
                        failed
                        ok evidence profiles_layered_green_evidence => match call require_bool(got.billing_quote_green, true, c, "billing-quote-green")
                            failed
                            ok evidence billing_quote_green_evidence => match call require_bool(got.billing_retry_green, true, c, "billing-retry-green")
                                failed
                                ok evidence billing_retry_green_evidence => match call require_bool(got.app_empty, true, c, "app-empty")
                                    failed
                                    ok evidence app_empty_evidence => match call require_bool(got.suspended_leg_green, true, c, "suspended-leg-green")
                                        failed
                                        ok evidence suspended_leg_green_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m28_033: "m28-033" => ok test_case("add-error-fixed/roots-green", ["add-error-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("root-count"), check_ref("profiles-load-green"), check_ref("profiles-retry-green"), check_ref("profiles-layered-green"), check_ref("billing-quote-green"), check_ref("billing-retry-green"), check_ref("app-empty"), check_ref("suspended-leg-green")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m28-033"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("add-error-fixed/roots-green", ["add-error-fixed", "m28"], ["conv-bundle-or-can-bun-archive"], 300000, [check_ref("root-count"), check_ref("profiles-load-green"), check_ref("profiles-retry-green"), check_ref("profiles-layered-green"), check_ref("billing-quote-green"), check_ref("billing-retry-green"), check_ref("app-empty"), check_ref("suspended-leg-green")], callable case_body)
