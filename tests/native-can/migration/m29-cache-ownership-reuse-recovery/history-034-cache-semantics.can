package m29history034cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-034 "Close preserves parent and peer: verdicts".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestClosePreservesParentAndConcurrentCache (L40-65); impl
/// tests/support/tempcache/cache.go Close (L100-123).
/// Disposition: migrate (this row ports
/// TestClosePreservesParentAndConcurrentCache to ordinary Can
/// functions; the old Go harness stays until the integrator
/// retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the three live verdicts in Go order:
/// the owned-gone leg, the concurrent-kept leg, the
/// parent-kept leg; plus the explicit-close ok, the three
/// refusal wordings, the open/close/stat/fatal counts, the
/// two-cache variant, and the leg-shape counts.
/// ADAPTATION (recorded, with source lines): verdicts pin
/// bools from the Stat guards (L56/L59/L62); close-ok pins
/// bool from the Close guard (L53); diags pin the exact Go
/// Fatalf spellings (L57/L60/L63); open-count pins 2 from
/// the Open sites (L42/L47); close-sites pins 3 from the
/// Close sites (L46/L51/L53); explicit-close pins 1 (L53);
/// defer-close pins 2 (L46/L51); stat-count pins 3
/// (L56/L59/L62); fatalf-count pins 3 (L57/L60/L63);
/// fatal-count pins 3 from the Fatal sites (L44/L49/L54);
/// cache-count pins 2 (first plus second); total-legs pins
/// 3 (L56/L59/L62); not-exist-legs pins 1 (L56);
/// err-nil-legs pins 2 (L59/L62).
/// Facet map (Go verdict legs): owned-gone pins true (L56);
/// concurrent-kept pins true (L59); parent-kept pins true
/// (L62); close-ok pins true (L53); owned-diag pins the
/// retained wording (L57); concurrent-diag pins the
/// concurrent wording (L60); parent-diag pins the parent
/// wording (L63); open-count pins 2 (L42/L47);
/// close-sites pins 3 (L46/L51/L53); explicit-close pins 1
/// (L53); defer-close pins 2 (L46/L51); stat-count pins 3
/// (L56/L59/L62); fatalf-count pins 3 (L57/L60/L63);
/// fatal-count pins 3 (L44/L49/L54); cache-count pins 2
/// (L42/L47); total-legs pins 3 (L56/L59/L62);
/// not-exist-legs pins 1 (L56); err-nil-legs pins 2
/// (L59/L62).
/// The roots-green pin lives in history-034-roots-green.can;
/// the run shape lives in history-034-run-shape.can.
/// Variants: two concurrent caches (first plus second, Go
/// order).
/// Environment: no env gate; local temp dir only.
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gate P23
/// is unmet. Timeout 60000ms bounds the two-Open/one-Close/
/// three-Stat sequence (no Go guard exists; offline only).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-close-semantics checks: owned-gone,
/// concurrent-kept, parent-kept, close-ok, owned-diag,
/// concurrent-diag, parent-diag, open-count, close-sites,
/// explicit-close, defer-close, stat-count, fatalf-count,
/// fatal-count, cache-count, total-legs, not-exist-legs,
/// err-nil-legs.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool owned_gone
    bool concurrent_kept
    bool parent_kept
    bool close_ok
    str owned_diag
    str concurrent_diag
    str parent_diag
    int open_count
    int close_sites
    int explicit_close
    int defer_close
    int stat_count
    int fatalf_count
    int fatal_count
    int cache_count
    int total_legs
    int not_exist_legs
    int err_nil_legs
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-close-semantics", "default", "", "offline"), "owned-gone" => ok "case history/cache-close-semantics variant default root owned-gone run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-close-semantics", "default", "", "offline"), "owned-gone" => ok evidence("owned-gone", "true", "true", true, "case history/cache-close-semantics variant default root owned-gone run offline")
        different: false, true, context("history/cache-close-semantics", "default", "", "offline"), "owned-gone" => failed{"owned-gone"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/cache-close-semantics", "default", "", "offline"), "open-count" => ok evidence("open-count", "2", "2", true, "case history/cache-close-semantics variant default root open-count run offline")
        different: 3, 2, context("history/cache-close-semantics", "default", "", "offline"), "open-count" => failed{"open-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "owned cache retained: %v", "owned cache retained: %v", context("history/cache-close-semantics", "default", "", "offline"), "owned-diag" => ok evidence("owned-diag", "owned cache retained: %v", "owned cache retained: %v", true, "case history/cache-close-semantics variant default root owned-diag run offline")
        different: "owned cache retained: %v_2", "owned cache retained: %v", context("history/cache-close-semantics", "default", "", "offline"), "owned-diag" => failed{"owned-diag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
