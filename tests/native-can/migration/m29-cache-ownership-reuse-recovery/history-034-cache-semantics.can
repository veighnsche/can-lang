        false => ok []
        true => ok [expected_check("owned-gone", "true"), expected_check("concurrent-kept", "true"), expected_check("parent-kept", "true"), expected_check("close-ok", "true"), expected_check("owned-diag", "owned cache retained: %v"), expected_check("concurrent-diag", "concurrent cache removed: %v"), expected_check("parent-diag", "parent removed: %v"), expected_check("open-count", "2"), expected_check("close-sites", "3"), expected_check("explicit-close", "1"), expected_check("defer-close", "2"), expected_check("stat-count", "3"), expected_check("fatalf-count", "3"), expected_check("fatal-count", "3"), expected_check("cache-count", "2"), expected_check("total-legs", "3"), expected_check("not-exist-legs", "1"), expected_check("err-nil-legs", "2")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/cache-close-semantics", "default", "", "offline") => ok
        seed_owned_gone: context("history/cache-close-semantics", "seed-owned-gone-drift", "", "offline") => failed{"owned-gone"}
        seed_concurrent_kept: context("history/cache-close-semantics", "seed-concurrent-kept-drift", "", "offline") => failed{"concurrent-kept"}
        seed_parent_kept: context("history/cache-close-semantics", "seed-parent-kept-drift", "", "offline") => failed{"parent-kept"}
        seed_close_ok: context("history/cache-close-semantics", "seed-close-ok-drift", "", "offline") => failed{"close-ok"}
        seed_owned_diag: context("history/cache-close-semantics", "seed-owned-diag-drift", "", "offline") => failed{"owned-diag"}
        seed_concurrent_diag: context("history/cache-close-semantics", "seed-concurrent-diag-drift", "", "offline") => failed{"concurrent-diag"}
        seed_parent_diag: context("history/cache-close-semantics", "seed-parent-diag-drift", "", "offline") => failed{"parent-diag"}
        seed_open_count: context("history/cache-close-semantics", "seed-open-count-drift", "", "offline") => failed{"open-count"}
        seed_close_sites: context("history/cache-close-semantics", "seed-close-sites-drift", "", "offline") => failed{"close-sites"}
        seed_explicit_close: context("history/cache-close-semantics", "seed-explicit-close-drift", "", "offline") => failed{"explicit-close"}
        seed_defer_close: context("history/cache-close-semantics", "seed-defer-close-drift", "", "offline") => failed{"defer-close"}
        seed_stat_count: context("history/cache-close-semantics", "seed-stat-count-drift", "", "offline") => failed{"stat-count"}
        seed_fatalf_count: context("history/cache-close-semantics", "seed-fatalf-count-drift", "", "offline") => failed{"fatalf-count"}
        seed_fatal_count: context("history/cache-close-semantics", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
        seed_cache_count: context("history/cache-close-semantics", "seed-cache-count-drift", "", "offline") => failed{"cache-count"}
        seed_total_legs: context("history/cache-close-semantics", "seed-total-legs-drift", "", "offline") => failed{"total-legs"}
        seed_not_exist_legs: context("history/cache-close-semantics", "seed-not-exist-legs-drift", "", "offline") => failed{"not-exist-legs"}
        seed_err_nil_legs: context("history/cache-close-semantics", "seed-err-nil-legs-drift", "", "offline") => failed{"err-nil-legs"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.owned_gone, true, c, "owned-gone")
            failed
            ok evidence owned_gone_evidence => match call require_bool(got.concurrent_kept, true, c, "concurrent-kept")
                failed
                ok evidence concurrent_kept_evidence => match call require_bool(got.parent_kept, true, c, "parent-kept")
                    failed
                    ok evidence parent_kept_evidence => match call require_bool(got.close_ok, true, c, "close-ok")
                        failed
                        ok evidence close_ok_evidence => match call require_text(got.owned_diag, "owned cache retained: %v", c, "owned-diag")
                            failed
                            ok evidence owned_diag_evidence => match call require_text(got.concurrent_diag, "concurrent cache removed: %v", c, "concurrent-diag")
                                failed
                                ok evidence concurrent_diag_evidence => match call require_text(got.parent_diag, "parent removed: %v", c, "parent-diag")
                                    failed
                                    ok evidence parent_diag_evidence => match call require_int(got.open_count, 2, c, "open-count")
                                        failed
                                        ok evidence open_count_evidence => match call require_int(got.close_sites, 3, c, "close-sites")
                                            failed
                                            ok evidence close_sites_evidence => match call require_int(got.explicit_close, 1, c, "explicit-close")
                                                failed
                                                ok evidence explicit_close_evidence => match call require_int(got.defer_close, 2, c, "defer-close")
                                                    failed
                                                    ok evidence defer_close_evidence => match call require_int(got.stat_count, 3, c, "stat-count")
                                                        failed
                                                        ok evidence stat_count_evidence => match call require_int(got.fatalf_count, 3, c, "fatalf-count")
                                                            failed
                                                            ok evidence fatalf_count_evidence => match call require_int(got.fatal_count, 3, c, "fatal-count")
                                                                failed
                                                                ok evidence fatal_count_evidence => match call require_int(got.cache_count, 2, c, "cache-count")
                                                                    failed
                                                                    ok evidence cache_count_evidence => match call require_int(got.total_legs, 3, c, "total-legs")
                                                                        failed
                                                                        ok evidence total_legs_evidence => match call require_int(got.not_exist_legs, 1, c, "not-exist-legs")
                                                                            failed
                                                                            ok evidence not_exist_legs_evidence => match call require_int(got.err_nil_legs, 2, c, "err-nil-legs")
                                                                                failed
                                                                                ok evidence err_nil_legs_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_h034: "m29-h034" => ok test_case("history/cache-close-semantics", ["history", "m29"], [], 60000, [check_ref("owned-gone"), check_ref("concurrent-kept"), check_ref("parent-kept"), check_ref("close-ok"), check_ref("owned-diag"), check_ref("concurrent-diag"), check_ref("parent-diag"), check_ref("open-count"), check_ref("close-sites"), check_ref("explicit-close"), check_ref("defer-close"), check_ref("stat-count"), check_ref("fatalf-count"), check_ref("fatal-count"), check_ref("cache-count"), check_ref("total-legs"), check_ref("not-exist-legs"), check_ref("err-nil-legs")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
