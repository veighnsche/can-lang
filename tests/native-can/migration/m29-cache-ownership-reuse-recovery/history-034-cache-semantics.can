    asserts
        m29_h034: "m29-h034" => ok [check("owned-gone", "closed cache is gone from parent"), check("concurrent-kept", "concurrent cache stays present"), check("parent-kept", "parent dir stays present"), check("close-ok", "explicit close returns nil"), check("owned-diag", "owned gone refusal wording"), check("concurrent-diag", "concurrent kept refusal wording"), check("parent-diag", "parent kept refusal wording"), check("open-count", "two opens run in order"), check("close-sites", "three close sites exist"), check("explicit-close", "one explicit close is guarded"), check("defer-close", "two deferred closes exist"), check("stat-count", "three stats guard verdicts"), check("fatalf-count", "three fatalf legs exist"), check("fatal-count", "three fatal guards exist"), check("cache-count", "two concurrent caches run"), check("total-legs", "three verdict legs run"), check("not-exist-legs", "one negated gone leg exists"), check("err-nil-legs", "two nil-err kept legs exist")]
        other: "nope" => ok []
    match scope is "m29-h034"
        false => ok []
        true => ok [check("owned-gone", "closed cache is gone from parent"), check("concurrent-kept", "concurrent cache stays present"), check("parent-kept", "parent dir stays present"), check("close-ok", "explicit close returns nil"), check("owned-diag", "owned gone refusal wording"), check("concurrent-diag", "concurrent kept refusal wording"), check("parent-diag", "parent kept refusal wording"), check("open-count", "two opens run in order"), check("close-sites", "three close sites exist"), check("explicit-close", "one explicit close is guarded"), check("defer-close", "two deferred closes exist"), check("stat-count", "three stats guard verdicts"), check("fatalf-count", "three fatalf legs exist"), check("fatal-count", "three fatal guards exist"), check("cache-count", "two concurrent caches run"), check("total-legs", "three verdict legs run"), check("not-exist-legs", "one negated gone leg exists"), check("err-nil-legs", "two nil-err kept legs exist")]
