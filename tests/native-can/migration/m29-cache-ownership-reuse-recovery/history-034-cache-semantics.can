    asserts
        known: "history/cache-close-semantics" => ok [expected_check("owned-gone", "true"), expected_check("concurrent-kept", "true"), expected_check("parent-kept", "true"), expected_check("close-ok", "true"), expected_check("owned-diag", "owned cache retained: %v"), expected_check("concurrent-diag", "concurrent cache removed: %v"), expected_check("parent-diag", "parent removed: %v"), expected_check("open-count", "2"), expected_check("close-sites", "3"), expected_check("explicit-close", "1"), expected_check("defer-close", "2"), expected_check("stat-count", "3"), expected_check("fatalf-count", "3"), expected_check("fatal-count", "3"), expected_check("cache-count", "2"), expected_check("total-legs", "3"), expected_check("not-exist-legs", "1"), expected_check("err-nil-legs", "2")]
