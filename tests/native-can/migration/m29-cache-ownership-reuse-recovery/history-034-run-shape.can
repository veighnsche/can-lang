package m29history034run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-034 "Close preserves parent and peer: run shape".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestClosePreservesParentAndConcurrentCache (L40-65);
/// impl tests/support/tempcache/cache.go Close refusal
/// (L111-112).
/// Disposition: migrate (this row ports
/// TestClosePreservesParentAndConcurrentCache to ordinary Can
/// functions; the old Go harness stays until the integrator
/// retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live run shape in Go order:
/// the parent var plus TempDir call, the two Open calls
/// with their defers, the firstPath capture, the explicit
/// Close guard, the three Stat legs with predicates, the
/// Fatal call shape plus Fatalf op, the Close replacement
/// refusal wording, the tempdir/err-guard/line/verb
/// counts, and the defer-plus-close ordering verdicts.
/// ADAPTATION (recorded, with source lines): tempdir-count
/// pins 1 from the in-range TempDir site (L41; five exist
/// file-wide); err-guard-count pins 5 from the in-range
/// err-nil guards (L43/L48/L53/L59/L62); func-line-count
/// pins 26 from L40-65 inclusive; verb-count pins 3 from
/// the Fatalf verbs (L57/L60/L63); ordering verdicts pin
/// bools from line order (defers L46/L51 precede capture
/// L52; close L53 precedes stats L56/L59/L62); call
/// spellings pin exact Go bytes without leading tabs or
/// trailing braces.
/// Facet map (run order): parent-var pins parent (L41);
/// first-var pins first (L42); second-var pins second
/// (L47); first-path-var pins firstPath (L52);
/// tempdir-call pins t.TempDir() (L41); open-call pins
/// Open(parent) (L42/L47); defer-first pins defer
/// first.Close() (L46); defer-second pins defer
/// second.Close() (L51); capture-leg pins firstPath :=
/// first.Path (L52); first-stat-leg pins
/// os.Stat(firstPath) (L56); first-stat-pred pins
/// !os.IsNotExist(err) (L56); second-stat-leg pins
/// os.Stat(second.Path) (L59); third-stat-leg pins
/// os.Stat(parent) (L62); fatal-call pins t.Fatal(err)
/// (L44/L49/L54); fatalf-op pins t.Fatalf (L57/L60/L63);
/// replace-diag pins the replaced-dir wording (impl
/// L112); tempdir-count pins 1 (L41); err-guard-count
/// pins 5 (L43/L48/L53/L59/L62); func-line-count pins 26
/// (L40-65); verb-count pins 3 (L57/L60/L63);
/// defer-before-capture pins true (L46/L51 before L52);
/// close-before-stats pins true (L53 before L56/L59/L62).
/// Answer verdicts live in history-034-cache-semantics.can;
/// the roots-green pin lives in history-034-roots-green.can.
/// Variants: two concurrent caches share one run shape (a
/// single default case; per-cache verdicts pin in
/// cache-semantics).
/// Environment: no env gate; local temp dir only.
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gate P23
/// is unmet. Timeout 60000ms bounds the run-shape probe
/// (no Go guard exists; offline only).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-close-run checks: parent-var,
/// first-var, second-var, first-path-var, tempdir-call,
/// open-call, defer-first, defer-second, capture-leg,
/// first-stat-leg, first-stat-pred, second-stat-leg,
/// third-stat-leg, fatal-call, fatalf-op, replace-diag,
/// tempdir-count, err-guard-count, func-line-count,
/// verb-count, defer-before-capture, close-before-stats.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str parent_var
    str first_var
    str second_var
    str first_path_var
    str tempdir_call
    str open_call
    str defer_first
    str defer_second
    str capture_leg
    str first_stat_leg
    str first_stat_pred
    str second_stat_leg
    str third_stat_leg
    str fatal_call
    str fatalf_op
    str replace_diag
    int tempdir_count
    int err_guard_count
    int func_line_count
    int verb_count
    bool defer_before_capture
    bool close_before_stats
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-close-run", "default", "", "offline"), "parent-var" => ok "case history/cache-close-run variant default root parent-var run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-close-run", "default", "", "offline"), "defer-before-capture" => ok evidence("defer-before-capture", "true", "true", true, "case history/cache-close-run variant default root defer-before-capture run offline")
        different: false, true, context("history/cache-close-run", "default", "", "offline"), "defer-before-capture" => failed{"defer-before-capture"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/cache-close-run", "default", "", "offline"), "tempdir-count" => ok evidence("tempdir-count", "1", "1", true, "case history/cache-close-run variant default root tempdir-count run offline")
        different: 2, 1, context("history/cache-close-run", "default", "", "offline"), "tempdir-count" => failed{"tempdir-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "parent", "parent", context("history/cache-close-run", "default", "", "offline"), "parent-var" => ok evidence("parent-var", "parent", "parent", true, "case history/cache-close-run variant default root parent-var run offline")
        different: "parent_2", "parent", context("history/cache-close-run", "default", "", "offline"), "parent-var" => failed{"parent-var"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
