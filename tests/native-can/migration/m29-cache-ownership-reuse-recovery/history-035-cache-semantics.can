    match scope is "m29-h035"
        false => ok []
        true => ok [check("abandoned-name", "abandoned leg keeps its Go name"), check("fresh-name", "fresh leg keeps its Go name"), check("live-name", "live leg keeps its Go name"), check("locked-name", "locked leg keeps its Go name"), check("foreign-name", "foreign leg keeps its Go name"), check("linked-name", "symlink leg keeps its Go name"), check("candidate-count", "exactly one path reaches the liveness gate"), check("protected-count", "five paths face the keep guard"), check("abandoned-removed", "old dead unlocked owned cache is removed"), check("fresh-kept", "fresh cache is kept"), check("live-kept", "live-owner cache is kept"), check("locked-kept", "locked cache is kept"), check("foreign-kept", "foreign-marker cache is kept"), check("linked-kept", "symlink path is kept"), check("abandoned-old", "abandoned leg is aged old"), check("fresh-old", "fresh leg stays new"), check("live-old", "live leg is aged old"), check("variant-count", "six legs run in order")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/cache-semantics" => ok [expected_check("abandoned-name", "abandoned"), expected_check("fresh-name", "fresh"), expected_check("live-name", "live"), expected_check("locked-name", "locked"), expected_check("foreign-name", "foreign"), expected_check("linked-name", "linked"), expected_check("candidate-count", "1"), expected_check("protected-count", "5"), expected_check("abandoned-removed", "true"), expected_check("fresh-kept", "true"), expected_check("live-kept", "true"), expected_check("locked-kept", "true"), expected_check("foreign-kept", "true"), expected_check("linked-kept", "true"), expected_check("abandoned-old", "true"), expected_check("fresh-old", "false"), expected_check("live-old", "true"), expected_check("variant-count", "6")]
        unknown: "nope" => ok []
    match case is "history/cache-semantics"
        false => ok []
        true => ok [expected_check("abandoned-name", "abandoned"), expected_check("fresh-name", "fresh"), expected_check("live-name", "live"), expected_check("locked-name", "locked"), expected_check("foreign-name", "foreign"), expected_check("linked-name", "linked"), expected_check("candidate-count", "1"), expected_check("protected-count", "5"), expected_check("abandoned-removed", "true"), expected_check("fresh-kept", "true"), expected_check("live-kept", "true"), expected_check("locked-kept", "true"), expected_check("foreign-kept", "true"), expected_check("linked-kept", "true"), expected_check("abandoned-old", "true"), expected_check("fresh-old", "false"), expected_check("live-old", "true"), expected_check("variant-count", "6")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/cache-semantics", "default", "", "offline") => ok
        seed_abandoned_name: context("history/cache-semantics", "seed-abandoned-name-drift", "", "offline") => failed{"abandoned-name"}
        seed_fresh_name: context("history/cache-semantics", "seed-fresh-name-drift", "", "offline") => failed{"fresh-name"}
        seed_live_name: context("history/cache-semantics", "seed-live-name-drift", "", "offline") => failed{"live-name"}
        seed_locked_name: context("history/cache-semantics", "seed-locked-name-drift", "", "offline") => failed{"locked-name"}
        seed_foreign_name: context("history/cache-semantics", "seed-foreign-name-drift", "", "offline") => failed{"foreign-name"}
        seed_linked_name: context("history/cache-semantics", "seed-linked-name-drift", "", "offline") => failed{"linked-name"}
        seed_candidate_count: context("history/cache-semantics", "seed-candidate-count-drift", "", "offline") => failed{"candidate-count"}
        seed_protected_count: context("history/cache-semantics", "seed-protected-count-drift", "", "offline") => failed{"protected-count"}
        seed_abandoned_removed: context("history/cache-semantics", "seed-abandoned-removed-drift", "", "offline") => failed{"abandoned-removed"}
        seed_fresh_kept: context("history/cache-semantics", "seed-fresh-kept-drift", "", "offline") => failed{"fresh-kept"}
        seed_live_kept: context("history/cache-semantics", "seed-live-kept-drift", "", "offline") => failed{"live-kept"}
        seed_locked_kept: context("history/cache-semantics", "seed-locked-kept-drift", "", "offline") => failed{"locked-kept"}
        seed_foreign_kept: context("history/cache-semantics", "seed-foreign-kept-drift", "", "offline") => failed{"foreign-kept"}
        seed_linked_kept: context("history/cache-semantics", "seed-linked-kept-drift", "", "offline") => failed{"linked-kept"}
        seed_abandoned_old: context("history/cache-semantics", "seed-abandoned-old-drift", "", "offline") => failed{"abandoned-old"}
        seed_fresh_old: context("history/cache-semantics", "seed-fresh-old-drift", "", "offline") => failed{"fresh-old"}
        seed_live_old: context("history/cache-semantics", "seed-live-old-drift", "", "offline") => failed{"live-old"}
        seed_variant_count: context("history/cache-semantics", "seed-variant-count-drift", "", "offline") => failed{"variant-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.abandoned_name, "abandoned", c, "abandoned-name")
            failed
            ok evidence abandoned_name_evidence => match call require_text(got.fresh_name, "fresh", c, "fresh-name")
                failed
                ok evidence fresh_name_evidence => match call require_text(got.live_name, "live", c, "live-name")
                    failed
                    ok evidence live_name_evidence => match call require_text(got.locked_name, "locked", c, "locked-name")
                        failed
                        ok evidence locked_name_evidence => match call require_text(got.foreign_name, "foreign", c, "foreign-name")
                            failed
                            ok evidence foreign_name_evidence => match call require_text(got.linked_name, "linked", c, "linked-name")
                                failed
                                ok evidence linked_name_evidence => match call require_int(got.candidate_count, 1, c, "candidate-count")
                                    failed
                                    ok evidence candidate_count_evidence => match call require_int(got.protected_count, 5, c, "protected-count")
                                        failed
                                        ok evidence protected_count_evidence => match call require_bool(got.abandoned_removed, true, c, "abandoned-removed")
                                            failed
                                            ok evidence abandoned_removed_evidence => match call require_bool(got.fresh_kept, true, c, "fresh-kept")
                                                failed
                                                ok evidence fresh_kept_evidence => match call require_bool(got.live_kept, true, c, "live-kept")
                                                    failed
                                                    ok evidence live_kept_evidence => match call require_bool(got.locked_kept, true, c, "locked-kept")
                                                        failed
                                                        ok evidence locked_kept_evidence => match call require_bool(got.foreign_kept, true, c, "foreign-kept")
                                                            failed
                                                            ok evidence foreign_kept_evidence => match call require_bool(got.linked_kept, true, c, "linked-kept")
                                                                failed
                                                                ok evidence linked_kept_evidence => match call require_bool(got.abandoned_old, true, c, "abandoned-old")
                                                                    failed
                                                                    ok evidence abandoned_old_evidence => match call require_bool(got.fresh_old, false, c, "fresh-old")
                                                                        failed
                                                                        ok evidence fresh_old_evidence => match call require_bool(got.live_old, true, c, "live-old")
                                                                            failed
                                                                            ok evidence live_old_evidence => match call require_int(got.variant_count, 6, c, "variant-count")
                                                                                failed
                                                                                ok evidence variant_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_h035: "m29-h035" => ok test_case("history/cache-semantics", ["history", "m29"], [], 120000, [check_ref("abandoned-name"), check_ref("fresh-name"), check_ref("live-name"), check_ref("locked-name"), check_ref("foreign-name"), check_ref("linked-name"), check_ref("candidate-count"), check_ref("protected-count"), check_ref("abandoned-removed"), check_ref("fresh-kept"), check_ref("live-kept"), check_ref("locked-kept"), check_ref("foreign-kept"), check_ref("linked-kept"), check_ref("abandoned-old"), check_ref("fresh-old"), check_ref("live-old"), check_ref("variant-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-h035"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/cache-semantics", ["history", "m29"], [], 120000, [check_ref("abandoned-name"), check_ref("fresh-name"), check_ref("live-name"), check_ref("locked-name"), check_ref("foreign-name"), check_ref("linked-name"), check_ref("candidate-count"), check_ref("protected-count"), check_ref("abandoned-removed"), check_ref("fresh-kept"), check_ref("live-kept"), check_ref("locked-kept"), check_ref("foreign-kept"), check_ref("linked-kept"), check_ref("abandoned-old"), check_ref("fresh-old"), check_ref("live-old"), check_ref("variant-count")], callable case_body)
