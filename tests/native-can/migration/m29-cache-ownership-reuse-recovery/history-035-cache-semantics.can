package m29history035cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-035 "Cache recovery: verdict semantics".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryRequiresInactivityAndPreservesForeignPaths
/// (L67-109); helper candidate (L13-36); deadPID (L38).
/// Disposition: migrate (this row ports
/// TestRecoveryRequiresInactivityAndPreservesForeignPaths to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the six candidate legs in Go order:
/// the abandoned old dead unlocked owned cache is removed
/// while the fresh, live, locked, foreign-marker and symlink
/// paths are kept; plus the one-candidate and five-kept
/// counts, the old/new age flags, and the six-variant count.
/// ADAPTATION (recorded, with source lines): leg names pin
/// the Go local spellings (abandoned L72, fresh L73, live L74,
/// locked L75, foreign L84, linked L88); candidate-count pins
/// int (1) from the len guard (L93); protected-count pins int
/// (5) from the keep loop slice (L104); removed/kept verdicts
/// pin bools from the Stat/IsNotExist gone guard (L101) and
/// the Lstat keep guard (L105); age flags pin bools from the
/// old args (L72-75); variant-count pins int (6) from the
/// coverage variants
/// (abandoned/fresh/live/locked/foreign/symlink).
/// Facet map (Go verdict legs): abandoned-name pins abandoned
/// (L72); fresh-name pins fresh (L73); live-name pins live
/// (L74); locked-name pins locked (L75); foreign-name pins
/// foreign (L84); linked-name pins linked (L88);
/// candidate-count pins 1 (L93); protected-count pins 5
/// (L104); abandoned-removed pins true (L101-103); fresh-kept,
/// live-kept, locked-kept, foreign-kept and linked-kept pin
/// true (L104-108); abandoned-old pins true (L72); fresh-old
/// pins false (L73); live-old pins true (L74); variant-count
/// pins 6 (coverage variants).
/// The roots-green pin lives in history-035-roots-green.can;
/// the run shape plus diagnostics live in
/// history-035-run-shape.can.
/// Variants: abandoned/fresh/live/locked/foreign/symlink (all
/// in Go order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-semantics checks: abandoned-name,
/// fresh-name, live-name, locked-name, foreign-name,
/// linked-name, candidate-count, protected-count,
/// abandoned-removed, fresh-kept, live-kept, locked-kept,
/// foreign-kept, linked-kept, abandoned-old, fresh-old,
/// live-old, variant-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str abandoned_name
    str fresh_name
    str live_name
    str locked_name
    str foreign_name
    str linked_name
    int candidate_count
    int protected_count
    bool abandoned_removed
    bool fresh_kept
    bool live_kept
    bool locked_kept
    bool foreign_kept
    bool linked_kept
    bool abandoned_old
    bool fresh_old
    bool live_old
    int variant_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-semantics", "default", "", "offline"), "abandoned-name" => ok "case history/cache-semantics variant default root abandoned-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-semantics", "default", "", "offline"), "abandoned-removed" => ok evidence("abandoned-removed", "true", "true", true, "case history/cache-semantics variant default root abandoned-removed run offline")
        different: false, true, context("history/cache-semantics", "default", "", "offline"), "abandoned-removed" => failed{"abandoned-removed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/cache-semantics", "default", "", "offline"), "candidate-count" => ok evidence("candidate-count", "1", "1", true, "case history/cache-semantics variant default root candidate-count run offline")
        different: 2, 1, context("history/cache-semantics", "default", "", "offline"), "candidate-count" => failed{"candidate-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "abandoned", "abandoned", context("history/cache-semantics", "default", "", "offline"), "abandoned-name" => ok evidence("abandoned-name", "abandoned", "abandoned", true, "case history/cache-semantics variant default root abandoned-name run offline")
        different: "abandoned_2", "abandoned", context("history/cache-semantics", "default", "", "offline"), "abandoned-name" => failed{"abandoned-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
