package m29history035roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-035 "Cache recovery: roots green".
/// Source: tests/support/tempcache/cache.go consts (L21-30)
/// plus owner shape (L32-36); test helper candidate plus
/// deadPID (tests/support/tempcache/cache_test.go L13-38).
/// Disposition: migrate (this row ports
/// TestRecoveryRequiresInactivityAndPreservesForeignPaths to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the static recovery baseline as the
/// green root: the cache prefix, marker and lease names, the
/// owner schema tag, the hour wait plus sixteen-entry scan
/// bound, the dead PID value, the owner JSON keys plus Go
/// field names, and the candidate helper call spellings
/// (mint, encode, base, join, modes, aging, live PID).
/// ADAPTATION (recorded, with source lines): recovery-age
/// pins the time.Hour spelling as str (no int literal at
/// cache.go L29); modes pin the 0600 spellings structurally
/// as str (test L23/L26); age-factor pins int (2) from -2
/// times recoveryAge (L30); join-call pins one spelling for
/// all seven Join sites; live-pid-call pins os.Getpid() with
/// parens as the call spelling (L74).
/// Facet map (static baseline): prefix pins can-suite-cache-
/// (cache.go L21); marker-name pins .can-test-owner.json
/// (L22); lease-name pins .can-test-lease (L23); schema pins
/// can.test-suite-cache/1 (L24); recovery-age pins time.Hour
/// (L29); recovery-limit pins 16 (L30); dead-pid pins
/// 999999999 (test L38); owner keys pin schema/name/pid
/// (cache.go L33-35); mkdir-call pins os.MkdirTemp (test
/// L15); marshal-call pins json.Marshal (L19); base-call
/// pins filepath.Base (L19); join-call pins filepath.Join
/// (L23); marker-mode pins 0600 (L23); lease-mode pins 0600
/// (L26); age-factor pins 2 (L30); chtimes-call pins
/// os.Chtimes (L31); live-pid-call pins os.Getpid() (L74);
/// helper-name pins candidate (L13); dead-pid-name pins
/// deadPID (L38); owner fields pin Schema/Name/PID (cache.go
/// L33-35).
/// The verdict pins live in history-035-cache-semantics.can;
/// the run shape plus diagnostics live in
/// history-035-run-shape.can.
/// Variants: abandoned/fresh/live/locked/foreign/symlink (all
/// in Go order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-roots checks: prefix, marker-name,
/// lease-name, schema, recovery-age, recovery-limit,
/// dead-pid, owner-schema-key, owner-name-key, owner-pid-key,
/// mkdir-call, marshal-call, base-call, join-call,
/// marker-mode, lease-mode, age-factor, chtimes-call,
/// live-pid-call, helper-name, dead-pid-name,
/// owner-schema-field, owner-name-field, owner-pid-field.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str prefix
    str marker_name
    str lease_name
    str schema
    str recovery_age
    int recovery_limit
    int dead_pid
    str owner_schema_key
    str owner_name_key
    str owner_pid_key
    str mkdir_call
    str marshal_call
    str base_call
    str join_call
    str marker_mode
    str lease_mode
    int age_factor
    str chtimes_call
    str live_pid_call
    str helper_name
    str dead_pid_name
    str owner_schema_field
    str owner_name_field
    str owner_pid_field
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-roots", "default", "", "offline"), "prefix" => ok "case history/cache-roots variant default root prefix run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-roots", "default", "", "offline"), "prefix" => ok evidence("prefix", "true", "true", true, "case history/cache-roots variant default root prefix run offline")
        different: false, true, context("history/cache-roots", "default", "", "offline"), "prefix" => failed{"prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 16, 16, context("history/cache-roots", "default", "", "offline"), "recovery-limit" => ok evidence("recovery-limit", "16", "16", true, "case history/cache-roots variant default root recovery-limit run offline")
        different: 15, 16, context("history/cache-roots", "default", "", "offline"), "recovery-limit" => failed{"recovery-limit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can-suite-cache-", "can-suite-cache-", context("history/cache-roots", "default", "", "offline"), "prefix" => ok evidence("prefix", "can-suite-cache-", "can-suite-cache-", true, "case history/cache-roots variant default root prefix run offline")
        different: "can-suite-cache-_2", "can-suite-cache-", context("history/cache-roots", "default", "", "offline"), "prefix" => failed{"prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
