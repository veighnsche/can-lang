package m29history035run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-035 "Cache recovery: run shape".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryRequiresInactivityAndPreservesForeignPaths
/// (L67-109): dead gate (L68-69); lock setup (L76-83);
/// foreign overwrite (L84-87); symlink leg (L88-91); check
/// closure (L92-97); recovery run (L98-100); gone guard
/// (L101-103); keep guard (L104-108).
/// Disposition: migrate (this row ports
/// TestRecoveryRequiresInactivityAndPreservesForeignPaths to
/// ordinary Can functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the live run shape: the dead-owner
/// gate (Kill/ESRCH/errors.Is plus refusal), the parent
/// setup, the lock setup (OpenFile flag plus zero perm, held
/// fd, exclusive no-block Flock), the foreign marker bytes,
/// the symlink suffix plus call, the check closure (name,
/// one-path guard, abandoned-first guard, refusal), the
/// recover call plus clock, and the gone/keep guards (Stat,
/// IsNotExist, Lstat plus both refusals).
/// ADAPTATION (recorded, with source lines): open-perm pins
/// int (0) from the OpenFile perm arg (L76); foreign-bytes
/// pins the backquote JSON inner bytes (L85); symlink-suffix
/// pins the symlink literal after prefix plus (L88);
/// flock-fd pins the int(file.Fd()) spelling (L81);
/// parent-setup pins t.TempDir() with parens (L71); guards
/// pin the full comparison spellings (L93).
/// Facet map (launch plus diagnostics): dead-gate-call pins
/// syscall.Kill (L68); dead-gate-want pins syscall.ESRCH
/// (L68); dead-gate-wrap pins errors.Is (L68); fatal-dead-pid
/// pins the dead PID refusal (L69); parent-setup pins
/// t.TempDir() (L71); open-call pins os.OpenFile (L76);
/// open-flag pins os.O_RDWR (L76); open-perm pins 0 (L76);
/// flock-call pins syscall.Flock (L81); flock-ex pins
/// syscall.LOCK_EX (L81); flock-nb pins syscall.LOCK_NB
/// (L81); flock-fd pins int(file.Fd()) (L81); foreign-bytes
/// pins the foreign JSON (L85); symlink-suffix pins symlink
/// (L88); symlink-call pins os.Symlink (L89); check-name pins
/// check (L92); check-len-guard pins len(paths) != 1 (L93);
/// check-first-guard pins paths[0] != abandoned (L93);
/// fatal-unsafe pins the unsafe refusal (L94); recover-call
/// pins recoverAbandoned (L98); now-call pins time.Now()
/// (L98); stat-call pins os.Stat (L101); not-exist-call pins
/// os.IsNotExist (L101); fatal-retained pins the retained
/// refusal (L102); lstat-call pins os.Lstat (L105);
/// fatal-protected pins the removed refusal (L106).
/// The verdict pins live in history-035-cache-semantics.can;
/// the roots-green pin lives in history-035-roots-green.can.
/// Variants: abandoned/fresh/live/locked/foreign/symlink (all
/// in Go order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-run checks: dead-gate-call,
/// dead-gate-want, dead-gate-wrap, fatal-dead-pid,
/// parent-setup, open-call, open-flag, open-perm, flock-call,
/// flock-ex, flock-nb, flock-fd, foreign-bytes,
/// symlink-suffix, symlink-call, check-name, check-len-guard,
/// check-first-guard, fatal-unsafe, recover-call, now-call,
/// stat-call, not-exist-call, fatal-retained, lstat-call,
/// fatal-protected.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str dead_gate_call
    str dead_gate_want
    str dead_gate_wrap
    str fatal_dead_pid
    str parent_setup
    str open_call
    str open_flag
    int open_perm
    str flock_call
    str flock_ex
    str flock_nb
    str flock_fd
    str foreign_bytes
    str symlink_suffix
    str symlink_call
    str check_name
    str check_len_guard
    str check_first_guard
    str fatal_unsafe
    str recover_call
    str now_call
    str stat_call
    str not_exist_call
    str fatal_retained
    str lstat_call
    str fatal_protected
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-run", "default", "", "offline"), "dead-gate-call" => ok "case history/cache-run variant default root dead-gate-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-run", "default", "", "offline"), "dead-gate-call" => ok evidence("dead-gate-call", "true", "true", true, "case history/cache-run variant default root dead-gate-call run offline")
        different: false, true, context("history/cache-run", "default", "", "offline"), "dead-gate-call" => failed{"dead-gate-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/cache-run", "default", "", "offline"), "open-perm" => ok evidence("open-perm", "0", "0", true, "case history/cache-run variant default root open-perm run offline")
        different: 1, 0, context("history/cache-run", "default", "", "offline"), "open-perm" => failed{"open-perm"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "syscall.Kill", "syscall.Kill", context("history/cache-run", "default", "", "offline"), "dead-gate-call" => ok evidence("dead-gate-call", "syscall.Kill", "syscall.Kill", true, "case history/cache-run variant default root dead-gate-call run offline")
        different: "syscall.Kill_2", "syscall.Kill", context("history/cache-run", "default", "", "offline"), "dead-gate-call" => failed{"dead-gate-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
