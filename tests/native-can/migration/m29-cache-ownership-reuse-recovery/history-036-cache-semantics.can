package m29history036cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-036 "unavailable liveness retains orphan: cache verdicts".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestUnavailableLivenessRetainsOrphan (L111-120); dead pid const (L38);
/// orphan builder (L13-36); skip path
/// tests/support/tempcache/cache.go (L164-167).
/// Disposition: migrate (this row ports
/// TestUnavailableLivenessRetainsOrphan to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the row verdict: the lsof-unavailable probe error,
/// the failing probe, the nil recovery verdict, the retained orphan plus its
/// os.Stat probe, the retention diagnostic wording, the dead pid plus aged
/// flag, and the one/one/two leg counts.
/// ADAPTATION (recorded, with source lines): probe-fails pins bool true from
/// the closure returning errors.New (L114); recover-returns-nil pins bool
/// true from the skip path returning nil (impl L164-167) which the L114-116
/// guard accepts; orphan-retained pins bool true from the L117 err-nil guard;
/// candidate-old pins bool true from the builder flag (L113); candidate-pid
/// pins int from the deadPID const (L38); recovery-calls pins 1 from the
/// single call site (L114); retention-asserts pins 1 from the single stat
/// guard (L117); fatal-guards pins 2 from t.Fatal plus t.Fatalf (L115/L118).
/// Facet map (Go verdict legs): test-name pins
/// TestUnavailableLivenessRetainsOrphan (L111); probe-error pins lsof
/// unavailable (L114); probe-fails pins true (L114); recover-returns-nil
/// pins true (L114-116; impl L164-167); orphan-retained pins true (L117);
/// orphan-check-op pins os.Stat (L117); fatal-retention pins the verdict
/// wording (L118); candidate-pid pins 999999999 (L38 via L113);
/// candidate-old pins true (L113); recovery-calls pins 1 (L114);
/// retention-asserts pins 1 (L117); fatal-guards pins 2 (L115/L118).
/// The roots-green pin lives in history-036-roots-green.can; the run shape
/// plus call wording live in history-036-run-shape.can.
/// Variants: lsof unavailable (the single row variant).
/// Environment: no gates; requires nothing. Logical gates
/// WORK/BUILD/CHILD/CLOCK and C/R/N/S/A identities bind at P23; no live run
/// now. Accept gate P23 is unmet. Timeout 60000ms is a neutral offline
/// descriptor default (the Go test sets no ctx).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-semantics checks: test-name, probe-error, probe-fails,
/// recover-returns-nil, orphan-retained, orphan-check-op, fatal-retention,
/// candidate-pid, candidate-old, recovery-calls, retention-asserts,
/// fatal-guards.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str probe_error
    bool probe_fails
    bool recover_returns_nil
    bool orphan_retained
    str orphan_check_op
    str fatal_retention
    int candidate_pid
    bool candidate_old
    int recovery_calls
    int retention_asserts
    int fatal_guards
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-semantics", "default", "", "offline"), "test-name" => ok "case history/cache-semantics variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-semantics", "default", "", "offline"), "probe-fails" => ok evidence("probe-fails", "true", "true", true, "case history/cache-semantics variant default root probe-fails run offline")
        different: false, true, context("history/cache-semantics", "default", "", "offline"), "probe-fails" => failed{"probe-fails"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 999999999, 999999999, context("history/cache-semantics", "default", "", "offline"), "candidate-pid" => ok evidence("candidate-pid", "999999999", "999999999", true, "case history/cache-semantics variant default root candidate-pid run offline")
        different: 999999998, 999999999, context("history/cache-semantics", "default", "", "offline"), "candidate-pid" => failed{"candidate-pid"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestUnavailableLivenessRetainsOrphan", "TestUnavailableLivenessRetainsOrphan", context("history/cache-semantics", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestUnavailableLivenessRetainsOrphan", "TestUnavailableLivenessRetainsOrphan", true, "case history/cache-semantics variant default root test-name run offline")
        different: "TestUnavailableLivenessRetainsOrphan_2", "TestUnavailableLivenessRetainsOrphan", context("history/cache-semantics", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        seed_test_name: "seed-test-name-drift" => ok observation("TestUnavailableLivenessRetainsOrphan_2", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        seed_probe_error: "seed-probe-error-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable_2", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        seed_probe_fails: "seed-probe-fails-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", false, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        seed_recover_returns_nil: "seed-recover-returns-nil-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, false, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        seed_orphan_retained: "seed-orphan-retained-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, false, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        seed_orphan_check_op: "seed-orphan-check-op-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat_2", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        seed_fatal_retention: "seed-fatal-retention-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v_2", 999999999, true, 1, 1, 2)
        seed_candidate_pid: "seed-candidate-pid-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999998, true, 1, 1, 2)
        seed_candidate_old: "seed-candidate-old-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, false, 1, 1, 2)
        seed_recovery_calls: "seed-recovery-calls-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 0, 1, 2)
        seed_retention_asserts: "seed-retention-asserts-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 0, 2)
        seed_fatal_guards: "seed-fatal-guards-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 1)
    match variant_id
        "seed-test-name-drift" => ok observation("TestUnavailableLivenessRetainsOrphan_2", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        "seed-probe-error-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable_2", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        "seed-probe-fails-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", false, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        "seed-recover-returns-nil-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, false, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        "seed-orphan-retained-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, false, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        "seed-orphan-check-op-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat_2", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 1, 2)
        "seed-fatal-retention-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v_2", 999999999, true, 1, 1, 2)
        "seed-candidate-pid-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999998, true, 1, 1, 2)
        "seed-candidate-old-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, false, 1, 1, 2)
        "seed-recovery-calls-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 0, 1, 2)
        "seed-retention-asserts-drift" => ok observation("TestUnavailableLivenessRetainsOrphan", "lsof unavailable", true, true, true, "os.Stat", "inconclusive liveness deleted cache: %v", 999999999, true, 1, 0, 2)
