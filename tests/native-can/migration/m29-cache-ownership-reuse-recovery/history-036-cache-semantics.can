fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_h036: "m29-h036" => ok [check("test-name", "row pins the unavailable-liveness test"), check("probe-error", "probe fails with lsof unavailable"), check("probe-fails", "liveness check returns an error"), check("recover-returns-nil", "recovery swallows the probe failure"), check("orphan-retained", "orphan cache survives the probe"), check("orphan-check-op", "retention probe stats the orphan"), check("fatal-retention", "retention failure names the verdict"), check("candidate-pid", "orphan carries the dead pid"), check("candidate-old", "orphan is aged past recovery"), check("recovery-calls", "one recovery call runs"), check("retention-asserts", "one retention assert guards the orphan"), check("fatal-guards", "two fatal guards watch the legs")]
        other: "nope" => ok []
    match scope is "m29-h036"
        false => ok []
        true => ok [check("test-name", "row pins the unavailable-liveness test"), check("probe-error", "probe fails with lsof unavailable"), check("probe-fails", "liveness check returns an error"), check("recover-returns-nil", "recovery swallows the probe failure"), check("orphan-retained", "orphan cache survives the probe"), check("orphan-check-op", "retention probe stats the orphan"), check("fatal-retention", "retention failure names the verdict"), check("candidate-pid", "orphan carries the dead pid"), check("candidate-old", "orphan is aged past recovery"), check("recovery-calls", "one recovery call runs"), check("retention-asserts", "one retention assert guards the orphan"), check("fatal-guards", "two fatal guards watch the legs")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/cache-semantics" => ok [expected_check("test-name", "TestUnavailableLivenessRetainsOrphan"), expected_check("probe-error", "lsof unavailable"), expected_check("probe-fails", "true"), expected_check("recover-returns-nil", "true"), expected_check("orphan-retained", "true"), expected_check("orphan-check-op", "os.Stat"), expected_check("fatal-retention", "inconclusive liveness deleted cache: %v"), expected_check("candidate-pid", "999999999"), expected_check("candidate-old", "true"), expected_check("recovery-calls", "1"), expected_check("retention-asserts", "1"), expected_check("fatal-guards", "2")]
        unknown: "nope" => ok []
    match case is "history/cache-semantics"
        false => ok []
        true => ok [expected_check("test-name", "TestUnavailableLivenessRetainsOrphan"), expected_check("probe-error", "lsof unavailable"), expected_check("probe-fails", "true"), expected_check("recover-returns-nil", "true"), expected_check("orphan-retained", "true"), expected_check("orphan-check-op", "os.Stat"), expected_check("fatal-retention", "inconclusive liveness deleted cache: %v"), expected_check("candidate-pid", "999999999"), expected_check("candidate-old", "true"), expected_check("recovery-calls", "1"), expected_check("retention-asserts", "1"), expected_check("fatal-guards", "2")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/cache-semantics", "default", "", "offline") => ok
        seed_test_name: context("history/cache-semantics", "seed-test-name-drift", "", "offline") => failed{"test-name"}
        seed_probe_error: context("history/cache-semantics", "seed-probe-error-drift", "", "offline") => failed{"probe-error"}
        seed_probe_fails: context("history/cache-semantics", "seed-probe-fails-drift", "", "offline") => failed{"probe-fails"}
        seed_recover_returns_nil: context("history/cache-semantics", "seed-recover-returns-nil-drift", "", "offline") => failed{"recover-returns-nil"}
        seed_orphan_retained: context("history/cache-semantics", "seed-orphan-retained-drift", "", "offline") => failed{"orphan-retained"}
        seed_orphan_check_op: context("history/cache-semantics", "seed-orphan-check-op-drift", "", "offline") => failed{"orphan-check-op"}
        seed_fatal_retention: context("history/cache-semantics", "seed-fatal-retention-drift", "", "offline") => failed{"fatal-retention"}
        seed_candidate_pid: context("history/cache-semantics", "seed-candidate-pid-drift", "", "offline") => failed{"candidate-pid"}
        seed_candidate_old: context("history/cache-semantics", "seed-candidate-old-drift", "", "offline") => failed{"candidate-old"}
        seed_recovery_calls: context("history/cache-semantics", "seed-recovery-calls-drift", "", "offline") => failed{"recovery-calls"}
        seed_retention_asserts: context("history/cache-semantics", "seed-retention-asserts-drift", "", "offline") => failed{"retention-asserts"}
        seed_fatal_guards: context("history/cache-semantics", "seed-fatal-guards-drift", "", "offline") => failed{"fatal-guards"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.test_name, "TestUnavailableLivenessRetainsOrphan", c, "test-name")
            failed
            ok evidence test_name_evidence => match call require_text(got.probe_error, "lsof unavailable", c, "probe-error")
                failed
                ok evidence probe_error_evidence => match call require_bool(got.probe_fails, true, c, "probe-fails")
                    failed
                    ok evidence probe_fails_evidence => match call require_bool(got.recover_returns_nil, true, c, "recover-returns-nil")
                        failed
                        ok evidence recover_returns_nil_evidence => match call require_bool(got.orphan_retained, true, c, "orphan-retained")
                            failed
                            ok evidence orphan_retained_evidence => match call require_text(got.orphan_check_op, "os.Stat", c, "orphan-check-op")
                                failed
                                ok evidence orphan_check_op_evidence => match call require_text(got.fatal_retention, "inconclusive liveness deleted cache: %v", c, "fatal-retention")
                                    failed
                                    ok evidence fatal_retention_evidence => match call require_int(got.candidate_pid, 999999999, c, "candidate-pid")
                                        failed
                                        ok evidence candidate_pid_evidence => match call require_bool(got.candidate_old, true, c, "candidate-old")
                                            failed
                                            ok evidence candidate_old_evidence => match call require_int(got.recovery_calls, 1, c, "recovery-calls")
                                                failed
                                                ok evidence recovery_calls_evidence => match call require_int(got.retention_asserts, 1, c, "retention-asserts")
                                                    failed
                                                    ok evidence retention_asserts_evidence => match call require_int(got.fatal_guards, 2, c, "fatal-guards")
                                                        failed
                                                        ok evidence fatal_guards_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_h036: "m29-h036" => ok test_case("history/cache-semantics", ["history", "m29"], [], 60000, [check_ref("test-name"), check_ref("probe-error"), check_ref("probe-fails"), check_ref("recover-returns-nil"), check_ref("orphan-retained"), check_ref("orphan-check-op"), check_ref("fatal-retention"), check_ref("candidate-pid"), check_ref("candidate-old"), check_ref("recovery-calls"), check_ref("retention-asserts"), check_ref("fatal-guards")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-h036"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/cache-semantics", ["history", "m29"], [], 60000, [check_ref("test-name"), check_ref("probe-error"), check_ref("probe-fails"), check_ref("recover-returns-nil"), check_ref("orphan-retained"), check_ref("orphan-check-op"), check_ref("fatal-retention"), check_ref("candidate-pid"), check_ref("candidate-old"), check_ref("recovery-calls"), check_ref("retention-asserts"), check_ref("fatal-guards")], callable case_body)
