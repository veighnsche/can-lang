package m29history036roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-036 "unavailable liveness retains orphan: roots green".
/// Source: tests/support/tempcache/cache_test.go orphan builder (L13-36)
/// plus dead pid const (L38); package consts
/// tests/support/tempcache/cache.go (L21-30).
/// Disposition: migrate (this row ports
/// TestUnavailableLivenessRetainsOrphan to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the static live baseline as the green root: the
/// package plus builder names, the four builder params, the dead pid name
/// plus value, the cache prefix, marker plus lease names, the owner schema,
/// the recovery age plus limit, the aging factor, the owner-only mode, and
/// the three builder ops.
/// ADAPTATION (recorded, with source lines): helper-params pins int 4 from
/// the builder signature (L13); dead-pid-value pins int from the const
/// (L38); recovery-age pins the time.Hour spelling as str since only the
/// spelling is byte truth here (impl L29); recovery-limit pins int 16
/// (impl L30); age-factor pins int 2 from the doubling (L30); marker-mode
/// pins the 0600 spelling structurally (L23/L26).
/// Facet map (static baseline): package-name pins tempcache (L1);
/// helper-name pins candidate (L13); helper-params pins 4 (L13);
/// dead-pid-name pins deadPID (L38); dead-pid-value pins 999999999 (L38);
/// cache-prefix pins can-suite-cache- (impl L21); marker-name pins
/// .can-test-owner.json (impl L22); lease-name pins .can-test-lease (impl
/// L23); owner-schema pins can.test-suite-cache/1 (impl L24); recovery-age
/// pins time.Hour (impl L29); recovery-limit pins 16 (impl L30);
/// age-factor pins 2 (L30); marker-mode pins 0600 (L23); mktemp-op pins
/// os.MkdirTemp (L15); marshal-op pins json.Marshal (L19); chtimes-op pins
/// os.Chtimes (L31).
/// Verdict legs live in history-036-cache-semantics.can; the run shape plus
/// call wording live in history-036-run-shape.can.
/// Variants: none in this file (default only); the lsof-unavailable variant
/// pins in cache-semantics.
/// Environment: no gates; requires nothing. Logical gates
/// WORK/BUILD/CHILD/CLOCK and C/R/N/S/A identities bind at P23; no live run
/// now. Accept gate P23 is unmet. Timeout 60000ms is a neutral offline
/// descriptor default (the Go test sets no ctx).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-roots checks: package-name, helper-name, helper-params,
/// dead-pid-name, dead-pid-value, cache-prefix, marker-name, lease-name,
/// owner-schema, recovery-age, recovery-limit, age-factor, marker-mode,
/// mktemp-op, marshal-op, chtimes-op.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str package_name
    str helper_name
    int helper_params
    str dead_pid_name
    int dead_pid_value
    str cache_prefix
    str marker_name
    str lease_name
    str owner_schema
    str recovery_age
    int recovery_limit
    int age_factor
    str marker_mode
    str mktemp_op
    str marshal_op
    str chtimes_op
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-roots", "default", "", "offline"), "package-name" => ok "case history/cache-roots variant default root package-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-roots", "default", "", "offline"), "package-name" => ok evidence("package-name", "true", "true", true, "case history/cache-roots variant default root package-name run offline")
        different: false, true, context("history/cache-roots", "default", "", "offline"), "package-name" => failed{"package-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/cache-roots", "default", "", "offline"), "helper-params" => ok evidence("helper-params", "4", "4", true, "case history/cache-roots variant default root helper-params run offline")
        different: 3, 4, context("history/cache-roots", "default", "", "offline"), "helper-params" => failed{"helper-params"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "tempcache", "tempcache", context("history/cache-roots", "default", "", "offline"), "package-name" => ok evidence("package-name", "tempcache", "tempcache", true, "case history/cache-roots variant default root package-name run offline")
        different: "tempcache_2", "tempcache", context("history/cache-roots", "default", "", "offline"), "package-name" => failed{"package-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
