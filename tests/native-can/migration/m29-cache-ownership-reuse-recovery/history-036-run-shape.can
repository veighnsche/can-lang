package m29history036run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-036 "unavailable liveness retains orphan: run shape".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestUnavailableLivenessRetainsOrphan (L111-120); skip report plus probe
/// refusals tests/support/tempcache/cache.go (L165/L194/L198).
/// Disposition: migrate (this row ports
/// TestUnavailableLivenessRetainsOrphan to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after every linked row,
/// variant, environment and control has accepted evidence).
/// Protects (this file): the live run shape: the TempDir setup, the aged
/// orphan call, the recovery func plus arg count, the probe closure shape
/// plus error ctor, both fatal verbs, the stat call, the skip report head
/// plus tail, and both probe refusal wordings.
/// ADAPTATION (recorded, with source lines): recover-arg-count pins 3 from
/// parent plus now plus check (L114); the skip head pins the static wording
/// before the dynamic count and the skip tail pins the static wording after
/// it (impl L165), since one pin cannot hold the dynamic count.
/// Facet map (calls plus diagnostics): tempdir-op pins t.TempDir (L112);
/// candidate-call pins the orphan call (L113; five twin calls
/// L72/L75/L84/L124/L155);
/// recover-func pins recoverAbandoned (L114); recover-arg-count pins 3
/// (L114); check-shape pins func([]string) error (L114; twin shape L144);
/// probe-error-ctor pins errors.New (L114); fatal-verb pins t.Fatal (L115);
/// fatalf-verb pins t.Fatalf (L118); stat-call pins os.Stat(path) (L117;
/// twin call L147); skip-head pins the report head (impl L165); skip-tail
/// pins the report tail (impl L165); unavailable-format pins the
/// unavailability wording (impl L194); active-format pins the active wording
/// (impl L198).
/// Verdict legs live in history-036-cache-semantics.can; the roots-green pin
/// lives in history-036-roots-green.can.
/// Variants: the single lsof-unavailable variant shares one call and
/// diagnostic shape (a single default case; per-leg verdicts pin in
/// cache-semantics).
/// Environment: no gates; requires nothing. Logical gates
/// WORK/BUILD/CHILD/CLOCK and C/R/N/S/A identities bind at P23; no live run
/// now. Accept gate P23 is unmet. Timeout 60000ms is a neutral offline
/// descriptor default (the Go test sets no ctx).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-run checks: tempdir-op, candidate-call, recover-func,
/// recover-arg-count, check-shape, probe-error-ctor, fatal-verb, fatalf-verb,
/// stat-call, skip-head, skip-tail, unavailable-format, active-format.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str tempdir_op
    str candidate_call
    str recover_func
    int recover_arg_count
    str check_shape
    str probe_error_ctor
    str fatal_verb
    str fatalf_verb
    str stat_call
    str skip_head
    str skip_tail
    str unavailable_format
    str active_format
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-run", "default", "", "offline"), "tempdir-op" => ok "case history/cache-run variant default root tempdir-op run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-run", "default", "", "offline"), "tempdir-op" => ok evidence("tempdir-op", "true", "true", true, "case history/cache-run variant default root tempdir-op run offline")
        different: false, true, context("history/cache-run", "default", "", "offline"), "tempdir-op" => failed{"tempdir-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/cache-run", "default", "", "offline"), "recover-arg-count" => ok evidence("recover-arg-count", "3", "3", true, "case history/cache-run variant default root recover-arg-count run offline")
        different: 2, 3, context("history/cache-run", "default", "", "offline"), "recover-arg-count" => failed{"recover-arg-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "t.TempDir", "t.TempDir", context("history/cache-run", "default", "", "offline"), "tempdir-op" => ok evidence("tempdir-op", "t.TempDir", "t.TempDir", true, "case history/cache-run variant default root tempdir-op run offline")
        different: "t.TempDir_2", "t.TempDir", context("history/cache-run", "default", "", "offline"), "tempdir-op" => failed{"tempdir-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
