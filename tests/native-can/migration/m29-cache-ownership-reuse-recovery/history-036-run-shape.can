fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_h036: "m29-h036" => ok [check("tempdir-op", "setup uses t.TempDir"), check("candidate-call", "setup builds an aged dead-pid orphan"), check("recover-func", "recovery runs recoverAbandoned"), check("recover-arg-count", "recovery takes three args"), check("check-shape", "probe has the liveness closure shape"), check("probe-error-ctor", "probe builds its error with errors.New"), check("fatal-verb", "recovery leg fails plain"), check("fatalf-verb", "retention leg fails formatted"), check("stat-call", "retention leg stats the orphan path"), check("skip-head", "skip report opens with the suite head"), check("skip-tail", "skip report closes with count and error"), check("unavailable-format", "missing tools refuse as unavailable"), check("active-format", "live paths refuse as active")]
        other: "nope" => ok []
    match scope is "m29-h036"
        false => ok []
        true => ok [check("tempdir-op", "setup uses t.TempDir"), check("candidate-call", "setup builds an aged dead-pid orphan"), check("recover-func", "recovery runs recoverAbandoned"), check("recover-arg-count", "recovery takes three args"), check("check-shape", "probe has the liveness closure shape"), check("probe-error-ctor", "probe builds its error with errors.New"), check("fatal-verb", "recovery leg fails plain"), check("fatalf-verb", "retention leg fails formatted"), check("stat-call", "retention leg stats the orphan path"), check("skip-head", "skip report opens with the suite head"), check("skip-tail", "skip report closes with count and error"), check("unavailable-format", "missing tools refuse as unavailable"), check("active-format", "live paths refuse as active")]
