fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/cache-run", "default", "", "offline") => ok
        seed_tempdir_op: context("history/cache-run", "seed-tempdir-op-drift", "", "offline") => failed{"tempdir-op"}
        seed_candidate_call: context("history/cache-run", "seed-candidate-call-drift", "", "offline") => failed{"candidate-call"}
        seed_recover_func: context("history/cache-run", "seed-recover-func-drift", "", "offline") => failed{"recover-func"}
        seed_recover_arg_count: context("history/cache-run", "seed-recover-arg-count-drift", "", "offline") => failed{"recover-arg-count"}
        seed_check_shape: context("history/cache-run", "seed-check-shape-drift", "", "offline") => failed{"check-shape"}
        seed_probe_error_ctor: context("history/cache-run", "seed-probe-error-ctor-drift", "", "offline") => failed{"probe-error-ctor"}
        seed_fatal_verb: context("history/cache-run", "seed-fatal-verb-drift", "", "offline") => failed{"fatal-verb"}
        seed_fatalf_verb: context("history/cache-run", "seed-fatalf-verb-drift", "", "offline") => failed{"fatalf-verb"}
        seed_stat_call: context("history/cache-run", "seed-stat-call-drift", "", "offline") => failed{"stat-call"}
        seed_skip_head: context("history/cache-run", "seed-skip-head-drift", "", "offline") => failed{"skip-head"}
        seed_skip_tail: context("history/cache-run", "seed-skip-tail-drift", "", "offline") => failed{"skip-tail"}
        seed_unavailable_format: context("history/cache-run", "seed-unavailable-format-drift", "", "offline") => failed{"unavailable-format"}
        seed_active_format: context("history/cache-run", "seed-active-format-drift", "", "offline") => failed{"active-format"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.tempdir_op, "t.TempDir", c, "tempdir-op")
            failed
            ok evidence tempdir_op_evidence => match call require_text(got.candidate_call, "candidate(t, parent, deadPID, true)", c, "candidate-call")
                failed
                ok evidence candidate_call_evidence => match call require_text(got.recover_func, "recoverAbandoned", c, "recover-func")
                    failed
                    ok evidence recover_func_evidence => match call require_int(got.recover_arg_count, 3, c, "recover-arg-count")
                        failed
                        ok evidence recover_arg_count_evidence => match call require_text(got.check_shape, "func([]string) error", c, "check-shape")
                            failed
                            ok evidence check_shape_evidence => match call require_text(got.probe_error_ctor, "errors.New", c, "probe-error-ctor")
                                failed
                                ok evidence probe_error_ctor_evidence => match call require_text(got.fatal_verb, "t.Fatal", c, "fatal-verb")
                                    failed
                                    ok evidence fatal_verb_evidence => match call require_text(got.fatalf_verb, "t.Fatalf", c, "fatalf-verb")
                                        failed
                                        ok evidence fatalf_verb_evidence => match call require_text(got.stat_call, "os.Stat(path)", c, "stat-call")
                                            failed
                                            ok evidence stat_call_evidence => match call require_text(got.skip_head, "suite cache recovery skipped (", c, "skip-head")
                                                failed
                                                ok evidence skip_head_evidence => match call require_text(got.skip_tail, " candidates): %v", c, "skip-tail")
                                                    failed
                                                    ok evidence skip_tail_evidence => match call require_text(got.unavailable_format, "%s liveness unavailable or incomplete", c, "unavailable-format")
                                                        failed
                                                        ok evidence unavailable_format_evidence => match call require_text(got.active_format, "%s reports an active reference", c, "active-format")
                                                            failed
                                                            ok evidence active_format_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_h036: "m29-h036" => ok test_case("history/cache-run", ["history", "m29"], [], 60000, [check_ref("tempdir-op"), check_ref("candidate-call"), check_ref("recover-func"), check_ref("recover-arg-count"), check_ref("check-shape"), check_ref("probe-error-ctor"), check_ref("fatal-verb"), check_ref("fatalf-verb"), check_ref("stat-call"), check_ref("skip-head"), check_ref("skip-tail"), check_ref("unavailable-format"), check_ref("active-format")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-h036"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/cache-run", ["history", "m29"], [], 60000, [check_ref("tempdir-op"), check_ref("candidate-call"), check_ref("recover-func"), check_ref("recover-arg-count"), check_ref("check-shape"), check_ref("probe-error-ctor"), check_ref("fatal-verb"), check_ref("fatalf-verb"), check_ref("stat-call"), check_ref("skip-head"), check_ref("skip-tail"), check_ref("unavailable-format"), check_ref("active-format")], callable case_body)
