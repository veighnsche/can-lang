    asserts
        known: "history/cache-symlink-semantics" => ok [expected_check("not-followed", "true"), expected_check("not-offered", "true"), expected_check("path-kept", "true"), expected_check("recover-ok", "true"), expected_check("symlink-diag", "symlink reached liveness check"), expected_check("foreign-name", "foreign-marker"), expected_check("join-count", "2"), expected_check("err-guard-count", "7"), expected_check("fatal-count", "8"), expected_check("fatal-err-count", "7"), expected_check("stat-count", "1"), expected_check("recover-count", "1"), expected_check("read-count", "1"), expected_check("write-count", "1"), expected_check("remove-count", "1"), expected_check("symlink-count", "1"), expected_check("chtimes-count", "1"), expected_check("candidate-count", "1")]
