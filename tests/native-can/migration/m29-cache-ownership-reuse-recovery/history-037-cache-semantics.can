fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/cache-symlink-semantics", "default", "", "offline") => ok
        seed_not_followed: context("history/cache-symlink-semantics", "seed-not-followed-drift", "", "offline") => failed{"not-followed"}
        seed_not_offered: context("history/cache-symlink-semantics", "seed-not-offered-drift", "", "offline") => failed{"not-offered"}
        seed_path_kept: context("history/cache-symlink-semantics", "seed-path-kept-drift", "", "offline") => failed{"path-kept"}
        seed_recover_ok: context("history/cache-symlink-semantics", "seed-recover-ok-drift", "", "offline") => failed{"recover-ok"}
        seed_symlink_diag: context("history/cache-symlink-semantics", "seed-symlink-diag-drift", "", "offline") => failed{"symlink-diag"}
        seed_foreign_name: context("history/cache-symlink-semantics", "seed-foreign-name-drift", "", "offline") => failed{"foreign-name"}
        seed_join_count: context("history/cache-symlink-semantics", "seed-join-count-drift", "", "offline") => failed{"join-count"}
        seed_err_guard_count: context("history/cache-symlink-semantics", "seed-err-guard-count-drift", "", "offline") => failed{"err-guard-count"}
        seed_fatal_count: context("history/cache-symlink-semantics", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
        seed_fatal_err_count: context("history/cache-symlink-semantics", "seed-fatal-err-count-drift", "", "offline") => failed{"fatal-err-count"}
        seed_stat_count: context("history/cache-symlink-semantics", "seed-stat-count-drift", "", "offline") => failed{"stat-count"}
        seed_recover_count: context("history/cache-symlink-semantics", "seed-recover-count-drift", "", "offline") => failed{"recover-count"}
        seed_read_count: context("history/cache-symlink-semantics", "seed-read-count-drift", "", "offline") => failed{"read-count"}
        seed_write_count: context("history/cache-symlink-semantics", "seed-write-count-drift", "", "offline") => failed{"write-count"}
        seed_remove_count: context("history/cache-symlink-semantics", "seed-remove-count-drift", "", "offline") => failed{"remove-count"}
        seed_symlink_count: context("history/cache-symlink-semantics", "seed-symlink-count-drift", "", "offline") => failed{"symlink-count"}
        seed_chtimes_count: context("history/cache-symlink-semantics", "seed-chtimes-count-drift", "", "offline") => failed{"chtimes-count"}
        seed_candidate_count: context("history/cache-symlink-semantics", "seed-candidate-count-drift", "", "offline") => failed{"candidate-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.not_followed, true, c, "not-followed")
            failed
            ok evidence not_followed_evidence => match call require_bool(got.not_offered, true, c, "not-offered")
                failed
                ok evidence not_offered_evidence => match call require_bool(got.path_kept, true, c, "path-kept")
                    failed
                    ok evidence path_kept_evidence => match call require_bool(got.recover_ok, true, c, "recover-ok")
                        failed
                        ok evidence recover_ok_evidence => match call require_text(got.symlink_diag, "symlink reached liveness check", c, "symlink-diag")
                            failed
                            ok evidence symlink_diag_evidence => match call require_text(got.foreign_name, "foreign-marker", c, "foreign-name")
                                failed
                                ok evidence foreign_name_evidence => match call require_int(got.join_count, 2, c, "join-count")
                                    failed
                                    ok evidence join_count_evidence => match call require_int(got.err_guard_count, 7, c, "err-guard-count")
                                        failed
                                        ok evidence err_guard_count_evidence => match call require_int(got.fatal_count, 8, c, "fatal-count")
                                            failed
                                            ok evidence fatal_count_evidence => match call require_int(got.fatal_err_count, 7, c, "fatal-err-count")
                                                failed
                                                ok evidence fatal_err_count_evidence => match call require_int(got.stat_count, 1, c, "stat-count")
                                                    failed
                                                    ok evidence stat_count_evidence => match call require_int(got.recover_count, 1, c, "recover-count")
                                                        failed
                                                        ok evidence recover_count_evidence => match call require_int(got.read_count, 1, c, "read-count")
                                                            failed
                                                            ok evidence read_count_evidence => match call require_int(got.write_count, 1, c, "write-count")
                                                                failed
                                                                ok evidence write_count_evidence => match call require_int(got.remove_count, 1, c, "remove-count")
                                                                    failed
                                                                    ok evidence remove_count_evidence => match call require_int(got.symlink_count, 1, c, "symlink-count")
                                                                        failed
                                                                        ok evidence symlink_count_evidence => match call require_int(got.chtimes_count, 1, c, "chtimes-count")
                                                                            failed
                                                                            ok evidence chtimes_count_evidence => match call require_int(got.candidate_count, 1, c, "candidate-count")
                                                                                failed
                                                                                ok evidence candidate_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_h037: "m29-h037" => ok test_case("history/cache-symlink-semantics", ["history", "m29"], [], 60000, [check_ref("not-followed"), check_ref("not-offered"), check_ref("path-kept"), check_ref("recover-ok"), check_ref("symlink-diag"), check_ref("foreign-name"), check_ref("join-count"), check_ref("err-guard-count"), check_ref("fatal-count"), check_ref("fatal-err-count"), check_ref("stat-count"), check_ref("recover-count"), check_ref("read-count"), check_ref("write-count"), check_ref("remove-count"), check_ref("symlink-count"), check_ref("chtimes-count"), check_ref("candidate-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-h037"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/cache-symlink-semantics", ["history", "m29"], [], 60000, [check_ref("not-followed"), check_ref("not-offered"), check_ref("path-kept"), check_ref("recover-ok"), check_ref("symlink-diag"), check_ref("foreign-name"), check_ref("join-count"), check_ref("err-guard-count"), check_ref("fatal-count"), check_ref("fatal-err-count"), check_ref("stat-count"), check_ref("recover-count"), check_ref("read-count"), check_ref("write-count"), check_ref("remove-count"), check_ref("symlink-count"), check_ref("chtimes-count"), check_ref("candidate-count")], callable case_body)
