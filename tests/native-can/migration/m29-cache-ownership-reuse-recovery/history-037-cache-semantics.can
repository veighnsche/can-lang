package m29history037cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-037 "Symlink marker refused: verdicts".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryRejectsSymlinkMarker (L122-150); impl
/// tests/support/tempcache/cache.go recoverOne (L218-283),
/// O_NOFOLLOW (L239/L261), OpenRoot (L229).
/// Disposition: migrate (this row ports
/// TestRecoveryRejectsSymlinkMarker to ordinary Can
/// functions; the old Go harness stays until the integrator
/// retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live symlink verdicts in Go
/// order: the not-followed leg, the not-offered leg, the
/// path-kept leg, the recovery-ok leg; plus the symlink
/// refusal wording, the outside marker name, the join,
/// guard, fatal, stat, recovery, read, write, remove,
/// symlink, chtimes and candidate counts.
/// ADAPTATION (recorded, with source lines): not-followed
/// pins bool from the retained Stat (L147; O_NOFOLLOW
/// L239/L261 plus OpenRoot L229 refuse the link);
/// not-offered pins bool from the never-fired Fatal
/// (L144); path-kept pins bool from the Stat guard
/// (L147); recover-ok pins bool from the recovery guard
/// (L144-146); diags pin exact Go spellings (L144/L130);
/// join-count pins 2 (L125/L130); err-guard-count pins 7
/// (L127/L131/L134/L137/L141/L144/L147); fatal-count
/// pins 8 (L128/L132/L135/L138/L142/L144/L145/L148);
/// fatal-err-count pins 7 (same minus L144 diag);
/// stat-count pins 1 (L147); recover-count pins 1
/// (L144); read-count pins 1 (L126); write-count pins 1
/// (L131); remove-count pins 1 (L134); symlink-count
/// pins 1 (L137); chtimes-count pins 1 (L141);
/// candidate-count pins 1 (L124).
/// Facet map (Go verdict legs): not-followed pins true
/// (L147); not-offered pins true (L144); path-kept pins
/// true (L147); recover-ok pins true (L144);
/// symlink-diag pins the liveness wording (L144);
/// foreign-name pins foreign-marker (L130); join-count
/// pins 2 (L125/L130); err-guard-count pins 7
/// (L127/L131/L134/L137/L141/L144/L147); fatal-count
/// pins 8; fatal-err-count pins 7; stat-count pins 1
/// (L147); recover-count pins 1 (L144); read-count pins
/// 1 (L126); write-count pins 1 (L131); remove-count
/// pins 1 (L134); symlink-count pins 1 (L137);
/// chtimes-count pins 1 (L141); candidate-count pins 1
/// (L124).
/// The roots-green pin lives in history-037-roots-green.can;
/// the run shape lives in history-037-run-shape.can.
/// Variants: single symlink candidate (marker link, Go
/// order).
/// Environment: no env gate; local temp dir only.
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gate P23
/// is unmet. Timeout 60000ms bounds the read/write/remove/
/// symlink/chtimes/recovery/stat sequence (no Go guard
/// exists; offline only).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-symlink-semantics checks: not-followed,
/// not-offered, path-kept, recover-ok, symlink-diag,
/// foreign-name, join-count, err-guard-count, fatal-count,
/// fatal-err-count, stat-count, recover-count, read-count,
/// write-count, remove-count, symlink-count, chtimes-count,
/// candidate-count.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool not_followed
    bool not_offered
    bool path_kept
    bool recover_ok
    str symlink_diag
    str foreign_name
    int join_count
    int err_guard_count
    int fatal_count
    int fatal_err_count
    int stat_count
    int recover_count
    int read_count
    int write_count
    int remove_count
    int symlink_count
    int chtimes_count
    int candidate_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-symlink-semantics", "default", "", "offline"), "not-followed" => ok "case history/cache-symlink-semantics variant default root not-followed run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-symlink-semantics", "default", "", "offline"), "not-followed" => ok evidence("not-followed", "true", "true", true, "case history/cache-symlink-semantics variant default root not-followed run offline")
        different: false, true, context("history/cache-symlink-semantics", "default", "", "offline"), "not-followed" => failed{"not-followed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/cache-symlink-semantics", "default", "", "offline"), "join-count" => ok evidence("join-count", "2", "2", true, "case history/cache-symlink-semantics variant default root join-count run offline")
        different: 3, 2, context("history/cache-symlink-semantics", "default", "", "offline"), "join-count" => failed{"join-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "symlink reached liveness check", "symlink reached liveness check", context("history/cache-symlink-semantics", "default", "", "offline"), "symlink-diag" => ok evidence("symlink-diag", "symlink reached liveness check", "symlink reached liveness check", true, "case history/cache-symlink-semantics variant default root symlink-diag run offline")
        different: "symlink reached liveness check_2", "symlink reached liveness check", context("history/cache-symlink-semantics", "default", "", "offline"), "symlink-diag" => failed{"symlink-diag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
