    str marker_name
    str lease_name
    str schema_name
    str mkdir_mode
    str file_mode
    int recovery_limit
    int cache_field_count
    bool nil_close_ok
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-symlink-roots", "default", "", "offline"), "pkg-name" => ok "case history/cache-symlink-roots variant default root pkg-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-symlink-roots", "default", "", "offline"), "nil-close-ok" => ok evidence("nil-close-ok", "true", "true", true, "case history/cache-symlink-roots variant default root nil-close-ok run offline")
        different: false, true, context("history/cache-symlink-roots", "default", "", "offline"), "nil-close-ok" => failed{"nil-close-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 16, 16, context("history/cache-symlink-roots", "default", "", "offline"), "recovery-limit" => ok evidence("recovery-limit", "16", "16", true, "case history/cache-symlink-roots variant default root recovery-limit run offline")
        different: 15, 16, context("history/cache-symlink-roots", "default", "", "offline"), "recovery-limit" => failed{"recovery-limit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "tempcache", "tempcache", context("history/cache-symlink-roots", "default", "", "offline"), "pkg-name" => ok evidence("pkg-name", "tempcache", "tempcache", true, "case history/cache-symlink-roots variant default root pkg-name run offline")
        different: "tempcache_2", "tempcache", context("history/cache-symlink-roots", "default", "", "offline"), "pkg-name" => failed{"pkg-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
