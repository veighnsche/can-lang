/// M29 HISTORY-037 "Symlink marker refused: roots green".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryRejectsSymlinkMarker (L122-150); package
/// plus imports (L1-11); impl
/// tests/support/tempcache/cache.go consts (L21-30),
/// structs (L32-42), Open (L47-96), recoverOne
/// (L218-283), O_NOFOLLOW (L239/L261), OpenRoot (L229).
/// Disposition: migrate (this row ports
/// TestRecoveryRejectsSymlinkMarker to ordinary Can
/// functions; the old Go harness stays until the integrator
/// retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the static live baseline as the
/// green root: the package plus func names, the TempDir,
/// candidate, Join, ReadFile, WriteFile, Remove, Symlink,
/// Chtimes, recoverAbandoned, Stat, Fatal spellings, the
/// O_NOFOLLOW plus OpenRoot guard spellings, the cache
/// prefix, marker, lease, schema names, the mkdir plus
/// file modes, the recovery bound, the Cache field count,
/// and the nil-close ok.
/// ADAPTATION (recorded, with source lines): modes pin str
/// to keep the 0755/0600 spellings (cache.go L55/L80/L91
/// plus test L131); limit pins int 16 (L30); field count
/// pins int 3 from the Cache struct (L39-41); nil-close
/// pins bool from the nil guard (L101-103); op spellings
/// pin the exact Go identifiers (TempDir L123, candidate
/// L124, Join L125/L130, ReadFile L126, WriteFile L131,
/// Remove L134, Symlink L137, Chtimes L141,
/// recoverAbandoned L144, Stat L147, Fatal L128/L132/
/// L135/L138/L142/L144/L145/L148, O_NOFOLLOW impl
/// L239/L261, OpenRoot impl L229).
/// Facet map (static baseline): pkg-name pins tempcache
/// (test L1); func-name pins the symlink probe (L122);
/// tempdir-op pins TempDir (L123); candidate-op pins
/// candidate (L124); join-op pins Join (L125/L130);
/// read-op pins ReadFile (L126); write-op pins WriteFile
/// (L131); remove-op pins Remove (L134); symlink-op pins
/// Symlink (L137); chtimes-op pins Chtimes (L141);
/// recover-op pins recoverAbandoned (L144); stat-op pins
/// Stat (L147); fatal-op pins Fatal (L128); nofollow-op
/// pins O_NOFOLLOW (impl L239/L261); openroot-op pins
/// OpenRoot (impl L229); cache-prefix pins can-suite-cache-
/// (impl L21); marker-name pins .can-test-owner.json
/// (impl L22); lease-name pins .can-test-lease (impl
/// L23); schema-name pins can.test-suite-cache/1 (impl
/// L24); mkdir-mode pins 0755 (impl L55); file-mode pins
/// 0600 (impl L80/L91 plus test L131); recovery-limit
/// pins 16 (impl L30); cache-field-count pins 3 (impl
/// L39-41); nil-close-ok pins true (impl L101-103).
/// Answer verdicts live in history-037-cache-semantics.can;
/// the run shape lives in history-037-run-shape.can.
/// Variants: none in this file (default only); the single
/// symlink candidate pins in cache-semantics.
/// Environment: no env gate; local temp dir only.
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gate P23
/// is unmet. Timeout 60000ms bounds the static baseline
/// probe (no Go guard exists; offline only).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-symlink-roots checks: pkg-name,
/// func-name, tempdir-op, candidate-op, join-op, read-op,
/// write-op, remove-op, symlink-op, chtimes-op, recover-op,
/// stat-op, fatal-op, nofollow-op, openroot-op, cache-prefix,
/// marker-name, lease-name, schema-name, mkdir-mode,
/// file-mode, recovery-limit, cache-field-count, nil-close-ok.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str pkg_name
    str func_name
    str tempdir_op
    str candidate_op
    str join_op
    str read_op
    str write_op
    str remove_op
    str symlink_op
    str chtimes_op
    str recover_op
