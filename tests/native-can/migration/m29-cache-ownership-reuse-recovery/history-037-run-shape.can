package m29history037run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-037 "Symlink marker refused: run shape".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryRejectsSymlinkMarker (L122-150); impl
/// tests/support/tempcache/cache.go O_NOFOLLOW refusal
/// (L239/L261) plus OpenRoot (L229).
/// Disposition: migrate (this row ports
/// TestRecoveryRejectsSymlinkMarker to ordinary Can
/// functions; the old Go harness stays until the integrator
/// retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live run shape in Go order:
/// the parent/path/marker/data/outside/old vars, the
/// TempDir plus candidate calls, the two Join calls with
/// read/write/remove/symlink/chtimes legs, the age call,
/// the recovery call with its liveness refusal, the Stat
/// leg, the Fatal call shape plus Fatal diag, the
/// tempdir/line/now/fatalf counts, and the remove/recovery
/// ordering verdicts.
/// ADAPTATION (recorded, with source lines): tempdir-count
/// pins 1 from the in-range TempDir site (L123; five exist
/// file-wide); func-line-count pins 29 from L122-150
/// inclusive; time-now-count pins 2 from the in-range Now
/// sites (L140/L144; six exist file-wide); fatalf-count
/// pins 0 from the absent Fatalf in range (nine exist
/// file-wide); ordering verdicts pin bools from line order
/// (remove L134 precedes symlink L137; recovery L144
/// precedes stat L147); call spellings pin exact Go bytes
/// without leading tabs or trailing braces or guards.
/// Facet map (run order): parent-var pins parent (L123);
/// path-var pins path (L124); marker-var pins marker
/// (L125); data-var pins data (L126); outside-var pins
/// outside (L130); old-var pins old (L140); tempdir-call
/// pins t.TempDir() (L123); candidate-call pins
/// candidate(t, parent, deadPID, true) (L124);
/// join-marker-call pins filepath.Join(path, markerName)
/// (L125); read-call pins os.ReadFile(marker) (L126);
/// join-outside-call pins filepath.Join(parent,
/// "foreign-marker") (L130); write-call pins
/// os.WriteFile(outside, data, 0600) (L131); remove-call
/// pins os.Remove(marker) (L134); symlink-call pins
/// os.Symlink(outside, marker) (L137); age-call pins
/// time.Now().Add(-2 * recoveryAge) (L140); chtimes-call
/// pins os.Chtimes(path, old, old) (L141); recover-call
/// pins the full recovery line minus guard (L144);
/// stat-leg pins os.Stat(path) (L147); fatal-call pins
/// t.Fatal(err) (L128); fatal-diag pins the symlink
/// refusal call (L144); tempdir-count pins 1 (L123);
/// func-line-count pins 29 (L122-150); time-now-count
/// pins 2 (L140/L144); fatalf-count pins 0 (none in
/// range); remove-before-symlink pins true (L134 before
/// L137); recover-before-stat pins true (L144 before
/// L147).
/// Answer verdicts live in history-037-cache-semantics.can;
/// the roots-green pin lives in history-037-roots-green.can.
/// Variants: single symlink candidate shares one run shape
/// (a single default case; per-leg verdicts pin in
/// cache-semantics).
/// Environment: no env gate; local temp dir only.
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gate P23
/// is unmet. Timeout 60000ms bounds the run-shape probe
/// (no Go guard exists; offline only).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-symlink-run checks: parent-var,
/// path-var, marker-var, data-var, outside-var, old-var,
/// tempdir-call, candidate-call, join-marker-call,
/// read-call, join-outside-call, write-call, remove-call,
/// symlink-call, age-call, chtimes-call, recover-call,
/// stat-leg, fatal-call, fatal-diag, tempdir-count,
/// func-line-count, time-now-count, fatalf-count,
/// remove-before-symlink, recover-before-stat.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str parent_var
    str path_var
    str marker_var
    str data_var
    str outside_var
    str old_var
    str tempdir_call
    str candidate_call
    str join_marker_call
    str read_call
    str join_outside_call
    str write_call
    str remove_call
    str symlink_call
    str age_call
    str chtimes_call
    str recover_call
    str stat_leg
    str fatal_call
    str fatal_diag
    int tempdir_count
    int func_line_count
    int time_now_count
    int fatalf_count
    bool remove_before_symlink
    bool recover_before_stat
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-symlink-run", "default", "", "offline"), "parent-var" => ok "case history/cache-symlink-run variant default root parent-var run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-symlink-run", "default", "", "offline"), "remove-before-symlink" => ok evidence("remove-before-symlink", "true", "true", true, "case history/cache-symlink-run variant default root remove-before-symlink run offline")
        different: false, true, context("history/cache-symlink-run", "default", "", "offline"), "remove-before-symlink" => failed{"remove-before-symlink"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/cache-symlink-run", "default", "", "offline"), "tempdir-count" => ok evidence("tempdir-count", "1", "1", true, "case history/cache-symlink-run variant default root tempdir-count run offline")
        different: 2, 1, context("history/cache-symlink-run", "default", "", "offline"), "tempdir-count" => failed{"tempdir-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "parent", "parent", context("history/cache-symlink-run", "default", "", "offline"), "parent-var" => ok evidence("parent-var", "parent", "parent", true, "case history/cache-symlink-run variant default root parent-var run offline")
        different: "parent_2", "parent", context("history/cache-symlink-run", "default", "", "offline"), "parent-var" => failed{"parent-var"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
