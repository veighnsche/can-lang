fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_h038: "m29-h038" => ok test_case("history/cache-bounded-semantics", ["history", "m29"], [], 60000, [check_ref("bounded-ok"), check_ref("overflow-kept"), check_ref("recover-ok"), check_ref("count-diag"), check_ref("unbounded-diag"), check_ref("recovery-limit"), check_ref("seed-extra"), check_ref("seed-total"), check_ref("candidate-sites"), check_ref("recover-sites"), check_ref("readdir-count"), check_ref("fatalf-count"), check_ref("fatal-count"), check_ref("len-count"), check_ref("limit-refs"), check_ref("total-legs"), check_ref("verb-count"), check_ref("overflow-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-h038"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/cache-bounded-semantics", ["history", "m29"], [], 60000, [check_ref("bounded-ok"), check_ref("overflow-kept"), check_ref("recover-ok"), check_ref("count-diag"), check_ref("unbounded-diag"), check_ref("recovery-limit"), check_ref("seed-extra"), check_ref("seed-total"), check_ref("candidate-sites"), check_ref("recover-sites"), check_ref("readdir-count"), check_ref("fatalf-count"), check_ref("fatal-count"), check_ref("len-count"), check_ref("limit-refs"), check_ref("total-legs"), check_ref("verb-count"), check_ref("overflow-count")], callable case_body)
