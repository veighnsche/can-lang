package m29history038cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-038 "Bounded recovery: verdicts".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryWorkIsBounded (L152-172); impl
/// tests/support/tempcache/cache.go limit (L30) plus
/// recoverAbandoned (L132-178).
/// Disposition: migrate (this row ports
/// TestRecoveryWorkIsBounded to ordinary Can
/// functions; the old Go harness stays until the integrator
/// retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the two live verdicts in Go order:
/// the bounded-count leg, the overflow-kept leg, the
/// recover-ok guard, the two refusal wordings, the
/// sixteen cap, the plus-one seed shape, the
/// candidate/recover/readdir counts, the len/limit/
/// leg/verb counts, and the single leftover.
/// ADAPTATION (recorded, with source lines): verdicts pin
/// bools from the len guards (L158/L169); recover-ok pins
/// bool from the recover guard (L157/L162); diags pin the
/// exact Go Fatalf spellings (L159/L170); recovery-limit
/// pins 16 from the const (impl L30); seed-extra pins 1
/// from the +1 (L154); seed-total pins 17 from 16+1
/// (L154); candidate-sites pins 1 (L155); recover-sites
/// pins 1 (L157); readdir-count pins 1 (L165);
/// fatalf-count pins 2 (L159/L170); fatal-count pins 2
/// (L163/L167); len-count pins 4 (L158/L159/L169/L170);
/// limit-refs pins 3 (L154/L158/L159); total-legs pins 2
/// (L158/L169); verb-count pins 3 (L159 x2 plus L170);
/// overflow-count pins 1 (L169).
/// Facet map (Go verdict legs): bounded-ok pins true
/// (L158); overflow-kept pins true (L169); recover-ok pins
/// true (L157/L162); count-diag pins the count wording
/// (L159); unbounded-diag pins the unbounded wording
/// (L170); recovery-limit pins 16 (impl L30); seed-extra
/// pins 1 (L154); seed-total pins 17 (L154);
/// candidate-sites pins 1 (L155); recover-sites pins 1
/// (L157); readdir-count pins 1 (L165); fatalf-count pins
/// 2 (L159/L170); fatal-count pins 2 (L163/L167);
/// len-count pins 4 (L158/L159/L169/L170); limit-refs pins
/// 3 (L154/L158/L159); total-legs pins 2 (L158/L169);
/// verb-count pins 3 (L159/L170); overflow-count pins 1
/// (L169).
/// The roots-green pin lives in history-038-roots-green.can;
/// the run shape lives in history-038-run-shape.can.
/// Variants: limit-plus-one seeds (sixteen plus one, Go
/// order).
/// Environment: no env gate; local temp dir only.
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gate P23
/// is unmet. Timeout 60000ms bounds the seed-loop/one-
/// recover/one-readdir/two-verdict sequence (no Go guard
/// exists; offline only).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-bounded-semantics checks: bounded-ok,
/// overflow-kept, recover-ok, count-diag, unbounded-diag,
/// recovery-limit, seed-extra, seed-total, candidate-sites,
/// recover-sites, readdir-count, fatalf-count, fatal-count,
/// len-count, limit-refs, total-legs, verb-count,
/// overflow-count.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool bounded_ok
    bool overflow_kept
    bool recover_ok
    str count_diag
    str unbounded_diag
    int recovery_limit
    int seed_extra
    int seed_total
    int candidate_sites
    int recover_sites
    int readdir_count
    int fatalf_count
    int fatal_count
    int len_count
    int limit_refs
    int total_legs
    int verb_count
    int overflow_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-bounded-semantics", "default", "", "offline"), "bounded-ok" => ok "case history/cache-bounded-semantics variant default root bounded-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-bounded-semantics", "default", "", "offline"), "bounded-ok" => ok evidence("bounded-ok", "true", "true", true, "case history/cache-bounded-semantics variant default root bounded-ok run offline")
        different: false, true, context("history/cache-bounded-semantics", "default", "", "offline"), "bounded-ok" => failed{"bounded-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 16, 16, context("history/cache-bounded-semantics", "default", "", "offline"), "recovery-limit" => ok evidence("recovery-limit", "16", "16", true, "case history/cache-bounded-semantics variant default root recovery-limit run offline")
        different: 17, 16, context("history/cache-bounded-semantics", "default", "", "offline"), "recovery-limit" => failed{"recovery-limit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "recovery count %d, want %d", "recovery count %d, want %d", context("history/cache-bounded-semantics", "default", "", "offline"), "count-diag" => ok evidence("count-diag", "recovery count %d, want %d", "recovery count %d, want %d", true, "case history/cache-bounded-semantics variant default root count-diag run offline")
        different: "recovery count %d, want %d_2", "recovery count %d, want %d", context("history/cache-bounded-semantics", "default", "", "offline"), "count-diag" => failed{"count-diag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
