/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryWorkIsBounded (L152-172); package plus
/// imports (L1-11); impl tests/support/tempcache/cache.go
/// consts (L21-30), recover guard (L144-152).
