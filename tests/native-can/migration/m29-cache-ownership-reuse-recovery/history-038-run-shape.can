package m29history038run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-038 "Bounded recovery: run shape".
/// Source: tests/support/tempcache/cache_test.go symbol
/// TestRecoveryWorkIsBounded (L152-172); impl
/// tests/support/tempcache/cache.go inspected guard
/// (L144-152).
/// Disposition: migrate (this row ports
/// TestRecoveryWorkIsBounded to ordinary Can
/// functions; the old Go harness stays until the integrator
/// retires it after every linked row, variant, environment
/// and control has accepted evidence).
/// Protects (this file): the live run shape in Go order:
/// the parent var plus TempDir call, the loop head with
/// its candidate call, the recover call with the bound leg
/// and count wording, the Fatal call shape plus Fatalf op,
/// the readdir leg, the overflow leg with its wording, the
/// return-nil leg, the tempdir/err-guard/line/verb counts,
/// and the loop-plus-recover ordering verdicts.
/// ADAPTATION (recorded, with source lines): tempdir-count
/// pins 1 from the in-range TempDir site (L153; five exist
/// file-wide); err-guard-count pins 2 from the in-range
/// err-nil guards (L162/L166); func-line-count pins 21
/// from L152-172 inclusive; verb-count pins 3 from the
/// Fatalf verbs (L159 x2 plus L170); ordering verdicts pin
/// bools from line order (loop L154 precedes recover L157;
/// recover L157 precedes readdir L165); call spellings pin
/// exact Go bytes without leading tabs or trailing braces.
/// Facet map (run order): parent-var pins parent (L153);
/// loop-var pins i (L154); paths-var pins paths (L157);
/// remaining-var pins remaining (L165); tempdir-call pins
/// t.TempDir() (L153); loop-head pins the for line (L154);
/// candidate-call pins candidate(t, parent, deadPID, true)
/// (L155); recover-call pins the recover line (L157);
/// bound-leg pins len(paths) != recoveryLimit (L158);
/// count-diag pins the count wording (L159); fatalf-op pins
/// t.Fatalf (L159/L170); fatal-call pins t.Fatal(err)
/// (L163/L167); readdir-leg pins os.ReadDir(parent) (L165);
/// overflow-leg pins len(remaining) != 1 (L169);
/// unbounded-diag pins the unbounded wording (L170);
/// return-leg pins return nil (L161); tempdir-count pins 1
/// (L153); err-guard-count pins 2 (L162/L166);
/// func-line-count pins 21 (L152-172); verb-count pins 3
/// (L159/L170); loop-before-recover pins true (L154 before
/// L157); recover-before-readdir pins true (L157 before
/// L165).
/// Answer verdicts live in history-038-cache-semantics.can;
/// the roots-green pin lives in history-038-roots-green.can.
/// Variants: limit-plus-one seeds share one run shape (a
/// single default case; per-leg verdicts pin in
/// cache-semantics).
/// Environment: no env gate; local temp dir only.
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE and C/R/N/S/A
/// identities bind at P23; no live run now. Accept gate P23
/// is unmet. Timeout 60000ms bounds the run-shape probe
/// (no Go guard exists; offline only).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-bounded-run checks: parent-var,
/// loop-var, paths-var, remaining-var, tempdir-call,
/// loop-head, candidate-call, recover-call, bound-leg,
/// count-diag, fatalf-op, fatal-call, readdir-leg,
/// overflow-leg, unbounded-diag, return-leg, tempdir-count,
/// err-guard-count, func-line-count, verb-count,
/// loop-before-recover, recover-before-readdir.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str parent_var
    str loop_var
    str paths_var
    str remaining_var
    str tempdir_call
    str loop_head
    str candidate_call
    str recover_call
    str bound_leg
    str count_diag
    str fatalf_op
    str fatal_call
    str readdir_leg
    str overflow_leg
    str unbounded_diag
    str return_leg
    int tempdir_count
    int err_guard_count
    int func_line_count
    int verb_count
    bool loop_before_recover
    bool recover_before_readdir
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-bounded-run", "default", "", "offline"), "parent-var" => ok "case history/cache-bounded-run variant default root parent-var run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-bounded-run", "default", "", "offline"), "loop-before-recover" => ok evidence("loop-before-recover", "true", "true", true, "case history/cache-bounded-run variant default root loop-before-recover run offline")
        different: false, true, context("history/cache-bounded-run", "default", "", "offline"), "loop-before-recover" => failed{"loop-before-recover"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/cache-bounded-run", "default", "", "offline"), "tempdir-count" => ok evidence("tempdir-count", "1", "1", true, "case history/cache-bounded-run variant default root tempdir-count run offline")
        different: 2, 1, context("history/cache-bounded-run", "default", "", "offline"), "tempdir-count" => failed{"tempdir-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "parent", "parent", context("history/cache-bounded-run", "default", "", "offline"), "parent-var" => ok evidence("parent-var", "parent", "parent", true, "case history/cache-bounded-run variant default root parent-var run offline")
        different: "parent_2", "parent", context("history/cache-bounded-run", "default", "", "offline"), "parent-var" => failed{"parent-var"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
