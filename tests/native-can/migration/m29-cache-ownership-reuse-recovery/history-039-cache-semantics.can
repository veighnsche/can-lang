        ok observation got => match call require_text(got.bypass_env, "CONV_BUNDLE", c, "bypass-env")
            failed
            ok evidence bypass_env_evidence => match call require_bool(got.bypass_verifies, true, c, "bypass-verifies")
                failed
                ok evidence bypass_verifies_evidence => match call require_text(got.archive_env, "CAN_BUN_ARCHIVE", c, "archive-env")
                    failed
                    ok evidence archive_env_evidence => match call require_bool(got.skip_when_unset, true, c, "skip-when-unset")
                        failed
                        ok evidence skip_when_unset_evidence => match call require_bool(got.build_once_per_key, true, c, "build-once-per-key")
                            failed
