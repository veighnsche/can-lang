package m29history039cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-039 "Bundle cache: verdict semantics".
/// Source: tests/failure-conventions/harness_test.go symbol
/// TestMain plus resolveBundle (L75-92), cachedBundle
/// (L99-131), suiteCache (L133-138), TestMain/runSuite
/// (L142-154), bundleCacheRoot (L156-165) and the
/// bundleKey input set (L169-216).
/// Disposition: migrate (this row ports the TestMain
/// suite-owned bundle cache contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the allocate-once legs, the
/// reuse-by-key verdicts with key input counts, the
/// abandoned-work recovery legs, the close-after-m.Run
/// ordering, and the CONV_BUNDLE bypass legs, all in Go
/// order.
/// ADAPTATION (recorded, with source lines): bypass legs
/// pin the CONV_BUNDLE spelling (L77) plus the verify
/// bool (L78); archive legs pin the CAN_BUN_ARCHIVE
/// spelling (L83) plus the skip bool (L84-86);
/// build-once-per-key pins bool from the cachedBundle doc
/// (L96); root-once pins bool from once.Do (L158);
/// parent-env pins CAN_TEST_CACHE (L159); key counts pin
/// ints from the dir slice (L172), the module file slice
/// (L189) and the three pinned tags (L200-202);
/// entry-prefix pins bundle- (L106); complete-marker pins
/// cache-complete (L235); verify-before-reuse pins bool
/// from the reuse guard (L110); lock-suffix pins .lock
/// (L113); wait-before-reap pins bool from the wait then
/// reap order (L123-126); stale-reaped pins bool from the
/// stale removal (L271-272); close-after-run pins bool
/// from the deferred Close around m.Run (L147-153);
/// close-exit-code pins int (1) from the failure code
/// (L150).
/// Facet map (Go verdict legs): bypass-env pins
/// CONV_BUNDLE (L77); bypass-verifies pins true (L78);
/// archive-env pins CAN_BUN_ARCHIVE (L83); skip-when-unset
/// pins true (L84-86); build-once-per-key pins true (L96);
/// root-once pins true (L158); parent-env pins
/// CAN_TEST_CACHE (L159); key-dir-count pins 4 (L172);
/// key-file-count pins 2 (L189); key-tag-count pins 3
/// (L200-202); entry-prefix pins bundle- (L106);
/// complete-marker pins cache-complete (L235);
/// verify-before-reuse pins true (L110); lock-suffix pins
/// .lock (L113); wait-before-reap pins true (L123-126);
/// stale-reaped pins true (L271-272); close-after-run pins
/// true (L147-153); close-exit-code pins 1 (L150).
/// The roots-green pin lives in history-039-roots-green.can;
/// the run shape plus diagnostics live in
/// history-039-run-shape.can.
/// Variants: none (row lists zero variants; one default
/// case per file).
/// Environment: requires conv-bundle, can-bun-archive,
/// can-test-cache (row gates CONV_BUNDLE, CAN_BUN_ARCHIVE,
/// CAN_TEST_CACHE; lowercase-hyphen requires form per the
/// M25 precedent; binds at P23).
/// Logical gates SUITE/BUILD/WORK/ENV bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is
/// the offline default bound (the Go 30-minute fill wait
/// plus 500ms poll are runtime waits pinned as checks, not
/// test timeouts; binds at P23 like the M11 rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/bundle-cache-semantics checks: bypass-env,
/// bypass-verifies, archive-env, skip-when-unset,
/// build-once-per-key, root-once, parent-env, key-dir-count,
/// key-file-count, key-tag-count, entry-prefix,
/// complete-marker, verify-before-reuse, lock-suffix,
/// wait-before-reap, stale-reaped, close-after-run,
/// close-exit-code.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str bypass_env
    bool bypass_verifies
    str archive_env
    bool skip_when_unset
    bool build_once_per_key
    bool root_once
    str parent_env
    int key_dir_count
    int key_file_count
    int key_tag_count
    str entry_prefix
    str complete_marker
    bool verify_before_reuse
    str lock_suffix
    bool wait_before_reap
    bool stale_reaped
    bool close_after_run
    int close_exit_code
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/bundle-cache-semantics", "default", "", "offline"), "bypass-env" => ok "case history/bundle-cache-semantics variant default root bypass-env run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/bundle-cache-semantics", "default", "", "offline"), "bypass-verifies" => ok evidence("bypass-verifies", "true", "true", true, "case history/bundle-cache-semantics variant default root bypass-verifies run offline")
        different: false, true, context("history/bundle-cache-semantics", "default", "", "offline"), "bypass-verifies" => failed{"bypass-verifies"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/bundle-cache-semantics", "default", "", "offline"), "key-dir-count" => ok evidence("key-dir-count", "4", "4", true, "case history/bundle-cache-semantics variant default root key-dir-count run offline")
        different: 5, 4, context("history/bundle-cache-semantics", "default", "", "offline"), "key-dir-count" => failed{"key-dir-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CONV_BUNDLE", "CONV_BUNDLE", context("history/bundle-cache-semantics", "default", "", "offline"), "bypass-env" => ok evidence("bypass-env", "CONV_BUNDLE", "CONV_BUNDLE", true, "case history/bundle-cache-semantics variant default root bypass-env run offline")
        different: "CONV_BUNDLE_2", "CONV_BUNDLE", context("history/bundle-cache-semantics", "default", "", "offline"), "bypass-env" => failed{"bypass-env"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
