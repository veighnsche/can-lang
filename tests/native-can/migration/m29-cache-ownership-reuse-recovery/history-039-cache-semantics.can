fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_h039: "m29-h039" => ok [check("bypass-env", "bypass env keeps its Go spelling"), check("bypass-verifies", "bypass path re-verifies the bundle"), check("archive-env", "archive env keeps its Go spelling"), check("skip-when-unset", "legs skip when both inputs are unset"), check("build-once-per-key", "each key builds at most once"), check("root-once", "root creation runs under once Do"), check("parent-env", "parent env keeps its Go spelling"), check("key-dir-count", "four source dirs feed the key"), check("key-file-count", "two module files feed the key"), check("key-tag-count", "three pinned tags feed the key"), check("entry-prefix", "entry dir keeps the bundle prefix"), check("complete-marker", "marker name keeps its spelling"), check("verify-before-reuse", "reuse wants complete plus verified"), check("lock-suffix", "fill lock keeps the lock suffix"), check("wait-before-reap", "waiters wait before reaping"), check("stale-reaped", "stale locks are removed"), check("close-after-run", "close is deferred around m Run"), check("close-exit-code", "close failure exits nonzero")]
        other: "nope" => ok []
    match scope is "m29-h039"
        false => ok []
        true => ok [check("bypass-env", "bypass env keeps its Go spelling"), check("bypass-verifies", "bypass path re-verifies the bundle"), check("archive-env", "archive env keeps its Go spelling"), check("skip-when-unset", "legs skip when both inputs are unset"), check("build-once-per-key", "each key builds at most once"), check("root-once", "root creation runs under once Do"), check("parent-env", "parent env keeps its Go spelling"), check("key-dir-count", "four source dirs feed the key"), check("key-file-count", "two module files feed the key"), check("key-tag-count", "three pinned tags feed the key"), check("entry-prefix", "entry dir keeps the bundle prefix"), check("complete-marker", "marker name keeps its spelling"), check("verify-before-reuse", "reuse wants complete plus verified"), check("lock-suffix", "fill lock keeps the lock suffix"), check("wait-before-reap", "waiters wait before reaping"), check("stale-reaped", "stale locks are removed"), check("close-after-run", "close is deferred around m Run"), check("close-exit-code", "close failure exits nonzero")]
