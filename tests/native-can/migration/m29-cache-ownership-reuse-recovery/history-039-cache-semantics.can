        seed_lock_suffix: context("history/bundle-cache-semantics", "seed-lock-suffix-drift", "", "offline") => failed{"lock-suffix"}
        seed_wait_before_reap: context("history/bundle-cache-semantics", "seed-wait-before-reap-drift", "", "offline") => failed{"wait-before-reap"}
        seed_stale_reaped: context("history/bundle-cache-semantics", "seed-stale-reaped-drift", "", "offline") => failed{"stale-reaped"}
