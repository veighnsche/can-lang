package m29history039roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-039 "Bundle cache: roots green".
/// Source: tests/failure-conventions/harness_test.go func
/// plus var names (L75-299), the bundleKey input literals
/// (L172/L189/L200-202), the manifest literals (L278/L286),
/// the entry literals (L106/L220) and the mode literals
/// (L107/L235).
/// Disposition: migrate (this row ports the TestMain
/// suite-owned bundle cache contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the static bundle-cache baseline
/// as the green root: the eleven func names, the two
/// suite var names, the once type plus open call plus path
/// field, the four key dir names, the two key file names,
/// the three key tag names plus the pinned version value,
/// the manifest file plus kind plus schema int, the fill
/// prefix, and the dir plus file modes.
/// ADAPTATION (recorded, with source lines): func names
/// pin the Go identifiers verbatim (L75/L99/L142/L146/L157/
/// L169/L218/L244/L252/L266/L277); vars pin suiteCache
/// (L133) plus bundleMu (L94); once-type pins sync.Once
/// (L134); open-call pins tempcache.Open (L159);
/// path-field pins Path (L161); key inputs pin the slice
/// plus tag literals (L172/L189/L200-202); version-value
/// pins harness-shared (L202); manifest pins pin the file
/// plus kind literals plus the schema int (L278/L286);
/// modes pin the 0755/0644 spellings structurally as str
/// (L107/L235).
/// Facet map (static baseline): main-name pins TestMain
/// (L142); suite-name pins runSuite (L146); resolve-name
/// pins resolveBundle (L75); cached-name pins cachedBundle
/// (L99); root-name pins bundleCacheRoot (L157); key-name
/// pins bundleKey (L169); build-name pins buildBundleEntry
/// (L218); complete-name pins entryComplete (L244);
/// wait-name pins waitForEntry (L252); reap-name pins
/// reapStaleLock (L266); verify-name pins verifyBundle
/// (L277); cache-var pins suiteCache (L133); mutex-var pins
/// bundleMu (L94); once-type pins sync.Once (L134);
/// open-call pins tempcache.Open (L159); path-field pins
/// Path (L161); key-dir-compiler pins compiler (L172);
/// key-dir-distribution pins distribution (L172);
/// key-dir-runtime pins runtime (L172); key-dir-tools pins
/// tools (L172); key-file-mod pins go.mod (L189);
/// key-file-sum pins go.sum (L189); key-tag-archive pins
/// @archive (L200); key-tag-go pins @go (L201);
/// key-tag-version pins @version (L202); version-value pins
/// harness-shared (L202); manifest-file pins manifest.json
/// (L278); manifest-kind pins can.development-distribution
/// (L286); schema-version pins 1 (L286); fill-prefix pins
/// .fill- (L220); dir-mode pins 0755 (L107); file-mode pins
/// 0644 (L235).
/// The verdict pins live in history-039-cache-semantics.can;
/// the run shape plus diagnostics live in
/// history-039-run-shape.can.
/// Variants: none (row lists zero variants; one default
/// case per file).
/// Environment: requires conv-bundle, can-bun-archive,
/// can-test-cache (row gates CONV_BUNDLE, CAN_BUN_ARCHIVE,
/// CAN_TEST_CACHE; lowercase-hyphen requires form per the
/// M25 precedent; binds at P23).
/// Logical gates SUITE/BUILD/WORK/ENV bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is
/// the offline default bound (the Go 30-minute fill wait
/// plus 500ms poll are runtime waits pinned as checks, not
/// test timeouts; binds at P23 like the M11 rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/bundle-cache-roots checks: main-name,
/// suite-name, resolve-name, cached-name, root-name,
/// key-name, build-name, complete-name, wait-name,
/// reap-name, verify-name, cache-var, mutex-var, once-type,
/// open-call, path-field, key-dir-compiler,
/// key-dir-distribution, key-dir-runtime, key-dir-tools,
/// key-file-mod, key-file-sum, key-tag-archive, key-tag-go,
/// key-tag-version, version-value, manifest-file,
/// manifest-kind, schema-version, fill-prefix, dir-mode,
/// file-mode.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str main_name
    str suite_name
    str resolve_name
    str cached_name
    str root_name
    str key_name
    str build_name
    str complete_name
    str wait_name
    str reap_name
    str verify_name
    str cache_var
    str mutex_var
    str once_type
    str open_call
    str path_field
    str key_dir_compiler
    str key_dir_distribution
    str key_dir_runtime
    str key_dir_tools
    str key_file_mod
    str key_file_sum
    str key_tag_archive
    str key_tag_go
    str key_tag_version
    str version_value
    str manifest_file
    str manifest_kind
    int schema_version
    str fill_prefix
    str dir_mode
    str file_mode
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/bundle-cache-roots", "default", "", "offline"), "main-name" => ok "case history/bundle-cache-roots variant default root main-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/bundle-cache-roots", "default", "", "offline"), "main-name" => ok evidence("main-name", "true", "true", true, "case history/bundle-cache-roots variant default root main-name run offline")
        different: false, true, context("history/bundle-cache-roots", "default", "", "offline"), "main-name" => failed{"main-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/bundle-cache-roots", "default", "", "offline"), "schema-version" => ok evidence("schema-version", "1", "1", true, "case history/bundle-cache-roots variant default root schema-version run offline")
        different: 2, 1, context("history/bundle-cache-roots", "default", "", "offline"), "schema-version" => failed{"schema-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestMain", "TestMain", context("history/bundle-cache-roots", "default", "", "offline"), "main-name" => ok evidence("main-name", "TestMain", "TestMain", true, "case history/bundle-cache-roots variant default root main-name run offline")
        different: "TestMain_2", "TestMain", context("history/bundle-cache-roots", "default", "", "offline"), "main-name" => failed{"main-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
