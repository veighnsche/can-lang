package m29history039run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-039 "Bundle cache: run shape".
/// Source: tests/failure-conventions/harness_test.go
/// resolveBundle (L75-92), cachedBundle (L99-131),
/// TestMain/runSuite (L142-154), bundleKey derivation
/// (L169-216), buildBundleEntry (L218-242), entryComplete
/// (L244-250), waitForEntry (L252-264), reapStaleLock
/// (L266-274) and verifyBundle (L276-299).
/// Disposition: migrate (this row ports the TestMain
/// suite-owned bundle cache contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the live run shape: the bypass
/// plus skip legs, the cache-fill legs (join, mkdir-all,
/// mkdir lock, fill wait, fill refusal), the close plus
/// exit legs, the key derivation calls, the build plus
/// publish calls with the entry lock pair, the completion
/// plus wait guards, the poll interval, the stale reap
/// guard, and the manifest verify calls plus refusals.
/// ADAPTATION (recorded, with source lines): fill-wait pins
/// the 30 * time.Minute spelling with spaces as str
/// (L114); reap-guard pins the full comparison spelling
/// with tight 30*time.Minute (L271); close-diag pins the
/// Fprintf inner bytes without the trailing newline escape
/// (L149); lock-call plus unlock-call pin the call
/// spellings with parens (L229-230); guards pin the full
/// comparison spellings (L249/L253/L258/L271); poll-ms pins
/// int (500) from the After arg (L260).
/// Facet map (launch plus diagnostics): getenv-call pins
/// os.Getenv (L77); fatal-bypass pins the bypass refusal
/// (L79); skip-call pins t.Skip (L85); skip-diag pins the
/// skip wording (L85); fatal-create-cache pins the create
/// refusal (L104); join-call pins filepath.Join (L106);
/// mkdirall-call pins os.MkdirAll (L107); mkdir-call pins
/// os.Mkdir (L116); fill-wait pins 30 * time.Minute (L114);
/// fatal-fill-wait pins the fill refusal (L128); exit-call
/// pins os.Exit (L143); close-call pins Close (L148);
/// close-diag pins the close wording (L149); run-call pins
/// m.Run() (L153); walkdir-call pins filepath.WalkDir
/// (L173); hash-call pins distribution.Hash (L182);
/// sort-call pins sort.Strings (L207); version-call pins
/// runtime.Version() (L201); mktemp-call pins os.MkdirTemp
/// (L220); build-call pins distribution.Build (L225);
/// lock-call pins bundleMu.Lock() (L229); unlock-call pins
/// bundleMu.Unlock() (L230); rename-call pins os.Rename
/// (L232); writefile-call pins os.WriteFile (L235);
/// trim-guard pins strings.TrimSpace(string(raw)) == key
/// (L249); deadline-guard pins time.Now().Before(deadline)
/// (L253); done-guard pins <-ctx.Done() (L258); poll-ms
/// pins 500 (L260); reap-guard pins the stale comparison
/// (L271); unmarshal-call pins json.Unmarshal (L283);
/// fatal-manifest pins the manifest refusal (L287);
/// fromslash-call pins filepath.FromSlash (L290);
/// fatal-file pins the file refusal (L295).
/// The verdict pins live in history-039-cache-semantics.can;
/// the roots-green pin lives in history-039-roots-green.can.
/// Variants: none (row lists zero variants; one default
/// case per file).
/// Environment: requires conv-bundle, can-bun-archive,
/// can-test-cache (row gates CONV_BUNDLE, CAN_BUN_ARCHIVE,
/// CAN_TEST_CACHE; lowercase-hyphen requires form per the
/// M25 precedent; binds at P23).
/// Logical gates SUITE/BUILD/WORK/ENV bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is
/// the offline default bound (the Go 30-minute fill wait
/// plus 500ms poll are runtime waits pinned as checks, not
/// test timeouts; binds at P23 like the M11 rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/bundle-cache-run checks: getenv-call,
/// fatal-bypass, skip-call, skip-diag, fatal-create-cache,
/// join-call, mkdirall-call, mkdir-call, fill-wait,
/// fatal-fill-wait, exit-call, close-call, close-diag,
/// run-call, walkdir-call, hash-call, sort-call,
/// version-call, mktemp-call, build-call, lock-call,
/// unlock-call, rename-call, writefile-call, trim-guard,
/// deadline-guard, done-guard, poll-ms, reap-guard,
/// unmarshal-call, fatal-manifest, fromslash-call,
/// fatal-file.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str getenv_call
    str fatal_bypass
    str skip_call
    str skip_diag
    str fatal_create_cache
    str join_call
    str mkdirall_call
    str mkdir_call
    str fill_wait
    str fatal_fill_wait
    str exit_call
    str close_call
    str close_diag
    str run_call
    str walkdir_call
    str hash_call
    str sort_call
    str version_call
    str mktemp_call
    str build_call
    str lock_call
    str unlock_call
    str rename_call
    str writefile_call
    str trim_guard
    str deadline_guard
    str done_guard
    int poll_ms
    str reap_guard
    str unmarshal_call
    str fatal_manifest
    str fromslash_call
    str fatal_file
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/bundle-cache-run", "default", "", "offline"), "getenv-call" => ok "case history/bundle-cache-run variant default root getenv-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/bundle-cache-run", "default", "", "offline"), "getenv-call" => ok evidence("getenv-call", "true", "true", true, "case history/bundle-cache-run variant default root getenv-call run offline")
        different: false, true, context("history/bundle-cache-run", "default", "", "offline"), "getenv-call" => failed{"getenv-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 500, 500, context("history/bundle-cache-run", "default", "", "offline"), "poll-ms" => ok evidence("poll-ms", "500", "500", true, "case history/bundle-cache-run variant default root poll-ms run offline")
        different: 501, 500, context("history/bundle-cache-run", "default", "", "offline"), "poll-ms" => failed{"poll-ms"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "os.Getenv", "os.Getenv", context("history/bundle-cache-run", "default", "", "offline"), "getenv-call" => ok evidence("getenv-call", "os.Getenv", "os.Getenv", true, "case history/bundle-cache-run variant default root getenv-call run offline")
        different: "os.Getenv_2", "os.Getenv", context("history/bundle-cache-run", "default", "", "offline"), "getenv-call" => failed{"getenv-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("os.Getenv", "CONV_BUNDLE %s failed verification: %v", "t.Skip", "set CONV_BUNDLE or CAN_BUN_ARCHIVE for execution legs", "create suite bundle cache: %v", "filepath.Join", "os.MkdirAll", "os.Mkdir", "30 * time.Minute", "bundle cache fill wait: %v", "os.Exit", "Close", "remove suite bundle cache: %v", "m.Run()", "filepath.WalkDir", "distribution.Hash", "sort.Strings", "runtime.Version()", "os.MkdirTemp", "distribution.Build", "bundleMu.Lock()", "bundleMu.Unlock()", "os.Rename", "os.WriteFile", "strings.TrimSpace(string(raw)) == key", "time.Now().Before(deadline)", "<-ctx.Done()", 500, "time.Since(info.ModTime()) > 30*time.Minute", "json.Unmarshal", "unexpected bundle manifest in %s", "filepath.FromSlash", "cached bundle file %s failed verification")
