package m29history040cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-040 "Staging/assert-report helpers: verdict semantics".
/// Source: tests/failure-conventions/harness_test.go helpers
/// stageProject (L304), runAssert (L350), requireGreen (L386),
/// requireRealCan (L401), snapshotFiles (L461), replaceOnce
/// (L444), requireUnchanged (L490), dumpSurgery (L428) plus
/// rootID (L70).
/// Disposition: migrate (this row ports the staging plus
/// assert-report helper deal to ordinary Can functions; the
/// old Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the six helper legs in Go order:
/// stage a Can project, run candidate assertions, require a
/// valid green report, require real-Can evidence, snapshot
/// plus mutate sources, and compare helper-local surgery;
/// plus the zero status, one-hit mutation, root join mark,
/// six-leg count, and both report predicates.
/// ADAPTATION (recorded, with source lines): stage names pin
/// the Go helper spellings; run-argv pins the assert verb
/// (L353); run-binary pins the bin/canlc join (L352);
/// green-status pins int (0) from the Status guard (L388);
/// mutate-count pins int (1) from the Count guard (L451);
/// green-passed pins bool from the Passed guard (L388);
/// realcan-required pins bool from the evidence loop
/// (L404-410); root-id-sep pins the colon join mark (L71);
/// variant-count pins int (6) from the six helper legs
/// (stage/run/green/realcan/snapshot/surgery).
/// Facet map (helper verdict legs): stage-helper pins
/// stageProject (L304); stage-copy pins copyTree (L310);
/// stage-eval pins filepath.EvalSymlinks (L306); run-helper
/// pins runAssert (L350); run-argv pins assert (L353);
/// run-binary pins bin/canlc (L352); green-helper pins
/// requireGreen (L386); realcan-helper pins requireRealCan
/// (L401); realcan-tag pins real-can (L406);
/// snapshot-helper pins snapshotFiles (L461); mutate-helper
/// pins replaceOnce (L444); unchanged-helper pins
/// requireUnchanged (L490); surgery-helper pins dumpSurgery
/// (L428); surgery-skip pins dist (L439); root-id-sep pins
/// : (L71); green-status pins 0 (L388); mutate-count pins 1
/// (L451); green-passed pins true (L388); realcan-required
/// pins true (L404-410); variant-count pins 6 (six legs).
/// The roots-green pin lives in history-040-roots-green.can;
/// the run shape plus diagnostics live in
/// history-040-run-shape.can.
/// Variants: stage/run/green/realcan/snapshot/surgery (all
/// in Go order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/harness-semantics checks: stage-helper,
/// stage-copy, stage-eval, run-helper, run-argv, run-binary,
/// green-helper, realcan-helper, realcan-tag,
/// snapshot-helper, mutate-helper, unchanged-helper,
/// surgery-helper, surgery-skip, root-id-sep, green-status,
/// mutate-count, green-passed, realcan-required,
/// variant-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str stage_helper
    str stage_copy
    str stage_eval
    str run_helper
    str run_argv
    str run_binary
    str green_helper
    str realcan_helper
    str realcan_tag
    str snapshot_helper
    str mutate_helper
    str unchanged_helper
    str surgery_helper
    str surgery_skip
    str root_id_sep
    int green_status
    int mutate_count
    bool green_passed
    bool realcan_required
    int variant_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/harness-semantics", "default", "", "offline"), "stage-helper" => ok "case history/harness-semantics variant default root stage-helper run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/harness-semantics", "default", "", "offline"), "green-passed" => ok evidence("green-passed", "true", "true", true, "case history/harness-semantics variant default root green-passed run offline")
        different: false, true, context("history/harness-semantics", "default", "", "offline"), "green-passed" => failed{"green-passed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/harness-semantics", "default", "", "offline"), "green-status" => ok evidence("green-status", "0", "0", true, "case history/harness-semantics variant default root green-status run offline")
        different: 1, 0, context("history/harness-semantics", "default", "", "offline"), "green-status" => failed{"green-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "stageProject", "stageProject", context("history/harness-semantics", "default", "", "offline"), "stage-helper" => ok evidence("stage-helper", "stageProject", "stageProject", true, "case history/harness-semantics variant default root stage-helper run offline")
        different: "stageProject_2", "stageProject", context("history/harness-semantics", "default", "", "offline"), "stage-helper" => failed{"stage-helper"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
