package m29history040roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-040 "Staging/assert-report helpers: roots green".
/// Source: tests/failure-conventions/harness_test.go shapes
/// assertReport (L35-39), assertEntry (L42-58), assertOutcome
/// (L63-68) plus env names (L77/L83/L159/L430) and the
/// manifest guard (L286).
/// Disposition: migrate (this row ports the staging plus
/// assert-report helper deal to ordinary Can functions; the
/// old Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the static helper baseline as the
/// green root: the report, entry and outcome type names,
/// all JSON keys of the report plus entry plus root plus
/// frame shapes, the four env names, the manifest schema
/// version, and the nonempty files demand.
/// ADAPTATION (recorded, with source lines): JSON keys pin
/// the Go tag inner spellings (L36-57); schema-version pins
/// int (1) from the SchemaVersion guard (L286);
/// manifest-files pins bool from the len(Files) guard
/// (L286); passed-key pins the tag shared by report (L36)
/// and entry (L48).
/// Facet map (static baseline): report-type pins
/// assertReport (L35); entry-type pins assertEntry (L42);
/// outcome-type pins assertOutcome (L63); passed-key pins
/// passed (L36/L48); complete-key pins complete (L37);
/// assertions-key pins assertions (L38); root-key pins root
/// (L47); package-key pins package (L44); declaration-key
/// pins declaration (L45); name-key pins name (L46);
/// reason-key pins reason (L49); violations-key pins
/// violations (L50); evidence-key pins evidence (L51);
/// frames-key pins frames (L57); file-key pins file (L53);
/// line-key pins line (L54); column-key pins column (L55);
/// operation-key pins operation (L56); conv-bundle-env pins
/// CONV_BUNDLE (L77); bun-archive-env pins CAN_BUN_ARCHIVE
/// (L83); test-cache-env pins CAN_TEST_CACHE (L159);
/// dump-env pins CONV_DUMP_SURGERY (L430); schema-version
/// pins 1 (L286); manifest-files pins true (L286).
/// The verdict pins live in history-040-cache-semantics.can;
/// the run shape plus diagnostics live in
/// history-040-run-shape.can.
/// Variants: stage/run/green/realcan/snapshot/surgery (all
/// in Go order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/harness-roots checks: report-type,
/// entry-type, outcome-type, passed-key, complete-key,
/// assertions-key, root-key, package-key, declaration-key,
/// name-key, reason-key, violations-key, evidence-key,
/// frames-key, file-key, line-key, column-key,
/// operation-key, conv-bundle-env, bun-archive-env,
/// test-cache-env, dump-env, schema-version,
/// manifest-files.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str report_type
    str entry_type
    str outcome_type
    str passed_key
    str complete_key
    str assertions_key
    str root_key
    str package_key
    str declaration_key
    str name_key
    str reason_key
    str violations_key
    str evidence_key
    str frames_key
    str file_key
    str line_key
    str column_key
    str operation_key
    str conv_bundle_env
    str bun_archive_env
    str test_cache_env
    str dump_env
    int schema_version
    bool manifest_files
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/harness-roots", "default", "", "offline"), "report-type" => ok "case history/harness-roots variant default root report-type run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/harness-roots", "default", "", "offline"), "manifest-files" => ok evidence("manifest-files", "true", "true", true, "case history/harness-roots variant default root manifest-files run offline")
        different: false, true, context("history/harness-roots", "default", "", "offline"), "manifest-files" => failed{"manifest-files"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/harness-roots", "default", "", "offline"), "schema-version" => ok evidence("schema-version", "1", "1", true, "case history/harness-roots variant default root schema-version run offline")
        different: 2, 1, context("history/harness-roots", "default", "", "offline"), "schema-version" => failed{"schema-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "assertReport", "assertReport", context("history/harness-roots", "default", "", "offline"), "report-type" => ok evidence("report-type", "assertReport", "assertReport", true, "case history/harness-roots variant default root report-type run offline")
        different: "assertReport_2", "assertReport", context("history/harness-roots", "default", "", "offline"), "report-type" => failed{"report-type"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
