package m29history040run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-040 "Staging/assert-report helpers: run shape".
/// Source: tests/failure-conventions/harness_test.go run
/// legs: bundle refusal plus skip (L79/L85); cache refusal
/// plus fill refusal (L104/L128); remove refusal (L149);
/// manifest refusals (L287/L295); assert plus root refusals
/// (L389/L393); no-real-can refusal (L411); replace plus
/// changed refusals (L452/L494); sandbox run (L356-364);
/// snapshot skip (L472); bundle keys (L200-202); modes
/// (L107/L235/L332/L342); waits (L114/L260/L271).
/// Disposition: migrate (this row ports the staging plus
/// assert-report helper deal to ordinary Can functions; the
/// old Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the live run shape: the twelve
/// refusal wordings in Go order, the mac sandbox call plus
/// profile, the sealed run env, the dist skip prefix, the
/// bundle prefix plus key slots plus shared tag plus distro
/// kind, the four copy/cache modes, the darwin gate plus
/// decode guard, and the fill wait plus bundle window.
/// ADAPTATION (recorded, with source lines): fatal pins
/// hold the Go format inner bytes; fatal-cache-remove drops
/// the Fprintf newline escape (L149); modes pin the octal
/// digit spellings structurally as str (L107/L235/L332/L342);
/// wait-ms pins int (500) from the poll pause (L260);
/// bundle-minutes pins int (30) from both window spellings
/// (L114 spaced, L271 tight); assert-guard pins the full
/// comparison spelling (L379).
/// Facet map (launch plus diagnostics): fatal-bundle-verify
/// pins the bundle refusal (L79); skip-no-bundle pins the
/// no-bundle skip (L85); fatal-bundle-cache pins the cache
/// refusal (L104); fatal-bundle-fill pins the fill refusal
/// (L128); fatal-cache-remove pins the remove refusal
/// (L149); fatal-manifest pins the manifest refusal (L287);
/// fatal-file-verify pins the file refusal (L295);
/// fatal-assert pins the assert refusal (L389); fatal-root
/// pins the root refusal (L393); fatal-no-realcan pins the
/// no-real-can refusal (L411); fatal-replace pins the
/// replace refusal (L452); fatal-changed pins the changed
/// refusal (L494); sandbox-call pins /usr/bin/sandbox-exec
/// (L358); sandbox-flag pins -p (L357); sandbox-profile pins
/// the offline profile (L357); path-env pins
/// PATH=/nonexistent (L364); home-prefix pins HOME= (L364);
/// dist-prefix pins dist/ (L472); bundle-prefix pins
/// bundle- (L106); archive-key pins @archive (L200); go-key
/// pins @go (L201); version-key pins @version (L202);
/// version-tag pins harness-shared (L202); kind-tag pins
/// can.development-distribution (L286); stage-dir-mode pins
/// 0700 (L332); stage-file-mode pins 0600 (L342);
/// cache-file-mode pins 0644 (L235); entry-dir-mode pins
/// 0755 (L107); darwin-guard pins darwin (L356);
/// assert-guard pins len(report.Assertions) > 0 (L379);
/// wait-ms pins 500 (L260); bundle-minutes pins 30
/// (L114/L271).
/// The verdict pins live in history-040-cache-semantics.can;
/// the roots-green pin lives in history-040-roots-green.can.
/// Variants: stage/run/green/realcan/snapshot/surgery (all
/// in Go order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/harness-run checks: fatal-bundle-verify,
/// skip-no-bundle, fatal-bundle-cache, fatal-bundle-fill,
/// fatal-cache-remove, fatal-manifest, fatal-file-verify,
/// fatal-assert, fatal-root, fatal-no-realcan,
/// fatal-replace, fatal-changed, sandbox-call,
/// sandbox-flag, sandbox-profile, path-env, home-prefix,
/// dist-prefix, bundle-prefix, archive-key, go-key,
/// version-key, version-tag, kind-tag, stage-dir-mode,
/// stage-file-mode, cache-file-mode, entry-dir-mode,
/// darwin-guard, assert-guard, wait-ms, bundle-minutes.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str fatal_bundle_verify
    str skip_no_bundle
    str fatal_bundle_cache
    str fatal_bundle_fill
    str fatal_cache_remove
    str fatal_manifest
    str fatal_file_verify
    str fatal_assert
    str fatal_root
    str fatal_no_realcan
    str fatal_replace
    str fatal_changed
    str sandbox_call
    str sandbox_flag
    str sandbox_profile
    str path_env
    str home_prefix
    str dist_prefix
    str bundle_prefix
    str archive_key
    str go_key
    str version_key
    str version_tag
    str kind_tag
    str stage_dir_mode
    str stage_file_mode
    str cache_file_mode
    str entry_dir_mode
    str darwin_guard
    str assert_guard
    int wait_ms
    int bundle_minutes
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/harness-run", "default", "", "offline"), "fatal-bundle-verify" => ok "case history/harness-run variant default root fatal-bundle-verify run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/harness-run", "default", "", "offline"), "fatal-bundle-verify" => ok evidence("fatal-bundle-verify", "true", "true", true, "case history/harness-run variant default root fatal-bundle-verify run offline")
        different: false, true, context("history/harness-run", "default", "", "offline"), "fatal-bundle-verify" => failed{"fatal-bundle-verify"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 500, 500, context("history/harness-run", "default", "", "offline"), "wait-ms" => ok evidence("wait-ms", "500", "500", true, "case history/harness-run variant default root wait-ms run offline")
        different: 499, 500, context("history/harness-run", "default", "", "offline"), "wait-ms" => failed{"wait-ms"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CONV_BUNDLE %s failed verification: %v", "CONV_BUNDLE %s failed verification: %v", context("history/harness-run", "default", "", "offline"), "fatal-bundle-verify" => ok evidence("fatal-bundle-verify", "CONV_BUNDLE %s failed verification: %v", "CONV_BUNDLE %s failed verification: %v", true, "case history/harness-run variant default root fatal-bundle-verify run offline")
        different: "CONV_BUNDLE %s failed verification: %v_2", "CONV_BUNDLE %s failed verification: %v", context("history/harness-run", "default", "", "offline"), "fatal-bundle-verify" => failed{"fatal-bundle-verify"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
