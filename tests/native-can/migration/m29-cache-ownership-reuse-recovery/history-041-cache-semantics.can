package m29history041cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-041 "Cache impl: verdict semantics".
/// Source: tests/support/tempcache/cache.go Open (L47-96)
/// plus Close (L100-123) plus parent doc (L44-46) plus
/// close doc (L98-99).
/// Disposition: migrate (this row ports the per-run owned
/// cache deal to ordinary Can functions; the old Go harness
/// stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the eleven Open legs in Go order
/// (TempDir default, Abs, MkdirAll, EvalSymlinks, sweep,
/// mint, Lstat, lease create, Flock hold, Marshal, marker
/// write); the parent-kept plus owned-marked guards; the
/// failed-open close; the nil plus gone plus replaced plus
/// remove plus clear plus join close legs; the replaced
/// refusal wording; plus the ten-exit count.
/// ADAPTATION (recorded, with source lines): leg verdicts
/// pin bools from the run guards (L48-49/L51/L55/L58/L62/
/// L65/L70/L80/L84/L87/L91); parent-kept pins bool from
/// the caller-owned doc (L44-46); owned-marked pins bool
/// from the candidate doc (L45-46); failed-guards-close
/// pins bool from the failed flag (L74-79); nil-close-ok
/// pins bool from the nil guard (L101-103); gone-kept pins
/// bool from the IsNotExist guard (L107-108);
/// close-replaced-diag pins the Errorf inner bytes (L112);
/// close-removes pins bool from RemoveAll (L114);
/// close-clears-path pins bool from the clear (L116);
/// close-joins-lease pins bool from errors.Join (L119);
/// open-err-sites pins int (10) from the nil-err exits
/// (L53/L56/L60/L63/L67/L72/L82/L85/L89/L92).
/// Facet map (allocation plus close): open-func pins Open
/// (L47); parent-param pins parent (L47); cache-type pins
/// Cache (L38); owner-type pins owner (L32); abandoned-type
/// pins abandoned (L125); tempdir-defaults pins true
/// (L48-49); abs-resolves pins true (L51); mkdir-ensures
/// pins true (L55); eval-resolves pins true (L58);
/// sweep-runs pins true (L62); mint-creates pins true
/// (L65); lstat-records pins true (L70); lease-creates pins
/// true (L80); flock-holds pins true (L84); marshal-writes
/// pins true (L87); marker-writes pins true (L91);
/// parent-kept pins true (L44-46); owned-marked pins true
/// (L45-46); failed-guards-close pins true (L74-79);
/// nil-close-ok pins true (L101-103); gone-kept pins true
/// (L107-108); close-replaced-diag pins the replaced
/// wording (L112); close-removes pins true (L114);
/// close-clears-path pins true (L116); close-joins-lease
/// pins true (L119); open-err-sites pins 10 (ten exits).
/// The roots-green pin lives in history-041-roots-green.can;
/// the run shape plus diagnostics live in
/// history-041-run-shape.can.
/// Variants: none (row lists zero variants; one default
/// case per file).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-impl-semantics checks: open-func,
/// parent-param, cache-type, owner-type, abandoned-type,
/// tempdir-defaults, abs-resolves, mkdir-ensures,
/// eval-resolves, sweep-runs, mint-creates, lstat-records,
/// lease-creates, flock-holds, marshal-writes,
/// marker-writes, parent-kept, owned-marked,
/// failed-guards-close, nil-close-ok, gone-kept,
/// close-replaced-diag, close-removes, close-clears-path,
/// close-joins-lease, open-err-sites.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str open_func
    str parent_param
    str cache_type
    str owner_type
    str abandoned_type
    bool tempdir_defaults
    bool abs_resolves
    bool mkdir_ensures
    bool eval_resolves
    bool sweep_runs
    bool mint_creates
    bool lstat_records
    bool lease_creates
    bool flock_holds
    bool marshal_writes
    bool marker_writes
    bool parent_kept
    bool owned_marked
    bool failed_guards_close
    bool nil_close_ok
    bool gone_kept
    str close_replaced_diag
    bool close_removes
    bool close_clears_path
    bool close_joins_lease
    int open_err_sites
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-impl-semantics", "default", "", "offline"), "open-func" => ok "case history/cache-impl-semantics variant default root open-func run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-impl-semantics", "default", "", "offline"), "tempdir-defaults" => ok evidence("tempdir-defaults", "true", "true", true, "case history/cache-impl-semantics variant default root tempdir-defaults run offline")
        different: false, true, context("history/cache-impl-semantics", "default", "", "offline"), "tempdir-defaults" => failed{"tempdir-defaults"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("history/cache-impl-semantics", "default", "", "offline"), "open-err-sites" => ok evidence("open-err-sites", "10", "10", true, "case history/cache-impl-semantics variant default root open-err-sites run offline")
        different: 9, 10, context("history/cache-impl-semantics", "default", "", "offline"), "open-err-sites" => failed{"open-err-sites"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "Open", "Open", context("history/cache-impl-semantics", "default", "", "offline"), "open-func" => ok evidence("open-func", "Open", "Open", true, "case history/cache-impl-semantics variant default root open-func run offline")
        different: "Open_2", "Open", context("history/cache-impl-semantics", "default", "", "offline"), "open-func" => failed{"open-func"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
