package m29history041roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-041 "Cache impl: roots green".
/// Source: tests/support/tempcache/cache.go consts (L21-30)
/// plus owner shape (L32-36) plus Cache shape (L38-42)
/// plus abandoned shape (L125-130) plus mkdir mode (L55)
/// plus file modes (L80/L91) plus size bound (L245) plus
/// liveness caps (L186/L211) plus guard flags
/// (L239/L261/L111).
/// Disposition: migrate (this row ports the per-run owned
/// cache deal to ordinary Can functions; the old Go harness
/// stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static impl baseline as the
/// green root: the cache prefix, marker and lease names,
/// the owner schema tag, the hour wait plus sixteen-entry
/// scan bound, the owner JSON keys plus Go field names, the
/// Cache plus abandoned field names, the mkdir plus file
/// modes, the marker size bound, the liveness output cap
/// plus wait, and the no-follow plus symlink flags.
/// ADAPTATION (recorded, with source lines): recovery-age
/// pins the time.Hour spelling as str (no int literal at
/// cache.go L29); modes pin the 0755 plus 0600 spellings
/// structurally as str (L55/L80/L91); output-limit pins the
/// 8<<20 spelling as str (L211); live-timeout pins the
/// 5*time.Second spelling as str (L186); marker-size-bound
/// pins int (4096) from the Size guard (L245);
/// recovery-limit pins int (16) from the const (L30).
/// Facet map (static baseline): prefix pins can-suite-cache-
/// (L21); marker-name pins .can-test-owner.json (L22);
/// lease-name pins .can-test-lease (L23); schema pins
/// can.test-suite-cache/1 (L24); recovery-age pins time.Hour
/// (L29); recovery-limit pins 16 (L30); owner-schema-key
/// pins schema (L33); owner-name-key pins name (L34);
/// owner-pid-key pins pid (L35); owner-schema-field pins
/// Schema (L33); owner-name-field pins Name (L34);
/// owner-pid-field pins PID (L35); cache-path-field pins
/// Path (L39); cache-lease-field pins lease (L40);
/// cache-info-field pins info (L41); abandoned-path-field
/// pins path (L126); abandoned-info-field pins info (L127);
/// abandoned-lease-field pins lease (L128);
/// abandoned-root-field pins root (L129); mkdir-mode pins
/// 0755 (L55); marker-mode pins 0600 (L91); lease-mode pins
/// 0600 (L80); marker-size-bound pins 4096 (L245);
/// output-limit pins 8<<20 (L211); live-timeout pins
/// 5*time.Second (L186); nofollow-flag pins
/// syscall.O_NOFOLLOW (L239/L261); symlink-flag pins
/// os.ModeSymlink (L111).
/// The verdict pins live in history-041-cache-semantics.can;
/// the run shape plus diagnostics live in
/// history-041-run-shape.can.
/// Variants: none (row lists zero variants; one default
/// case per file).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-impl-roots checks: prefix,
/// marker-name, lease-name, schema, recovery-age,
/// recovery-limit, owner-schema-key, owner-name-key,
/// owner-pid-key, owner-schema-field, owner-name-field,
/// owner-pid-field, cache-path-field, cache-lease-field,
/// cache-info-field, abandoned-path-field,
/// abandoned-info-field, abandoned-lease-field,
/// abandoned-root-field, mkdir-mode, marker-mode,
/// lease-mode, marker-size-bound, output-limit,
/// live-timeout, nofollow-flag, symlink-flag.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str prefix
    str marker_name
    str lease_name
    str schema
    str recovery_age
    int recovery_limit
    str owner_schema_key
    str owner_name_key
    str owner_pid_key
    str owner_schema_field
    str owner_name_field
    str owner_pid_field
    str cache_path_field
    str cache_lease_field
    str cache_info_field
    str abandoned_path_field
    str abandoned_info_field
    str abandoned_lease_field
    str abandoned_root_field
    str mkdir_mode
    str marker_mode
    str lease_mode
    int marker_size_bound
    str output_limit
    str live_timeout
    str nofollow_flag
    str symlink_flag
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-impl-roots", "default", "", "offline"), "prefix" => ok "case history/cache-impl-roots variant default root prefix run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-impl-roots", "default", "", "offline"), "prefix" => ok evidence("prefix", "true", "true", true, "case history/cache-impl-roots variant default root prefix run offline")
        different: false, true, context("history/cache-impl-roots", "default", "", "offline"), "prefix" => failed{"prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 16, 16, context("history/cache-impl-roots", "default", "", "offline"), "recovery-limit" => ok evidence("recovery-limit", "16", "16", true, "case history/cache-impl-roots variant default root recovery-limit run offline")
        different: 15, 16, context("history/cache-impl-roots", "default", "", "offline"), "recovery-limit" => failed{"recovery-limit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "can-suite-cache-", "can-suite-cache-", context("history/cache-impl-roots", "default", "", "offline"), "prefix" => ok evidence("prefix", "can-suite-cache-", "can-suite-cache-", true, "case history/cache-impl-roots variant default root prefix run offline")
        different: "can-suite-cache-_2", "can-suite-cache-", context("history/cache-impl-roots", "default", "", "offline"), "prefix" => failed{"prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
