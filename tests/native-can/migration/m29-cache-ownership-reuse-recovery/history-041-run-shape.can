package m29history041run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 HISTORY-041 "Cache impl: run shape".
/// Source: tests/support/tempcache/cache.go Open shapes
/// (L55/L65/L80/L84) plus recoverAbandoned (L132-178) plus
/// noReferences (L184-203) plus limitedOutput (L205-216)
/// plus recoverOne (L218-283).
/// Disposition: migrate (this row ports the per-run owned
/// cache deal to ordinary Can functions; the old Go harness
/// stays until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the mkdir plus
/// mint shapes, the lease create flags plus lock modes plus
/// held fd, the Join call, the ReadDir plus prefix plus
/// bound plus single plus empty plus gate sweep legs, the
/// skip head plus tail, the ps plus lsof argv shapes, both
/// liveness refusal wordings plus the overflow wording, the
/// Contains plus Itoa shapes, the OpenRoot plus marker plus
/// lease open flags, the size plus schema plus name plus pid
/// plus eof marker guards, the dead-owner gate, the lease
/// probe guard, the age guard, and the zero root perm.
/// ADAPTATION (recorded, with source lines): skip-head pins
/// the static wording before the dynamic count and skip-tail
/// pins the static wording after it (L165), since one pin
/// cannot hold the dynamic count (H036 precedent); ps-argv
/// pins the inner argv bytes with quotes (L185); lsof-argv
/// pins the inner argv bytes with quotes plus the uid shape
/// (L185); root-perm pins int (0) from the OpenRoot perm
/// args (L239/L261); guards pin the full comparison
/// spellings (L149/L157/L245/L251/L254/L258/L274/L220).
/// Facet map (launch plus diagnostics): mkdir-call pins
/// os.MkdirAll(parent, 0755) (L55); mint-call pins
/// os.MkdirTemp(parent, prefix) (L65); lease-create-flags
/// pins os.O_CREATE|os.O_EXCL|os.O_RDWR (L80); flock-modes
/// pins syscall.LOCK_EX|syscall.LOCK_NB (L84); flock-fd pins
/// int(c.lease.Fd()) (L84); join-call pins filepath.Join
/// (L80); readdir-call pins os.ReadDir(parent) (L133);
/// prefix-check pins strings.HasPrefix(entry.Name(), prefix)
/// (L146); bound-guard pins inspected == recoveryLimit
/// (L149); recover-one-call pins
/// recoverOne(filepath.Join(parent, entry.Name()), now)
/// (L153); empty-guard pins len(candidates) == 0 (L157);
/// check-call pins check(paths) (L164); skip-head pins the
/// report head (L165); skip-tail pins the report tail
/// (L165); ps-argv pins the ps argv (L185); lsof-argv pins
/// the lsof argv (L185); unavailable-format pins the
/// unavailability wording (L194); active-format pins the
/// active wording (L198); output-exceeds-diag pins the
/// overflow wording (L213); contains-call pins
/// strings.Contains (L197); itoa-shape pins
/// strconv.Itoa(os.Getuid()) (L185); openroot-call pins
/// os.OpenRoot(path) (L229); marker-open-flags pins
/// os.O_RDONLY|syscall.O_NOFOLLOW (L239); lease-open-flags
/// pins os.O_RDWR|syscall.O_NOFOLLOW (L261); size-guard pins
/// markerInfo.Size() > 4096 (L245); schema-guard pins
/// owned.Schema != schema (L251); name-guard pins
/// owned.Name != filepath.Base(path) (L251); pid-guard pins
/// owned.PID <= 0 (L251); eof-guard pins
/// decoder.Decode(new(any)) != io.EOF (L254); dead-gate pins
/// errors.Is(syscall.Kill(owned.PID, 0), syscall.ESRCH)
/// (L258); flock-probe pins the probe guard (L274);
/// age-guard pins now.Sub(info.ModTime()) < recoveryAge
/// (L220); root-perm pins 0 (L239/L261).
/// The verdict pins live in history-041-cache-semantics.can;
/// the roots-green pin lives in history-041-roots-green.can.
/// Variants: none (row lists zero variants; one default
/// case per file).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/cache-impl-run checks: mkdir-call,
/// mint-call, lease-create-flags, flock-modes, flock-fd,
/// join-call, readdir-call, prefix-check, bound-guard,
/// recover-one-call, empty-guard, check-call, skip-head,
/// skip-tail, ps-argv, lsof-argv, unavailable-format,
/// active-format, output-exceeds-diag, contains-call,
/// itoa-shape, openroot-call, marker-open-flags,
/// lease-open-flags, size-guard, schema-guard, name-guard,
/// pid-guard, eof-guard, dead-gate, flock-probe, age-guard,
/// root-perm.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str mkdir_call
    str mint_call
    str lease_create_flags
    str flock_modes
    str flock_fd
    str join_call
    str readdir_call
    str prefix_check
    str bound_guard
    str recover_one_call
    str empty_guard
    str check_call
    str skip_head
    str skip_tail
    str ps_argv
    str lsof_argv
    str unavailable_format
    str active_format
    str output_exceeds_diag
    str contains_call
    str itoa_shape
    str openroot_call
    str marker_open_flags
    str lease_open_flags
    str size_guard
    str schema_guard
    str name_guard
    str pid_guard
    str eof_guard
    str dead_gate
    str flock_probe
    str age_guard
    int root_perm
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/cache-impl-run", "default", "", "offline"), "mkdir-call" => ok "case history/cache-impl-run variant default root mkdir-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/cache-impl-run", "default", "", "offline"), "mkdir-call" => ok evidence("mkdir-call", "true", "true", true, "case history/cache-impl-run variant default root mkdir-call run offline")
        different: false, true, context("history/cache-impl-run", "default", "", "offline"), "mkdir-call" => failed{"mkdir-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/cache-impl-run", "default", "", "offline"), "root-perm" => ok evidence("root-perm", "0", "0", true, "case history/cache-impl-run variant default root root-perm run offline")
        different: 1, 0, context("history/cache-impl-run", "default", "", "offline"), "root-perm" => failed{"root-perm"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "os.MkdirAll(parent, 0755)", "os.MkdirAll(parent, 0755)", context("history/cache-impl-run", "default", "", "offline"), "mkdir-call" => ok evidence("mkdir-call", "os.MkdirAll(parent, 0755)", "os.MkdirAll(parent, 0755)", true, "case history/cache-impl-run variant default root mkdir-call run offline")
        different: "os.MkdirAll(parent, 0755)_2", "os.MkdirAll(parent, 0755)", context("history/cache-impl-run", "default", "", "offline"), "mkdir-call" => failed{"mkdir-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("os.MkdirAll(parent, 0755)", "os.MkdirTemp(parent, prefix)", "os.O_CREATE|os.O_EXCL|os.O_RDWR", "syscall.LOCK_EX|syscall.LOCK_NB", "int(c.lease.Fd())", "filepath.Join", "os.ReadDir(parent)", "strings.HasPrefix(entry.Name(), prefix)", "inspected == recoveryLimit", "recoverOne(filepath.Join(parent, entry.Name()), now)", "len(candidates) == 0", "check(paths)", "suite cache recovery skipped (", " candidates): %v", "\"ps\", \"-axo\", \"command=\"", "\"lsof\", \"-n\", \"-P\", \"-u\", strconv.Itoa(os.Getuid()), \"-Fpn\"", "%s liveness unavailable or incomplete", "%s reports an active reference", "liveness output exceeds limit", "strings.Contains", "strconv.Itoa(os.Getuid())", "os.OpenRoot(path)", "os.O_RDONLY|syscall.O_NOFOLLOW", "os.O_RDWR|syscall.O_NOFOLLOW", "markerInfo.Size() > 4096", "owned.Schema != schema", "owned.Name != filepath.Base(path)", "owned.PID <= 0", "decoder.Decode(new(any)) != io.EOF", "errors.Is(syscall.Kill(owned.PID, 0), syscall.ESRCH)", "syscall.Flock(int(lease.Fd()), syscall.LOCK_EX|syscall.LOCK_NB) != nil", "now.Sub(info.ModTime()) < recoveryAge", 0)
