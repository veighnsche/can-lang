    match scope is "m29-l016"
        false => ok []
        true => ok [check("source-root-name", "source leg keeps its Go name"), check("archive-name", "archive leg keeps its Go name"), check("first-name", "first derivation keeps its Go name"), check("second-name", "second derivation keeps its Go name"), check("helper-name", "key helper is named harnessKey"), check("derivation-count", "two derivations run in order"), check("bundle-input-count", "four bundle input slots are pinned"), check("guard-leg-count", "stability gate has two legs"), check("refusal-count", "one refusal guards the gate"), check("inputs-identical", "both derivations share inputs"), check("keys-equal", "repeated keys compare equal"), check("key-nonempty", "derived key is nonempty"), check("abs-ok", "root lookup succeeds"), check("write-ok", "archive seed write succeeds"), check("refusal-fired", "refusal stays silent on stable keys")]
