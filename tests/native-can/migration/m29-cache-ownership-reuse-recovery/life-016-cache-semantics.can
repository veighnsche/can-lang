package m29life016cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-016 "Key stable: cache semantics".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessKeyStable (L16-31).
/// Disposition: migrate (this row ports
/// TestHarnessKeyStable to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the stability verdicts in Go order:
/// the source and archive leg names, the first and second
/// derivation names, the helper name, the derivation and input
/// and guard and refusal counts, plus the identical-inputs,
/// keys-equal, key-nonempty, abs-ok, write-ok and refusal-fired
/// verdicts.
/// ADAPTATION (recorded, with source lines): leg names pin
/// the Go local spellings (sourceRoot L18, archive L22, first
/// L26, second L27, harnessKey L26); derivation-count pins int
/// (2) from the two harnessKey calls (L26-27);
/// bundle-input-count pins int (4) from two derivations times
/// two bundle inputs (sourceRoot plus archive per call, L26-27;
/// t is the test handle, not a bundle input); guard-leg-count
/// pins int (2) from the empty plus stability legs (L28);
/// refusal-count pins int (1) from the single Fatalf site (L29);
/// verdicts pin bools from the identical call args (L26-27) and
/// the passing guards (L19, L23, L28); refusal-fired pins false
/// since the stable path never reaches the Fatalf (L29).
/// Facet map (Go verdict legs): source-root-name pins sourceRoot
/// (L18); archive-name pins archive (L22); first-name pins first
/// (L26); second-name pins second (L27); helper-name pins
/// harnessKey (L26); derivation-count pins 2 (L26-27);
/// bundle-input-count pins 4 (L26-27); guard-leg-count pins 2
/// (L28); refusal-count pins 1 (L29); inputs-identical pins true
/// (L26-27); keys-equal pins true (L28); key-nonempty pins true
/// (L28); abs-ok pins true (L19); write-ok pins true (L23);
/// refusal-fired pins false (L29).
/// The roots-green pin lives in life-016-roots-green.can;
/// the run shape plus diagnostics live in
/// life-016-run-shape.can.
/// Variants: first/second (the two repeated derivations in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/cache-semantics checks: source-root-name,
/// archive-name, first-name, second-name, helper-name,
/// derivation-count, bundle-input-count, guard-leg-count,
/// refusal-count, inputs-identical, keys-equal, key-nonempty,
/// abs-ok, write-ok, refusal-fired.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str source_root_name
    str archive_name
    str first_name
    str second_name
    str helper_name
    int derivation_count
    int bundle_input_count
    int guard_leg_count
    int refusal_count
    bool inputs_identical
    bool keys_equal
    bool key_nonempty
    bool abs_ok
    bool write_ok
    bool refusal_fired
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/cache-semantics", "default", "", "offline"), "source-root-name" => ok "case life/cache-semantics variant default root source-root-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/cache-semantics", "default", "", "offline"), "inputs-identical" => ok evidence("inputs-identical", "true", "true", true, "case life/cache-semantics variant default root inputs-identical run offline")
        different: false, true, context("life/cache-semantics", "default", "", "offline"), "inputs-identical" => failed{"inputs-identical"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/cache-semantics", "default", "", "offline"), "derivation-count" => ok evidence("derivation-count", "2", "2", true, "case life/cache-semantics variant default root derivation-count run offline")
        different: 1, 2, context("life/cache-semantics", "default", "", "offline"), "derivation-count" => failed{"derivation-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "sourceRoot", "sourceRoot", context("life/cache-semantics", "default", "", "offline"), "source-root-name" => ok evidence("source-root-name", "sourceRoot", "sourceRoot", true, "case life/cache-semantics variant default root source-root-name run offline")
        different: "sourceRoot_2", "sourceRoot", context("life/cache-semantics", "default", "", "offline"), "source-root-name" => failed{"source-root-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
