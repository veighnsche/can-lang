    asserts
        expected: context("life/cache-semantics", "default", "", "offline") => ok
        seed_source_root_name: context("life/cache-semantics", "seed-source-root-name-drift", "", "offline") => failed{"source-root-name"}
        seed_archive_name: context("life/cache-semantics", "seed-archive-name-drift", "", "offline") => failed{"archive-name"}
        seed_first_name: context("life/cache-semantics", "seed-first-name-drift", "", "offline") => failed{"first-name"}
        seed_second_name: context("life/cache-semantics", "seed-second-name-drift", "", "offline") => failed{"second-name"}
        seed_helper_name: context("life/cache-semantics", "seed-helper-name-drift", "", "offline") => failed{"helper-name"}
        seed_derivation_count: context("life/cache-semantics", "seed-derivation-count-drift", "", "offline") => failed{"derivation-count"}
        seed_bundle_input_count: context("life/cache-semantics", "seed-bundle-input-count-drift", "", "offline") => failed{"bundle-input-count"}
        seed_guard_leg_count: context("life/cache-semantics", "seed-guard-leg-count-drift", "", "offline") => failed{"guard-leg-count"}
        seed_refusal_count: context("life/cache-semantics", "seed-refusal-count-drift", "", "offline") => failed{"refusal-count"}
        seed_inputs_identical: context("life/cache-semantics", "seed-inputs-identical-drift", "", "offline") => failed{"inputs-identical"}
        seed_keys_equal: context("life/cache-semantics", "seed-keys-equal-drift", "", "offline") => failed{"keys-equal"}
        seed_key_nonempty: context("life/cache-semantics", "seed-key-nonempty-drift", "", "offline") => failed{"key-nonempty"}
        seed_abs_ok: context("life/cache-semantics", "seed-abs-ok-drift", "", "offline") => failed{"abs-ok"}
        seed_write_ok: context("life/cache-semantics", "seed-write-ok-drift", "", "offline") => failed{"write-ok"}
        seed_refusal_fired: context("life/cache-semantics", "seed-refusal-fired-drift", "", "offline") => failed{"refusal-fired"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.source_root_name, "sourceRoot", c, "source-root-name")
            failed
            ok evidence source_root_name_evidence => match call require_text(got.archive_name, "archive", c, "archive-name")
                failed
                ok evidence archive_name_evidence => match call require_text(got.first_name, "first", c, "first-name")
                    failed
                    ok evidence first_name_evidence => match call require_text(got.second_name, "second", c, "second-name")
                        failed
                        ok evidence second_name_evidence => match call require_text(got.helper_name, "harnessKey", c, "helper-name")
                            failed
                            ok evidence helper_name_evidence => match call require_int(got.derivation_count, 2, c, "derivation-count")
                                failed
                                ok evidence derivation_count_evidence => match call require_int(got.bundle_input_count, 4, c, "bundle-input-count")
                                    failed
                                    ok evidence bundle_input_count_evidence => match call require_int(got.guard_leg_count, 2, c, "guard-leg-count")
                                        failed
                                        ok evidence guard_leg_count_evidence => match call require_int(got.refusal_count, 1, c, "refusal-count")
                                            failed
                                            ok evidence refusal_count_evidence => match call require_bool(got.inputs_identical, true, c, "inputs-identical")
                                                failed
                                                ok evidence inputs_identical_evidence => match call require_bool(got.keys_equal, true, c, "keys-equal")
                                                    failed
                                                    ok evidence keys_equal_evidence => match call require_bool(got.key_nonempty, true, c, "key-nonempty")
                                                        failed
                                                        ok evidence key_nonempty_evidence => match call require_bool(got.abs_ok, true, c, "abs-ok")
                                                            failed
                                                            ok evidence abs_ok_evidence => match call require_bool(got.write_ok, true, c, "write-ok")
                                                                failed
                                                                ok evidence write_ok_evidence => match call require_bool(got.refusal_fired, false, c, "refusal-fired")
                                                                    failed
                                                                    ok evidence refusal_fired_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_l016: "m29-l016" => ok test_case("life/cache-semantics", ["life", "m29"], [], 120000, [check_ref("source-root-name"), check_ref("archive-name"), check_ref("first-name"), check_ref("second-name"), check_ref("helper-name"), check_ref("derivation-count"), check_ref("bundle-input-count"), check_ref("guard-leg-count"), check_ref("refusal-count"), check_ref("inputs-identical"), check_ref("keys-equal"), check_ref("key-nonempty"), check_ref("abs-ok"), check_ref("write-ok"), check_ref("refusal-fired")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-l016"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/cache-semantics", ["life", "m29"], [], 120000, [check_ref("source-root-name"), check_ref("archive-name"), check_ref("first-name"), check_ref("second-name"), check_ref("helper-name"), check_ref("derivation-count"), check_ref("bundle-input-count"), check_ref("guard-leg-count"), check_ref("refusal-count"), check_ref("inputs-identical"), check_ref("keys-equal"), check_ref("key-nonempty"), check_ref("abs-ok"), check_ref("write-ok"), check_ref("refusal-fired")], callable case_body)
