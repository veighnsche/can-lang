package m29life016roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-016 "Key stable: roots green".
/// Source: tests/integration/harness_cache_test.go static
/// baseline for TestHarnessKeyStable (L16-29) plus call shapes
/// (L17-18, L22-23, L26).
/// Disposition: migrate (this row ports
/// TestHarnessKeyStable to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static baseline as the green root:
/// the test symbol plus param shape, the repo root plus archive
/// name plus seed bytes, the byte wrap plus file mode, and the
/// call spellings (Abs, Join, TempDir, WriteFile, Parallel,
/// Fatal, Fatalf, harnessKey).
/// ADAPTATION (recorded, with source lines): repo-root pins the
/// ../.. inner bytes as str (L18); archive-suffix pins the
/// archive.zip inner bytes (L22); archive-bytes pins the
/// fake-archive-bytes inner bytes (L23); byte-wrap pins the full
/// []byte call spelling (L23); file-mode pins the 0600 spelling
/// structurally as str (L23; Go octal has no Can int spelling);
/// paren calls pin t.TempDir() and t.Parallel() with parens
/// (L22, L17); harness-call pins one spelling for both
/// derivation sites (L26-27).
/// Facet map (static baseline): test-name pins
/// TestHarnessKeyStable (L16); test-param pins t *testing.T
/// (L16); repo-root pins ../.. (L18); archive-suffix pins
/// archive.zip (L22); archive-bytes pins fake-archive-bytes
/// (L23); byte-wrap pins []byte("fake-archive-bytes") (L23);
/// file-mode pins 0600 (L23); abs-call pins filepath.Abs (L18);
/// join-call pins filepath.Join (L22); tempdir-call pins
/// t.TempDir() (L22); write-call pins os.WriteFile (L23);
/// parallel-call pins t.Parallel() (L17); fatal-call pins
/// t.Fatal (L20); fatalf-call pins t.Fatalf (L29);
/// harness-call pins harnessKey(t, sourceRoot, archive) (L26).
/// The verdict pins live in life-016-cache-semantics.can;
/// the run shape plus diagnostics live in
/// life-016-run-shape.can.
/// Variants: first/second (the two repeated derivations in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/cache-roots checks: test-name, test-param,
/// repo-root, archive-suffix, archive-bytes, byte-wrap,
/// file-mode, abs-call, join-call, tempdir-call, write-call,
/// parallel-call, fatal-call, fatalf-call, harness-call.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str test_param
    str repo_root
    str archive_suffix
    str archive_bytes
    str byte_wrap
    str file_mode
    str abs_call
    str join_call
    str tempdir_call
    str write_call
    str parallel_call
    str fatal_call
    str fatalf_call
    str harness_call
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/cache-roots", "default", "", "offline"), "test-name" => ok "case life/cache-roots variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/cache-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/cache-roots variant default root test-name run offline")
        different: false, true, context("life/cache-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/cache-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "1", "1", true, "case life/cache-roots variant default root test-name run offline")
        different: 2, 1, context("life/cache-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestHarnessKeyStable", "TestHarnessKeyStable", context("life/cache-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestHarnessKeyStable", "TestHarnessKeyStable", true, "case life/cache-roots variant default root test-name run offline")
        different: "TestHarnessKeyStable_2", "TestHarnessKeyStable", context("life/cache-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
