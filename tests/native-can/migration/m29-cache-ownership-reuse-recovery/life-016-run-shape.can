fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/cache-run", "default", "", "offline") => ok
        seed_abs_stmt: context("life/cache-run", "seed-abs-stmt-drift", "", "offline") => failed{"abs-stmt"}
