package m29life016run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-016 "Key stable: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessKeyStable (L16-29): parallel gate (L17); root
/// setup (L18-20); archive setup (L22-24); first and second
/// derivations (L26-27); stability gate (L28); refusal (L29).
/// Disposition: migrate (this row ports
/// TestHarnessKeyStable to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the root setup
/// shape, the archive setup shape, the seed write shape, the
/// err guard plus fatal shape, the first and second derivation
/// shapes, the empty plus or plus stability gate legs, the
/// unstable refusal wording plus args, the fatal and refusal
/// arg counts, and the parallel-first order.
/// ADAPTATION (recorded, with source lines): shapes pin the Go
/// statement inner bytes without leading tabs (L18, L22-23,
/// L26-27); err-guard pins one spelling for both setup sites
/// (L19, L23); fatal-err pins one spelling for both failure
/// sites (L20, L24); gate legs pin the decomposed comparison
/// spellings (L28); fatal-unstable pins the Fatalf format inner
/// bytes (L29); counts pin ints from the failure sites (L20,
/// L24) and the refusal args (L29).
/// Facet map (launch plus diagnostics): abs-stmt pins the root
/// setup (L18); archive-stmt pins the archive setup (L22);
/// write-shape pins the seed write (L23); err-guard pins
/// err != nil (L19, L23); fatal-err pins t.Fatal(err) (L20,
/// L24); first-stmt pins the first derivation (L26);
/// second-stmt pins the second derivation (L27); empty-guard
/// pins first == "" (L28); or-op pins || (L28);
/// stability-guard pins first != second (L28); fatal-unstable
/// pins the refusal wording (L29); fatalf-args pins first,
/// second (L29); fatal-err-count pins 2 (L20, L24);
/// refusal-arg-count pins 2 (L29); parallel-first pins true
/// (L17).
/// The verdict pins live in life-016-cache-semantics.can;
/// the roots-green pin lives in life-016-roots-green.can.
/// Variants: first/second (the two repeated derivations in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/cache-run checks: abs-stmt, archive-stmt,
/// write-shape, err-guard, fatal-err, first-stmt, second-stmt,
/// empty-guard, or-op, stability-guard, fatal-unstable,
/// fatalf-args, fatal-err-count, refusal-arg-count,
/// parallel-first.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str abs_stmt
    str archive_stmt
    str write_shape
    str err_guard
    str fatal_err
    str first_stmt
    str second_stmt
    str empty_guard
    str or_op
    str stability_guard
    str fatal_unstable
    str fatalf_args
    int fatal_err_count
    int refusal_arg_count
    bool parallel_first
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/cache-run", "default", "", "offline"), "abs-stmt" => ok "case life/cache-run variant default root abs-stmt run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/cache-run", "default", "", "offline"), "parallel-first" => ok evidence("parallel-first", "true", "true", true, "case life/cache-run variant default root parallel-first run offline")
        different: false, true, context("life/cache-run", "default", "", "offline"), "parallel-first" => failed{"parallel-first"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/cache-run", "default", "", "offline"), "fatal-err-count" => ok evidence("fatal-err-count", "2", "2", true, "case life/cache-run variant default root fatal-err-count run offline")
        different: 3, 2, context("life/cache-run", "default", "", "offline"), "fatal-err-count" => failed{"fatal-err-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "sourceRoot, err := filepath.Abs(\"../..\")", "sourceRoot, err := filepath.Abs(\"../..\")", context("life/cache-run", "default", "", "offline"), "abs-stmt" => ok evidence("abs-stmt", "sourceRoot, err := filepath.Abs(\"../..\")", "sourceRoot, err := filepath.Abs(\"../..\")", true, "case life/cache-run variant default root abs-stmt run offline")
        different: "sourceRoot, err := filepath.Abs(\"../..\")_2", "sourceRoot, err := filepath.Abs(\"../..\")", context("life/cache-run", "default", "", "offline"), "abs-stmt" => failed{"abs-stmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
