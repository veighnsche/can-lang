package m29life017cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-017 "Key sensitivity: verdict semantics".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessKeySensitive (L35-53).
/// Disposition: consolidate (this row ports
/// TestHarnessKeySensitive to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the two archive-input legs in Go
/// order (before baseline bytes vs after changed bytes), the
/// equality spelling that refuses equal keys, the
/// keys-differ plus reuse-invalidated verdicts, the two-input
/// count, and the three err-guard count.
/// ADAPTATION (recorded, with source lines): leg names pin
/// the Go local spellings (before L42, after L43); file names
/// pin the zip literals (L42-43); leg bytes pin the []byte
/// inner spellings (archive-a L44, archive-b L47); write-mode
/// pins the 0600 spelling structurally as str (L44/L47);
/// compare-op pins == (L50) as the comparison logic (no hash
/// re-implementation anywhere); keys-differ pins bool (true)
/// from the refused equality (L50-52); reuse-invalidated pins
/// bool (true) from the protects facet; archive-count pins
/// int (2) from the two legs (L42-43); err-guard-count pins
/// int (3) from the err guards (L38/L44/L47).
/// Facet map (Go verdict legs): before-name pins before
/// (L42); after-name pins after (L43); before-file pins
/// before.zip (L42); after-file pins after.zip (L43);
/// before-bytes pins archive-a (L44); after-bytes pins
/// archive-b (L47); write-mode pins 0600 (L44/L47);
/// compare-op pins == (L50); keys-differ pins true (L50-52);
/// reuse-invalidated pins true (protects facet);
/// archive-count pins 2 (L42-43); err-guard-count pins 3
/// (L38/L44/L47).
/// The roots-green pin lives in life-017-roots-green.can; the
/// run shape plus diagnostics live in life-017-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is the
/// offline default bound (no Go timeout in this row; binds at
/// P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/key-semantics checks: before-name, after-name,
/// before-file, after-file, before-bytes, after-bytes,
/// write-mode, compare-op, keys-differ, reuse-invalidated,
/// archive-count, err-guard-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str before_name
    str after_name
    str before_file
    str after_file
    str before_bytes
    str after_bytes
    str write_mode
    str compare_op
    bool keys_differ
    bool reuse_invalidated
    int archive_count
    int err_guard_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/key-semantics", "default", "", "offline"), "before-name" => ok "case life/key-semantics variant default root before-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/key-semantics", "default", "", "offline"), "before-name" => ok evidence("before-name", "true", "true", true, "case life/key-semantics variant default root before-name run offline")
        different: false, true, context("life/key-semantics", "default", "", "offline"), "before-name" => failed{"before-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/key-semantics", "default", "", "offline"), "archive-count" => ok evidence("archive-count", "2", "2", true, "case life/key-semantics variant default root archive-count run offline")
        different: 1, 2, context("life/key-semantics", "default", "", "offline"), "archive-count" => failed{"archive-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "before", "before", context("life/key-semantics", "default", "", "offline"), "before-name" => ok evidence("before-name", "before", "before", true, "case life/key-semantics variant default root before-name run offline")
        different: "before_2", "before", context("life/key-semantics", "default", "", "offline"), "before-name" => failed{"before-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        seed_before_name: "seed-before-name-drift" => ok observation("before_2", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        seed_after_name: "seed-after-name-drift" => ok observation("before", "after_2", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        seed_before_file: "seed-before-file-drift" => ok observation("before", "after", "before.zip_2", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        seed_after_file: "seed-after-file-drift" => ok observation("before", "after", "before.zip", "after.zip_2", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        seed_before_bytes: "seed-before-bytes-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a_2", "archive-b", "0600", "==", true, true, 2, 3)
        seed_after_bytes: "seed-after-bytes-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b_2", "0600", "==", true, true, 2, 3)
        seed_write_mode: "seed-write-mode-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600_2", "==", true, true, 2, 3)
        seed_compare_op: "seed-compare-op-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==_2", true, true, 2, 3)
        seed_keys_differ: "seed-keys-differ-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", false, true, 2, 3)
        seed_reuse_invalidated: "seed-reuse-invalidated-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, false, 2, 3)
        seed_archive_count: "seed-archive-count-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 1, 3)
        seed_err_guard_count: "seed-err-guard-count-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 2)
    match variant_id
        "seed-before-name-drift" => ok observation("before_2", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        "seed-after-name-drift" => ok observation("before", "after_2", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        "seed-before-file-drift" => ok observation("before", "after", "before.zip_2", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        "seed-after-file-drift" => ok observation("before", "after", "before.zip", "after.zip_2", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
        "seed-before-bytes-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a_2", "archive-b", "0600", "==", true, true, 2, 3)
        "seed-after-bytes-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b_2", "0600", "==", true, true, 2, 3)
        "seed-write-mode-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600_2", "==", true, true, 2, 3)
        "seed-compare-op-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==_2", true, true, 2, 3)
        "seed-keys-differ-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", false, true, 2, 3)
        "seed-reuse-invalidated-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, false, 2, 3)
        "seed-archive-count-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 1, 3)
        "seed-err-guard-count-drift" => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 2)
        _ => ok observation("before", "after", "before.zip", "after.zip", "archive-a", "archive-b", "0600", "==", true, true, 2, 3)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_l017: "m29-l017" => ok [check("before-name", "before leg keeps its Go name"), check("after-name", "after leg keeps its Go name"), check("before-file", "before leg pins the before zip name"), check("after-file", "after leg pins the after zip name"), check("before-bytes", "before leg pins the baseline archive bytes"), check("after-bytes", "after leg pins the changed archive bytes"), check("write-mode", "both legs land owner-only"), check("compare-op", "key legs pin the equality spelling"), check("keys-differ", "changed bytes yield a different key"), check("reuse-invalidated", "changed bytes refuse stale build reuse"), check("archive-count", "exactly two archive inputs run"), check("err-guard-count", "three legs face the err guard")]
        other: "nope" => ok []
    match scope is "m29-l017"
        false => ok []
        true => ok [check("before-name", "before leg keeps its Go name"), check("after-name", "after leg keeps its Go name"), check("before-file", "before leg pins the before zip name"), check("after-file", "after leg pins the after zip name"), check("before-bytes", "before leg pins the baseline archive bytes"), check("after-bytes", "after leg pins the changed archive bytes"), check("write-mode", "both legs land owner-only"), check("compare-op", "key legs pin the equality spelling"), check("keys-differ", "changed bytes yield a different key"), check("reuse-invalidated", "changed bytes refuse stale build reuse"), check("archive-count", "exactly two archive inputs run"), check("err-guard-count", "three legs face the err guard")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "life/key-semantics" => ok [expected_check("before-name", "before"), expected_check("after-name", "after"), expected_check("before-file", "before.zip"), expected_check("after-file", "after.zip"), expected_check("before-bytes", "archive-a"), expected_check("after-bytes", "archive-b"), expected_check("write-mode", "0600"), expected_check("compare-op", "=="), expected_check("keys-differ", "true"), expected_check("reuse-invalidated", "true"), expected_check("archive-count", "2"), expected_check("err-guard-count", "3")]
        unknown: "nope" => ok []
    match case is "life/key-semantics"
        false => ok []
        true => ok [expected_check("before-name", "before"), expected_check("after-name", "after"), expected_check("before-file", "before.zip"), expected_check("after-file", "after.zip"), expected_check("before-bytes", "archive-a"), expected_check("after-bytes", "archive-b"), expected_check("write-mode", "0600"), expected_check("compare-op", "=="), expected_check("keys-differ", "true"), expected_check("reuse-invalidated", "true"), expected_check("archive-count", "2"), expected_check("err-guard-count", "3")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/key-semantics", "default", "", "offline") => ok
        seed_before_name: context("life/key-semantics", "seed-before-name-drift", "", "offline") => failed{"before-name"}
        seed_after_name: context("life/key-semantics", "seed-after-name-drift", "", "offline") => failed{"after-name"}
        seed_before_file: context("life/key-semantics", "seed-before-file-drift", "", "offline") => failed{"before-file"}
        seed_after_file: context("life/key-semantics", "seed-after-file-drift", "", "offline") => failed{"after-file"}
        seed_before_bytes: context("life/key-semantics", "seed-before-bytes-drift", "", "offline") => failed{"before-bytes"}
        seed_after_bytes: context("life/key-semantics", "seed-after-bytes-drift", "", "offline") => failed{"after-bytes"}
        seed_write_mode: context("life/key-semantics", "seed-write-mode-drift", "", "offline") => failed{"write-mode"}
        seed_compare_op: context("life/key-semantics", "seed-compare-op-drift", "", "offline") => failed{"compare-op"}
        seed_keys_differ: context("life/key-semantics", "seed-keys-differ-drift", "", "offline") => failed{"keys-differ"}
        seed_reuse_invalidated: context("life/key-semantics", "seed-reuse-invalidated-drift", "", "offline") => failed{"reuse-invalidated"}
        seed_archive_count: context("life/key-semantics", "seed-archive-count-drift", "", "offline") => failed{"archive-count"}
        seed_err_guard_count: context("life/key-semantics", "seed-err-guard-count-drift", "", "offline") => failed{"err-guard-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.before_name, "before", c, "before-name")
            failed
            ok evidence before_name_evidence => match call require_text(got.after_name, "after", c, "after-name")
                failed
                ok evidence after_name_evidence => match call require_text(got.before_file, "before.zip", c, "before-file")
                    failed
                    ok evidence before_file_evidence => match call require_text(got.after_file, "after.zip", c, "after-file")
                        failed
                        ok evidence after_file_evidence => match call require_text(got.before_bytes, "archive-a", c, "before-bytes")
                            failed
                            ok evidence before_bytes_evidence => match call require_text(got.after_bytes, "archive-b", c, "after-bytes")
                                failed
                                ok evidence after_bytes_evidence => match call require_text(got.write_mode, "0600", c, "write-mode")
                                    failed
                                    ok evidence write_mode_evidence => match call require_text(got.compare_op, "==", c, "compare-op")
                                        failed
                                        ok evidence compare_op_evidence => match call require_bool(got.keys_differ, true, c, "keys-differ")
                                            failed
                                            ok evidence keys_differ_evidence => match call require_bool(got.reuse_invalidated, true, c, "reuse-invalidated")
                                                failed
                                                ok evidence reuse_invalidated_evidence => match call require_int(got.archive_count, 2, c, "archive-count")
                                                    failed
                                                    ok evidence archive_count_evidence => match call require_int(got.err_guard_count, 3, c, "err-guard-count")
                                                        failed
                                                        ok evidence err_guard_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_l017: "m29-l017" => ok test_case("life/key-semantics", ["life", "m29"], [], 120000, [check_ref("before-name"), check_ref("after-name"), check_ref("before-file"), check_ref("after-file"), check_ref("before-bytes"), check_ref("after-bytes"), check_ref("write-mode"), check_ref("compare-op"), check_ref("keys-differ"), check_ref("reuse-invalidated"), check_ref("archive-count"), check_ref("err-guard-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-l017"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/key-semantics", ["life", "m29"], [], 120000, [check_ref("before-name"), check_ref("after-name"), check_ref("before-file"), check_ref("after-file"), check_ref("before-bytes"), check_ref("after-bytes"), check_ref("write-mode"), check_ref("compare-op"), check_ref("keys-differ"), check_ref("reuse-invalidated"), check_ref("archive-count"), check_ref("err-guard-count")], callable case_body)
