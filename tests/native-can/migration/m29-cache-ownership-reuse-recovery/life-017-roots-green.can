package m29life017roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-017 "Key sensitivity: roots green".
/// Source: tests/integration/harness_test.go helper
/// harnessKey (L177-220) plus consts (L48/L53).
/// Disposition: consolidate (this row ports
/// TestHarnessKeySensitive to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the static key baseline as the
/// green root: the helper name plus archive param, the
/// per-pair memo name plus NUL join, the Lock/Unlock pair,
/// the tree call plus dir set, the go.mod/go.sum pins, the
/// ReadFile plus Hash calls, the three synthetic slots
/// (@archive/@go/@version) plus Version call plus shared
/// version name/value, the Strings sort plus Builder canon
/// with equals/newline joins, and the dir/slot counts.
/// ADAPTATION (recorded, with source lines): memo-sep pins
/// the \x00 inner bytes as a 4-char str (L181); sep-newline
/// pins the \n inner bytes as a 2-char str (L213); go-call
/// pins runtime.Version() with parens (L201); key-dirs-count
/// pins int (4) from the dir list (L53); extra-key-count pins
/// int (3) from the synthetic slots (L200-202); all call pins
/// pin spellings only (no hash re-implementation anywhere).
/// Facet map (static baseline): helper-name pins harnessKey
/// (L177); key-param pins archive (L177); memo-name pins memo
/// (L181); memo-sep pins \x00 (L181); lock-call pins
/// harnessMu.Lock (L182); unlock-call pins harnessMu.Unlock
/// (L184); tree-call pins treeHashes (L188); key-dirs-name
/// pins harnessKeyDirs (L188); dir-compiler pins compiler
/// (L53); dir-distribution pins distribution (L53);
/// dir-runtime pins runtime (L53); dir-tools pins tools
/// (L53); gomod-name pins go.mod (L189); gosum-name pins
/// go.sum (L189); read-call pins os.ReadFile (L190);
/// hash-call pins distribution.Hash (L194); archive-key pins
/// @archive (L200); go-key pins @go (L201); version-key pins
/// @version (L202); go-call pins runtime.Version() (L201);
/// version-name pins harnessSharedVersion (L202);
/// version-value pins harness-shared (L48); sort-call pins
/// sort.Strings (L207); builder-name pins strings.Builder
/// (L208); sep-equals pins = (L211); sep-newline pins \n
/// (L213); key-dirs-count pins 4 (L53); extra-key-count pins
/// 3 (L200-202).
/// The verdict pins live in life-017-cache-semantics.can; the
/// run shape plus diagnostics live in life-017-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is the
/// offline default bound (no Go timeout in this row; binds at
/// P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/key-roots checks: helper-name, key-param,
/// memo-name, memo-sep, lock-call, unlock-call, tree-call,
/// key-dirs-name, dir-compiler, dir-distribution, dir-runtime,
/// dir-tools, gomod-name, gosum-name, read-call, hash-call,
/// archive-key, go-key, version-key, go-call, version-name,
/// version-value, sort-call, builder-name, sep-equals,
/// sep-newline, key-dirs-count, extra-key-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str helper_name
    str key_param
    str memo_name
    str memo_sep
    str lock_call
    str unlock_call
    str tree_call
    str key_dirs_name
    str dir_compiler
    str dir_distribution
    str dir_runtime
    str dir_tools
    str gomod_name
    str gosum_name
    str read_call
    str hash_call
    str archive_key
    str go_key
    str version_key
    str go_call
    str version_name
    str version_value
    str sort_call
    str builder_name
    str sep_equals
    str sep_newline
    int key_dirs_count
    int extra_key_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/key-roots", "default", "", "offline"), "helper-name" => ok "case life/key-roots variant default root helper-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/key-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "true", "true", true, "case life/key-roots variant default root helper-name run offline")
        different: false, true, context("life/key-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("life/key-roots", "default", "", "offline"), "key-dirs-count" => ok evidence("key-dirs-count", "4", "4", true, "case life/key-roots variant default root key-dirs-count run offline")
        different: 3, 4, context("life/key-roots", "default", "", "offline"), "key-dirs-count" => failed{"key-dirs-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "harnessKey", "harnessKey", context("life/key-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "harnessKey", "harnessKey", true, "case life/key-roots variant default root helper-name run offline")
        different: "harnessKey_2", "harnessKey", context("life/key-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
