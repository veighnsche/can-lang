package m29life017run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-017 "Key sensitivity: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessKeySensitive (L35-53): parallel gate (L36);
/// root setup (L37-40); temp dir (L41); before/after joins
/// (L42-43); byte writes (L44-49); key comparison (L50-52).
/// Disposition: consolidate (this row ports
/// TestHarnessKeySensitive to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the live run shape: the test name,
/// the Parallel gate, the Abs root setup plus climb arg, the
/// shared err guard plus Fatal err refusal, the TempDir
/// scratch dir, the Join plus WriteFile plus []byte legs, the
/// two full key call spellings, the ignores-bytes refusal,
/// and the write/key-call counts.
/// ADAPTATION (recorded, with source lines): parallel-call
/// pins t.Parallel() with parens (L36); tempdir-call pins
/// t.TempDir() with parens (L41); err-guard pins the full
/// err != nil spelling shared by three sites (L38/L44/L47);
/// fatal-err pins the t.Fatal(err) call shared by three sites
/// (L39/L45/L48); fatal-ignores pins the refusal inner bytes
/// (L51); write-count pins int (2) from the two writes
/// (L44/L47); key-call-count pins int (2) from the two key
/// calls (L50).
/// Facet map (launch plus diagnostics): test-name pins
/// TestHarnessKeySensitive (L35); parallel-call pins
/// t.Parallel() (L36); abs-call pins filepath.Abs (L37);
/// abs-arg pins ../.. (L37); err-guard pins err != nil
/// (L38); fatal-err pins t.Fatal(err) (L39); dir-name pins
/// dir (L41); tempdir-call pins t.TempDir() (L41); join-call
/// pins filepath.Join (L42); write-call pins os.WriteFile
/// (L44); bytes-call pins []byte (L44); key-before-call pins
/// harnessKey(t, sourceRoot, before) (L50); key-after-call
/// pins harnessKey(t, sourceRoot, after) (L50); fatal-ignores
/// pins harness key ignores archive bytes (L51); write-count
/// pins 2 (L44/L47); key-call-count pins 2 (L50).
/// The verdict pins live in life-017-cache-semantics.can; the
/// roots-green pin lives in life-017-roots-green.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is the
/// offline default bound (no Go timeout in this row; binds at
/// P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/key-run checks: test-name, parallel-call,
/// abs-call, abs-arg, err-guard, fatal-err, dir-name,
/// tempdir-call, join-call, write-call, bytes-call,
/// key-before-call, key-after-call, fatal-ignores,
/// write-count, key-call-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str parallel_call
    str abs_call
    str abs_arg
    str err_guard
    str fatal_err
    str dir_name
    str tempdir_call
    str join_call
    str write_call
    str bytes_call
    str key_before_call
    str key_after_call
    str fatal_ignores
    int write_count
    int key_call_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/key-run", "default", "", "offline"), "test-name" => ok "case life/key-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/key-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/key-run variant default root test-name run offline")
        different: false, true, context("life/key-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/key-run", "default", "", "offline"), "write-count" => ok evidence("write-count", "2", "2", true, "case life/key-run variant default root write-count run offline")
        different: 1, 2, context("life/key-run", "default", "", "offline"), "write-count" => failed{"write-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestHarnessKeySensitive", "TestHarnessKeySensitive", context("life/key-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestHarnessKeySensitive", "TestHarnessKeySensitive", true, "case life/key-run variant default root test-name run offline")
        different: "TestHarnessKeySensitive_2", "TestHarnessKeySensitive", context("life/key-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
