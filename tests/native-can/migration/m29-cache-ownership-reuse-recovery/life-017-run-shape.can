        false => ok []
        true => ok [check("test-name", "row pins the Sensitive test name"), check("parallel-call", "test pins the Parallel call"), check("abs-call", "root pins the Abs call"), check("abs-arg", "root climbs two levels up"), check("err-guard", "three legs share the err guard"), check("fatal-err", "err legs refuse with Fatal err"), check("dir-name", "scratch dir is named dir"), check("tempdir-call", "scratch pins the TempDir call"), check("join-call", "zips join with filepath Join"), check("write-call", "legs land with WriteFile"), check("bytes-call", "bytes pin the byte slice cast"), check("key-before-call", "left key pins the before call"), check("key-after-call", "right key pins the after call"), check("fatal-ignores", "equal keys refusal wording is pinned"), check("write-count", "exactly two legs write bytes"), check("key-call-count", "exactly two key calls compare")]
