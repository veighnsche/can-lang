fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/key-run", "default", "", "offline") => ok
        seed_test_name: context("life/key-run", "seed-test-name-drift", "", "offline") => failed{"test-name"}
        seed_parallel_call: context("life/key-run", "seed-parallel-call-drift", "", "offline") => failed{"parallel-call"}
        seed_abs_call: context("life/key-run", "seed-abs-call-drift", "", "offline") => failed{"abs-call"}
        seed_abs_arg: context("life/key-run", "seed-abs-arg-drift", "", "offline") => failed{"abs-arg"}
        seed_err_guard: context("life/key-run", "seed-err-guard-drift", "", "offline") => failed{"err-guard"}
        seed_fatal_err: context("life/key-run", "seed-fatal-err-drift", "", "offline") => failed{"fatal-err"}
        seed_dir_name: context("life/key-run", "seed-dir-name-drift", "", "offline") => failed{"dir-name"}
        seed_tempdir_call: context("life/key-run", "seed-tempdir-call-drift", "", "offline") => failed{"tempdir-call"}
        seed_join_call: context("life/key-run", "seed-join-call-drift", "", "offline") => failed{"join-call"}
        seed_write_call: context("life/key-run", "seed-write-call-drift", "", "offline") => failed{"write-call"}
        seed_bytes_call: context("life/key-run", "seed-bytes-call-drift", "", "offline") => failed{"bytes-call"}
        seed_key_before_call: context("life/key-run", "seed-key-before-call-drift", "", "offline") => failed{"key-before-call"}
        seed_key_after_call: context("life/key-run", "seed-key-after-call-drift", "", "offline") => failed{"key-after-call"}
        seed_fatal_ignores: context("life/key-run", "seed-fatal-ignores-drift", "", "offline") => failed{"fatal-ignores"}
        seed_write_count: context("life/key-run", "seed-write-count-drift", "", "offline") => failed{"write-count"}
        seed_key_call_count: context("life/key-run", "seed-key-call-count-drift", "", "offline") => failed{"key-call-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.test_name, "TestHarnessKeySensitive", c, "test-name")
            failed
            ok evidence test_name_evidence => match call require_text(got.parallel_call, "t.Parallel()", c, "parallel-call")
                failed
                ok evidence parallel_call_evidence => match call require_text(got.abs_call, "filepath.Abs", c, "abs-call")
                    failed
                    ok evidence abs_call_evidence => match call require_text(got.abs_arg, "../..", c, "abs-arg")
                        failed
                        ok evidence abs_arg_evidence => match call require_text(got.err_guard, "err != nil", c, "err-guard")
                            failed
