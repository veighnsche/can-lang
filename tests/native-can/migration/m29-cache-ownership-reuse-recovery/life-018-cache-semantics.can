        seed_refusal_count: "seed-refusal-count-drift" => ok observation("bin/canlc", "runtime/bun", "launcher", "runtime", "harnessVerify", 2, 3, 1, 2, true, true, true, true, true, false)
        seed_files_listed: "seed-files-listed-drift" => ok observation("bin/canlc", "runtime/bun", "launcher", "runtime", "harnessVerify", 2, 3, 1, 1, false, true, true, true, true, false)
        seed_hash_match: "seed-hash-match-drift" => ok observation("bin/canlc", "runtime/bun", "launcher", "runtime", "harnessVerify", 2, 3, 1, 1, true, false, true, true, true, false)
        seed_manifest_ok: "seed-manifest-ok-drift" => ok observation("bin/canlc", "runtime/bun", "launcher", "runtime", "harnessVerify", 2, 3, 1, 1, true, true, false, true, true, false)
        seed_verify_ok: "seed-verify-ok-drift" => ok observation("bin/canlc", "runtime/bun", "launcher", "runtime", "harnessVerify", 2, 3, 1, 1, true, true, true, false, true, false)
