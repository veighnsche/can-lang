        other: "nope" => ok []
    match scope is "m29-l018"
        false => ok []
        true => ok [check("first-file-name", "first manifest leg pins its file name"), check("second-file-name", "second manifest leg pins its file name"), check("first-file-body", "first manifest leg pins its seed body"), check("second-file-body", "second manifest leg pins its seed body"), check("helper-name", "verify helper is named harnessVerify"), check("file-count", "two files are listed in order"), check("manifest-guard-count", "manifest gate has three legs"), check("verify-call-count", "one verify call runs the gate"), check("refusal-count", "one refusal guards the gate"), check("files-listed", "both files land in the manifest"), check("hash-match", "pristine bytes compare equal"), check("manifest-ok", "manifest gate passes on clean bytes"), check("verify-ok", "verify returns nil on clean entry"), check("err-nil", "err stays nil on the clean path"), check("refusal-fired", "refusal stays silent on clean entry")]
