fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/verify-clean-semantics", "default", "", "offline") => ok
        seed_first_file_name: context("life/verify-clean-semantics", "seed-first-file-name-drift", "", "offline") => failed{"first-file-name"}
        seed_second_file_name: context("life/verify-clean-semantics", "seed-second-file-name-drift", "", "offline") => failed{"second-file-name"}
        seed_first_file_body: context("life/verify-clean-semantics", "seed-first-file-body-drift", "", "offline") => failed{"first-file-body"}
        seed_second_file_body: context("life/verify-clean-semantics", "seed-second-file-body-drift", "", "offline") => failed{"second-file-body"}
        seed_helper_name: context("life/verify-clean-semantics", "seed-helper-name-drift", "", "offline") => failed{"helper-name"}
        seed_file_count: context("life/verify-clean-semantics", "seed-file-count-drift", "", "offline") => failed{"file-count"}
        seed_manifest_guard_count: context("life/verify-clean-semantics", "seed-manifest-guard-count-drift", "", "offline") => failed{"manifest-guard-count"}
        seed_verify_call_count: context("life/verify-clean-semantics", "seed-verify-call-count-drift", "", "offline") => failed{"verify-call-count"}
        seed_refusal_count: context("life/verify-clean-semantics", "seed-refusal-count-drift", "", "offline") => failed{"refusal-count"}
        seed_files_listed: context("life/verify-clean-semantics", "seed-files-listed-drift", "", "offline") => failed{"files-listed"}
        seed_hash_match: context("life/verify-clean-semantics", "seed-hash-match-drift", "", "offline") => failed{"hash-match"}
        seed_manifest_ok: context("life/verify-clean-semantics", "seed-manifest-ok-drift", "", "offline") => failed{"manifest-ok"}
        seed_verify_ok: context("life/verify-clean-semantics", "seed-verify-ok-drift", "", "offline") => failed{"verify-ok"}
        seed_err_nil: context("life/verify-clean-semantics", "seed-err-nil-drift", "", "offline") => failed{"err-nil"}
        seed_refusal_fired: context("life/verify-clean-semantics", "seed-refusal-fired-drift", "", "offline") => failed{"refusal-fired"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.first_file_name, "bin/canlc", c, "first-file-name")
            failed
            ok evidence first_file_name_evidence => match call require_text(got.second_file_name, "runtime/bun", c, "second-file-name")
                failed
                ok evidence second_file_name_evidence => match call require_text(got.first_file_body, "launcher", c, "first-file-body")
                    failed
                    ok evidence first_file_body_evidence => match call require_text(got.second_file_body, "runtime", c, "second-file-body")
                        failed
                        ok evidence second_file_body_evidence => match call require_text(got.helper_name, "harnessVerify", c, "helper-name")
                            failed
                            ok evidence helper_name_evidence => match call require_int(got.file_count, 2, c, "file-count")
                                failed
                                ok evidence file_count_evidence => match call require_int(got.manifest_guard_count, 3, c, "manifest-guard-count")
                                    failed
                                    ok evidence manifest_guard_count_evidence => match call require_int(got.verify_call_count, 1, c, "verify-call-count")
                                        failed
                                        ok evidence verify_call_count_evidence => match call require_int(got.refusal_count, 1, c, "refusal-count")
                                            failed
                                            ok evidence refusal_count_evidence => match call require_bool(got.files_listed, true, c, "files-listed")
                                                failed
                                                ok evidence files_listed_evidence => match call require_bool(got.hash_match, true, c, "hash-match")
                                                    failed
                                                    ok evidence hash_match_evidence => match call require_bool(got.manifest_ok, true, c, "manifest-ok")
                                                        failed
                                                        ok evidence manifest_ok_evidence => match call require_bool(got.verify_ok, true, c, "verify-ok")
                                                            failed
                                                            ok evidence verify_ok_evidence => match call require_bool(got.err_nil, true, c, "err-nil")
                                                                failed
                                                                ok evidence err_nil_evidence => match call require_bool(got.refusal_fired, false, c, "refusal-fired")
                                                                    failed
                                                                    ok evidence refusal_fired_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_l018: "m29-l018" => ok test_case("life/verify-clean-semantics", ["life", "m29"], [], 120000, [check_ref("first-file-name"), check_ref("second-file-name"), check_ref("first-file-body"), check_ref("second-file-body"), check_ref("helper-name"), check_ref("file-count"), check_ref("manifest-guard-count"), check_ref("verify-call-count"), check_ref("refusal-count"), check_ref("files-listed"), check_ref("hash-match"), check_ref("manifest-ok"), check_ref("verify-ok"), check_ref("err-nil"), check_ref("refusal-fired")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-l018"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/verify-clean-semantics", ["life", "m29"], [], 120000, [check_ref("first-file-name"), check_ref("second-file-name"), check_ref("first-file-body"), check_ref("second-file-body"), check_ref("helper-name"), check_ref("file-count"), check_ref("manifest-guard-count"), check_ref("verify-call-count"), check_ref("refusal-count"), check_ref("files-listed"), check_ref("hash-match"), check_ref("manifest-ok"), check_ref("verify-ok"), check_ref("err-nil"), check_ref("refusal-fired")], callable case_body)
