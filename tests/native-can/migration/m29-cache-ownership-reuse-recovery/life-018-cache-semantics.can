package m29life018cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-018 "Verify clean: cache semantics".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessVerifyClean (L86-92) plus
/// tests/integration/harness_test.go helper harnessVerify
/// (L319-341).
/// Disposition: migrate (this row ports
/// TestHarnessVerifyClean to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the clean verdicts in Go order:
/// the two listed file names, the two seed bodies, the helper
/// name, the file plus guard plus call plus refusal counts,
/// plus the listed, hash-match, manifest-ok, verify-ok,
/// err-nil and refusal-fired verdicts.
/// ADAPTATION (recorded, with source lines): file names pin
/// the Go map keys (bin/canlc plus runtime/bun, L88);
/// bodies pin the map values (launcher plus runtime, L88);
/// file-count pins int (2) from the two map entries (L88);
/// manifest-guard-count pins int (3) from the three or-joined
/// legs (L328); verify-call-count pins int (1) from the single
/// harnessVerify call (L89); refusal-count pins int (1) from
/// the single Fatalf site (L90); verdicts pin bools from the
/// pristine path (L88-90) and the passing verify (L319-341);
/// refusal-fired pins false since the clean path never
/// reaches the Fatalf (L90).
/// Facet map (Go verdict legs): first-file-name pins
/// bin/canlc (L88); second-file-name pins runtime/bun (L88);
/// first-file-body pins launcher (L88); second-file-body
/// pins runtime (L88); helper-name pins harnessVerify (L89);
/// file-count pins 2 (L88); manifest-guard-count pins 3
/// (L328); verify-call-count pins 1 (L89); refusal-count
/// pins 1 (L90); files-listed pins true (L88);
/// hash-match pins true (L336); manifest-ok pins true
/// (L328); verify-ok pins true (L340); err-nil pins true
/// (L89); refusal-fired pins false (L90).
/// The roots-green pin lives in life-018-roots-green.can;
/// the run shape plus diagnostics live in
/// life-018-run-shape.can.
/// Variants: clean/pristine (the single passing path in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/verify-clean-semantics checks: first-file-name,
/// second-file-name, first-file-body, second-file-body,
/// helper-name, file-count, manifest-guard-count,
/// verify-call-count, refusal-count, files-listed,
/// hash-match, manifest-ok, verify-ok, err-nil,
/// refusal-fired.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str first_file_name
    str second_file_name
    str first_file_body
    str second_file_body
    str helper_name
    int file_count
    int manifest_guard_count
    int verify_call_count
    int refusal_count
    bool files_listed
    bool hash_match
    bool manifest_ok
    bool verify_ok
    bool err_nil
    bool refusal_fired
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/verify-clean-semantics", "default", "", "offline"), "first-file-name" => ok "case life/verify-clean-semantics variant default root first-file-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/verify-clean-semantics", "default", "", "offline"), "files-listed" => ok evidence("files-listed", "true", "true", true, "case life/verify-clean-semantics variant default root files-listed run offline")
        different: false, true, context("life/verify-clean-semantics", "default", "", "offline"), "files-listed" => failed{"files-listed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/verify-clean-semantics", "default", "", "offline"), "file-count" => ok evidence("file-count", "2", "2", true, "case life/verify-clean-semantics variant default root file-count run offline")
        different: 1, 2, context("life/verify-clean-semantics", "default", "", "offline"), "file-count" => failed{"file-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "bin/canlc", "bin/canlc", context("life/verify-clean-semantics", "default", "", "offline"), "first-file-name" => ok evidence("first-file-name", "bin/canlc", "bin/canlc", true, "case life/verify-clean-semantics variant default root first-file-name run offline")
        different: "bin/canlc_2", "bin/canlc", context("life/verify-clean-semantics", "default", "", "offline"), "first-file-name" => failed{"first-file-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
