        seed_bundle_call: context("life/verify-clean-roots", "seed-bundle-call-drift", "", "offline") => failed{"bundle-call"}
        seed_verify_call: context("life/verify-clean-roots", "seed-verify-call-drift", "", "offline") => failed{"verify-call"}
        seed_manifest_name: context("life/verify-clean-roots", "seed-manifest-name-drift", "", "offline") => failed{"manifest-name"}
        seed_hash_call: context("life/verify-clean-roots", "seed-hash-call-drift", "", "offline") => failed{"hash-call"}
        seed_parallel_call: context("life/verify-clean-roots", "seed-parallel-call-drift", "", "offline") => failed{"parallel-call"}
