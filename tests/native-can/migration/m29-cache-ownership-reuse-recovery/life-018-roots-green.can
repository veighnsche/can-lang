                            failed
                            ok evidence first_body_evidence => match call require_text(got.second_body, "runtime", c, "second-body")
                                failed
                                ok evidence second_body_evidence => match call require_text(got.map_shape, "map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"}", c, "map-shape")
