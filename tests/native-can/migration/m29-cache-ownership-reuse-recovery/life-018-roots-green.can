package m29life018roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-018 "Verify clean: roots green".
/// Source: tests/integration/harness_cache_test.go static
/// baseline for TestHarnessVerifyClean (L86-92) plus call
/// shapes (L88-90) and tests/integration/harness_test.go
/// verify baseline (L319-341).
/// Disposition: migrate (this row ports
/// TestHarnessVerifyClean to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static baseline as the green root:
/// the test symbol plus param shape, the two file names plus
/// bodies plus map shape, the entry name, the bundle plus
/// verify plus hash plus parallel plus fatalf spellings, the
/// manifest name, and the verify param.
/// ADAPTATION (recorded, with source lines): first-file pins
/// the bin/canlc inner bytes as str (L88); second-file pins
/// the runtime/bun inner bytes (L88); bodies pin launcher
/// plus runtime inner bytes (L88); map-shape pins the full
/// map literal spelling (L88); entry-name pins entry (L88);
/// bundle-call pins writeFakeBundle (L88); verify-call pins
/// harnessVerify(entry) with parens plus arg (L89);
/// manifest-name pins manifest.json (L320); hash-call pins
/// distribution.Hash(data) with parens plus arg (L336);
/// parallel-call pins t.Parallel() with parens (L87);
/// fatalf-call pins t.Fatalf (L90); verify-param pins entry
/// string (L319).
/// Facet map (static baseline): test-name pins
/// TestHarnessVerifyClean (L86); test-param pins t *testing.T
/// (L86); first-file pins bin/canlc (L88); second-file pins
/// runtime/bun (L88); first-body pins launcher (L88);
/// second-body pins runtime (L88); map-shape pins
/// map[string]string plus both entries (L88); entry-name
/// pins entry (L88); bundle-call pins writeFakeBundle (L88);
/// verify-call pins harnessVerify(entry) (L89);
/// manifest-name pins manifest.json (L320); hash-call pins
/// distribution.Hash(data) (L336); parallel-call pins
/// t.Parallel() (L87); fatalf-call pins t.Fatalf (L90);
/// verify-param pins entry string (L319).
/// The verdict pins live in life-018-cache-semantics.can;
/// the run shape plus diagnostics live in
/// life-018-run-shape.can.
/// Variants: clean/pristine (the single passing path in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/verify-clean-roots checks: test-name,
/// test-param, first-file, second-file, first-body,
/// second-body, map-shape, entry-name, bundle-call,
/// verify-call, manifest-name, hash-call, parallel-call,
/// fatalf-call, verify-param.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str test_param
    str first_file
    str second_file
    str first_body
    str second_body
    str map_shape
    str entry_name
    str bundle_call
    str verify_call
    str manifest_name
    str hash_call
    str parallel_call
    str fatalf_call
    str verify_param
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/verify-clean-roots", "default", "", "offline"), "test-name" => ok "case life/verify-clean-roots variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/verify-clean-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/verify-clean-roots variant default root test-name run offline")
        different: false, true, context("life/verify-clean-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/verify-clean-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "1", "1", true, "case life/verify-clean-roots variant default root test-name run offline")
        different: 2, 1, context("life/verify-clean-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestHarnessVerifyClean", "TestHarnessVerifyClean", context("life/verify-clean-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestHarnessVerifyClean", "TestHarnessVerifyClean", true, "case life/verify-clean-roots variant default root test-name run offline")
        different: "TestHarnessVerifyClean_2", "TestHarnessVerifyClean", context("life/verify-clean-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
