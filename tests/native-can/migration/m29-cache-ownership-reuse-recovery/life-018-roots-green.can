        seed_verify_param: context("life/verify-clean-roots", "seed-verify-param-drift", "", "offline") => failed{"verify-param"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.test_name, "TestHarnessVerifyClean", c, "test-name")
            failed
            ok evidence test_name_evidence => match call require_text(got.test_param, "t *testing.T", c, "test-param")
                failed
                ok evidence test_param_evidence => match call require_text(got.first_file, "bin/canlc", c, "first-file")
                    failed
                    ok evidence first_file_evidence => match call require_text(got.second_file, "runtime/bun", c, "second-file")
