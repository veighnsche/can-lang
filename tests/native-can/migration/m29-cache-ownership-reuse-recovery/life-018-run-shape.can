        seed_manifest_guard: context("life/verify-clean-run", "seed-manifest-guard-drift", "", "offline") => failed{"manifest-guard"}
        seed_range_shape: context("life/verify-clean-run", "seed-range-shape-drift", "", "offline") => failed{"range-shape"}
        seed_read_shape: context("life/verify-clean-run", "seed-read-shape-drift", "", "offline") => failed{"read-shape"}
        seed_hash_guard: context("life/verify-clean-run", "seed-hash-guard-drift", "", "offline") => failed{"hash-guard"}
