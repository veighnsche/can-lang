        seed_return_err_count: context("life/verify-clean-run", "seed-return-err-count-drift", "", "offline") => failed{"return-err-count"}
        seed_refusal_arg_count: context("life/verify-clean-run", "seed-refusal-arg-count-drift", "", "offline") => failed{"refusal-arg-count"}
        seed_parallel_first: context("life/verify-clean-run", "seed-parallel-first-drift", "", "offline") => failed{"parallel-first"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.entry_stmt, "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"})", c, "entry-stmt")
            failed
            ok evidence entry_stmt_evidence => match call require_text(got.verify_stmt, "if err := harnessVerify(entry); err != nil {", c, "verify-stmt")
                failed
                ok evidence verify_stmt_evidence => match call require_text(got.err_guard, "err != nil", c, "err-guard")
                    failed
                    ok evidence err_guard_evidence => match call require_text(got.fatal_clean, "clean entry failed verification: %v", c, "fatal-clean")
                        failed
