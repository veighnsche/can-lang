                            failed
                            ok evidence fatalf_args_evidence => match call require_text(got.manifest_stmt, "raw, err := os.ReadFile(filepath.Join(entry, \"manifest.json\"))", c, "manifest-stmt")
                                failed
                                ok evidence manifest_stmt_evidence => match call require_text(got.unmarshal_shape, "json.Unmarshal(raw, &manifest)", c, "unmarshal-shape")
                                    failed
                                    ok evidence unmarshal_shape_evidence => match call require_text(got.manifest_guard, "manifest.SchemaVersion != 1 || manifest.Kind != \"can.development-distribution\" || len(manifest.Files) == 0", c, "manifest-guard")
                                        failed
                                        ok evidence manifest_guard_evidence => match call require_text(got.range_shape, "for name, want := range manifest.Files {", c, "range-shape")
                                            failed
                                            ok evidence range_shape_evidence => match call require_text(got.read_shape, "data, err := os.ReadFile(filepath.Join(entry, filepath.FromSlash(name)))", c, "read-shape")
                                                failed
                                                ok evidence read_shape_evidence => match call require_text(got.hash_guard, "distribution.Hash(data) != want", c, "hash-guard")
                                                    failed
                                                    ok evidence hash_guard_evidence => match call require_text(got.fatal_cached, "cached bundle file %s failed verification", c, "fatal-cached")
                                                        failed
                                                        ok evidence fatal_cached_evidence => match call require_int(got.return_err_count, 3, c, "return-err-count")
                                                            failed
                                                            ok evidence return_err_count_evidence => match call require_int(got.refusal_arg_count, 1, c, "refusal-arg-count")
                                                                failed
                                                                ok evidence refusal_arg_count_evidence => match call require_bool(got.parallel_first, true, c, "parallel-first")
                                                                    failed
                                                                    ok evidence parallel_first_evidence => ok
