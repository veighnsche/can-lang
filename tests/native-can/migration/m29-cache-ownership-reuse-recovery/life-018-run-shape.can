package m29life018run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-018 "Verify clean: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessVerifyClean (L86-92): parallel gate (L87);
/// entry setup (L88); verify gate (L89); refusal (L90);
/// plus tests/integration/harness_test.go verify legs
/// (L320-340): manifest read (L320); decode (L325);
/// manifest gate (L328); file loop (L331); file read
/// (L332); hash compare (L336); cached refusal (L337).
/// Disposition: migrate (this row ports
/// TestHarnessVerifyClean to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the entry setup
/// shape, the verify gate plus err guard, the clean refusal
/// wording plus arg, the manifest read plus decode shapes,
/// the manifest gate, the loop plus read plus hash-compare
/// shapes, the cached refusal wording, the read-failure plus
/// refusal-arg counts, and the parallel-first order.
/// ADAPTATION (recorded, with source lines): shapes pin the Go
/// statement inner bytes without leading tabs (L88-89,
/// L320, L325, L328, L331-332, L336); err-guard pins
/// err != nil (L89); fatal-clean pins the Fatalf format inner
/// bytes (L90); fatal-cached pins the Errorf format inner
/// bytes (L337); counts pin ints from the read failure sites
/// (L322, L326, L334) and the refusal arg (L90).
/// Facet map (launch plus diagnostics): entry-stmt pins the
/// entry setup (L88); verify-stmt pins the verify gate
/// (L89); err-guard pins err != nil (L89); fatal-clean pins
/// the clean wording (L90); fatalf-args pins err (L90);
/// manifest-stmt pins the manifest read (L320);
/// unmarshal-shape pins the decode call (L325);
/// manifest-guard pins the three gate legs (L328);
/// range-shape pins the file loop (L331); read-shape pins
/// the file read (L332); hash-guard pins the hash compare
/// (L336); fatal-cached pins the cached wording (L337);
/// return-err-count pins 3 (L322, L326, L334);
/// refusal-arg-count pins 1 (L90); parallel-first pins true
/// (L87).
/// The verdict pins live in life-018-cache-semantics.can;
/// the roots-green pin lives in life-018-roots-green.can.
/// Variants: clean/pristine (the single passing path in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/verify-clean-run checks: entry-stmt,
/// verify-stmt, err-guard, fatal-clean, fatalf-args,
/// manifest-stmt, unmarshal-shape, manifest-guard,
/// range-shape, read-shape, hash-guard, fatal-cached,
/// return-err-count, refusal-arg-count, parallel-first.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str entry_stmt
    str verify_stmt
    str err_guard
    str fatal_clean
    str fatalf_args
    str manifest_stmt
    str unmarshal_shape
    str manifest_guard
    str range_shape
    str read_shape
    str hash_guard
    str fatal_cached
    int return_err_count
    int refusal_arg_count
    bool parallel_first
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/verify-clean-run", "default", "", "offline"), "entry-stmt" => ok "case life/verify-clean-run variant default root entry-stmt run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/verify-clean-run", "default", "", "offline"), "parallel-first" => ok evidence("parallel-first", "true", "true", true, "case life/verify-clean-run variant default root parallel-first run offline")
        different: false, true, context("life/verify-clean-run", "default", "", "offline"), "parallel-first" => failed{"parallel-first"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("life/verify-clean-run", "default", "", "offline"), "return-err-count" => ok evidence("return-err-count", "3", "3", true, "case life/verify-clean-run variant default root return-err-count run offline")
        different: 2, 3, context("life/verify-clean-run", "default", "", "offline"), "return-err-count" => failed{"return-err-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"})", "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"})", context("life/verify-clean-run", "default", "", "offline"), "entry-stmt" => ok evidence("entry-stmt", "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"})", "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"})", true, "case life/verify-clean-run variant default root entry-stmt run offline")
        different: "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"})_2", "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\", \"runtime/bun\": \"runtime\"})", context("life/verify-clean-run", "default", "", "offline"), "entry-stmt" => failed{"entry-stmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
