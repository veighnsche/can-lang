package m29life019cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-019 "Contamination verdict: cache semantics".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessVerifyContaminated (L94-105) plus the verify
/// verdict in tests/integration/harness_test.go (L336-337).
/// Disposition: consolidate (this row ports
/// TestHarnessVerifyContaminated to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the manifest-listed file plus its
/// baseline bytes, the post-capture overwrite leg (tamper
/// bytes, mode, join target), the not-equal comparison that
/// detects the drift, the nil-err guard that refuses a
/// passed verify, the verify refusal wording, the
/// detected plus reuse-refused verdicts, the one-listed
/// count, and the one-tamper count.
/// ADAPTATION (recorded, with source lines): tamper-mode pins
/// the 0600 spelling structurally as str (L99); compare-op
/// pins != (H L336) as the comparison logic (no hash
/// re-implementation anywhere); detect-guard pins err == nil
/// (L102); contam-detected pins bool (true) from the
/// protects facet; reuse-refused pins bool (true) from the
/// never-trusted facet; manifest-count pins int (1) from the
/// one listed file (L98); tamper-count pins int (1) from the
/// one overwrite leg (L99).
/// Facet map (Go verdict legs): listed-file pins bin/canlc
/// (L98); baseline-bytes pins launcher (L98); tamper-bytes
/// pins tampered (L99); tamper-mode pins 0600 (L99);
/// tamper-dir pins bin (L99); tamper-leaf pins canlc (L99);
/// tamper-target pins the Join spelling (L99); compare-op
/// pins != (H L336); detect-guard pins err == nil (L102);
/// verify-error pins the failed-verification wording (H
/// L337); contam-detected pins true (protects facet);
/// reuse-refused pins true (never-trusted facet);
/// manifest-count pins 1 (L98); tamper-count pins 1 (L99).
/// The roots-green pin lives in life-019-roots-green.can; the
/// run shape plus diagnostics live in life-019-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is the
/// offline default bound (no Go timeout in this row; binds at
/// P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/contam-semantics checks: listed-file,
/// baseline-bytes, tamper-bytes, tamper-mode, tamper-dir,
/// tamper-leaf, tamper-target, compare-op, detect-guard,
/// verify-error, contam-detected, reuse-refused,
/// manifest-count, tamper-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str listed_file
    str baseline_bytes
    str tamper_bytes
    str tamper_mode
    str tamper_dir
    str tamper_leaf
    str tamper_target
    str compare_op
    str detect_guard
    str verify_error
    bool contam_detected
    bool reuse_refused
    int manifest_count
    int tamper_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/contam-semantics", "default", "", "offline"), "listed-file" => ok "case life/contam-semantics variant default root listed-file run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/contam-semantics", "default", "", "offline"), "listed-file" => ok evidence("listed-file", "true", "true", true, "case life/contam-semantics variant default root listed-file run offline")
        different: false, true, context("life/contam-semantics", "default", "", "offline"), "listed-file" => failed{"listed-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/contam-semantics", "default", "", "offline"), "manifest-count" => ok evidence("manifest-count", "1", "1", true, "case life/contam-semantics variant default root manifest-count run offline")
        different: 0, 1, context("life/contam-semantics", "default", "", "offline"), "manifest-count" => failed{"manifest-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "bin/canlc", "bin/canlc", context("life/contam-semantics", "default", "", "offline"), "listed-file" => ok evidence("listed-file", "bin/canlc", "bin/canlc", true, "case life/contam-semantics variant default root listed-file run offline")
        different: "bin/canlc_2", "bin/canlc", context("life/contam-semantics", "default", "", "offline"), "listed-file" => failed{"listed-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
