fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_l019: "m29-l019" => ok [check("listed-file", "mutated leg pins the listed file"), check("baseline-bytes", "manifest pins the baseline bytes"), check("tamper-bytes", "overwrite pins the tamper bytes"), check("tamper-mode", "overwrite lands owner-only"), check("tamper-dir", "overwrite pins the bin leg"), check("tamper-leaf", "overwrite pins the leaf name"), check("tamper-target", "overwrite pins the join target"), check("compare-op", "verify pins the not-equal spelling"), check("detect-guard", "clean verify refuses as passed"), check("verify-error", "verify refusal wording is pinned"), check("contam-detected", "mutated file is detected"), check("reuse-refused", "mutated entry refuses reuse"), check("manifest-count", "exactly one listed file runs"), check("tamper-count", "exactly one overwrite leg runs")]
        other: "nope" => ok []
    match scope is "m29-l019"
        false => ok []
        true => ok [check("listed-file", "mutated leg pins the listed file"), check("baseline-bytes", "manifest pins the baseline bytes"), check("tamper-bytes", "overwrite pins the tamper bytes"), check("tamper-mode", "overwrite lands owner-only"), check("tamper-dir", "overwrite pins the bin leg"), check("tamper-leaf", "overwrite pins the leaf name"), check("tamper-target", "overwrite pins the join target"), check("compare-op", "verify pins the not-equal spelling"), check("detect-guard", "clean verify refuses as passed"), check("verify-error", "verify refusal wording is pinned"), check("contam-detected", "mutated file is detected"), check("reuse-refused", "mutated entry refuses reuse"), check("manifest-count", "exactly one listed file runs"), check("tamper-count", "exactly one overwrite leg runs")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "life/contam-semantics" => ok [expected_check("listed-file", "bin/canlc"), expected_check("baseline-bytes", "launcher"), expected_check("tamper-bytes", "tampered"), expected_check("tamper-mode", "0600"), expected_check("tamper-dir", "bin"), expected_check("tamper-leaf", "canlc"), expected_check("tamper-target", "filepath.Join(entry, \"bin\", \"canlc\")"), expected_check("compare-op", "!="), expected_check("detect-guard", "err == nil"), expected_check("verify-error", "cached bundle file %s failed verification"), expected_check("contam-detected", "true"), expected_check("reuse-refused", "true"), expected_check("manifest-count", "1"), expected_check("tamper-count", "1")]
        unknown: "nope" => ok []
    match case is "life/contam-semantics"
        false => ok []
        true => ok [expected_check("listed-file", "bin/canlc"), expected_check("baseline-bytes", "launcher"), expected_check("tamper-bytes", "tampered"), expected_check("tamper-mode", "0600"), expected_check("tamper-dir", "bin"), expected_check("tamper-leaf", "canlc"), expected_check("tamper-target", "filepath.Join(entry, \"bin\", \"canlc\")"), expected_check("compare-op", "!="), expected_check("detect-guard", "err == nil"), expected_check("verify-error", "cached bundle file %s failed verification"), expected_check("contam-detected", "true"), expected_check("reuse-refused", "true"), expected_check("manifest-count", "1"), expected_check("tamper-count", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/contam-semantics", "default", "", "offline") => ok
        seed_listed_file: context("life/contam-semantics", "seed-listed-file-drift", "", "offline") => failed{"listed-file"}
        seed_baseline_bytes: context("life/contam-semantics", "seed-baseline-bytes-drift", "", "offline") => failed{"baseline-bytes"}
        seed_tamper_bytes: context("life/contam-semantics", "seed-tamper-bytes-drift", "", "offline") => failed{"tamper-bytes"}
        seed_tamper_mode: context("life/contam-semantics", "seed-tamper-mode-drift", "", "offline") => failed{"tamper-mode"}
        seed_tamper_dir: context("life/contam-semantics", "seed-tamper-dir-drift", "", "offline") => failed{"tamper-dir"}
        seed_tamper_leaf: context("life/contam-semantics", "seed-tamper-leaf-drift", "", "offline") => failed{"tamper-leaf"}
        seed_tamper_target: context("life/contam-semantics", "seed-tamper-target-drift", "", "offline") => failed{"tamper-target"}
        seed_compare_op: context("life/contam-semantics", "seed-compare-op-drift", "", "offline") => failed{"compare-op"}
        seed_detect_guard: context("life/contam-semantics", "seed-detect-guard-drift", "", "offline") => failed{"detect-guard"}
        seed_verify_error: context("life/contam-semantics", "seed-verify-error-drift", "", "offline") => failed{"verify-error"}
        seed_contam_detected: context("life/contam-semantics", "seed-contam-detected-drift", "", "offline") => failed{"contam-detected"}
        seed_reuse_refused: context("life/contam-semantics", "seed-reuse-refused-drift", "", "offline") => failed{"reuse-refused"}
        seed_manifest_count: context("life/contam-semantics", "seed-manifest-count-drift", "", "offline") => failed{"manifest-count"}
        seed_tamper_count: context("life/contam-semantics", "seed-tamper-count-drift", "", "offline") => failed{"tamper-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.listed_file, "bin/canlc", c, "listed-file")
            failed
            ok evidence listed_file_evidence => match call require_text(got.baseline_bytes, "launcher", c, "baseline-bytes")
                failed
                ok evidence baseline_bytes_evidence => match call require_text(got.tamper_bytes, "tampered", c, "tamper-bytes")
                    failed
                    ok evidence tamper_bytes_evidence => match call require_text(got.tamper_mode, "0600", c, "tamper-mode")
                        failed
                        ok evidence tamper_mode_evidence => match call require_text(got.tamper_dir, "bin", c, "tamper-dir")
                            failed
                            ok evidence tamper_dir_evidence => match call require_text(got.tamper_leaf, "canlc", c, "tamper-leaf")
                                failed
                                ok evidence tamper_leaf_evidence => match call require_text(got.tamper_target, "filepath.Join(entry, \"bin\", \"canlc\")", c, "tamper-target")
                                    failed
                                    ok evidence tamper_target_evidence => match call require_text(got.compare_op, "!=", c, "compare-op")
                                        failed
                                        ok evidence compare_op_evidence => match call require_text(got.detect_guard, "err == nil", c, "detect-guard")
                                            failed
                                            ok evidence detect_guard_evidence => match call require_text(got.verify_error, "cached bundle file %s failed verification", c, "verify-error")
                                                failed
                                                ok evidence verify_error_evidence => match call require_bool(got.contam_detected, true, c, "contam-detected")
                                                    failed
                                                    ok evidence contam_detected_evidence => match call require_bool(got.reuse_refused, true, c, "reuse-refused")
                                                        failed
                                                        ok evidence reuse_refused_evidence => match call require_int(got.manifest_count, 1, c, "manifest-count")
                                                            failed
                                                            ok evidence manifest_count_evidence => match call require_int(got.tamper_count, 1, c, "tamper-count")
                                                                failed
                                                                ok evidence tamper_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_l019: "m29-l019" => ok test_case("life/contam-semantics", ["life", "m29"], [], 120000, [check_ref("listed-file"), check_ref("baseline-bytes"), check_ref("tamper-bytes"), check_ref("tamper-mode"), check_ref("tamper-dir"), check_ref("tamper-leaf"), check_ref("tamper-target"), check_ref("compare-op"), check_ref("detect-guard"), check_ref("verify-error"), check_ref("contam-detected"), check_ref("reuse-refused"), check_ref("manifest-count"), check_ref("tamper-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-l019"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/contam-semantics", ["life", "m29"], [], 120000, [check_ref("listed-file"), check_ref("baseline-bytes"), check_ref("tamper-bytes"), check_ref("tamper-mode"), check_ref("tamper-dir"), check_ref("tamper-leaf"), check_ref("tamper-target"), check_ref("compare-op"), check_ref("detect-guard"), check_ref("verify-error"), check_ref("contam-detected"), check_ref("reuse-refused"), check_ref("manifest-count"), check_ref("tamper-count")], callable case_body)
