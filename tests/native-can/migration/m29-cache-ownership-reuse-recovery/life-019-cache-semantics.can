        seed_reuse_refused: "seed-reuse-refused-drift" => ok observation("bin/canlc", "launcher", "tampered", "0600", "bin", "canlc", "filepath.Join(entry, \"bin\", \"canlc\")", "!=", "err == nil", "cached bundle file %s failed verification", true, false, 1, 1)
