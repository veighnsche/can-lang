        seed_listed_file: "seed-listed-file-drift" => ok observation("bin/canlc_2", "launcher", "tampered", "0600", "bin", "canlc", "filepath.Join(entry, \"bin\", \"canlc\")", "!=", "err == nil", "cached bundle file %s failed verification", true, true, 1, 1)
        seed_baseline_bytes: "seed-baseline-bytes-drift" => ok observation("bin/canlc", "launcher_2", "tampered", "0600", "bin", "canlc", "filepath.Join(entry, \"bin\", \"canlc\")", "!=", "err == nil", "cached bundle file %s failed verification", true, true, 1, 1)
