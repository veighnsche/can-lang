        seed_tamper_leaf: "seed-tamper-leaf-drift" => ok observation("bin/canlc", "launcher", "tampered", "0600", "bin", "canlc_2", "filepath.Join(entry, \"bin\", \"canlc\")", "!=", "err == nil", "cached bundle file %s failed verification", true, true, 1, 1)
        seed_tamper_target: "seed-tamper-target-drift" => ok observation("bin/canlc", "launcher", "tampered", "0600", "bin", "canlc", "filepath.Join(entry, \"bin\", \"canlc\")_2", "!=", "err == nil", "cached bundle file %s failed verification", true, true, 1, 1)
