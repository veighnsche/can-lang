package m29life019roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-019 "Contamination verdict: roots green".
/// Source: tests/integration/harness_cache_test.go helper
/// writeFakeBundle (L55-83).
/// Disposition: consolidate (this row ports
/// TestHarnessVerifyContaminated to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the pristine entry baseline as the
/// green root: the helper name plus files param, the Helper
/// plus TempDir calls, the manifest local plus its five
/// literal fields, the shared version name, the file loop
/// plus Join/FromSlash path assembly, the MkdirAll plus
/// WriteFile legs with modes, the hash capture line, the
/// Marshal call plus manifest.json name, and the
/// schema/field/write/err-guard counts.
/// ADAPTATION (recorded, with source lines): mkdir-mode pins
/// the 0700 spelling structurally as str (L67); write-mode
/// pins the 0600 spelling structurally as str (L70/L79);
/// schema-version pins int (1) from the literal (L59);
/// field-count pins int (5) from the literal fields
/// (L59-63); helper-write-count pins int (2) from the write
/// legs (L70/L79); helper-err-count pins int (4) from the
/// err guards (L67/L70/L76/L79); all call pins pin
/// spellings only (no hash re-implementation anywhere).
/// Facet map (static baseline): helper-name pins
/// writeFakeBundle (L55); files-param pins the files param
/// (L55); helper-call pins t.Helper() (L56); tempdir-call
/// pins t.TempDir() (L57); manifest-name pins manifest
/// (L58); schema-field pins SchemaVersion (L59); kind-field
/// pins Kind (L60); kind-value pins the kind value (L60);
/// version-field pins Version (L61); version-name pins
/// harnessSharedVersion (L61); target-field pins TargetID
/// (L62); target-value pins test (L62); files-field pins
/// Files (L63); loop-shape pins the range loop (L65);
/// join-call pins filepath.Join (L66); fromslash-call pins
/// filepath.FromSlash (L66); mkdir-call pins os.MkdirAll
/// (L67); mkdir-mode pins 0700 (L67); write-call pins
/// os.WriteFile (L70); bytes-call pins []byte (L70);
/// hash-call pins distribution.Hash (L73); capture-line pins
/// the hash capture line (L73); marshal-call pins
/// json.Marshal (L75); manifest-file pins manifest.json
/// (L79); write-mode pins 0600 (L70/L79); schema-version
/// pins 1 (L59); field-count pins 5 (L59-63);
/// helper-write-count pins 2 (L70/L79); helper-err-count
/// pins 4 (L67/L70/L76/L79).
/// The verdict pins live in life-019-cache-semantics.can; the
/// run shape plus diagnostics live in life-019-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is the
/// offline default bound (no Go timeout in this row; binds at
/// P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/contam-roots checks: helper-name, files-param,
/// helper-call, tempdir-call, manifest-name, schema-field,
/// kind-field, kind-value, version-field, version-name,
/// target-field, target-value, files-field, loop-shape,
/// join-call, fromslash-call, mkdir-call, mkdir-mode,
/// write-call, bytes-call, hash-call, capture-line,
/// marshal-call, manifest-file, write-mode, schema-version,
/// field-count, helper-write-count, helper-err-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str helper_name
    str files_param
    str helper_call
    str tempdir_call
    str manifest_name
    str schema_field
    str kind_field
    str kind_value
    str version_field
    str version_name
    str target_field
    str target_value
    str files_field
    str loop_shape
    str join_call
    str fromslash_call
    str mkdir_call
    str mkdir_mode
    str write_call
    str bytes_call
    str hash_call
    str capture_line
    str marshal_call
    str manifest_file
    str write_mode
    int schema_version
    int field_count
    int helper_write_count
    int helper_err_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/contam-roots", "default", "", "offline"), "helper-name" => ok "case life/contam-roots variant default root helper-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/contam-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "true", "true", true, "case life/contam-roots variant default root helper-name run offline")
        different: false, true, context("life/contam-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/contam-roots", "default", "", "offline"), "schema-version" => ok evidence("schema-version", "1", "1", true, "case life/contam-roots variant default root schema-version run offline")
        different: 0, 1, context("life/contam-roots", "default", "", "offline"), "schema-version" => failed{"schema-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "writeFakeBundle", "writeFakeBundle", context("life/contam-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "writeFakeBundle", "writeFakeBundle", true, "case life/contam-roots variant default root helper-name run offline")
        different: "writeFakeBundle_2", "writeFakeBundle", context("life/contam-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
