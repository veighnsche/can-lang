    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/contam-run", "default", "", "offline"), "write-count" => ok evidence("write-count", "1", "1", true, "case life/contam-run variant default root write-count run offline")
        different: 0, 1, context("life/contam-run", "default", "", "offline"), "write-count" => failed{"write-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
