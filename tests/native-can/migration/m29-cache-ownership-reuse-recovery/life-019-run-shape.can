                                        failed
                                        ok evidence fatal_err_evidence => match call require_text(got.verify_line, "if err := harnessVerify(entry); err == nil {", c, "verify-line")
                                            failed
                                            ok evidence verify_line_evidence => match call require_text(got.fatal_contam, "contaminated entry passed verification", c, "fatal-contam")
                                                failed
                                                ok evidence fatal_contam_evidence => match call require_int(got.write_count, 1, c, "write-count")
                                                    failed
                                                    ok evidence write_count_evidence => match call require_int(got.verify_count, 1, c, "verify-count")
                                                        failed
                                                        ok evidence verify_count_evidence => ok
