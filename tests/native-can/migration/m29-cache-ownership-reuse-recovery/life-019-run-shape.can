    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-019 "Contamination verdict: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessVerifyContaminated (L94-105): comment pair
/// (L94-95); parallel gate (L97); bundle line (L98); tamper
/// write (L99-101); verify check (L102-104).
/// Disposition: consolidate (this row ports
/// TestHarnessVerifyContaminated to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the live run shape: the test name,
/// the Parallel gate, the entry local plus full bundle
/// line plus map shape, the full tamper write line, the
/// err guard plus Fatal err refusal, the full verify check
/// line, the passed-verification refusal, and the
/// write/verify-call counts.
/// ADAPTATION (recorded, with source lines): parallel-call
/// pins t.Parallel() with parens (L97); bundle-line pins
/// the full L98 spelling; tamper-line pins the full L99
/// spelling; err-guard pins err != nil (L99); fatal-err pins
/// t.Fatal(err) (L100); verify-line pins the full L102
/// spelling; write-count pins int (1) from the one tamper
/// write (L99); verify-count pins int (1) from the one
/// verify call (L102).
/// Facet map (launch plus diagnostics): test-name pins
/// TestHarnessVerifyContaminated (L96); parallel-call pins
/// t.Parallel() (L97); entry-name pins entry (L98);
/// bundle-line pins the full bundle line (L98); map-shape
/// pins map[string]string (L98); tamper-line pins the full
/// tamper line (L99); err-guard pins err != nil (L99);
/// fatal-err pins t.Fatal(err) (L100); verify-line pins the
/// full verify line (L102); fatal-contam pins the passed
/// refusal (L103); write-count pins 1 (L99); verify-count
/// pins 1 (L102).
/// The verdict pins live in life-019-cache-semantics.can; the
/// roots-green pin lives in life-019-roots-green.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no live
/// run now. Accept gate P23 is unmet. Timeout 120000ms is the
/// offline default bound (no Go timeout in this row; binds at
/// P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/contam-run checks: test-name, parallel-call,
/// entry-name, bundle-line, map-shape, tamper-line,
/// err-guard, fatal-err, verify-line, fatal-contam,
/// write-count, verify-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str parallel_call
    str entry_name
    str bundle_line
    str map_shape
    str tamper_line
    str err_guard
    str fatal_err
    str verify_line
    str fatal_contam
    int write_count
    int verify_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/contam-run", "default", "", "offline"), "test-name" => ok "case life/contam-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/contam-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/contam-run variant default root test-name run offline")
        different: false, true, context("life/contam-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
