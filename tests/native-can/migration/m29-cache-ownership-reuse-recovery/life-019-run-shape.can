        seed_write_count: context("life/contam-run", "seed-write-count-drift", "", "offline") => failed{"write-count"}
        seed_verify_count: context("life/contam-run", "seed-verify-count-drift", "", "offline") => failed{"verify-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.test_name, "TestHarnessVerifyContaminated", c, "test-name")
            failed
            ok evidence test_name_evidence => match call require_text(got.parallel_call, "t.Parallel()", c, "parallel-call")
                failed
                ok evidence parallel_call_evidence => match call require_text(got.entry_name, "entry", c, "entry-name")
                    failed
                    ok evidence entry_name_evidence => match call require_text(got.bundle_line, "entry := writeFakeBundle(t, map[string]string{\"bin/canlc\": \"launcher\"})", c, "bundle-line")
                        failed
                        ok evidence bundle_line_evidence => match call require_text(got.map_shape, "map[string]string", c, "map-shape")
