fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_l020: "m29-l020" => ok [check("helper-name", "helper is named harnessEntryComplete"), check("entry-param", "entry input is named entry"), check("key-param", "key input is named key"), check("return-type", "helper returns bool"), check("raw-name", "read bytes are named raw"), check("read-call", "marker loads with ReadFile"), check("join-call", "marker joins with filepath Join"), check("marker-name", "helper pins the marker name"), check("err-guard", "missing marker faces the err guard"), check("missing-returns", "missing marker returns false"), check("trim-call", "compare pins the TrimSpace call"), check("string-call", "compare pins the string cast"), check("compare-op", "compare pins the equality spelling"), check("compare-rhs", "compare pins key on the right"), check("writer-bytes", "writer pins the key plus newline bytes"), check("writer-mode", "writer pins the 0644 mode"), check("param-count", "helper takes two params"), check("call-site-count", "eight call sites pin the helper")]
        other: "nope" => ok []
    match scope is "m29-l020"
        false => ok []
        true => ok [check("helper-name", "helper is named harnessEntryComplete"), check("entry-param", "entry input is named entry"), check("key-param", "key input is named key"), check("return-type", "helper returns bool"), check("raw-name", "read bytes are named raw"), check("read-call", "marker loads with ReadFile"), check("join-call", "marker joins with filepath Join"), check("marker-name", "helper pins the marker name"), check("err-guard", "missing marker faces the err guard"), check("missing-returns", "missing marker returns false"), check("trim-call", "compare pins the TrimSpace call"), check("string-call", "compare pins the string cast"), check("compare-op", "compare pins the equality spelling"), check("compare-rhs", "compare pins key on the right"), check("writer-bytes", "writer pins the key plus newline bytes"), check("writer-mode", "writer pins the 0644 mode"), check("param-count", "helper takes two params"), check("call-site-count", "eight call sites pin the helper")]
