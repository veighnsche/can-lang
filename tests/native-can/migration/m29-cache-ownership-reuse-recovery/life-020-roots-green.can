package m29life020roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-020 "Entry complete: roots green".
/// Source: tests/integration/harness_test.go helper
/// harnessEntryComplete (L307-314) plus the marker write
/// (L297).
/// Disposition: consolidate (this row ports
/// TestHarnessEntryComplete to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the static completion baseline as
/// the green root: the helper name plus entry/key params,
/// the bool return, the raw read plus Join marker path, the
/// cache-complete pin, the err guard plus false return, the
/// TrimSpace plus string-cast plus equality compare, the key
/// right side, the writer bytes plus 0644 mode, and the
/// param/call-site counts.
/// ADAPTATION (recorded, with source lines):
/// missing-returns pins the full return-false spelling
/// (L311); string-call pins string(raw) with parens (L313);
/// compare-op pins == (L313) as the comparison logic (no
/// hash re-implementation anywhere); writer-bytes pins the
/// key plus newline inner bytes (L297); writer-mode pins
/// the 0644 spelling structurally as str (L297); param-count
/// pins int (2) from the params (L308); call-site-count pins
/// int (8) from the five helper-internal calls (H
/// L119/L228/L237/L257/L262) plus the three test legs
/// (L110/L116/L122); all call pins pin spellings only (no
/// hash re-implementation anywhere).
/// Facet map (static baseline): helper-name pins
/// harnessEntryComplete (L308); entry-param pins entry
/// (L308); key-param pins key (L308); return-type pins bool
/// (L308); raw-name pins raw (L309); read-call pins
/// os.ReadFile (L309); join-call pins filepath.Join (L309);
/// marker-name pins cache-complete (L309); err-guard pins
/// err != nil (L310); missing-returns pins return false
/// (L311); trim-call pins strings.TrimSpace (L313);
/// string-call pins string(raw) (L313); compare-op pins ==
/// (L313); compare-rhs pins key (L313); writer-bytes pins
/// key plus newline (L297); writer-mode pins 0644 (L297);
/// param-count pins 2 (L308); call-site-count pins 8 (H
/// L119/L228/L237/L257/L262 plus L110/L116/L122).
/// The verdict pins live in life-020-cache-semantics.can;
/// the run shape plus diagnostics live in
/// life-020-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 120000ms
/// is the offline default bound (no Go timeout in this row;
/// binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/entry-roots checks: helper-name, entry-param,
/// key-param, return-type, raw-name, read-call, join-call,
/// marker-name, err-guard, missing-returns, trim-call,
/// string-call, compare-op, compare-rhs, writer-bytes,
/// writer-mode, param-count, call-site-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str helper_name
    str entry_param
    str key_param
    str return_type
    str raw_name
    str read_call
    str join_call
    str marker_name
    str err_guard
    str missing_returns
    str trim_call
    str string_call
    str compare_op
    str compare_rhs
    str writer_bytes
    str writer_mode
    int param_count
    int call_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/entry-roots", "default", "", "offline"), "helper-name" => ok "case life/entry-roots variant default root helper-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/entry-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "true", "true", true, "case life/entry-roots variant default root helper-name run offline")
        different: false, true, context("life/entry-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/entry-roots", "default", "", "offline"), "param-count" => ok evidence("param-count", "2", "2", true, "case life/entry-roots variant default root param-count run offline")
        different: 1, 2, context("life/entry-roots", "default", "", "offline"), "param-count" => failed{"param-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "harnessEntryComplete", "harnessEntryComplete", context("life/entry-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "harnessEntryComplete", "harnessEntryComplete", true, "case life/entry-roots variant default root helper-name run offline")
        different: "harnessEntryComplete_2", "harnessEntryComplete", context("life/entry-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
