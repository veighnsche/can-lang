fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/entry-roots", "default", "", "offline") => ok
        seed_helper_name: context("life/entry-roots", "seed-helper-name-drift", "", "offline") => failed{"helper-name"}
        seed_entry_param: context("life/entry-roots", "seed-entry-param-drift", "", "offline") => failed{"entry-param"}
        seed_key_param: context("life/entry-roots", "seed-key-param-drift", "", "offline") => failed{"key-param"}
        seed_return_type: context("life/entry-roots", "seed-return-type-drift", "", "offline") => failed{"return-type"}
        seed_raw_name: context("life/entry-roots", "seed-raw-name-drift", "", "offline") => failed{"raw-name"}
        seed_read_call: context("life/entry-roots", "seed-read-call-drift", "", "offline") => failed{"read-call"}
        seed_join_call: context("life/entry-roots", "seed-join-call-drift", "", "offline") => failed{"join-call"}
        seed_marker_name: context("life/entry-roots", "seed-marker-name-drift", "", "offline") => failed{"marker-name"}
        seed_err_guard: context("life/entry-roots", "seed-err-guard-drift", "", "offline") => failed{"err-guard"}
        seed_missing_returns: context("life/entry-roots", "seed-missing-returns-drift", "", "offline") => failed{"missing-returns"}
        seed_trim_call: context("life/entry-roots", "seed-trim-call-drift", "", "offline") => failed{"trim-call"}
        seed_string_call: context("life/entry-roots", "seed-string-call-drift", "", "offline") => failed{"string-call"}
        seed_compare_op: context("life/entry-roots", "seed-compare-op-drift", "", "offline") => failed{"compare-op"}
        seed_compare_rhs: context("life/entry-roots", "seed-compare-rhs-drift", "", "offline") => failed{"compare-rhs"}
        seed_writer_bytes: context("life/entry-roots", "seed-writer-bytes-drift", "", "offline") => failed{"writer-bytes"}
        seed_writer_mode: context("life/entry-roots", "seed-writer-mode-drift", "", "offline") => failed{"writer-mode"}
        seed_param_count: context("life/entry-roots", "seed-param-count-drift", "", "offline") => failed{"param-count"}
        seed_call_site_count: context("life/entry-roots", "seed-call-site-count-drift", "", "offline") => failed{"call-site-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.helper_name, "harnessEntryComplete", c, "helper-name")
            failed
            ok evidence helper_name_evidence => match call require_text(got.entry_param, "entry", c, "entry-param")
                failed
                ok evidence entry_param_evidence => match call require_text(got.key_param, "key", c, "key-param")
                    failed
                    ok evidence key_param_evidence => match call require_text(got.return_type, "bool", c, "return-type")
                        failed
                        ok evidence return_type_evidence => match call require_text(got.raw_name, "raw", c, "raw-name")
                            failed
                            ok evidence raw_name_evidence => match call require_text(got.read_call, "os.ReadFile", c, "read-call")
                                failed
                                ok evidence read_call_evidence => match call require_text(got.join_call, "filepath.Join", c, "join-call")
                                    failed
                                    ok evidence join_call_evidence => match call require_text(got.marker_name, "cache-complete", c, "marker-name")
                                        failed
                                        ok evidence marker_name_evidence => match call require_text(got.err_guard, "err != nil", c, "err-guard")
                                            failed
                                            ok evidence err_guard_evidence => match call require_text(got.missing_returns, "return false", c, "missing-returns")
                                                failed
                                                ok evidence missing_returns_evidence => match call require_text(got.trim_call, "strings.TrimSpace", c, "trim-call")
                                                    failed
                                                    ok evidence trim_call_evidence => match call require_text(got.string_call, "string(raw)", c, "string-call")
                                                        failed
