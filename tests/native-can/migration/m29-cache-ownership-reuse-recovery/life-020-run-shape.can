/// M29 LIFE-020 "Entry complete: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessEntryComplete (L107-125): parallel gate
/// (L108); entry setup (L109); missing probe (L110-112);
/// foreign write plus probe (L113-118); matching write plus
/// probe (L119-124).
/// Disposition: consolidate (this row ports
/// TestHarnessEntryComplete to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the live run shape: the test name,
/// the Parallel gate, the TempDir entry setup, the full
/// missing probe call, the Join plus WriteFile plus []byte
/// legs, the wrong and correct marker bytes, the negation on
/// the matching probe, the three Fatal wordings, the shared
/// err guard plus Fatal err refusal, and the
/// complete-call/write counts.
/// ADAPTATION (recorded, with source lines): parallel-call
/// pins t.Parallel() with parens (L108); tempdir-call pins
/// t.TempDir() with parens (L109); missing-call pins the
/// full harnessEntryComplete(entry, "k") spelling (L110);
/// wrong-bytes pins other plus newline (L113);
/// correct-bytes pins k plus newline (L119); neg-op pins !
/// (L122) as the negation on the matching probe;
/// fatal-missing pins the missing inner bytes (L111);
/// fatal-foreign pins the foreign inner bytes (L117);
/// fatal-matching pins the matching inner bytes (L123);
/// err-guard pins the full err != nil spelling shared by two
/// sites (L113/L119); fatal-err pins the t.Fatal(err) call
/// shared by two sites (L114/L120); complete-call-count pins
/// int (3) from the three probes (L110/L116/L122);
/// write-count pins int (2) from the two writes (L113/L119).
/// Facet map (launch plus diagnostics): test-name pins
/// TestHarnessEntryComplete (L107); parallel-call pins
/// t.Parallel() (L108); entry-name pins entry (L109);
/// tempdir-call pins t.TempDir() (L109); missing-call pins
/// harnessEntryComplete(entry, "k") (L110); fatal-missing
/// pins missing marker reports complete (L111); join-call
/// pins filepath.Join (L113); write-call pins os.WriteFile
/// (L113); bytes-call pins []byte (L113); wrong-bytes pins
/// other plus newline (L113); fatal-foreign pins foreign
/// marker reports complete (L117); correct-bytes pins k
/// plus newline (L119); neg-op pins ! (L122);
/// fatal-matching pins matching marker reports incomplete
/// (L123); err-guard pins err != nil (L113); fatal-err pins
/// t.Fatal(err) (L114); complete-call-count pins 3
/// (L110/L116/L122); write-count pins 2 (L113/L119).
/// The verdict pins live in life-020-cache-semantics.can;
/// the roots-green pin lives in life-020-roots-green.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 120000ms
/// is the offline default bound (no Go timeout in this row;
/// binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/entry-run checks: test-name, parallel-call,
/// entry-name, tempdir-call, missing-call, fatal-missing,
/// join-call, write-call, bytes-call, wrong-bytes,
/// fatal-foreign, correct-bytes, neg-op, fatal-matching,
/// err-guard, fatal-err, complete-call-count, write-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str parallel_call
    str entry_name
    str tempdir_call
    str missing_call
    str fatal_missing
    str join_call
    str write_call
    str bytes_call
    str wrong_bytes
    str fatal_foreign
    str correct_bytes
    str neg_op
    str fatal_matching
    str err_guard
    str fatal_err
    int complete_call_count
    int write_count
error failed{str check}
