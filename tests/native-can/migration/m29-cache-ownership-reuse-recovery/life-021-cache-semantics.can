fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_l021: "m29-l021" => ok [check("helper-name", "acquire helper is named acquireFrom"), check("blocked-wording", "cap-2 refusal wording is pinned"), check("waiter-wording", "unpark refusal wording is pinned"), check("block-timeout", "block probe pins the 100ms leg"), check("waiter-timeout", "admit probe pins the 5s leg"), check("slot-capacity", "slot cap pins two buffered slots"), check("acquire-count", "two acquires fill the cap"), check("waiter-count", "one waiter parks past the cap"), check("select-count", "two select gates probe the waiter"), check("fatal-count", "two refusals guard the probes"), check("third-blocked", "third send stays parked at cap"), check("release-admits", "release unparks the waiter"), check("proceed-closed", "waiter closes proceeded on send"), check("waiting-closed", "waiter closes waiting on launch"), check("drain-armed", "cleanups drain sends at test end")]
        other: "nope" => ok []
    match scope is "m29-l021"
        false => ok []
        true => ok [check("helper-name", "acquire helper is named acquireFrom"), check("blocked-wording", "cap-2 refusal wording is pinned"), check("waiter-wording", "unpark refusal wording is pinned"), check("block-timeout", "block probe pins the 100ms leg"), check("waiter-timeout", "admit probe pins the 5s leg"), check("slot-capacity", "slot cap pins two buffered slots"), check("acquire-count", "two acquires fill the cap"), check("waiter-count", "one waiter parks past the cap"), check("select-count", "two select gates probe the waiter"), check("fatal-count", "two refusals guard the probes"), check("third-blocked", "third send stays parked at cap"), check("release-admits", "release unparks the waiter"), check("proceed-closed", "waiter closes proceeded on send"), check("waiting-closed", "waiter closes waiting on launch"), check("drain-armed", "cleanups drain sends at test end")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "life/heavy-slots-semantics" => ok [expected_check("helper-name", "acquireFrom"), expected_check("blocked-wording", "third acquisition proceeded past a cap-2 semaphore"), expected_check("waiter-wording", "release did not unpark the waiter"), expected_check("block-timeout", "100 * time.Millisecond"), expected_check("waiter-timeout", "5 * time.Second"), expected_check("slot-capacity", "2"), expected_check("acquire-count", "2"), expected_check("waiter-count", "1"), expected_check("select-count", "2"), expected_check("fatal-count", "2"), expected_check("third-blocked", "true"), expected_check("release-admits", "true"), expected_check("proceed-closed", "true"), expected_check("waiting-closed", "true"), expected_check("drain-armed", "true")]
        unknown: "nope" => ok []
    match case is "life/heavy-slots-semantics"
        false => ok []
        true => ok [expected_check("helper-name", "acquireFrom"), expected_check("blocked-wording", "third acquisition proceeded past a cap-2 semaphore"), expected_check("waiter-wording", "release did not unpark the waiter"), expected_check("block-timeout", "100 * time.Millisecond"), expected_check("waiter-timeout", "5 * time.Second"), expected_check("slot-capacity", "2"), expected_check("acquire-count", "2"), expected_check("waiter-count", "1"), expected_check("select-count", "2"), expected_check("fatal-count", "2"), expected_check("third-blocked", "true"), expected_check("release-admits", "true"), expected_check("proceed-closed", "true"), expected_check("waiting-closed", "true"), expected_check("drain-armed", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/heavy-slots-semantics", "default", "", "offline") => ok
        seed_helper_name: context("life/heavy-slots-semantics", "seed-helper-name-drift", "", "offline") => failed{"helper-name"}
        seed_blocked_wording: context("life/heavy-slots-semantics", "seed-blocked-wording-drift", "", "offline") => failed{"blocked-wording"}
        seed_waiter_wording: context("life/heavy-slots-semantics", "seed-waiter-wording-drift", "", "offline") => failed{"waiter-wording"}
        seed_block_timeout: context("life/heavy-slots-semantics", "seed-block-timeout-drift", "", "offline") => failed{"block-timeout"}
        seed_waiter_timeout: context("life/heavy-slots-semantics", "seed-waiter-timeout-drift", "", "offline") => failed{"waiter-timeout"}
        seed_slot_capacity: context("life/heavy-slots-semantics", "seed-slot-capacity-drift", "", "offline") => failed{"slot-capacity"}
        seed_acquire_count: context("life/heavy-slots-semantics", "seed-acquire-count-drift", "", "offline") => failed{"acquire-count"}
        seed_waiter_count: context("life/heavy-slots-semantics", "seed-waiter-count-drift", "", "offline") => failed{"waiter-count"}
        seed_select_count: context("life/heavy-slots-semantics", "seed-select-count-drift", "", "offline") => failed{"select-count"}
        seed_fatal_count: context("life/heavy-slots-semantics", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
        seed_third_blocked: context("life/heavy-slots-semantics", "seed-third-blocked-drift", "", "offline") => failed{"third-blocked"}
        seed_release_admits: context("life/heavy-slots-semantics", "seed-release-admits-drift", "", "offline") => failed{"release-admits"}
        seed_proceed_closed: context("life/heavy-slots-semantics", "seed-proceed-closed-drift", "", "offline") => failed{"proceed-closed"}
        seed_waiting_closed: context("life/heavy-slots-semantics", "seed-waiting-closed-drift", "", "offline") => failed{"waiting-closed"}
        seed_drain_armed: context("life/heavy-slots-semantics", "seed-drain-armed-drift", "", "offline") => failed{"drain-armed"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.helper_name, "acquireFrom", c, "helper-name")
            failed
            ok evidence helper_name_evidence => match call require_text(got.blocked_wording, "third acquisition proceeded past a cap-2 semaphore", c, "blocked-wording")
                failed
                ok evidence blocked_wording_evidence => match call require_text(got.waiter_wording, "release did not unpark the waiter", c, "waiter-wording")
                    failed
                    ok evidence waiter_wording_evidence => match call require_text(got.block_timeout, "100 * time.Millisecond", c, "block-timeout")
                        failed
                        ok evidence block_timeout_evidence => match call require_text(got.waiter_timeout, "5 * time.Second", c, "waiter-timeout")
                            failed
                            ok evidence waiter_timeout_evidence => match call require_int(got.slot_capacity, 2, c, "slot-capacity")
                                failed
                                ok evidence slot_capacity_evidence => match call require_int(got.acquire_count, 2, c, "acquire-count")
                                    failed
                                    ok evidence acquire_count_evidence => match call require_int(got.waiter_count, 1, c, "waiter-count")
                                        failed
                                        ok evidence waiter_count_evidence => match call require_int(got.select_count, 2, c, "select-count")
                                            failed
                                            ok evidence select_count_evidence => match call require_int(got.fatal_count, 2, c, "fatal-count")
                                                failed
                                                ok evidence fatal_count_evidence => match call require_bool(got.third_blocked, true, c, "third-blocked")
                                                    failed
                                                    ok evidence third_blocked_evidence => match call require_bool(got.release_admits, true, c, "release-admits")
                                                        failed
                                                        ok evidence release_admits_evidence => match call require_bool(got.proceed_closed, true, c, "proceed-closed")
                                                            failed
                                                            ok evidence proceed_closed_evidence => match call require_bool(got.waiting_closed, true, c, "waiting-closed")
                                                                failed
                                                                ok evidence waiting_closed_evidence => match call require_bool(got.drain_armed, true, c, "drain-armed")
                                                                    failed
                                                                    ok evidence drain_armed_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_l021: "m29-l021" => ok test_case("life/heavy-slots-semantics", ["life", "m29"], [], 120000, [check_ref("helper-name"), check_ref("blocked-wording"), check_ref("waiter-wording"), check_ref("block-timeout"), check_ref("waiter-timeout"), check_ref("slot-capacity"), check_ref("acquire-count"), check_ref("waiter-count"), check_ref("select-count"), check_ref("fatal-count"), check_ref("third-blocked"), check_ref("release-admits"), check_ref("proceed-closed"), check_ref("waiting-closed"), check_ref("drain-armed")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-l021"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/heavy-slots-semantics", ["life", "m29"], [], 120000, [check_ref("helper-name"), check_ref("blocked-wording"), check_ref("waiter-wording"), check_ref("block-timeout"), check_ref("waiter-timeout"), check_ref("slot-capacity"), check_ref("acquire-count"), check_ref("waiter-count"), check_ref("select-count"), check_ref("fatal-count"), check_ref("third-blocked"), check_ref("release-admits"), check_ref("proceed-closed"), check_ref("waiting-closed"), check_ref("drain-armed")], callable case_body)
