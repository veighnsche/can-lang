package m29life021cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-021 "Heavy slots: cache semantics".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHeavySlotsBounded (L130-156) plus
/// tests/integration/harness_test.go helper acquireFrom
/// (L90-94).
/// Disposition: migrate (this row ports
/// TestHeavySlotsBounded to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the bounded verdicts in Go order:
/// the helper name, the two refusal wordings, the two
/// timeout legs, the slot cap, the acquire plus waiter
/// plus select plus refusal counts, plus the blocked,
/// admit, close, and drain verdicts.
/// ADAPTATION (recorded, with source lines): helper-name
/// pins acquireFrom (L132); wordings pin the Fatal inner
/// bytes (L146, L153); timeouts pin the After arg inner
/// bytes (L147, L152); slot-capacity pins int (2) from the
/// buffered chan size (L131); acquire-count pins int (2)
/// from the two acquire calls (L132-133); waiter-count
/// pins int (1) from the single go waiter (L136);
/// select-count pins int (2) from the two select gates
/// (L144, L150); fatal-count pins int (2) from the two
/// refusal sites (L146, L153); blocked pins true since the
/// third send parks (L144-148); admit pins true since the
/// release unparks the waiter (L149-154); closes pin true
/// from the two close calls (L137, L141); drain pins true
/// from the two Cleanup drains (L155).
/// Facet map (Go verdict legs): helper-name pins
/// acquireFrom (L132); blocked-wording pins the cap-2
/// refusal (L146); waiter-wording pins the unpark refusal
/// (L153); block-timeout pins 100ms leg (L147);
/// waiter-timeout pins 5s leg (L152); slot-capacity pins 2
/// (L131); acquire-count pins 2 (L132-133); waiter-count
/// pins 1 (L136); select-count pins 2 (L144, L150);
/// fatal-count pins 2 (L146, L153); third-blocked pins
/// true (L144-148); release-admits pins true (L149-154);
/// proceed-closed pins true (L141); waiting-closed pins
/// true (L137); drain-armed pins true (L155).
/// The roots-green pin lives in life-021-roots-green.can;
/// the run shape plus diagnostics live in
/// life-021-run-shape.can.
/// Variants: bounded/admit (the single passing path in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/heavy-slots-semantics checks: helper-name,
/// blocked-wording, waiter-wording, block-timeout,
/// waiter-timeout, slot-capacity, acquire-count,
/// waiter-count, select-count, fatal-count, third-blocked,
/// release-admits, proceed-closed, waiting-closed,
/// drain-armed.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str helper_name
    str blocked_wording
    str waiter_wording
    str block_timeout
    str waiter_timeout
    int slot_capacity
    int acquire_count
    int waiter_count
    int select_count
    int fatal_count
    bool third_blocked
    bool release_admits
    bool proceed_closed
    bool waiting_closed
    bool drain_armed
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/heavy-slots-semantics", "default", "", "offline"), "helper-name" => ok "case life/heavy-slots-semantics variant default root helper-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/heavy-slots-semantics", "default", "", "offline"), "third-blocked" => ok evidence("third-blocked", "true", "true", true, "case life/heavy-slots-semantics variant default root third-blocked run offline")
        different: false, true, context("life/heavy-slots-semantics", "default", "", "offline"), "third-blocked" => failed{"third-blocked"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/heavy-slots-semantics", "default", "", "offline"), "slot-capacity" => ok evidence("slot-capacity", "2", "2", true, "case life/heavy-slots-semantics variant default root slot-capacity run offline")
        different: 1, 2, context("life/heavy-slots-semantics", "default", "", "offline"), "slot-capacity" => failed{"slot-capacity"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "acquireFrom", "acquireFrom", context("life/heavy-slots-semantics", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "acquireFrom", "acquireFrom", true, "case life/heavy-slots-semantics variant default root helper-name run offline")
        different: "acquireFrom_2", "acquireFrom", context("life/heavy-slots-semantics", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
