        str expected
        context c
        str check
    asserts
        same: "TestHeavySlotsBounded", "TestHeavySlotsBounded", context("life/heavy-slots-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestHeavySlotsBounded", "TestHeavySlotsBounded", true, "case life/heavy-slots-roots variant default root test-name run offline")
        different: "TestHeavySlotsBounded_2", "TestHeavySlotsBounded", context("life/heavy-slots-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
