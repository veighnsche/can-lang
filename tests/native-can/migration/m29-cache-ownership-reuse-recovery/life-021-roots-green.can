/// M29 LIFE-021 "Heavy slots: roots green".
/// Source: tests/integration/harness_cache_test.go static
/// baseline for TestHeavySlotsBounded (L130-156) plus call
/// shapes (L131-143) and tests/integration/harness_test.go
/// helper baseline (L90-94).
/// Disposition: migrate (this row ports
/// TestHeavySlotsBounded to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static baseline as the green root:
/// the test symbol plus param shape, the slots decl plus
/// chan shape, the acquire call plus helper name plus param
/// plus send plus cleanup shapes, the two barrier decls,
/// the go plus close spellings, and the suite slots name.
/// ADAPTATION (recorded, with source lines): test-name pins
/// the TestHeavySlotsBounded symbol (L130); test-param pins
/// t *testing.T (L130); slots-decl pins the buffered make
/// (L131); chan-shape pins chan struct{} (L131);
/// acquire-call pins acquireFrom(t, slots) with parens plus
/// args (L132); helper-name pins acquireFrom (L90);
/// helper-param pins the full param list (L90);
/// helper-send pins the helper send (L92); cleanup-shape
/// pins the Cleanup call (L93); barrier decls pin the two
/// unbuffered makes (L134-135); go-shape pins go func() {
/// (L136); closes pin close(waiting) plus close(proceeded)
/// (L137, L141); suite-slots pins heavySlots (L87).
/// Facet map (static baseline): test-name pins
/// TestHeavySlotsBounded (L130); test-param pins t *testing.T
/// (L130); slots-decl pins the L131 make; chan-shape pins
/// chan struct{} (L131); acquire-call pins
/// acquireFrom(t, slots) (L132); helper-name pins
/// acquireFrom (L90); helper-param pins the L90 params;
/// helper-send pins the L92 send; cleanup-shape pins the
/// L93 Cleanup; proceeded-decl pins the L134 make;
/// waiting-decl pins the L135 make; go-shape pins
/// go func() { (L136); close-waiting pins close(waiting)
/// (L137); close-proceeded pins close(proceeded) (L141);
/// suite-slots pins heavySlots (L87).
/// The verdict pins live in life-021-cache-semantics.can;
/// the run shape plus diagnostics live in
/// life-021-run-shape.can.
/// Variants: bounded/admit (the single passing path in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/heavy-slots-roots checks: test-name,
/// test-param, slots-decl, chan-shape, acquire-call,
/// helper-name, helper-param, helper-send, cleanup-shape,
/// proceeded-decl, waiting-decl, go-shape, close-waiting,
/// close-proceeded, suite-slots.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str test_param
    str slots_decl
    str chan_shape
    str acquire_call
    str helper_name
    str helper_param
    str helper_send
    str cleanup_shape
    str proceeded_decl
    str waiting_decl
    str go_shape
    str close_waiting
    str close_proceeded
    str suite_slots
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/heavy-slots-roots", "default", "", "offline"), "test-name" => ok "case life/heavy-slots-roots variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/heavy-slots-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/heavy-slots-roots variant default root test-name run offline")
        different: false, true, context("life/heavy-slots-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/heavy-slots-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "1", "1", true, "case life/heavy-slots-roots variant default root test-name run offline")
        different: 2, 1, context("life/heavy-slots-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
