package m29life021run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-021 "Heavy slots: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHeavySlotsBounded (L130-156): slots setup (L131);
/// acquires (L132-133); barriers (L134-135); waiter go
/// (L136-142); wait gate (L143); block probe (L144-148);
/// release (L149); admit probe (L150-154); drain note
/// (L155).
/// Disposition: migrate (this row ports
/// TestHeavySlotsBounded to ordinary Can functions; the old Go
/// harness stays until the integrator retires it after every
/// linked row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the slots
/// setup shape, the acquire shape, the go plus waiter-send
/// shapes, the wait gate, the block probe plus guard plus
/// fatal wording plus timeout, the release shape, the
/// admit probe plus timeout plus fatal wording, the
/// acquire plus fatal counts, and the admit order.
/// ADAPTATION (recorded, with source lines): shapes pin the Go
/// statement inner bytes without leading tabs (L131-132,
/// L136, L140, L143-145, L147, L149-152); blocked-fatal
/// pins the Fatal format inner bytes (L146); waiter-fatal
/// pins the Fatal format inner bytes (L153); counts pin
/// ints from the acquire calls (L132-133) and the refusal
/// sites (L146, L153).
/// Facet map (launch plus diagnostics): slots-stmt pins the
/// slots setup (L131); acquire-stmt pins the acquire call
/// (L132); go-stmt pins the waiter go (L136); waiter-stmt
/// pins the waiter send (L140); wait-recv pins the wait
/// gate (L143); select-stmt pins the select gate (L144);
/// blocked-guard pins the proceed leg (L145);
/// blocked-fatal pins the cap-2 wording (L146);
/// block-timeout pins the 100ms leg (L147); release-stmt
/// pins the release (L149); waiter-timeout pins the 5s leg
/// (L152); waiter-fatal pins the unpark wording (L153);
/// acquire-count pins 2 (L132-133); fatal-count pins 2
/// (L146, L153); release-admits pins true (L149-154).
/// The verdict pins live in life-021-cache-semantics.can;
/// the roots-green pin lives in life-021-roots-green.can.
/// Variants: bounded/admit (the single passing path in Go
/// order).
/// Environment: none (no gates; requires []).
/// Logical gates SUITE/WORK/FILES/FAULT/NATIVE bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go timeout in
/// this row; binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/heavy-slots-run checks: slots-stmt,
/// acquire-stmt, go-stmt, waiter-stmt, wait-recv,
/// select-stmt, blocked-guard, blocked-fatal,
/// block-timeout, release-stmt, waiter-timeout,
/// waiter-fatal, acquire-count, fatal-count,
/// release-admits.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str slots_stmt
    str acquire_stmt
    str go_stmt
    str waiter_stmt
    str wait_recv
    str select_stmt
    str blocked_guard
    str blocked_fatal
    str block_timeout
    str release_stmt
    str waiter_timeout
    str waiter_fatal
    int acquire_count
    int fatal_count
    bool release_admits
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/heavy-slots-run", "default", "", "offline"), "slots-stmt" => ok "case life/heavy-slots-run variant default root slots-stmt run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/heavy-slots-run", "default", "", "offline"), "release-admits" => ok evidence("release-admits", "true", "true", true, "case life/heavy-slots-run variant default root release-admits run offline")
        different: false, true, context("life/heavy-slots-run", "default", "", "offline"), "release-admits" => failed{"release-admits"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/heavy-slots-run", "default", "", "offline"), "acquire-count" => ok evidence("acquire-count", "2", "2", true, "case life/heavy-slots-run variant default root acquire-count run offline")
        different: 1, 2, context("life/heavy-slots-run", "default", "", "offline"), "acquire-count" => failed{"acquire-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "slots := make(chan struct{}, 2)", "slots := make(chan struct{}, 2)", context("life/heavy-slots-run", "default", "", "offline"), "slots-stmt" => ok evidence("slots-stmt", "slots := make(chan struct{}, 2)", "slots := make(chan struct{}, 2)", true, "case life/heavy-slots-run variant default root slots-stmt run offline")
        different: "slots := make(chan struct{}, 2)_2", "slots := make(chan struct{}, 2)", context("life/heavy-slots-run", "default", "", "offline"), "slots-stmt" => failed{"slots-stmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
