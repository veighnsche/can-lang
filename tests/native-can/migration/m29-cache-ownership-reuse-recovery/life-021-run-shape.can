        seed_select_stmt: context("life/heavy-slots-run", "seed-select-stmt-drift", "", "offline") => failed{"select-stmt"}
        seed_blocked_guard: context("life/heavy-slots-run", "seed-blocked-guard-drift", "", "offline") => failed{"blocked-guard"}
        seed_blocked_fatal: context("life/heavy-slots-run", "seed-blocked-fatal-drift", "", "offline") => failed{"blocked-fatal"}
        seed_block_timeout: context("life/heavy-slots-run", "seed-block-timeout-drift", "", "offline") => failed{"block-timeout"}
        seed_release_stmt: context("life/heavy-slots-run", "seed-release-stmt-drift", "", "offline") => failed{"release-stmt"}
        seed_waiter_timeout: context("life/heavy-slots-run", "seed-waiter-timeout-drift", "", "offline") => failed{"waiter-timeout"}
        seed_waiter_fatal: context("life/heavy-slots-run", "seed-waiter-fatal-drift", "", "offline") => failed{"waiter-fatal"}
        seed_acquire_count: context("life/heavy-slots-run", "seed-acquire-count-drift", "", "offline") => failed{"acquire-count"}
        seed_fatal_count: context("life/heavy-slots-run", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
        seed_release_admits: context("life/heavy-slots-run", "seed-release-admits-drift", "", "offline") => failed{"release-admits"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.slots_stmt, "slots := make(chan struct{}, 2)", c, "slots-stmt")
            failed
            ok evidence slots_stmt_evidence => match call require_text(got.acquire_stmt, "acquireFrom(t, slots)", c, "acquire-stmt")
                failed
