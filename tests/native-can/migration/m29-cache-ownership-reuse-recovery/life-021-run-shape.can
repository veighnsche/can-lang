    emits {failed}
    given
        context c
    asserts
        expected: context("life/heavy-slots-run", "default", "", "offline") => ok
        seed_slots_stmt: context("life/heavy-slots-run", "seed-slots-stmt-drift", "", "offline") => failed{"slots-stmt"}
        seed_acquire_stmt: context("life/heavy-slots-run", "seed-acquire-stmt-drift", "", "offline") => failed{"acquire-stmt"}
