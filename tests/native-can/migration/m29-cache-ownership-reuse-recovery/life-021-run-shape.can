        false => ok []
        true => ok [check("slots-stmt", "slots setup shape is pinned"), check("acquire-stmt", "acquire shape is pinned"), check("go-stmt", "waiter go shape is pinned"), check("waiter-stmt", "waiter send shape is pinned"), check("wait-recv", "wait gate shape is pinned"), check("select-stmt", "select gate shape is pinned"), check("blocked-guard", "block probe pins the proceed leg"), check("blocked-fatal", "cap-2 refusal wording is pinned"), check("block-timeout", "block probe pins the 100ms leg"), check("release-stmt", "release shape is pinned"), check("waiter-timeout", "admit probe pins the 5s leg"), check("waiter-fatal", "unpark refusal wording is pinned"), check("acquire-count", "two acquires fill the cap"), check("fatal-count", "two refusals guard the probes"), check("release-admits", "release unparks the waiter")]
