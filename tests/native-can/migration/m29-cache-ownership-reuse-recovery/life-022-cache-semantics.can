/// M29 LIFE-022 "Slot cap: policy semantics".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHeavySlotCap (L158-173).
/// Disposition: consolidate (this row ports
/// TestHeavySlotCap to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the three slot-cap legs in Go
/// order (empty default vs 7 override vs 0 invalid), the
/// env name, the 3 default cap, the accepted 7 override,
/// the rejected 0 override falling back to 3, the !=
/// guard spelling, the got binding, the three Fatal
/// wordings with exact want values, and the
/// setenv/call/fatal counts.
/// ADAPTATION (recorded, with source lines): default-value
/// pins the empty inner bytes (L161); override-value pins
/// the 7 inner bytes (L165); invalid-value pins the 0
/// inner bytes (L169); default-cap pins int (3) from the
/// empty-env leg (L162); override-cap pins int (7) from
/// the 7 leg (L166); invalid-cap pins int (3) from the
/// fallback leg (L170); compare-op pins != (L162) as the
/// refusal guard (no semaphore re-implementation
/// anywhere); default-fatal pins the default inner bytes
/// (L163); override-fatal pins the override inner bytes
/// (L167); invalid-fatal pins the invalid inner bytes
/// (L171); setenv-count pins int (3) from the three legs
/// (L161/L165/L169); cap-call-count pins int (3) from the
/// three probes (L162/L166/L170); fatal-count pins int
/// (3) from the Fatal legs (L163/L167/L171).
/// Facet map (Go policy legs): env-name pins
/// CAN_TEST_HEAVY_SLOTS (L161); default-value pins empty
/// (L161); override-value pins 7 (L165); invalid-value
/// pins 0 (L169); default-fatal pins default heavy cap
/// plus want 3 (L163); override-fatal pins override heavy
/// cap plus want 7 (L167); invalid-fatal pins invalid
/// heavy cap plus want default 3 (L171); compare-op pins
/// != (L162); got-name pins got (L162); default-cap pins 3
/// (L162); override-cap pins 7 (L166); invalid-cap pins 3
/// (L170); setenv-count pins 3 (L161/L165/L169);
/// cap-call-count pins 3 (L162/L166/L170); fatal-count
/// pins 3 (L163/L167/L171).
/// The roots-green pin lives in life-022-roots-green.can;
/// the run shape plus diagnostics live in
/// life-022-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 120000ms
/// is the offline default bound (no Go timeout in this row;
/// binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/slot-cap checks: env-name, default-value,
/// override-value, invalid-value, default-fatal,
/// override-fatal, invalid-fatal, compare-op, got-name,
/// default-cap, override-cap, invalid-cap, setenv-count,
/// cap-call-count, fatal-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_name
    str default_value
    str override_value
    str invalid_value
    str default_fatal
    str override_fatal
    str invalid_fatal
    str compare_op
    str got_name
    int default_cap
    int override_cap
    int invalid_cap
    int setenv_count
    int cap_call_count
    int fatal_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/slot-cap", "default", "", "offline"), "env-name" => ok "case life/slot-cap variant default root env-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/slot-cap", "default", "", "offline"), "env-name" => ok evidence("env-name", "true", "true", true, "case life/slot-cap variant default root env-name run offline")
        different: false, true, context("life/slot-cap", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
