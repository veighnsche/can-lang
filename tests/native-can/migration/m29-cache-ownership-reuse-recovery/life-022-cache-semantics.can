    emits {failed}
    given
        context c
    asserts
        expected: context("life/slot-cap", "default", "", "offline") => ok
        seed_env_name: context("life/slot-cap", "seed-env-name-drift", "", "offline") => failed{"env-name"}
        seed_default_value: context("life/slot-cap", "seed-default-value-drift", "", "offline") => failed{"default-value"}
        seed_override_value: context("life/slot-cap", "seed-override-value-drift", "", "offline") => failed{"override-value"}
        seed_invalid_value: context("life/slot-cap", "seed-invalid-value-drift", "", "offline") => failed{"invalid-value"}
        seed_default_fatal: context("life/slot-cap", "seed-default-fatal-drift", "", "offline") => failed{"default-fatal"}
        seed_override_fatal: context("life/slot-cap", "seed-override-fatal-drift", "", "offline") => failed{"override-fatal"}
        seed_invalid_fatal: context("life/slot-cap", "seed-invalid-fatal-drift", "", "offline") => failed{"invalid-fatal"}
        seed_compare_op: context("life/slot-cap", "seed-compare-op-drift", "", "offline") => failed{"compare-op"}
        seed_got_name: context("life/slot-cap", "seed-got-name-drift", "", "offline") => failed{"got-name"}
        seed_default_cap: context("life/slot-cap", "seed-default-cap-drift", "", "offline") => failed{"default-cap"}
        seed_override_cap: context("life/slot-cap", "seed-override-cap-drift", "", "offline") => failed{"override-cap"}
        seed_invalid_cap: context("life/slot-cap", "seed-invalid-cap-drift", "", "offline") => failed{"invalid-cap"}
        seed_setenv_count: context("life/slot-cap", "seed-setenv-count-drift", "", "offline") => failed{"setenv-count"}
        seed_cap_call_count: context("life/slot-cap", "seed-cap-call-count-drift", "", "offline") => failed{"cap-call-count"}
        seed_fatal_count: context("life/slot-cap", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.env_name, "CAN_TEST_HEAVY_SLOTS", c, "env-name")
            failed
            ok evidence env_name_evidence => match call require_text(got.default_value, "", c, "default-value")
                failed
                ok evidence default_value_evidence => match call require_text(got.override_value, "7", c, "override-value")
                    failed
                    ok evidence override_value_evidence => match call require_text(got.invalid_value, "0", c, "invalid-value")
                        failed
                        ok evidence invalid_value_evidence => match call require_text(got.default_fatal, "default heavy cap %d, want 3", c, "default-fatal")
                            failed
                            ok evidence default_fatal_evidence => match call require_text(got.override_fatal, "override heavy cap %d, want 7", c, "override-fatal")
                                failed
                                ok evidence override_fatal_evidence => match call require_text(got.invalid_fatal, "invalid heavy cap %d, want default 3", c, "invalid-fatal")
                                    failed
                                    ok evidence invalid_fatal_evidence => match call require_text(got.compare_op, "!=", c, "compare-op")
                                        failed
                                        ok evidence compare_op_evidence => match call require_text(got.got_name, "got", c, "got-name")
                                            failed
                                            ok evidence got_name_evidence => match call require_int(got.default_cap, 3, c, "default-cap")
                                                failed
                                                ok evidence default_cap_evidence => match call require_int(got.override_cap, 7, c, "override-cap")
                                                    failed
                                                    ok evidence override_cap_evidence => match call require_int(got.invalid_cap, 3, c, "invalid-cap")
                                                        failed
                                                        ok evidence invalid_cap_evidence => match call require_int(got.setenv_count, 3, c, "setenv-count")
                                                            failed
                                                            ok evidence setenv_count_evidence => match call require_int(got.cap_call_count, 3, c, "cap-call-count")
                                                                failed
                                                                ok evidence cap_call_count_evidence => match call require_int(got.fatal_count, 3, c, "fatal-count")
                                                                    failed
                                                                    ok evidence fatal_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_l022: "m29-l022" => ok test_case("life/slot-cap", ["life", "m29"], [], 120000, [check_ref("env-name"), check_ref("default-value"), check_ref("override-value"), check_ref("invalid-value"), check_ref("default-fatal"), check_ref("override-fatal"), check_ref("invalid-fatal"), check_ref("compare-op"), check_ref("got-name"), check_ref("default-cap"), check_ref("override-cap"), check_ref("invalid-cap"), check_ref("setenv-count"), check_ref("cap-call-count"), check_ref("fatal-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-l022"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/slot-cap", ["life", "m29"], [], 120000, [check_ref("env-name"), check_ref("default-value"), check_ref("override-value"), check_ref("invalid-value"), check_ref("default-fatal"), check_ref("override-fatal"), check_ref("invalid-fatal"), check_ref("compare-op"), check_ref("got-name"), check_ref("default-cap"), check_ref("override-cap"), check_ref("invalid-cap"), check_ref("setenv-count"), check_ref("cap-call-count"), check_ref("fatal-count")], callable case_body)
