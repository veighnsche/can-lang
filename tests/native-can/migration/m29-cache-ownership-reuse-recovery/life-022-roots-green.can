    emits {}
    given
        str case
    asserts
        known: "life/slot-roots" => ok [expected_check("helper-name", "heavySlotCap"), expected_check("return-type", "int"), expected_check("raw-name", "raw"), expected_check("getenv-call", "os.Getenv"), expected_check("env-name", "CAN_TEST_HEAVY_SLOTS"), expected_check("empty-guard", "raw != \"\""), expected_check("atoi-call", "strconv.Atoi"), expected_check("n-name", "n"), expected_check("err-name", "err"), expected_check("ok-guard", "err == nil && n >= 1"), expected_check("default-returns", "return 3"), expected_check("override-returns", "return n"), expected_check("min-cap", "1"), expected_check("param-count", "0"), expected_check("call-site-count", "4")]
        unknown: "nope" => ok []
    match case is "life/slot-roots"
        false => ok []
        true => ok [expected_check("helper-name", "heavySlotCap"), expected_check("return-type", "int"), expected_check("raw-name", "raw"), expected_check("getenv-call", "os.Getenv"), expected_check("env-name", "CAN_TEST_HEAVY_SLOTS"), expected_check("empty-guard", "raw != \"\""), expected_check("atoi-call", "strconv.Atoi"), expected_check("n-name", "n"), expected_check("err-name", "err"), expected_check("ok-guard", "err == nil && n >= 1"), expected_check("default-returns", "return 3"), expected_check("override-returns", "return n"), expected_check("min-cap", "1"), expected_check("param-count", "0"), expected_check("call-site-count", "4")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/slot-roots", "default", "", "offline") => ok
        seed_helper_name: context("life/slot-roots", "seed-helper-name-drift", "", "offline") => failed{"helper-name"}
        seed_return_type: context("life/slot-roots", "seed-return-type-drift", "", "offline") => failed{"return-type"}
        seed_raw_name: context("life/slot-roots", "seed-raw-name-drift", "", "offline") => failed{"raw-name"}
        seed_getenv_call: context("life/slot-roots", "seed-getenv-call-drift", "", "offline") => failed{"getenv-call"}
        seed_env_name: context("life/slot-roots", "seed-env-name-drift", "", "offline") => failed{"env-name"}
        seed_empty_guard: context("life/slot-roots", "seed-empty-guard-drift", "", "offline") => failed{"empty-guard"}
        seed_atoi_call: context("life/slot-roots", "seed-atoi-call-drift", "", "offline") => failed{"atoi-call"}
        seed_n_name: context("life/slot-roots", "seed-n-name-drift", "", "offline") => failed{"n-name"}
        seed_err_name: context("life/slot-roots", "seed-err-name-drift", "", "offline") => failed{"err-name"}
        seed_ok_guard: context("life/slot-roots", "seed-ok-guard-drift", "", "offline") => failed{"ok-guard"}
        seed_default_returns: context("life/slot-roots", "seed-default-returns-drift", "", "offline") => failed{"default-returns"}
        seed_override_returns: context("life/slot-roots", "seed-override-returns-drift", "", "offline") => failed{"override-returns"}
        seed_min_cap: context("life/slot-roots", "seed-min-cap-drift", "", "offline") => failed{"min-cap"}
        seed_param_count: context("life/slot-roots", "seed-param-count-drift", "", "offline") => failed{"param-count"}
        seed_call_site_count: context("life/slot-roots", "seed-call-site-count-drift", "", "offline") => failed{"call-site-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.helper_name, "heavySlotCap", c, "helper-name")
            failed
            ok evidence helper_name_evidence => match call require_text(got.return_type, "int", c, "return-type")
                failed
                ok evidence return_type_evidence => match call require_text(got.raw_name, "raw", c, "raw-name")
                    failed
                    ok evidence raw_name_evidence => match call require_text(got.getenv_call, "os.Getenv", c, "getenv-call")
                        failed
                        ok evidence getenv_call_evidence => match call require_text(got.env_name, "CAN_TEST_HEAVY_SLOTS", c, "env-name")
                            failed
                            ok evidence env_name_evidence => match call require_text(got.empty_guard, "raw != \"\"", c, "empty-guard")
                                failed
                                ok evidence empty_guard_evidence => match call require_text(got.atoi_call, "strconv.Atoi", c, "atoi-call")
                                    failed
                                    ok evidence atoi_call_evidence => match call require_text(got.n_name, "n", c, "n-name")
                                        failed
                                        ok evidence n_name_evidence => match call require_text(got.err_name, "err", c, "err-name")
                                            failed
                                            ok evidence err_name_evidence => match call require_text(got.ok_guard, "err == nil && n >= 1", c, "ok-guard")
                                                failed
                                                ok evidence ok_guard_evidence => match call require_text(got.default_returns, "return 3", c, "default-returns")
                                                    failed
                                                    ok evidence default_returns_evidence => match call require_text(got.override_returns, "return n", c, "override-returns")
                                                        failed
                                                        ok evidence override_returns_evidence => match call require_int(got.min_cap, 1, c, "min-cap")
                                                            failed
                                                            ok evidence min_cap_evidence => match call require_int(got.param_count, 0, c, "param-count")
                                                                failed
                                                                ok evidence param_count_evidence => match call require_int(got.call_site_count, 4, c, "call-site-count")
                                                                    failed
                                                                    ok evidence call_site_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m29_l022: "m29-l022" => ok test_case("life/slot-roots", ["life", "m29"], [], 120000, [check_ref("helper-name"), check_ref("return-type"), check_ref("raw-name"), check_ref("getenv-call"), check_ref("env-name"), check_ref("empty-guard"), check_ref("atoi-call"), check_ref("n-name"), check_ref("err-name"), check_ref("ok-guard"), check_ref("default-returns"), check_ref("override-returns"), check_ref("min-cap"), check_ref("param-count"), check_ref("call-site-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m29-l022"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/slot-roots", ["life", "m29"], [], 120000, [check_ref("helper-name"), check_ref("return-type"), check_ref("raw-name"), check_ref("getenv-call"), check_ref("env-name"), check_ref("empty-guard"), check_ref("atoi-call"), check_ref("n-name"), check_ref("err-name"), check_ref("ok-guard"), check_ref("default-returns"), check_ref("override-returns"), check_ref("min-cap"), check_ref("param-count"), check_ref("call-site-count")], callable case_body)
