fn check[] checks
    emits {}
    given
        str scope
    asserts
        m29_l022: "m29-l022" => ok [check("helper-name", "helper is named heavySlotCap"), check("return-type", "helper returns int"), check("raw-name", "env bytes are named raw"), check("getenv-call", "env loads with Getenv"), check("env-name", "helper pins the env name"), check("empty-guard", "nonempty env faces the empty guard"), check("atoi-call", "parse pins the Atoi call"), check("n-name", "parsed value is named n"), check("err-name", "parse error is named err"), check("ok-guard", "override faces the ok guard"), check("default-returns", "default path returns 3"), check("override-returns", "override path returns n"), check("min-cap", "override minimum is 1"), check("param-count", "helper takes zero params"), check("call-site-count", "four call sites pin the helper")]
        other: "nope" => ok []
    match scope is "m29-l022"
        false => ok []
        true => ok [check("helper-name", "helper is named heavySlotCap"), check("return-type", "helper returns int"), check("raw-name", "env bytes are named raw"), check("getenv-call", "env loads with Getenv"), check("env-name", "helper pins the env name"), check("empty-guard", "nonempty env faces the empty guard"), check("atoi-call", "parse pins the Atoi call"), check("n-name", "parsed value is named n"), check("err-name", "parse error is named err"), check("ok-guard", "override faces the ok guard"), check("default-returns", "default path returns 3"), check("override-returns", "override path returns n"), check("min-cap", "override minimum is 1"), check("param-count", "helper takes zero params"), check("call-site-count", "four call sites pin the helper")]
