package m29life022roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-022 "Slot cap: roots green".
/// Source: tests/integration/harness_test.go helper
/// heavySlotCap (L71-80) plus the semaphore init (L68).
/// Disposition: consolidate (this row ports
/// TestHeavySlotCap to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the static slot-cap baseline as
/// the green root: the helper name plus int return, the
/// raw name, the Getenv env read, the empty guard, the
/// Atoi parse plus n/err bindings, the ok guard plus
/// minimum 1, the return-n plus return-3 spellings, and
/// the param/call-site counts.
/// ADAPTATION (recorded, with source lines): return-type
/// pins int (L73); raw-name pins raw (L74); getenv-call
/// pins os.Getenv (L74); empty-guard pins the full raw
/// not-empty spelling (L74); atoi-call pins strconv.Atoi
/// (L75); n-name pins n (L75); err-name pins err (L75);
/// ok-guard pins the full err-nil plus at-least-1
/// spelling (L75); min-cap pins int (1) from the lower
/// bound (L75); default-returns pins return 3 (L79);
/// override-returns pins return n (L76); param-count pins
/// int (0) from the empty param list (L73);
/// call-site-count pins int (4) from the semaphore init
/// (H L68) plus the three test legs (L162/L166/L170); all
/// call pins pin spellings only (no semaphore
/// re-implementation anywhere).
/// Facet map (static baseline): helper-name pins
/// heavySlotCap (L73); return-type pins int (L73);
/// raw-name pins raw (L74); getenv-call pins os.Getenv
/// (L74); env-name pins CAN_TEST_HEAVY_SLOTS (L74);
/// empty-guard pins raw not-empty (L74); atoi-call pins
/// strconv.Atoi (L75); n-name pins n (L75); err-name pins
/// err (L75); ok-guard pins err-nil plus at-least-1
/// (L75); default-returns pins return 3 (L79);
/// override-returns pins return n (L76); min-cap pins 1
/// (L75); param-count pins 0 (L73); call-site-count pins
/// 4 (H L68 plus L162/L166/L170).
/// The policy pins live in life-022-cache-semantics.can;
/// the run shape plus diagnostics live in
/// life-022-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 120000ms
/// is the offline default bound (no Go timeout in this row;
/// binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/slot-roots checks: helper-name, return-type,
/// raw-name, getenv-call, env-name, empty-guard,
/// atoi-call, n-name, err-name, ok-guard,
/// default-returns, override-returns, min-cap,
/// param-count, call-site-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str helper_name
    str return_type
    str raw_name
    str getenv_call
    str env_name
    str empty_guard
    str atoi_call
    str n_name
    str err_name
    str ok_guard
    str default_returns
    str override_returns
    int min_cap
    int param_count
    int call_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/slot-roots", "default", "", "offline"), "helper-name" => ok "case life/slot-roots variant default root helper-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/slot-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "true", "true", true, "case life/slot-roots variant default root helper-name run offline")
        different: false, true, context("life/slot-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/slot-roots", "default", "", "offline"), "min-cap" => ok evidence("min-cap", "1", "1", true, "case life/slot-roots variant default root min-cap run offline")
        different: 0, 1, context("life/slot-roots", "default", "", "offline"), "min-cap" => failed{"min-cap"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "heavySlotCap", "heavySlotCap", context("life/slot-roots", "default", "", "offline"), "helper-name" => ok evidence("helper-name", "heavySlotCap", "heavySlotCap", true, "case life/slot-roots variant default root helper-name run offline")
        different: "heavySlotCap_2", "heavySlotCap", context("life/slot-roots", "default", "", "offline"), "helper-name" => failed{"helper-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
