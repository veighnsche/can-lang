package m29life022run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-022 "Slot cap: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHeavySlotCap (L158-173): default Setenv plus probe
/// (L161-163); override Setenv plus probe (L165-167);
/// invalid Setenv plus probe (L169-171).
/// Disposition: consolidate (this row ports
/// TestHeavySlotCap to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the live run shape: the test name,
/// the Setenv gate plus env name, the empty/7/0 leg
/// values, the full cap call, the got binding, the !=
/// refusal guard, the three want values, the Fatalf call
/// plus three Fatal wordings, and the setenv/fatal
/// counts.
/// ADAPTATION (recorded, with source lines): test-name
/// pins TestHeavySlotCap (L158); setenv-call pins
/// t.Setenv (L161); default-value pins the empty inner
/// bytes (L161); cap-call pins heavySlotCap() with parens
/// (L162); compare-op pins != (L162) as the refusal
/// guard; override-value pins the 7 inner bytes (L165);
/// invalid-value pins the 0 inner bytes (L169);
/// fatal-call pins t.Fatalf (L163); default-fatal pins
/// the default inner bytes (L163); override-fatal pins
/// the override inner bytes (L167); invalid-fatal pins
/// the invalid inner bytes (L171); default-want pins int
/// (3) from the default leg (L162); override-want pins
/// int (7) from the override leg (L166); invalid-want
/// pins int (3) from the invalid leg (L170);
/// setenv-count pins int (3) from the three legs
/// (L161/L165/L169); fatal-count pins int (3) from the
/// Fatal legs (L163/L167/L171).
/// Facet map (launch plus diagnostics): test-name pins
/// TestHeavySlotCap (L158); setenv-call pins t.Setenv
/// (L161); env-name pins CAN_TEST_HEAVY_SLOTS (L161);
/// default-value pins empty (L161); cap-call pins
/// heavySlotCap() (L162); got-name pins got (L162);
/// compare-op pins != (L162); override-value pins 7
/// (L165); invalid-value pins 0 (L169); fatal-call pins
/// t.Fatalf (L163); default-fatal pins default heavy cap
/// plus want 3 (L163); override-fatal pins override
/// heavy cap plus want 7 (L167); invalid-fatal pins
/// invalid heavy cap plus want default 3 (L171);
/// default-want pins 3 (L162); override-want pins 7
/// (L166); invalid-want pins 3 (L170); setenv-count pins
/// 3 (L161/L165/L169); fatal-count pins 3
/// (L163/L167/L171).
/// The policy pins live in life-022-cache-semantics.can;
/// the roots-green pin lives in life-022-roots-green.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 120000ms
/// is the offline default bound (no Go timeout in this row;
/// binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/slot-run checks: test-name, setenv-call,
/// env-name, default-value, cap-call, got-name,
/// compare-op, override-value, invalid-value, fatal-call,
/// default-fatal, override-fatal, invalid-fatal,
/// default-want, override-want, invalid-want,
/// setenv-count, fatal-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str setenv_call
    str env_name
    str default_value
    str cap_call
    str got_name
    str compare_op
    str override_value
    str invalid_value
    str fatal_call
    str default_fatal
    str override_fatal
    str invalid_fatal
    int default_want
    int override_want
    int invalid_want
    int setenv_count
    int fatal_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/slot-run", "default", "", "offline"), "test-name" => ok "case life/slot-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/slot-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/slot-run variant default root test-name run offline")
        different: false, true, context("life/slot-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("life/slot-run", "default", "", "offline"), "default-want" => ok evidence("default-want", "3", "3", true, "case life/slot-run variant default root default-want run offline")
        different: 2, 3, context("life/slot-run", "default", "", "offline"), "default-want" => failed{"default-want"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestHeavySlotCap", "TestHeavySlotCap", context("life/slot-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestHeavySlotCap", "TestHeavySlotCap", true, "case life/slot-run variant default root test-name run offline")
        different: "TestHeavySlotCap_2", "TestHeavySlotCap", context("life/slot-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
