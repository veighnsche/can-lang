    uses [text]

/// M29 LIFE-023 "Shared bundle: cache semantics".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessSharedEndToEnd (L175-200).
/// Disposition: consolidate (this row ports
/// TestHarnessSharedEndToEnd to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the two bundle request legs plus
/// their helper and args, the shared-identity comparison
/// (compare spelling plus not-equal op), the before line,
/// the fill line plus minus-before shape plus guard, the
/// two Fatalf refusal wordings, the shared verdict, the
/// two-request count, and the one-fill bound.
/// ADAPTATION (recorded, with source lines): identity-cmp
/// pins first != second (L194) as the identity comparison
/// (no path re-hash anywhere); identity-op pins != (L194);
/// fill-expr pins the minus-before shape (L197) as the fill
/// counting logic (no counter re-implementation); fill-guard
/// pins got > 1 (L197); fill-bound pins int (1) from the
/// guard and wording (L197-198); shared-same pins bool
/// (true) from the protects facet; request-count pins int
/// (2) from the two request legs (L186/L190).
/// Facet map (Go verdict legs): first-leg pins the first
/// call (L186); second-leg pins the repeat call (L190);
/// bundle-call pins harnessBundle (L186/L190); bundle-args
/// pins (t, ctx, archive) (L186/L190); identity-cmp pins
/// first != second (L194); identity-op pins != (L194);
/// before-line pins the before line (L185); builds-call pins
/// harnessBuilds.Load() (L185/L197); fill-line pins the full
/// if line (L197); fill-expr pins the minus-before shape
/// (L197); fill-guard pins got > 1 (L197); fatal-share pins
/// the diverged-paths wording (L195); fatal-fill pins the
/// fills wording (L198); shared-same pins true (protects
/// facet); request-count pins 2 (L186/L190); fill-bound
/// pins 1 (L197-198).
/// The roots-green pin lives in life-023-roots-green.can; the
/// run shape plus diagnostics live in life-023-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: CAN_BUN_ARCHIVE required; requires
/// can-bun-archive.
/// Logical gates CAN/FILES/WORK/BUILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 600000ms
/// mirrors the Go 10-minute ctx (L183); binds at P23.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/shared-semantics checks: first-leg,
/// second-leg, bundle-call, bundle-args, identity-cmp,
/// identity-op, before-line, builds-call, fill-line,
/// fill-expr, fill-guard, fatal-share, fatal-fill,
/// shared-same, request-count, fill-bound.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str first_leg
    str second_leg
    str bundle_call
    str bundle_args
    str identity_cmp
    str identity_op
    str before_line
    str builds_call
    str fill_line
    str fill_expr
    str fill_guard
    str fatal_share
    str fatal_fill
    bool shared_same
    int request_count
    int fill_bound
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/shared-semantics", "default", "", "offline"), "first-leg" => ok "case life/shared-semantics variant default root first-leg run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/shared-semantics", "default", "", "offline"), "first-leg" => ok evidence("first-leg", "true", "true", true, "case life/shared-semantics variant default root first-leg run offline")
        different: false, true, context("life/shared-semantics", "default", "", "offline"), "first-leg" => failed{"first-leg"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/shared-semantics", "default", "", "offline"), "request-count" => ok evidence("request-count", "2", "2", true, "case life/shared-semantics variant default root request-count run offline")
        different: 1, 2, context("life/shared-semantics", "default", "", "offline"), "request-count" => failed{"request-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
