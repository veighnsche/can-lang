        different: "first, err := harnessBundle(t, ctx, archive)_2", "first, err := harnessBundle(t, ctx, archive)", context("life/shared-semantics", "default", "", "offline"), "first-leg" => failed{"first-leg"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
