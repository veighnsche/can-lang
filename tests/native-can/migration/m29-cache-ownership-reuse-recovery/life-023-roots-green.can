package m29life023roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-023 "Shared bundle: roots green".
/// Source: tests/integration/harness_cache_test.go setup
/// legs of TestHarnessSharedEndToEnd (L175-184 plus guards
/// L187/L191).
/// Disposition: consolidate (this row ports
/// TestHarnessSharedEndToEnd to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the green roots: the archive env
/// line plus Getenv call plus env name, the empty gate plus
/// its guard, the Skip line plus call plus wording, the ctx
/// timeout line plus WithTimeout plus Background plus ten
/// minutes shape, the defer cancel, the err guard plus Fatal
/// err legs, the three header comment lines, and the
/// bundle/err-guard/comment counts.
/// ADAPTATION (recorded, with source lines): gate-guard
/// pins archive == "" (L180); timeout-shape pins
/// 10*time.Minute structurally as str (L183); bundle-count
/// pins int (2) from the two calls (L186/L190);
/// errguard-count pins int (2) from the two guards
/// (L187/L191); comment-count pins int (3) from the header
/// (L175-177); all call pins pin spellings only (no helper
/// re-implementation anywhere).
/// Facet map (static baseline): archive-line pins the env
/// line (L179); getenv-call pins os.Getenv (L179); env-name
/// pins CAN_BUN_ARCHIVE (L179); gate-line pins the if line
/// (L180); gate-guard pins archive == "" (L180); skip-line
/// pins the full Skip line (L181); skip-call pins t.Skip
/// (L181); skip-diag pins the skip wording (L181); ctx-line
/// pins the full ctx line (L183); ctx-call pins
/// context.WithTimeout (L183); bg-call pins
/// context.Background() (L183); timeout-shape pins
/// 10*time.Minute (L183); cancel-line pins defer cancel()
/// (L184); err-guard pins err != nil (L187/L191); fatal-err
/// pins t.Fatal(err) (L188/L192); comment-share pins the
/// sharing line (L175); comment-fill pins the one-fill line
/// (L176); comment-stage pins the staged-only line (L177);
/// bundle-count pins 2 (L186/L190); errguard-count pins 2
/// (L187/L191); comment-count pins 3 (L175-177).
/// The verdict pins live in life-023-cache-semantics.can; the
/// run shape plus diagnostics live in life-023-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: CAN_BUN_ARCHIVE required; requires
/// can-bun-archive.
/// Logical gates CAN/FILES/WORK/BUILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 600000ms
/// mirrors the Go 10-minute ctx (L183); binds at P23.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/shared-roots checks: archive-line, getenv-call,
/// env-name, gate-line, gate-guard, skip-line, skip-call,
/// skip-diag, ctx-line, ctx-call, bg-call, timeout-shape,
/// cancel-line, err-guard, fatal-err, comment-share,
/// comment-fill, comment-stage, bundle-count,
/// errguard-count, comment-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str archive_line
    str getenv_call
    str env_name
    str gate_line
    str gate_guard
    str skip_line
    str skip_call
    str skip_diag
    str ctx_line
    str ctx_call
    str bg_call
    str timeout_shape
    str cancel_line
    str err_guard
    str fatal_err
    str comment_share
    str comment_fill
    str comment_stage
    int bundle_count
    int errguard_count
    int comment_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/shared-roots", "default", "", "offline"), "archive-line" => ok "case life/shared-roots variant default root archive-line run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/shared-roots", "default", "", "offline"), "archive-line" => ok evidence("archive-line", "true", "true", true, "case life/shared-roots variant default root archive-line run offline")
        different: false, true, context("life/shared-roots", "default", "", "offline"), "archive-line" => failed{"archive-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/shared-roots", "default", "", "offline"), "bundle-count" => ok evidence("bundle-count", "2", "2", true, "case life/shared-roots variant default root bundle-count run offline")
        different: 1, 2, context("life/shared-roots", "default", "", "offline"), "bundle-count" => failed{"bundle-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "archive := os.Getenv(\"CAN_BUN_ARCHIVE\")", "archive := os.Getenv(\"CAN_BUN_ARCHIVE\")", context("life/shared-roots", "default", "", "offline"), "archive-line" => ok evidence("archive-line", "archive := os.Getenv(\"CAN_BUN_ARCHIVE\")", "archive := os.Getenv(\"CAN_BUN_ARCHIVE\")", true, "case life/shared-roots variant default root archive-line run offline")
        different: "archive := os.Getenv(\"CAN_BUN_ARCHIVE\")_2", "archive := os.Getenv(\"CAN_BUN_ARCHIVE\")", context("life/shared-roots", "default", "", "offline"), "archive-line" => failed{"archive-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
