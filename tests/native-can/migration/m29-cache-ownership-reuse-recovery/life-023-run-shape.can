        str expected
        context c
        str check
    asserts
        same: "TestHarnessSharedEndToEnd", "TestHarnessSharedEndToEnd", context("life/shared-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestHarnessSharedEndToEnd", "TestHarnessSharedEndToEnd", true, "case life/shared-run variant default root test-name run offline")
        different: "TestHarnessSharedEndToEnd_2", "TestHarnessSharedEndToEnd", context("life/shared-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
