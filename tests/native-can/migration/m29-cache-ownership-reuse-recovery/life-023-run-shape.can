                                            failed
                                            ok evidence fatalf_fill_evidence => match call require_text(got.fatalf_call, "t.Fatalf", c, "fatalf-call")
                                                failed
                                                ok evidence fatalf_call_evidence => match call require_int(got.bundle_count, 2, c, "bundle-count")
                                                    failed
                                                    ok evidence bundle_count_evidence => match call require_int(got.fatalf_count, 2, c, "fatalf-count")
                                                        failed
                                                        ok evidence fatalf_count_evidence => ok
