fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/shared-run", "default", "", "offline") => ok
        seed_test_name: context("life/shared-run", "seed-test-name-drift", "", "offline") => failed{"test-name"}
        seed_sig_line: context("life/shared-run", "seed-sig-line-drift", "", "offline") => failed{"sig-line"}
        seed_before_leg: context("life/shared-run", "seed-before-leg-drift", "", "offline") => failed{"before-leg"}
        seed_first_leg: context("life/shared-run", "seed-first-leg-drift", "", "offline") => failed{"first-leg"}
        seed_second_leg: context("life/shared-run", "seed-second-leg-drift", "", "offline") => failed{"second-leg"}
        seed_identity_line: context("life/shared-run", "seed-identity-line-drift", "", "offline") => failed{"identity-line"}
        seed_fatalf_share: context("life/shared-run", "seed-fatalf-share-drift", "", "offline") => failed{"fatalf-share"}
        seed_fill_line: context("life/shared-run", "seed-fill-line-drift", "", "offline") => failed{"fill-line"}
        seed_fatalf_fill: context("life/shared-run", "seed-fatalf-fill-drift", "", "offline") => failed{"fatalf-fill"}
        seed_fatalf_call: context("life/shared-run", "seed-fatalf-call-drift", "", "offline") => failed{"fatalf-call"}
        seed_bundle_count: context("life/shared-run", "seed-bundle-count-drift", "", "offline") => failed{"bundle-count"}
        seed_fatalf_count: context("life/shared-run", "seed-fatalf-count-drift", "", "offline") => failed{"fatalf-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.test_name, "TestHarnessSharedEndToEnd", c, "test-name")
            failed
            ok evidence test_name_evidence => match call require_text(got.sig_line, "func TestHarnessSharedEndToEnd(t *testing.T) {", c, "sig-line")
                failed
                ok evidence sig_line_evidence => match call require_text(got.before_leg, "before := harnessBuilds.Load()", c, "before-leg")
                    failed
                    ok evidence before_leg_evidence => match call require_text(got.first_leg, "first, err := harnessBundle(t, ctx, archive)", c, "first-leg")
                        failed
                        ok evidence first_leg_evidence => match call require_text(got.second_leg, "second, err := harnessBundle(t, ctx, archive)", c, "second-leg")
                            failed
                            ok evidence second_leg_evidence => match call require_text(got.identity_line, "if first != second {", c, "identity-line")
                                failed
                                ok evidence identity_line_evidence => match call require_text(got.fatalf_share, "t.Fatalf(\"shared bundle paths differ: %q vs %q\", first, second)", c, "fatalf-share")
