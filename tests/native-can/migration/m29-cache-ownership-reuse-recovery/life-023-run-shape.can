/// M29 LIFE-023 "Shared bundle: run shape".
/// Source: tests/integration/harness_cache_test.go symbol
/// TestHarnessSharedEndToEnd (L175-200): comment trio
/// (L175-177); env gate (L179-182); ctx setup (L183-184);
/// before leg (L185); bundle legs (L186-193); identity
/// check (L194-196); fill check (L197-199).
/// Disposition: consolidate (this row ports
/// TestHarnessSharedEndToEnd to ordinary Can functions; the old
/// Go harness stays until the integrator retires it after
/// every linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the live run shape: the test name,
/// the full signature, the before leg, the two bundle legs,
/// the identity if line, the diverged-paths Fatalf leg, the
/// fill if line, the fills Fatalf leg, the Fatalf call, and
/// the bundle/Fatalf counts.
/// ADAPTATION (recorded, with source lines): sig-line pins
/// the full L178 spelling; identity-line pins the full L194
/// spelling; fatalf-share pins the full L195 spelling;
/// fill-line pins the full L197 spelling; fatalf-fill pins
/// the full L198 spelling; bundle-count pins int (2) from
/// the two legs (L186/L190); fatalf-count pins int (2) from
/// the two refusals (L195/L198).
/// Facet map (launch plus diagnostics): test-name pins
/// TestHarnessSharedEndToEnd (L178); sig-line pins the full
/// signature (L178); before-leg pins the before leg (L185);
/// first-leg pins the first leg (L186); second-leg pins the
/// repeat leg (L190); identity-line pins the identity line
/// (L194); fatalf-share pins the diverged leg (L195);
/// fill-line pins the fill line (L197); fatalf-fill pins the
/// fills leg (L198); fatalf-call pins t.Fatalf (L195/L198);
/// bundle-count pins 2 (L186/L190); fatalf-count pins 2
/// (L195/L198).
/// The verdict pins live in life-023-cache-semantics.can; the
/// roots-green pin lives in life-023-roots-green.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: CAN_BUN_ARCHIVE required; requires
/// can-bun-archive.
/// Logical gates CAN/FILES/WORK/BUILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 600000ms
/// mirrors the Go 10-minute ctx (L183); binds at P23.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/shared-run checks: test-name, sig-line,
/// before-leg, first-leg, second-leg, identity-line,
/// fatalf-share, fill-line, fatalf-fill, fatalf-call,
/// bundle-count, fatalf-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str sig_line
    str before_leg
    str first_leg
    str second_leg
    str identity_line
    str fatalf_share
    str fill_line
    str fatalf_fill
    str fatalf_call
    int bundle_count
    int fatalf_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/shared-run", "default", "", "offline"), "test-name" => ok "case life/shared-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/shared-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/shared-run variant default root test-name run offline")
        different: false, true, context("life/shared-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/shared-run", "default", "", "offline"), "bundle-count" => ok evidence("bundle-count", "2", "2", true, "case life/shared-run variant default root bundle-count run offline")
        different: 1, 2, context("life/shared-run", "default", "", "offline"), "bundle-count" => failed{"bundle-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
