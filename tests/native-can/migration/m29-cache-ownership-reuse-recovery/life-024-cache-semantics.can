    emits {}
    given
        str scope
    asserts
        m29_l024: "m29-l024" => ok [check("create-wording", "create diagnostic wording is pinned"), check("remove-wording", "remove diagnostic wording is pinned"), check("fill-wording", "fill-wait diagnostic wording is pinned"), check("manifest-wording", "manifest refusal wording is pinned"), check("verify-wording", "verify refusal wording is pinned"), check("verify-compare", "hash comparison spelling is pinned"), check("marker-compare", "marker comparison spelling is pinned"), check("fill-deadline", "fill deadline pins the 30m leg"), check("heavy-default", "heavy default pins three slots"), check("single-cache", "one leased cache per suite run"), check("key-memoized", "input key hashes once per pair"), check("atomic-publish", "rename publishes staged builds"), check("cleanup-after-fail", "cleanup runs after failed runs"), check("cleanup-overrides", "cleanup error overrides exit"), check("stale-reaped", "stale locks are reaped by age")]
        other: "nope" => ok []
    match scope is "m29-l024"
