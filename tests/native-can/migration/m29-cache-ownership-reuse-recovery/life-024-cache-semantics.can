        seed_fill_deadline: context("life/testmain-cache-semantics", "seed-fill-deadline-drift", "", "offline") => failed{"fill-deadline"}
        seed_heavy_default: context("life/testmain-cache-semantics", "seed-heavy-default-drift", "", "offline") => failed{"heavy-default"}
        seed_single_cache: context("life/testmain-cache-semantics", "seed-single-cache-drift", "", "offline") => failed{"single-cache"}
        seed_key_memoized: context("life/testmain-cache-semantics", "seed-key-memoized-drift", "", "offline") => failed{"key-memoized"}
        seed_atomic_publish: context("life/testmain-cache-semantics", "seed-atomic-publish-drift", "", "offline") => failed{"atomic-publish"}
        seed_cleanup_after_fail: context("life/testmain-cache-semantics", "seed-cleanup-after-fail-drift", "", "offline") => failed{"cleanup-after-fail"}
        seed_cleanup_overrides: context("life/testmain-cache-semantics", "seed-cleanup-overrides-drift", "", "offline") => failed{"cleanup-overrides"}
        seed_stale_reaped: context("life/testmain-cache-semantics", "seed-stale-reaped-drift", "", "offline") => failed{"stale-reaped"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.create_wording, "create suite bundle cache: %w", c, "create-wording")
            failed
            ok evidence create_wording_evidence => match call require_text(got.remove_wording, "remove suite bundle cache: %v", c, "remove-wording")
                failed
                ok evidence remove_wording_evidence => match call require_text(got.fill_wording, "harness cache fill wait: %w", c, "fill-wording")
                    failed
                    ok evidence fill_wording_evidence => match call require_text(got.manifest_wording, "unexpected bundle manifest in %s", c, "manifest-wording")
                        failed
                        ok evidence manifest_wording_evidence => match call require_text(got.verify_wording, "cached bundle file %s failed verification", c, "verify-wording")
                            failed
                            ok evidence verify_wording_evidence => match call require_text(got.verify_compare, "distribution.Hash(data) != want", c, "verify-compare")
                                failed
                                ok evidence verify_compare_evidence => match call require_text(got.marker_compare, "strings.TrimSpace(string(raw)) == key", c, "marker-compare")
                                    failed
                                    ok evidence marker_compare_evidence => match call require_text(got.fill_deadline, "30 * time.Minute", c, "fill-deadline")
                                        failed
