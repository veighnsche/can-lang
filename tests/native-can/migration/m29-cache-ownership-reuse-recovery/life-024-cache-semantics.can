package m29life024cache
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-024 "TestMain: cache semantics".
/// Source: tests/integration/harness_test.go symbol
/// TestMain (L149-151) plus runSuite (L153-161),
/// harnessRoot (L164-172), harnessKey (L177-220),
/// harnessFill (L224-251), harnessWaitForEntry
/// (L255-267), harnessReapStaleLock (L271-279),
/// harnessBuild (L283-305), harnessEntryComplete
/// (L308-314) plus harnessVerify (L319-341).
/// Disposition: replace_support (this row ports the
/// TestMain suite-cache contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the suite-cache verdicts in
/// Go order: the five diagnostic wordings, the two
/// comparison spellings, the fill deadline, the heavy
/// default, plus the single-cache, key-memoized,
/// atomic-publish, cleanup-after-fail,
/// cleanup-overrides and stale-reaped verdicts.
/// ADAPTATION (recorded, with source lines):
/// create-wording pins the Errorf format inner bytes
/// (L108); remove-wording pins the Fprintf format
/// inner bytes before the newline escape (L156);
/// fill-wording pins the Errorf format inner bytes
/// (L248); manifest-wording pins the Errorf format
/// inner bytes (L329); verify-wording pins the Errorf
/// format inner bytes (L337); verify-compare pins the
/// hash comparison (L336), never a re-hash;
/// marker-compare pins the marker comparison (L313);
/// fill-deadline pins the Add arg inner bytes (L232);
/// heavy-default pins int (3) from the default return
/// (L79); single-cache pins true since once.Do builds
/// one cache (L165); key-memoized pins true since the
/// memo hit returns the stored key (L183-185);
/// atomic-publish pins true since Rename publishes the
/// staged dir (L294); cleanup-after-fail pins true
/// since the defer runs after failed runs (L19, L154);
/// cleanup-overrides pins true since the defer assigns
/// code 1 over success (L155-158); stale-reaped pins
/// true since the age guard removes old locks
/// (L276-277).
/// Facet map (Go verdict legs): create-wording pins
/// the root-failure wording (L108); remove-wording
/// pins the close-failure wording (L156); fill-wording
/// pins the fill-wait wording (L248); manifest-wording
/// pins the bad-manifest wording (L329); verify-wording
/// pins the file-verify wording (L337); verify-compare
/// pins Hash(data) not-equal want (L336);
/// marker-compare pins TrimSpace(raw) equal key (L313);
/// fill-deadline pins the 30m leg (L232);
/// heavy-default pins 3 (L79); single-cache pins true
/// (L165); key-memoized pins true (L183);
/// atomic-publish pins true (L294); cleanup-after-fail
/// pins true (L19, L154); cleanup-overrides pins true
/// (L157); stale-reaped pins true (L276).
/// The roots-green pin lives in life-024-roots-green.can;
/// the run shape plus diagnostics live in
/// life-024-run-shape.can.
/// Variants: none (row lists zero variants; the single
/// passing path in Go order).
/// Environment: CAN_TEST_CACHE parent plus
/// CAN_TEST_HEAVY_SLOTS override (row lists 1 gate;
/// requires [] offline; binds at P23).
/// Logical gates SUITE/WORK/FILES/BUILD/CHILD/PROC/CLOCK
/// bind at P23; no live run now. Accept gate P23 is
/// unmet. Timeout 120000ms is the offline default bound
/// (no Go test timeout in this row; binds at P23 like
/// the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/testmain-cache-semantics checks:
/// create-wording, remove-wording, fill-wording,
/// manifest-wording, verify-wording, verify-compare,
/// marker-compare, fill-deadline, heavy-default,
/// single-cache, key-memoized, atomic-publish,
/// cleanup-after-fail, cleanup-overrides, stale-reaped.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str create_wording
    str remove_wording
    str fill_wording
    str manifest_wording
    str verify_wording
    str verify_compare
    str marker_compare
    str fill_deadline
    int heavy_default
    bool single_cache
    bool key_memoized
    bool atomic_publish
    bool cleanup_after_fail
    bool cleanup_overrides
    bool stale_reaped
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/testmain-cache-semantics", "default", "", "offline"), "create-wording" => ok "case life/testmain-cache-semantics variant default root create-wording run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/testmain-cache-semantics", "default", "", "offline"), "single-cache" => ok evidence("single-cache", "true", "true", true, "case life/testmain-cache-semantics variant default root single-cache run offline")
        different: false, true, context("life/testmain-cache-semantics", "default", "", "offline"), "single-cache" => failed{"single-cache"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("life/testmain-cache-semantics", "default", "", "offline"), "heavy-default" => ok evidence("heavy-default", "3", "3", true, "case life/testmain-cache-semantics variant default root heavy-default run offline")
        different: 2, 3, context("life/testmain-cache-semantics", "default", "", "offline"), "heavy-default" => failed{"heavy-default"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "create suite bundle cache: %w", "create suite bundle cache: %w", context("life/testmain-cache-semantics", "default", "", "offline"), "create-wording" => ok evidence("create-wording", "create suite bundle cache: %w", "create suite bundle cache: %w", true, "case life/testmain-cache-semantics variant default root create-wording run offline")
        different: "create suite bundle cache: %w_2", "create suite bundle cache: %w", context("life/testmain-cache-semantics", "default", "", "offline"), "create-wording" => failed{"create-wording"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
