/// M29 LIFE-024 "TestMain: roots green".
/// Source: tests/integration/harness_test.go static
/// baseline for TestMain (L149-151) plus runSuite
/// (L153-161), harnessRoot once guard (L165), cache
/// parent (L19, L166), slots decl (L68), cap helper
/// (L73-79), entry marker (L297, L309) plus manifest
/// name (L320).
/// Disposition: replace_support (this row ports the
/// TestMain suite-cache contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static baseline as the
/// green root: the TestMain symbol plus param, the
/// runSuite decl plus exit plus close plus override
/// plus run shapes, the once guard plus cache parent,
/// the slots decl plus cap name plus heavy env plus
/// minimum, plus the entry marker plus manifest name.
/// ADAPTATION (recorded, with source lines): test-name
/// pins the TestMain symbol (L149); test-param pins m
/// *testing.M (L149); run-decl pins the full decl
/// (L153); exit-shape pins the Exit call (L150);
/// close-guard pins the Close guard (L155);
/// override-shape pins the code assignment (L157);
/// run-shape pins the m.Run return (L160); once-shape
/// pins the once guard (L165); cache-parent pins
/// CAN_TEST_CACHE (L19, L166); slots-decl pins the
/// chan make (L68); cap-name pins heavySlotCap (L68,
/// L73); heavy-env pins CAN_TEST_HEAVY_SLOTS (L72,
/// L74); heavy-min pins n >= 1 (L75); entry-marker
/// pins cache-complete (L297, L309); manifest-name
/// pins manifest.json (L320).
/// Facet map (static baseline): test-name pins
/// TestMain (L149); test-param pins m *testing.M
/// (L149); run-decl pins the L153 decl; exit-shape pins
/// the L150 call; close-guard pins the L155 guard;
/// override-shape pins the L157 assign; run-shape pins
/// the L160 return; once-shape pins the L165 guard;
/// cache-parent pins the env name (L19, L166);
/// slots-decl pins the L68 make; cap-name pins the L73
/// helper; heavy-env pins the env name (L72, L74);
/// heavy-min pins the L75 floor; entry-marker pins the
/// marker name (L297, L309); manifest-name pins the
/// file name (L320).
/// The verdict pins live in life-024-cache-semantics.can;
/// the run shape plus diagnostics live in
/// life-024-run-shape.can.
/// Variants: none (row lists zero variants; the single
/// passing path in Go order).
/// Environment: CAN_TEST_CACHE parent plus
/// CAN_TEST_HEAVY_SLOTS override (row lists 1 gate;
/// requires [] offline; binds at P23).
/// Logical gates SUITE/WORK/FILES/BUILD/CHILD/PROC/CLOCK
/// bind at P23; no live run now. Accept gate P23 is
/// unmet. Timeout 120000ms is the offline default bound
/// (no Go test timeout in this row; binds at P23 like
/// the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/testmain-roots checks: test-name,
/// test-param, run-decl, exit-shape, close-guard,
/// override-shape, run-shape, once-shape, cache-parent,
/// slots-decl, cap-name, heavy-env, heavy-min,
/// entry-marker, manifest-name.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str test_param
    str run_decl
    str exit_shape
    str close_guard
    str override_shape
    str run_shape
    str once_shape
    str cache_parent
    str slots_decl
    str cap_name
    str heavy_env
    str heavy_min
    str entry_marker
    str manifest_name
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/testmain-roots", "default", "", "offline"), "test-name" => ok "case life/testmain-roots variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/testmain-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/testmain-roots variant default root test-name run offline")
        different: false, true, context("life/testmain-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/testmain-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "1", "1", true, "case life/testmain-roots variant default root test-name run offline")
        different: 2, 1, context("life/testmain-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestMain", "TestMain", context("life/testmain-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestMain", "TestMain", true, "case life/testmain-roots variant default root test-name run offline")
        different: "TestMain_2", "TestMain", context("life/testmain-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
