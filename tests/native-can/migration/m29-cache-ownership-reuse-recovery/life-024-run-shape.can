package m29life024run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M29 LIFE-024 "TestMain: run shape".
/// Source: tests/integration/harness_test.go symbol
/// TestMain (L149-151): exit (L150); defer (L154);
/// override (L157); run (L160); once (L165); key memo
/// (L183); key hash (L215); hit guard (L228); lock
/// (L234); poll leg (L263); reap guard (L276); rename
/// (L294); verify call sites (L119, L228, L237, L257,
/// L262, L300); complete call sites (L119, L228, L237,
/// L257, L262); wait call (L243) before reap call
/// (L246).
/// Disposition: replace_support (this row ports the
/// TestMain suite-cache contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the exit
/// plus defer plus override plus run spine, the once
/// guard, the key memo plus hash shapes, the hit guard
/// plus lock shapes, the poll leg, the reap guard, the
/// rename shape, the verify plus complete counts, and
/// the wait-before-reap order.
/// ADAPTATION (recorded, with source lines): shapes pin
/// the Go statement inner bytes without leading tabs
/// (L150, L154, L157, L160, L165, L183, L215, L228,
/// L234, L263, L276, L294); verify-count pins int (6)
/// from the six harnessVerify call sites (L119, L228,
/// L237, L257, L262, L300; decl L319 excluded);
/// complete-count pins int (5) from the five
/// harnessEntryComplete call sites (L119, L228, L237,
/// L257, L262; decl L308 excluded); wait-before-reap
/// pins true since the wait call precedes the reap call
/// (L243, L246).
/// Facet map (launch plus diagnostics): exit-stmt pins
/// the L150 exit; defer-stmt pins the L154 defer;
/// override-stmt pins the L157 assign; run-stmt pins
/// the L160 run; once-stmt pins the L165 guard;
/// memo-stmt pins the L183 memo; hash-stmt pins the
/// L215 hash; hit-stmt pins the L228 guard (same inner
/// bytes at L237, L257; L119 uses path); lock-stmt pins
/// the L234 lock; poll-stmt pins the L263 leg;
/// reap-stmt pins the L276 guard (no-space spelling);
/// rename-stmt pins the L294 publish; verify-count pins
/// 6 (L119, L228, L237, L257, L262, L300);
/// complete-count pins 5 (L119, L228, L237, L257,
/// L262); wait-before-reap pins true (L243, L246).
/// The verdict pins live in life-024-cache-semantics.can;
/// the roots-green pin lives in life-024-roots-green.can.
/// Variants: none (row lists zero variants; the single
/// passing path in Go order).
/// Environment: CAN_TEST_CACHE parent plus
/// CAN_TEST_HEAVY_SLOTS override (row lists 1 gate;
/// requires [] offline; binds at P23).
/// Logical gates SUITE/WORK/FILES/BUILD/CHILD/PROC/CLOCK
/// bind at P23; no live run now. Accept gate P23 is
/// unmet. Timeout 120000ms is the offline default bound
/// (no Go test timeout in this row; binds at P23 like
/// the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case life/testmain-run checks: exit-stmt, defer-stmt,
/// override-stmt, run-stmt, once-stmt, memo-stmt,
/// hash-stmt, hit-stmt, lock-stmt, poll-stmt, reap-stmt,
/// rename-stmt, verify-count, complete-count,
/// wait-before-reap.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str exit_stmt
    str defer_stmt
    str override_stmt
    str run_stmt
    str once_stmt
    str memo_stmt
    str hash_stmt
    str hit_stmt
    str lock_stmt
    str poll_stmt
    str reap_stmt
    str rename_stmt
    int verify_count
    int complete_count
    bool wait_before_reap
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/testmain-run", "default", "", "offline"), "exit-stmt" => ok "case life/testmain-run variant default root exit-stmt run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/testmain-run", "default", "", "offline"), "wait-before-reap" => ok evidence("wait-before-reap", "true", "true", true, "case life/testmain-run variant default root wait-before-reap run offline")
        different: false, true, context("life/testmain-run", "default", "", "offline"), "wait-before-reap" => failed{"wait-before-reap"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("life/testmain-run", "default", "", "offline"), "verify-count" => ok evidence("verify-count", "6", "6", true, "case life/testmain-run variant default root verify-count run offline")
        different: 5, 6, context("life/testmain-run", "default", "", "offline"), "verify-count" => failed{"verify-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "os.Exit(runSuite(m))", "os.Exit(runSuite(m))", context("life/testmain-run", "default", "", "offline"), "exit-stmt" => ok evidence("exit-stmt", "os.Exit(runSuite(m))", "os.Exit(runSuite(m))", true, "case life/testmain-run variant default root exit-stmt run offline")
        different: "os.Exit(runSuite(m))_2", "os.Exit(runSuite(m))", context("life/testmain-run", "default", "", "offline"), "exit-stmt" => failed{"exit-stmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
