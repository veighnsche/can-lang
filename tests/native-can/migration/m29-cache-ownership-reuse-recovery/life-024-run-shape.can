fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/testmain-run", "default", "", "offline") => ok
        seed_exit_stmt: context("life/testmain-run", "seed-exit-stmt-drift", "", "offline") => failed{"exit-stmt"}
        seed_defer_stmt: context("life/testmain-run", "seed-defer-stmt-drift", "", "offline") => failed{"defer-stmt"}
        seed_override_stmt: context("life/testmain-run", "seed-override-stmt-drift", "", "offline") => failed{"override-stmt"}
        seed_run_stmt: context("life/testmain-run", "seed-run-stmt-drift", "", "offline") => failed{"run-stmt"}
        seed_once_stmt: context("life/testmain-run", "seed-once-stmt-drift", "", "offline") => failed{"once-stmt"}
        seed_memo_stmt: context("life/testmain-run", "seed-memo-stmt-drift", "", "offline") => failed{"memo-stmt"}
        seed_hash_stmt: context("life/testmain-run", "seed-hash-stmt-drift", "", "offline") => failed{"hash-stmt"}
        seed_hit_stmt: context("life/testmain-run", "seed-hit-stmt-drift", "", "offline") => failed{"hit-stmt"}
        seed_lock_stmt: context("life/testmain-run", "seed-lock-stmt-drift", "", "offline") => failed{"lock-stmt"}
        seed_poll_stmt: context("life/testmain-run", "seed-poll-stmt-drift", "", "offline") => failed{"poll-stmt"}
        seed_reap_stmt: context("life/testmain-run", "seed-reap-stmt-drift", "", "offline") => failed{"reap-stmt"}
        seed_rename_stmt: context("life/testmain-run", "seed-rename-stmt-drift", "", "offline") => failed{"rename-stmt"}
        seed_verify_count: context("life/testmain-run", "seed-verify-count-drift", "", "offline") => failed{"verify-count"}
        seed_complete_count: context("life/testmain-run", "seed-complete-count-drift", "", "offline") => failed{"complete-count"}
        seed_wait_before_reap: context("life/testmain-run", "seed-wait-before-reap-drift", "", "offline") => failed{"wait-before-reap"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.exit_stmt, "os.Exit(runSuite(m))", c, "exit-stmt")
            failed
            ok evidence exit_stmt_evidence => match call require_text(got.defer_stmt, "defer func() {", c, "defer-stmt")
                failed
                ok evidence defer_stmt_evidence => match call require_text(got.override_stmt, "code = 1", c, "override-stmt")
                    failed
                    ok evidence override_stmt_evidence => match call require_text(got.run_stmt, "return m.Run()", c, "run-stmt")
                        failed
                        ok evidence run_stmt_evidence => match call require_text(got.once_stmt, "suiteCache.once.Do(func() {", c, "once-stmt")
                            failed
                            ok evidence once_stmt_evidence => match call require_text(got.memo_stmt, "if key, ok := harnessKeys[memo]; ok {", c, "memo-stmt")
                                failed
                                ok evidence memo_stmt_evidence => match call require_text(got.hash_stmt, "key := distribution.Hash([]byte(sb.String()))", c, "hash-stmt")
                                    failed
                                    ok evidence hash_stmt_evidence => match call require_text(got.hit_stmt, "if harnessEntryComplete(entry, key) && harnessVerify(entry) == nil {", c, "hit-stmt")
                                        failed
                                        ok evidence hit_stmt_evidence => match call require_text(got.lock_stmt, "if err := os.Mkdir(lock, 0755); err == nil {", c, "lock-stmt")
                                            failed
                                            ok evidence lock_stmt_evidence => match call require_text(got.poll_stmt, "case <-time.After(500 * time.Millisecond):", c, "poll-stmt")
                                                failed
                                                ok evidence poll_stmt_evidence => match call require_text(got.reap_stmt, "if time.Since(info.ModTime()) > 30*time.Minute {", c, "reap-stmt")
                                                    failed
                                                    ok evidence reap_stmt_evidence => match call require_text(got.rename_stmt, "if err := os.Rename(built, entry); err != nil {", c, "rename-stmt")
                                                        failed
                                                        ok evidence rename_stmt_evidence => match call require_int(got.verify_count, 6, c, "verify-count")
                                                            failed
                                                            ok evidence verify_count_evidence => match call require_int(got.complete_count, 5, c, "complete-count")
                                                                failed
                                                                ok evidence complete_count_evidence => match call require_bool(got.wait_before_reap, true, c, "wait-before-reap")
                                                                    failed
                                                                    ok evidence wait_before_reap_evidence => ok
