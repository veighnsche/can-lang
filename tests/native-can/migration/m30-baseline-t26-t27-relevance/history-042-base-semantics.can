package m30history042base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-042 "Toolchain freeze: base semantics".
/// Source: tests/baseline/baseline_test.go symbol
/// TestBaselineToolchainMatchesFreeze (L68-102) plus
/// frozen values in tests/baseline/baseline.json.
/// Disposition: consolidate (this row ports
/// TestBaselineToolchainMatchesFreeze to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the frozen comparison legs in
/// Go order (task/date freeze vs bun version vs bun
/// revision vs go minimum vs full-sha shape vs
/// ancestor), the exact frozen values, the guard
/// spellings, the seven refusal wordings, and the go
/// minor floor.
/// ADAPTATION (recorded, with source lines): task-value
/// pins T01 (J task); task-guard pins the task
/// not-equal spelling (L73); date-guard pins the date
/// empty spelling (L73); task-fatal pins the task/date
/// inner bytes (L74); bun-version pins 1.4.2 (J
/// bun/version); bun-version-guard pins the version
/// not-equal spelling (L76); bun-version-fatal pins
/// the version inner bytes (L77); bun-revision pins
/// 1.4.2+744846f84 (J bun/revision);
/// bun-revision-guard pins the revision not-equal
/// spelling (L79); bun-revision-fatal pins the
/// revision inner bytes (L80); go-minimum pins the
/// minimum wording (J go/minimum); go-minor-guard pins
/// the below-floor spelling (L91); go-below-fatal pins
/// the below-floor inner bytes (L92);
/// unparseable-fatal pins the unparseable inner bytes
/// (L85); compiler-revision pins the frozen sha (J
/// compiler/revision); sha-shape pins the 40-nibble
/// shape (L94); sha-fatal pins the not-a-sha inner
/// bytes (L95); ancestor-fatal pins the not-ancestor
/// inner bytes (L100); go-minor-floor pins int (25)
/// from the floor guard (L91); guards pin spellings
/// only (no probe or ancestry re-implementation
/// anywhere).
/// Facet map (freeze legs): task-value pins T01 (J);
/// task-guard pins the task not-equal (L73);
/// date-guard pins the date empty (L73); task-fatal
/// pins task/date refusal (L74); bun-version pins
/// 1.4.2 (J); bun-version-guard pins the version
/// not-equal (L76); bun-version-fatal pins version
/// refusal (L77); bun-revision pins 1.4.2+744846f84
/// (J); bun-revision-guard pins the revision
/// not-equal (L79); bun-revision-fatal pins revision
/// refusal (L80); go-minimum pins the minimum wording
/// (J); go-minor-guard pins below-floor (L91);
/// go-below-fatal pins below-floor refusal (L92);
/// unparseable-fatal pins unparseable refusal (L85);
/// compiler-revision pins the frozen sha (J);
/// sha-shape pins the 40-nibble shape (L94); sha-fatal
/// pins not-a-sha refusal (L95); ancestor-fatal pins
/// not-ancestor refusal (L100); go-minor-floor pins 25
/// (L91).
/// The roots-green pin lives in
/// history-042-roots-green.can; the run shape plus
/// diagnostics live in history-042-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 120000ms
/// is the offline default bound (no Go timeout in this row;
/// binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/toolchain-freeze checks: task-value,
/// task-guard, date-guard, task-fatal, bun-version,
/// bun-version-guard, bun-version-fatal, bun-revision,
/// bun-revision-guard, bun-revision-fatal, go-minimum,
/// go-minor-guard, go-below-fatal, unparseable-fatal,
/// compiler-revision, sha-shape, sha-fatal,
/// ancestor-fatal, go-minor-floor.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str task_value
    str task_guard
    str date_guard
    str task_fatal
    str bun_version
    str bun_version_guard
    str bun_version_fatal
    str bun_revision
    str bun_revision_guard
    str bun_revision_fatal
    str go_minimum
    str go_minor_guard
    str go_below_fatal
    str unparseable_fatal
    str compiler_revision
    str sha_shape
    str sha_fatal
    str ancestor_fatal
    int go_minor_floor
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/toolchain-freeze", "default", "", "offline"), "task-value" => ok "case history/toolchain-freeze variant default root task-value run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/toolchain-freeze", "default", "", "offline"), "task-value" => ok evidence("task-value", "true", "true", true, "case history/toolchain-freeze variant default root task-value run offline")
        different: false, true, context("history/toolchain-freeze", "default", "", "offline"), "task-value" => failed{"task-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 25, 25, context("history/toolchain-freeze", "default", "", "offline"), "go-minor-floor" => ok evidence("go-minor-floor", "25", "25", true, "case history/toolchain-freeze variant default root go-minor-floor run offline")
        different: 24, 25, context("history/toolchain-freeze", "default", "", "offline"), "go-minor-floor" => failed{"go-minor-floor"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "T01", "T01", context("history/toolchain-freeze", "default", "", "offline"), "task-value" => ok evidence("task-value", "T01", "T01", true, "case history/toolchain-freeze variant default root task-value run offline")
        different: "T01_2", "T01", context("history/toolchain-freeze", "default", "", "offline"), "task-value" => failed{"task-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
