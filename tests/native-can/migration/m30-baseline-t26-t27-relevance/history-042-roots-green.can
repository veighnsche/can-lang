/// M30 HISTORY-042 "Toolchain freeze: roots green".
/// Source: tests/baseline/baseline_test.go symbol
/// TestBaselineToolchainMatchesFreeze (L68-102) plus
/// frozen values in tests/baseline/baseline.json.
/// Disposition: consolidate (this row ports
/// TestBaselineToolchainMatchesFreeze to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static frozen roots as
/// the green root: the frozen file join, the frozen
/// record shape plus date, the or join, the bun and go
/// probe spellings, the go minor pattern plus parse
/// calls, the nil guard, the times-ten step, the sha
/// match call plus not-ok guard, the git ancestor
/// probe plus err guard, the got binding, and the sha
/// length.
/// ADAPTATION (recorded, with source lines):
/// freeze-path pins the full join spelling (L71);
/// frozen-type pins baselineFile (L70); frozen-date
/// pins 2026-09-24 (J date); or-op pins || (L73) as
/// the task/date join; bun-probe pins the full bun
/// version probe spelling (L76); bun-rev-probe pins
/// the full bun revision probe spelling (L79);
/// go-probe pins the full go probe spelling (L82);
/// go-pattern pins the minor pattern inner bytes
/// (L83); must-compile pins regexp.MustCompile (L83);
/// go-parse pins FindStringSubmatch(goVer) (L83);
/// nil-guard pins the m nil spelling (L84);
/// minor-step pins the times-ten spelling (L89);
/// match-call pins the full MatchString spelling
/// (L94); sha-guard pins !ok (L94); git-probe pins
/// the full git call spelling (L97); ancestor-guard
/// pins err != nil (L99); got-name pins got (L76);
/// sha-length pins int (40) from the shape braces
/// (L94); all call pins pin spellings only (no probe
/// or ancestry re-implementation anywhere).
/// Facet map (static roots): freeze-path pins the
/// join (L71); frozen-type pins baselineFile (L70);
/// frozen-date pins 2026-09-24 (J); or-op pins ||
/// (L73); bun-probe pins the version probe (L76);
/// bun-rev-probe pins the revision probe (L79);
/// go-probe pins the go probe (L82); go-pattern pins
/// the minor pattern (L83); must-compile pins
/// MustCompile (L83); go-parse pins
/// FindStringSubmatch (L83); nil-guard pins m nil
/// (L84); minor-step pins times-ten (L89);
/// match-call pins MatchString (L94); sha-guard pins
/// !ok (L94); git-probe pins the git call (L97);
/// ancestor-guard pins err guard (L99); got-name pins
/// got (L76); sha-length pins 40 (L94).
/// The base pins live in
/// history-042-base-semantics.can; the run shape plus
/// diagnostics live in history-042-run-shape.can.
/// Variants: none (row lists zero variants; default plus
/// seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23; no
/// live run now. Accept gate P23 is unmet. Timeout 120000ms
/// is the offline default bound (no Go timeout in this row;
/// binds at P23 like the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/toolchain-roots checks: freeze-path,
/// frozen-type, frozen-date, or-op, bun-probe,
/// bun-rev-probe, go-probe, go-pattern, must-compile,
/// go-parse, nil-guard, minor-step, match-call,
/// sha-guard, git-probe, ancestor-guard, got-name,
/// sha-length.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str freeze_path
    str frozen_type
    str frozen_date
    str or_op
    str bun_probe
    str bun_rev_probe
    str go_probe
    str go_pattern
    str must_compile
    str go_parse
    str nil_guard
    str minor_step
    str match_call
    str sha_guard
    str git_probe
    str ancestor_guard
    str got_name
    int sha_length
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/toolchain-roots", "default", "", "offline"), "freeze-path" => ok "case history/toolchain-roots variant default root freeze-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/toolchain-roots", "default", "", "offline"), "freeze-path" => ok evidence("freeze-path", "true", "true", true, "case history/toolchain-roots variant default root freeze-path run offline")
        different: false, true, context("history/toolchain-roots", "default", "", "offline"), "freeze-path" => failed{"freeze-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 40, 40, context("history/toolchain-roots", "default", "", "offline"), "sha-length" => ok evidence("sha-length", "40", "40", true, "case history/toolchain-roots variant default root sha-length run offline")
        different: 39, 40, context("history/toolchain-roots", "default", "", "offline"), "sha-length" => failed{"sha-length"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "filepath.Join(root, \"tests\", \"baseline\", \"baseline.json\")", "filepath.Join(root, \"tests\", \"baseline\", \"baseline.json\")", context("history/toolchain-roots", "default", "", "offline"), "freeze-path" => ok evidence("freeze-path", "filepath.Join(root, \"tests\", \"baseline\", \"baseline.json\")", "filepath.Join(root, \"tests\", \"baseline\", \"baseline.json\")", true, "case history/toolchain-roots variant default root freeze-path run offline")
        different: "filepath.Join(root, \"tests\", \"baseline\", \"baseline.json\")_2", "filepath.Join(root, \"tests\", \"baseline\", \"baseline.json\")", context("history/toolchain-roots", "default", "", "offline"), "freeze-path" => failed{"freeze-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
