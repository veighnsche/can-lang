record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str load_call
    str task_fatal
    str bun_version_fatal
    str bun_revision_fatal
    str unparseable_fatal
    str go_below_fatal
    str sha_fatal
    str ancestor_fatal
    str fatal_call
    str go_ver_name
    str minor_name
    str cmd_dir
    int fatal_count
    int run_count
    int bun_leg_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/toolchain-run", "default", "", "offline"), "test-name" => ok "case history/toolchain-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/toolchain-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/toolchain-run variant default root test-name run offline")
        different: false, true, context("history/toolchain-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 7, 7, context("history/toolchain-run", "default", "", "offline"), "fatal-count" => ok evidence("fatal-count", "7", "7", true, "case history/toolchain-run variant default root fatal-count run offline")
        different: 6, 7, context("history/toolchain-run", "default", "", "offline"), "fatal-count" => failed{"fatal-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
