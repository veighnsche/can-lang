package m30history043base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-043 "Registry complete: doc facts".
/// Source: tests/baseline/registry.json (R, one line)
/// plus tests/baseline/baseline_test.go symbol
/// TestRegistryComplete (L155-217) plus registryFile
/// (L104-150).
/// Disposition: historical_candidate (this row pins the
/// TestRegistryComplete offline pact as reviewable Can
/// facts; the old Go check stays until the integrator
/// retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the registry doc facts in
/// member order: the T01 task, the seven case ids, the
/// standard trial name, the pending candidate slot,
/// the frozen model/effort pairs, and the case/trial/
/// candidate/prompt/fixture/held-out/hidden/attempt
/// counts.
/// ADAPTATION (recorded, with source lines): task pins
/// T01 (R); case ids pin the seven id members in doc
/// order (R); trial name pins standard (R); candidate
/// slot pins pending (R); frozen pairs pin the
/// primary/efficient/escalation model plus effort
/// members (R); counts pin ints tallied from R
/// members: seven cases, one trial, seven pending
/// slots, three prompt kinds, twelve fixtures, seven
/// held-out ids, fourteen hidden checks, five
/// attempts.
/// Facet map (doc members): registry-task pins T01
/// (R); case-id-0 pins closed-variant-arm (R);
/// case-id-1 pins two-libraries (R); case-id-2 pins
/// fixture-link (R); case-id-3 pins invoice-edit (R);
/// case-id-4 pins stream-cleanup (R); case-id-5 pins
/// invoice-grid (R); case-id-6 pins native-judgment
/// (R); trial-name pins standard (R); candidate-status
/// pins pending (R); primary-model pins gpt-6-sol (R);
/// primary-effort pins medium (R); efficient-model
/// pins gpt-6-luna (R); efficient-effort pins medium
/// (R); escalation-model pins gpt-6-astra (R);
/// escalation-effort pins high (R); case-count pins 7
/// (R); trial-count pins 1 (R); candidate-count pins
/// 7 (R); prompt-kind-count pins 3 (R); fixture-total
/// pins 12 (R); heldout-count pins 7 (R); hidden-total
/// pins 14 (R); trial-attempts pins 5 (R).
/// The roots-green pin lives in
/// history-043-roots-green.can; the run shape plus
/// diagnostics live in history-043-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates SUITE/DOC/FILES/PROC/BUILD/WORK bind
/// at P23; no live run now. Accept gate P23 is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet).
/// Case history/registry-base checks: registry-task,
/// case-id-0, case-id-1, case-id-2, case-id-3,
/// case-id-4, case-id-5, case-id-6, trial-name,
/// candidate-status, primary-model, primary-effort,
/// efficient-model, efficient-effort, escalation-model,
/// escalation-effort, case-count, trial-count,
/// candidate-count, prompt-kind-count, fixture-total,
/// heldout-count, hidden-total, trial-attempts.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str registry_task
    str case_id_0
    str case_id_1
    str case_id_2
    str case_id_3
    str case_id_4
    str case_id_5
    str case_id_6
    str trial_name
    str candidate_status
    str primary_model
    str primary_effort
    str efficient_model
    str efficient_effort
    str escalation_model
    str escalation_effort
    int case_count
    int trial_count
    int candidate_count
    int prompt_kind_count
    int fixture_total
    int heldout_count
    int hidden_total
    int trial_attempts
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/registry-base", "default", "", "offline"), "registry-task" => ok "case history/registry-base variant default root registry-task run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/registry-base", "default", "", "offline"), "registry-task" => ok evidence("registry-task", "true", "true", true, "case history/registry-base variant default root registry-task run offline")
        different: false, true, context("history/registry-base", "default", "", "offline"), "registry-task" => failed{"registry-task"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 7, 7, context("history/registry-base", "default", "", "offline"), "case-count" => ok evidence("case-count", "7", "7", true, "case history/registry-base variant default root case-count run offline")
        different: 6, 7, context("history/registry-base", "default", "", "offline"), "case-count" => failed{"case-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "T01", "T01", context("history/registry-base", "default", "", "offline"), "registry-task" => ok evidence("registry-task", "T01", "T01", true, "case history/registry-base variant default root registry-task run offline")
        different: "T01_2", "T01", context("history/registry-base", "default", "", "offline"), "registry-task" => failed{"registry-task"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
