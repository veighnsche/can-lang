record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str type_name
    str loader_call
    str root_call
    str json_file
    str task_guard
    str empty_guard
    str dup_guard
    str family_guard
    str prompt_guard
    str fixture_guard
    str stat_call
    str candidate_guard
    str heldout_guard
    str hidden_guard
    str hidden_one_guard
    str trial_guard
    str fatal_call
    int attempts_want
    int fatal_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/registry-roots", "default", "", "offline"), "test-name" => ok "case history/registry-roots variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/registry-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/registry-roots variant default root test-name run offline")
        different: false, true, context("history/registry-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("history/registry-roots", "default", "", "offline"), "attempts-want" => ok evidence("attempts-want", "5", "5", true, "case history/registry-roots variant default root attempts-want run offline")
        different: 4, 5, context("history/registry-roots", "default", "", "offline"), "attempts-want" => failed{"attempts-want"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestRegistryComplete", "TestRegistryComplete", context("history/registry-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestRegistryComplete", "TestRegistryComplete", true, "case history/registry-roots variant default root test-name run offline")
        different: "TestRegistryComplete_2", "TestRegistryComplete", context("history/registry-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
