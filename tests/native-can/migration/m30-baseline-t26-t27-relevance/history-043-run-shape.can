package m30history043run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-043 "Registry complete: run shape".
/// Source: tests/baseline/baseline_test.go symbol
/// TestRegistryComplete (L155-217): task leg
/// (L160-162); empty leg (L163-165); id loop with dup
/// guard (L166-171); family leg (L172-174); prompt leg
/// (L175-177); fixture legs (L178-185); candidate leg
/// (L186-188); held-out leg (L189-191); hidden legs
/// (L192-199); trial legs (L200-215).
/// Disposition: historical_candidate (this row pins the
/// TestRegistryComplete offline pact as reviewable Can
/// facts; the old Go check stays until the integrator
/// retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the live run shape: the test
/// name, the sixteen refusal wordings in Go order,
/// and the refusal count.
/// ADAPTATION (recorded, with source lines): test-name
/// pins TestRegistryComplete (L155); fatal-task pins
/// the task inner bytes (L161); fatal-empty pins the
/// empty inner bytes (L164); fatal-dup pins the dup
/// inner bytes (L169); fatal-family pins the family
/// inner bytes (L174); fatal-prompts pins the prompt
/// inner bytes (L176); fatal-fixtures pins the
/// fixture inner bytes (L179); fatal-fixture-missing
/// pins the missing inner bytes (L183);
/// fatal-candidate pins the candidate inner bytes
/// (L187); fatal-heldout pins the held-out inner
/// bytes (L190); fatal-hidden pins the hidden inner
/// bytes (L193); fatal-hidden-one pins the hidden-one
/// inner bytes (L197); fatal-trial pins the trial
/// inner bytes (L202); fatal-attempts pins the
/// attempts inner bytes (L205); fatal-primary pins
/// the primary inner bytes (L208); fatal-efficient
/// pins the efficient inner bytes (L211);
/// fatal-escalation pins the escalation inner bytes
/// (L214); fatal-count pins int (16) from the sixteen
/// legs (L161/L164/L169/L174/L176/L179/L183/L187/
/// L190/L193/L197/L202/L205/L208/L211/L214).
/// Facet map (launch plus diagnostics): test-name pins
/// TestRegistryComplete (L155); fatal-task pins task
/// plus quoted got (L161); fatal-empty pins no cases
/// (L164); fatal-dup pins missing-or-duplicated plus
/// quoted id (L169); fatal-family pins missing
/// family/workload (L174); fatal-prompts pins the
/// missing triple (L176); fatal-fixtures pins missing
/// fixtures/run (L179); fatal-fixture-missing pins
/// case plus fixture plus err (L183); fatal-candidate
/// pins pending plus owner (L187); fatal-heldout pins
/// the missing variant triple (L190); fatal-hidden
/// pins no checks (L193); fatal-hidden-one pins one
/// incomplete check (L197); fatal-trial pins unknown
/// trial plus quoted name (L202); fatal-attempts pins
/// got plus want 5 (L205); fatal-primary pins got
/// plus sol/medium (L208); fatal-efficient pins got
/// plus luna/medium (L211); fatal-escalation pins got
/// plus astra/high (L214); fatal-count pins 16 (L161
/// through L214).
/// The doc facts live in
/// history-043-base-semantics.can; the roots-green pin
/// lives in history-043-roots-green.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates SUITE/DOC/FILES/PROC/BUILD/WORK bind
/// at P23; no live run now. Accept gate P23 is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet).
/// Case history/registry-run checks: test-name,
/// fatal-task, fatal-empty, fatal-dup, fatal-family,
/// fatal-prompts, fatal-fixtures, fatal-fixture-missing,
/// fatal-candidate, fatal-heldout, fatal-hidden,
/// fatal-hidden-one, fatal-trial, fatal-attempts,
/// fatal-primary, fatal-efficient, fatal-escalation,
/// fatal-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str fatal_task
    str fatal_empty
    str fatal_dup
    str fatal_family
    str fatal_prompts
    str fatal_fixtures
    str fatal_fixture_missing
    str fatal_candidate
    str fatal_heldout
    str fatal_hidden
    str fatal_hidden_one
    str fatal_trial
    str fatal_attempts
    str fatal_primary
    str fatal_efficient
    str fatal_escalation
    int fatal_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/registry-run", "default", "", "offline"), "test-name" => ok "case history/registry-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/registry-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/registry-run variant default root test-name run offline")
        different: false, true, context("history/registry-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 16, 16, context("history/registry-run", "default", "", "offline"), "fatal-count" => ok evidence("fatal-count", "16", "16", true, "case history/registry-run variant default root fatal-count run offline")
        different: 15, 16, context("history/registry-run", "default", "", "offline"), "fatal-count" => failed{"fatal-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestRegistryComplete", "TestRegistryComplete", context("history/registry-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestRegistryComplete", "TestRegistryComplete", true, "case history/registry-run variant default root test-name run offline")
        different: "TestRegistryComplete_2", "TestRegistryComplete", context("history/registry-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
