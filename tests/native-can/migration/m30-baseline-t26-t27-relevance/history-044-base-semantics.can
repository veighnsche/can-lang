package m30history044base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-044 "Smoke repeatable: base verdicts".
/// Source: tests/baseline/baseline_test.go symbol
/// TestHarnessSmokeRepeatable (L231-268) plus the
/// smokeReport struct (L219-227).
/// Disposition: replace_support (this row ports the
/// smoke-repeatable offline contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the passing-path verdicts in
/// Go order: the seven diagnostic wordings, the five
/// comparison spellings, the fatal count, plus the
/// retain-before-run and cleanup-after-parse order
/// verdicts.
/// ADAPTATION (recorded, with source lines):
/// missing-wording pins the Fatalf format inner bytes
/// (L235); run-wording pins the format head before the
/// newline escape (L244); report-wording pins the head
/// before the newline escape (L248); clean-wording pins
/// the full format (L255); disposable-wording pins the
/// full format (L258); inside-wording pins the full
/// format (L261); step-wording pins the full format
/// (L265); mode-compare pins the guard head before the
/// quoted literal (L254); failures-compare pins the
/// zero guard tail (L254); temp-compare pins the
/// disposable guard (L257); root-compare pins the
/// source-tree guard (L260); step-compare pins the
/// status guard head before the quoted literal (L264);
/// fatal-count pins int (7) from the seven Fatalf call
/// sites (L235, L244, L248, L255, L258, L261, L265);
/// retain-before-run pins true since the KEEP_DIR keep
/// (L239) precedes the smoke run (L243);
/// cleanup-after-parse pins true since the Cleanup
/// join (L251) follows the report-line parse
/// (L246-250).
/// Facet map (Go verdict legs): missing-wording pins
/// the exec-guard wording (L235); run-wording pins the
/// run-failure head (L244); report-wording pins the
/// absent-line head (L248); clean-wording pins the
/// unclean-report wording (L255); disposable-wording
/// pins the non-disposable wording (L258);
/// inside-wording pins the inside-source wording
/// (L261); step-wording pins the failed-step wording
/// (L265); mode-compare pins the mode guard (L254);
/// failures-compare pins the zero guard (L254);
/// temp-compare pins the TempDir guard (L257);
/// root-compare pins the root guard (L260);
/// step-compare pins the status guard (L264);
/// fatal-count pins 7; retain-before-run pins true
/// (L239, L243); cleanup-after-parse pins true (L250,
/// L251).
/// The roots-green pin lives in
/// history-044-roots-green.can; the run shape plus
/// diagnostics live in history-044-run-shape.can.
/// Variants: none (row lists zero variants; the single
/// passing path in Go order).
/// Environment: KEEP_DIR retain plus os TempDir parent
/// (row lists 1 gate; requires [] offline; binds at
/// P23).
/// Logical gates SUITE/WORK/FILES/BUILD/CHILD/PROC/CLOCK
/// bind at P23; no live run now. Accept gate P23 is
/// unmet. Timeout 120000ms is the offline default bound
/// (no Go test timeout in this row; binds at P23 like
/// the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/smoke-repeatable-base checks:
/// missing-wording, run-wording, report-wording,
/// clean-wording, disposable-wording, inside-wording,
/// step-wording, mode-compare, failures-compare,
/// temp-compare, root-compare, step-compare,
/// fatal-count, retain-before-run, cleanup-after-parse.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str missing_wording
    str run_wording
    str report_wording
    str clean_wording
    str disposable_wording
    str inside_wording
    str step_wording
    str mode_compare
    str failures_compare
    str temp_compare
    str root_compare
    str step_compare
    int fatal_count
    bool retain_before_run
    bool cleanup_after_parse
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/smoke-repeatable-base", "default", "", "offline"), "missing-wording" => ok "case history/smoke-repeatable-base variant default root missing-wording run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/smoke-repeatable-base", "default", "", "offline"), "retain-before-run" => ok evidence("retain-before-run", "true", "true", true, "case history/smoke-repeatable-base variant default root retain-before-run run offline")
        different: false, true, context("history/smoke-repeatable-base", "default", "", "offline"), "retain-before-run" => failed{"retain-before-run"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 7, 7, context("history/smoke-repeatable-base", "default", "", "offline"), "fatal-count" => ok evidence("fatal-count", "7", "7", true, "case history/smoke-repeatable-base variant default root fatal-count run offline")
        different: 6, 7, context("history/smoke-repeatable-base", "default", "", "offline"), "fatal-count" => failed{"fatal-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "harness %s missing or not executable", "harness %s missing or not executable", context("history/smoke-repeatable-base", "default", "", "offline"), "missing-wording" => ok evidence("missing-wording", "harness %s missing or not executable", "harness %s missing or not executable", true, "case history/smoke-repeatable-base variant default root missing-wording run offline")
        different: "harness %s missing or not executable_2", "harness %s missing or not executable", context("history/smoke-repeatable-base", "default", "", "offline"), "missing-wording" => failed{"missing-wording"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
