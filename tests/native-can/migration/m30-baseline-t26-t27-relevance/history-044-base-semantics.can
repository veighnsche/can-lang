                                                            failed
                                                            ok evidence fatal_count_evidence => match call require_bool(got.retain_before_run, true, c, "retain-before-run")
                                                                failed
                                                                ok evidence retain_before_run_evidence => match call require_bool(got.cleanup_after_parse, true, c, "cleanup-after-parse")
                                                                    failed
                                                                    ok evidence cleanup_after_parse_evidence => ok
