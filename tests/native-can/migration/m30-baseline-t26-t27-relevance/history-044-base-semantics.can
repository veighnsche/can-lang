        seed_root_compare: context("history/smoke-repeatable-base", "seed-root-compare-drift", "", "offline") => failed{"root-compare"}
        seed_step_compare: context("history/smoke-repeatable-base", "seed-step-compare-drift", "", "offline") => failed{"step-compare"}
        seed_fatal_count: context("history/smoke-repeatable-base", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
        seed_retain_before_run: context("history/smoke-repeatable-base", "seed-retain-before-run-drift", "", "offline") => failed{"retain-before-run"}
        seed_cleanup_after_parse: context("history/smoke-repeatable-base", "seed-cleanup-after-parse-drift", "", "offline") => failed{"cleanup-after-parse"}
