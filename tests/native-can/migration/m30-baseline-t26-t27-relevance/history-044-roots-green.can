package m30history044roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-044 "Smoke repeatable: roots green".
/// Source: tests/baseline/baseline_test.go static
/// baseline for TestHarnessSmokeRepeatable (L231-233)
/// plus the smokeReport struct (L219-227), the keep
/// value (L239) plus the load call (L253).
/// Disposition: replace_support (this row ports the
/// smoke-repeatable offline contract to ordinary Can
/// functions; the old Go harness stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the static baseline as the
/// green root: the test symbol plus param, the report
/// decl plus its five field spellings, the script join
/// plus tail, the smoke flag, the keep value, plus the
/// root helper and load helper call shapes.
/// ADAPTATION (recorded, with source lines): test-name
/// pins the TestHarnessSmokeRepeatable symbol (L231);
/// test-param pins t *testing.T (L231); report-decl pins
/// the full decl (L219); mode-field pins the Mode head
/// (L220); failures-field pins the Failures head (L221);
/// dir-field pins the Dir head (L222); steps-field pins
/// the Steps line (L223); name-field pins the Name head
/// (L224); status-field pins the Status head (L225);
/// script-join pins the Join head before the quoted
/// segs (L233); script-tail pins run.sh (L233, L244);
/// smoke-flag pins --smoke (L237, L244); keep-env pins
/// KEEP_DIR=1 (L239); root-helper pins the repoRoot call
/// (L232); load-helper pins the loadJSON call (L253).
/// Facet map (static baseline): test-name pins the
/// symbol (L231); test-param pins the param (L231);
/// report-decl pins the decl (L219); mode-field pins
/// the head (L220); failures-field pins the head
/// (L221); dir-field pins the head (L222); steps-field
/// pins the line (L223); name-field pins the head
/// (L224); status-field pins the head (L225);
/// script-join pins the head (L233); script-tail pins
/// the tail (L233, L244); smoke-flag pins the flag
/// (L237, L244); keep-env pins the keep value (L239);
/// root-helper pins the call (L232); load-helper pins
/// the call (L253).
/// The verdict pins live in
/// history-044-base-semantics.can; the run shape plus
/// diagnostics live in history-044-run-shape.can.
/// Variants: none (row lists zero variants; the single
/// passing path in Go order).
/// Environment: KEEP_DIR retain plus os TempDir parent
/// (row lists 1 gate; requires [] offline; binds at
/// P23).
/// Logical gates SUITE/WORK/FILES/BUILD/CHILD/PROC/CLOCK
/// bind at P23; no live run now. Accept gate P23 is
/// unmet. Timeout 120000ms is the offline default bound
/// (no Go test timeout in this row; binds at P23 like
/// the M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/smoke-repeatable-roots checks: test-name,
/// test-param, report-decl, mode-field, failures-field,
/// dir-field, steps-field, name-field, status-field,
/// script-join, script-tail, smoke-flag, keep-env,
/// root-helper, load-helper.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str test_param
    str report_decl
    str mode_field
    str failures_field
    str dir_field
    str steps_field
    str name_field
    str status_field
    str script_join
    str script_tail
    str smoke_flag
    str keep_env
    str root_helper
    str load_helper
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/smoke-repeatable-roots", "default", "", "offline"), "test-name" => ok "case history/smoke-repeatable-roots variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/smoke-repeatable-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/smoke-repeatable-roots variant default root test-name run offline")
        different: false, true, context("history/smoke-repeatable-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/smoke-repeatable-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "1", "1", true, "case history/smoke-repeatable-roots variant default root test-name run offline")
        different: 2, 1, context("history/smoke-repeatable-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestHarnessSmokeRepeatable", "TestHarnessSmokeRepeatable", context("history/smoke-repeatable-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestHarnessSmokeRepeatable", "TestHarnessSmokeRepeatable", true, "case history/smoke-repeatable-roots variant default root test-name run offline")
        different: "TestHarnessSmokeRepeatable_2", "TestHarnessSmokeRepeatable", context("history/smoke-repeatable-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
