fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/smoke-repeatable-roots", "default", "", "offline") => ok
        seed_test_name: context("history/smoke-repeatable-roots", "seed-test-name-drift", "", "offline") => failed{"test-name"}
        seed_test_param: context("history/smoke-repeatable-roots", "seed-test-param-drift", "", "offline") => failed{"test-param"}
        seed_report_decl: context("history/smoke-repeatable-roots", "seed-report-decl-drift", "", "offline") => failed{"report-decl"}
        seed_mode_field: context("history/smoke-repeatable-roots", "seed-mode-field-drift", "", "offline") => failed{"mode-field"}
        seed_failures_field: context("history/smoke-repeatable-roots", "seed-failures-field-drift", "", "offline") => failed{"failures-field"}
        seed_dir_field: context("history/smoke-repeatable-roots", "seed-dir-field-drift", "", "offline") => failed{"dir-field"}
        seed_steps_field: context("history/smoke-repeatable-roots", "seed-steps-field-drift", "", "offline") => failed{"steps-field"}
        seed_name_field: context("history/smoke-repeatable-roots", "seed-name-field-drift", "", "offline") => failed{"name-field"}
        seed_status_field: context("history/smoke-repeatable-roots", "seed-status-field-drift", "", "offline") => failed{"status-field"}
        seed_script_join: context("history/smoke-repeatable-roots", "seed-script-join-drift", "", "offline") => failed{"script-join"}
        seed_script_tail: context("history/smoke-repeatable-roots", "seed-script-tail-drift", "", "offline") => failed{"script-tail"}
        seed_smoke_flag: context("history/smoke-repeatable-roots", "seed-smoke-flag-drift", "", "offline") => failed{"smoke-flag"}
        seed_keep_env: context("history/smoke-repeatable-roots", "seed-keep-env-drift", "", "offline") => failed{"keep-env"}
        seed_root_helper: context("history/smoke-repeatable-roots", "seed-root-helper-drift", "", "offline") => failed{"root-helper"}
        seed_load_helper: context("history/smoke-repeatable-roots", "seed-load-helper-drift", "", "offline") => failed{"load-helper"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.test_name, "TestHarnessSmokeRepeatable", c, "test-name")
            failed
            ok evidence test_name_evidence => match call require_text(got.test_param, "t *testing.T", c, "test-param")
                failed
                ok evidence test_param_evidence => match call require_text(got.report_decl, "type smokeReport struct {", c, "report-decl")
                    failed
                    ok evidence report_decl_evidence => match call require_text(got.mode_field, "Mode     string", c, "mode-field")
                        failed
                        ok evidence mode_field_evidence => match call require_text(got.failures_field, "Failures int", c, "failures-field")
                            failed
