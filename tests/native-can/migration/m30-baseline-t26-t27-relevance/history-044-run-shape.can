    str dir_stmt
    str env_stmt
    str stdout_stmt
    str stderr_stmt
    str run_stmt
    str regex_failures
    str match_stmt
    str nil_guard
    str report_assign
    str cleanup_stmt
    str steps_loop
    int stream_count
    bool cleanup_before_load
    bool load_before_assert
error failed{str check}
