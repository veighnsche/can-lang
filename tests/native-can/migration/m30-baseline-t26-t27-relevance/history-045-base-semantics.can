record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-guide-base", "default", "", "offline"), "phrase-bun-darwin" => ok "case history/t26-guide-base variant default root phrase-bun-darwin run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t26-guide-base", "default", "", "offline"), "phrase-bun-darwin" => ok evidence("phrase-bun-darwin", "true", "true", true, "case history/t26-guide-base variant default root phrase-bun-darwin run offline")
        different: false, true, context("history/t26-guide-base", "default", "", "offline"), "phrase-bun-darwin" => failed{"phrase-bun-darwin"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 34, 34, context("history/t26-guide-base", "default", "", "offline"), "required-count" => ok evidence("required-count", "34", "34", true, "case history/t26-guide-base variant default root required-count run offline")
        different: 33, 34, context("history/t26-guide-base", "default", "", "offline"), "required-count" => failed{"required-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "bun-1.4.2-darwin-arm64-v1", "bun-1.4.2-darwin-arm64-v1", context("history/t26-guide-base", "default", "", "offline"), "phrase-bun-darwin" => ok evidence("phrase-bun-darwin", "bun-1.4.2-darwin-arm64-v1", "bun-1.4.2-darwin-arm64-v1", true, "case history/t26-guide-base variant default root phrase-bun-darwin run offline")
        different: "bun-1.4.2-darwin-arm64-v1_2", "bun-1.4.2-darwin-arm64-v1", context("history/t26-guide-base", "default", "", "offline"), "phrase-bun-darwin" => failed{"phrase-bun-darwin"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
