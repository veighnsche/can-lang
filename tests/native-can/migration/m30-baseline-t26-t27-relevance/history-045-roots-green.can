        int expected
        context c
        str check
    asserts
        same: 8, 8, context("history/t26-guide-roots", "default", "", "offline"), "anchor-file-count" => ok evidence("anchor-file-count", "8", "8", true, "case history/t26-guide-roots variant default root anchor-file-count run offline")
