fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-guide-roots", "default", "", "offline"), "anchor-file-stream" => ok "case history/t26-guide-roots variant default root anchor-file-stream run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t26-guide-roots", "default", "", "offline"), "anchor-file-stream" => ok evidence("anchor-file-stream", "true", "true", true, "case history/t26-guide-roots variant default root anchor-file-stream run offline")
        different: false, true, context("history/t26-guide-roots", "default", "", "offline"), "anchor-file-stream" => failed{"anchor-file-stream"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
