package m30history046base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-046 "T26 comparison: base facts".
/// Source: tests/baseline/reports/
/// t26-agent-comparison-2026-09-24.json (J, one
/// line) plus tests/baseline/registry.json (R, one
/// line) plus tests/baseline/
/// t26_product_guide_test.go symbol
/// TestT26AgentComparisonReportConsistent
/// (L150-207).
/// Disposition: consolidate (this row ports
/// TestT26AgentComparisonReportConsistent to
/// ordinary Can functions; the old Go harness stays
/// until the integrator retires it after every
/// linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the report doc facts in
/// member order: the T01 registry task, the T26
/// report task, the not-run trials status plus zero
/// attempts, the no-significance wording plus its
/// none-claimed needle, the seven case ids, the
/// shared per-case not-run trials pin, the shared
/// null tokens pin, both disposition wordings, the
/// deferral entry, the deferr needle, the slot plus
/// file names, the prose md name, and the
/// case/shipped/deferral counts.
/// ADAPTATION (recorded, with source lines):
/// registry-task pins T01 (R); report-task pins T26
/// (J); trials-status pins not-run (J
/// agentTrials/status); trials-attempts pins int (0)
/// (J agentTrials/attempts); significance pins the
/// full no-significance wording (J significance);
/// significance-needle pins none claimed (L165);
/// case ids pin the seven id members in doc order
/// (J, same order as R); case-trials pins the shared
/// per-case not-run value (J); tokens-absent pins
/// the shared null literal (J); disposition-shipped
/// pins the six-case gate-evidence wording (J);
/// disposition-deferred pins the DI-17 wording (J);
/// deferred-entry pins the deferral member (J);
/// defer-needle pins deferr (L200); slot-name pins
/// T26-native-ai (L193); readme-name pins README.md
/// (L194); candidate-name pins candidate.json (L194);
/// prose-name pins the md name (L204); case-count
/// pins int (7); shipped-count pins int (6);
/// deferred-count pins int (1).
/// Facet map (doc members): registry-task pins T01
/// (R); report-task pins T26 (J); trials-status pins
/// not-run (J); trials-attempts pins 0 (J);
/// significance pins the wording (J);
/// significance-needle pins none claimed (L165);
/// case-id-0 pins closed-variant-arm (J);
/// case-id-1 pins two-libraries (J); case-id-2 pins
/// fixture-link (J); case-id-3 pins invoice-edit (J);
/// case-id-4 pins stream-cleanup (J); case-id-5 pins
/// invoice-grid (J); case-id-6 pins native-judgment
/// (J); case-trials pins not-run (J); tokens-absent
/// pins null (J); disposition-shipped pins the
/// gate-evidence wording (J); disposition-deferred
/// pins the DI-17 wording (J); deferred-entry pins
/// the member (J); defer-needle pins deferr (L200);
/// slot-name pins T26-native-ai (L193); readme-name
/// pins README.md (L194); candidate-name pins
/// candidate.json (L194); prose-name pins the md
/// name (L204); case-count pins 7; shipped-count
/// pins 6; deferred-count pins 1.
/// The roots-green pin lives in
/// history-046-roots-green.can; the run shape plus
/// diagnostics live in history-046-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go
/// timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet).
/// Case history/t26-report checks: registry-task,
/// report-task, trials-status, trials-attempts,
/// significance, significance-needle, case-id-0,
/// case-id-1, case-id-2, case-id-3, case-id-4,
/// case-id-5, case-id-6, case-trials, tokens-absent,
/// disposition-shipped, disposition-deferred,
/// deferred-entry, defer-needle, slot-name,
/// readme-name, candidate-name, prose-name,
/// case-count, shipped-count, deferred-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str registry_task
    str report_task
    str trials_status
    int trials_attempts
    str significance
    str significance_needle
    str case_id_0
    str case_id_1
    str case_id_2
    str case_id_3
    str case_id_4
    str case_id_5
    str case_id_6
    str case_trials
    str tokens_absent
    str disposition_shipped
    str disposition_deferred
    str deferred_entry
    str defer_needle
    str slot_name
    str readme_name
    str candidate_name
    str prose_name
    int case_count
    int shipped_count
    int deferred_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-report", "default", "", "offline"), "registry-task" => ok "case history/t26-report variant default root registry-task run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t26-report", "default", "", "offline"), "registry-task" => ok evidence("registry-task", "true", "true", true, "case history/t26-report variant default root registry-task run offline")
        different: false, true, context("history/t26-report", "default", "", "offline"), "registry-task" => failed{"registry-task"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("history/t26-report", "default", "", "offline"), "trials-attempts" => ok evidence("trials-attempts", "0", "0", true, "case history/t26-report variant default root trials-attempts run offline")
        different: 1, 0, context("history/t26-report", "default", "", "offline"), "trials-attempts" => failed{"trials-attempts"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "T01", "T01", context("history/t26-report", "default", "", "offline"), "registry-task" => ok evidence("registry-task", "T01", "T01", true, "case history/t26-report variant default root registry-task run offline")
        different: "T01_2", "T01", context("history/t26-report", "default", "", "offline"), "registry-task" => failed{"registry-task"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
