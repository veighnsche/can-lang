record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str type_name
    str loader_call
    str root_call
    str registry_file
    str report_file
    str registry_guard
    str report_guard
    str trials_guard
    str significance_guard
    str case_trials_guard
    str tokens_guard
    str disposition_guard
    str omit_guard
    str count_guard
    str deferred_guard
    str slot_join
    str candidate_join
    str defer_guard
    str stat_call
    str err_guard
    str fatal_call
    str error_call
    int fatal_count
    int error_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-report-roots", "default", "", "offline"), "test-name" => ok "case history/t26-report-roots variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t26-report-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/t26-report-roots variant default root test-name run offline")
        different: false, true, context("history/t26-report-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/t26-report-roots", "default", "", "offline"), "fatal-count" => ok evidence("fatal-count", "4", "4", true, "case history/t26-report-roots variant default root fatal-count run offline")
        different: 3, 4, context("history/t26-report-roots", "default", "", "offline"), "fatal-count" => failed{"fatal-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestT26AgentComparisonReportConsistent", "TestT26AgentComparisonReportConsistent", context("history/t26-report-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestT26AgentComparisonReportConsistent", "TestT26AgentComparisonReportConsistent", true, "case history/t26-report-roots variant default root test-name run offline")
        different: "TestT26AgentComparisonReportConsistent_2", "TestT26AgentComparisonReportConsistent", context("history/t26-report-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
