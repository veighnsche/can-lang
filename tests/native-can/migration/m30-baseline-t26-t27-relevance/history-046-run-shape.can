record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str fatal_registry_task
    str fatal_report_task
    str fatal_report_trials
    str fatal_significance
    str error_case_trials
    str error_case_tokens
    str error_case_disposition
    str error_omit_case
    str error_case_count
    str error_no_deferred
    str error_slot_missing
    str error_slot_deferral
    str error_prose_missing
    str fatal_call
    str error_call
    int fatal_count
    int error_count
    int diagnostic_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-report-run", "default", "", "offline"), "test-name" => ok "case history/t26-report-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t26-report-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/t26-report-run variant default root test-name run offline")
        different: false, true, context("history/t26-report-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/t26-report-run", "default", "", "offline"), "fatal-count" => ok evidence("fatal-count", "4", "4", true, "case history/t26-report-run variant default root fatal-count run offline")
        different: 3, 4, context("history/t26-report-run", "default", "", "offline"), "fatal-count" => failed{"fatal-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestT26AgentComparisonReportConsistent", "TestT26AgentComparisonReportConsistent", context("history/t26-report-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestT26AgentComparisonReportConsistent", "TestT26AgentComparisonReportConsistent", true, "case history/t26-report-run variant default root test-name run offline")
        different: "TestT26AgentComparisonReportConsistent_2", "TestT26AgentComparisonReportConsistent", context("history/t26-report-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
