    asserts
        known: "history/generated-fresh-base" => ok [expected_check("check-wording", "cataloguegen --check: %v"), expected_check("missing-wording", "runtime/catalogue.ts missing or empty: %v"), expected_check("run-compare", "cmd.CombinedOutput(); err != nil"), expected_check("stat-err-compare", "err != nil ||"), expected_check("size-compare", "|| info.Size() == 0"), expected_check("fatal-count", "2"), expected_check("check-before-stat", "true"), expected_check("stat-before-guard", "true")]
