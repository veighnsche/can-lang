fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/generated-fresh-base", "default", "", "offline") => ok
        seed_check_wording: context("history/generated-fresh-base", "seed-check-wording-drift", "", "offline") => failed{"check-wording"}
        seed_missing_wording: context("history/generated-fresh-base", "seed-missing-wording-drift", "", "offline") => failed{"missing-wording"}
        seed_run_compare: context("history/generated-fresh-base", "seed-run-compare-drift", "", "offline") => failed{"run-compare"}
        seed_stat_err_compare: context("history/generated-fresh-base", "seed-stat-err-compare-drift", "", "offline") => failed{"stat-err-compare"}
        seed_size_compare: context("history/generated-fresh-base", "seed-size-compare-drift", "", "offline") => failed{"size-compare"}
        seed_fatal_count: context("history/generated-fresh-base", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
        seed_check_before_stat: context("history/generated-fresh-base", "seed-check-before-stat-drift", "", "offline") => failed{"check-before-stat"}
        seed_stat_before_guard: context("history/generated-fresh-base", "seed-stat-before-guard-drift", "", "offline") => failed{"stat-before-guard"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.check_wording, "cataloguegen --check: %v", c, "check-wording")
            failed
            ok evidence check_wording_evidence => match call require_text(got.missing_wording, "runtime/catalogue.ts missing or empty: %v", c, "missing-wording")
                failed
                ok evidence missing_wording_evidence => match call require_text(got.run_compare, "cmd.CombinedOutput(); err != nil", c, "run-compare")
                    failed
                    ok evidence run_compare_evidence => match call require_text(got.stat_err_compare, "err != nil ||", c, "stat-err-compare")
                        failed
                        ok evidence stat_err_compare_evidence => match call require_text(got.size_compare, "|| info.Size() == 0", c, "size-compare")
                            failed
                            ok evidence size_compare_evidence => match call require_int(got.fatal_count, 2, c, "fatal-count")
                                failed
                                ok evidence fatal_count_evidence => match call require_bool(got.check_before_stat, true, c, "check-before-stat")
                                    failed
                                    ok evidence check_before_stat_evidence => match call require_bool(got.stat_before_guard, true, c, "stat-before-guard")
                                        failed
                                        ok evidence stat_before_guard_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m30_h047: "m30-h047" => ok test_case("history/generated-fresh-base", ["history", "m30"], [], 120000, [check_ref("check-wording"), check_ref("missing-wording"), check_ref("run-compare"), check_ref("stat-err-compare"), check_ref("size-compare"), check_ref("fatal-count"), check_ref("check-before-stat"), check_ref("stat-before-guard")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m30-h047"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/generated-fresh-base", ["history", "m30"], [], 120000, [check_ref("check-wording"), check_ref("missing-wording"), check_ref("run-compare"), check_ref("stat-err-compare"), check_ref("size-compare"), check_ref("fatal-count"), check_ref("check-before-stat"), check_ref("stat-before-guard")], callable case_body)
