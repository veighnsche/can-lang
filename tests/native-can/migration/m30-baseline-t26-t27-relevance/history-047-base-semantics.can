    asserts
        m30_h047: "m30-h047" => ok [check("check-wording", "check failure wording is pinned"), check("missing-wording", "missing catalogue wording is pinned"), check("run-compare", "run guard spelling is pinned"), check("stat-err-compare", "stat err guard spelling is pinned"), check("size-compare", "size guard spelling is pinned"), check("fatal-count", "fatal call count pins two"), check("check-before-stat", "check precedes stat"), check("stat-before-guard", "stat precedes size guard")]
        other: "nope" => ok []
    match scope is "m30-h047"
