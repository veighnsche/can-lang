    asserts
        expected: context("history/generated-fresh-run", "default", "", "offline") => ok
        seed_exec_stmt: context("history/generated-fresh-run", "seed-exec-stmt-drift", "", "offline") => failed{"exec-stmt"}
        seed_dir_stmt: context("history/generated-fresh-run", "seed-dir-stmt-drift", "", "offline") => failed{"dir-stmt"}
        seed_run_stmt: context("history/generated-fresh-run", "seed-run-stmt-drift", "", "offline") => failed{"run-stmt"}
        seed_stat_stmt: context("history/generated-fresh-run", "seed-stat-stmt-drift", "", "offline") => failed{"stat-stmt"}
