            failed
            ok evidence exec_stmt_evidence => match call require_text(got.dir_stmt, "cmd.Dir = root", c, "dir-stmt")
                failed
                ok evidence dir_stmt_evidence => match call require_text(got.run_stmt, "if out, err := cmd.CombinedOutput(); err != nil {", c, "run-stmt")
                    failed
                    ok evidence run_stmt_evidence => match call require_text(got.stat_stmt, "info, err := os.Stat(filepath.Join(root, ", c, "stat-stmt")
                        failed
