record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str id_di_01
    str disp_di_01
    str id_di_02
    str disp_di_02
    str id_di_03
    str disp_di_03
    str id_di_04
    str disp_di_04
