error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-di-base", "default", "", "offline"), "id-di-01" => ok "case history/t27-di-base variant default root id-di-01 run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-di-base", "default", "", "offline"), "id-di-01" => ok evidence("id-di-01", "true", "true", true, "case history/t27-di-base variant default root id-di-01 run offline")
        different: false, true, context("history/t27-di-base", "default", "", "offline"), "id-di-01" => failed{"id-di-01"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 26, 26, context("history/t27-di-base", "default", "", "offline"), "id-count" => ok evidence("id-count", "26", "26", true, "case history/t27-di-base variant default root id-count run offline")
        different: 25, 26, context("history/t27-di-base", "default", "", "offline"), "id-count" => failed{"id-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "DI-01", "DI-01", context("history/t27-di-base", "default", "", "offline"), "id-di-01" => ok evidence("id-di-01", "DI-01", "DI-01", true, "case history/t27-di-base variant default root id-di-01 run offline")
        different: "DI-01_2", "DI-01", context("history/t27-di-base", "default", "", "offline"), "id-di-01" => failed{"id-di-01"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
