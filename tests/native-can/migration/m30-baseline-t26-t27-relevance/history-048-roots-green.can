package m30history048roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-048 "DI guard: pairs plus words".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27DIInventoryComplete (L35-78) guard
/// remark (L53) plus range legs (L54-55) plus the
/// word list (L45).
/// Disposition: historical_candidate (this row pins
/// the TestT27DIInventoryComplete offline pact as
/// reviewable Can facts; the old Go check stays until
/// the integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the guard pairs as the
/// green root: the two ambiguous stems plus full
/// ids plus suffix bytes, the four range bounds,
/// the guard remark, the five word spellings in Go
/// order, and the three totals.
/// ADAPTATION (recorded, with source lines): stem
/// pins hold the short id bytes; full pins hold the
/// long id bytes; suffix pins hold the single
/// distinguishing byte; bound pins hold the rune
/// inner bytes; the remark pins the L53 remark inner
/// bytes; word pins hold the L45 literal bytes in Go
/// order; counts pin ints tallied from the guard.
/// amb-09-stem pins DI-09 (L40); amb-09b-full pins
/// DI-09b (L40); amb-09-suffix pins b; amb-14-stem
/// pins DI-14 (L41); amb-14a-full pins DI-14a (L41);
/// amb-14-suffix pins a; guard-lo-alpha pins a
/// (L55); guard-hi-alpha pins z (L55); guard-lo-digit
/// pins 0 (L55); guard-hi-digit pins 9 (L55);
/// guard-comment pins the remark (L53);
/// vocab-accepted pins accepted (L45); vocab-retained
/// pins retained (L45); vocab-deferred pins deferred
/// (L45); vocab-unselected pins unselected (L45);
/// vocab-unattested pins unattested (L45);
/// ambiguous-pair-count pins int (2);
/// guard-range-count pins int (2); vocab-count pins
/// int (5).
/// Facet map (guard in Go order): amb-09-stem,
/// amb-09b-full, amb-09-suffix, amb-14-stem,
/// amb-14a-full, amb-14-suffix, guard-lo-alpha,
/// guard-hi-alpha, guard-lo-digit, guard-hi-digit,
/// guard-comment, vocab-accepted, vocab-retained,
/// vocab-deferred, vocab-unselected, vocab-unattested,
/// ambiguous-pair-count, guard-range-count, vocab-count.
/// The inventory legs live in
/// history-048-base-semantics.can; the run shape plus
/// diagnostics live in history-048-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates SUITE/DOC/FILES/PROC/BUILD/WORK bind
/// at P23; no live run now. Accept gate P23 is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet).
/// Case history/t27-di-roots checks: amb-09-stem,
/// amb-09b-full, amb-09-suffix, amb-14-stem, amb-14a-full,
/// amb-14-suffix, guard-lo-alpha, guard-hi-alpha,
/// guard-lo-digit, guard-hi-digit, guard-comment,
/// vocab-accepted, vocab-retained, vocab-deferred,
/// vocab-unselected, vocab-unattested, ambiguous-pair-count,
/// guard-range-count, vocab-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str amb_09_stem
    str amb_09b_full
    str amb_09_suffix
    str amb_14_stem
    str amb_14a_full
    str amb_14_suffix
    str guard_lo_alpha
    str guard_hi_alpha
    str guard_lo_digit
    str guard_hi_digit
    str guard_comment
    str vocab_accepted
    str vocab_retained
    str vocab_deferred
    str vocab_unselected
    str vocab_unattested
    int ambiguous_pair_count
    int guard_range_count
    int vocab_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-di-roots", "default", "", "offline"), "amb-09-stem" => ok "case history/t27-di-roots variant default root amb-09-stem run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-di-roots", "default", "", "offline"), "amb-09-stem" => ok evidence("amb-09-stem", "true", "true", true, "case history/t27-di-roots variant default root amb-09-stem run offline")
        different: false, true, context("history/t27-di-roots", "default", "", "offline"), "amb-09-stem" => failed{"amb-09-stem"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/t27-di-roots", "default", "", "offline"), "ambiguous-pair-count" => ok evidence("ambiguous-pair-count", "2", "2", true, "case history/t27-di-roots variant default root ambiguous-pair-count run offline")
        different: 1, 2, context("history/t27-di-roots", "default", "", "offline"), "ambiguous-pair-count" => failed{"ambiguous-pair-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "DI-09", "DI-09", context("history/t27-di-roots", "default", "", "offline"), "amb-09-stem" => ok evidence("amb-09-stem", "DI-09", "DI-09", true, "case history/t27-di-roots variant default root amb-09-stem run offline")
        different: "DI-09_2", "DI-09", context("history/t27-di-roots", "default", "", "offline"), "amb-09-stem" => failed{"amb-09-stem"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
