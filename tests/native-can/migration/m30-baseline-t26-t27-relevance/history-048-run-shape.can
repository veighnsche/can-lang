/// M30 HISTORY-048 "DI cover: run shape".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27DIInventoryComplete (L35-78): root
/// plus read (L36-37); line loop (L48); index plus
/// guard (L49-58); fold plus word loop (L60-66);
/// refusal switch (L71-76).
/// Disposition: historical_candidate (this row pins
/// the TestT27DIInventoryComplete offline pact as
/// reviewable Can facts; the old Go check stays until
/// the integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the
/// test name, the audit const name plus file, the
/// four loader plus scan calls, the fold plus word
/// calls, the two flag names, the refusal call, the
/// two refusal wordings in Go order, and the refusal
/// total.
/// ADAPTATION (recorded, with source lines): test-name
/// pins TestT27DIInventoryComplete (L35); audit-const
/// pins t27Audit (L20); audit-path pins the audit
/// file (L20); root-call pins repoRoot (L36);
/// read-call pins readRepoFile (L37); lines-call pins
/// strings.Lines (L48); index-call pins strings.Index
/// (L49); len-call pins len (L54); lower-call pins
/// strings.ToLower (L60); contains-call pins
/// strings.Contains (L62); mentioned-ident pins
/// mentioned (L47); disposed-ident pins disposed
/// (L47); error-call pins t.Errorf (L73); error-omit
/// pins the omitted inner bytes (L73);
/// error-no-disposition pins the missing inner bytes
/// (L75); error-site-count pins int (2) from
/// L73/L75.
/// Facet map (launch plus diagnostics): test-name pins
/// InventoryComplete (L35); audit-const pins const
/// (L20); audit-path pins file (L20); root-call pins
/// root (L36); read-call pins read (L37); lines-call
/// pins split (L48); index-call pins search (L49);
/// len-call pins measure (L54); lower-call pins fold
/// (L60); contains-call pins word search (L62);
/// mentioned-ident pins seen flag (L47);
/// disposed-ident pins word flag (L47); error-call
/// pins Errorf (L73); error-omit pins omitted plus
/// row (L73); error-no-disposition pins mentions plus
/// carries (L75); error-site-count pins 2.
/// The inventory legs live in
/// history-048-base-semantics.can; the roots-green pin
/// lives in history-048-roots-green.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates SUITE/DOC/FILES/PROC/BUILD/WORK bind
/// at P23; no live run now. Accept gate P23 is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet).
/// Case history/t27-di-run checks: test-name, audit-const,
/// audit-path, root-call, read-call, lines-call, index-call,
/// len-call, lower-call, contains-call, mentioned-ident,
/// disposed-ident, error-call, error-omit,
/// error-no-disposition, error-site-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str audit_const
    str audit_path
    str root_call
    str read_call
    str lines_call
    str index_call
    str len_call
    str lower_call
    str contains_call
    str mentioned_ident
    str disposed_ident
    str error_call
    str error_omit
    str error_no_disposition
    int error_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-di-run", "default", "", "offline"), "test-name" => ok "case history/t27-di-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-di-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/t27-di-run variant default root test-name run offline")
        different: false, true, context("history/t27-di-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/t27-di-run", "default", "", "offline"), "error-site-count" => ok evidence("error-site-count", "2", "2", true, "case history/t27-di-run variant default root error-site-count run offline")
        different: 1, 2, context("history/t27-di-run", "default", "", "offline"), "error-site-count" => failed{"error-site-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestT27DIInventoryComplete", "TestT27DIInventoryComplete", context("history/t27-di-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestT27DIInventoryComplete", "TestT27DIInventoryComplete", true, "case history/t27-di-run variant default root test-name run offline")
        different: "TestT27DIInventoryComplete_2", "TestT27DIInventoryComplete", context("history/t27-di-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
