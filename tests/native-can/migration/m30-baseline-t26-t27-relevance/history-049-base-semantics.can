package m30history049base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-049 "T27 accepted map: base".
/// Source: docs/syntax-taste/
/// t27-release-audit-2026-09-24.md (A) plus
/// tests/baseline/
/// t27_release_audit_test.go symbol
/// TestT27AcceptedItemsMapToTestsAndDocs
/// (L83-161).
/// Disposition: consolidate (this row ports
/// TestT27AcceptedItemsMapToTestsAndDocs to
/// ordinary Can functions; the old Go harness stays
/// until the integrator retires it after every
/// linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the audit mapping facts in
/// Go order: the audit file, the audit needle, the
/// twenty-one anchor phrase pins, and the phrase
/// count.
/// ADAPTATION (recorded, with source lines):
/// audit-file pins A (L20); audit-needle pins the
/// depth test name (L86); bind-shape pins the
/// struct line (L91); bind-dependency pins the
/// Dependency arm (L92); bind-scenario pins the
/// Scenario arm (L93); bind-depth-test pins the
/// depth test (L96); bind-duplicates-test pins the
/// duplicates test (L97); bind-nodes-test pins the
/// nodes test (L100); owner-boundary-test pins the
/// boundary test (L103); owner-email pins the email
/// needle (L104); generics-composites-test pins the
/// composites test (L107); generics-package pins
/// the package line (L110); imports-test pins the
/// imports test (L113); identity-test pins the
/// identity test (L116); identity-version pins the
/// version line (L119); scenario-test pins the link
/// test (L122); leafset-test pins the leaf test
/// (L125); leafset-rule pins the leaf rule (L128);
/// di06-needle pins (DI-06) (L131); guide-owner
/// pins owner-only (L134); guide-routes pins
/// action-routes (L135); guide-order pins
/// lines_order (L136); shutdown-once pins exactly
/// once (L139); phrase-count pins int (21).
/// Facet map (mapping pins): audit-file pins A
/// (L20); audit-needle pins the depth test (L86);
/// bind-shape pins the struct (L91);
/// bind-dependency pins Dependency (L92);
/// bind-scenario pins Scenario (L93); bind-depth-test
/// pins the depth test (L96); bind-duplicates-test
/// pins the duplicates test (L97); bind-nodes-test
/// pins the nodes test (L100); owner-boundary-test
/// pins the boundary test (L103); owner-email pins
/// the email needle (L104);
/// generics-composites-test pins the composites
/// test (L107); generics-package pins package
/// check (L110); imports-test pins the imports
/// test (L113); identity-test pins the identity
/// test (L116); identity-version pins the version
/// (L119); scenario-test pins the link (L122);
/// leafset-test pins the leaf test (L125);
/// leafset-rule pins the rule (L128); di06-needle
/// pins (DI-06) (L131); guide-owner pins
/// owner-only (L134); guide-routes pins the routes
/// (L135); guide-order pins the order (L136);
/// shutdown-once pins once (L139); phrase-count
/// pins 21.
/// The roots-green pin lives in
/// history-049-roots-green.can; the run shape plus
/// diagnostics live in history-049-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go
/// timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet).
/// Case history/t27-accepted-map checks: audit-file,
/// audit-needle, bind-shape, bind-dependency,
/// bind-scenario, bind-depth-test,
/// bind-duplicates-test, bind-nodes-test,
/// owner-boundary-test, owner-email,
/// generics-composites-test, generics-package,
/// imports-test, identity-test, identity-version,
/// scenario-test, leafset-test, leafset-rule,
/// di06-needle, guide-owner, guide-routes,
/// guide-order, shutdown-once, phrase-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str audit_file
    str audit_needle
    str bind_shape
    str bind_dependency
    str bind_scenario
    str bind_depth_test
    str bind_duplicates_test
    str bind_nodes_test
    str owner_boundary_test
    str owner_email
    str generics_composites_test
    str generics_package
    str imports_test
    str identity_test
    str identity_version
    str scenario_test
    str leafset_test
    str leafset_rule
    str di06_needle
    str guide_owner
    str guide_routes
    str guide_order
    str shutdown_once
    int phrase_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-accepted-map", "default", "", "offline"), "audit-file" => ok "case history/t27-accepted-map variant default root audit-file run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-accepted-map", "default", "", "offline"), "audit-file" => ok evidence("audit-file", "true", "true", true, "case history/t27-accepted-map variant default root audit-file run offline")
        different: false, true, context("history/t27-accepted-map", "default", "", "offline"), "audit-file" => failed{"audit-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 21, 21, context("history/t27-accepted-map", "default", "", "offline"), "phrase-count" => ok evidence("phrase-count", "21", "21", true, "case history/t27-accepted-map variant default root phrase-count run offline")
        different: 20, 21, context("history/t27-accepted-map", "default", "", "offline"), "phrase-count" => failed{"phrase-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "docs/syntax-taste/t27-release-audit-2026-09-24.md", "docs/syntax-taste/t27-release-audit-2026-09-24.md", context("history/t27-accepted-map", "default", "", "offline"), "audit-file" => ok evidence("audit-file", "docs/syntax-taste/t27-release-audit-2026-09-24.md", "docs/syntax-taste/t27-release-audit-2026-09-24.md", true, "case history/t27-accepted-map variant default root audit-file run offline")
