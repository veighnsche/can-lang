/// M30 HISTORY-049 "T27 accepted map: run".
/// Source: tests/baseline/
/// t27_release_audit_test.go symbol
/// TestT27AcceptedItemsMapToTestsAndDocs
/// (L83-161): audit leg (L86-88); anchor legs
/// (L142-149); suite legs (L150-160).
/// Disposition: consolidate (this row ports
/// TestT27AcceptedItemsMapToTestsAndDocs to
/// ordinary Can functions; the old Go harness stays
/// until the integrator retires it after every
/// linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the live run shape: the
/// test name, the three refusal wordings in Go
/// order, the seven call pins, the three guard pins,
/// the error call, and the error/diagnostic counts.
/// ADAPTATION (recorded, with source lines):
/// test-name pins TestT27AcceptedItemsMapToTestsAndDocs
/// (L83); audit-wording pins the audit inner bytes
/// (L87); anchor-wording pins the anchor inner
/// bytes (L146); suite-wording pins the suite inner
/// bytes (L158); root-call pins repoRoot(t) (L84);
/// read-call pins readRepoFile (L85); contains-call
/// pins strings.Contains (L86); stat-call pins
/// os.Stat (L156); join-call pins filepath.Join
/// (L156); slash-call pins filepath.FromSlash
/// (L156); size-call pins info.Size() (L157);
/// audit-guard pins the negated audit guard (L86);
/// phrase-guard pins the phrase guard (L145);
/// suite-guard pins the err/size guard (L157);
/// error-call pins t.Errorf (L87); error-leg-count
/// pins int (3) from the three legs (L87/L146/L158);
/// diagnostic-count pins int (3) as three errors
/// plus zero fatals.
/// Facet map (launch plus diagnostics): test-name
/// pins the test (L83); audit-wording pins audit
/// plus tests (L87); anchor-wording pins anchor
/// plus quoted phrase (L146); suite-wording pins
/// suite plus err (L158); root-call pins repoRoot
/// (L84); read-call pins readRepoFile (L85);
/// contains-call pins Contains (L86); stat-call pins
/// os.Stat (L156); join-call pins Join (L156);
/// slash-call pins FromSlash (L156); size-call pins
/// Size (L157); audit-guard pins negated audit
/// (L86); phrase-guard pins phrase (L145);
/// suite-guard pins err/size (L157); error-call pins
/// t.Errorf (L87); error-leg-count pins 3;
/// diagnostic-count pins 3.
/// The base facts live in
/// history-049-base-semantics.can; the roots-green pin
/// lives in history-049-roots-green.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: none (no gates; requires []).
/// Logical gates WORK/BUILD/CHILD/CLOCK bind at P23;
/// no live run now. Accept gate P23 is unmet. Timeout
/// 120000ms is the offline default bound (no Go
/// timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet).
/// Case history/t27-accepted-map-run checks:
/// test-name, audit-wording, anchor-wording,
/// suite-wording, root-call, read-call,
/// contains-call, stat-call, join-call, slash-call,
/// size-call, audit-guard, phrase-guard, suite-guard,
/// error-call, error-leg-count, diagnostic-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str audit_wording
    str anchor_wording
    str suite_wording
    str root_call
    str read_call
    str contains_call
    str stat_call
    str join_call
    str slash_call
    str size_call
    str audit_guard
    str phrase_guard
    str suite_guard
    str error_call
    int error_leg_count
    int diagnostic_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-accepted-map-run", "default", "", "offline"), "test-name" => ok "case history/t27-accepted-map-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-accepted-map-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/t27-accepted-map-run variant default root test-name run offline")
        different: false, true, context("history/t27-accepted-map-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/t27-accepted-map-run", "default", "", "offline"), "error-leg-count" => ok evidence("error-leg-count", "3", "3", true, "case history/t27-accepted-map-run variant default root error-leg-count run offline")
        different: 2, 3, context("history/t27-accepted-map-run", "default", "", "offline"), "error-leg-count" => failed{"error-leg-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestT27AcceptedItemsMapToTestsAndDocs", "TestT27AcceptedItemsMapToTestsAndDocs", context("history/t27-accepted-map-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestT27AcceptedItemsMapToTestsAndDocs", "TestT27AcceptedItemsMapToTestsAndDocs", true, "case history/t27-accepted-map-run variant default root test-name run offline")
