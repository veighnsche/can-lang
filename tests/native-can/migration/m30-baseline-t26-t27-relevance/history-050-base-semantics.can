error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-no-deferred-base", "default", "", "offline"), "numbered-pattern" => ok "case history/t27-no-deferred-base variant default root numbered-pattern run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-no-deferred-base", "default", "", "offline"), "numbered-pattern" => ok evidence("numbered-pattern", "true", "true", true, "case history/t27-no-deferred-base variant default root numbered-pattern run offline")
        different: false, true, context("history/t27-no-deferred-base", "default", "", "offline"), "numbered-pattern" => failed{"numbered-pattern"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/t27-no-deferred-base", "default", "", "offline"), "catalogue-group-count" => ok evidence("catalogue-group-count", "4", "4", true, "case history/t27-no-deferred-base variant default root catalogue-group-count run offline")
        different: 3, 4, context("history/t27-no-deferred-base", "default", "", "offline"), "catalogue-group-count" => failed{"catalogue-group-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "error\\s+[0-9]", "error\\s+[0-9]", context("history/t27-no-deferred-base", "default", "", "offline"), "numbered-pattern" => ok evidence("numbered-pattern", "error\\s+[0-9]", "error\\s+[0-9]", true, "case history/t27-no-deferred-base variant default root numbered-pattern run offline")
        different: "error\\s+[0-9]_2", "error\\s+[0-9]", context("history/t27-no-deferred-base", "default", "", "offline"), "numbered-pattern" => failed{"numbered-pattern"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
