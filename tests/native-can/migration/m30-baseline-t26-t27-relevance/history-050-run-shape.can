/// match-call pins Match (L193); fatalf-call pins
/// t.Fatalf (L199); error-call pins t.Errorf (L204);
/// len-call pins len (L207); read-call pins
/// readRepoFile (L212); contains-call pins
/// strings.Contains (L212); error-bare-call pins
/// t.Error (L213); glob-call pins filepath.Glob
/// (L218); fatal-bare-call pins t.Fatal (L220);
/// load-call pins loadJSON (L256); match-string-call
