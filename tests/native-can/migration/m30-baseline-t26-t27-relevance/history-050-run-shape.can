    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str root_call
    str compile_call
    str walk_call
    str is_dir_call
    str suffix_call
    str rel_call
    str read_file_call
    str match_call
