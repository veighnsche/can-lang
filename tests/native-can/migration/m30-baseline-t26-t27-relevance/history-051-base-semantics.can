package m30history051base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-051 "Gate links: twelve files".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27GateEvidenceLinked (L303-330) plus
/// the evidence list (L306-319).
/// Disposition: historical_candidate (this row pins
/// the TestT27GateEvidenceLinked offline pact as
/// reviewable Can facts; the old Go check stays until
/// the integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the evidence legs in Go
/// order: the exact file bytes for all twelve rows
/// plus the row tally.
/// ADAPTATION (recorded, with source lines): each ev
/// pin holds its Go literal inner bytes; ev-count
/// pins int tallied from the Go list.
/// ev-comp-check pins compiler/internal/check/core_integration_test.go (L307);
/// ev-comp-emit pins compiler/internal/emit/core_integration_test.go (L308);
/// ev-comp-syntax pins compiler/internal/syntax/core_integration_test.go (L309);
/// ev-gate3 pins tests/integration/gate3_matrix_test.go (L310);
/// ev-gate4 pins tests/integration/gate4_fault_test.go (L311);
/// ev-gate5 pins tests/integration/gate5_frontend_test.go (L312);
/// ev-grid pins tests/integration/browser/grid.mjs (L313);
/// ev-build-grid pins tests/integration/browser/build-grid.mjs (L314);
/// ev-sha256 pins tests/integration/browser/sha256-shim.mjs (L315);
/// ev-baseline pins tests/baseline/baseline.json (L316);
/// ev-registry pins tests/baseline/registry.json (L317);
/// ev-findings pins docs/syntax-taste/jev-consultations/findings.md (L318);
/// ev-count pins int (12) from L306-319.
/// Facet map (rows in Go order): ev-comp-check,
/// ev-comp-emit, ev-comp-syntax, ev-gate3, ev-gate4,
/// ev-gate5, ev-grid, ev-build-grid, ev-sha256,
/// ev-baseline, ev-registry, ev-findings, ev-count.
/// The roots-green pin lives in
/// history-051-roots-green.can; the run shape plus
/// diagnostics live in history-051-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates bind at P23 only if any leg is
/// retained live; no live run now. Accept gate
/// reviewed disposition is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after
/// reviewed disposition unmet).
/// Case history/t27-gate-base checks: ev-comp-check, ev-comp-emit,
/// ev-comp-syntax, ev-gate3, ev-gate4, ev-gate5, ev-grid,
/// ev-build-grid, ev-sha256, ev-baseline, ev-registry, ev-findings,
/// ev-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str ev_comp_check
    str ev_comp_emit
    str ev_comp_syntax
    str ev_gate3
    str ev_gate4
    str ev_gate5
    str ev_grid
    str ev_build_grid
    str ev_sha256
    str ev_baseline
    str ev_registry
    str ev_findings
    int ev_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-gate-base", "default", "", "offline"), "ev-comp-check" => ok "case history/t27-gate-base variant default root ev-comp-check run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-gate-base", "default", "", "offline"), "ev-comp-check" => ok evidence("ev-comp-check", "true", "true", true, "case history/t27-gate-base variant default root ev-comp-check run offline")
        different: false, true, context("history/t27-gate-base", "default", "", "offline"), "ev-comp-check" => failed{"ev-comp-check"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 12, 12, context("history/t27-gate-base", "default", "", "offline"), "ev-count" => ok evidence("ev-count", "12", "12", true, "case history/t27-gate-base variant default root ev-count run offline")
        different: 11, 12, context("history/t27-gate-base", "default", "", "offline"), "ev-count" => failed{"ev-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "compiler/internal/check/core_integration_test.go", "compiler/internal/check/core_integration_test.go", context("history/t27-gate-base", "default", "", "offline"), "ev-comp-check" => ok evidence("ev-comp-check", "compiler/internal/check/core_integration_test.go", "compiler/internal/check/core_integration_test.go", true, "case history/t27-gate-base variant default root ev-comp-check run offline")
        different: "compiler/internal/check/core_integration_test.go_2", "compiler/internal/check/core_integration_test.go", context("history/t27-gate-base", "default", "", "offline"), "ev-comp-check" => failed{"ev-comp-check"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
