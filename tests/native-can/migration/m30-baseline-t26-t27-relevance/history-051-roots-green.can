fn check[] checks
    emits {}
    given
        str scope
    asserts
        m30_h051: "m30-h051" => ok [check("line-comp-check", "audit line for the check core file is pinned"), check("line-comp-emit", "audit line for the emit core file is pinned"), check("line-comp-syntax", "audit line for the syntax core file is pinned"), check("line-gate3", "audit line for the gate3 file is pinned"), check("line-gate4", "audit line for the gate4 file is pinned"), check("line-gate5", "audit line for the gate5 file is pinned"), check("line-grid", "audit line for the grid file is pinned"), check("line-build-grid", "audit line for the grid builder file is pinned"), check("line-sha256", "audit line for the sha shim file is pinned"), check("line-baseline", "audit line for the baseline file is pinned"), check("line-registry", "audit line for the registry file is pinned"), check("line-findings", "audit line for the findings file is pinned"), check("linked-count", "twelve links exist")]
        other: "nope" => ok []
    match scope is "m30-h051"
        false => ok []
        true => ok [check("line-comp-check", "audit line for the check core file is pinned"), check("line-comp-emit", "audit line for the emit core file is pinned"), check("line-comp-syntax", "audit line for the syntax core file is pinned"), check("line-gate3", "audit line for the gate3 file is pinned"), check("line-gate4", "audit line for the gate4 file is pinned"), check("line-gate5", "audit line for the gate5 file is pinned"), check("line-grid", "audit line for the grid file is pinned"), check("line-build-grid", "audit line for the grid builder file is pinned"), check("line-sha256", "audit line for the sha shim file is pinned"), check("line-baseline", "audit line for the baseline file is pinned"), check("line-registry", "audit line for the registry file is pinned"), check("line-findings", "audit line for the findings file is pinned"), check("linked-count", "twelve links exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/t27-gate-roots" => ok [expected_check("line-comp-check", "171"), expected_check("line-comp-emit", "171"), expected_check("line-comp-syntax", "171"), expected_check("line-gate3", "172"), expected_check("line-gate4", "173"), expected_check("line-gate5", "174"), expected_check("line-grid", "174"), expected_check("line-build-grid", "174"), expected_check("line-sha256", "174"), expected_check("line-baseline", "179"), expected_check("line-registry", "180"), expected_check("line-findings", "191"), expected_check("linked-count", "12")]
        unknown: "nope" => ok []
    match case is "history/t27-gate-roots"
        false => ok []
        true => ok [expected_check("line-comp-check", "171"), expected_check("line-comp-emit", "171"), expected_check("line-comp-syntax", "171"), expected_check("line-gate3", "172"), expected_check("line-gate4", "173"), expected_check("line-gate5", "174"), expected_check("line-grid", "174"), expected_check("line-build-grid", "174"), expected_check("line-sha256", "174"), expected_check("line-baseline", "179"), expected_check("line-registry", "180"), expected_check("line-findings", "191"), expected_check("linked-count", "12")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/t27-gate-roots", "default", "", "offline") => ok
        seed_line_comp_check: context("history/t27-gate-roots", "seed-line-comp-check-drift", "", "offline") => failed{"line-comp-check"}
        seed_line_comp_emit: context("history/t27-gate-roots", "seed-line-comp-emit-drift", "", "offline") => failed{"line-comp-emit"}
        seed_line_comp_syntax: context("history/t27-gate-roots", "seed-line-comp-syntax-drift", "", "offline") => failed{"line-comp-syntax"}
        seed_line_gate3: context("history/t27-gate-roots", "seed-line-gate3-drift", "", "offline") => failed{"line-gate3"}
        seed_line_gate4: context("history/t27-gate-roots", "seed-line-gate4-drift", "", "offline") => failed{"line-gate4"}
        seed_line_gate5: context("history/t27-gate-roots", "seed-line-gate5-drift", "", "offline") => failed{"line-gate5"}
        seed_line_grid: context("history/t27-gate-roots", "seed-line-grid-drift", "", "offline") => failed{"line-grid"}
        seed_line_build_grid: context("history/t27-gate-roots", "seed-line-build-grid-drift", "", "offline") => failed{"line-build-grid"}
        seed_line_sha256: context("history/t27-gate-roots", "seed-line-sha256-drift", "", "offline") => failed{"line-sha256"}
        seed_line_baseline: context("history/t27-gate-roots", "seed-line-baseline-drift", "", "offline") => failed{"line-baseline"}
        seed_line_registry: context("history/t27-gate-roots", "seed-line-registry-drift", "", "offline") => failed{"line-registry"}
        seed_line_findings: context("history/t27-gate-roots", "seed-line-findings-drift", "", "offline") => failed{"line-findings"}
        seed_linked_count: context("history/t27-gate-roots", "seed-linked-count-drift", "", "offline") => failed{"linked-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_int(got.line_comp_check, 171, c, "line-comp-check")
            failed
            ok evidence line_comp_check_evidence => match call require_int(got.line_comp_emit, 171, c, "line-comp-emit")
                failed
                ok evidence line_comp_emit_evidence => match call require_int(got.line_comp_syntax, 171, c, "line-comp-syntax")
                    failed
                    ok evidence line_comp_syntax_evidence => match call require_int(got.line_gate3, 172, c, "line-gate3")
                        failed
                        ok evidence line_gate3_evidence => match call require_int(got.line_gate4, 173, c, "line-gate4")
                            failed
                            ok evidence line_gate4_evidence => match call require_int(got.line_gate5, 174, c, "line-gate5")
                                failed
                                ok evidence line_gate5_evidence => match call require_int(got.line_grid, 174, c, "line-grid")
                                    failed
                                    ok evidence line_grid_evidence => match call require_int(got.line_build_grid, 174, c, "line-build-grid")
                                        failed
                                        ok evidence line_build_grid_evidence => match call require_int(got.line_sha256, 174, c, "line-sha256")
                                            failed
                                            ok evidence line_sha256_evidence => match call require_int(got.line_baseline, 179, c, "line-baseline")
                                                failed
                                                ok evidence line_baseline_evidence => match call require_int(got.line_registry, 180, c, "line-registry")
                                                    failed
                                                    ok evidence line_registry_evidence => match call require_int(got.line_findings, 191, c, "line-findings")
                                                        failed
                                                        ok evidence line_findings_evidence => match call require_int(got.linked_count, 12, c, "linked-count")
                                                            failed
                                                            ok evidence linked_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m30_h051: "m30-h051" => ok test_case("history/t27-gate-roots", ["history", "m30"], [], 120000, [check_ref("line-comp-check"), check_ref("line-comp-emit"), check_ref("line-comp-syntax"), check_ref("line-gate3"), check_ref("line-gate4"), check_ref("line-gate5"), check_ref("line-grid"), check_ref("line-build-grid"), check_ref("line-sha256"), check_ref("line-baseline"), check_ref("line-registry"), check_ref("line-findings"), check_ref("linked-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m30-h051"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/t27-gate-roots", ["history", "m30"], [], 120000, [check_ref("line-comp-check"), check_ref("line-comp-emit"), check_ref("line-comp-syntax"), check_ref("line-gate3"), check_ref("line-gate4"), check_ref("line-gate5"), check_ref("line-grid"), check_ref("line-build-grid"), check_ref("line-sha256"), check_ref("line-baseline"), check_ref("line-registry"), check_ref("line-findings"), check_ref("linked-count")], callable case_body)
