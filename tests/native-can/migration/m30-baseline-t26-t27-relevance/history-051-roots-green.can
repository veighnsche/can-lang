package m30history051roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-051 "Gate links: audit lines".
/// Source: docs/syntax-taste/t27-release-audit-2026-09-24.md
/// (L171-191 link lines) plus the Go link leg
/// (tests/baseline/t27_release_audit_test.go L326).
/// Disposition: historical_candidate (this row pins
/// the TestT27GateEvidenceLinked offline pact as
/// reviewable Can facts; the old Go check stays until
/// the integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): one audit line number per
/// evidence file plus the linked tally; every file
/// is named exactly once in the audit.
/// ADAPTATION (recorded, with source lines): each
/// line pin holds the audit line number where the
/// file is named (grep -n); linked-count pins int
/// tallied from the twelve link hits. Three files
/// share audit L171 and three share audit L174.
/// line-comp-check pins int (171); line-comp-emit
/// pins int (171); line-comp-syntax pins int (171);
/// line-gate3 pins int (172); line-gate4 pins int
/// (173); line-gate5 pins int (174); line-grid pins
/// int (174); line-build-grid pins int (174);
/// line-sha256 pins int (174); line-baseline pins
/// int (179); line-registry pins int (180);
/// line-findings pins int (191); linked-count pins
/// int (12).
/// Facet map (links in Go order): line-comp-check,
/// line-comp-emit, line-comp-syntax, line-gate3,
/// line-gate4, line-gate5, line-grid,
/// line-build-grid, line-sha256, line-baseline,
/// line-registry, line-findings, linked-count.
/// The base list pin lives in
/// history-051-base-semantics.can; the run shape
/// plus diagnostics live in
/// history-051-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates bind at P23 only if any leg is
/// retained live; no live run now. Accept gate
/// reviewed disposition is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after
/// reviewed disposition unmet).
/// Case history/t27-gate-roots checks: line-comp-check, line-comp-emit,
/// line-comp-syntax, line-gate3, line-gate4, line-gate5, line-grid,
/// line-build-grid, line-sha256, line-baseline, line-registry,
/// line-findings, linked-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    int line_comp_check
    int line_comp_emit
    int line_comp_syntax
    int line_gate3
    int line_gate4
    int line_gate5
    int line_grid
    int line_build_grid
    int line_sha256
    int line_baseline
    int line_registry
    int line_findings
    int linked_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-gate-roots", "default", "", "offline"), "line-comp-check" => ok "case history/t27-gate-roots variant default root line-comp-check run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-gate-roots", "default", "", "offline"), "line-comp-check" => ok evidence("line-comp-check", "true", "true", true, "case history/t27-gate-roots variant default root line-comp-check run offline")
        different: false, true, context("history/t27-gate-roots", "default", "", "offline"), "line-comp-check" => failed{"line-comp-check"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 171, 171, context("history/t27-gate-roots", "default", "", "offline"), "line-comp-check" => ok evidence("line-comp-check", "171", "171", true, "case history/t27-gate-roots variant default root line-comp-check run offline")
        different: 170, 171, context("history/t27-gate-roots", "default", "", "offline"), "line-comp-check" => failed{"line-comp-check"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "171", "171", context("history/t27-gate-roots", "default", "", "offline"), "line-comp-check" => ok evidence("line-comp-check", "171", "171", true, "case history/t27-gate-roots variant default root line-comp-check run offline")
        different: "171_2", "171", context("history/t27-gate-roots", "default", "", "offline"), "line-comp-check" => failed{"line-comp-check"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
