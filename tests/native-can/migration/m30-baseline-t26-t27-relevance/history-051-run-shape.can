/// M30 HISTORY-051 "Gate links: run shape".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27GateEvidenceLinked (L303-330): root
/// plus read (L304-305); list (L306-319); loop
/// (L320); stat plus join (L321); size guard
/// (L322); refusal (L323); link leg (L326);
/// refusal (L327).
/// Disposition: historical_candidate (this row pins
/// the TestT27GateEvidenceLinked offline pact as
/// reviewable Can facts; the old Go check stays until
/// the integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the
/// test name, the audit const name plus file, the
/// two loader calls, the list plus loop idents, the
/// stat plus join plus slash plus size calls, the
/// link call, the refusal call, the two refusal
/// wordings in Go order, and the refusal total.
/// ADAPTATION (recorded, with source lines):
/// test-name pins TestT27GateEvidenceLinked (L303);
/// audit-const pins t27Audit (L20); audit-path pins
/// the audit file (L20); root-call pins repoRoot
/// (L304); read-call pins readRepoFile (L305);
/// evidence-ident pins evidence (L306); loop-ident
/// pins file (L320); stat-call pins os.Stat (L321);
/// join-call pins filepath.Join (L321); slash-call
/// pins filepath.FromSlash (L321); size-call pins
/// info.Size (L322); contains-call pins
/// strings.Contains (L326); error-call pins t.Errorf
/// (L323); error-missing pins the missing inner
/// bytes (L323); error-unlinked pins the unlinked
/// inner bytes (L327); error-site-count pins int
/// (2) from L323/L327.
/// Facet map (launch plus diagnostics): test-name
/// pins GateEvidenceLinked (L303); audit-const pins
/// const (L20); audit-path pins file (L20);
/// root-call pins root (L304); read-call pins read
/// (L305); evidence-ident pins list (L306);
/// loop-ident pins var (L320); stat-call pins stat
/// (L321); join-call pins join (L321); slash-call
/// pins slash map (L321); size-call pins measure
/// (L322); contains-call pins link search (L326);
/// error-call pins Errorf (L323); error-missing
/// pins missing plus empty (L323); error-unlinked
/// pins does not link (L327); error-site-count
/// pins 2.
/// The base list pin lives in
/// history-051-base-semantics.can; the roots-green
/// pin lives in history-051-roots-green.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates bind at P23 only if any leg is
/// retained live; no live run now. Accept gate
/// reviewed disposition is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after
/// reviewed disposition unmet).
/// Case history/t27-gate-run checks: test-name, audit-const,
/// audit-path, root-call, read-call, evidence-ident, loop-ident,
/// stat-call, join-call, slash-call, size-call, contains-call,
/// error-call, error-missing, error-unlinked, error-site-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str audit_const
    str audit_path
    str root_call
    str read_call
    str evidence_ident
    str loop_ident
    str stat_call
    str join_call
    str slash_call
    str size_call
    str contains_call
    str error_call
    str error_missing
    str error_unlinked
    int error_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-gate-run", "default", "", "offline"), "test-name" => ok "case history/t27-gate-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-gate-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/t27-gate-run variant default root test-name run offline")
        different: false, true, context("history/t27-gate-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/t27-gate-run", "default", "", "offline"), "error-site-count" => ok evidence("error-site-count", "2", "2", true, "case history/t27-gate-run variant default root error-site-count run offline")
        different: 1, 2, context("history/t27-gate-run", "default", "", "offline"), "error-site-count" => failed{"error-site-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestT27GateEvidenceLinked", "TestT27GateEvidenceLinked", context("history/t27-gate-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestT27GateEvidenceLinked", "TestT27GateEvidenceLinked", true, "case history/t27-gate-run variant default root test-name run offline")
        different: "TestT27GateEvidenceLinked_2", "TestT27GateEvidenceLinked", context("history/t27-gate-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
