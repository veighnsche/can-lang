    emits {}
    given
        str case
    asserts
        known: "history/t27-fresh-base" => ok [expected_check("check-wording", "cataloguegen --check: %v"), expected_check("marker-wording", "generated file %s lost its generated marker"), expected_check("run-compare", "cmd.CombinedOutput(); err != nil"), expected_check("contains-compare", "!strings.Contains(raw,"), expected_check("gen-count", "2"), expected_check("fatal-count", "1"), expected_check("error-count", "1"), expected_check("check-before-loop", "true"), expected_check("read-before-guard", "true")]
