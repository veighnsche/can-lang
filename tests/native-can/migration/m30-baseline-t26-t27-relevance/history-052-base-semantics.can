        true => ok [expected_check("check-wording", "cataloguegen --check: %v"), expected_check("marker-wording", "generated file %s lost its generated marker"), expected_check("run-compare", "cmd.CombinedOutput(); err != nil"), expected_check("contains-compare", "!strings.Contains(raw,"), expected_check("gen-count", "2"), expected_check("fatal-count", "1"), expected_check("error-count", "1"), expected_check("check-before-loop", "true"), expected_check("read-before-guard", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/t27-fresh-base", "default", "", "offline") => ok
        seed_check_wording: context("history/t27-fresh-base", "seed-check-wording-drift", "", "offline") => failed{"check-wording"}
        seed_marker_wording: context("history/t27-fresh-base", "seed-marker-wording-drift", "", "offline") => failed{"marker-wording"}
        seed_run_compare: context("history/t27-fresh-base", "seed-run-compare-drift", "", "offline") => failed{"run-compare"}
        seed_contains_compare: context("history/t27-fresh-base", "seed-contains-compare-drift", "", "offline") => failed{"contains-compare"}
        seed_gen_count: context("history/t27-fresh-base", "seed-gen-count-drift", "", "offline") => failed{"gen-count"}
        seed_fatal_count: context("history/t27-fresh-base", "seed-fatal-count-drift", "", "offline") => failed{"fatal-count"}
        seed_error_count: context("history/t27-fresh-base", "seed-error-count-drift", "", "offline") => failed{"error-count"}
        seed_check_before_loop: context("history/t27-fresh-base", "seed-check-before-loop-drift", "", "offline") => failed{"check-before-loop"}
        seed_read_before_guard: context("history/t27-fresh-base", "seed-read-before-guard-drift", "", "offline") => failed{"read-before-guard"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.check_wording, "cataloguegen --check: %v", c, "check-wording")
            failed
            ok evidence check_wording_evidence => match call require_text(got.marker_wording, "generated file %s lost its generated marker", c, "marker-wording")
                failed
                ok evidence marker_wording_evidence => match call require_text(got.run_compare, "cmd.CombinedOutput(); err != nil", c, "run-compare")
                    failed
                    ok evidence run_compare_evidence => match call require_text(got.contains_compare, "!strings.Contains(raw,", c, "contains-compare")
                        failed
                        ok evidence contains_compare_evidence => match call require_int(got.gen_count, 2, c, "gen-count")
                            failed
                            ok evidence gen_count_evidence => match call require_int(got.fatal_count, 1, c, "fatal-count")
                                failed
                                ok evidence fatal_count_evidence => match call require_int(got.error_count, 1, c, "error-count")
                                    failed
                                    ok evidence error_count_evidence => match call require_bool(got.check_before_loop, true, c, "check-before-loop")
                                        failed
                                        ok evidence check_before_loop_evidence => match call require_bool(got.read_before_guard, true, c, "read-before-guard")
                                            failed
                                            ok evidence read_before_guard_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m30_h052: "m30-h052" => ok test_case("history/t27-fresh-base", ["history", "m30"], [], 120000, [check_ref("check-wording"), check_ref("marker-wording"), check_ref("run-compare"), check_ref("contains-compare"), check_ref("gen-count"), check_ref("fatal-count"), check_ref("error-count"), check_ref("check-before-loop"), check_ref("read-before-guard")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m30-h052"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/t27-fresh-base", ["history", "m30"], [], 120000, [check_ref("check-wording"), check_ref("marker-wording"), check_ref("run-compare"), check_ref("contains-compare"), check_ref("gen-count"), check_ref("fatal-count"), check_ref("error-count"), check_ref("check-before-loop"), check_ref("read-before-guard")], callable case_body)
