package m30history052base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-052 "T27 fresh: base verdicts".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27GeneratedArtifactsFresh (L334-350)
/// plus the fresh comments (L332-333).
/// Disposition: consolidate (this row ports the T27
/// generated-fresh offline pact to ordinary Can
/// functions beside the T26 sibling in HISTORY-047;
/// the old Go harness stays until the integrator
/// retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the passing-path verdicts in
/// Go order: the two diagnostic wordings, the two
/// comparison spellings, the gen plus fatal plus
/// error counts, plus the check-before-loop and
/// read-before-guard order verdicts.
/// ADAPTATION (recorded, with source lines):
/// check-wording pins the Fatalf format head before
/// the newline escape (L339); marker-wording pins
/// the full Errorf format (L347); run-compare pins
/// the CombinedOutput guard fragment (L338);
/// contains-compare pins the negated Contains guard
/// fragment before the quoted marker (L346);
/// gen-count pins int (2) from the two gen segs
/// (L342, L343); fatal-count pins int (1) from the
/// Fatalf call site (L339); error-count pins int (1)
/// from the Errorf call site (L347);
/// check-before-loop pins true since the cataloguegen
/// probe (L336) precedes the gen loop (L341);
/// read-before-guard pins true since the read call
/// (L345) precedes the Contains guard (L346).
/// Facet map (Go verdict legs): check-wording pins
/// the check-failure head (L339); marker-wording
/// pins the marker-failure wording (L347);
/// run-compare pins the run guard (L338);
/// contains-compare pins the guard frag (L346);
/// gen-count pins 2; fatal-count pins 1;
/// error-count pins 1; check-before-loop pins true
/// (L336, L341); read-before-guard pins true (L345,
/// L346).
/// The roots-green pin lives in
/// history-052-roots-green.can; the run shape plus
/// diagnostics live in history-052-run-shape.can.
/// Variants: none (row lists zero variants; the single
/// passing path in Go order).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates SUITE/DOC/FILES/PROC/BUILD/WORK bind
/// at P23; no live run now. Accept gate P23 is
/// unmet. Timeout 120000ms is the offline default
/// bound (no Go timeout in this row; binds at P23
/// like the M11 rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/t27-fresh-base checks:
/// check-wording, marker-wording, run-compare,
/// contains-compare, gen-count, fatal-count,
/// error-count, check-before-loop, read-before-guard.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str check_wording
    str marker_wording
    str run_compare
    str contains_compare
    int gen_count
    int fatal_count
    int error_count
    bool check_before_loop
    bool read_before_guard
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-fresh-base", "default", "", "offline"), "check-wording" => ok "case history/t27-fresh-base variant default root check-wording run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-fresh-base", "default", "", "offline"), "check-before-loop" => ok evidence("check-before-loop", "true", "true", true, "case history/t27-fresh-base variant default root check-before-loop run offline")
        different: false, true, context("history/t27-fresh-base", "default", "", "offline"), "check-before-loop" => failed{"check-before-loop"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/t27-fresh-base", "default", "", "offline"), "gen-count" => ok evidence("gen-count", "2", "2", true, "case history/t27-fresh-base variant default root gen-count run offline")
        different: 1, 2, context("history/t27-fresh-base", "default", "", "offline"), "gen-count" => failed{"gen-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "cataloguegen --check: %v", "cataloguegen --check: %v", context("history/t27-fresh-base", "default", "", "offline"), "check-wording" => ok evidence("check-wording", "cataloguegen --check: %v", "cataloguegen --check: %v", true, "case history/t27-fresh-base variant default root check-wording run offline")
        different: "cataloguegen --check: %v_2", "cataloguegen --check: %v", context("history/t27-fresh-base", "default", "", "offline"), "check-wording" => failed{"check-wording"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, true)
        seed_check_wording: "seed-check-wording-drift" => ok observation("cataloguegen --check: %v_2", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, true)
        seed_marker_wording: "seed-marker-wording-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker_2", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, true)
        seed_run_compare: "seed-run-compare-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil_2", "!strings.Contains(raw,", 2, 1, 1, true, true)
        seed_contains_compare: "seed-contains-compare-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,_2", 2, 1, 1, true, true)
        seed_gen_count: "seed-gen-count-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 1, 1, 1, true, true)
        seed_fatal_count: "seed-fatal-count-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 0, 1, true, true)
        seed_error_count: "seed-error-count-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 0, true, true)
        seed_check_before_loop: "seed-check-before-loop-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, false, true)
        seed_read_before_guard: "seed-read-before-guard-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, false)
    match variant_id
        "seed-check-wording-drift" => ok observation("cataloguegen --check: %v_2", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, true)
        "seed-marker-wording-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker_2", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, true)
        "seed-run-compare-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil_2", "!strings.Contains(raw,", 2, 1, 1, true, true)
        "seed-contains-compare-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,_2", 2, 1, 1, true, true)
        "seed-gen-count-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 1, 1, 1, true, true)
        "seed-fatal-count-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 0, 1, true, true)
        "seed-error-count-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 0, true, true)
        "seed-check-before-loop-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, false, true)
        "seed-read-before-guard-drift" => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, false)
        _ => ok observation("cataloguegen --check: %v", "generated file %s lost its generated marker", "cmd.CombinedOutput(); err != nil", "!strings.Contains(raw,", 2, 1, 1, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m30_h052: "m30-h052" => ok [check("check-wording", "check failure wording is pinned"), check("marker-wording", "marker failure wording is pinned"), check("run-compare", "run guard spelling is pinned"), check("contains-compare", "contains guard spelling is pinned"), check("gen-count", "gen file count pins two"), check("fatal-count", "fatal call count pins one"), check("error-count", "error call count pins one"), check("check-before-loop", "check precedes loop"), check("read-before-guard", "read precedes guard")]
        other: "nope" => ok []
    match scope is "m30-h052"
        false => ok []
        true => ok [check("check-wording", "check failure wording is pinned"), check("marker-wording", "marker failure wording is pinned"), check("run-compare", "run guard spelling is pinned"), check("contains-compare", "contains guard spelling is pinned"), check("gen-count", "gen file count pins two"), check("fatal-count", "fatal call count pins one"), check("error-count", "error call count pins one"), check("check-before-loop", "check precedes loop"), check("read-before-guard", "read precedes guard")]
