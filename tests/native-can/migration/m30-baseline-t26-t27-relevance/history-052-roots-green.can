    asserts
        same: true, true, context("history/t27-fresh-roots", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/t27-fresh-roots variant default root test-name run offline")
        different: false, true, context("history/t27-fresh-roots", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
