package m30history052run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-052 "T27 fresh: run shape".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27GeneratedArtifactsFresh (L334-350):
/// exec (L336); dir (L337); run (L338); loop
/// (L341); read (L345); contains guard (L346);
/// check args (L339); plus the exec arg count and
/// the dir/run/loop orders.
/// Disposition: consolidate (this row ports the T27
/// generated-fresh offline pact to ordinary Can
/// functions beside the T26 sibling in HISTORY-047;
/// the old Go harness stays until the integrator
/// retires it after every linked row, variant,
/// environment and control has accepted evidence).
/// Protects (this file): the live run shape: the exec
/// plus dir plus run spine, the gen loop plus read
/// plus contains guard, the check-failure args, the
/// exec arg count, plus the dir-before-run and
/// run-before-loop orders.
/// ADAPTATION (recorded, with source lines): shapes pin
/// the Go statement inner bytes without leading tabs
/// (L336-338, L341, L345-346); exec-stmt pins the
/// Command head before the quoted args (L336);
/// contains-guard pins the guard head before the
/// quoted marker (L346); check-args pins err plus
/// out (L339); exec-arg-count pins int (4) from the
/// four exec args (L336); dir-before-run pins true
/// since the Dir bind (L337) precedes the run guard
/// (L338); run-before-loop pins true since the run
/// guard (L338) precedes the gen loop (L341).
/// Facet map (launch plus diagnostics): exec-stmt pins
/// the L336 head; dir-stmt pins the L337 bind;
/// run-stmt pins the L338 guard; loop-stmt pins the
/// L341 loop; read-stmt pins the L345 read;
/// contains-guard pins the L346 head; check-args pins
/// err plus out (L339); exec-arg-count pins 4
/// (L336); dir-before-run pins true (L337, L338);
/// run-before-loop pins true (L338, L341).
/// The verdict pins live in
/// history-052-base-semantics.can; the roots-green
/// pin lives in history-052-roots-green.can.
/// Variants: none (row lists zero variants; the single
/// passing path in Go order).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates SUITE/DOC/FILES/PROC/BUILD/WORK bind
/// at P23; no live run now. Accept gate P23 is
/// unmet. Timeout 120000ms is the offline default
/// bound (no Go timeout in this row; binds at P23
/// like the M11 rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23 unmet).
/// Case history/t27-fresh-run checks: exec-stmt,
/// dir-stmt, run-stmt, loop-stmt, read-stmt,
/// contains-guard, check-args, exec-arg-count,
/// dir-before-run, run-before-loop.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str exec_stmt
    str dir_stmt
    str run_stmt
    str loop_stmt
    str read_stmt
    str contains_guard
    str check_args
    int exec_arg_count
    bool dir_before_run
    bool run_before_loop
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-fresh-run", "default", "", "offline"), "exec-stmt" => ok "case history/t27-fresh-run variant default root exec-stmt run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-fresh-run", "default", "", "offline"), "dir-before-run" => ok evidence("dir-before-run", "true", "true", true, "case history/t27-fresh-run variant default root dir-before-run run offline")
        different: false, true, context("history/t27-fresh-run", "default", "", "offline"), "dir-before-run" => failed{"dir-before-run"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/t27-fresh-run", "default", "", "offline"), "exec-arg-count" => ok evidence("exec-arg-count", "4", "4", true, "case history/t27-fresh-run variant default root exec-arg-count run offline")
        different: 3, 4, context("history/t27-fresh-run", "default", "", "offline"), "exec-arg-count" => failed{"exec-arg-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "cmd := exec.Command(", "cmd := exec.Command(", context("history/t27-fresh-run", "default", "", "offline"), "exec-stmt" => ok evidence("exec-stmt", "cmd := exec.Command(", "cmd := exec.Command(", true, "case history/t27-fresh-run variant default root exec-stmt run offline")
        different: "cmd := exec.Command(_2", "cmd := exec.Command(", context("history/t27-fresh-run", "default", "", "offline"), "exec-stmt" => failed{"exec-stmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
