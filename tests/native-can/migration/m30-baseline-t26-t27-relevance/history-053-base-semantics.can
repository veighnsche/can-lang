/// M30 HISTORY-053 "Scoped pins: eight rows".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27RecommendationScoped (L355-377) plus
/// the scope list (L359-368).
/// Disposition: historical_candidate (this row pins
/// the TestT27RecommendationScoped offline pact as
/// reviewable Can facts; the old Go check stays until
/// the integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the scope legs in Go
/// order: the exact Go bytes for all eight rows
/// plus the row tally.
/// ADAPTATION (recorded, with source lines): each pin
/// holds its Go literal inner bytes; phrase-count
/// pins int tallied from the Go list.
/// phrase-bun pins bun-1.4.2-darwin-arm64-v1 (L360);
/// phrase-chromium pins chromium 140 (L361);
/// phrase-webkit pins webkit 26 (L362);
/// phrase-firefox-excluded pins firefox is not
/// qualified (L363); phrase-linux pins native
/// (non-emulated) linux/amd64 (L364);
/// phrase-no-durability pins no reload durability
/// (L365); phrase-no-queue pins no automatic queue
/// (L366); phrase-postgres pins postgresql 17.11
/// (L367); phrase-count pins int (8) from L359-368.
/// Facet map (rows in Go order): phrase-bun,
/// phrase-chromium, phrase-webkit,
/// phrase-firefox-excluded, phrase-linux,
/// phrase-no-durability, phrase-no-queue,
/// phrase-postgres, phrase-count.
/// The roots-green pin lives in
/// history-053-roots-green.can; the run shape plus
/// diagnostics live in history-053-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates bind at P23 only if any leg is
/// retained live; no live run now. Accept gate
/// reviewed disposition is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after
/// reviewed disposition unmet).
/// Case history/t27-rec-base checks: phrase-bun, phrase-chromium,
/// phrase-webkit, phrase-firefox-excluded, phrase-linux,
/// phrase-no-durability, phrase-no-queue, phrase-postgres,
/// phrase-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str phrase_bun
    str phrase_chromium
    str phrase_webkit
    str phrase_firefox_excluded
    str phrase_linux
    str phrase_no_durability
    str phrase_no_queue
    str phrase_postgres
    int phrase_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-rec-base", "default", "", "offline"), "phrase-bun" => ok "case history/t27-rec-base variant default root phrase-bun run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-rec-base", "default", "", "offline"), "phrase-bun" => ok evidence("phrase-bun", "true", "true", true, "case history/t27-rec-base variant default root phrase-bun run offline")
        different: false, true, context("history/t27-rec-base", "default", "", "offline"), "phrase-bun" => failed{"phrase-bun"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
