        int expected
        context c
        str check
    asserts
        same: 8, 8, context("history/t27-rec-base", "default", "", "offline"), "phrase-count" => ok evidence("phrase-count", "8", "8", true, "case history/t27-rec-base variant default root phrase-count run offline")
        different: 7, 8, context("history/t27-rec-base", "default", "", "offline"), "phrase-count" => failed{"phrase-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
