/// M30 HISTORY-053 "Scoped pins: run shape".
/// Source: tests/baseline/t27_release_audit_test.go
/// symbol TestT27RecommendationScoped (L355-377):
/// root plus read (L356-357); lower (L358); list
/// (L359-368); loop search (L369); refusal (L370);
/// veto pair (L373-374); veto refusal (L375).
/// Disposition: historical_candidate (this row pins
/// the TestT27RecommendationScoped offline pact as
/// reviewable Can facts; the old Go check stays until
/// the integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the live run shape: the
/// test name, the audit const name plus file, the
/// two loader calls, the fold plus loop idents, the
/// search call, the refusal call, the omits
/// wording, the two veto needles in Go order, the
/// veto call plus wording, and the refusal total.
/// ADAPTATION (recorded, with source lines):
/// test-name pins TestT27RecommendationScoped (L355);
/// audit-const pins t27Audit (L20); audit-path pins
/// the audit file (L20); root-call pins repoRoot
/// (L356); read-call pins readRepoFile (L357);
/// lower-call pins strings.ToLower (L358);
/// phrase-ident pins phrase (L359); contains-call
/// pins strings.Contains (L369); error-call pins
/// t.Errorf (L370); error-wording pins the omits
/// inner bytes (L370); forbidden-a pins the em-dash
/// needle inner bytes (L373, U+2014 E2 80 94);
/// forbidden-b pins the plain needle inner bytes
/// (L374); refusal-call pins t.Error (L375);
/// refusal-wording pins the veto inner bytes
/// (L375); refusal-site-count pins int (2) from
/// L370/L375.
/// Facet map (launch plus diagnostics): test-name
/// pins RecommendationScoped (L355); audit-const
/// pins const (L20); audit-path pins file (L20);
/// root-call pins root (L356); read-call pins read
/// (L357); lower-call pins fold (L358);
/// phrase-ident pins var (L359); contains-call pins
/// scope search (L369); error-call pins Errorf
/// (L370); error-wording pins omits (L370);
/// forbidden-a pins dash veto (L373); forbidden-b
/// pins plain veto (L374); refusal-call pins Error
/// (L375); refusal-wording pins veto must-not
/// (L375); refusal-site-count pins 2.
/// The base list pin lives in
/// history-053-base-semantics.can; the roots-green
/// pin lives in history-053-roots-green.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: one gate (Bun/Go/Git for T01 smoke or
/// generator when applicable); binds at P23, requires
/// [] now (offline only).
/// Logical gates bind at P23 only if any leg is
/// retained live; no live run now. Accept gate
/// reviewed disposition is unmet.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after
/// reviewed disposition unmet).
/// Case history/t27-rec-run checks: test-name, audit-const,
/// audit-path, root-call, read-call, lower-call, phrase-ident,
/// contains-call, error-call, error-wording, forbidden-a,
/// forbidden-b, refusal-call, refusal-wording, refusal-site-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str audit_const
    str audit_path
    str root_call
    str read_call
    str lower_call
    str phrase_ident
    str contains_call
    str error_call
    str error_wording
    str forbidden_a
    str forbidden_b
    str refusal_call
    str refusal_wording
    int refusal_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t27-rec-run", "default", "", "offline"), "test-name" => ok "case history/t27-rec-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/t27-rec-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/t27-rec-run variant default root test-name run offline")
        different: false, true, context("history/t27-rec-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/t27-rec-run", "default", "", "offline"), "refusal-site-count" => ok evidence("refusal-site-count", "2", "2", true, "case history/t27-rec-run variant default root refusal-site-count run offline")
        different: 1, 2, context("history/t27-rec-run", "default", "", "offline"), "refusal-site-count" => failed{"refusal-site-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestT27RecommendationScoped", "TestT27RecommendationScoped", context("history/t27-rec-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestT27RecommendationScoped", "TestT27RecommendationScoped", true, "case history/t27-rec-run variant default root test-name run offline")
        different: "TestT27RecommendationScoped_2", "TestT27RecommendationScoped", context("history/t27-rec-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
