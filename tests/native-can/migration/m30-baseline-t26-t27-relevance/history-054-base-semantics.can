fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/baseline-base", "default", "", "offline") => ok
        seed_shebang: context("history/baseline-base", "seed-shebang-drift", "", "offline") => failed{"shebang"}
        seed_strict_mode: context("history/baseline-base", "seed-strict-mode-drift", "", "offline") => failed{"strict-mode"}
        seed_default_mode: context("history/baseline-base", "seed-default-mode-drift", "", "offline") => failed{"default-mode"}
        seed_flag_smoke: context("history/baseline-base", "seed-flag-smoke-drift", "", "offline") => failed{"flag-smoke"}
