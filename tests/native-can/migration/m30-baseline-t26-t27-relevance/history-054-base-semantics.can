        seed_flag_help: context("history/baseline-base", "seed-flag-help-drift", "", "offline") => failed{"flag-help"}
        seed_help_range: context("history/baseline-base", "seed-help-range-drift", "", "offline") => failed{"help-range"}
        seed_unknown_wording: context("history/baseline-base", "seed-unknown-wording-drift", "", "offline") => failed{"unknown-wording"}
        seed_fresh_dir: context("history/baseline-base", "seed-fresh-dir-drift", "", "offline") => failed{"fresh-dir"}
        seed_keep_name: context("history/baseline-base", "seed-keep-name-drift", "", "offline") => failed{"keep-name"}
        seed_keep_on: context("history/baseline-base", "seed-keep-on-drift", "", "offline") => failed{"keep-on"}
        seed_trap_call: context("history/baseline-base", "seed-trap-call-drift", "", "offline") => failed{"trap-call"}
        seed_prov_bun_ver: context("history/baseline-base", "seed-prov-bun-ver-drift", "", "offline") => failed{"prov-bun-ver"}
        seed_prov_bun_rev: context("history/baseline-base", "seed-prov-bun-rev-drift", "", "offline") => failed{"prov-bun-rev"}
        seed_prov_go_ver: context("history/baseline-base", "seed-prov-go-ver-drift", "", "offline") => failed{"prov-go-ver"}
        seed_prov_git_call: context("history/baseline-base", "seed-prov-git-call-drift", "", "offline") => failed{"prov-git-call"}
        seed_report_leaf: context("history/baseline-base", "seed-report-leaf-drift", "", "offline") => failed{"report-leaf"}
        seed_steps_leaf: context("history/baseline-base", "seed-steps-leaf-drift", "", "offline") => failed{"steps-leaf"}
        seed_unknown_exit: context("history/baseline-base", "seed-unknown-exit-drift", "", "offline") => failed{"unknown-exit"}
        seed_variant_count: context("history/baseline-base", "seed-variant-count-drift", "", "offline") => failed{"variant-count"}
        seed_prov_count: context("history/baseline-base", "seed-prov-count-drift", "", "offline") => failed{"prov-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.shebang, "#!/usr/bin/env bash", c, "shebang")
            failed
            ok evidence shebang_evidence => match call require_text(got.strict_mode, "set -euo pipefail", c, "strict-mode")
                failed
                ok evidence strict_mode_evidence => match call require_text(got.default_mode, "smoke", c, "default-mode")
                    failed
                    ok evidence default_mode_evidence => match call require_text(got.flag_smoke, "--smoke", c, "flag-smoke")
                        failed
                        ok evidence flag_smoke_evidence => match call require_text(got.flag_full, "--full", c, "flag-full")
                            failed
                            ok evidence flag_full_evidence => match call require_text(got.flag_help, "-h|--help", c, "flag-help")
                                failed
                                ok evidence flag_help_evidence => match call require_text(got.help_range, "2,12p", c, "help-range")
                                    failed
                                    ok evidence help_range_evidence => match call require_text(got.unknown_wording, "unknown argument: $1 (want --smoke or --full)", c, "unknown-wording")
                                        failed
                                        ok evidence unknown_wording_evidence => match call require_text(got.fresh_dir, "mktemp -d", c, "fresh-dir")
                                            failed
                                            ok evidence fresh_dir_evidence => match call require_text(got.keep_name, "KEEP_DIR", c, "keep-name")
                                                failed
                                                ok evidence keep_name_evidence => match call require_text(got.keep_on, "1", c, "keep-on")
                                                    failed
                                                    ok evidence keep_on_evidence => match call require_text(got.trap_call, "rm -rf \"$DIR\"", c, "trap-call")
                                                        failed
                                                        ok evidence trap_call_evidence => match call require_text(got.prov_bun_ver, "bun --version", c, "prov-bun-ver")
                                                            failed
                                                            ok evidence prov_bun_ver_evidence => match call require_text(got.prov_bun_rev, "bun --revision", c, "prov-bun-rev")
                                                                failed
                                                                ok evidence prov_bun_rev_evidence => match call require_text(got.prov_go_ver, "go version", c, "prov-go-ver")
                                                                    failed
                                                                    ok evidence prov_go_ver_evidence => match call require_text(got.prov_git_call, "git -C \"$ROOT\" rev-parse HEAD", c, "prov-git-call")
                                                                        failed
                                                                        ok evidence prov_git_call_evidence => match call require_text(got.report_leaf, "baseline-report.json", c, "report-leaf")
                                                                            failed
                                                                            ok evidence report_leaf_evidence => match call require_text(got.steps_leaf, "steps.tsv", c, "steps-leaf")
                                                                                failed
                                                                                ok evidence steps_leaf_evidence => match call require_int(got.unknown_exit, 2, c, "unknown-exit")
                                                                                    failed
                                                                                    ok evidence unknown_exit_evidence => match call require_int(got.variant_count, 3, c, "variant-count")
                                                                                        failed
                                                                                        ok evidence variant_count_evidence => match call require_int(got.prov_count, 4, c, "prov-count")
                                                                                            failed
                                                                                            ok evidence prov_count_evidence => ok
