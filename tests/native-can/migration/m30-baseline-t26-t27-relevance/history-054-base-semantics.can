package m30history054base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-054 "Runner shell: flags plus provenance".
/// Source: tests/baseline/run.sh (L1-45 CLI plus
/// provenance legs; full runs live in
/// history-054-run-shape.can; the report shape lives
/// in history-054-roots-green.can).
/// Disposition: migrate (this row pins the runner
/// static pact as reviewable Can facts; the old shell
/// stays until the integrator retires it after every
/// linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): CLI surface plus variants
/// plus provenance collection: shebang, strict flags,
/// default mode, smoke plus full plus help flags,
/// help slice, unknown-arg refusal, fresh-dir plus
/// retention plus trap legs, four provenance calls,
/// both record leaves, and the variant plus leg
/// tallies.
/// ADAPTATION (recorded, with source lines): each pin
/// holds its shell inner bytes; counts are int
/// tallied from the guarded legs.
/// shebang pins the L1 launcher line; strict-mode
/// pins set -euo pipefail (L10); default-mode pins
/// smoke (L12); flag-smoke pins --smoke (L14);
/// flag-full pins --full (L15); flag-help pins
/// -h|--help (L16); help-range pins 2,12p (L17);
/// unknown-wording pins the refusal inner (L21);
/// fresh-dir pins mktemp -d (L26); keep-name pins
/// KEEP_DIR (L27); keep-on pins 1 (L27); trap-call
/// pins the rm inner (L28); prov-bun-ver pins
/// bun --version (L31); prov-bun-rev pins
/// bun --revision (L32); prov-go-ver pins go version
/// (L33); prov-git-call pins the rev-parse inner
/// (L34); report-leaf pins baseline-report.json
/// (L35); steps-leaf pins steps.tsv (L41);
/// unknown-exit pins int (2) from L21;
/// variant-count pins int (3); prov-count pins int
/// (4) from L31-34.
/// Facet map (script order): shebang, strict-mode,
/// default-mode, flag-smoke, flag-full, flag-help,
/// help-range, unknown-wording, fresh-dir, keep-name,
/// keep-on, trap-call, prov-bun-ver, prov-bun-rev,
/// prov-go-ver, prov-git-call, report-leaf,
/// steps-leaf, unknown-exit, variant-count,
/// prov-count.
/// The report shape pin lives in
/// history-054-roots-green.can; the step run shape
/// lives in history-054-run-shape.can.
/// Variants: three (--smoke, --full, KEEP_DIR
/// retention); default plus seeded drifts only.
/// Environment: one gate (local Bun/Go/Git; full is
/// broad and currently deferred); binds at P23,
/// requires [] now (offline only).
/// Logical gates bind at P23; no live run now.
/// Accept gate P23 is unmet.
/// Timeout 120000ms is the offline default bound (no
/// shell timeout here; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet; full-mode execution deferred).
/// Case history/baseline-base checks: shebang, strict-mode,
/// default-mode, flag-smoke, flag-full, flag-help,
/// help-range, unknown-wording, fresh-dir, keep-name,
/// keep-on, trap-call, prov-bun-ver, prov-bun-rev,
/// prov-go-ver, prov-git-call, report-leaf,
/// steps-leaf, unknown-exit, variant-count, prov-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str shebang
    str strict_mode
    str default_mode
    str flag_smoke
    str flag_full
    str flag_help
    str help_range
    str unknown_wording
    str fresh_dir
    str keep_name
    str keep_on
    str trap_call
    str prov_bun_ver
    str prov_bun_rev
    str prov_go_ver
    str prov_git_call
    str report_leaf
    str steps_leaf
    int unknown_exit
    int variant_count
    int prov_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/baseline-base", "default", "", "offline"), "shebang" => ok "case history/baseline-base variant default root shebang run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/baseline-base", "default", "", "offline"), "shebang" => ok evidence("shebang", "true", "true", true, "case history/baseline-base variant default root shebang run offline")
        different: false, true, context("history/baseline-base", "default", "", "offline"), "shebang" => failed{"shebang"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/baseline-base", "default", "", "offline"), "unknown-exit" => ok evidence("unknown-exit", "2", "2", true, "case history/baseline-base variant default root unknown-exit run offline")
        different: 1, 2, context("history/baseline-base", "default", "", "offline"), "unknown-exit" => failed{"unknown-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "#!/usr/bin/env bash", "#!/usr/bin/env bash", context("history/baseline-base", "default", "", "offline"), "shebang" => ok evidence("shebang", "#!/usr/bin/env bash", "#!/usr/bin/env bash", true, "case history/baseline-base variant default root shebang run offline")
        different: "#!/usr/bin/env bash_2", "#!/usr/bin/env bash", context("history/baseline-base", "default", "", "offline"), "shebang" => failed{"shebang"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("#!/usr/bin/env bash", "set -euo pipefail", "smoke", "--smoke", "--full", "-h|--help", "2,12p", "unknown argument: $1 (want --smoke or --full)", "mktemp -d", "KEEP_DIR", "1", "rm -rf \"$DIR\"", "bun --version", "bun --revision", "go version", "git -C \"$ROOT\" rev-parse HEAD", "baseline-report.json", "steps.tsv", 2, 3, 4)
        seed_shebang: "seed-shebang-drift" => ok observation("#!/usr/bin/env bash_2", "set -euo pipefail", "smoke", "--smoke", "--full", "-h|--help", "2,12p", "unknown argument: $1 (want --smoke or --full)", "mktemp -d", "KEEP_DIR", "1", "rm -rf \"$DIR\"", "bun --version", "bun --revision", "go version", "git -C \"$ROOT\" rev-parse HEAD", "baseline-report.json", "steps.tsv", 2, 3, 4)
        seed_strict_mode: "seed-strict-mode-drift" => ok observation("#!/usr/bin/env bash", "set -euo pipefail_2", "smoke", "--smoke", "--full", "-h|--help", "2,12p", "unknown argument: $1 (want --smoke or --full)", "mktemp -d", "KEEP_DIR", "1", "rm -rf \"$DIR\"", "bun --version", "bun --revision", "go version", "git -C \"$ROOT\" rev-parse HEAD", "baseline-report.json", "steps.tsv", 2, 3, 4)
        seed_default_mode: "seed-default-mode-drift" => ok observation("#!/usr/bin/env bash", "set -euo pipefail", "smoke_2", "--smoke", "--full", "-h|--help", "2,12p", "unknown argument: $1 (want --smoke or --full)", "mktemp -d", "KEEP_DIR", "1", "rm -rf \"$DIR\"", "bun --version", "bun --revision", "go version", "git -C \"$ROOT\" rev-parse HEAD", "baseline-report.json", "steps.tsv", 2, 3, 4)
        seed_flag_smoke: "seed-flag-smoke-drift" => ok observation("#!/usr/bin/env bash", "set -euo pipefail", "smoke", "--smoke_2", "--full", "-h|--help", "2,12p", "unknown argument: $1 (want --smoke or --full)", "mktemp -d", "KEEP_DIR", "1", "rm -rf \"$DIR\"", "bun --version", "bun --revision", "go version", "git -C \"$ROOT\" rev-parse HEAD", "baseline-report.json", "steps.tsv", 2, 3, 4)
