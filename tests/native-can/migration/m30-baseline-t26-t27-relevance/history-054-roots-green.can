package m30history054roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-054 "Runner shell: report shape".
/// Source: tests/baseline/run.sh (banner plus record
/// legs L37-42; report emission L91-110; flags plus
/// provenance live in history-054-base-semantics.can;
/// the step run shape lives in
/// history-054-run-shape.can).
/// Disposition: migrate (this row pins the runner
/// static pact as reviewable Can facts; the old shell
/// stays until the integrator retires it after every
/// linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): recording shape: the step
/// banner prefix, the steps row format, all ten
/// report fields in emission order, all three step
/// row keys, and both tallies.
/// ADAPTATION (recorded, with source lines): each pin
/// holds its shell inner bytes; counts are int
/// tallied from the emission legs.
/// banner-prefix pins --- $* (L37); record-fmt pins
/// the row format inner (L41); report-task pins T01
/// (L93); field-mode pins mode (L94); field-date
/// pins date (L95); field-bun-version pins
/// bunVersion (L96); field-bun-revision pins
/// bunRevision (L97); field-go-version pins
/// goVersion (L98); field-git-revision pins
/// gitRevision (L99); field-dir pins dir (L100);
/// field-failures pins failures (L101); field-steps
/// pins steps (L102); step-name-key pins name
/// (L107); step-status-key pins status (L107);
/// step-detail-key pins detail (L107);
/// report-field-count pins int (10) from L93-102;
/// step-key-count pins int (3) from L107.
/// Facet map (emission order): banner-prefix,
/// record-fmt, report-task, field-mode, field-date,
/// field-bun-version, field-bun-revision,
/// field-go-version, field-git-revision, field-dir,
/// field-failures, field-steps, step-name-key,
/// step-status-key, step-detail-key,
/// report-field-count, step-key-count.
/// The flags plus provenance pin lives in
/// history-054-base-semantics.can; the step run
/// shape lives in history-054-run-shape.can.
/// Variants: three (--smoke, --full, KEEP_DIR
/// retention); default plus seeded drifts only.
/// Environment: one gate (local Bun/Go/Git; full is
/// broad and currently deferred); binds at P23,
/// requires [] now (offline only).
/// Logical gates bind at P23; no live run now.
/// Accept gate P23 is unmet.
/// Timeout 120000ms is the offline default bound (no
/// shell timeout here; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet; full-mode execution deferred).
/// Case history/baseline-roots checks: banner-prefix,
/// record-fmt, report-task, field-mode, field-date,
/// field-bun-version, field-bun-revision,
/// field-go-version, field-git-revision, field-dir,
/// field-failures, field-steps, step-name-key,
/// step-status-key, step-detail-key,
/// report-field-count, step-key-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str banner_prefix
    str record_fmt
    str report_task
    str field_mode
    str field_date
    str field_bun_version
    str field_bun_revision
    str field_go_version
    str field_git_revision
    str field_dir
    str field_failures
    str field_steps
    str step_name_key
    str step_status_key
    str step_detail_key
    int report_field_count
    int step_key_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/baseline-roots", "default", "", "offline"), "banner-prefix" => ok "case history/baseline-roots variant default root banner-prefix run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/baseline-roots", "default", "", "offline"), "banner-prefix" => ok evidence("banner-prefix", "true", "true", true, "case history/baseline-roots variant default root banner-prefix run offline")
        different: false, true, context("history/baseline-roots", "default", "", "offline"), "banner-prefix" => failed{"banner-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("history/baseline-roots", "default", "", "offline"), "report-field-count" => ok evidence("report-field-count", "10", "10", true, "case history/baseline-roots variant default root report-field-count run offline")
        different: 9, 10, context("history/baseline-roots", "default", "", "offline"), "report-field-count" => failed{"report-field-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "--- $*", "--- $*", context("history/baseline-roots", "default", "", "offline"), "banner-prefix" => ok evidence("banner-prefix", "--- $*", "--- $*", true, "case history/baseline-roots variant default root banner-prefix run offline")
        different: "--- $*_2", "--- $*", context("history/baseline-roots", "default", "", "offline"), "banner-prefix" => failed{"banner-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
