                                                            failed
                                                            ok evidence step_name_key_evidence => match call require_text(got.step_status_key, "status", c, "step-status-key")
                                                                failed
                                                                ok evidence step_status_key_evidence => match call require_text(got.step_detail_key, "detail", c, "step-detail-key")
                                                                    failed
                                                                    ok evidence step_detail_key_evidence => match call require_int(got.report_field_count, 10, c, "report-field-count")
                                                                        failed
                                                                        ok evidence report_field_count_evidence => match call require_int(got.step_key_count, 3, c, "step-key-count")
                                                                            failed
                                                                            ok evidence step_key_count_evidence => ok
fn test_case descriptor
    emits {}
    given
