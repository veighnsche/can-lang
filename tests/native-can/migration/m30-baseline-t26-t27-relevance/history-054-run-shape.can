package m30history054run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-054 "Runner shell: step run shape".
/// Source: tests/baseline/run.sh (smoke steps
/// L44-69; full gate plus steps L71-89; final seal
/// L112-113; flags plus provenance live in
/// history-054-base-semantics.can; the report shape
/// lives in history-054-roots-green.can).
/// Disposition: migrate (this row pins the runner
/// static pact as reviewable Can facts; the old shell
/// stays until the integrator retires it after every
/// linked row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): every step the runner would
/// run: three smoke wordings in run order, six full
/// wordings in run order, all nine record names in
/// run order, the full gate word, the failure seal,
/// and the smoke plus full plus total tallies.
/// ADAPTATION (recorded, with source lines): each pin
/// holds its shell inner bytes; counts are int
/// tallied from the guarded legs.
/// step-gofmt pins the gofmt wording (L47);
/// step-build pins the build wording (L55);
/// step-version pins the version wording (L63);
/// step-vet pins the vet wording (L72);
/// step-catalogue pins the catalogue wording (L75);
/// step-gram pins gramcheck (L78); step-runtime pins
/// the runtime wording (L81); step-go-test pins the
/// go suite wording (L84); step-bun-test pins the
/// bun suite wording (L87); rec-gofmt pins gofmt
/// (L49); rec-build pins build (L57); rec-version
/// pins canlc-version (L65); rec-vet pins vet (L73);
/// rec-catalogue pins catalogue (L76); rec-gram pins
/// gramcheck (L79); rec-runtime pins runtime (L82);
/// rec-go-test pins go-test (L85); rec-bun-test pins
/// bun-test (L88); full-guard pins full (L71);
/// fail-exit pins int (1) from L113;
/// smoke-step-count pins int (3); full-step-count
/// pins int (6); total-step-count pins int (9).
/// Facet map (run order): step-gofmt, step-build,
/// step-version, step-vet, step-catalogue, step-gram,
/// step-runtime, step-go-test, step-bun-test,
/// rec-gofmt, rec-build, rec-version, rec-vet,
/// rec-catalogue, rec-gram, rec-runtime, rec-go-test,
/// rec-bun-test, full-guard, fail-exit,
/// smoke-step-count, full-step-count,
/// total-step-count.
/// The flags plus provenance pin lives in
/// history-054-base-semantics.can; the report shape
/// pin lives in history-054-roots-green.can.
/// Variants: three (--smoke, --full, KEEP_DIR
/// retention); default plus seeded drifts only.
/// Environment: one gate (local Bun/Go/Git; full is
/// broad and currently deferred); binds at P23,
/// requires [] now (offline only).
/// Logical gates bind at P23; no live run now.
/// Accept gate P23 is unmet.
/// Timeout 120000ms is the offline default bound (no
/// shell timeout here; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (accept_after P23
/// unmet; full-mode execution deferred).
/// Case history/baseline-run checks: step-gofmt, step-build,
/// step-version, step-vet, step-catalogue, step-gram,
/// step-runtime, step-go-test, step-bun-test,
/// rec-gofmt, rec-build, rec-version, rec-vet,
/// rec-catalogue, rec-gram, rec-runtime, rec-go-test,
/// rec-bun-test, full-guard, fail-exit,
/// smoke-step-count, full-step-count,
/// total-step-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str step_gofmt
    str step_build
    str step_version
    str step_vet
    str step_catalogue
    str step_gram
    str step_runtime
    str step_go_test
    str step_bun_test
    str rec_gofmt
    str rec_build
    str rec_version
    str rec_vet
    str rec_catalogue
    str rec_gram
    str rec_runtime
    str rec_go_test
    str rec_bun_test
    str full_guard
    int fail_exit
    int smoke_step_count
    int full_step_count
    int total_step_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/baseline-run", "default", "", "offline"), "step-gofmt" => ok "case history/baseline-run variant default root step-gofmt run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/baseline-run", "default", "", "offline"), "step-gofmt" => ok evidence("step-gofmt", "true", "true", true, "case history/baseline-run variant default root step-gofmt run offline")
        different: false, true, context("history/baseline-run", "default", "", "offline"), "step-gofmt" => failed{"step-gofmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/baseline-run", "default", "", "offline"), "fail-exit" => ok evidence("fail-exit", "1", "1", true, "case history/baseline-run variant default root fail-exit run offline")
        different: 0, 1, context("history/baseline-run", "default", "", "offline"), "fail-exit" => failed{"fail-exit"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "gofmt check (repo must be clean)", "gofmt check (repo must be clean)", context("history/baseline-run", "default", "", "offline"), "step-gofmt" => ok evidence("step-gofmt", "gofmt check (repo must be clean)", "gofmt check (repo must be clean)", true, "case history/baseline-run variant default root step-gofmt run offline")
        different: "gofmt check (repo must be clean)_2", "gofmt check (repo must be clean)", context("history/baseline-run", "default", "", "offline"), "step-gofmt" => failed{"step-gofmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("gofmt check (repo must be clean)", "build canlc into disposable dir", "canlc --version smoke", "go vet ./...", "cataloguegen --check", "gramcheck", "runtime checks (bun ci + check:runtime)", "go test -count=1 ./...", "bun test runtime/test/", "gofmt", "build", "canlc-version", "vet", "catalogue", "gramcheck", "runtime", "go-test", "bun-test", "full", 1, 3, 6, 9)
        seed_step_gofmt: "seed-step-gofmt-drift" => ok observation("gofmt check (repo must be clean)_2", "build canlc into disposable dir", "canlc --version smoke", "go vet ./...", "cataloguegen --check", "gramcheck", "runtime checks (bun ci + check:runtime)", "go test -count=1 ./...", "bun test runtime/test/", "gofmt", "build", "canlc-version", "vet", "catalogue", "gramcheck", "runtime", "go-test", "bun-test", "full", 1, 3, 6, 9)
        seed_step_build: "seed-step-build-drift" => ok observation("gofmt check (repo must be clean)", "build canlc into disposable dir_2", "canlc --version smoke", "go vet ./...", "cataloguegen --check", "gramcheck", "runtime checks (bun ci + check:runtime)", "go test -count=1 ./...", "bun test runtime/test/", "gofmt", "build", "canlc-version", "vet", "catalogue", "gramcheck", "runtime", "go-test", "bun-test", "full", 1, 3, 6, 9)
        seed_step_version: "seed-step-version-drift" => ok observation("gofmt check (repo must be clean)", "build canlc into disposable dir", "canlc --version smoke_2", "go vet ./...", "cataloguegen --check", "gramcheck", "runtime checks (bun ci + check:runtime)", "go test -count=1 ./...", "bun test runtime/test/", "gofmt", "build", "canlc-version", "vet", "catalogue", "gramcheck", "runtime", "go-test", "bun-test", "full", 1, 3, 6, 9)
