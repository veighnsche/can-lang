/// M30 HISTORY-055 roots green: live readers of tests/baseline/baseline.json.
/// Caller pins hold path spellings, 1-based read lines and read summaries.
/// baseline_test.go L71 loads the freeze; reads Task Date Bun Version
/// Bun Revision Go Minimum Compiler Revision (L73-L100 legs).
/// t27_release_audit_test.go L316 names the file as gate evidence;
/// os.Stat plus audit-link legs guard it; audit names it once at L179.
/// run.sh is a verified non-reader: baseline.json only in a note at L5;
/// full mode mirrors the 7 frozen commands without opening the file.
/// checks: caller-baseline-path, caller-baseline-reads, caller-t27-path,
/// caller-t27-reads, caller-runsh-path, caller-runsh-reads,
/// caller-baseline-line, caller-t27-line, caller-runsh-line.
package m30history055roots
    provides [context, check, check_ref, expected_check, evidence, observation, failed, test_case, selector, require_bool, require_int, require_text, observe, checks, expected_vector, case_body, descriptor]
    uses [text]

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str caller_baseline_path
    str caller_baseline_reads
    str caller_t27_path
    str caller_t27_reads
    str caller_runsh_path
    str caller_runsh_reads
    int caller_baseline_line
    int caller_t27_line
    int caller_runsh_line
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/baseline-record-roots", "default", "", "offline"), "caller-baseline-path" => ok "case history/baseline-record-roots variant default root caller-baseline-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/baseline-record-roots", "default", "", "offline"), "caller-baseline-path" => ok evidence("caller-baseline-path", "true", "true", true, "case history/baseline-record-roots variant default root caller-baseline-path run offline")
        different: true, false, context("history/baseline-record-roots", "default", "", "offline"), "caller-baseline-path" => failed{"caller-baseline-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/baseline-record-roots", "default", "", "offline"), "caller-baseline-line" => ok evidence("caller-baseline-line", "3", "3", true, "case history/baseline-record-roots variant default root caller-baseline-line run offline")
        different: 3, 4, context("history/baseline-record-roots", "default", "", "offline"), "caller-baseline-line" => failed{"caller-baseline-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "a", "a", context("history/baseline-record-roots", "default", "", "offline"), "caller-baseline-path" => ok evidence("caller-baseline-path", "a", "a", true, "case history/baseline-record-roots variant default root caller-baseline-path run offline")
        different: "a", "b", context("history/baseline-record-roots", "default", "", "offline"), "caller-baseline-path" => failed{"caller-baseline-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
