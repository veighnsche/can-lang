        default: "default" => ok observation("tests/baseline/baseline_test.go", "Task Date Toolchain.Bun.Version Toolchain.Bun.Revision Toolchain.Go.Minimum Compiler.Revision", "tests/baseline/t27_release_audit_test.go", "evidence literal stat nonempty audit link", "tests/baseline/run.sh", "no read; full mode mirrors 7 commands", 71, 316, 5)
