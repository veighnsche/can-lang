package m30history056base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-056 "registry.json: frozen T01 trial registry".
/// Source: tests/baseline/registry.json (12282 bytes, md5
/// cde032ab1b4c6f466cc540fc9f08a40a, one line, five top-level keys).
/// Disposition: preserve_record; review decision RETAIN (live Go callers
/// keep decoding it; its dates and unrun trials stay historical, never
/// new execution evidence; retirement is a later integrator decision).
/// Protects (this file): the frozen byte/provenance pins: key order and
/// total, T01 task tag, 2026-09-24 freeze day, seven case ids in file
/// order, the shared standard trial plus five attempts, four notes,
/// seven pending slots, byte size and md5.
/// ADAPTATION (recorded): top-keys pins the comma-joined key order seen
/// at byte offsets 1/11135/11155/11723/11736; case pins follow registry
/// order; pending-count tallies candidate status pending over 7/7 cases
/// (T02 slot absent by design, status still pending); reg-md5 pins the
/// md5 of the frozen bytes.
/// Facet map (registry.json): top-keys/top-key-count pin keys (offsets
/// 1/11135/11155/11723/11736); reg-task pins T01; reg-date pins
/// 2026-09-24; case-count pins 7; case-one pins closed-variant-arm;
/// case-two pins two-libraries; case-three pins fixture-link; case-four
/// pins invoice-edit; case-five pins stream-cleanup; case-six pins
/// invoice-grid; case-seven pins native-judgment; trial-name/trial-attempts
/// pin standard/5; notes-count pins 4; pending-count pins 7; reg-bytes
/// pins 12282; reg-md5 pins cde032ab1b4c6f466cc540fc9f08a40a.
/// The roots-green pin lives in history-056-roots-green.can; the run shape
/// plus disposition review live in history-056-run-shape.can.
/// Variants: none. Environment: no gates; requires nothing. P23 binds no
/// live leg here; accept gate is reviewed disposition.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (preserved history is not execution
/// evidence; report trials are not-run with zero attempts).
/// Case history/registry-base checks: top-keys, top-key-count, reg-task,
/// reg-date, case-count, case-one, case-two, case-three, case-four,
/// case-five, case-six, case-seven, trial-name, trial-attempts,
/// notes-count, pending-count, reg-bytes, reg-md5.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str top_keys
    int top_key_count
    str reg_task
    str reg_date
    int case_count
    str case_one
    str case_two
    str case_three
    str case_four
    str case_five
    str case_six
    str case_seven
    str trial_name
    int trial_attempts
    int notes_count
    int pending_count
    int reg_bytes
    str reg_md5
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/registry-base", "default", "", "offline"), "top-keys" => ok "case history/registry-base variant default root top-keys run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/registry-base", "default", "", "offline"), "top-keys" => ok evidence("top-keys", "true", "true", true, "case history/registry-base variant default root top-keys run offline")
        different: false, true, context("history/registry-base", "default", "", "offline"), "top-keys" => failed{"top-keys"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("history/registry-base", "default", "", "offline"), "top-key-count" => ok evidence("top-key-count", "5", "5", true, "case history/registry-base variant default root top-key-count run offline")
        different: 4, 5, context("history/registry-base", "default", "", "offline"), "top-key-count" => failed{"top-key-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "cases,date,notes,task,trials", "cases,date,notes,task,trials", context("history/registry-base", "default", "", "offline"), "top-keys" => ok evidence("top-keys", "cases,date,notes,task,trials", "cases,date,notes,task,trials", true, "case history/registry-base variant default root top-keys run offline")
        different: "cases,date,notes,task,trials_2", "cases,date,notes,task,trials", context("history/registry-base", "default", "", "offline"), "top-keys" => failed{"top-keys"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
