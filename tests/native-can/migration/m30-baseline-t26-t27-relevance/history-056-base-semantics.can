fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/registry-base", "default", "", "offline") => ok
        seed_top_keys: context("history/registry-base", "seed-top-keys-drift", "", "offline") => failed{"top-keys"}
        seed_top_key_count: context("history/registry-base", "seed-top-key-count-drift", "", "offline") => failed{"top-key-count"}
