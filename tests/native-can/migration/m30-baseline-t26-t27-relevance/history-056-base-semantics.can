        seed_reg_date: context("history/registry-base", "seed-reg-date-drift", "", "offline") => failed{"reg-date"}
        seed_case_count: context("history/registry-base", "seed-case-count-drift", "", "offline") => failed{"case-count"}
        seed_case_one: context("history/registry-base", "seed-case-one-drift", "", "offline") => failed{"case-one"}
        seed_case_two: context("history/registry-base", "seed-case-two-drift", "", "offline") => failed{"case-two"}
