fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/registry-roots", "default", "", "offline") => ok
        seed_caller_one_file: context("history/registry-roots", "seed-caller-one-file-drift", "", "offline") => failed{"caller-one-file"}
        seed_caller_one_line: context("history/registry-roots", "seed-caller-one-line-drift", "", "offline") => failed{"caller-one-line"}
        seed_caller_one_test: context("history/registry-roots", "seed-caller-one-test-drift", "", "offline") => failed{"caller-one-test"}
        seed_caller_one_op: context("history/registry-roots", "seed-caller-one-op-drift", "", "offline") => failed{"caller-one-op"}
