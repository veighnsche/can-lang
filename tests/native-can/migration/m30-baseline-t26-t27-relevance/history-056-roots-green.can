        seed_caller_two_line: context("history/registry-roots", "seed-caller-two-line-drift", "", "offline") => failed{"caller-two-line"}
        seed_caller_two_test: context("history/registry-roots", "seed-caller-two-test-drift", "", "offline") => failed{"caller-two-test"}
        seed_caller_two_op: context("history/registry-roots", "seed-caller-two-op-drift", "", "offline") => failed{"caller-two-op"}
