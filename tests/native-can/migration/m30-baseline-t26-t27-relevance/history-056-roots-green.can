package m30history056roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-056 "registry.json: live caller roots".
/// Source: the three live Go readers of tests/baseline/registry.json:
/// baseline_test.go L158, t26_product_guide_test.go L153 and
/// t27_release_audit_test.go L317 (verified by scoped grep; no other Go,
/// shell, mjs or ts reader under tests/, tools/, compiler/, runtime/).
/// Disposition: preserve_record; review decision RETAIN (kept callers pin
/// this file; doc-only mentions in README/report/audit prose are not live
/// callers and stay outside the live-caller total).
/// Protects (this file): one observation per verified live caller: file,
/// line, enclosing test and read operation, plus the shared decode shape
/// and the live-caller total.
/// ADAPTATION (recorded): file pins hold the slash-joined repo paths from
/// the Join/literal bytes; line pins hold grep -n line numbers; op pins
/// hold bare callee spellings (loadJSON for the two decoders, os.Stat plus
/// strings.Contains for the linkage leg); decode-target pins the shared
/// registryFile shape (baseline_test.go L104).
/// Facet map (live callers): caller-one-file/caller-one-line/caller-one-test/
/// caller-one-op pin baseline_test.go/158/TestRegistryComplete/loadJSON;
/// caller-two-file/caller-two-line/caller-two-test/caller-two-op pin
/// t26_product_guide_test.go/153/TestT26AgentComparisonReportConsistent/
/// loadJSON; caller-three-file/caller-three-line/caller-three-test/
/// caller-three-op/caller-three-link-op pin
/// t27_release_audit_test.go/317/TestT27GateEvidenceLinked/os.Stat/
/// strings.Contains; decode-target pins registryFile; live-caller-count
/// pins 3.
/// The base-semantics pin lives in history-056-base-semantics.can; the run
/// shape plus disposition review live in history-056-run-shape.can.
/// Variants: none. Environment: no gates; requires nothing. P23 binds no
/// live leg here; accept gate is reviewed disposition.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (caller pins are parsed-history
/// observations, not a live run).
/// Case history/registry-roots checks: caller-one-file, caller-one-line,
/// caller-one-test, caller-one-op, caller-two-file, caller-two-line,
/// caller-two-test, caller-two-op, caller-three-file, caller-three-line,
/// caller-three-test, caller-three-op, caller-three-link-op,
/// decode-target, live-caller-count.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str caller_one_file
    int caller_one_line
    str caller_one_test
    str caller_one_op
    str caller_two_file
    int caller_two_line
    str caller_two_test
    str caller_two_op
    str caller_three_file
    int caller_three_line
    str caller_three_test
    str caller_three_op
    str caller_three_link_op
    str decode_target
    int live_caller_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/registry-roots", "default", "", "offline"), "caller-one-file" => ok "case history/registry-roots variant default root caller-one-file run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/registry-roots", "default", "", "offline"), "caller-one-file" => ok evidence("caller-one-file", "true", "true", true, "case history/registry-roots variant default root caller-one-file run offline")
        different: false, true, context("history/registry-roots", "default", "", "offline"), "caller-one-file" => failed{"caller-one-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 158, 158, context("history/registry-roots", "default", "", "offline"), "caller-one-line" => ok evidence("caller-one-line", "158", "158", true, "case history/registry-roots variant default root caller-one-line run offline")
        different: 157, 158, context("history/registry-roots", "default", "", "offline"), "caller-one-line" => failed{"caller-one-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "tests/baseline/baseline_test.go", "tests/baseline/baseline_test.go", context("history/registry-roots", "default", "", "offline"), "caller-one-file" => ok evidence("caller-one-file", "tests/baseline/baseline_test.go", "tests/baseline/baseline_test.go", true, "case history/registry-roots variant default root caller-one-file run offline")
        different: "tests/baseline/baseline_test.go_2", "tests/baseline/baseline_test.go", context("history/registry-roots", "default", "", "offline"), "caller-one-file" => failed{"caller-one-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
