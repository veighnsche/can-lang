        other: "nope" => ok []
    match scope is "m30-h056"
        false => ok []
        true => ok [check("caller-one-file", "first live caller lives in baseline_test.go"), check("caller-one-line", "first live caller reads at line 158"), check("caller-one-test", "first live caller runs TestRegistryComplete"), check("caller-one-op", "first live caller decodes with loadJSON"), check("caller-two-file", "second live caller lives in t26 guide test"), check("caller-two-line", "second live caller reads at line 153"), check("caller-two-test", "second live caller runs the T26 report test"), check("caller-two-op", "second live caller decodes with loadJSON"), check("caller-three-file", "third live caller lives in t27 audit test"), check("caller-three-line", "third live caller names line 317"), check("caller-three-test", "third live caller runs the gate linkage test"), check("caller-three-op", "third live caller stats the file"), check("caller-three-link-op", "third live caller links via audit wording"), check("decode-target", "both decoders share the registryFile shape"), check("live-caller-count", "exactly three live Go callers exist")]
