        seed_caller_three_line: context("history/registry-roots", "seed-caller-three-line-drift", "", "offline") => failed{"caller-three-line"}
        seed_caller_three_test: context("history/registry-roots", "seed-caller-three-test-drift", "", "offline") => failed{"caller-three-test"}
        seed_caller_three_op: context("history/registry-roots", "seed-caller-three-op-drift", "", "offline") => failed{"caller-three-op"}
        seed_caller_three_link_op: context("history/registry-roots", "seed-caller-three-link-op-drift", "", "offline") => failed{"caller-three-link-op"}
        seed_decode_target: context("history/registry-roots", "seed-decode-target-drift", "", "offline") => failed{"decode-target"}
        seed_live_caller_count: context("history/registry-roots", "seed-live-caller-count-drift", "", "offline") => failed{"live-caller-count"}
