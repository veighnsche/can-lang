        ok observation got => match call require_text(got.caller_one_file, "tests/baseline/baseline_test.go", c, "caller-one-file")
            failed
            ok evidence caller_one_file_evidence => match call require_int(got.caller_one_line, 158, c, "caller-one-line")
                failed
                ok evidence caller_one_line_evidence => match call require_text(got.caller_one_test, "TestRegistryComplete", c, "caller-one-test")
                    failed
                    ok evidence caller_one_test_evidence => match call require_text(got.caller_one_op, "loadJSON", c, "caller-one-op")
                        failed
                        ok evidence caller_one_op_evidence => match call require_text(got.caller_two_file, "tests/baseline/t26_product_guide_test.go", c, "caller-two-file")
                            failed
