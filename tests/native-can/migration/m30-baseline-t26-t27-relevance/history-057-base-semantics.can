package m30history057base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-057 base: frozen T26 held-out comparison record bytes.
/// Source: tests/baseline/reports/t26-agent-comparison-2026-09-24.json.
/// Record: md5 4150e83b256b6441e09a30c5ed1a8b08, 5252 bytes, one line,
/// no closing newline; 10 top keys; 7 registry cases; zero live trials.
/// All 7 cases show not-run with null per-case counts and set
/// dispositions; whole-task attempts equal 0; deferral names one entry.
/// Disposition: preserve_record; decision retain (see run-shape slice).
/// This file pins file name, md5, size, key/case/gate counts, frozen
/// date, task tag, not-run trial state and no-significance wording.
/// Dates and unrun trials stay frozen history; no new run proof follows.
/// Checks: report-file, record-md5, byte-size, top-key-count, date-value, task-value, case-count, trials-status, trials-attempts, significance-guard, deferred-count, gate-count, case-closed, case-two-libs, case-fixture, case-invoice-edit, case-stream, case-grid, case-native.
/// Byte pins own the frozen record; reader pins live in roots-green;
/// review inputs live in run-shape.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str report_file
    str record_md5
    int byte_size
    int top_key_count
    str date_value
    str task_value
    int case_count
    str trials_status
    int trials_attempts
    str significance_guard
    int deferred_count
    int gate_count
    str case_closed
    str case_two_libs
    str case_fixture
    str case_invoice_edit
    str case_stream
    str case_grid
    str case_native
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-comparison-base", "default", "", "offline"), "report-file" => ok "case history/t26-comparison-base variant default root report-file run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5252, 5252, context("history/t26-comparison-base", "default", "", "offline"), "byte-size" => ok evidence("byte-size", "5252", "5252", true, "case history/t26-comparison-base variant default root byte-size run offline")
        different: 5251, 5252, context("history/t26-comparison-base", "default", "", "offline"), "byte-size" => failed{"byte-size"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "t26-agent-comparison-2026-09-24.json", "t26-agent-comparison-2026-09-24.json", context("history/t26-comparison-base", "default", "", "offline"), "report-file" => ok evidence("report-file", "t26-agent-comparison-2026-09-24.json", "t26-agent-comparison-2026-09-24.json", true, "case history/t26-comparison-base variant default root report-file run offline")
        different: "t26-agent-comparison-2026-09-24.json_2", "t26-agent-comparison-2026-09-24.json", context("history/t26-comparison-base", "default", "", "offline"), "report-file" => failed{"report-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
