package m30history057roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-057 roots: live readers of the frozen T26 record.
/// Source: tests/baseline/reports/t26-agent-comparison-2026-09-24.json.
/// One live code reader exists: tests/baseline/t26_product_guide_test.go
/// line 158 loads the record via loadJSON into t26Report inside
/// TestT26AgentComparisonReportConsistent and guards Task, trial state,
/// no-significance wording, per-case trial/disposition shape, coverage
/// parity and the deferral entry.
/// Header comment line 5 names the record; prose companion line 6 points
/// at the machine form. No other Go/TS reader was found by repo search.
/// This file pins reader file, lines, loader, report kind, guard
/// spellings and the live-reader count.
/// Checks: caller-file, caller-line, test-name, loader-call, report-type, task-guard, trials-guard, significance-guard, case-trials-guard, disposition-guard, deferred-guard, comment-ref-line, prose-ref-file, prose-ref-line, caller-count.
/// Byte pins live in base-semantics; review inputs live in run-shape.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str caller_file
    int caller_line
    str test_name
    str loader_call
    str report_type
    str task_guard
    str trials_guard
    str significance_guard
    str case_trials_guard
    str disposition_guard
    str deferred_guard
    int comment_ref_line
    str prose_ref_file
    int prose_ref_line
    int caller_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-comparison-roots", "default", "", "offline"), "caller-file" => ok "case history/t26-comparison-roots variant default root caller-file run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 158, 158, context("history/t26-comparison-roots", "default", "", "offline"), "caller-line" => ok evidence("caller-line", "158", "158", true, "case history/t26-comparison-roots variant default root caller-line run offline")
        different: 157, 158, context("history/t26-comparison-roots", "default", "", "offline"), "caller-line" => failed{"caller-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "tests/baseline/t26_product_guide_test.go", "tests/baseline/t26_product_guide_test.go", context("history/t26-comparison-roots", "default", "", "offline"), "caller-file" => ok evidence("caller-file", "tests/baseline/t26_product_guide_test.go", "tests/baseline/t26_product_guide_test.go", true, "case history/t26-comparison-roots variant default root caller-file run offline")
        different: "tests/baseline/t26_product_guide_test.go_2", "tests/baseline/t26_product_guide_test.go", context("history/t26-comparison-roots", "default", "", "offline"), "caller-file" => failed{"caller-file"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
