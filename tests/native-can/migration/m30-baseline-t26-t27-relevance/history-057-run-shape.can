package m30history057run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-057 run: disposition review for the frozen T26 record.
/// Source: tests/baseline/reports/t26-agent-comparison-2026-09-24.json.
/// Coverage row HISTORY-057 keeps one frozen-record facet, zero variants,
/// zero gates; start after P15 (met); accept after reviewed disposition.
/// Review: one live reader holds (see roots-green); registry holds 7/7
/// cases; frozen date and unrun trials grant no new run proof.
/// Decision: retain under preserve_record; no execution credit claimed;
/// retirement stays ineligible; history remains available as a record.
/// Checks: row-id, source-file, disposition, decision, protected-count, variant-count, gate-count, live-caller-count, execution-credit, retirement-eligible, review-state, frozen-date.
/// Byte pins live in base-semantics; reader pins live in roots-green.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str row_id
    str source_file
    str disposition
    str decision
    int protected_count
    int variant_count
    int gate_count
    int live_caller_count
    str execution_credit
    bool retirement_eligible
    str review_state
    str frozen_date
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/t26-comparison-run", "default", "", "offline"), "row-id" => ok "case history/t26-comparison-run variant default root row-id run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: false, false, context("history/t26-comparison-run", "default", "", "offline"), "retirement-eligible" => ok evidence("retirement-eligible", "false", "false", true, "case history/t26-comparison-run variant default root retirement-eligible run offline")
        different: true, false, context("history/t26-comparison-run", "default", "", "offline"), "retirement-eligible" => failed{"retirement-eligible"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/t26-comparison-run", "default", "", "offline"), "protected-count" => ok evidence("protected-count", "1", "1", true, "case history/t26-comparison-run variant default root protected-count run offline")
        different: 0, 1, context("history/t26-comparison-run", "default", "", "offline"), "protected-count" => failed{"protected-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "HISTORY-057", "HISTORY-057", context("history/t26-comparison-run", "default", "", "offline"), "row-id" => ok evidence("row-id", "HISTORY-057", "HISTORY-057", true, "case history/t26-comparison-run variant default root row-id run offline")
        different: "HISTORY-057_2", "HISTORY-057", context("history/t26-comparison-run", "default", "", "offline"), "row-id" => failed{"row-id"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        seed_row_id_drift: "seed-row-id-drift" => ok observation("HISTORY-057_2", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        seed_source_file_drift: "seed-source-file-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json_2", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        seed_disposition_drift: "seed-disposition-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record_2", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        seed_decision_drift: "seed-decision-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain_2", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        seed_protected_count_drift: "seed-protected-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 0, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        seed_variant_count_drift: "seed-variant-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, -1, 0, 1, "none", false, "reviewed", "2026-09-24")
        seed_gate_count_drift: "seed-gate-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, -1, 1, "none", false, "reviewed", "2026-09-24")
        seed_live_caller_count_drift: "seed-live-caller-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 0, "none", false, "reviewed", "2026-09-24")
        seed_execution_credit_drift: "seed-execution-credit-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none_2", false, "reviewed", "2026-09-24")
        seed_retirement_eligible_drift: "seed-retirement-eligible-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", true, "reviewed", "2026-09-24")
        seed_review_state_drift: "seed-review-state-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed_2", "2026-09-24")
        seed_frozen_date_drift: "seed-frozen-date-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24_2")
    match variant_id
        "seed-row-id-drift" => ok observation("HISTORY-057_2", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        "seed-source-file-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json_2", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        "seed-disposition-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record_2", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        "seed-decision-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain_2", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        "seed-protected-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 0, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
        "seed-variant-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, -1, 0, 1, "none", false, "reviewed", "2026-09-24")
        "seed-gate-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, -1, 1, "none", false, "reviewed", "2026-09-24")
        "seed-live-caller-count-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 0, "none", false, "reviewed", "2026-09-24")
        "seed-execution-credit-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none_2", false, "reviewed", "2026-09-24")
        "seed-retirement-eligible-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", true, "reviewed", "2026-09-24")
        "seed-review-state-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed_2", "2026-09-24")
        "seed-frozen-date-drift" => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24_2")
        _ => ok observation("HISTORY-057", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", "preserve_record", "retain", 1, 0, 0, 1, "none", false, "reviewed", "2026-09-24")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m30_057: "m30-057" => ok [check("row-id", "coverage row reads HISTORY-057"), check("source-file", "reviewed source path is pinned"), check("disposition", "disposition reads preserve_record"), check("decision", "review decision is retain"), check("protected-count", "one frozen-record facet is kept"), check("variant-count", "zero variants are listed"), check("gate-count", "zero gates are listed"), check("live-caller-count", "one live reader is held"), check("execution-credit", "no execution credit is claimed"), check("retirement-eligible", "retirement stays ineligible"), check("review-state", "disposition review is recorded"), check("frozen-date", "frozen date stays 2026-09-24")]
        other: "nope" => ok []
    match scope is "m30-057"
        false => ok []
        true => ok [check("row-id", "coverage row reads HISTORY-057"), check("source-file", "reviewed source path is pinned"), check("disposition", "disposition reads preserve_record"), check("decision", "review decision is retain"), check("protected-count", "one frozen-record facet is kept"), check("variant-count", "zero variants are listed"), check("gate-count", "zero gates are listed"), check("live-caller-count", "one live reader is held"), check("execution-credit", "no execution credit is claimed"), check("retirement-eligible", "retirement stays ineligible"), check("review-state", "disposition review is recorded"), check("frozen-date", "frozen date stays 2026-09-24")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/t26-comparison-run" => ok [expected_check("row-id", "HISTORY-057"), expected_check("source-file", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json"), expected_check("disposition", "preserve_record"), expected_check("decision", "retain"), expected_check("protected-count", "1"), expected_check("variant-count", "0"), expected_check("gate-count", "0"), expected_check("live-caller-count", "1"), expected_check("execution-credit", "none"), expected_check("retirement-eligible", "false"), expected_check("review-state", "reviewed"), expected_check("frozen-date", "2026-09-24")]
        unknown: "nope" => ok []
    match case is "history/t26-comparison-run"
        false => ok []
        true => ok [expected_check("row-id", "HISTORY-057"), expected_check("source-file", "tests/baseline/reports/t26-agent-comparison-2026-09-24.json"), expected_check("disposition", "preserve_record"), expected_check("decision", "retain"), expected_check("protected-count", "1"), expected_check("variant-count", "0"), expected_check("gate-count", "0"), expected_check("live-caller-count", "1"), expected_check("execution-credit", "none"), expected_check("retirement-eligible", "false"), expected_check("review-state", "reviewed"), expected_check("frozen-date", "2026-09-24")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/t26-comparison-run", "default", "", "offline") => ok
        seed_row_id_drift: context("history/t26-comparison-run", "seed-row-id-drift", "", "offline") => failed{"row-id"}
        seed_source_file_drift: context("history/t26-comparison-run", "seed-source-file-drift", "", "offline") => failed{"source-file"}
        seed_disposition_drift: context("history/t26-comparison-run", "seed-disposition-drift", "", "offline") => failed{"disposition"}
        seed_decision_drift: context("history/t26-comparison-run", "seed-decision-drift", "", "offline") => failed{"decision"}
        seed_protected_count_drift: context("history/t26-comparison-run", "seed-protected-count-drift", "", "offline") => failed{"protected-count"}
        seed_variant_count_drift: context("history/t26-comparison-run", "seed-variant-count-drift", "", "offline") => failed{"variant-count"}
        seed_gate_count_drift: context("history/t26-comparison-run", "seed-gate-count-drift", "", "offline") => failed{"gate-count"}
        seed_live_caller_count_drift: context("history/t26-comparison-run", "seed-live-caller-count-drift", "", "offline") => failed{"live-caller-count"}
        seed_execution_credit_drift: context("history/t26-comparison-run", "seed-execution-credit-drift", "", "offline") => failed{"execution-credit"}
        seed_retirement_eligible_drift: context("history/t26-comparison-run", "seed-retirement-eligible-drift", "", "offline") => failed{"retirement-eligible"}
        seed_review_state_drift: context("history/t26-comparison-run", "seed-review-state-drift", "", "offline") => failed{"review-state"}
        seed_frozen_date_drift: context("history/t26-comparison-run", "seed-frozen-date-drift", "", "offline") => failed{"frozen-date"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.row_id, "HISTORY-057", c, "row-id")
            failed
            ok evidence row_id_evidence => match call require_text(got.source_file, "tests/baseline/reports/t26-agent-comparison-2026-09-24.json", c, "source-file")
                failed
                ok evidence source_file_evidence => match call require_text(got.disposition, "preserve_record", c, "disposition")
                    failed
                    ok evidence disposition_evidence => match call require_text(got.decision, "retain", c, "decision")
                        failed
                        ok evidence decision_evidence => match call require_int(got.protected_count, 1, c, "protected-count")
                            failed
                            ok evidence protected_count_evidence => match call require_int(got.variant_count, 0, c, "variant-count")
                                failed
                                ok evidence variant_count_evidence => match call require_int(got.gate_count, 0, c, "gate-count")
                                    failed
                                    ok evidence gate_count_evidence => match call require_int(got.live_caller_count, 1, c, "live-caller-count")
                                        failed
                                        ok evidence live_caller_count_evidence => match call require_text(got.execution_credit, "none", c, "execution-credit")
                                            failed
                                            ok evidence execution_credit_evidence => match call require_bool(got.retirement_eligible, false, c, "retirement-eligible")
                                                failed
                                                ok evidence retirement_eligible_evidence => match call require_text(got.review_state, "reviewed", c, "review-state")
                                                    failed
                                                    ok evidence review_state_evidence => match call require_text(got.frozen_date, "2026-09-24", c, "frozen-date")
                                                        failed
                                                        ok evidence frozen_date_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m30_057: "m30-057" => ok test_case("history/t26-comparison-run", ["history", "m30"], [], 60000, [check_ref("row-id"), check_ref("source-file"), check_ref("disposition"), check_ref("decision"), check_ref("protected-count"), check_ref("variant-count"), check_ref("gate-count"), check_ref("live-caller-count"), check_ref("execution-credit"), check_ref("retirement-eligible"), check_ref("review-state"), check_ref("frozen-date")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m30-057"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/t26-comparison-run", ["history", "m30"], [], 60000, [check_ref("row-id"), check_ref("source-file"), check_ref("disposition"), check_ref("decision"), check_ref("protected-count"), check_ref("variant-count"), check_ref("gate-count"), check_ref("live-caller-count"), check_ref("execution-credit"), check_ref("retirement-eligible"), check_ref("review-state"), check_ref("frozen-date")], callable case_body)
