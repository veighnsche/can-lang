package m30history058base
    provides [context, check, check_ref, expected_check, evidence, observation, failed, test_case, selector, require_bool, require_int, require_text, observe, checks, expected_vector, case_body, descriptor]
    uses [text]

/// M30 HISTORY-058 base: frozen bytes of the T26 prose comparison record
/// (tests/baseline/reports/t26-agent-comparison-2026-09-24.md, 2871 bytes,
/// 58 lines, md5 3106d98d7e97ef67b1e9fb19bbcf7a24). One check per pinned
/// facet: title-line, date-prose, json-name, heading-what-ran,
/// heading-per-case, heading-significance, attempts-needle, null-needle,
/// model-pins, settings-needle, fixtures-needle, replay-go-needle,
/// replay-bun-needle, replay-catalogue-needle, significance-needle,
/// rule-needle, case-id-0, case-id-1, case-id-2, case-id-3, case-id-4,
/// case-id-5, case-id-6, owner-line, disposition-shipped,
/// disposition-deferred, record-md5, heading-count, case-count,
/// shipped-count, deferred-count, byte-size, line-count. Each seed drifts
/// exactly one field; no execution credit is claimed here.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str title_line
    str date_prose
    str json_name
    str heading_what_ran
    str heading_per_case
    str heading_significance
    str attempts_needle
    str null_needle
    str model_pins
    str settings_needle
    str fixtures_needle
    str replay_go_needle
    str replay_bun_needle
    str replay_catalogue_needle
    str significance_needle
    str rule_needle
    str case_id_0
    str case_id_1
    str case_id_2
    str case_id_3
    str case_id_4
    str case_id_5
    str case_id_6
    str owner_line
    str disposition_shipped
    str disposition_deferred
    str record_md5
    int heading_count
    int case_count
    int shipped_count
    int deferred_count
    int byte_size
    int line_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
/// Exact reproduction selector: case, variant, root and run.
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prose-record-base", "default", "", "offline"), "title-line" => ok "case history/prose-record-base variant default root title-line run offline"
        planned: context("a/b", "-", "", "static"), "plan" => ok "case a/b variant - root plan run static"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
/// Compare two bools for a named check.
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prose-record-base", "default", "", "offline"), "title-line" => ok evidence("title-line", "true", "true", true, "case history/prose-record-base variant default root title-line run offline")
        different: true, false, context("history/prose-record-base", "default", "", "offline"), "title-line" => failed{"title-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
/// Compare two ints for a named check.
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/prose-record-base", "default", "", "offline"), "heading-count" => ok evidence("heading-count", "3", "3", true, "case history/prose-record-base variant default root heading-count run offline")
        different: 3, 4, context("history/prose-record-base", "default", "", "offline"), "heading-count" => failed{"heading-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
/// Compare two strs for a named check.
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "a", "a", context("history/prose-record-base", "default", "", "offline"), "title-line" => ok evidence("title-line", "a", "a", true, "case history/prose-record-base variant default root title-line run offline")
        different: "a", "b", context("history/prose-record-base", "default", "", "offline"), "title-line" => failed{"title-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
