fn test_case descriptor
    emits {}
    given
        str id
    asserts
        known: "history/prose-record-base" => ok test_case("history/prose-record-base", ["history"], ["reviewed-disposition"], 15000, [check_ref("title-line"), check_ref("date-prose"), check_ref("json-name"), check_ref("heading-what-ran"), check_ref("heading-per-case"), check_ref("heading-significance"), check_ref("attempts-needle"), check_ref("null-needle"), check_ref("model-pins"), check_ref("settings-needle"), check_ref("fixtures-needle"), check_ref("replay-go-needle"), check_ref("replay-bun-needle"), check_ref("replay-catalogue-needle"), check_ref("significance-needle"), check_ref("rule-needle"), check_ref("case-id-0"), check_ref("case-id-1"), check_ref("case-id-2"), check_ref("case-id-3"), check_ref("case-id-4"), check_ref("case-id-5"), check_ref("case-id-6"), check_ref("owner-line"), check_ref("disposition-shipped"), check_ref("disposition-deferred"), check_ref("record-md5"), check_ref("heading-count"), check_ref("case-count"), check_ref("shipped-count"), check_ref("deferred-count"), check_ref("byte-size"), check_ref("line-count")], callable case_body)
