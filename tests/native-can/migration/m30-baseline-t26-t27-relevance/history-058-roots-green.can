package m30history058roots
    provides [context, check, check_ref, expected_check, evidence, observation, failed, test_case, selector, require_bool, require_int, require_text, observe, checks, expected_vector, case_body, descriptor]
    uses [text]

/// M30 HISTORY-058 roots: live-caller legs of the T26 prose comparison
/// record. One code caller (existence-only os.Stat) plus four prose
/// pointers: caller-go-path, caller-go-reads, caller-go-kind,
/// caller-go-line, caller-readme-path, caller-readme-reads,
/// caller-readme-kind, caller-readme-line, caller-guide-path,
/// caller-guide-reads, caller-guide-kind, caller-guide-line,
/// caller-audit-path, caller-audit-reads, caller-audit-kind,
/// caller-audit-line, caller-tasklist-path, caller-tasklist-reads,
/// caller-tasklist-kind, caller-tasklist-line. Each seed drifts exactly
/// one field; no execution credit is claimed here.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str caller_go_path
    str caller_go_reads
    str caller_go_kind
    str caller_readme_path
    str caller_readme_reads
    str caller_readme_kind
    str caller_guide_path
    str caller_guide_reads
    str caller_guide_kind
    str caller_audit_path
    str caller_audit_reads
    str caller_audit_kind
    str caller_tasklist_path
    str caller_tasklist_reads
    str caller_tasklist_kind
    int caller_go_line
    int caller_readme_line
    int caller_guide_line
    int caller_audit_line
    int caller_tasklist_line
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
/// Exact reproduction selector: case, variant, root and run.
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prose-record-roots", "default", "", "offline"), "caller-go-path" => ok "case history/prose-record-roots variant default root caller-go-path run offline"
        planned: context("a/b", "-", "", "static"), "plan" => ok "case a/b variant - root plan run static"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
/// Compare two bools for a named check.
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prose-record-roots", "default", "", "offline"), "caller-go-path" => ok evidence("caller-go-path", "true", "true", true, "case history/prose-record-roots variant default root caller-go-path run offline")
        different: true, false, context("history/prose-record-roots", "default", "", "offline"), "caller-go-path" => failed{"caller-go-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
/// Compare two ints for a named check.
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/prose-record-roots", "default", "", "offline"), "caller-go-line" => ok evidence("caller-go-line", "3", "3", true, "case history/prose-record-roots variant default root caller-go-line run offline")
        different: 3, 4, context("history/prose-record-roots", "default", "", "offline"), "caller-go-line" => failed{"caller-go-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
/// Compare two strs for a named check.
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "a", "a", context("history/prose-record-roots", "default", "", "offline"), "caller-go-path" => ok evidence("caller-go-path", "a", "a", true, "case history/prose-record-roots variant default root caller-go-path run offline")
        different: "a", "b", context("history/prose-record-roots", "default", "", "offline"), "caller-go-path" => failed{"caller-go-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
