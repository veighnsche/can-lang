package m30history058run
    provides [context, check, check_ref, expected_check, evidence, observation, failed, test_case, selector, require_bool, require_int, require_text, observe, checks, expected_vector, case_body, descriptor]
    uses [text]

/// M30 HISTORY-058 run: disposition review of the T26 prose comparison
/// record against the live callers above. Decision inputs: record-date,
/// record-task, decision, rationale, protects-count, variant-count,
/// env-gate-count, live-caller-count, code-caller-count,
/// doc-pointer-count, execution-credit, retirement-eligible.
/// Retain: frozen record stays; dates and unrun trials are history, not
/// execution evidence. Each seed drifts exactly one field; execution
/// credit stays zero and retirement stays false here.

record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str record_date
    str record_task
    str decision
    str rationale
    int protects_count
    int variant_count
    int env_gate_count
    int live_caller_count
    int code_caller_count
    int doc_pointer_count
    int execution_credit
    int retirement_eligible
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
/// Exact reproduction selector: case, variant, root and run.
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prose-record-run", "default", "", "offline"), "record-date" => ok "case history/prose-record-run variant default root record-date run offline"
        planned: context("a/b", "-", "", "static"), "plan" => ok "case a/b variant - root plan run static"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
/// Compare two bools for a named check.
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prose-record-run", "default", "", "offline"), "record-date" => ok evidence("record-date", "true", "true", true, "case history/prose-record-run variant default root record-date run offline")
        different: true, false, context("history/prose-record-run", "default", "", "offline"), "record-date" => failed{"record-date"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
/// Compare two ints for a named check.
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/prose-record-run", "default", "", "offline"), "protects-count" => ok evidence("protects-count", "3", "3", true, "case history/prose-record-run variant default root protects-count run offline")
        different: 3, 4, context("history/prose-record-run", "default", "", "offline"), "protects-count" => failed{"protects-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
/// Compare two strs for a named check.
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "a", "a", context("history/prose-record-run", "default", "", "offline"), "record-date" => ok evidence("record-date", "a", "a", true, "case history/prose-record-run variant default root record-date run offline")
        different: "a", "b", context("history/prose-record-run", "default", "", "offline"), "record-date" => failed{"record-date"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
/// Bounded probe observations: default plus one one-field-off seed per check.
fn observation observe
    emits {}
    given
        str probe
    asserts
        default: "default" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
        seed_record_date: "seed-record-date-drift" => ok observation("2026-09-24_2", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
        seed_record_task: "seed-record-task-drift" => ok observation("2026-09-24", "T26_2", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
        seed_decision: "seed-decision-drift" => ok observation("2026-09-24", "T26", "retain_2", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
        seed_rationale: "seed-rationale-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence_2", 1, 0, 0, 5, 1, 4, 0, 0)
        seed_protects_count: "seed-protects-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 0, 0, 0, 5, 1, 4, 0, 0)
        seed_variant_count: "seed-variant-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, -1, 0, 5, 1, 4, 0, 0)
        seed_env_gate_count: "seed-env-gate-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, -1, 5, 1, 4, 0, 0)
        seed_live_caller_count: "seed-live-caller-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 4, 1, 4, 0, 0)
        seed_code_caller_count: "seed-code-caller-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 0, 4, 0, 0)
        seed_doc_pointer_count: "seed-doc-pointer-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 3, 0, 0)
        seed_execution_credit: "seed-execution-credit-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, -1, 0)
        seed_retirement_eligible: "seed-retirement-eligible-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, -1)
    match probe
        "seed-record-date-drift" => ok observation("2026-09-24_2", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
        "seed-record-task-drift" => ok observation("2026-09-24", "T26_2", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
        "seed-decision-drift" => ok observation("2026-09-24", "T26", "retain_2", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
        "seed-rationale-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence_2", 1, 0, 0, 5, 1, 4, 0, 0)
        "seed-protects-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 0, 0, 0, 5, 1, 4, 0, 0)
        "seed-variant-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, -1, 0, 5, 1, 4, 0, 0)
        "seed-env-gate-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, -1, 5, 1, 4, 0, 0)
        "seed-live-caller-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 4, 1, 4, 0, 0)
        "seed-code-caller-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 0, 4, 0, 0)
        "seed-doc-pointer-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 3, 0, 0)
        "seed-execution-credit-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, -1, 0)
        "seed-retirement-eligible-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, -1)
        _ => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
/// Declared check inventory for the history scope.
fn check[] checks
    emits {}
    given
        str scope
    asserts
        known: "history" => ok [check("record-date", "record vintage"), check("record-task", "record task"), check("decision", "review decision"), check("rationale", "review rationale"), check("protects-count", "protected facet count"), check("variant-count", "variant count"), check("env-gate-count", "environment gate count"), check("live-caller-count", "live caller tally"), check("code-caller-count", "code caller tally"), check("doc-pointer-count", "doc pointer tally"), check("execution-credit", "execution credit"), check("retirement-eligible", "retirement flag")]
        unknown: "other" => ok []
    match scope is "history"
        false => ok []
        true => ok [check("record-date", "record vintage"), check("record-task", "record task"), check("decision", "review decision"), check("rationale", "review rationale"), check("protects-count", "protected facet count"), check("variant-count", "variant count"), check("env-gate-count", "environment gate count"), check("live-caller-count", "live caller tally"), check("code-caller-count", "code caller tally"), check("doc-pointer-count", "doc pointer tally"), check("execution-credit", "execution credit"), check("retirement-eligible", "retirement flag")]
/// Expected observation vector per case id.
fn expected_check[] expected_vector
    emits {}
    given
        str case_id
    asserts
        known: "history/prose-record-run" => ok [expected_check("record-date", "2026-09-24"), expected_check("record-task", "T26"), expected_check("decision", "retain"), expected_check("rationale", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence"), expected_check("protects-count", "1"), expected_check("variant-count", "0"), expected_check("env-gate-count", "0"), expected_check("live-caller-count", "5"), expected_check("code-caller-count", "1"), expected_check("doc-pointer-count", "4"), expected_check("execution-credit", "0"), expected_check("retirement-eligible", "0")]
        unknown: "nope" => ok []
    match case_id is "history/prose-record-run"
        false => ok []
        true => ok [expected_check("record-date", "2026-09-24"), expected_check("record-task", "T26"), expected_check("decision", "retain"), expected_check("rationale", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence"), expected_check("protects-count", "1"), expected_check("variant-count", "0"), expected_check("env-gate-count", "0"), expected_check("live-caller-count", "5"), expected_check("code-caller-count", "1"), expected_check("doc-pointer-count", "4"), expected_check("execution-credit", "0"), expected_check("retirement-eligible", "0")]
/// Case body: every pinned field must compare equal; each seed must refuse at its own check.
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/prose-record-run", "default", "", "offline") => ok
        seed_record_date: context("history/prose-record-run", "default", "", "offline") => failed{"record-date"}
        seed_record_task: context("history/prose-record-run", "default", "", "offline") => failed{"record-task"}
        seed_decision: context("history/prose-record-run", "default", "", "offline") => failed{"decision"}
        seed_rationale: context("history/prose-record-run", "default", "", "offline") => failed{"rationale"}
        seed_protects_count: context("history/prose-record-run", "default", "", "offline") => failed{"protects-count"}
        seed_variant_count: context("history/prose-record-run", "default", "", "offline") => failed{"variant-count"}
        seed_env_gate_count: context("history/prose-record-run", "default", "", "offline") => failed{"env-gate-count"}
        seed_live_caller_count: context("history/prose-record-run", "default", "", "offline") => failed{"live-caller-count"}
        seed_code_caller_count: context("history/prose-record-run", "default", "", "offline") => failed{"code-caller-count"}
        seed_doc_pointer_count: context("history/prose-record-run", "default", "", "offline") => failed{"doc-pointer-count"}
        seed_execution_credit: context("history/prose-record-run", "default", "", "offline") => failed{"execution-credit"}
        seed_retirement_eligible: context("history/prose-record-run", "default", "", "offline") => failed{"retirement-eligible"}
    match call observe("default")
        when
            expected: "default" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
            seed_record_date: "seed-record-date-drift" => ok observation("2026-09-24_2", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
            seed_record_task: "seed-record-task-drift" => ok observation("2026-09-24", "T26_2", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
            seed_decision: "seed-decision-drift" => ok observation("2026-09-24", "T26", "retain_2", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, 0)
            seed_rationale: "seed-rationale-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence_2", 1, 0, 0, 5, 1, 4, 0, 0)
            seed_protects_count: "seed-protects-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 0, 0, 0, 5, 1, 4, 0, 0)
            seed_variant_count: "seed-variant-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, -1, 0, 5, 1, 4, 0, 0)
            seed_env_gate_count: "seed-env-gate-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, -1, 5, 1, 4, 0, 0)
            seed_live_caller_count: "seed-live-caller-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 4, 1, 4, 0, 0)
            seed_code_caller_count: "seed-code-caller-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 0, 4, 0, 0)
            seed_doc_pointer_count: "seed-doc-pointer-count-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 3, 0, 0)
            seed_execution_credit: "seed-execution-credit-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, -1, 0)
            seed_retirement_eligible: "seed-retirement-eligible-drift" => ok observation("2026-09-24", "T26", "retain", "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", 1, 0, 0, 5, 1, 4, 0, -1)
        ok observation got => match call require_text(got.record_date, "2026-09-24", c, "record-date")
            failed
            ok evidence record_date_evidence => match call require_text(got.record_task, "T26", c, "record-task")
                failed
                ok evidence record_task_evidence => match call require_text(got.decision, "retain", c, "decision")
                    failed
                    ok evidence decision_evidence => match call require_text(got.rationale, "frozen T26 prose comparison record with one live existence assertion plus four prose pointers; dates and unrun trials are history, not execution evidence", c, "rationale")
                        failed
                        ok evidence rationale_evidence => match call require_int(got.protects_count, 1, c, "protects-count")
                            failed
                            ok evidence protects_count_evidence => match call require_int(got.variant_count, 0, c, "variant-count")
                                failed
                                ok evidence variant_count_evidence => match call require_int(got.env_gate_count, 0, c, "env-gate-count")
                                    failed
                                    ok evidence env_gate_count_evidence => match call require_int(got.live_caller_count, 5, c, "live-caller-count")
                                        failed
                                        ok evidence live_caller_count_evidence => match call require_int(got.code_caller_count, 1, c, "code-caller-count")
                                            failed
                                            ok evidence code_caller_count_evidence => match call require_int(got.doc_pointer_count, 4, c, "doc-pointer-count")
                                                failed
                                                ok evidence doc_pointer_count_evidence => match call require_int(got.execution_credit, 0, c, "execution-credit")
                                                    failed
                                                    ok evidence execution_credit_evidence => match call require_int(got.retirement_eligible, 0, c, "retirement-eligible")
                                                        failed
                                                        ok evidence retirement_eligible_evidence => ok
/// Case descriptor for selection and planning.
fn test_case descriptor
    emits {}
    given
        str id
    asserts
        known: "history/prose-record-run" => ok test_case("history/prose-record-run", ["history"], ["reviewed-disposition"], 15000, [check_ref("record-date"), check_ref("record-task"), check_ref("decision"), check_ref("rationale"), check_ref("protects-count"), check_ref("variant-count"), check_ref("env-gate-count"), check_ref("live-caller-count"), check_ref("code-caller-count"), check_ref("doc-pointer-count"), check_ref("execution-credit"), check_ref("retirement-eligible")], callable case_body)
        unknown: "nope" => ok test_case("nope", [], [], 0, [], callable case_body)
    match id is "history/prose-record-run"
        false => ok test_case(id, [], [], 0, [], callable case_body)
        true => ok test_case("history/prose-record-run", ["history"], ["reviewed-disposition"], 15000, [check_ref("record-date"), check_ref("record-task"), check_ref("decision"), check_ref("rationale"), check_ref("protects-count"), check_ref("variant-count"), check_ref("env-gate-count"), check_ref("live-caller-count"), check_ref("code-caller-count"), check_ref("doc-pointer-count"), check_ref("execution-credit"), check_ref("retirement-eligible")], callable case_body)
