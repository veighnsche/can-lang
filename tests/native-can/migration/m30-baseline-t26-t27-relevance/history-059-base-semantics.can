package m30history059base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-059 "T26-native-ai README.md" base record.
/// Source: tests/baseline/candidates/T26-native-ai/README.md (45 lines,
/// 1978 bytes, md5 fbae3dabacb0f2f8c9c72aba3dabab9e).
/// Disposition: preserve_record (this row keeps the frozen deferral
/// record; current assertions may read it but its dates and unrun
/// trials are not new execution proof).
/// Protects (this file): the L1/L8/L23/L35 heads, the case id, the
/// owner task, the slot path, the DI-17 tag, both current-idiom
/// fixtures, the held-out id, the replay command plus archive guard,
/// the candidate/report links, the no-significance line, the frozen
/// md5, and the heading/bullet/byte/line/deferred/case tallies.
/// ADAPTATION (recorded, with source lines): head pins hold verbatim
/// head bytes (L1/L8/L23/L35); entry pins hold verbatim entry bytes
/// (case L3, owner L4, slot L6, DI-17 L10, fixtures L15/L17, held-out
/// L18, replay L39, guard L40, links L43/L44, significance L45);
/// tally pins hold ints tallied under the md5 lock (heads 4, bullets
/// 4, bytes 1978, lines 45, deferred 4, case mentions 3).
/// The roots-green pins live in history-059-roots-green.can; the run
/// shape plus verdict live in history-059-run-shape.can.
/// Variants: none. Environment: no gates; requires nothing.
/// R/N/S/A identities bind at P23; no live run now. Accept gate is
/// reviewed disposition (no live qualification for preserve_record).
/// Timeout 60000ms is a neutral offline descriptor default.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (preserved history is not execution
/// proof; retirement_eligible false).
/// Case history/readme-record-base checks: title-head,
/// disposition-head, boundary-head, replay-head, case-id, owner-task,
/// slot-path, mechanism, fixture-native, fixture-judge, heldout-id,
/// replay-cmd, replay-env, candidate-link, report-link, significance,
/// record-md5, heading-count, bullet-count, byte-size, line-count,
/// deferred-count, case-mention-count.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str title_head
    str disposition_head
    str boundary_head
    str replay_head
    str case_id
    str owner_task
    str slot_path
    str mechanism
    str fixture_native
    str fixture_judge
    str heldout_id
    str replay_cmd
    str replay_env
    str candidate_link
    str report_link
    str significance
    str record_md5
    int heading_count
    int bullet_count
    int byte_size
    int line_count
    int deferred_count
    int case_mention_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/readme-record-base", "default", "", "offline"), "title-head" => ok "case history/readme-record-base variant default root title-head run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/readme-record-base", "default", "", "offline"), "title-head" => ok evidence("title-head", "true", "true", true, "case history/readme-record-base variant default root title-head run offline")
        different: false, true, context("history/readme-record-base", "default", "", "offline"), "title-head" => failed{"title-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/readme-record-base", "default", "", "offline"), "title-head" => ok evidence("title-head", "4", "4", true, "case history/readme-record-base variant default root title-head run offline")
        different: 3, 4, context("history/readme-record-base", "default", "", "offline"), "title-head" => failed{"title-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "# T26 native-judgment candidate slot: deferred, current idiom retained", "# T26 native-judgment candidate slot: deferred, current idiom retained", context("history/readme-record-base", "default", "", "offline"), "title-head" => ok evidence("title-head", "# T26 native-judgment candidate slot: deferred, current idiom retained", "# T26 native-judgment candidate slot: deferred, current idiom retained", true, "case history/readme-record-base variant default root title-head run offline")
        different: "# T26 native-judgment candidate slot: deferred, current idiom retained_2", "# T26 native-judgment candidate slot: deferred, current idiom retained", context("history/readme-record-base", "default", "", "offline"), "title-head" => failed{"title-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
