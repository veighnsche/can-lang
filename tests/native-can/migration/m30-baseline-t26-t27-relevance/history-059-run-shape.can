package m30history059run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M30 HISTORY-059 "T26-native-ai README.md" disposition review shape.
/// Source: tests/baseline/candidates/T26-native-ai/README.md; review
/// inputs from the coverage map plus the verified live callers.
/// Disposition: preserve_record (this file records the
/// retain/migrate/obsolete review as bounded observations).
/// Protects (this file): the frozen source, case and verdict names,
/// the retain verdict plus rationale, the 1/0/0 facet tallies, the
/// 2+4 caller tallies, and the zero credit/retirement flags.
/// ADAPTATION (recorded): source/case/verdict pins hold frozen source
/// spellings; decision pins retain; rationale records why the frozen
/// bytes stay (live readers pin deferral wording; dates plus unrun
/// trials stay history); tally pins hold coverage-map counts (1 facet,
/// 0 variants, 0 gates) plus caller counts (2 code, 4 doc); credit
/// pins hold 0 (no execution proof) and retirement holds 0 (kept).
/// The base record pins live in history-059-base-semantics.can; the
/// live-caller roots live in history-059-roots-green.can.
/// Variants: none. Environment: no gates; requires nothing.
/// R/N/S/A identities bind at P23; no live run now. Accept gate is
/// reviewed disposition (no live qualification for preserve_record).
/// Timeout 60000ms is a neutral offline descriptor default.
/// Delegated oracles: none.
/// Execution credit: NOT claimed (preserved history is not execution
/// proof; retirement_eligible false).
/// Case history/readme-record-run checks: record-source, record-case,
/// record-disposition, decision, rationale, protects-count,
/// variant-count, env-gate-count, live-caller-count, doc-ref-count,
/// execution-credit, retirement-eligible.
/// Shared old files untouched; retirement is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str record_source
    str record_case
    str record_disposition
    str decision
    str rationale
    int protects_count
    int variant_count
    int env_gate_count
    int live_caller_count
    int doc_ref_count
    int execution_credit
    int retirement_eligible
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/readme-record-run", "default", "", "offline"), "record-source" => ok "case history/readme-record-run variant default root record-source run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/readme-record-run", "default", "", "offline"), "record-source" => ok evidence("record-source", "true", "true", true, "case history/readme-record-run variant default root record-source run offline")
        different: false, true, context("history/readme-record-run", "default", "", "offline"), "record-source" => failed{"record-source"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/readme-record-run", "default", "", "offline"), "record-source" => ok evidence("record-source", "1", "1", true, "case history/readme-record-run variant default root record-source run offline")
        different: 0, 1, context("history/readme-record-run", "default", "", "offline"), "record-source" => failed{"record-source"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "tests/baseline/candidates/T26-native-ai/README.md", "tests/baseline/candidates/T26-native-ai/README.md", context("history/readme-record-run", "default", "", "offline"), "record-source" => ok evidence("record-source", "tests/baseline/candidates/T26-native-ai/README.md", "tests/baseline/candidates/T26-native-ai/README.md", true, "case history/readme-record-run variant default root record-source run offline")
        different: "tests/baseline/candidates/T26-native-ai/README.md_2", "tests/baseline/candidates/T26-native-ai/README.md", context("history/readme-record-run", "default", "", "offline"), "record-source" => failed{"record-source"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        seed_record_source: "seed-record-source-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md_2", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        seed_record_case: "seed-record-case-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment_2", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        seed_record_disposition: "seed-record-disposition-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred_2", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        seed_decision: "seed-decision-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain_2", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        seed_rationale: "seed-rationale-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit_2", 1, 0, 0, 2, 4, 0, 0)
        seed_protects_count: "seed-protects-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 0, 0, 0, 2, 4, 0, 0)
        seed_variant_count: "seed-variant-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, -1, 0, 2, 4, 0, 0)
        seed_env_gate_count: "seed-env-gate-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, -1, 2, 4, 0, 0)
        seed_live_caller_count: "seed-live-caller-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 1, 4, 0, 0)
        seed_doc_ref_count: "seed-doc-ref-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 3, 0, 0)
        seed_execution_credit: "seed-execution-credit-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, -1, 0)
        seed_retirement_eligible: "seed-retirement-eligible-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, -1)
    match variant_id
        "seed-record-source-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md_2", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        "seed-record-case-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment_2", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        "seed-record-disposition-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred_2", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        "seed-decision-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain_2", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
        "seed-rationale-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit_2", 1, 0, 0, 2, 4, 0, 0)
        "seed-protects-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 0, 0, 0, 2, 4, 0, 0)
        "seed-variant-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, -1, 0, 2, 4, 0, 0)
        "seed-env-gate-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, -1, 2, 4, 0, 0)
        "seed-live-caller-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 1, 4, 0, 0)
        "seed-doc-ref-count-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 3, 0, 0)
        "seed-execution-credit-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, -1, 0)
        "seed-retirement-eligible-drift" => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, -1)
        _ => ok observation("tests/baseline/candidates/T26-native-ai/README.md", "native-judgment", "deferred", "retain", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", 1, 0, 0, 2, 4, 0, 0)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m30_h059: "m30-h059" => ok [check("record-source", "review names the frozen source"), check("record-case", "review names the frozen case"), check("record-disposition", "review names the frozen verdict"), check("decision", "review verdict is retain"), check("rationale", "retain rationale is recorded"), check("protects-count", "one protected facet"), check("variant-count", "zero variants"), check("env-gate-count", "zero environment gates"), check("live-caller-count", "two live code callers"), check("doc-ref-count", "four doc links"), check("execution-credit", "zero execution credit"), check("retirement-eligible", "not retirement eligible")]
        other: "nope" => ok []
    match scope is "m30-h059"
        false => ok []
        true => ok [check("record-source", "review names the frozen source"), check("record-case", "review names the frozen case"), check("record-disposition", "review names the frozen verdict"), check("decision", "review verdict is retain"), check("rationale", "retain rationale is recorded"), check("protects-count", "one protected facet"), check("variant-count", "zero variants"), check("env-gate-count", "zero environment gates"), check("live-caller-count", "two live code callers"), check("doc-ref-count", "four doc links"), check("execution-credit", "zero execution credit"), check("retirement-eligible", "not retirement eligible")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/readme-record-run" => ok [expected_check("record-source", "tests/baseline/candidates/T26-native-ai/README.md"), expected_check("record-case", "native-judgment"), expected_check("record-disposition", "deferred"), expected_check("decision", "retain"), expected_check("rationale", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit"), expected_check("protects-count", "1"), expected_check("variant-count", "0"), expected_check("env-gate-count", "0"), expected_check("live-caller-count", "2"), expected_check("doc-ref-count", "4"), expected_check("execution-credit", "0"), expected_check("retirement-eligible", "0")]
        unknown: "nope" => ok []
    match case is "history/readme-record-run"
        false => ok []
        true => ok [expected_check("record-source", "tests/baseline/candidates/T26-native-ai/README.md"), expected_check("record-case", "native-judgment"), expected_check("record-disposition", "deferred"), expected_check("decision", "retain"), expected_check("rationale", "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit"), expected_check("protects-count", "1"), expected_check("variant-count", "0"), expected_check("env-gate-count", "0"), expected_check("live-caller-count", "2"), expected_check("doc-ref-count", "4"), expected_check("execution-credit", "0"), expected_check("retirement-eligible", "0")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/readme-record-run", "default", "", "offline") => ok
        seed_record_source: context("history/readme-record-run", "seed-record-source-drift", "", "offline") => failed{"record-source"}
        seed_record_case: context("history/readme-record-run", "seed-record-case-drift", "", "offline") => failed{"record-case"}
        seed_record_disposition: context("history/readme-record-run", "seed-record-disposition-drift", "", "offline") => failed{"record-disposition"}
        seed_decision: context("history/readme-record-run", "seed-decision-drift", "", "offline") => failed{"decision"}
        seed_rationale: context("history/readme-record-run", "seed-rationale-drift", "", "offline") => failed{"rationale"}
        seed_protects_count: context("history/readme-record-run", "seed-protects-count-drift", "", "offline") => failed{"protects-count"}
        seed_variant_count: context("history/readme-record-run", "seed-variant-count-drift", "", "offline") => failed{"variant-count"}
        seed_env_gate_count: context("history/readme-record-run", "seed-env-gate-count-drift", "", "offline") => failed{"env-gate-count"}
        seed_live_caller_count: context("history/readme-record-run", "seed-live-caller-count-drift", "", "offline") => failed{"live-caller-count"}
        seed_doc_ref_count: context("history/readme-record-run", "seed-doc-ref-count-drift", "", "offline") => failed{"doc-ref-count"}
        seed_execution_credit: context("history/readme-record-run", "seed-execution-credit-drift", "", "offline") => failed{"execution-credit"}
        seed_retirement_eligible: context("history/readme-record-run", "seed-retirement-eligible-drift", "", "offline") => failed{"retirement-eligible"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.record_source, "tests/baseline/candidates/T26-native-ai/README.md", c, "record-source")
            failed
            ok evidence record_source_evidence => match call require_text(got.record_case, "native-judgment", c, "record-case")
                failed
                ok evidence record_case_evidence => match call require_text(got.record_disposition, "deferred", c, "record-disposition")
                    failed
                    ok evidence record_disposition_evidence => match call require_text(got.decision, "retain", c, "decision")
                        failed
                        ok evidence decision_evidence => match call require_text(got.rationale, "2 live Go readers pin deferral bytes; frozen T01/T26 history kept; zero execution credit", c, "rationale")
                            failed
                            ok evidence rationale_evidence => match call require_int(got.protects_count, 1, c, "protects-count")
                                failed
                                ok evidence protects_count_evidence => match call require_int(got.variant_count, 0, c, "variant-count")
                                    failed
                                    ok evidence variant_count_evidence => match call require_int(got.env_gate_count, 0, c, "env-gate-count")
                                        failed
                                        ok evidence env_gate_count_evidence => match call require_int(got.live_caller_count, 2, c, "live-caller-count")
                                            failed
                                            ok evidence live_caller_count_evidence => match call require_int(got.doc_ref_count, 4, c, "doc-ref-count")
                                                failed
                                                ok evidence doc_ref_count_evidence => match call require_int(got.execution_credit, 0, c, "execution-credit")
                                                    failed
                                                    ok evidence execution_credit_evidence => match call require_int(got.retirement_eligible, 0, c, "retirement-eligible")
                                                        failed
                                                        ok evidence retirement_eligible_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m30_h059: "m30-h059" => ok test_case("history/readme-record-run", ["history", "m30"], [], 60000, [check_ref("record-source"), check_ref("record-case"), check_ref("record-disposition"), check_ref("decision"), check_ref("rationale"), check_ref("protects-count"), check_ref("variant-count"), check_ref("env-gate-count"), check_ref("live-caller-count"), check_ref("doc-ref-count"), check_ref("execution-credit"), check_ref("retirement-eligible")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m30-h059"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/readme-record-run", ["history", "m30"], [], 60000, [check_ref("record-source"), check_ref("record-case"), check_ref("record-disposition"), check_ref("decision"), check_ref("rationale"), check_ref("protects-count"), check_ref("variant-count"), check_ref("env-gate-count"), check_ref("live-caller-count"), check_ref("doc-ref-count"), check_ref("execution-credit"), check_ref("retirement-eligible")], callable case_body)
