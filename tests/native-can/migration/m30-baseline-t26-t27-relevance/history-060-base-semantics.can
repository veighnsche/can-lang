    emits {}
    given
        str case_id
    asserts
        known: "history/candidate-record-base" => ok test_case("history/candidate-record-base", ["history"], [], 15000, [check_ref("key-case"), check_ref("key-date"), check_ref("key-disposition"), check_ref("key-mechanism"), check_ref("key-owner-task"), check_ref("key-significance"), check_ref("key-slot"), check_ref("case-value"), check_ref("date-value"), check_ref("disposition-value"), check_ref("mechanism-value"), check_ref("owner-task-value"), check_ref("significance-value"), check_ref("slot-value"), check_ref("key-count"), check_ref("byte-size"), check_ref("line-count")], callable case_body)
        unknown: "nope" => ok test_case("nope", [], [], 0, [], callable case_body)
    match case_id is "history/candidate-record-base"
        false => ok test_case("nope", [], [], 0, [], callable case_body)
        true => ok test_case("history/candidate-record-base", ["history"], [], 15000, [check_ref("key-case"), check_ref("key-date"), check_ref("key-disposition"), check_ref("key-mechanism"), check_ref("key-owner-task"), check_ref("key-significance"), check_ref("key-slot"), check_ref("case-value"), check_ref("date-value"), check_ref("disposition-value"), check_ref("mechanism-value"), check_ref("owner-task-value"), check_ref("significance-value"), check_ref("slot-value"), check_ref("key-count"), check_ref("byte-size"), check_ref("line-count")], callable case_body)
