/// M30 HISTORY-060 roots green: live readers of tests/baseline/candidates/T26-native-ai/candidate.json.
/// Caller pins name the 2 Go legs that open the record bytes and the deferr
/// needle each asserts: t26 guide leg (L195 ReadFile, L200 needle) and t27
/// release audit leg (L281 readRepoFile, L282 needle).
/// Sibling pins name the co-located README pointer (L43) as a doc reference,
/// not a code caller. run.sh, baseline_test.go and tools/ hold no reader.
/// checks: caller-t26-path, caller-t26-reads, caller-t27-path,
/// caller-t27-reads, doc-sibling-path, doc-sibling-mention, caller-t26-line,
/// caller-t27-line, doc-sibling-line.
package m30history060roots
    provides [context, check, check_ref, expected_check, evidence, observation, failed, test_case, selector, require_bool, require_int, require_text, observe, checks, expected_vector, case_body, descriptor]
    uses [text]

