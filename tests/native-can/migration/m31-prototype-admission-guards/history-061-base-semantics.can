        different: 2, 3, context("history/prototype-admission-base", "default", "", "offline"), "prefix-count" => failed{"prefix-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
