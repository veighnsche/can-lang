package m31history061base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M31 HISTORY-061 "Prototype admission: legs plus needles".
/// Source: tests/host-discrimination/admission_test.go
/// symbol TestPrototypeCapabilitiesUnadmitted (L29-61):
/// two no-admission legs, each pinning a file plus a
/// needle (or a zero tally).
/// Disposition: migrate (this row owns the
/// TestPrototypeCapabilitiesUnadmitted offline pact
/// as reviewable Can facts; the old Go check stays
/// until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the two legs in Go order:
/// the catalogue leg (file plus identity field plus
/// three prefixes plus HasPrefix call) and the
/// generated leg (file plus Contains call), with five
/// tallies.
/// ADAPTATION (recorded, with source lines): prefix
/// pins hold Go quoted bytes; file pins hold Join arg
/// bytes; field pins hold Go ident bytes; call pins
/// hold Go selector bytes; counts pin ints tallied
/// from the Go lists; tally pins hold live scan
/// results over the two trees.
/// prefix-storage pins can.std.storage@ (L24);
/// prefix-clipboard pins can.std.clipboard@ (L25);
/// prefix-chart pins can.std.chart@ (L26);
/// catalogue-path pins
/// compiler/internal/catalogue/catalogue.json (L30);
/// identity-field pins Identity (L36);
/// generated-path pins runtime/catalogue.ts (L52);
/// prefix-count pins int (3) from L23-27;
/// tree-count pins int (2) from L30 plus L52;
/// operation-count pins int (377) live tally;
/// catalogue-hit-count pins int (0) live HasPrefix
/// tally; generated-hit-count pins int (0) live
/// Contains tally.
/// Facet map (legs in Go order): prefix-storage,
/// prefix-clipboard, prefix-chart, catalogue-path,
/// identity-field, generated-path, prefix-count,
/// tree-count, operation-count, catalogue-hit-count,
/// generated-hit-count.
/// The sweep roots live in
/// history-061-roots-green.can; the run shape plus
/// diagnostics live in history-061-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: no gates (row lists zero environment
/// gates; offline only).
/// Logical gates SUITE/DOC/FILES/BUILD bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 accept gate
/// unmet).
/// Case history/prototype-admission-base checks:
/// prefix-storage, prefix-clipboard, prefix-chart,
/// catalogue-path, identity-field, generated-path,
/// prefix-count, tree-count, operation-count,
/// catalogue-hit-count, generated-hit-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str prefix_storage
    str prefix_clipboard
    str prefix_chart
    str catalogue_path
    str identity_field
    str generated_path
    int prefix_count
    int tree_count
    int operation_count
    int catalogue_hit_count
    int generated_hit_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prototype-admission-base", "default", "", "offline"), "prefix-storage" => ok "case history/prototype-admission-base variant default root prefix-storage run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prototype-admission-base", "default", "", "offline"), "prefix-storage" => ok evidence("prefix-storage", "true", "true", true, "case history/prototype-admission-base variant default root prefix-storage run offline")
        different: false, true, context("history/prototype-admission-base", "default", "", "offline"), "prefix-storage" => failed{"prefix-storage"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
