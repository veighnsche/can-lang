        str expected
        context c
        str check
    asserts
        same: "hypotheticalPackages", "hypotheticalPackages", context("history/prototype-admission-roots", "default", "", "offline"), "list-name" => ok evidence("list-name", "hypotheticalPackages", "hypotheticalPackages", true, "case history/prototype-admission-roots variant default root list-name run offline")
        different: "hypotheticalPackages_2", "hypotheticalPackages", context("history/prototype-admission-roots", "default", "", "offline"), "list-name" => failed{"list-name"}
    match observed is expected
