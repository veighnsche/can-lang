package m31history061roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M31 HISTORY-061 "Prototype admission: sweep roots".
/// Source: tests/host-discrimination/admission_test.go
/// symbol TestPrototypeCapabilitiesUnadmitted (L29-61)
/// list shape (L23-27) plus the two inspected trees
/// (L30 plus L52).
/// Disposition: migrate (this row owns the
/// TestPrototypeCapabilitiesUnadmitted offline pact
/// as reviewable Can facts; the old Go check stays
/// until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the sweep roots: the prefix
/// list name, the two tree dirs, the two leaves, the
/// row plus tag shape, the two leg calls, and the two
/// tallies.
/// ADAPTATION (recorded, with source lines): list pins
/// hold L23 bytes; dir pins hold Join dir bytes;
/// leaf pins hold Join leaf bytes; shape pins hold
/// L35-37 spellings; call pins hold L47 plus L57
/// selector bytes; counts pin ints tallied from the
/// Go sites.
/// list-name pins hypotheticalPackages (L23);
/// catalogue-rel-dir pins compiler/internal/catalogue
/// (L30); catalogue-leaf pins catalogue.json (L30);
/// generated-rel-dir pins runtime (L52);
/// generated-leaf pins catalogue.ts (L52);
/// inventory-field pins Operations (L35);
/// identity-tag pins identity (L36);
/// operations-tag pins operations (L37);
/// prefix-call pins strings.HasPrefix (L47);
/// contains-call pins strings.Contains (L57);
/// read-count pins int (2) from L30 plus L52;
/// loop-count pins int (3) from L45, L46 plus L56.
/// Facet map (sweep in Go order): list-name,
/// catalogue-rel-dir, catalogue-leaf,
/// generated-rel-dir, generated-leaf, inventory-field,
/// identity-tag, operations-tag, prefix-call,
/// contains-call, read-count, loop-count.
/// The anchor legs live in
/// history-061-base-semantics.can; the run shape plus
/// diagnostics live in history-061-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: no gates (row lists zero environment
/// gates; offline only).
/// Logical gates SUITE/DOC/FILES/BUILD bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 accept gate
/// unmet).
/// Case history/prototype-admission-roots checks:
/// list-name, catalogue-rel-dir, catalogue-leaf,
/// generated-rel-dir, generated-leaf, inventory-field,
/// identity-tag, operations-tag, prefix-call,
/// contains-call, read-count, loop-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str list_name
    str catalogue_rel_dir
    str catalogue_leaf
    str generated_rel_dir
    str generated_leaf
    str inventory_field
    str identity_tag
    str operations_tag
    str prefix_call
    str contains_call
    int read_count
    int loop_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prototype-admission-roots", "default", "", "offline"), "list-name" => ok "case history/prototype-admission-roots variant default root list-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prototype-admission-roots", "default", "", "offline"), "list-name" => ok evidence("list-name", "true", "true", true, "case history/prototype-admission-roots variant default root list-name run offline")
        different: false, true, context("history/prototype-admission-roots", "default", "", "offline"), "list-name" => failed{"list-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/prototype-admission-roots", "default", "", "offline"), "read-count" => ok evidence("read-count", "2", "2", true, "case history/prototype-admission-roots variant default root read-count run offline")
        different: 1, 2, context("history/prototype-admission-roots", "default", "", "offline"), "read-count" => failed{"read-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
