        str expected
        context c
        str check
    asserts
        same: "TestPrototypeCapabilitiesUnadmitted", "TestPrototypeCapabilitiesUnadmitted", context("history/prototype-admission-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestPrototypeCapabilitiesUnadmitted", "TestPrototypeCapabilitiesUnadmitted", true, "case history/prototype-admission-run variant default root test-name run offline")
        different: "TestPrototypeCapabilitiesUnadmitted_2", "TestPrototypeCapabilitiesUnadmitted", context("history/prototype-admission-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
