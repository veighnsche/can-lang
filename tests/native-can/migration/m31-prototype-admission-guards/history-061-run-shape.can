package m31history061run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M31 HISTORY-061 "Prototype admission: run shape".
/// Source: tests/host-discrimination/admission_test.go
/// symbol TestPrototypeCapabilitiesUnadmitted (L29-61)
/// call shape plus the six diagnostic wordings plus
/// the three site tallies.
/// Disposition: migrate (this row owns the
/// TestPrototypeCapabilitiesUnadmitted offline pact
/// as reviewable Can facts; the old Go check stays
/// until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the run shape: the Go name,
/// the seven call spellings, the six wordings, and
/// the three tallies.
/// ADAPTATION (recorded, with source lines): name pins
/// hold the L29 ident; call pins hold Go selector
/// bytes; wording pins hold Go quoted bytes; counts
/// pin ints tallied from the Go sites.
/// test-name pins TestPrototypeCapabilitiesUnadmitted
/// (L29); root-call pins repoRoot (L30 plus L52);
/// read-call pins os.ReadFile (L30 plus L52);
/// unmarshal-call pins json.Unmarshal (L39);
/// len-call pins len (L42); fatalf-call pins
/// t.Fatalf (L32, L40, L48, L54 plus L58);
/// fatal-call pins t.Fatal (L43);
/// word-read-catalogue pins read catalogue: %v (L32);
/// word-parse-catalogue pins parse catalogue: %v
/// (L40); word-vacuous pins catalogue has no
/// operations; leg is vacuous (L43); word-admitted
/// pins prototype capability %q admitted;
/// self-admission path exists (L48);
/// word-read-generated pins read generated catalogue:
/// %v (L54); word-generated-contains pins generated
/// catalogue contains %q; self-admission path exists
/// (L58); fatalf-site-count pins int (5);
/// fatal-site-count pins int (1);
/// diagnostic-site-count pins int (6).
/// Facet map (run in Go order): test-name, root-call,
/// read-call, unmarshal-call, len-call, fatalf-call,
/// fatal-call, word-read-catalogue,
/// word-parse-catalogue, word-vacuous, word-admitted,
/// word-read-generated, word-generated-contains,
/// fatalf-site-count, fatal-site-count,
/// diagnostic-site-count.
/// The anchor legs live in
/// history-061-base-semantics.can; the sweep roots
/// live in history-061-roots-green.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: no gates (row lists zero environment
/// gates; offline only).
/// Logical gates SUITE/DOC/FILES/BUILD bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 accept gate
/// unmet).
/// Case history/prototype-admission-run checks:
/// test-name, root-call, read-call, unmarshal-call,
/// len-call, fatalf-call, fatal-call,
/// word-read-catalogue, word-parse-catalogue,
/// word-vacuous, word-admitted, word-read-generated,
/// word-generated-contains, fatalf-site-count,
/// fatal-site-count, diagnostic-site-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str root_call
    str read_call
    str unmarshal_call
    str len_call
    str fatalf_call
    str fatal_call
    str word_read_catalogue
    str word_parse_catalogue
    str word_vacuous
    str word_admitted
    str word_read_generated
    str word_generated_contains
    int fatalf_site_count
    int fatal_site_count
    int diagnostic_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prototype-admission-run", "default", "", "offline"), "test-name" => ok "case history/prototype-admission-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prototype-admission-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/prototype-admission-run variant default root test-name run offline")
        different: false, true, context("history/prototype-admission-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("history/prototype-admission-run", "default", "", "offline"), "fatalf-site-count" => ok evidence("fatalf-site-count", "5", "5", true, "case history/prototype-admission-run variant default root fatalf-site-count run offline")
        different: 4, 5, context("history/prototype-admission-run", "default", "", "offline"), "fatalf-site-count" => failed{"fatalf-site-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
