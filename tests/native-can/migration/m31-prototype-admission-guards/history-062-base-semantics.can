    asserts
        same: "host-discrimination", "host-discrimination", context("history/prototype-unreferenced-base", "default", "", "offline"), "needle" => ok evidence("needle", "host-discrimination", "host-discrimination", true, "case history/prototype-unreferenced-base variant default root needle run offline")
        different: "host-discrimination_2", "host-discrimination", context("history/prototype-unreferenced-base", "default", "", "offline"), "needle" => failed{"needle"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
