package m31history062base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M31 HISTORY-062 "Unreferenced: needle plus trees".
/// Source: tests/host-discrimination/admission_test.go
/// symbol TestPrototypesUnreferenced (L66-113): one
/// no-reference sweep pinning a needle plus six
/// owned trees (plus live tallies).
/// Disposition: migrate (this row owns the
/// TestPrototypesUnreferenced offline pact
/// as reviewable Can facts; the old Go check stays
/// until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the sweep inputs in Go
/// order: the needle plus the six owned trees plus
/// the reverse-import allowance, with five tallies.
/// ADAPTATION (recorded, with source lines): needle
/// pins hold Go quoted bytes; tree pins hold Go
/// quoted bytes; policy pins hold Go comment bytes;
/// target pins hold live specifier bytes; counts pin
/// ints tallied from the Go lists; tally pins hold
/// live scan results over the owned trees.
/// needle pins host-discrimination (L102);
/// tree-runtime pins runtime (L69);
/// tree-tools-runtime pins tools/runtime (L70);
/// tree-compiler pins compiler (L71);
/// tree-examples pins examples (L72);
/// tree-distribution pins distribution (L73);
/// tree-internal pins internal (L74);
/// reverse-policy pins F01 (L65);
/// reverse-target pins runtime/outbound (live
/// companion edge);
/// reverse-file-count pins int (3) live companions
/// with owned imports; tree-count pins int (6) from
/// L68-75; present-tree-count pins int (5) live
/// (internal/ is absent, so the live Go leg halts at
/// L81 before its verdict); scanned-count pins int
/// (2957) live readable tally; violation-count pins
/// int (0) live tally.
/// Facet map (sweep in Go order): needle,
/// tree-runtime, tree-tools-runtime,
/// tree-compiler, tree-examples,
/// tree-distribution, tree-internal,
/// reverse-policy, reverse-target,
/// reverse-file-count, tree-count,
/// present-tree-count, scanned-count,
/// violation-count.
/// The sweep roots live in
/// history-062-roots-green.can; the run shape plus
/// diagnostics live in history-062-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: no gates (row lists zero environment
/// gates; offline only).
/// Logical gates SUITE/DOC/FILES/BUILD bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 accept gate
/// unmet).
/// Case history/prototype-unreferenced-base checks:
/// needle, tree-runtime, tree-tools-runtime,
/// tree-compiler, tree-examples,
/// tree-distribution, tree-internal,
/// reverse-policy, reverse-target,
/// reverse-file-count, tree-count,
/// present-tree-count, scanned-count,
/// violation-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str needle
    str tree_runtime
    str tree_tools_runtime
    str tree_compiler
    str tree_examples
    str tree_distribution
    str tree_internal
    str reverse_policy
    str reverse_target
    int reverse_file_count
    int tree_count
    int present_tree_count
    int scanned_count
    int violation_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prototype-unreferenced-base", "default", "", "offline"), "needle" => ok "case history/prototype-unreferenced-base variant default root needle run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prototype-unreferenced-base", "default", "", "offline"), "needle" => ok evidence("needle", "true", "true", true, "case history/prototype-unreferenced-base variant default root needle run offline")
        different: false, true, context("history/prototype-unreferenced-base", "default", "", "offline"), "needle" => failed{"needle"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/prototype-unreferenced-base", "default", "", "offline"), "reverse-file-count" => ok evidence("reverse-file-count", "3", "3", true, "case history/prototype-unreferenced-base variant default root reverse-file-count run offline")
        different: 2, 3, context("history/prototype-unreferenced-base", "default", "", "offline"), "reverse-file-count" => failed{"reverse-file-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
