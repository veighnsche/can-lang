package m31history062roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M31 HISTORY-062 "Unreferenced: sweep roots".
/// Source: tests/host-discrimination/admission_test.go
/// symbol TestPrototypesUnreferenced (L66-113)
/// list shape (L68-76) plus the walk filter
/// (L84-95).
/// Disposition: migrate (this row owns the
/// TestPrototypesUnreferenced offline pact
/// as reviewable Can facts; the old Go check stays
/// until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the sweep roots: the owned
/// list name, the violations ident, the three skip
/// dirs, the three suffixes, the two walk calls, and
/// the two tallies.
/// ADAPTATION (recorded, with source lines): list pins
/// hold L68 bytes; ident pins hold L76 bytes; skip
/// pins hold L90 quoted bytes; suffix pins hold L95
/// quoted bytes; call pins hold L79 plus L84
/// selector bytes; counts pin ints tallied from the
/// Go sites.
/// list-name pins owned (L68);
/// violations-ident pins violations (L76);
/// skip-vendor pins vendor (L90);
/// skip-node-modules pins node_modules (L90);
/// skip-git pins .git (L90);
/// suffix-ts pins .ts (L95);
/// suffix-go pins .go (L95);
/// suffix-json pins .json (L95);
/// walk-call pins filepath.WalkDir (L84);
/// readdir-call pins os.ReadDir (L79);
/// skip-count pins int (3) from L90;
/// suffix-count pins int (3) from L95.
/// Facet map (sweep in Go order): list-name,
/// violations-ident, skip-vendor,
/// skip-node-modules, skip-git, suffix-ts,
/// suffix-go, suffix-json, walk-call,
/// readdir-call, skip-count, suffix-count.
/// The anchor legs live in
/// history-062-base-semantics.can; the run shape plus
/// diagnostics live in history-062-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: no gates (row lists zero environment
/// gates; offline only).
/// Logical gates SUITE/DOC/FILES/BUILD bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 accept gate
/// unmet).
/// Case history/prototype-unreferenced-roots checks:
/// list-name, violations-ident, skip-vendor,
/// skip-node-modules, skip-git, suffix-ts,
/// suffix-go, suffix-json, walk-call,
/// readdir-call, skip-count, suffix-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str list_name
    str violations_ident
    str skip_vendor
    str skip_node_modules
    str skip_git
    str suffix_ts
    str suffix_go
    str suffix_json
    str walk_call
    str readdir_call
    int skip_count
    int suffix_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prototype-unreferenced-roots", "default", "", "offline"), "list-name" => ok "case history/prototype-unreferenced-roots variant default root list-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prototype-unreferenced-roots", "default", "", "offline"), "list-name" => ok evidence("list-name", "true", "true", true, "case history/prototype-unreferenced-roots variant default root list-name run offline")
        different: false, true, context("history/prototype-unreferenced-roots", "default", "", "offline"), "list-name" => failed{"list-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/prototype-unreferenced-roots", "default", "", "offline"), "skip-count" => ok evidence("skip-count", "3", "3", true, "case history/prototype-unreferenced-roots variant default root skip-count run offline")
        different: 2, 3, context("history/prototype-unreferenced-roots", "default", "", "offline"), "skip-count" => failed{"skip-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
