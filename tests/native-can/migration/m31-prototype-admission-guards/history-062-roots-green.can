    asserts
        same: "owned", "owned", context("history/prototype-unreferenced-roots", "default", "", "offline"), "list-name" => ok evidence("list-name", "owned", "owned", true, "case history/prototype-unreferenced-roots variant default root list-name run offline")
        different: "owned_2", "owned", context("history/prototype-unreferenced-roots", "default", "", "offline"), "list-name" => failed{"list-name"}
    match observed is expected
