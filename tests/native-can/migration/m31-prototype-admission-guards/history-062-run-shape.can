package m31history062run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M31 HISTORY-062 "Unreferenced: run shape".
/// Source: tests/host-discrimination/admission_test.go
/// symbol TestPrototypesUnreferenced (L66-113)
/// call shape plus the three diagnostic wordings plus
/// the two site tallies.
/// Disposition: migrate (this row owns the
/// TestPrototypesUnreferenced offline pact
/// as reviewable Can facts; the old Go check stays
/// until the integrator retires it after every linked
/// row, variant, environment and control has accepted
/// evidence).
/// Protects (this file): the run shape: the Go name,
/// the eleven call spellings, the three wordings, and
/// the two tallies.
/// ADAPTATION (recorded, with source lines): name pins
/// hold the L66 ident; call pins hold Go selector
/// bytes; wording pins hold Go quoted bytes; counts
/// pin ints tallied from the Go sites.
/// test-name pins TestPrototypesUnreferenced
/// (L66); root-call pins repoRoot (L67);
/// join-call pins filepath.Join (L78);
/// isdir-call pins entry.IsDir (L88);
/// name-call pins entry.Name (L89);
/// skipdir-ident pins filepath.SkipDir (L91);
/// suffix-call pins strings.HasSuffix (L95);
/// read-call pins os.ReadFile (L98);
/// contains-call pins strings.Contains (L102);
/// len-call pins len (L110);
/// fatalf-call pins t.Fatalf (L81, L107 plus L111);
/// word-read-tree pins read %s: %v (L81);
/// word-walk-tree pins walk %s: %v (L107);
/// word-referenced pins prototype referenced from
/// owned trees: %v (L111); fatalf-site-count pins int
/// (3); diagnostic-site-count pins int (3).
/// Facet map (run in Go order): test-name, root-call,
/// join-call, isdir-call, name-call,
/// skipdir-ident, suffix-call, read-call,
/// contains-call, len-call, fatalf-call,
/// word-read-tree, word-walk-tree,
/// word-referenced, fatalf-site-count,
/// diagnostic-site-count.
/// The anchor legs live in
/// history-062-base-semantics.can; the sweep roots
/// live in history-062-roots-green.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: no gates (row lists zero environment
/// gates; offline only).
/// Logical gates SUITE/DOC/FILES/BUILD bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 accept gate
/// unmet).
/// Case history/prototype-unreferenced-run checks:
/// test-name, root-call, join-call, isdir-call,
/// name-call, skipdir-ident, suffix-call,
/// read-call, contains-call, len-call,
/// fatalf-call, word-read-tree, word-walk-tree,
/// word-referenced, fatalf-site-count,
/// diagnostic-site-count.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str root_call
    str join_call
    str isdir_call
    str name_call
    str skipdir_ident
    str suffix_call
    str read_call
    str contains_call
    str len_call
    str fatalf_call
    str word_read_tree
    str word_walk_tree
    str word_referenced
    int fatalf_site_count
    int diagnostic_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/prototype-unreferenced-run", "default", "", "offline"), "test-name" => ok "case history/prototype-unreferenced-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/prototype-unreferenced-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/prototype-unreferenced-run variant default root test-name run offline")
        different: false, true, context("history/prototype-unreferenced-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("history/prototype-unreferenced-run", "default", "", "offline"), "fatalf-site-count" => ok evidence("fatalf-site-count", "3", "3", true, "case history/prototype-unreferenced-run variant default root fatalf-site-count run offline")
        different: 2, 3, context("history/prototype-unreferenced-run", "default", "", "offline"), "fatalf-site-count" => failed{"fatalf-site-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
