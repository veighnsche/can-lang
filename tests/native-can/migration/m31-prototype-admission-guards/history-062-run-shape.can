    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestPrototypesUnreferenced", "TestPrototypesUnreferenced", context("history/prototype-unreferenced-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestPrototypesUnreferenced", "TestPrototypesUnreferenced", true, "case history/prototype-unreferenced-run variant default root test-name run offline")
        different: "TestPrototypesUnreferenced_2", "TestPrototypesUnreferenced", context("history/prototype-unreferenced-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
