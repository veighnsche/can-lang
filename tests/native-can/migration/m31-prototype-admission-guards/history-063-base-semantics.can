    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str manifest_file
    str manifest_status
    str entry_status
    str path_adapters_storage
    str path_companions_storage
    str path_adapters_clipboard
    str path_companions_clipboard
    str path_adapters_chart
    str path_companions_chart
    int entry_count
    int duplicate_count
    int dangle_count
    int missing_count
    int test_file_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
