/// M31 HISTORY-063 "Review manifest: sweep roots".
/// Source: tests/host-discrimination/admission_test.go
/// symbol TestReviewManifestCoversPrototypes (L126-175)
/// tree list (L152) plus suffix gates (L162) plus the
/// manifest record shape (L115-121).
/// Disposition: migrate (this row owns the
/// TestReviewManifestCoversPrototypes offline pact
/// as reviewable Can facts; the old Go check stays
/// until the integrator retires it after every linked
/// row, variant, environment plus control has accepted
/// evidence).
/// Protects (this file): the sweep roots: the two
/// tree names, the two suffixes, the record name
/// plus fields plus tags, plus five tallies.
/// ADAPTATION (recorded, with source lines): tree pins
/// hold L152 bytes; suffix pins hold L162 bytes;
/// struct pins hold L115-121 bytes; tag pins hold
/// L116-120 bytes; counts pin ints tallied from the
/// Go sites plus live walk.
/// tree-adapters pins adapters (L152);
/// tree-companions pins companions (L152);
/// suffix-ts pins .ts (L162);
/// suffix-test pins .test.ts (L162);
/// manifest-struct pins reviewManifest (L115);
/// manifest-status-field pins Status (L116);
/// prototypes-field pins Prototypes (L117);
/// path-field pins Path (L118);
/// prototypes-tag pins prototypes (L120);
/// path-tag pins path (L118);
/// status-tag pins status (L116 plus L119);
/// tree-count pins int (2) from L152;
/// manifest-field-count pins int (2) from L116-117;
/// entry-field-count pins int (2) from L118-119;
/// prototype-per-tree pins int (3) live tally;
/// test-per-tree pins int (3) live tally.
/// Facet map (sweep in Go order): tree-adapters,
/// tree-companions, suffix-ts, suffix-test,
/// manifest-struct, manifest-status-field,
/// prototypes-field, path-field, prototypes-tag,
/// path-tag, status-tag, tree-count,
/// manifest-field-count, entry-field-count,
/// prototype-per-tree, test-per-tree.
/// The anchor legs live in
/// history-063-base-semantics.can; the run shape plus
/// diagnostics live in history-063-run-shape.can.
/// Variants: none (row lists zero variants; default
/// plus seeded drifts only).
/// Environment: no gates (row lists zero environment
/// gates; offline only).
/// Logical gates SUITE/DOC/FILES/BUILD bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default bound (no
/// Go timeout in this row; binds at P23 like the M11
/// no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 accept gate
/// unmet).
/// Case history/review-manifest-roots checks:
/// tree-adapters, tree-companions, suffix-ts,
/// suffix-test, manifest-struct, manifest-status-field,
/// prototypes-field, path-field, prototypes-tag,
/// path-tag, status-tag, tree-count,
/// manifest-field-count, entry-field-count,
/// prototype-per-tree, test-per-tree.
/// Shared old files untouched; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str tree_adapters
    str tree_companions
    str suffix_ts
    str suffix_test
    str manifest_struct
    str manifest_status_field
    str prototypes_field
    str path_field
    str prototypes_tag
    str path_tag
    str status_tag
    int tree_count
    int manifest_field_count
    int entry_field_count
    int prototype_per_tree
    int test_per_tree
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
