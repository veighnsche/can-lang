error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/review-manifest-run", "default", "", "offline"), "test-name" => ok "case history/review-manifest-run variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/review-manifest-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/review-manifest-run variant default root test-name run offline")
        different: false, true, context("history/review-manifest-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 9, 9, context("history/review-manifest-run", "default", "", "offline"), "fatalf-site-count" => ok evidence("fatalf-site-count", "9", "9", true, "case history/review-manifest-run variant default root fatalf-site-count run offline")
        different: 8, 9, context("history/review-manifest-run", "default", "", "offline"), "fatalf-site-count" => failed{"fatalf-site-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestReviewManifestCoversPrototypes", "TestReviewManifestCoversPrototypes", context("history/review-manifest-run", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestReviewManifestCoversPrototypes", "TestReviewManifestCoversPrototypes", true, "case history/review-manifest-run variant default root test-name run offline")
        different: "TestReviewManifestCoversPrototypes_2", "TestReviewManifestCoversPrototypes", context("history/review-manifest-run", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
