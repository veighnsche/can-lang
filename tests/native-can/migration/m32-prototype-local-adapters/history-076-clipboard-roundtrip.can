package m32history076
    provides [checks, expected_vector, observe, case_body, descriptor]
    uses [text]

/// M32 HISTORY-076 "roundtrip: write then read returns the text".
/// Source: tests/host-discrimination/adapters/clipboard.test.ts.
/// Related fixture: tests/host-discrimination/adapters/clipboard.ts (fake host + adapter).
/// Disposition: RETAIN. Roundtrip is live in the delivered reviewed adapter:
/// host/adapters/clipboard.ts inherits validators and leaves verbatim.
/// Protects: roundtrip; write then read returns the text; operations readText, writeText.
/// Variants: all values/host faults enumerated in this declaration (single text pair here).
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case clipboard/roundtrip-write-read checks: write-ok, read-ok, read-value.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool write_ok
    bool read_ok
    str read_value
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("clipboard/roundtrip-write-read", "default", "", "offline"), "write-ok" => ok "case clipboard/roundtrip-write-read variant default root write-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("clipboard/roundtrip-write-read", "default", "", "offline"), "write-ok" => ok evidence("write-ok", "true", "true", true, "case clipboard/roundtrip-write-read variant default root write-ok run offline")
        different: true, false, context("clipboard/roundtrip-write-read", "default", "", "offline"), "write-ok" => failed{"write-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "invoice-42", "invoice-42", context("clipboard/roundtrip-write-read", "default", "", "offline"), "read-value" => ok evidence("read-value", "invoice-42", "invoice-42", true, "case clipboard/roundtrip-write-read variant default root read-value run offline")
        different: "stale-text", "invoice-42", context("clipboard/roundtrip-write-read", "default", "", "offline"), "read-value" => failed{"read-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, "invoice-42")
        seed_write_fail: "seed-write-fail" => ok observation(false, false, "")
        seed_missing_read: "seed-missing-read" => ok observation(true, false, "")
        seed_read_mismatch: "seed-read-mismatch" => ok observation(true, true, "stale-text")
    match variant_id
        "seed-write-fail" => ok observation(false, false, "")
        "seed-missing-read" => ok observation(true, false, "")
        "seed-read-mismatch" => ok observation(true, true, "stale-text")
        _ => ok observation(true, true, "invoice-42")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("write-ok", "writeText succeeds"), check("read-ok", "readText succeeds"), check("read-value", "read returns the written text")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("write-ok", "writeText succeeds"), check("read-ok", "readText succeeds"), check("read-value", "read returns the written text")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "clipboard/roundtrip-write-read" => ok [expected_check("write-ok", "true"), expected_check("read-ok", "true"), expected_check("read-value", "invoice-42")]
        unknown: "nope" => ok []
    match case is "clipboard/roundtrip-write-read"
        false => ok []
        true => ok [expected_check("write-ok", "true"), expected_check("read-ok", "true"), expected_check("read-value", "invoice-42")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("clipboard/roundtrip-write-read", "default", "", "offline") => ok
        seed_write_fail: context("clipboard/roundtrip-write-read", "seed-write-fail", "", "offline") => failed{"write-ok"}
        seed_missing_read: context("clipboard/roundtrip-write-read", "seed-missing-read", "", "offline") => failed{"read-ok"}
        seed_read_mismatch: context("clipboard/roundtrip-write-read", "seed-read-mismatch", "", "offline") => failed{"read-value"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.write_ok, true, c, "write-ok")
            failed
            ok evidence write_evidence => match call require_bool(got.read_ok, true, c, "read-ok")
                failed
                ok evidence read_evidence => match call require_text(got.read_value, "invoice-42", c, "read-value")
                    failed
                    ok evidence value_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("clipboard/roundtrip-write-read", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("write-ok"), check_ref("read-ok"), check_ref("read-value")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("clipboard/roundtrip-write-read", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("write-ok"), check_ref("read-ok"), check_ref("read-value")], callable case_body)
