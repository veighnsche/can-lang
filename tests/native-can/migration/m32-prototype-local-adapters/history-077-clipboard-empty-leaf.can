package m32history077
    provides [checks, expected_vector, observe, case_body, descriptor]
    uses [text]

/// M32 HISTORY-077 "empty clipboard reads the empty leaf".
/// Source: tests/host-discrimination/adapters/clipboard.test.ts.
/// Related fixture: tests/host-discrimination/adapters/clipboard.ts (fake host + adapter).
/// Disposition: RETAIN. The empty leaf is live in the delivered reviewed adapter:
/// host/adapters/clipboard.ts inherits the leaves verbatim (empty-read native shape
/// stays D02 live-verification debt, shared by all tiers).
/// Protects: empty clipboard reads the empty leaf; operations readText; expected
/// leaves clipboard::empty.
/// Variants: all values/host faults enumerated in this declaration (empty read here).
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case clipboard/empty-reads-empty-leaf checks: read-fails, failure-code.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool read_ok
    str failure_code
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("clipboard/empty-reads-empty-leaf", "default", "", "offline"), "read-fails" => ok "case clipboard/empty-reads-empty-leaf variant default root read-fails run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: false, false, context("clipboard/empty-reads-empty-leaf", "default", "", "offline"), "read-fails" => ok evidence("read-fails", "false", "false", true, "case clipboard/empty-reads-empty-leaf variant default root read-fails run offline")
        different: true, false, context("clipboard/empty-reads-empty-leaf", "default", "", "offline"), "read-fails" => failed{"read-fails"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "clipboard::empty", "clipboard::empty", context("clipboard/empty-reads-empty-leaf", "default", "", "offline"), "failure-code" => ok evidence("failure-code", "clipboard::empty", "clipboard::empty", true, "case clipboard/empty-reads-empty-leaf variant default root failure-code run offline")
        different: "clipboard::unavailable", "clipboard::empty", context("clipboard/empty-reads-empty-leaf", "default", "", "offline"), "failure-code" => failed{"failure-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(false, "clipboard::empty")
        seed_unexpected_ok: "seed-unexpected-ok" => ok observation(true, "")
        seed_wrong_leaf: "seed-wrong-leaf" => ok observation(false, "clipboard::unavailable")
    match variant_id
        "seed-unexpected-ok" => ok observation(true, "")
        "seed-wrong-leaf" => ok observation(false, "clipboard::unavailable")
        _ => ok observation(false, "clipboard::empty")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("read-fails", "empty read fails"), check("failure-code", "failure leaf is clipboard::empty")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("read-fails", "empty read fails"), check("failure-code", "failure leaf is clipboard::empty")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "clipboard/empty-reads-empty-leaf" => ok [expected_check("read-fails", "false"), expected_check("failure-code", "clipboard::empty")]
        unknown: "nope" => ok []
    match case is "clipboard/empty-reads-empty-leaf"
        false => ok []
        true => ok [expected_check("read-fails", "false"), expected_check("failure-code", "clipboard::empty")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("clipboard/empty-reads-empty-leaf", "default", "", "offline") => ok
        seed_unexpected_ok: context("clipboard/empty-reads-empty-leaf", "seed-unexpected-ok", "", "offline") => failed{"read-fails"}
        seed_wrong_leaf: context("clipboard/empty-reads-empty-leaf", "seed-wrong-leaf", "", "offline") => failed{"failure-code"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.read_ok, false, c, "read-fails")
            failed
            ok evidence fails_evidence => match call require_text(got.failure_code, "clipboard::empty", c, "failure-code")
                failed
                ok evidence code_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("clipboard/empty-reads-empty-leaf", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("read-fails"), check_ref("failure-code")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("clipboard/empty-reads-empty-leaf", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("read-fails"), check_ref("failure-code")], callable case_body)
