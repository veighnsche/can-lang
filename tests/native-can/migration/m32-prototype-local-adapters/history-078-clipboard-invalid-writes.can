/// M32 HISTORY-078 "invalid writes reject before host contact".
/// Source: tests/host-discrimination/adapters/clipboard.test.ts.
/// Related fixture: tests/host-discrimination/adapters/clipboard.ts (fake host + adapter).
/// Disposition: RETAIN. Pre-contact validation is live in the delivered reviewed
/// adapter: host/adapters/clipboard.ts inherits the validator verbatim and the
/// conformance suite pins zero host calls on rejected input.
/// Protects: invalid writes reject before host contact; operations writeText; expected
/// leaves clipboard::invalid_text; no host contact or wire send on rejected input.
/// Variants: all values/host faults enumerated in this declaration: empty text, overlong
/// text (MAX+1), non-text (7), null, lone surrogate.
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case clipboard/invalid-writes-reject checks: reject-code, all-five-reject, no-host-contact.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str failure_code
    int rejected_count
    int host_calls
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("clipboard/invalid-writes-reject", "default", "", "offline"), "reject-code" => ok "case clipboard/invalid-writes-reject variant default root reject-code run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "clipboard::invalid_text", "clipboard::invalid_text", context("clipboard/invalid-writes-reject", "default", "", "offline"), "reject-code" => ok evidence("reject-code", "clipboard::invalid_text", "clipboard::invalid_text", true, "case clipboard/invalid-writes-reject variant default root reject-code run offline")
        different: "clipboard::unavailable", "clipboard::invalid_text", context("clipboard/invalid-writes-reject", "default", "", "offline"), "reject-code" => failed{"reject-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("clipboard/invalid-writes-reject", "default", "", "offline"), "all-five-reject" => ok evidence("all-five-reject", "5", "5", true, "case clipboard/invalid-writes-reject variant default root all-five-reject run offline")
        different: 4, 5, context("clipboard/invalid-writes-reject", "default", "", "offline"), "all-five-reject" => failed{"all-five-reject"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("clipboard::invalid_text", 5, 0)
        seed_wrong_leaf: "seed-wrong-leaf" => ok observation("clipboard::unavailable", 5, 0)
        seed_short_count: "seed-short-count" => ok observation("clipboard::invalid_text", 4, 0)
        seed_host_contacted: "seed-host-contacted" => ok observation("clipboard::invalid_text", 5, 1)
    match variant_id
        "seed-wrong-leaf" => ok observation("clipboard::unavailable", 5, 0)
        "seed-short-count" => ok observation("clipboard::invalid_text", 4, 0)
        "seed-host-contacted" => ok observation("clipboard::invalid_text", 5, 1)
        _ => ok observation("clipboard::invalid_text", 5, 0)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("reject-code", "rejections carry clipboard::invalid_text"), check("all-five-reject", "all five invalid values reject"), check("no-host-contact", "zero host calls on rejected input")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("reject-code", "rejections carry clipboard::invalid_text"), check("all-five-reject", "all five invalid values reject"), check("no-host-contact", "zero host calls on rejected input")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "clipboard/invalid-writes-reject" => ok [expected_check("reject-code", "clipboard::invalid_text"), expected_check("all-five-reject", "5"), expected_check("no-host-contact", "0")]
        unknown: "nope" => ok []
    match case is "clipboard/invalid-writes-reject"
        false => ok []
        true => ok [expected_check("reject-code", "clipboard::invalid_text"), expected_check("all-five-reject", "5"), expected_check("no-host-contact", "0")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("clipboard/invalid-writes-reject", "default", "", "offline") => ok
        seed_wrong_leaf: context("clipboard/invalid-writes-reject", "seed-wrong-leaf", "", "offline") => failed{"reject-code"}
        seed_short_count: context("clipboard/invalid-writes-reject", "seed-short-count", "", "offline") => failed{"all-five-reject"}
        seed_host_contacted: context("clipboard/invalid-writes-reject", "seed-host-contacted", "", "offline") => failed{"no-host-contact"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.failure_code, "clipboard::invalid_text", c, "reject-code")
            failed
            ok evidence code_evidence => match call require_int(got.rejected_count, 5, c, "all-five-reject")
                failed
                ok evidence count_evidence => match call require_int(got.host_calls, 0, c, "no-host-contact")
                    failed
                    ok evidence contact_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("clipboard/invalid-writes-reject", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("reject-code"), check_ref("all-five-reject"), check_ref("no-host-contact")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("clipboard/invalid-writes-reject", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("reject-code"), check_ref("all-five-reject"), check_ref("no-host-contact")], callable case_body)
