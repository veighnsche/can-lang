package m32history080
    provides [checks, expected_vector, observe, case_body, descriptor]
    uses [text]

/// M32 HISTORY-080 "unavailable target fails closed without host contact".
/// Source: tests/host-discrimination/adapters/clipboard.test.ts.
/// Related fixture: tests/host-discrimination/adapters/clipboard.ts (fake host + adapter).
/// Disposition: RETAIN. Availability fail-closed is live in the delivered reviewed
/// adapter: host/adapters/clipboard.ts inherits the availability guard verbatim and the
/// conformance suite pins zero host calls when unavailable.
/// Protects: unavailable target fails closed without host contact; operations readText,
/// writeText; expected leaves clipboard::unavailable; no host contact or wire send.
/// Variants: all values/host faults enumerated in this declaration (unavailable read+write here).
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case clipboard/unavailable-fails-closed checks: read-unavailable, write-unavailable, no-host-contact.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str read_code
    str write_code
    int host_calls
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("clipboard/unavailable-fails-closed", "default", "", "offline"), "read-unavailable" => ok "case clipboard/unavailable-fails-closed variant default root read-unavailable run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "clipboard::unavailable", "clipboard::unavailable", context("clipboard/unavailable-fails-closed", "default", "", "offline"), "read-unavailable" => ok evidence("read-unavailable", "clipboard::unavailable", "clipboard::unavailable", true, "case clipboard/unavailable-fails-closed variant default root read-unavailable run offline")
        different: "clipboard::denied", "clipboard::unavailable", context("clipboard/unavailable-fails-closed", "default", "", "offline"), "read-unavailable" => failed{"read-unavailable"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("clipboard/unavailable-fails-closed", "default", "", "offline"), "no-host-contact" => ok evidence("no-host-contact", "0", "0", true, "case clipboard/unavailable-fails-closed variant default root no-host-contact run offline")
        different: 1, 0, context("clipboard/unavailable-fails-closed", "default", "", "offline"), "no-host-contact" => failed{"no-host-contact"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("clipboard::unavailable", "clipboard::unavailable", 0)
        seed_read_leak: "seed-read-leak" => ok observation("clipboard::empty", "clipboard::unavailable", 0)
        seed_write_leak: "seed-write-leak" => ok observation("clipboard::unavailable", "clipboard::denied", 0)
        seed_host_contacted: "seed-host-contacted" => ok observation("clipboard::unavailable", "clipboard::unavailable", 2)
    match variant_id
        "seed-read-leak" => ok observation("clipboard::empty", "clipboard::unavailable", 0)
        "seed-write-leak" => ok observation("clipboard::unavailable", "clipboard::denied", 0)
        "seed-host-contacted" => ok observation("clipboard::unavailable", "clipboard::unavailable", 2)
        _ => ok observation("clipboard::unavailable", "clipboard::unavailable", 0)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("read-unavailable", "unavailable read fails with clipboard::unavailable"), check("write-unavailable", "unavailable write fails with clipboard::unavailable"), check("no-host-contact", "zero host calls when unavailable")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("read-unavailable", "unavailable read fails with clipboard::unavailable"), check("write-unavailable", "unavailable write fails with clipboard::unavailable"), check("no-host-contact", "zero host calls when unavailable")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "clipboard/unavailable-fails-closed" => ok [expected_check("read-unavailable", "clipboard::unavailable"), expected_check("write-unavailable", "clipboard::unavailable"), expected_check("no-host-contact", "0")]
        unknown: "nope" => ok []
    match case is "clipboard/unavailable-fails-closed"
        false => ok []
        true => ok [expected_check("read-unavailable", "clipboard::unavailable"), expected_check("write-unavailable", "clipboard::unavailable"), expected_check("no-host-contact", "0")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("clipboard/unavailable-fails-closed", "default", "", "offline") => ok
        seed_read_leak: context("clipboard/unavailable-fails-closed", "seed-read-leak", "", "offline") => failed{"read-unavailable"}
        seed_write_leak: context("clipboard/unavailable-fails-closed", "seed-write-leak", "", "offline") => failed{"write-unavailable"}
        seed_host_contacted: context("clipboard/unavailable-fails-closed", "seed-host-contacted", "", "offline") => failed{"no-host-contact"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.read_code, "clipboard::unavailable", c, "read-unavailable")
            failed
            ok evidence read_evidence => match call require_text(got.write_code, "clipboard::unavailable", c, "write-unavailable")
                failed
                ok evidence write_evidence => match call require_int(got.host_calls, 0, c, "no-host-contact")
                    failed
                    ok evidence contact_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("clipboard/unavailable-fails-closed", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("read-unavailable"), check_ref("write-unavailable"), check_ref("no-host-contact")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("clipboard/unavailable-fails-closed", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("read-unavailable"), check_ref("write-unavailable"), check_ref("no-host-contact")], callable case_body)
