package m32history081
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M32 HISTORY-081 "native denial and native failure map with no native text".
/// Source: tests/host-discrimination/adapters/clipboard.test.ts.
/// Related fixture: tests/host-discrimination/adapters/clipboard.ts (fake host + adapter).
/// Disposition: RETAIN. Native-error mapping without text leaks is live in the delivered
/// reviewed adapter: host/adapters/clipboard.ts inherits mapNative verbatim.
/// Protects: native denial and native failure map with no native text; operations
/// readText, writeText; expected leaves clipboard::denied, clipboard::unavailable;
/// native exception or secret text does not leak.
/// Variants: all values/host faults enumerated in this declaration: NotAllowedError on
/// read, SecurityError on write.
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case clipboard/native-failure-mapping checks: denial-code, failure-code, no-denial-text, no-failure-text.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str denial_code
    str failure_code
    bool denial_leaked
    bool failure_leaked
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("clipboard/native-failure-mapping", "default", "", "offline"), "denial-code" => ok "case clipboard/native-failure-mapping variant default root denial-code run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: false, false, context("clipboard/native-failure-mapping", "default", "", "offline"), "no-denial-text" => ok evidence("no-denial-text", "false", "false", true, "case clipboard/native-failure-mapping variant default root no-denial-text run offline")
        different: true, false, context("clipboard/native-failure-mapping", "default", "", "offline"), "no-denial-text" => failed{"no-denial-text"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "clipboard::denied", "clipboard::denied", context("clipboard/native-failure-mapping", "default", "", "offline"), "denial-code" => ok evidence("denial-code", "clipboard::denied", "clipboard::denied", true, "case clipboard/native-failure-mapping variant default root denial-code run offline")
        different: "clipboard::unavailable", "clipboard::denied", context("clipboard/native-failure-mapping", "default", "", "offline"), "denial-code" => failed{"denial-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("clipboard::denied", "clipboard::unavailable", false, false)
        seed_denial_mapped_wrong: "seed-denial-mapped-wrong" => ok observation("clipboard::unavailable", "clipboard::unavailable", false, false)
        seed_failure_mapped_wrong: "seed-failure-mapped-wrong" => ok observation("clipboard::denied", "clipboard::denied", false, false)
        seed_denial_leak: "seed-denial-leak" => ok observation("clipboard::denied", "clipboard::unavailable", true, false)
        seed_failure_leak: "seed-failure-leak" => ok observation("clipboard::denied", "clipboard::unavailable", false, true)
    match variant_id
        "seed-denial-mapped-wrong" => ok observation("clipboard::unavailable", "clipboard::unavailable", false, false)
        "seed-failure-mapped-wrong" => ok observation("clipboard::denied", "clipboard::denied", false, false)
        "seed-denial-leak" => ok observation("clipboard::denied", "clipboard::unavailable", true, false)
        "seed-failure-leak" => ok observation("clipboard::denied", "clipboard::unavailable", false, true)
        _ => ok observation("clipboard::denied", "clipboard::unavailable", false, false)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("denial-code", "NotAllowedError maps to clipboard::denied"), check("failure-code", "SecurityError maps to clipboard::unavailable"), check("no-denial-text", "denial result carries no native text"), check("no-failure-text", "failure result carries no native text")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("denial-code", "NotAllowedError maps to clipboard::denied"), check("failure-code", "SecurityError maps to clipboard::unavailable"), check("no-denial-text", "denial result carries no native text"), check("no-failure-text", "failure result carries no native text")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "clipboard/native-failure-mapping" => ok [expected_check("denial-code", "clipboard::denied"), expected_check("failure-code", "clipboard::unavailable"), expected_check("no-denial-text", "false"), expected_check("no-failure-text", "false")]
        unknown: "nope" => ok []
    match case is "clipboard/native-failure-mapping"
        false => ok []
        true => ok [expected_check("denial-code", "clipboard::denied"), expected_check("failure-code", "clipboard::unavailable"), expected_check("no-denial-text", "false"), expected_check("no-failure-text", "false")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("clipboard/native-failure-mapping", "default", "", "offline") => ok
        seed_denial_mapped_wrong: context("clipboard/native-failure-mapping", "seed-denial-mapped-wrong", "", "offline") => failed{"denial-code"}
        seed_failure_mapped_wrong: context("clipboard/native-failure-mapping", "seed-failure-mapped-wrong", "", "offline") => failed{"failure-code"}
        seed_denial_leak: context("clipboard/native-failure-mapping", "seed-denial-leak", "", "offline") => failed{"no-denial-text"}
        seed_failure_leak: context("clipboard/native-failure-mapping", "seed-failure-leak", "", "offline") => failed{"no-failure-text"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.denial_code, "clipboard::denied", c, "denial-code")
            failed
            ok evidence denial_evidence => match call require_text(got.failure_code, "clipboard::unavailable", c, "failure-code")
                failed
                ok evidence failure_evidence => match call require_bool(got.denial_leaked, false, c, "no-denial-text")
                    failed
                    ok evidence denial_text_evidence => match call require_bool(got.failure_leaked, false, c, "no-failure-text")
                        failed
                        ok evidence failure_text_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("clipboard/native-failure-mapping", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("denial-code"), check_ref("failure-code"), check_ref("no-denial-text"), check_ref("no-failure-text")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("clipboard/native-failure-mapping", ["clipboard", "m32"], ["bun-prototype-env"], 15000, [check_ref("denial-code"), check_ref("failure-code"), check_ref("no-denial-text"), check_ref("no-failure-text")], callable case_body)
