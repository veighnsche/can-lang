package m32history084
    provides [checks, expected_vector, observe, case_body, descriptor]
    uses [text]

/// M32 HISTORY-084 "roundtrip: set, get, remove, missing reads null".
/// Source: tests/host-discrimination/adapters/storage.test.ts.
/// Related fixture: tests/host-discrimination/adapters/storage.ts (fake host + adapter).
/// Disposition: RETAIN. Roundtrip is live in the delivered reviewed adapter:
/// host/adapters/storage.ts inherits the ops and null-missing shape verbatim.
/// Protects: roundtrip; set, get, remove, missing reads null; operations localGet,
/// localRemove, localSet.
/// Variants: all values/host faults enumerated in this declaration (single key here).
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case storage/roundtrip-set-get-remove checks: set-ok, get-ok, get-value, remove-ok, missing-ok, missing-null.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool set_ok
    bool get_ok
    str get_value
    bool remove_ok
    bool missing_ok
    bool missing_null
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("storage/roundtrip-set-get-remove", "default", "", "offline"), "set-ok" => ok "case storage/roundtrip-set-get-remove variant default root set-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("storage/roundtrip-set-get-remove", "default", "", "offline"), "set-ok" => ok evidence("set-ok", "true", "true", true, "case storage/roundtrip-set-get-remove variant default root set-ok run offline")
        different: false, true, context("storage/roundtrip-set-get-remove", "default", "", "offline"), "set-ok" => failed{"set-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "dark", "dark", context("storage/roundtrip-set-get-remove", "default", "", "offline"), "get-value" => ok evidence("get-value", "dark", "dark", true, "case storage/roundtrip-set-get-remove variant default root get-value run offline")
        different: "light", "dark", context("storage/roundtrip-set-get-remove", "default", "", "offline"), "get-value" => failed{"get-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, "dark", true, true, true)
        seed_set_fail: "seed-set-fail" => ok observation(false, true, "dark", true, true, true)
        seed_value_drift: "seed-value-drift" => ok observation(true, true, "light", true, true, true)
        seed_remove_fail: "seed-remove-fail" => ok observation(true, true, "dark", false, true, true)
        seed_missing_present: "seed-missing-present" => ok observation(true, true, "dark", true, true, false)
    match variant_id
        "seed-set-fail" => ok observation(false, true, "dark", true, true, true)
        "seed-value-drift" => ok observation(true, true, "light", true, true, true)
        "seed-remove-fail" => ok observation(true, true, "dark", false, true, true)
        "seed-missing-present" => ok observation(true, true, "dark", true, true, false)
        _ => ok observation(true, true, "dark", true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("set-ok", "localSet succeeds"), check("get-ok", "localGet succeeds"), check("get-value", "localGet returns the stored value"), check("remove-ok", "localRemove succeeds"), check("missing-ok", "missing read succeeds"), check("missing-null", "missing read returns null")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("set-ok", "localSet succeeds"), check("get-ok", "localGet succeeds"), check("get-value", "localGet returns the stored value"), check("remove-ok", "localRemove succeeds"), check("missing-ok", "missing read succeeds"), check("missing-null", "missing read returns null")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "storage/roundtrip-set-get-remove" => ok [expected_check("set-ok", "true"), expected_check("get-ok", "true"), expected_check("get-value", "dark"), expected_check("remove-ok", "true"), expected_check("missing-ok", "true"), expected_check("missing-null", "true")]
        unknown: "nope" => ok []
    match case is "storage/roundtrip-set-get-remove"
        false => ok []
        true => ok [expected_check("set-ok", "true"), expected_check("get-ok", "true"), expected_check("get-value", "dark"), expected_check("remove-ok", "true"), expected_check("missing-ok", "true"), expected_check("missing-null", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("storage/roundtrip-set-get-remove", "default", "", "offline") => ok
        seed_set_fail: context("storage/roundtrip-set-get-remove", "seed-set-fail", "", "offline") => failed{"set-ok"}
        seed_value_drift: context("storage/roundtrip-set-get-remove", "seed-value-drift", "", "offline") => failed{"get-value"}
        seed_remove_fail: context("storage/roundtrip-set-get-remove", "seed-remove-fail", "", "offline") => failed{"remove-ok"}
        seed_missing_present: context("storage/roundtrip-set-get-remove", "seed-missing-present", "", "offline") => failed{"missing-null"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.set_ok, true, c, "set-ok")
            failed
            ok evidence set_evidence => match call require_bool(got.get_ok, true, c, "get-ok")
                failed
                ok evidence get_evidence => match call require_text(got.get_value, "dark", c, "get-value")
                    failed
                    ok evidence value_evidence => match call require_bool(got.remove_ok, true, c, "remove-ok")
                        failed
                        ok evidence remove_evidence => match call require_bool(got.missing_ok, true, c, "missing-ok")
                            failed
                            ok evidence missing_evidence => match call require_bool(got.missing_null, true, c, "missing-null")
                                failed
                                ok evidence null_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("storage/roundtrip-set-get-remove", ["storage", "m32"], ["bun-prototype-env"], 15000, [check_ref("set-ok"), check_ref("get-ok"), check_ref("get-value"), check_ref("remove-ok"), check_ref("missing-ok"), check_ref("missing-null")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("storage/roundtrip-set-get-remove", ["storage", "m32"], ["bun-prototype-env"], 15000, [check_ref("set-ok"), check_ref("get-ok"), check_ref("get-value"), check_ref("remove-ok"), check_ref("missing-ok"), check_ref("missing-null")], callable case_body)
