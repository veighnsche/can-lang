package m32history085
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M32 HISTORY-085 "invalid keys and values reject before host contact".
/// Source: tests/host-discrimination/adapters/storage.test.ts.
/// Related fixture: tests/host-discrimination/adapters/storage.ts (fake host + adapter).
/// Disposition: RETAIN. Pre-contact validation is live in the delivered reviewed
/// adapter: host/adapters/storage.ts inherits the key/value validators verbatim and the
/// conformance suite pins zero host calls on rejected input.
/// Protects: invalid keys and values reject before host contact; operations localGet,
/// localSet; expected leaves storage::invalid_key; no host contact or wire send.
/// Variants: all values/host faults enumerated in this declaration: six bad keys (empty,
/// overlong, 42, null, {}, lone-surrogate text) plus one overlong value.
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case storage/invalid-keys-reject checks: get-reject-code, set-reject-code, no-host-contact.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str get_code
    str set_code
    int host_calls
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("storage/invalid-keys-reject", "default", "", "offline"), "get-reject-code" => ok "case storage/invalid-keys-reject variant default root get-reject-code run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "storage::invalid_key", "storage::invalid_key", context("storage/invalid-keys-reject", "default", "", "offline"), "get-reject-code" => ok evidence("get-reject-code", "storage::invalid_key", "storage::invalid_key", true, "case storage/invalid-keys-reject variant default root get-reject-code run offline")
        different: "storage::unavailable", "storage::invalid_key", context("storage/invalid-keys-reject", "default", "", "offline"), "get-reject-code" => failed{"get-reject-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("storage/invalid-keys-reject", "default", "", "offline"), "no-host-contact" => ok evidence("no-host-contact", "0", "0", true, "case storage/invalid-keys-reject variant default root no-host-contact run offline")
        different: 7, 0, context("storage/invalid-keys-reject", "default", "", "offline"), "no-host-contact" => failed{"no-host-contact"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("storage::invalid_key", "storage::invalid_key", 0)
        seed_get_leak: "seed-get-leak" => ok observation("storage::unavailable", "storage::invalid_key", 0)
        seed_set_leak: "seed-set-leak" => ok observation("storage::invalid_key", "storage::quota_exceeded", 0)
        seed_host_contacted: "seed-host-contacted" => ok observation("storage::invalid_key", "storage::invalid_key", 7)
    match variant_id
        "seed-get-leak" => ok observation("storage::unavailable", "storage::invalid_key", 0)
        "seed-set-leak" => ok observation("storage::invalid_key", "storage::quota_exceeded", 0)
        "seed-host-contacted" => ok observation("storage::invalid_key", "storage::invalid_key", 7)
        _ => ok observation("storage::invalid_key", "storage::invalid_key", 0)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("get-reject-code", "bad-key gets carry storage::invalid_key"), check("set-reject-code", "overlong-value sets carry storage::invalid_key"), check("no-host-contact", "zero host calls on rejected input")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("get-reject-code", "bad-key gets carry storage::invalid_key"), check("set-reject-code", "overlong-value sets carry storage::invalid_key"), check("no-host-contact", "zero host calls on rejected input")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "storage/invalid-keys-reject" => ok [expected_check("get-reject-code", "storage::invalid_key"), expected_check("set-reject-code", "storage::invalid_key"), expected_check("no-host-contact", "0")]
        unknown: "nope" => ok []
    match case is "storage/invalid-keys-reject"
        false => ok []
        true => ok [expected_check("get-reject-code", "storage::invalid_key"), expected_check("set-reject-code", "storage::invalid_key"), expected_check("no-host-contact", "0")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("storage/invalid-keys-reject", "default", "", "offline") => ok
        seed_get_leak: context("storage/invalid-keys-reject", "seed-get-leak", "", "offline") => failed{"get-reject-code"}
        seed_set_leak: context("storage/invalid-keys-reject", "seed-set-leak", "", "offline") => failed{"set-reject-code"}
        seed_host_contacted: context("storage/invalid-keys-reject", "seed-host-contacted", "", "offline") => failed{"no-host-contact"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.get_code, "storage::invalid_key", c, "get-reject-code")
            failed
            ok evidence get_evidence => match call require_text(got.set_code, "storage::invalid_key", c, "set-reject-code")
                failed
                ok evidence set_evidence => match call require_int(got.host_calls, 0, c, "no-host-contact")
                    failed
                    ok evidence contact_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("storage/invalid-keys-reject", ["storage", "m32"], ["bun-prototype-env"], 15000, [check_ref("get-reject-code"), check_ref("set-reject-code"), check_ref("no-host-contact")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("storage/invalid-keys-reject", ["storage", "m32"], ["bun-prototype-env"], 15000, [check_ref("get-reject-code"), check_ref("set-reject-code"), check_ref("no-host-contact")], callable case_body)
