fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("storage/quota-breach-mapping", "default", "", "offline") => ok
        seed_quota_mapped_wrong: context("storage/quota-breach-mapping", "seed-quota-mapped-wrong", "", "offline") => failed{"quota-code"}
