    str expected
    str observed
    bool matched
    str selector
record observation
    str quota_code
    bool leaked
    str injected_code
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("storage/quota-breach-mapping", "default", "", "offline"), "quota-code" => ok "case storage/quota-breach-mapping variant default root quota-code run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: false, false, context("storage/quota-breach-mapping", "default", "", "offline"), "no-native-text" => ok evidence("no-native-text", "false", "false", true, "case storage/quota-breach-mapping variant default root no-native-text run offline")
        different: true, false, context("storage/quota-breach-mapping", "default", "", "offline"), "no-native-text" => failed{"no-native-text"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "storage::quota_exceeded", "storage::quota_exceeded", context("storage/quota-breach-mapping", "default", "", "offline"), "quota-code" => ok evidence("quota-code", "storage::quota_exceeded", "storage::quota_exceeded", true, "case storage/quota-breach-mapping variant default root quota-code run offline")
        different: "storage::unavailable", "storage::quota_exceeded", context("storage/quota-breach-mapping", "default", "", "offline"), "quota-code" => failed{"quota-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("storage::quota_exceeded", false, "storage::quota_exceeded")
        seed_quota_mapped_wrong: "seed-quota-mapped-wrong" => ok observation("storage::unavailable", false, "storage::quota_exceeded")
        seed_native_leak: "seed-native-leak" => ok observation("storage::quota_exceeded", true, "storage::quota_exceeded")
        seed_injected_mapped_wrong: "seed-injected-mapped-wrong" => ok observation("storage::quota_exceeded", false, "storage::invalid_key")
    match variant_id
        "seed-quota-mapped-wrong" => ok observation("storage::unavailable", false, "storage::quota_exceeded")
        "seed-native-leak" => ok observation("storage::quota_exceeded", true, "storage::quota_exceeded")
        "seed-injected-mapped-wrong" => ok observation("storage::quota_exceeded", false, "storage::invalid_key")
        _ => ok observation("storage::quota_exceeded", false, "storage::quota_exceeded")
