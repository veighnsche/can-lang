    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("storage/unavailable-fails-closed", "default", "", "offline"), "get-unavailable" => ok "case storage/unavailable-fails-closed variant default root get-unavailable run offline"
