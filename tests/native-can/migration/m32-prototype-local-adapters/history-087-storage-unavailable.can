        seed_remove_leak: "seed-remove-leak" => ok observation("storage::unavailable", "storage::unavailable", "storage::invalid_key", 0)
        seed_host_contacted: "seed-host-contacted" => ok observation("storage::unavailable", "storage::unavailable", "storage::unavailable", 3)
