        "seed-set-leak" => ok observation("storage::unavailable", "storage::invalid_key", "storage::unavailable", 0)
        "seed-remove-leak" => ok observation("storage::unavailable", "storage::unavailable", "storage::invalid_key", 0)
        "seed-host-contacted" => ok observation("storage::unavailable", "storage::unavailable", "storage::unavailable", 3)
        _ => ok observation("storage::unavailable", "storage::unavailable", "storage::unavailable", 0)
