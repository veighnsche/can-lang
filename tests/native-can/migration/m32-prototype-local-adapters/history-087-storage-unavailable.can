fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "storage::unavailable", "storage::unavailable", context("storage/unavailable-fails-closed", "default", "", "offline"), "get-unavailable" => ok evidence("get-unavailable", "storage::unavailable", "storage::unavailable", true, "case storage/unavailable-fails-closed variant default root get-unavailable run offline")
        different: "storage::invalid_key", "storage::unavailable", context("storage/unavailable-fails-closed", "default", "", "offline"), "get-unavailable" => failed{"get-unavailable"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 0, 0, context("storage/unavailable-fails-closed", "default", "", "offline"), "no-host-contact" => ok evidence("no-host-contact", "0", "0", true, "case storage/unavailable-fails-closed variant default root no-host-contact run offline")
        different: 3, 0, context("storage/unavailable-fails-closed", "default", "", "offline"), "no-host-contact" => failed{"no-host-contact"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
