package m32history089
    provides [checks, expected_vector, observe, case_body, descriptor]
    uses [text]

/// M32 HISTORY-089 "immutable copies: results are frozen primitives with no aliasing".
/// Source: tests/host-discrimination/adapters/storage.test.ts.
/// Related fixture: tests/host-discrimination/adapters/storage.ts (fake host + adapter).
/// Disposition: RETAIN. Result immutability is live in the delivered reviewed adapter:
/// host/adapters/storage.ts inherits the frozen-result shape verbatim.
/// Protects: immutable copies; results are frozen primitives with no aliasing; operations
/// localGet, localSet; frozen/opaque output.
/// Variants: all values/host faults enumerated in this declaration (repeat-get plus
/// overwrite-then-reread here).
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// N1, N2, BROWSER and C/R/N/S/A identities bind at P23; no live run now.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case storage/immutable-copies checks: same-value, result-frozen, past-immutable.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool same_value
    bool frozen
    str past_value
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("storage/immutable-copies", "default", "", "offline"), "same-value" => ok "case storage/immutable-copies variant default root same-value run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("storage/immutable-copies", "default", "", "offline"), "same-value" => ok evidence("same-value", "true", "true", true, "case storage/immutable-copies variant default root same-value run offline")
        different: false, true, context("storage/immutable-copies", "default", "", "offline"), "same-value" => failed{"same-value"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "v", "v", context("storage/immutable-copies", "default", "", "offline"), "past-immutable" => ok evidence("past-immutable", "v", "v", true, "case storage/immutable-copies variant default root past-immutable run offline")
        different: "changed", "v", context("storage/immutable-copies", "default", "", "offline"), "past-immutable" => failed{"past-immutable"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, true, "v")
        seed_diverged: "seed-diverged" => ok observation(false, true, "v")
        seed_unfrozen: "seed-unfrozen" => ok observation(true, false, "v")
        seed_mutated: "seed-mutated" => ok observation(true, true, "changed")
    match variant_id
        "seed-diverged" => ok observation(false, true, "v")
        "seed-unfrozen" => ok observation(true, false, "v")
        "seed-mutated" => ok observation(true, true, "changed")
        _ => ok observation(true, true, "v")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok [check("same-value", "repeat gets return the same value"), check("result-frozen", "get results are frozen"), check("past-immutable", "overwriting the store cannot mutate a past result")]
        other: "nope" => ok []
    match scope is "m32"
        false => ok []
        true => ok [check("same-value", "repeat gets return the same value"), check("result-frozen", "get results are frozen"), check("past-immutable", "overwriting the store cannot mutate a past result")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "storage/immutable-copies" => ok [expected_check("same-value", "true"), expected_check("result-frozen", "true"), expected_check("past-immutable", "v")]
        unknown: "nope" => ok []
    match case is "storage/immutable-copies"
        false => ok []
        true => ok [expected_check("same-value", "true"), expected_check("result-frozen", "true"), expected_check("past-immutable", "v")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("storage/immutable-copies", "default", "", "offline") => ok
        seed_diverged: context("storage/immutable-copies", "seed-diverged", "", "offline") => failed{"same-value"}
        seed_unfrozen: context("storage/immutable-copies", "seed-unfrozen", "", "offline") => failed{"result-frozen"}
        seed_mutated: context("storage/immutable-copies", "seed-mutated", "", "offline") => failed{"past-immutable"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.same_value, true, c, "same-value")
            failed
            ok evidence same_evidence => match call require_bool(got.frozen, true, c, "result-frozen")
                failed
                ok evidence frozen_evidence => match call require_text(got.past_value, "v", c, "past-immutable")
                    failed
                    ok evidence past_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok test_case("storage/immutable-copies", ["storage", "m32"], ["bun-prototype-env"], 15000, [check_ref("same-value"), check_ref("result-frozen"), check_ref("past-immutable")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m32"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("storage/immutable-copies", ["storage", "m32"], ["bun-prototype-env"], 15000, [check_ref("same-value"), check_ref("result-frozen"), check_ref("past-immutable")], callable case_body)
