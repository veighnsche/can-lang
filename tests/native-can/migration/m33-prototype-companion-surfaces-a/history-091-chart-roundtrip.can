package m33history091
    provides [checks, expected_vector, observe, case_body, descriptor]
    uses [text]

/// M33 HISTORY-091 "render, select, release roundtrip".
/// Source: tests/host-discrimination/companions/chart-widget.test.ts.
/// Related fixture: tests/host-discrimination/companions/chart-widget.ts (prototype pair).
/// Disposition: RETAIN. The companion lifecycle is live in the delivered reviewed
/// companion: host/companions/chart.ts keeps render/select/release, the frozen
/// render/table shape, idempotent release and server-side expiry verbatim under the
/// d02.chart/1 contract. Completes the M32 HISTORY-064 handoff (T2 adapter
/// lifecycle vacated in favor of this T3 contract).
/// Protects: render, select, release roundtrip; operations release, render, select;
/// frozen/opaque output.
/// Variants: all values/host faults enumerated in this declaration (single roundtrip here).
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// PEER, WIRE, N1 and C/R/N/S/A identities bind at P23; no live run now.
/// C/R/N/S/A inputs: C = companion endpoint/policy/credential env; R = seeded observe
/// variants below (offline only); N/S/A bind at P23 with the qualified report; state
/// not bound. Cleanup receipt: release drains server renders (server-drained check).
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case chart-companion/render-select-release-roundtrip checks: render-ok, select-label,
/// release-ok, server-drained, output-frozen.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool render_ok
    str select_label
    bool release_ok
    bool live_zero
    bool frozen
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("chart-companion/render-select-release-roundtrip", "default", "", "offline"), "render-ok" => ok "case chart-companion/render-select-release-roundtrip variant default root render-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("chart-companion/render-select-release-roundtrip", "default", "", "offline"), "render-ok" => ok evidence("render-ok", "true", "true", true, "case chart-companion/render-select-release-roundtrip variant default root render-ok run offline")
        different: false, true, context("chart-companion/render-select-release-roundtrip", "default", "", "offline"), "render-ok" => failed{"render-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "Feb", "Feb", context("chart-companion/render-select-release-roundtrip", "default", "", "offline"), "select-label" => ok evidence("select-label", "Feb", "Feb", true, "case chart-companion/render-select-release-roundtrip variant default root select-label run offline")
        different: "Jan", "Feb", context("chart-companion/render-select-release-roundtrip", "default", "", "offline"), "select-label" => failed{"select-label"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, "Feb", true, true, true)
        seed_render_fail: "seed-render-fail" => ok observation(false, "", false, true, false)
        seed_select_wrong: "seed-select-wrong" => ok observation(true, "Jan", true, true, true)
        seed_select_missing: "seed-select-missing" => ok observation(true, "", true, true, true)
        seed_release_fail: "seed-release-fail" => ok observation(true, "Feb", false, false, true)
        seed_leak: "seed-leak" => ok observation(true, "Feb", true, false, true)
        seed_unfrozen: "seed-unfrozen" => ok observation(true, "Feb", true, true, false)
    match variant_id
        "seed-render-fail" => ok observation(false, "", false, true, false)
        "seed-select-wrong" => ok observation(true, "Jan", true, true, true)
        "seed-select-missing" => ok observation(true, "", true, true, true)
        "seed-release-fail" => ok observation(true, "Feb", false, false, true)
        "seed-leak" => ok observation(true, "Feb", true, false, true)
        "seed-unfrozen" => ok observation(true, "Feb", true, true, false)
        _ => ok observation(true, "Feb", true, true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok [check("render-ok", "render succeeds"), check("select-label", "select returns the Feb point"), check("release-ok", "release succeeds"), check("server-drained", "server holds zero live renders"), check("output-frozen", "render output is frozen")]
        other: "nope" => ok []
    match scope is "m33"
        false => ok []
        true => ok [check("render-ok", "render succeeds"), check("select-label", "select returns the Feb point"), check("release-ok", "release succeeds"), check("server-drained", "server holds zero live renders"), check("output-frozen", "render output is frozen")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "chart-companion/render-select-release-roundtrip" => ok [expected_check("render-ok", "true"), expected_check("select-label", "Feb"), expected_check("release-ok", "true"), expected_check("server-drained", "true"), expected_check("output-frozen", "true")]
        unknown: "nope" => ok []
    match case is "chart-companion/render-select-release-roundtrip"
        false => ok []
        true => ok [expected_check("render-ok", "true"), expected_check("select-label", "Feb"), expected_check("release-ok", "true"), expected_check("server-drained", "true"), expected_check("output-frozen", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("chart-companion/render-select-release-roundtrip", "default", "", "offline") => ok
        seed_render_fail: context("chart-companion/render-select-release-roundtrip", "seed-render-fail", "", "offline") => failed{"render-ok"}
        seed_select_wrong: context("chart-companion/render-select-release-roundtrip", "seed-select-wrong", "", "offline") => failed{"select-label"}
        seed_select_missing: context("chart-companion/render-select-release-roundtrip", "seed-select-missing", "", "offline") => failed{"select-label"}
        seed_release_fail: context("chart-companion/render-select-release-roundtrip", "seed-release-fail", "", "offline") => failed{"release-ok"}
        seed_leak: context("chart-companion/render-select-release-roundtrip", "seed-leak", "", "offline") => failed{"server-drained"}
        seed_unfrozen: context("chart-companion/render-select-release-roundtrip", "seed-unfrozen", "", "offline") => failed{"output-frozen"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.render_ok, true, c, "render-ok")
            failed
            ok evidence render_evidence => match call require_text(got.select_label, "Feb", c, "select-label")
                failed
                ok evidence select_evidence => match call require_bool(got.release_ok, true, c, "release-ok")
                    failed
                    ok evidence release_evidence => match call require_bool(got.live_zero, true, c, "server-drained")
                        failed
                        ok evidence drain_evidence => match call require_bool(got.frozen, true, c, "output-frozen")
                            failed
                            ok evidence frozen_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok test_case("chart-companion/render-select-release-roundtrip", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("render-ok"), check_ref("select-label"), check_ref("release-ok"), check_ref("server-drained"), check_ref("output-frozen")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m33"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("chart-companion/render-select-release-roundtrip", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("render-ok"), check_ref("select-label"), check_ref("release-ok"), check_ref("server-drained"), check_ref("output-frozen")], callable case_body)
