package m33history092
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M33 HISTORY-092 "invalid specs reject client-side without sending".
/// Source: tests/host-discrimination/companions/chart-widget.test.ts.
/// Related fixture: tests/host-discrimination/companions/chart-widget.ts (prototype pair).
/// Disposition: RETAIN. Client-side invalid-spec rejection is live in the delivered
/// reviewed companion: host/companions/chart.ts keeps the title/points validators and
/// the chart::invalid_spec leaf verbatim, and the conformance suite pins zero wire
/// sends on rejected input. Completes the M32 HISTORY-065 handoff.
/// Protects: invalid specs reject client-side without sending; operations render;
/// expected leaves chart::invalid_spec; no host contact or wire send on rejected input.
/// Variants: all values/host faults enumerated in this declaration: empty title, empty
/// points, NaN point value, null title.
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// PEER, WIRE, N1 and C/R/N/S/A identities bind at P23; no live run now.
/// C/R/N/S/A inputs: C = companion endpoint/policy/credential env; R = seeded observe
/// variants below (offline only); N/S/A bind at P23 with the qualified report; state
/// not bound. Cleanup receipt: no wire send means no server state (no-wire-send check).
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case chart-companion/invalid-specs-reject checks: reject-code, all-four-reject,
/// no-wire-send.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str reject_code
    bool all_rejected
    bool wire_sends_zero
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("chart-companion/invalid-specs-reject", "default", "", "offline"), "reject-code" => ok "case chart-companion/invalid-specs-reject variant default root reject-code run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("chart-companion/invalid-specs-reject", "default", "", "offline"), "all-four-reject" => ok evidence("all-four-reject", "true", "true", true, "case chart-companion/invalid-specs-reject variant default root all-four-reject run offline")
        different: false, true, context("chart-companion/invalid-specs-reject", "default", "", "offline"), "all-four-reject" => failed{"all-four-reject"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "chart::invalid_spec", "chart::invalid_spec", context("chart-companion/invalid-specs-reject", "default", "", "offline"), "reject-code" => ok evidence("reject-code", "chart::invalid_spec", "chart::invalid_spec", true, "case chart-companion/invalid-specs-reject variant default root reject-code run offline")
        different: "chart::expired", "chart::invalid_spec", context("chart-companion/invalid-specs-reject", "default", "", "offline"), "reject-code" => failed{"reject-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("chart::invalid_spec", true, true)
        seed_wrong_leaf: "seed-wrong-leaf" => ok observation("chart::expired", true, true)
        seed_partial_reject: "seed-partial-reject" => ok observation("chart::invalid_spec", false, true)
        seed_sent: "seed-sent" => ok observation("chart::invalid_spec", true, false)
    match variant_id
        "seed-wrong-leaf" => ok observation("chart::expired", true, true)
        "seed-partial-reject" => ok observation("chart::invalid_spec", false, true)
        "seed-sent" => ok observation("chart::invalid_spec", true, false)
        _ => ok observation("chart::invalid_spec", true, true)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok [check("reject-code", "rejections carry chart::invalid_spec"), check("all-four-reject", "all four bad specs reject"), check("no-wire-send", "zero wire sends on rejected input")]
        other: "nope" => ok []
    match scope is "m33"
        false => ok []
        true => ok [check("reject-code", "rejections carry chart::invalid_spec"), check("all-four-reject", "all four bad specs reject"), check("no-wire-send", "zero wire sends on rejected input")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "chart-companion/invalid-specs-reject" => ok [expected_check("reject-code", "chart::invalid_spec"), expected_check("all-four-reject", "true"), expected_check("no-wire-send", "true")]
        unknown: "nope" => ok []
    match case is "chart-companion/invalid-specs-reject"
        false => ok []
        true => ok [expected_check("reject-code", "chart::invalid_spec"), expected_check("all-four-reject", "true"), expected_check("no-wire-send", "true")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("chart-companion/invalid-specs-reject", "default", "", "offline") => ok
        seed_wrong_leaf: context("chart-companion/invalid-specs-reject", "seed-wrong-leaf", "", "offline") => failed{"reject-code"}
        seed_partial_reject: context("chart-companion/invalid-specs-reject", "seed-partial-reject", "", "offline") => failed{"all-four-reject"}
        seed_sent: context("chart-companion/invalid-specs-reject", "seed-sent", "", "offline") => failed{"no-wire-send"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.reject_code, "chart::invalid_spec", c, "reject-code")
            failed
            ok evidence code_evidence => match call require_bool(got.all_rejected, true, c, "all-four-reject")
                failed
                ok evidence all_evidence => match call require_bool(got.wire_sends_zero, true, c, "no-wire-send")
                    failed
                    ok evidence send_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok test_case("chart-companion/invalid-specs-reject", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("reject-code"), check_ref("all-four-reject"), check_ref("no-wire-send")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m33"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("chart-companion/invalid-specs-reject", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("reject-code"), check_ref("all-four-reject"), check_ref("no-wire-send")], callable case_body)
