package m33history093
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M33 HISTORY-093 "select-after-release expires; double release is idempotent".
/// Source: tests/host-discrimination/companions/chart-widget.test.ts.
/// Related fixture: tests/host-discrimination/companions/chart-widget.ts (prototype pair).
/// Disposition: RETAIN. Release idempotency plus select-after-release expiry is live in
/// the delivered reviewed companion: host/companions/chart.ts keeps the idempotent
/// release and the chart::expired leaf verbatim, so at-least-once redelivery never
/// fails. Completes the M32 HISTORY-072/HISTORY-073 handoff (dispose-poison and
/// dispose-during-callback rules vacated in favor of expiry).
/// Protects: select-after-release expires; double release is idempotent; operations
/// release, render, select; expected leaves chart::expired.
/// Variants: all values/host faults enumerated in this declaration: double release,
/// select-after-release, unknown render select.
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// PEER, WIRE, N1 and C/R/N/S/A identities bind at P23; no live run now.
/// C/R/N/S/A inputs: C = companion endpoint/policy/credential env; R = seeded observe
/// variants below (offline only); N/S/A bind at P23 with the qualified report; state
/// not bound. Cleanup receipt: idempotent release leaves no live render behind.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case chart-companion/release-expiry checks: double-release-ok, stale-select-expired,
/// unknown-select-expired.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool double_release_ok
    str stale_code
    str unknown_code
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("chart-companion/release-expiry", "default", "", "offline"), "double-release-ok" => ok "case chart-companion/release-expiry variant default root double-release-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("chart-companion/release-expiry", "default", "", "offline"), "double-release-ok" => ok evidence("double-release-ok", "true", "true", true, "case chart-companion/release-expiry variant default root double-release-ok run offline")
        different: false, true, context("chart-companion/release-expiry", "default", "", "offline"), "double-release-ok" => failed{"double-release-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "chart::expired", "chart::expired", context("chart-companion/release-expiry", "default", "", "offline"), "stale-select-expired" => ok evidence("stale-select-expired", "chart::expired", "chart::expired", true, "case chart-companion/release-expiry variant default root stale-select-expired run offline")
        different: "chart::invalid_spec", "chart::expired", context("chart-companion/release-expiry", "default", "", "offline"), "stale-select-expired" => failed{"stale-select-expired"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, "chart::expired", "chart::expired")
        seed_release_fail: "seed-release-fail" => ok observation(false, "chart::expired", "chart::expired")
        seed_stale_wrong: "seed-stale-wrong" => ok observation(true, "chart::invalid_spec", "chart::expired")
        seed_unknown_wrong: "seed-unknown-wrong" => ok observation(true, "chart::expired", "chart::invalid_spec")
        seed_stale_missing: "seed-stale-missing" => ok observation(true, "", "chart::expired")
    match variant_id
        "seed-release-fail" => ok observation(false, "chart::expired", "chart::expired")
        "seed-stale-wrong" => ok observation(true, "chart::invalid_spec", "chart::expired")
        "seed-unknown-wrong" => ok observation(true, "chart::expired", "chart::invalid_spec")
        "seed-stale-missing" => ok observation(true, "", "chart::expired")
        _ => ok observation(true, "chart::expired", "chart::expired")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok [check("double-release-ok", "double release succeeds"), check("stale-select-expired", "select-after-release carries chart::expired"), check("unknown-select-expired", "unknown render select carries chart::expired")]
        other: "nope" => ok []
    match scope is "m33"
        false => ok []
        true => ok [check("double-release-ok", "double release succeeds"), check("stale-select-expired", "select-after-release carries chart::expired"), check("unknown-select-expired", "unknown render select carries chart::expired")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "chart-companion/release-expiry" => ok [expected_check("double-release-ok", "true"), expected_check("stale-select-expired", "chart::expired"), expected_check("unknown-select-expired", "chart::expired")]
        unknown: "nope" => ok []
    match case is "chart-companion/release-expiry"
        false => ok []
        true => ok [expected_check("double-release-ok", "true"), expected_check("stale-select-expired", "chart::expired"), expected_check("unknown-select-expired", "chart::expired")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("chart-companion/release-expiry", "default", "", "offline") => ok
        seed_release_fail: context("chart-companion/release-expiry", "seed-release-fail", "", "offline") => failed{"double-release-ok"}
        seed_stale_wrong: context("chart-companion/release-expiry", "seed-stale-wrong", "", "offline") => failed{"stale-select-expired"}
        seed_unknown_wrong: context("chart-companion/release-expiry", "seed-unknown-wrong", "", "offline") => failed{"unknown-select-expired"}
        seed_stale_missing: context("chart-companion/release-expiry", "seed-stale-missing", "", "offline") => failed{"stale-select-expired"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.double_release_ok, true, c, "double-release-ok")
            failed
            ok evidence release_evidence => match call require_text(got.stale_code, "chart::expired", c, "stale-select-expired")
                failed
                ok evidence stale_evidence => match call require_text(got.unknown_code, "chart::expired", c, "unknown-select-expired")
                    failed
                    ok evidence unknown_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok test_case("chart-companion/release-expiry", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("double-release-ok"), check_ref("stale-select-expired"), check_ref("unknown-select-expired")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m33"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("chart-companion/release-expiry", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("double-release-ok"), check_ref("stale-select-expired"), check_ref("unknown-select-expired")], callable case_body)
