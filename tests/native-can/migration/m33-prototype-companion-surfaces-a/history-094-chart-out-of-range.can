package m33history094
    provides [checks, expected_vector, observe, case_body, descriptor]
    uses [text]

/// M33 HISTORY-094 "out-of-range index rejects against a live render".
/// Source: tests/host-discrimination/companions/chart-widget.test.ts.
/// Related fixture: tests/host-discrimination/companions/chart-widget.ts (prototype pair).
/// Disposition: RETAIN. Server-side bounds rejection is live in the delivered reviewed
/// companion: host/companions/chart.ts keeps the out-of-range select mapping to
/// chart::invalid_spec verbatim (client guards shape; the server owns the table).
/// Protects: out-of-range index rejects against a live render; operations render,
/// select; expected leaves chart::invalid_spec.
/// Variants: all values/host faults enumerated in this declaration (index past the end
/// of a two-point live render here).
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// PEER, WIRE, N1 and C/R/N/S/A identities bind at P23; no live run now.
/// C/R/N/S/A inputs: C = companion endpoint/policy/credential env; R = seeded observe
/// variants below (offline only); N/S/A bind at P23 with the qualified report; state
/// not bound. Cleanup receipt: release after the rejected select drains server renders.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case chart-companion/out-of-range-rejects checks: live-render-ok, reject-code.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    bool render_ok
    str reject_code
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("chart-companion/out-of-range-rejects", "default", "", "offline"), "live-render-ok" => ok "case chart-companion/out-of-range-rejects variant default root live-render-ok run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("chart-companion/out-of-range-rejects", "default", "", "offline"), "live-render-ok" => ok evidence("live-render-ok", "true", "true", true, "case chart-companion/out-of-range-rejects variant default root live-render-ok run offline")
        different: false, true, context("chart-companion/out-of-range-rejects", "default", "", "offline"), "live-render-ok" => failed{"live-render-ok"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "chart::invalid_spec", "chart::invalid_spec", context("chart-companion/out-of-range-rejects", "default", "", "offline"), "reject-code" => ok evidence("reject-code", "chart::invalid_spec", "chart::invalid_spec", true, "case chart-companion/out-of-range-rejects variant default root reject-code run offline")
        different: "chart::expired", "chart::invalid_spec", context("chart-companion/out-of-range-rejects", "default", "", "offline"), "reject-code" => failed{"reject-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation(true, "chart::invalid_spec")
        seed_render_fail: "seed-render-fail" => ok observation(false, "chart::invalid_spec")
        seed_wrong_leaf: "seed-wrong-leaf" => ok observation(true, "chart::expired")
        seed_unexpected_ok: "seed-unexpected-ok" => ok observation(true, "")
    match variant_id
        "seed-render-fail" => ok observation(false, "chart::invalid_spec")
        "seed-wrong-leaf" => ok observation(true, "chart::expired")
        "seed-unexpected-ok" => ok observation(true, "")
        _ => ok observation(true, "chart::invalid_spec")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok [check("live-render-ok", "setup render succeeds"), check("reject-code", "out-of-range select carries chart::invalid_spec")]
        other: "nope" => ok []
    match scope is "m33"
        false => ok []
        true => ok [check("live-render-ok", "setup render succeeds"), check("reject-code", "out-of-range select carries chart::invalid_spec")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "chart-companion/out-of-range-rejects" => ok [expected_check("live-render-ok", "true"), expected_check("reject-code", "chart::invalid_spec")]
        unknown: "nope" => ok []
    match case is "chart-companion/out-of-range-rejects"
        false => ok []
        true => ok [expected_check("live-render-ok", "true"), expected_check("reject-code", "chart::invalid_spec")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("chart-companion/out-of-range-rejects", "default", "", "offline") => ok
        seed_render_fail: context("chart-companion/out-of-range-rejects", "seed-render-fail", "", "offline") => failed{"live-render-ok"}
        seed_wrong_leaf: context("chart-companion/out-of-range-rejects", "seed-wrong-leaf", "", "offline") => failed{"reject-code"}
        seed_unexpected_ok: context("chart-companion/out-of-range-rejects", "seed-unexpected-ok", "", "offline") => failed{"reject-code"}
    match call observe(c.variant_id)
        ok observation got => match call require_bool(got.render_ok, true, c, "live-render-ok")
            failed
            ok evidence render_evidence => match call require_text(got.reject_code, "chart::invalid_spec", c, "reject-code")
                failed
                ok evidence code_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok test_case("chart-companion/out-of-range-rejects", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("live-render-ok"), check_ref("reject-code")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m33"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("chart-companion/out-of-range-rejects", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("live-render-ok"), check_ref("reject-code")], callable case_body)
