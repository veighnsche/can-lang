package m33history095
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M33 HISTORY-095 "denied destination, bad credential, and offline fail closed".
/// Source: tests/host-discrimination/companions/chart-widget.test.ts.
/// Related fixture: tests/host-discrimination/companions/chart-widget.ts (prototype pair).
/// Disposition: RETAIN. Boundary fail-closed is live in the delivered reviewed
/// companion: host/companions/chart.ts keeps the destination-denied pre-send guard,
/// the unauthorized mapping, and the sealed transport_failed mapping verbatim.
/// Completes the M32 HISTORY-066/HISTORY-067 handoff (adapter availability and
/// SDK-throw mappings vacated in favor of these boundary rules).
/// Protects: denied destination, bad credential, and offline fail closed; operations
/// render; expected leaves companion::destination_denied, companion::transport_failed,
/// companion::unauthorized; no host contact or wire send on rejected input, native
/// exception or secret text does not leak.
/// Variants: all values/host faults enumerated in this declaration: denied destination,
/// wrong credential, throwing transport.
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// PEER, WIRE, N1 and C/R/N/S/A identities bind at P23; no live run now.
/// C/R/N/S/A inputs: C = companion endpoint/policy/credential env; R = seeded observe
/// variants below (offline only); N/S/A bind at P23 with the qualified report; state
/// not bound. Cleanup receipt: no wire send on denied input; failed renders hold no
/// server state.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case chart-companion/fail-closed checks: denied-code, denied-no-send,
/// unauthorized-code, transport-code, no-transport-text.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str denied_code
    bool denied_sent
    str unauthorized_code
    str transport_code
    bool transport_leaked
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("chart-companion/fail-closed", "default", "", "offline"), "denied-code" => ok "case chart-companion/fail-closed variant default root denied-code run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: false, false, context("chart-companion/fail-closed", "default", "", "offline"), "denied-no-send" => ok evidence("denied-no-send", "false", "false", true, "case chart-companion/fail-closed variant default root denied-no-send run offline")
        different: true, false, context("chart-companion/fail-closed", "default", "", "offline"), "denied-no-send" => failed{"denied-no-send"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "companion::destination_denied", "companion::destination_denied", context("chart-companion/fail-closed", "default", "", "offline"), "denied-code" => ok evidence("denied-code", "companion::destination_denied", "companion::destination_denied", true, "case chart-companion/fail-closed variant default root denied-code run offline")
        different: "companion::unauthorized", "companion::destination_denied", context("chart-companion/fail-closed", "default", "", "offline"), "denied-code" => failed{"denied-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("companion::destination_denied", false, "companion::unauthorized", "companion::transport_failed", false)
        seed_denied_wrong: "seed-denied-wrong" => ok observation("companion::unauthorized", false, "companion::unauthorized", "companion::transport_failed", false)
        seed_denied_sent: "seed-denied-sent" => ok observation("companion::destination_denied", true, "companion::unauthorized", "companion::transport_failed", false)
        seed_unauthorized_wrong: "seed-unauthorized-wrong" => ok observation("companion::destination_denied", false, "companion::protocol_error", "companion::transport_failed", false)
        seed_transport_wrong: "seed-transport-wrong" => ok observation("companion::destination_denied", false, "companion::unauthorized", "companion::protocol_error", false)
        seed_transport_leak: "seed-transport-leak" => ok observation("companion::destination_denied", false, "companion::unauthorized", "companion::transport_failed", true)
    match variant_id
        "seed-denied-wrong" => ok observation("companion::unauthorized", false, "companion::unauthorized", "companion::transport_failed", false)
        "seed-denied-sent" => ok observation("companion::destination_denied", true, "companion::unauthorized", "companion::transport_failed", false)
        "seed-unauthorized-wrong" => ok observation("companion::destination_denied", false, "companion::protocol_error", "companion::transport_failed", false)
        "seed-transport-wrong" => ok observation("companion::destination_denied", false, "companion::unauthorized", "companion::protocol_error", false)
        "seed-transport-leak" => ok observation("companion::destination_denied", false, "companion::unauthorized", "companion::transport_failed", true)
        _ => ok observation("companion::destination_denied", false, "companion::unauthorized", "companion::transport_failed", false)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok [check("denied-code", "denied destination carries companion::destination_denied"), check("denied-no-send", "denied destination sends zero bytes"), check("unauthorized-code", "bad credential carries companion::unauthorized"), check("transport-code", "offline carries companion::transport_failed"), check("no-transport-text", "transport failure carries no native text")]
        other: "nope" => ok []
    match scope is "m33"
        false => ok []
        true => ok [check("denied-code", "denied destination carries companion::destination_denied"), check("denied-no-send", "denied destination sends zero bytes"), check("unauthorized-code", "bad credential carries companion::unauthorized"), check("transport-code", "offline carries companion::transport_failed"), check("no-transport-text", "transport failure carries no native text")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "chart-companion/fail-closed" => ok [expected_check("denied-code", "companion::destination_denied"), expected_check("denied-no-send", "false"), expected_check("unauthorized-code", "companion::unauthorized"), expected_check("transport-code", "companion::transport_failed"), expected_check("no-transport-text", "false")]
        unknown: "nope" => ok []
    match case is "chart-companion/fail-closed"
        false => ok []
        true => ok [expected_check("denied-code", "companion::destination_denied"), expected_check("denied-no-send", "false"), expected_check("unauthorized-code", "companion::unauthorized"), expected_check("transport-code", "companion::transport_failed"), expected_check("no-transport-text", "false")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("chart-companion/fail-closed", "default", "", "offline") => ok
        seed_denied_wrong: context("chart-companion/fail-closed", "seed-denied-wrong", "", "offline") => failed{"denied-code"}
        seed_denied_sent: context("chart-companion/fail-closed", "seed-denied-sent", "", "offline") => failed{"denied-no-send"}
        seed_unauthorized_wrong: context("chart-companion/fail-closed", "seed-unauthorized-wrong", "", "offline") => failed{"unauthorized-code"}
        seed_transport_wrong: context("chart-companion/fail-closed", "seed-transport-wrong", "", "offline") => failed{"transport-code"}
        seed_transport_leak: context("chart-companion/fail-closed", "seed-transport-leak", "", "offline") => failed{"no-transport-text"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.denied_code, "companion::destination_denied", c, "denied-code")
            failed
            ok evidence denied_evidence => match call require_bool(got.denied_sent, false, c, "denied-no-send")
                failed
                ok evidence send_evidence => match call require_text(got.unauthorized_code, "companion::unauthorized", c, "unauthorized-code")
                    failed
                    ok evidence auth_evidence => match call require_text(got.transport_code, "companion::transport_failed", c, "transport-code")
                        failed
                        ok evidence transport_evidence => match call require_bool(got.transport_leaked, false, c, "no-transport-text")
                            failed
                            ok evidence leak_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok test_case("chart-companion/fail-closed", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("denied-code"), check_ref("denied-no-send"), check_ref("unauthorized-code"), check_ref("transport-code"), check_ref("no-transport-text")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m33"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("chart-companion/fail-closed", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("denied-code"), check_ref("denied-no-send"), check_ref("unauthorized-code"), check_ref("transport-code"), check_ref("no-transport-text")], callable case_body)
