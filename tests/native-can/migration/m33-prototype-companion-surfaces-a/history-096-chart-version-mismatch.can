/// M33 HISTORY-096 "version mismatch fails closed both directions".
/// Source: tests/host-discrimination/companions/chart-widget.test.ts.
/// Related fixture: tests/host-discrimination/companions/chart-widget.ts (prototype pair).
/// Disposition: RETAIN. Strict version gating is live in the delivered reviewed
/// companion: host/companions/chart.ts keeps the request/response version check and
/// the companion::version_mismatch leaf verbatim under the d02.chart/1 contract.
/// Migrated without pinning any prototype version string: only the mismatch behavior
/// and leaf are retained.
/// Protects: version mismatch fails closed both directions; operations
/// protocol/packaging; expected leaves companion::version_mismatch.
/// Variants: all values/host faults enumerated in this declaration: stale request
/// version, stale response version.
/// Environment: Bun prototype test environment; requires bun-prototype-env. Logical gates
/// PEER, WIRE, N1 and C/R/N/S/A identities bind at P23; no live run now.
/// C/R/N/S/A inputs: C = companion endpoint/policy/credential env; R = seeded observe
/// variants below (offline only); N/S/A bind at P23 with the qualified report; state
/// not bound. Cleanup receipt: decode-only leg; no session state is created.
/// Delegated oracles: none. Execution credit: NOT claimed (if_retained_accept_after P23).
/// Case chart-companion/version-mismatch checks: request-version-code,
/// response-version-code.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str request_code
    str response_code
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("chart-companion/version-mismatch", "default", "", "offline"), "request-version-code" => ok "case chart-companion/version-mismatch variant default root request-version-code run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("chart-companion/version-mismatch", "default", "", "offline"), "request-version-code" => ok evidence("request-version-code", "true", "true", true, "case chart-companion/version-mismatch variant default root request-version-code run offline")
        different: false, true, context("chart-companion/version-mismatch", "default", "", "offline"), "request-version-code" => failed{"request-version-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "companion::version_mismatch", "companion::version_mismatch", context("chart-companion/version-mismatch", "default", "", "offline"), "request-version-code" => ok evidence("request-version-code", "companion::version_mismatch", "companion::version_mismatch", true, "case chart-companion/version-mismatch variant default root request-version-code run offline")
        different: "companion::protocol_error", "companion::version_mismatch", context("chart-companion/version-mismatch", "default", "", "offline"), "request-version-code" => failed{"request-version-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("companion::version_mismatch", "companion::version_mismatch")
        seed_request_wrong: "seed-request-wrong" => ok observation("companion::protocol_error", "companion::version_mismatch")
        seed_response_wrong: "seed-response-wrong" => ok observation("companion::version_mismatch", "companion::protocol_error")
        seed_request_missing: "seed-request-missing" => ok observation("", "companion::version_mismatch")
    match variant_id
        "seed-request-wrong" => ok observation("companion::protocol_error", "companion::version_mismatch")
        "seed-response-wrong" => ok observation("companion::version_mismatch", "companion::protocol_error")
        "seed-request-missing" => ok observation("", "companion::version_mismatch")
        _ => ok observation("companion::version_mismatch", "companion::version_mismatch")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok [check("request-version-code", "stale request version carries companion::version_mismatch"), check("response-version-code", "stale response version carries companion::version_mismatch")]
        other: "nope" => ok []
    match scope is "m33"
        false => ok []
        true => ok [check("request-version-code", "stale request version carries companion::version_mismatch"), check("response-version-code", "stale response version carries companion::version_mismatch")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "chart-companion/version-mismatch" => ok [expected_check("request-version-code", "companion::version_mismatch"), expected_check("response-version-code", "companion::version_mismatch")]
        unknown: "nope" => ok []
    match case is "chart-companion/version-mismatch"
        false => ok []
        true => ok [expected_check("request-version-code", "companion::version_mismatch"), expected_check("response-version-code", "companion::version_mismatch")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("chart-companion/version-mismatch", "default", "", "offline") => ok
        seed_request_wrong: context("chart-companion/version-mismatch", "seed-request-wrong", "", "offline") => failed{"request-version-code"}
        seed_response_wrong: context("chart-companion/version-mismatch", "seed-response-wrong", "", "offline") => failed{"response-version-code"}
        seed_request_missing: context("chart-companion/version-mismatch", "seed-request-missing", "", "offline") => failed{"request-version-code"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.request_code, "companion::version_mismatch", c, "request-version-code")
            failed
            ok evidence request_evidence => match call require_text(got.response_code, "companion::version_mismatch", c, "response-version-code")
                failed
                ok evidence response_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m33: "m33" => ok test_case("chart-companion/version-mismatch", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("request-version-code"), check_ref("response-version-code")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m33"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("chart-companion/version-mismatch", ["chart-companion", "m33"], ["bun-prototype-env"], 15000, [check_ref("request-version-code"), check_ref("response-version-code")], callable case_body)
