package m33history105
    provides [decide, disposition]
    uses []

/// M33 HISTORY-105 "envelope bytes are deterministic and measured".
/// Source: tests/host-discrimination/companions/clipboard.test.ts.
/// Related fixture: tests/host-discrimination/companions/clipboard.ts.
/// Disposition: OBSOLETE. T3 clipboard excluded for Op B by measurement (x-r01-1.md
/// assignment table): the companion envelope pins (106/127/79 bytes) are dated
/// prototype-ABI measurements with no live surface, and old sizes must not freeze.
/// Protects: envelope bytes are deterministic and measured; operations
/// protocol/packaging; pinned byte/count observation.
/// Variants: all values/host faults enumerated in this declaration.
/// Environment: Bun prototype test environment (no live run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (no retained behavior; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_105: "HISTORY-105" => ok disposition("HISTORY-105", "obsolete", "x-r01-1.md Op B table (T3 excluded)", "Dated envelope pins for the excluded T3 clipboard tier; no live surface and old sizes must not freeze.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-105"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-105", "obsolete", "x-r01-1.md Op B table (T3 excluded)", "Dated envelope pins for the excluded T3 clipboard tier; no live surface and old sizes must not freeze.")
