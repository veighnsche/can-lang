package m34history120
    provides [decide]
    uses []

/// M34 HISTORY-120 "t1-sketches.md".
/// Source: tests/host-discrimination/catalogue/t1-sketches.md.
/// Related fixtures: x-r01-1.md, REVIEW-MANIFEST.json and
/// tests/host-discrimination/admission_test.go (pins the hypothetical
/// can.std.storage/clipboard/chart packages absent from the catalogue).
/// Disposition: PRESERVE. The T1 catalogue-sketch record documents the
/// unadmitted tier the comparison rejected; the admission leg keeps its
/// hypothetical packages out of the closed catalogue. It stays as the
/// selection-context record. Preserved history is not execution evidence.
/// Protects: records unadmitted prototype inventory, tier comparison and
/// selection context; stored document/manifest observation.
/// Variants: none.
/// Environment: none (stored document; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (preserved record; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_120: "HISTORY-120" => ok disposition("HISTORY-120", "preserve", "tests/host-discrimination/catalogue/t1-sketches.md; admission_test.go", "T1 sketch record retained as history; rejected tier stays out of the closed catalogue, not execution evidence.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-120"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-120", "preserve", "tests/host-discrimination/catalogue/t1-sketches.md; admission_test.go", "T1 sketch record retained as history; rejected tier stays out of the closed catalogue, not execution evidence.")
