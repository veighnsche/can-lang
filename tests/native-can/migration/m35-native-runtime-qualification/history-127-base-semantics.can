    asserts
        same: 6, 6, context("history/native-qualification-base", "default", "", "offline"), "identity-field-count" => ok evidence("identity-field-count", "6", "6", true, "case history/native-qualification-base variant default root identity-field-count run offline")
        different: 5, 6, context("history/native-qualification-base", "default", "", "offline"), "identity-field-count" => failed{"identity-field-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
