    asserts
        same: "qualified native APIs and behaviors", "qualified native APIs and behaviors", context("history/native-qualification-base", "default", "", "offline"), "test-name" => ok evidence("test-name", "qualified native APIs and behaviors", "qualified native APIs and behaviors", true, "case history/native-qualification-base variant default root test-name run offline")
