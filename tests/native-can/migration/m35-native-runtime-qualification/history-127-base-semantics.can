package m35history127base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-127 "qualified native APIs and
/// behaviors" green pact.
/// Source: tests/conformance/native.test.ts
/// symbol "qualified native APIs and
/// behaviors" (L9-11): pinned identity plus an
/// empty failure list.
/// Disposition: migrate (this row owns the
/// green-path offline pact as reviewable Can
/// facts; the old bun check stays until the
/// integrator retires it after every linked
/// row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the actual literal
/// (L7-8) with six member spellings, value
/// root spellings, and the two tallies that
/// bound the green assertion.
/// ADAPTATION (recorded, with source lines):
/// field pins hold literal member spellings;
/// source pins hold value root spellings;
/// count pins hold ints tallied from the
/// literal and the L10 assertion.
/// test-name pins qualified native APIs and
/// behaviors (L9); field-name pins name (L7);
/// field-version pins version (L7);
/// field-revision pins revision (L7);
/// field-platform pins platform (L8);
/// field-architecture pins architecture (L8);
/// field-sha256 pins sha256 (L8);
/// runtime-literal pins bun (L7);
/// version-source pins Bun.version (L7);
/// revision-source pins Bun.revision (L7);
/// platform-source pins process.platform (L8);
/// arch-source pins process.arch (L8);
/// exec-read pins
/// readFileSync(process.execPath) (L8);
/// identity-field-count pins int (6) from
/// L7-8; failure-expect-count pins int (0)
/// from L10 toEqual.
/// Facet map (literal order): test-name,
/// field-name, field-version, field-revision,
/// field-platform, field-architecture,
/// field-sha256, runtime-literal,
/// version-source, revision-source,
/// platform-source, arch-source, exec-read,
/// identity-field-count, failure-expect-count.
/// The import plus invocation roots live in
/// history-127-roots-green.can; the report
/// shape plus list tallies live in
/// history-127-run-shape.can.
/// Variants: none (row lists zero variants;
/// default plus seeded drifts only).
/// Environment: pinned Bun runtime/native host
/// (row lists one gate; binds at QN1/QN2; no
/// live run now).
/// Logical gates N1/N2 bind at QN1/QN2; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2
/// accept gates unmet).
/// Case history/native-qualification-base
/// checks: test-name, field-name,
/// field-version, field-revision,
/// field-platform, field-architecture,
/// field-sha256, runtime-literal,
/// version-source, revision-source,
/// platform-source, arch-source, exec-read,
/// identity-field-count, failure-expect-count.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str field_name
    str field_version
    str field_revision
    str field_platform
    str field_architecture
    str field_sha256
    str runtime_literal
    str version_source
    str revision_source
    str platform_source
    str arch_source
    str exec_read
    int identity_field_count
    int failure_expect_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/native-qualification-base", "default", "", "offline"), "test-name" => ok "case history/native-qualification-base variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/native-qualification-base", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/native-qualification-base variant default root test-name run offline")
        different: false, true, context("history/native-qualification-base", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
