package m35history127roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-127 "qualified native APIs and
/// behaviors" invocation roots.
/// Source: tests/conformance/native.test.ts
/// symbol "qualified native APIs and
/// behaviors" (L9-11): imports plus the
/// expect/await/qualify/failures/toEqual
/// chain.
/// Disposition: migrate (same row pact as the
/// base slice; this file owns the import and
/// invocation spellings).
/// Protects (this file): the five import
/// lines (L1-5) with two module bytes plus
/// the L10 invocation chain spellings and
/// tallies.
/// ADAPTATION (recorded, with source lines):
/// path pins hold import bytes; root pins
/// hold ident spellings; call pins hold call
/// spellings; count pins hold ints tallied
/// from L1-5 and L9-11.
/// manifest-path pins
/// ../../distribution/target.json (L2);
/// native-module pins ./native (L3);
/// bun-test-module pins bun:test (L1);
/// qualify-fn pins qualify (L3 plus L10);
/// manifest-root pins manifest (L2 plus L10);
/// actual-root pins actual (L7 plus L10);
/// failures-root pins failures (L10);
/// toequal-fn pins toEqual (L10); expect-fn
/// pins expect (L1 plus L10); import-count
/// pins int (5) from L1-5; qualify-arg-count
/// pins int (2) from L10; span-await-count
/// pins int (1) from L9-11; span-expect-count
/// pins int (1) from L9-11.
/// Facet map (import then chain order):
/// manifest-path, native-module,
/// bun-test-module, qualify-fn,
/// manifest-root, actual-root, failures-root,
/// toequal-fn, expect-fn, import-count,
/// qualify-arg-count, span-await-count,
/// span-expect-count.
/// The identity literal lives in
/// history-127-base-semantics.can; the report
/// shape plus list tallies live in
/// history-127-run-shape.can.
/// Variants: none (row lists zero variants;
/// default plus seeded drifts only).
/// Environment: pinned Bun runtime/native host
/// (row lists one gate; binds at QN1/QN2; no
/// live run now).
/// Logical gates N1/N2 bind at QN1/QN2; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2
/// accept gates unmet).
/// Case history/native-qualification-roots
/// checks: manifest-path, native-module,
/// bun-test-module, qualify-fn,
/// manifest-root, actual-root, failures-root,
/// toequal-fn, expect-fn, import-count,
/// qualify-arg-count, span-await-count,
/// span-expect-count.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str manifest_path
    str native_module
    str bun_test_module
    str qualify_fn
    str manifest_root
    str actual_root
    str failures_root
    str toequal_fn
    str expect_fn
    int import_count
    int qualify_arg_count
    int span_await_count
    int span_expect_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
