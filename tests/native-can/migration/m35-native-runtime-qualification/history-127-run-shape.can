package m35history127run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-127 "qualified native APIs and
/// behaviors" report shape.
/// Sources: tests/conformance/native.ts
/// (qualify report, L87-103) plus
/// distribution/target.json (list tallies).
/// The L10 green assertion wants failures to
/// equal an empty list; this file pins the
/// report fields plus the list bounds that
/// assertion covers.
/// Disposition: migrate (same row pact as the
/// base slice; this file owns the report
/// shape and list tallies only, not probe
/// bodies or fallback denials, which belong
/// to sibling rows).
/// Protects (this file): the eight report
/// fields (L101-102), the kind bytes, the
/// schema int, the six identity fields, and
/// the required API plus probe tallies.
/// ADAPTATION (recorded, with source lines):
/// field pins hold report member spellings;
/// list pins hold manifest list names; count
/// pins hold ints tallied from the report
/// literal and the manifest lists.
/// schema-field pins schemaVersion (L101);
/// kind-field pins kind (L101); kind-value
/// pins can.native-capability-report (L101);
/// target-field pins targetId (L101);
/// actual-field pins actual (L102);
/// capabilities-field pins capabilities
/// (L102); behaviors-field pins behaviors
/// (L102); failures-field pins failures
/// (L102); passed-field pins passed (L102);
/// api-list-field pins requiredNativeAPIs
/// (manifest); probe-list-field pins
/// requiredBehaviorProbes (manifest);
/// schema-version pins int (1);
/// identity-field-count pins int (6) from
/// L13; required-api-count pins int (78)
/// from the manifest; probe-count pins int
/// (10) from the manifest; report-field-count
/// pins int (8) from L101-102.
/// Facet map (report order): schema-field,
/// kind-field, kind-value, target-field,
/// actual-field, capabilities-field,
/// behaviors-field, failures-field,
/// passed-field, api-list-field,
/// probe-list-field, schema-version,
/// identity-field-count, required-api-count,
/// probe-count, report-field-count.
/// The identity literal lives in
/// history-127-base-semantics.can; the import
/// plus invocation roots live in
/// history-127-roots-green.can.
/// Variants: none (row lists zero variants;
/// default plus seeded drifts only).
/// Environment: pinned Bun runtime/native host
/// (row lists one gate; binds at QN1/QN2; no
/// live run now).
/// Logical gates N1/N2 bind at QN1/QN2; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2
/// accept gates unmet).
/// Case history/native-qualification-run
/// checks: schema-field, kind-field,
/// kind-value, target-field, actual-field,
/// capabilities-field, behaviors-field,
/// failures-field, passed-field,
/// api-list-field, probe-list-field,
/// schema-version, identity-field-count,
/// required-api-count, probe-count,
/// report-field-count.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str schema_field
    str kind_field
    str kind_value
    str target_field
    str actual_field
    str capabilities_field
    str behaviors_field
    str failures_field
    str passed_field
    str api_list_field
    str probe_list_field
    int schema_version
    int identity_field_count
    int required_api_count
    int probe_count
    int report_field_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/native-qualification-run", "default", "", "offline"), "schema-field" => ok "case history/native-qualification-run variant default root schema-field run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/native-qualification-run", "default", "", "offline"), "schema-field" => ok evidence("schema-field", "true", "true", true, "case history/native-qualification-run variant default root schema-field run offline")
        different: false, true, context("history/native-qualification-run", "default", "", "offline"), "schema-field" => failed{"schema-field"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("history/native-qualification-run", "default", "", "offline"), "schema-version" => ok evidence("schema-version", "1", "1", true, "case history/native-qualification-run variant default root schema-version run offline")
        different: 0, 1, context("history/native-qualification-run", "default", "", "offline"), "schema-version" => failed{"schema-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "schemaVersion", "schemaVersion", context("history/native-qualification-run", "default", "", "offline"), "schema-field" => ok evidence("schema-field", "schemaVersion", "schemaVersion", true, "case history/native-qualification-run variant default root schema-field run offline")
        different: "schemaVersion_2", "schemaVersion", context("history/native-qualification-run", "default", "", "offline"), "schema-field" => failed{"schema-field"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
