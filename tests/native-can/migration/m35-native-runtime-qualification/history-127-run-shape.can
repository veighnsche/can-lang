fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m35_h127: "m35-h127" => ok test_case("history/native-qualification-run", ["history", "m35"], [], 120000, [check_ref("schema-field"), check_ref("kind-field"), check_ref("kind-value"), check_ref("target-field"), check_ref("actual-field"), check_ref("capabilities-field"), check_ref("behaviors-field"), check_ref("failures-field"), check_ref("passed-field"), check_ref("api-list-field"), check_ref("probe-list-field"), check_ref("schema-version"), check_ref("identity-field-count"), check_ref("required-api-count"), check_ref("probe-count"), check_ref("report-field-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m35-h127"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/native-qualification-run", ["history", "m35"], [], 120000, [check_ref("schema-field"), check_ref("kind-field"), check_ref("kind-value"), check_ref("target-field"), check_ref("actual-field"), check_ref("capabilities-field"), check_ref("behaviors-field"), check_ref("failures-field"), check_ref("passed-field"), check_ref("api-list-field"), check_ref("probe-list-field"), check_ref("schema-version"), check_ref("identity-field-count"), check_ref("required-api-count"), check_ref("probe-count"), check_ref("report-field-count")], callable case_body)
