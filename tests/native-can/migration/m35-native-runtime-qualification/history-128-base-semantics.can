package m35history128base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-128 "Missing API: variant legs".
/// Source: tests/conformance/native.test.ts
/// symbol `refuse missing ${name} without fallback`
/// (L12-24): six legs, one per listed native API,
/// each pinning a variant name; plus the loop tally
/// and the shared title shape.
/// Disposition: migrate (this row owns the
/// refuse-missing offline pact as reviewable Can
/// facts; the old bun check stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the six L12 variant names
/// in loop order, the variant tally, and the L13
/// title words.
/// ADAPTATION (recorded, with source lines): variant
/// pins hold L12 quoted bytes; test-name holds L13
/// backtick bytes; counts pin ints tallied from the
/// L12 list.
/// variant-json-raw pins JSON.rawJSON (L12);
/// variant-array-from-async pins Array.fromAsync
/// (L12); variant-is-proxy pins
/// node:util.types.isProxy (L12);
/// variant-is-native-error pins
/// node:util.types.isNativeError (L12);
/// variant-scan-imports pins
/// Bun.Transpiler.prototype.scanImports (L12);
/// variant-transform-sync pins
/// Bun.Transpiler.prototype.transformSync (L12);
/// variant-count pins int (6) from the L12 list;
/// test-name pins refuse missing ${name} without
/// fallback (L13).
/// Facet map (legs in loop order): variant-json-raw,
/// variant-array-from-async, variant-is-proxy,
/// variant-is-native-error, variant-scan-imports,
/// variant-transform-sync, variant-count, test-name.
/// Per-variant absent-API reasons live in
/// history-128-roots-green.can; the run shape plus
/// mutation and restore pins live in
/// history-128-run-shape.can.
/// Variants: six listed (row lists six variants;
/// each name above is one leg; default plus seeded
/// drifts only).
/// Environment: one gate (pinned Bun runtime/native
/// host; parsed-history work only: no suite run, no
/// global mutation; binds at QN1/QN2).
/// Logical gates N1/N2/ENV/ARCHIVE bind at
/// P23/QN1/QN2; no live run now.
/// Timeout 120000ms is the offline default bound (no
/// runner timeout in this row; binds at P23 like the
/// M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2 accept
/// gates unmet).
/// Case history/missing-api-base checks:
/// variant-json-raw, variant-array-from-async,
/// variant-is-proxy, variant-is-native-error,
/// variant-scan-imports, variant-transform-sync,
/// variant-count, test-name.
/// Shared old files unmoved; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str variant_json
    str variant_array
    str variant_proxy
    str variant_native_error
    str variant_scan_imports
    str variant_transform_sync
    int variant_count
    str test_name
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/missing-api-base", "default", "", "offline"), "variant-json-raw" => ok "case history/missing-api-base variant default root variant-json-raw run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/missing-api-base", "default", "", "offline"), "variant-json-raw" => ok evidence("variant-json-raw", "true", "true", true, "case history/missing-api-base variant default root variant-json-raw run offline")
        different: false, true, context("history/missing-api-base", "default", "", "offline"), "variant-json-raw" => failed{"variant-json-raw"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/missing-api-base", "default", "", "offline"), "variant-count" => ok evidence("variant-count", "6", "6", true, "case history/missing-api-base variant default root variant-count run offline")
        different: 5, 6, context("history/missing-api-base", "default", "", "offline"), "variant-count" => failed{"variant-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "JSON.rawJSON", "JSON.rawJSON", context("history/missing-api-base", "default", "", "offline"), "variant-json-raw" => ok evidence("variant-json-raw", "JSON.rawJSON", "JSON.rawJSON", true, "case history/missing-api-base variant default root variant-json-raw run offline")
        different: "JSON.rawJSON_2", "JSON.rawJSON", context("history/missing-api-base", "default", "", "offline"), "variant-json-raw" => failed{"variant-json-raw"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        seed_variant_json: "seed-variant-json-raw-drift" => ok observation("JSON.rawJSON_2", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        seed_variant_array: "seed-variant-array-from-async-drift" => ok observation("JSON.rawJSON", "Array.fromAsync_2", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        seed_variant_proxy: "seed-variant-is-proxy-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy_2", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        seed_variant_native_error: "seed-variant-is-native-error-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError_2", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        seed_variant_scan_imports: "seed-variant-scan-imports-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports_2", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        seed_variant_transform_sync: "seed-variant-transform-sync-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync_2", 6, "refuse missing ${name} without fallback")
        seed_variant_count: "seed-variant-count-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 5, "refuse missing ${name} without fallback")
        seed_test_name: "seed-test-name-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback_2")
    match variant_id
        "seed-variant-json-raw-drift" => ok observation("JSON.rawJSON_2", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        "seed-variant-array-from-async-drift" => ok observation("JSON.rawJSON", "Array.fromAsync_2", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        "seed-variant-is-proxy-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy_2", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        "seed-variant-is-native-error-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError_2", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        "seed-variant-scan-imports-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports_2", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
        "seed-variant-transform-sync-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync_2", 6, "refuse missing ${name} without fallback")
        "seed-variant-count-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 5, "refuse missing ${name} without fallback")
        "seed-test-name-drift" => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback_2")
        _ => ok observation("JSON.rawJSON", "Array.fromAsync", "node:util.types.isProxy", "node:util.types.isNativeError", "Bun.Transpiler.prototype.scanImports", "Bun.Transpiler.prototype.transformSync", 6, "refuse missing ${name} without fallback")
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m35_h128: "m35-h128" => ok [check("variant-json-raw", "JSON raw variant keeps its bytes"), check("variant-array-from-async", "array from async variant keeps its bytes"), check("variant-is-proxy", "is proxy variant keeps its bytes"), check("variant-is-native-error", "is native error variant keeps its bytes"), check("variant-scan-imports", "scan imports variant keeps its bytes"), check("variant-transform-sync", "transform sync variant keeps its bytes"), check("variant-count", "six variants exist"), check("test-name", "missing api title keeps its words")]
        other: "nope" => ok []
    match scope is "m35-h128"
        false => ok []
        true => ok [check("variant-json-raw", "JSON raw variant keeps its bytes"), check("variant-array-from-async", "array from async variant keeps its bytes"), check("variant-is-proxy", "is proxy variant keeps its bytes"), check("variant-is-native-error", "is native error variant keeps its bytes"), check("variant-scan-imports", "scan imports variant keeps its bytes"), check("variant-transform-sync", "transform sync variant keeps its bytes"), check("variant-count", "six variants exist"), check("test-name", "missing api title keeps its words")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/missing-api-base" => ok [expected_check("variant-json-raw", "JSON.rawJSON"), expected_check("variant-array-from-async", "Array.fromAsync"), expected_check("variant-is-proxy", "node:util.types.isProxy"), expected_check("variant-is-native-error", "node:util.types.isNativeError"), expected_check("variant-scan-imports", "Bun.Transpiler.prototype.scanImports"), expected_check("variant-transform-sync", "Bun.Transpiler.prototype.transformSync"), expected_check("variant-count", "6"), expected_check("test-name", "refuse missing ${name} without fallback")]
        unknown: "nope" => ok []
    match case is "history/missing-api-base"
        false => ok []
        true => ok [expected_check("variant-json-raw", "JSON.rawJSON"), expected_check("variant-array-from-async", "Array.fromAsync"), expected_check("variant-is-proxy", "node:util.types.isProxy"), expected_check("variant-is-native-error", "node:util.types.isNativeError"), expected_check("variant-scan-imports", "Bun.Transpiler.prototype.scanImports"), expected_check("variant-transform-sync", "Bun.Transpiler.prototype.transformSync"), expected_check("variant-count", "6"), expected_check("test-name", "refuse missing ${name} without fallback")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/missing-api-base", "default", "", "offline") => ok
        seed_variant_json: context("history/missing-api-base", "seed-variant-json-raw-drift", "", "offline") => failed{"variant-json-raw"}
        seed_variant_array: context("history/missing-api-base", "seed-variant-array-from-async-drift", "", "offline") => failed{"variant-array-from-async"}
        seed_variant_proxy: context("history/missing-api-base", "seed-variant-is-proxy-drift", "", "offline") => failed{"variant-is-proxy"}
        seed_variant_native_error: context("history/missing-api-base", "seed-variant-is-native-error-drift", "", "offline") => failed{"variant-is-native-error"}
        seed_variant_scan_imports: context("history/missing-api-base", "seed-variant-scan-imports-drift", "", "offline") => failed{"variant-scan-imports"}
        seed_variant_transform_sync: context("history/missing-api-base", "seed-variant-transform-sync-drift", "", "offline") => failed{"variant-transform-sync"}
        seed_variant_count: context("history/missing-api-base", "seed-variant-count-drift", "", "offline") => failed{"variant-count"}
        seed_test_name: context("history/missing-api-base", "seed-test-name-drift", "", "offline") => failed{"test-name"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.variant_json, "JSON.rawJSON", c, "variant-json-raw")
            failed
            ok evidence variant_json_evidence => match call require_text(got.variant_array, "Array.fromAsync", c, "variant-array-from-async")
                failed
                ok evidence variant_array_evidence => match call require_text(got.variant_proxy, "node:util.types.isProxy", c, "variant-is-proxy")
                    failed
                    ok evidence variant_proxy_evidence => match call require_text(got.variant_native_error, "node:util.types.isNativeError", c, "variant-is-native-error")
                        failed
                        ok evidence variant_native_error_evidence => match call require_text(got.variant_scan_imports, "Bun.Transpiler.prototype.scanImports", c, "variant-scan-imports")
                            failed
                            ok evidence variant_scan_imports_evidence => match call require_text(got.variant_transform_sync, "Bun.Transpiler.prototype.transformSync", c, "variant-transform-sync")
                                failed
                                ok evidence variant_transform_sync_evidence => match call require_int(got.variant_count, 6, c, "variant-count")
                                    failed
                                    ok evidence variant_count_evidence => match call require_text(got.test_name, "refuse missing ${name} without fallback", c, "test-name")
                                        failed
                                        ok evidence test_name_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m35_h128: "m35-h128" => ok test_case("history/missing-api-base", ["history", "m35"], [], 120000, [check_ref("variant-json-raw"), check_ref("variant-array-from-async"), check_ref("variant-is-proxy"), check_ref("variant-is-native-error"), check_ref("variant-scan-imports"), check_ref("variant-transform-sync"), check_ref("variant-count"), check_ref("test-name")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m35-h128"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/missing-api-base", ["history", "m35"], [], 120000, [check_ref("variant-json-raw"), check_ref("variant-array-from-async"), check_ref("variant-is-proxy"), check_ref("variant-is-native-error"), check_ref("variant-scan-imports"), check_ref("variant-transform-sync"), check_ref("variant-count"), check_ref("test-name")], callable case_body)
