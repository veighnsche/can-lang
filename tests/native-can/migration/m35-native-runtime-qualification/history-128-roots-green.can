package m35history128roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-128 "Missing API: reason roots".
/// Source: tests/conformance/native.test.ts
/// symbol `refuse missing ${name} without fallback`
/// (L12-24): the exact missing-API reason per leg,
/// each built from the L21 reason head plus its L12
/// variant name; plus the head and the tally.
/// Disposition: migrate (this row owns the
/// refuse-missing offline pact as reviewable Can
/// facts; the old bun check stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the absent-API control per
/// variant: six full reasons, the shared head, and
/// the reason tally.
/// ADAPTATION (recorded, with source lines): reason
/// pins hold head-plus-name bytes (L21 head joined
/// with each L12 name); head pins hold L21 quoted
/// bytes; counts pin ints tallied from the L12
/// list.
/// reason-json-raw pins missing native API:
/// JSON.rawJSON (L21 plus L12);
/// reason-array-from-async pins missing native API:
/// Array.fromAsync (L21 plus L12); reason-is-proxy
/// pins missing native API: node:util.types.isProxy
/// (L21 plus L12); reason-is-native-error pins
/// missing native API: node:util.types.isNativeError
/// (L21 plus L12); reason-scan-imports pins missing
/// native API: Bun.Transpiler.prototype.scanImports
/// (L21 plus L12); reason-transform-sync pins
/// missing native API:
/// Bun.Transpiler.prototype.transformSync (L21 plus
/// L12); reason-prefix pins missing native API:
/// (L21, with one gap); reason-count pins int (6)
/// from the L12 list.
/// Facet map (legs in loop order): reason-json-raw,
/// reason-array-from-async, reason-is-proxy,
/// reason-is-native-error, reason-scan-imports,
/// reason-transform-sync, reason-prefix,
/// reason-count.
/// The variant legs live in
/// history-128-base-semantics.can; the run shape
/// plus mutation and restore pins live in
/// history-128-run-shape.can.
/// Variants: six listed (row lists six variants;
/// each reason above is one leg control; default
/// plus seeded drifts only).
/// Environment: one gate (pinned Bun runtime/native
/// host; parsed-history work only: no suite run, no
/// global mutation; binds at QN1/QN2).
/// Logical gates N1/N2/ENV/ARCHIVE bind at
/// P23/QN1/QN2; no live run now.
/// Timeout 120000ms is the offline default bound (no
/// runner timeout in this row; binds at P23 like the
/// M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2 accept
/// gates unmet).
/// Case history/missing-api-roots checks:
/// reason-json-raw, reason-array-from-async,
/// reason-is-proxy, reason-is-native-error,
/// reason-scan-imports, reason-transform-sync,
/// reason-prefix, reason-count.
/// Shared old files unmoved; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str reason_json
    str reason_array
    str reason_proxy
    str reason_native_error
    str reason_scan_imports
    str reason_transform_sync
    str reason_prefix
    int reason_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/missing-api-roots", "default", "", "offline"), "reason-json-raw" => ok "case history/missing-api-roots variant default root reason-json-raw run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/missing-api-roots", "default", "", "offline"), "reason-json-raw" => ok evidence("reason-json-raw", "true", "true", true, "case history/missing-api-roots variant default root reason-json-raw run offline")
        different: false, true, context("history/missing-api-roots", "default", "", "offline"), "reason-json-raw" => failed{"reason-json-raw"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/missing-api-roots", "default", "", "offline"), "reason-count" => ok evidence("reason-count", "6", "6", true, "case history/missing-api-roots variant default root reason-count run offline")
        different: 5, 6, context("history/missing-api-roots", "default", "", "offline"), "reason-count" => failed{"reason-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "missing native API: JSON.rawJSON", "missing native API: JSON.rawJSON", context("history/missing-api-roots", "default", "", "offline"), "reason-json-raw" => ok evidence("reason-json-raw", "missing native API: JSON.rawJSON", "missing native API: JSON.rawJSON", true, "case history/missing-api-roots variant default root reason-json-raw run offline")
        different: "missing native API: JSON.rawJSON_2", "missing native API: JSON.rawJSON", context("history/missing-api-roots", "default", "", "offline"), "reason-json-raw" => failed{"reason-json-raw"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
