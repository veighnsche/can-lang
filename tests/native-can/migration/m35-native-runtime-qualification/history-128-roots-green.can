fn check[] checks
    emits {}
    given
        str scope
    asserts
        m35_h128: "m35-h128" => ok [check("reason-json-raw", "JSON raw reason keeps its words"), check("reason-array-from-async", "array from async reason keeps its words"), check("reason-is-proxy", "is proxy reason keeps its words"), check("reason-is-native-error", "is native error reason keeps its words"), check("reason-scan-imports", "scan imports reason keeps its words"), check("reason-transform-sync", "transform sync reason keeps its words"), check("reason-prefix", "reason head keeps its words"), check("reason-count", "six reasons exist")]
        other: "nope" => ok []
    match scope is "m35-h128"
        false => ok []
        true => ok [check("reason-json-raw", "JSON raw reason keeps its words"), check("reason-array-from-async", "array from async reason keeps its words"), check("reason-is-proxy", "is proxy reason keeps its words"), check("reason-is-native-error", "is native error reason keeps its words"), check("reason-scan-imports", "scan imports reason keeps its words"), check("reason-transform-sync", "transform sync reason keeps its words"), check("reason-prefix", "reason head keeps its words"), check("reason-count", "six reasons exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/missing-api-roots" => ok [expected_check("reason-json-raw", "missing native API: JSON.rawJSON"), expected_check("reason-array-from-async", "missing native API: Array.fromAsync"), expected_check("reason-is-proxy", "missing native API: node:util.types.isProxy"), expected_check("reason-is-native-error", "missing native API: node:util.types.isNativeError"), expected_check("reason-scan-imports", "missing native API: Bun.Transpiler.prototype.scanImports"), expected_check("reason-transform-sync", "missing native API: Bun.Transpiler.prototype.transformSync"), expected_check("reason-prefix", "missing native API: "), expected_check("reason-count", "6")]
        unknown: "nope" => ok []
    match case is "history/missing-api-roots"
        false => ok []
        true => ok [expected_check("reason-json-raw", "missing native API: JSON.rawJSON"), expected_check("reason-array-from-async", "missing native API: Array.fromAsync"), expected_check("reason-is-proxy", "missing native API: node:util.types.isProxy"), expected_check("reason-is-native-error", "missing native API: node:util.types.isNativeError"), expected_check("reason-scan-imports", "missing native API: Bun.Transpiler.prototype.scanImports"), expected_check("reason-transform-sync", "missing native API: Bun.Transpiler.prototype.transformSync"), expected_check("reason-prefix", "missing native API: "), expected_check("reason-count", "6")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/missing-api-roots", "default", "", "offline") => ok
        seed_reason_json: context("history/missing-api-roots", "seed-reason-json-raw-drift", "", "offline") => failed{"reason-json-raw"}
        seed_reason_array: context("history/missing-api-roots", "seed-reason-array-from-async-drift", "", "offline") => failed{"reason-array-from-async"}
        seed_reason_proxy: context("history/missing-api-roots", "seed-reason-is-proxy-drift", "", "offline") => failed{"reason-is-proxy"}
        seed_reason_native_error: context("history/missing-api-roots", "seed-reason-is-native-error-drift", "", "offline") => failed{"reason-is-native-error"}
        seed_reason_scan_imports: context("history/missing-api-roots", "seed-reason-scan-imports-drift", "", "offline") => failed{"reason-scan-imports"}
        seed_reason_transform_sync: context("history/missing-api-roots", "seed-reason-transform-sync-drift", "", "offline") => failed{"reason-transform-sync"}
        seed_reason_prefix: context("history/missing-api-roots", "seed-reason-prefix-drift", "", "offline") => failed{"reason-prefix"}
        seed_reason_count: context("history/missing-api-roots", "seed-reason-count-drift", "", "offline") => failed{"reason-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.reason_json, "missing native API: JSON.rawJSON", c, "reason-json-raw")
            failed
            ok evidence reason_json_evidence => match call require_text(got.reason_array, "missing native API: Array.fromAsync", c, "reason-array-from-async")
                failed
                ok evidence reason_array_evidence => match call require_text(got.reason_proxy, "missing native API: node:util.types.isProxy", c, "reason-is-proxy")
                    failed
                    ok evidence reason_proxy_evidence => match call require_text(got.reason_native_error, "missing native API: node:util.types.isNativeError", c, "reason-is-native-error")
                        failed
                        ok evidence reason_native_error_evidence => match call require_text(got.reason_scan_imports, "missing native API: Bun.Transpiler.prototype.scanImports", c, "reason-scan-imports")
                            failed
                            ok evidence reason_scan_imports_evidence => match call require_text(got.reason_transform_sync, "missing native API: Bun.Transpiler.prototype.transformSync", c, "reason-transform-sync")
                                failed
                                ok evidence reason_transform_sync_evidence => match call require_text(got.reason_prefix, "missing native API: ", c, "reason-prefix")
                                    failed
                                    ok evidence reason_prefix_evidence => match call require_int(got.reason_count, 6, c, "reason-count")
                                        failed
                                        ok evidence reason_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m35_h128: "m35-h128" => ok test_case("history/missing-api-roots", ["history", "m35"], [], 120000, [check_ref("reason-json-raw"), check_ref("reason-array-from-async"), check_ref("reason-is-proxy"), check_ref("reason-is-native-error"), check_ref("reason-scan-imports"), check_ref("reason-transform-sync"), check_ref("reason-prefix"), check_ref("reason-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m35-h128"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/missing-api-roots", ["history", "m35"], [], 120000, [check_ref("reason-json-raw"), check_ref("reason-array-from-async"), check_ref("reason-is-proxy"), check_ref("reason-is-native-error"), check_ref("reason-scan-imports"), check_ref("reason-transform-sync"), check_ref("reason-prefix"), check_ref("reason-count")], callable case_body)
