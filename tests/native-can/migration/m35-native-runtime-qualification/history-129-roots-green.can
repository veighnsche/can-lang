package m35history129roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-129 "Changed identity: refusal heads".
/// Source: tests/conformance/native.test.ts
/// symbol `refuse different ${key}`
/// (L25-34): the exact field refusal head per
/// leg, each built from the L32 head plus its
/// L25-27 key; plus the shared head and the
/// head tally. The native L14 map joins the same
/// head with each key, so the six heads below are
/// the per-variant mismatch reasons the L32 some
/// scan wants.
/// Disposition: migrate (this row owns the
/// refuse-different offline pact as reviewable Can
/// facts; the old bun check stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the changed-identity
/// control per variant: six full heads, the
/// shared head, and the head tally.
/// ADAPTATION (recorded, with source lines): head
/// pins hold head-plus-key bytes (L32 head joined
/// with each L25-27 key; shape agrees with native
/// L14); head pins hold L32 dotted bytes; counts
/// pin ints tallied from the L25-27 list.
/// reason-name pins runtime.name: (L32 plus L25);
/// reason-version pins runtime.version: (L32 plus
/// L25); reason-revision pins runtime.revision:
/// (L32 plus L25); reason-sha256 pins
/// runtime.sha256: (L32 plus L25); reason-platform
/// pins runtime.platform: (L32 plus L26);
/// reason-architecture pins runtime.architecture:
/// (L32 plus L27); reason-head pins runtime.
/// (L32, with one dot); reason-count pins int (6)
/// from the L25-27 list.
/// Facet map (legs in loop order): reason-name,
/// reason-version, reason-revision,
/// reason-sha256, reason-platform,
/// reason-architecture, reason-head,
/// reason-count.
/// The key legs live in
/// history-129-base-semantics.can; the run shape
/// plus wrong values and guards live in
/// history-129-run-shape.can.
/// Variants: six listed (row lists six variants;
/// each head above is one leg control; default
/// plus seeded drifts only).
/// Environment: one gate (pinned Bun runtime/native
/// host; parsed-history work only: no suite run, no
/// global mutation; binds at QN1/QN2).
/// Logical gates N1/N2/ENV/ARCHIVE bind at
/// P23/QN1/QN2; no live run now.
/// Timeout 120000ms is the offline default bound (no
/// runner timeout in this row; binds at P23 like the
/// M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2 accept
/// gates unmet).
/// Case history/changed-identity-roots checks:
/// reason-name, reason-version,
/// reason-revision, reason-sha256,
/// reason-platform, reason-architecture,
/// reason-head, reason-count.
/// Shared old files unmoved; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str reason_name
    str reason_version
    str reason_revision
    str reason_sha256
    str reason_platform
    str reason_architecture
    str reason_head
    int reason_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/changed-identity-roots", "default", "", "offline"), "reason-name" => ok "case history/changed-identity-roots variant default root reason-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/changed-identity-roots", "default", "", "offline"), "reason-name" => ok evidence("reason-name", "true", "true", true, "case history/changed-identity-roots variant default root reason-name run offline")
        different: false, true, context("history/changed-identity-roots", "default", "", "offline"), "reason-name" => failed{"reason-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/changed-identity-roots", "default", "", "offline"), "reason-count" => ok evidence("reason-count", "6", "6", true, "case history/changed-identity-roots variant default root reason-count run offline")
        different: 5, 6, context("history/changed-identity-roots", "default", "", "offline"), "reason-count" => failed{"reason-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "runtime.name:", "runtime.name:", context("history/changed-identity-roots", "default", "", "offline"), "reason-name" => ok evidence("reason-name", "runtime.name:", "runtime.name:", true, "case history/changed-identity-roots variant default root reason-name run offline")
        different: "runtime.name:_2", "runtime.name:", context("history/changed-identity-roots", "default", "", "offline"), "reason-name" => failed{"reason-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        seed_reason_name: "seed-reason-name-drift" => ok observation("runtime.name:_2", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        seed_reason_version: "seed-reason-version-drift" => ok observation("runtime.name:", "runtime.version:_2", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        seed_reason_revision: "seed-reason-revision-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:_2", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        seed_reason_sha256: "seed-reason-sha256-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:_2", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        seed_reason_platform: "seed-reason-platform-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:_2", "runtime.architecture:", "runtime.", 6)
        seed_reason_architecture: "seed-reason-architecture-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:_2", "runtime.", 6)
        seed_reason_head: "seed-reason-head-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime._2", 6)
        seed_reason_count: "seed-reason-count-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 5)
    match variant_id
        "seed-reason-name-drift" => ok observation("runtime.name:_2", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        "seed-reason-version-drift" => ok observation("runtime.name:", "runtime.version:_2", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        "seed-reason-revision-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:_2", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        "seed-reason-sha256-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:_2", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
        "seed-reason-platform-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:_2", "runtime.architecture:", "runtime.", 6)
        "seed-reason-architecture-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:_2", "runtime.", 6)
        "seed-reason-head-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime._2", 6)
        "seed-reason-count-drift" => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 5)
        _ => ok observation("runtime.name:", "runtime.version:", "runtime.revision:", "runtime.sha256:", "runtime.platform:", "runtime.architecture:", "runtime.", 6)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        m35_h129: "m35-h129" => ok [check("reason-name", "name refusal keeps its head"), check("reason-version", "version refusal keeps its head"), check("reason-revision", "revision refusal keeps its head"), check("reason-sha256", "sha256 refusal keeps its head"), check("reason-platform", "platform refusal keeps its head"), check("reason-architecture", "architecture refusal keeps its head"), check("reason-head", "head keeps its bytes"), check("reason-count", "six heads exist")]
        other: "nope" => ok []
    match scope is "m35-h129"
        false => ok []
        true => ok [check("reason-name", "name refusal keeps its head"), check("reason-version", "version refusal keeps its head"), check("reason-revision", "revision refusal keeps its head"), check("reason-sha256", "sha256 refusal keeps its head"), check("reason-platform", "platform refusal keeps its head"), check("reason-architecture", "architecture refusal keeps its head"), check("reason-head", "head keeps its bytes"), check("reason-count", "six heads exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/changed-identity-roots" => ok [expected_check("reason-name", "runtime.name:"), expected_check("reason-version", "runtime.version:"), expected_check("reason-revision", "runtime.revision:"), expected_check("reason-sha256", "runtime.sha256:"), expected_check("reason-platform", "runtime.platform:"), expected_check("reason-architecture", "runtime.architecture:"), expected_check("reason-head", "runtime."), expected_check("reason-count", "6")]
        unknown: "nope" => ok []
    match case is "history/changed-identity-roots"
        false => ok []
        true => ok [expected_check("reason-name", "runtime.name:"), expected_check("reason-version", "runtime.version:"), expected_check("reason-revision", "runtime.revision:"), expected_check("reason-sha256", "runtime.sha256:"), expected_check("reason-platform", "runtime.platform:"), expected_check("reason-architecture", "runtime.architecture:"), expected_check("reason-head", "runtime."), expected_check("reason-count", "6")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/changed-identity-roots", "default", "", "offline") => ok
        seed_reason_name: context("history/changed-identity-roots", "seed-reason-name-drift", "", "offline") => failed{"reason-name"}
        seed_reason_version: context("history/changed-identity-roots", "seed-reason-version-drift", "", "offline") => failed{"reason-version"}
        seed_reason_revision: context("history/changed-identity-roots", "seed-reason-revision-drift", "", "offline") => failed{"reason-revision"}
        seed_reason_sha256: context("history/changed-identity-roots", "seed-reason-sha256-drift", "", "offline") => failed{"reason-sha256"}
        seed_reason_platform: context("history/changed-identity-roots", "seed-reason-platform-drift", "", "offline") => failed{"reason-platform"}
        seed_reason_architecture: context("history/changed-identity-roots", "seed-reason-architecture-drift", "", "offline") => failed{"reason-architecture"}
        seed_reason_head: context("history/changed-identity-roots", "seed-reason-head-drift", "", "offline") => failed{"reason-head"}
        seed_reason_count: context("history/changed-identity-roots", "seed-reason-count-drift", "", "offline") => failed{"reason-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.reason_name, "runtime.name:", c, "reason-name")
            failed
            ok evidence reason_name_evidence => match call require_text(got.reason_version, "runtime.version:", c, "reason-version")
                failed
                ok evidence reason_version_evidence => match call require_text(got.reason_revision, "runtime.revision:", c, "reason-revision")
                    failed
                    ok evidence reason_revision_evidence => match call require_text(got.reason_sha256, "runtime.sha256:", c, "reason-sha256")
                        failed
                        ok evidence reason_sha256_evidence => match call require_text(got.reason_platform, "runtime.platform:", c, "reason-platform")
                            failed
                            ok evidence reason_platform_evidence => match call require_text(got.reason_architecture, "runtime.architecture:", c, "reason-architecture")
                                failed
                                ok evidence reason_architecture_evidence => match call require_text(got.reason_head, "runtime.", c, "reason-head")
                                    failed
                                    ok evidence reason_head_evidence => match call require_int(got.reason_count, 6, c, "reason-count")
                                        failed
                                        ok evidence reason_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m35_h129: "m35-h129" => ok test_case("history/changed-identity-roots", ["history", "m35"], [], 120000, [check_ref("reason-name"), check_ref("reason-version"), check_ref("reason-revision"), check_ref("reason-sha256"), check_ref("reason-platform"), check_ref("reason-architecture"), check_ref("reason-head"), check_ref("reason-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m35-h129"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/changed-identity-roots", ["history", "m35"], [], 120000, [check_ref("reason-name"), check_ref("reason-version"), check_ref("reason-revision"), check_ref("reason-sha256"), check_ref("reason-platform"), check_ref("reason-architecture"), check_ref("reason-head"), check_ref("reason-count")], callable case_body)
