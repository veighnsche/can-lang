fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/changed-identity-run", "default", "", "offline") => ok
        seed_wrong_name: context("history/changed-identity-run", "seed-wrong-name-drift", "", "offline") => failed{"wrong-name"}
        seed_wrong_version: context("history/changed-identity-run", "seed-wrong-version-drift", "", "offline") => failed{"wrong-version"}
