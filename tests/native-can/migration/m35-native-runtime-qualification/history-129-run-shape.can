package m35history129run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-129 "Changed identity: run shape".
/// Source: tests/conformance/native.test.ts
/// symbol `refuse different ${key}`
/// (L25-34): wrong values plus guard roots plus
/// loop and refusal call shape plus the two flags
/// plus the three site tallies.
/// Disposition: migrate (this row owns the
/// refuse-different offline pact as reviewable Can
/// facts; the old bun check stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence).
/// Protects (this file): the run shape: the
/// sixteen value, guard, word, root and call
/// pins, the two flags, and the three tallies.
/// ADAPTATION (recorded, with source lines): value
/// pins hold L25 quoted bytes; guard pins hold L26
/// plus L27 member-path bytes; word pins hold
/// quoted flip bytes; root pins hold loop idents;
/// call pins hold call ident bytes; flags pin the
/// L31 plus L32 bool words; counts pin ints
/// tallied from the L25-34 span.
/// wrong-name pins node (L25); wrong-version pins
/// 0.0.0 (L25); wrong-revision pins wrong (L25);
/// wrong-sha pins tampered (L25); platform-guard
/// pins manifest.runtime.platform (L26); arch-guard
/// pins manifest.runtime.architecture (L27);
/// linux-word pins linux (L26); darwin-word pins
/// darwin (L26); amd64-word pins amd64 (L27);
/// arm64-word pins arm64 (L27); wrong-root pins
/// wrongIdentity (L25 plus L28); entries-call pins
/// entries (L28); qualify-call pins qualify (L30);
/// passed-assert pins toBe (L31 plus L32);
/// some-call pins some (L32); starts-with-call
/// pins startsWith (L32); passed-flag pins bool
/// (false) from L31; prefix-flag pins bool (true)
/// from L32; assert-count pins int (2) from L31
/// plus L32; wrong-literal-count pins int (4) from
/// L25; ternary-count pins int (2) from L26 plus
/// L27.
/// Facet map (run in span order): wrong-name,
/// wrong-version, wrong-revision, wrong-sha,
/// platform-guard, arch-guard, linux-word,
/// darwin-word, amd64-word, arm64-word,
/// wrong-root, entries-call, qualify-call,
/// passed-assert, some-call, starts-with-call,
/// passed-flag, prefix-flag, assert-count,
/// wrong-literal-count, ternary-count.
/// The key legs live in
/// history-129-base-semantics.can; the per-variant
/// heads live in history-129-roots-green.can.
/// Variants: six listed (row lists six variants;
/// run shape is shared by all legs; default plus
/// seeded drifts only).
/// Environment: one gate (pinned Bun runtime/native
/// host; parsed-history work only: no suite run, no
/// global mutation; binds at QN1/QN2).
/// Logical gates N1/N2/ENV/ARCHIVE bind at
/// P23/QN1/QN2; no live run now.
/// Timeout 120000ms is the offline default bound (no
/// runner timeout in this row; binds at P23 like the
/// M11 no-gate rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2 accept
/// gates unmet).
/// Case history/changed-identity-run checks:
/// wrong-name, wrong-version, wrong-revision,
/// wrong-sha, platform-guard, arch-guard,
/// linux-word, darwin-word, amd64-word,
/// arm64-word, wrong-root, entries-call,
/// qualify-call, passed-assert, some-call,
/// starts-with-call, passed-flag, prefix-flag,
/// assert-count, wrong-literal-count,
/// ternary-count.
/// Shared old files unmoved; retirement is a later
/// integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str wrong_name
    str wrong_version
    str wrong_revision
    str wrong_sha
    str platform_guard
    str arch_guard
    str linux_word
    str darwin_word
    str amd64_word
    str arm64_word
    str wrong_root
    str entries_call
    str qualify_call
    str passed_assert
    str some_call
    str starts_with_call
    bool passed_flag
    bool prefix_flag
    int assert_count
    int wrong_literal_count
    int ternary_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/changed-identity-run", "default", "", "offline"), "wrong-name" => ok "case history/changed-identity-run variant default root wrong-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/changed-identity-run", "default", "", "offline"), "passed-flag" => ok evidence("passed-flag", "true", "true", true, "case history/changed-identity-run variant default root passed-flag run offline")
        different: false, true, context("history/changed-identity-run", "default", "", "offline"), "passed-flag" => failed{"passed-flag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/changed-identity-run", "default", "", "offline"), "assert-count" => ok evidence("assert-count", "2", "2", true, "case history/changed-identity-run variant default root assert-count run offline")
        different: 1, 2, context("history/changed-identity-run", "default", "", "offline"), "assert-count" => failed{"assert-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "node", "node", context("history/changed-identity-run", "default", "", "offline"), "wrong-name" => ok evidence("wrong-name", "node", "node", true, "case history/changed-identity-run variant default root wrong-name run offline")
        different: "node_2", "node", context("history/changed-identity-run", "default", "", "offline"), "wrong-name" => failed{"wrong-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
