/// M35 HISTORY-130 "refuse missing
/// AsyncLocalStorage without fallback"
/// injection pact.
/// Source: tests/conformance/native.test.ts
/// symbol "refuse missing AsyncLocalStorage
/// without fallback" (L36-39): a three arg
/// qualify call whose last arg withholds one
/// api while all else delegates.
/// Disposition: migrate (this row owns the
/// absent api fail closed pact as reviewable
/// Can facts; the old bun check stays until
/// the integrator retires it after every
/// linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): the test name, the
/// withheld api spelling, the arrow shape
/// marks and the delegate plus call roots
/// with the tallies that bound them.
/// ADAPTATION (recorded, with source lines):
/// name pins hold literal spellings; mark
/// pins hold mark spellings; root pins hold
/// ident spellings; count pins hold ints
/// tallied from L36-39.
/// test-name pins refuse missing
/// AsyncLocalStorage without fallback (L36);
/// excluded-api pins
/// node:async_hooks.AsyncLocalStorage
/// (L37 plus L38); arrow-param pins name
/// (L37); arrow-op pins => (L37); guard-op
/// pins !== (L37); and-op pins && (L37);
/// delegate-fn pins apiAvailable (L37);
/// qualify-fn pins qualify (L37);
/// report-root pins report (L37);
/// manifest-root pins manifest (L37);
/// actual-root pins actual (L37);
/// qualify-arity pins int (3) from L37;
/// span-await-count pins int (1) from
/// L36-39; span-qualify-count pins int (1)
/// from L36-39.
/// Facet map (call order): test-name,
/// excluded-api, arrow-param, arrow-op,
/// guard-op, and-op, delegate-fn,
/// qualify-fn, report-root, manifest-root,
/// actual-root, qualify-arity,
/// span-await-count, span-qualify-count.
/// The fail closed reason plus assert roots
/// live in history-130-roots-green.can; the
/// call shape plus span tallies live in
/// history-130-run-shape.can.
/// Variants: none (row lists zero variants;
/// default plus seeded drifts only).
/// Environment: pinned Bun runtime/native
/// host (row lists one gate; binds at QN2;
/// no live run now).
/// Logical gate N2 binds at QN2; no live
/// run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN2
/// accept gates unmet).
/// Case history/async-injection-base
/// checks: test-name, excluded-api,
/// arrow-param, arrow-op, guard-op, and-op,
/// delegate-fn, qualify-fn, report-root,
/// manifest-root, actual-root,
/// qualify-arity, span-await-count,
/// span-qualify-count.
/// Shared old files untouched; retirement is
/// a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str excluded_api
    str arrow_param
    str arrow_op
    str guard_op
    str and_op
    str delegate_fn
    str qualify_fn
    str report_root
    str manifest_root
    str actual_root
    int qualify_arity
    int span_await_count
    int span_qualify_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/async-injection-base", "default", "", "offline"), "test-name" => ok "case history/async-injection-base variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/async-injection-base", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case history/async-injection-base variant default root test-name run offline")
        different: false, true, context("history/async-injection-base", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
