        context c
        str check
    asserts
        same: 3, 3, context("history/async-injection-base", "default", "", "offline"), "qualify-arity" => ok evidence("qualify-arity", "3", "3", true, "case history/async-injection-base variant default root qualify-arity run offline")
        different: 2, 3, context("history/async-injection-base", "default", "", "offline"), "qualify-arity" => failed{"qualify-arity"}
    match observed is expected
