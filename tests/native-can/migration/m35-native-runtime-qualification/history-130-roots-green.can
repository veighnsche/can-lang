/// M35 HISTORY-130 "refuse missing
/// AsyncLocalStorage without fallback"
/// fail closed roots.
/// Source: tests/conformance/native.test.ts
/// symbol "refuse missing AsyncLocalStorage
/// without fallback" (L38): passed must be
/// false and failures must hold the withheld
/// api reason.
/// Disposition: migrate (same row pact as the
/// base slice; this file owns the reason
/// bytes plus the assert chain spellings).
/// Protects (this file): the full reason,
/// its head, the report roots, the matcher
/// names, the wanted flag and the tallies
/// that bound the two asserts.
/// ADAPTATION (recorded, with source lines):
/// reason pins hold reason bytes; root pins
/// hold ident spellings; name pins hold call
/// spellings; count pins hold ints tallied
/// from L38.
/// reason-full pins missing native API:
/// node:async_hooks.AsyncLocalStorage (L38);
/// reason-head pins missing native API:
/// (L38); passed-root pins passed (L38);
/// failures-root pins failures (L38);
/// expect-fn pins expect (L38); tobe-fn pins
/// toBe (L38); tocontain-fn pins toContain
/// (L38); passed-want pins false (L38);
/// assert-count pins int (2) from L38;
/// span-expect-count pins int (2) from
/// L36-39; span-tobe-count pins int (1) from
/// L36-39; span-tocontain-count pins int (1)
/// from L36-39.
/// Facet map (assert order): reason-full,
/// reason-head, passed-root, failures-root,
/// expect-fn, tobe-fn, tocontain-fn,
/// passed-want, assert-count,
/// span-expect-count, span-tobe-count,
/// span-tocontain-count.
/// The injection pact lives in
/// history-130-base-semantics.can; the call
/// shape plus span tallies live in
/// history-130-run-shape.can.
/// Variants: none (row lists zero variants;
/// default plus seeded drifts only).
/// Environment: pinned Bun runtime/native
/// host (row lists one gate; binds at QN2;
/// no live run now).
/// Logical gate N2 binds at QN2; no live
/// run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN2
/// accept gates unmet).
/// Case history/async-injection-roots
/// checks: reason-full, reason-head,
/// passed-root, failures-root, expect-fn,
/// tobe-fn, tocontain-fn, passed-want,
/// assert-count, span-expect-count,
/// span-tobe-count, span-tocontain-count.
/// Shared old files untouched; retirement is
/// a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str reason_full
    str reason_head
    str passed_root
    str failures_root
    str expect_fn
    str tobe_fn
    str tocontain_fn
    str passed_want
    int assert_count
    int span_expect_count
    int span_tobe_count
    int span_tocontain_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
