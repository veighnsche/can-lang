                                                    failed
                                                    ok evidence versions_root_evidence => match call require_int(got.identity_field_count, 6, c, "identity-field-count")
                                                        failed
                                                        ok evidence identity_field_count_evidence => match call require_int(got.actual_key_count, 9, c, "actual-key-count")
                                                            failed
                                                            ok evidence actual_key_count_evidence => match call require_int(got.layout_check_count, 1, c, "layout-check-count")
                                                                failed
                                                                ok evidence layout_check_count_evidence => match call require_int(got.os_check_count, 1, c, "os-check-count")
                                                                    failed
                                                                    ok evidence os_check_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m35_h131: "m35-h131" => ok test_case("history/native-qualification-impl-base", ["history", "m35"], [], 120000, [check_ref("identity-fn"), check_ref("arch-form"), check_ref("arch-alias"), check_ref("runtime-prefix"), check_ref("sha-fn"), check_ref("layout-msg"), check_ref("os-msg"), check_ref("min-os-key"), check_ref("os-version-root"), check_ref("executable-root"), check_ref("versions-root"), check_ref("identity-field-count"), check_ref("actual-key-count"), check_ref("layout-check-count"), check_ref("os-check-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m35-h131"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/native-qualification-impl-base", ["history", "m35"], [], 120000, [check_ref("identity-fn"), check_ref("arch-form"), check_ref("arch-alias"), check_ref("runtime-prefix"), check_ref("sha-fn"), check_ref("layout-msg"), check_ref("os-msg"), check_ref("min-os-key"), check_ref("os-version-root"), check_ref("executable-root"), check_ref("versions-root"), check_ref("identity-field-count"), check_ref("actual-key-count"), check_ref("layout-check-count"), check_ref("os-check-count")], callable case_body)
