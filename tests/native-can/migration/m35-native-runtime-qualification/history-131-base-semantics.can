        seed_executable_root: context("history/native-qualification-impl-base", "seed-executable-root-drift", "", "offline") => failed{"executable-root"}
        seed_versions_root: context("history/native-qualification-impl-base", "seed-versions-root-drift", "", "offline") => failed{"versions-root"}
        seed_identity_field_count: context("history/native-qualification-impl-base", "seed-identity-field-count-drift", "", "offline") => failed{"identity-field-count"}
        seed_actual_key_count: context("history/native-qualification-impl-base", "seed-actual-key-count-drift", "", "offline") => failed{"actual-key-count"}
        seed_layout_check_count: context("history/native-qualification-impl-base", "seed-layout-check-count-drift", "", "offline") => failed{"layout-check-count"}
        seed_os_check_count: context("history/native-qualification-impl-base", "seed-os-check-count-drift", "", "offline") => failed{"os-check-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.identity_fn, "identityFailures", c, "identity-fn")
            failed
            ok evidence identity_fn_evidence => match call require_text(got.arch_form, "amd64", c, "arch-form")
                failed
                ok evidence arch_form_evidence => match call require_text(got.arch_alias, "x64", c, "arch-alias")
                    failed
