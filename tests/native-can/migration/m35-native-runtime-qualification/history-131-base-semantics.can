package m35history131base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-131 native qualification
/// implementation: identity plus layout plus
/// minimum OS.
/// Source: tests/conformance/native.ts
/// symbol native qualification implementation:
/// identityFailures (L11-15) plus the CLI
/// actual literal (L109-112), staged layout
/// refusal (L114) and OS refusal (L115-118).
/// Disposition: migrate (this row owns the
/// implementation pins as reviewable Can
/// facts; the old bun sources stay until the
/// integrator retires them after every linked
/// row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): exact Bun identity
/// comparison, arch alias pair, runtime
/// message root, sha helper name, layout and
/// OS refusal lines, minimum OS key, CLI
/// root spellings, and the four tallies
/// bounding identity, actual roots, layout
/// and OS gates.
/// ADAPTATION (recorded, with source lines):
/// name pins hold literal spellings; count
/// pins hold ints tallied from the named
/// lines.
/// identity-fn pins identityFailures (L11);
/// arch-form pins amd64 (L12); arch-alias
/// pins x64 (L12); runtime-prefix pins
/// runtime. (L14); sha-fn pins sha256 (L10);
/// layout-msg pins runtime executable is
/// outside the staged layout (L114); os-msg
/// pins unsupported OS version (L118);
/// min-os-key pins minimumOSVersion (L117);
/// os-version-root pins osVersion (L106);
/// executable-root pins executable (L111);
/// versions-root pins versions (L112);
/// identity-field-count pins int (6) from
/// L13; actual-key-count pins int (9) from
/// L109-112; layout-check-count pins int (1)
/// from L114; os-check-count pins int (1)
/// from L118.
/// Facet map (literal order): identity-fn,
/// arch-form, arch-alias, runtime-prefix,
/// sha-fn, layout-msg, os-msg, min-os-key,
/// os-version-root, executable-root,
/// versions-root, identity-field-count,
/// actual-key-count, layout-check-count,
/// os-check-count.
/// The presence roots live in
/// history-131-roots-green.can; the probes
/// plus report shape live in
/// history-131-run-shape.can.
/// Variants: OS/platform/architecture (this
/// file; arch alias pair plus OS gate).
/// Environment: distribution/target.json,
/// qualified Bun runtime, offline isolation
/// (row lists three gates; runtime binds at
/// QN1/QN2; no live run now).
/// Logical gates N1/N2 bind at QN1/QN2; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2
/// accept gates unmet).
/// Case history/native-qualification-impl-base
/// checks: identity-fn, arch-form,
/// arch-alias, runtime-prefix, sha-fn,
/// layout-msg, os-msg, min-os-key,
/// os-version-root, executable-root,
/// versions-root, identity-field-count,
/// actual-key-count, layout-check-count,
/// os-check-count.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str identity_fn
    str arch_form
    str arch_alias
    str runtime_prefix
    str sha_fn
    str layout_msg
    str os_msg
    str min_os_key
    str os_version_root
    str executable_root
    str versions_root
    int identity_field_count
    int actual_key_count
    int layout_check_count
    int os_check_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/native-qualification-impl-base", "default", "", "offline"), "identity-fn" => ok "case history/native-qualification-impl-base variant default root identity-fn run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/native-qualification-impl-base", "default", "", "offline"), "identity-fn" => ok evidence("identity-fn", "true", "true", true, "case history/native-qualification-impl-base variant default root identity-fn run offline")
        different: false, true, context("history/native-qualification-impl-base", "default", "", "offline"), "identity-fn" => failed{"identity-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("history/native-qualification-impl-base", "default", "", "offline"), "identity-field-count" => ok evidence("identity-field-count", "6", "6", true, "case history/native-qualification-impl-base variant default root identity-field-count run offline")
        different: 5, 6, context("history/native-qualification-impl-base", "default", "", "offline"), "identity-field-count" => failed{"identity-field-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "identityFailures", "identityFailures", context("history/native-qualification-impl-base", "default", "", "offline"), "identity-fn" => ok evidence("identity-fn", "identityFailures", "identityFailures", true, "case history/native-qualification-impl-base variant default root identity-fn run offline")
        different: "identityFailures_2", "identityFailures", context("history/native-qualification-impl-base", "default", "", "offline"), "identity-fn" => failed{"identity-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
