                                            failed
                                            ok evidence missing_msg_evidence => match call require_text(got.global_root, "globalThis", c, "global-root")
                                                failed
                                                ok evidence global_root_evidence => match call require_int(got.presence_branch_count, 5, c, "presence-branch-count")
                                                    failed
                                                    ok evidence presence_branch_count_evidence => match call require_int(got.prefix_count, 2, c, "prefix-count")
                                                        failed
                                                        ok evidence prefix_count_evidence => match call require_int(got.required_api_count, 78, c, "required-api-count")
                                                            failed
                                                            ok evidence required_api_count_evidence => ok
