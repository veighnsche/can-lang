    asserts
        same: 5, 5, context("history/native-qualification-impl-roots", "default", "", "offline"), "presence-branch-count" => ok evidence("presence-branch-count", "5", "5", true, "case history/native-qualification-impl-roots variant default root presence-branch-count run offline")
        different: 4, 5, context("history/native-qualification-impl-roots", "default", "", "offline"), "presence-branch-count" => failed{"presence-branch-count"}
    match observed is expected
