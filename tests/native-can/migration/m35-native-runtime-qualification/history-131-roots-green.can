package m35history131roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-131 native qualification
/// implementation: required API presence.
/// Source: tests/conformance/native.ts
/// symbol native qualification implementation:
/// apiAvailable (L16-27) plus the qualify
/// API loop (L90-93).
/// Disposition: migrate (this row owns the
/// implementation pins as reviewable Can
/// facts; the old bun sources stay until the
/// integrator retires them after every linked
/// row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): presence helper
/// name, five exact-match API spellings, two
/// module prefix spellings, the missing-API
/// message root, the global root spelling,
/// and the three tallies bounding branches,
/// prefixes and the manifest API list.
/// ADAPTATION (recorded, with source lines):
/// name pins hold literal spellings; count
/// pins hold ints tallied from the named
/// lines and the manifest list.
/// presence-fn pins apiAvailable (L16);
/// async-hooks-api pins
/// node:async_hooks.AsyncLocalStorage (L17);
/// proxy-api pins node:util.types.isProxy
/// (L18); native-error-api pins
/// node:util.types.isNativeError (L19);
/// subtle-api pins crypto.subtle (L20);
/// password-api pins Bun.password (L21);
/// fs-prefix pins node:fs/promises (L22);
/// path-prefix pins node:path (L22);
/// missing-msg pins missing native API plus
/// colon (L92); global-root pins globalThis
/// (L26); presence-branch-count pins int (5)
/// from L17-21; prefix-count pins int (2)
/// from L22; required-api-count pins int (78)
/// from distribution/target.json
/// requiredNativeAPIs.
/// Facet map (literal order): presence-fn,
/// async-hooks-api, proxy-api,
/// native-error-api, subtle-api, password-api,
/// fs-prefix, path-prefix, missing-msg,
/// global-root, presence-branch-count,
/// prefix-count, required-api-count.
/// The identity plus layout plus OS pins live
/// in history-131-base-semantics.can; the
/// probes plus report shape live in
/// history-131-run-shape.can.
/// Variants: manifest API list (this file;
/// branch spellings plus the 78-API tally).
/// Environment: distribution/target.json,
/// qualified Bun runtime, offline isolation
/// (row lists three gates; runtime binds at
/// QN1/QN2; no live run now).
/// Logical gates N1/N2 bind at QN1/QN2; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2
/// accept gates unmet).
/// Case history/native-qualification-impl-roots
/// checks: presence-fn, async-hooks-api,
/// proxy-api, native-error-api, subtle-api,
/// password-api, fs-prefix, path-prefix,
/// missing-msg, global-root,
/// presence-branch-count, prefix-count,
/// required-api-count.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str presence_fn
    str async_hooks_api
    str proxy_api
    str native_error_api
    str subtle_api
    str password_api
    str fs_prefix
    str path_prefix
    str missing_msg
    str global_root
    int presence_branch_count
    int prefix_count
    int required_api_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/native-qualification-impl-roots", "default", "", "offline"), "presence-fn" => ok "case history/native-qualification-impl-roots variant default root presence-fn run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/native-qualification-impl-roots", "default", "", "offline"), "presence-fn" => ok evidence("presence-fn", "true", "true", true, "case history/native-qualification-impl-roots variant default root presence-fn run offline")
        different: false, true, context("history/native-qualification-impl-roots", "default", "", "offline"), "presence-fn" => failed{"presence-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
