        seed_subtle_api: context("history/native-qualification-impl-roots", "seed-subtle-api-drift", "", "offline") => failed{"subtle-api"}
        seed_password_api: context("history/native-qualification-impl-roots", "seed-password-api-drift", "", "offline") => failed{"password-api"}
        seed_fs_prefix: context("history/native-qualification-impl-roots", "seed-fs-prefix-drift", "", "offline") => failed{"fs-prefix"}
        seed_path_prefix: context("history/native-qualification-impl-roots", "seed-path-prefix-drift", "", "offline") => failed{"path-prefix"}
        seed_missing_msg: context("history/native-qualification-impl-roots", "seed-missing-msg-drift", "", "offline") => failed{"missing-msg"}
        seed_global_root: context("history/native-qualification-impl-roots", "seed-global-root-drift", "", "offline") => failed{"global-root"}
        seed_presence_branch_count: context("history/native-qualification-impl-roots", "seed-presence-branch-count-drift", "", "offline") => failed{"presence-branch-count"}
        seed_prefix_count: context("history/native-qualification-impl-roots", "seed-prefix-count-drift", "", "offline") => failed{"prefix-count"}
        seed_required_api_count: context("history/native-qualification-impl-roots", "seed-required-api-count-drift", "", "offline") => failed{"required-api-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.presence_fn, "apiAvailable", c, "presence-fn")
            failed
            ok evidence presence_fn_evidence => match call require_text(got.async_hooks_api, "node:async_hooks.AsyncLocalStorage", c, "async-hooks-api")
                failed
                ok evidence async_hooks_api_evidence => match call require_text(got.proxy_api, "node:util.types.isProxy", c, "proxy-api")
                    failed
                    ok evidence proxy_api_evidence => match call require_text(got.native_error_api, "node:util.types.isNativeError", c, "native-error-api")
                        failed
                        ok evidence native_error_api_evidence => match call require_text(got.subtle_api, "crypto.subtle", c, "subtle-api")
                            failed
                            ok evidence subtle_api_evidence => match call require_text(got.password_api, "Bun.password", c, "password-api")
                                failed
                                ok evidence password_api_evidence => match call require_text(got.fs_prefix, "node:fs/promises", c, "fs-prefix")
                                    failed
