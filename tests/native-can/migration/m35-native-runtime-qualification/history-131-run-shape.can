package m35history131run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M35 HISTORY-131 native qualification
/// implementation: behavior probes plus
/// report computation.
/// Source: tests/conformance/native.ts
/// symbol native qualification implementation:
/// probes map (L28-85), qualify (L87-103)
/// and the CLI report finish (L105-123).
/// Disposition: migrate (this row owns the
/// implementation pins as reviewable Can
/// facts; the old bun sources stay until the
/// integrator retires them after every linked
/// row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): ten probe names,
/// qualify helper name, unknown-probe
/// message root, report kind value, passed
/// and failures roots, assert root, exit
/// root, and the three tallies bounding
/// probes, report fields and schema version.
/// ADAPTATION (recorded, with source lines):
/// name pins hold literal spellings; count
/// pins hold ints tallied from the named
/// lines.
/// probe-async pins isolated-async-context
/// (L29); probe-json pins
/// json-source-and-raw-integers (L36);
/// probe-from-async pins ordered-fromAsync
/// (L46); probe-box pins nonthenable-box
/// (L54); probe-equality pins strict-equality
/// (L62); probe-arrays pins immutable-arrays
/// (L66); probe-unicode pins
/// unicode-and-literal-replacement (L72);
/// probe-utf8 pins fatal-utf8 (L79);
/// probe-order pins native-intersection-order
/// (L80); probe-io pins bun-io-handles (L81);
/// qualify-fn pins qualify (L87);
/// unknown-msg pins unknown probe plus colon
/// (L97); report-kind pins
/// can.native-capability-report (L101);
/// passed-root pins passed (L102);
/// failures-root pins failures (L88);
/// assert-root pins assert (L8); exit-root
/// pins exitCode (L122); probe-count pins int
/// (10) from L28-85; report-field-count pins
/// int (8) from L101-102; schema-version pins
/// int (1) from L101.
/// Facet map (literal order): probe-async,
/// probe-json, probe-from-async, probe-box,
/// probe-equality, probe-arrays, probe-unicode,
/// probe-utf8, probe-order, probe-io,
/// qualify-fn, unknown-msg, report-kind,
/// passed-root, failures-root, assert-root,
/// exit-root, probe-count, report-field-count,
/// schema-version.
/// The identity plus layout plus OS pins live
/// in history-131-base-semantics.can; the
/// presence roots live in
/// history-131-roots-green.can.
/// Variants: behavior probes (this file; ten
/// probe names plus the 10-probe tally).
/// Environment: distribution/target.json,
/// qualified Bun runtime, offline isolation
/// (row lists three gates; runtime binds at
/// QN1/QN2; no live run now).
/// Logical gates N1/N2 bind at QN1/QN2; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1/QN2
/// accept gates unmet).
/// Case history/native-qualification-impl-run
/// checks: probe-async, probe-json,
/// probe-from-async, probe-box, probe-equality,
/// probe-arrays, probe-unicode, probe-utf8,
/// probe-order, probe-io, qualify-fn,
/// unknown-msg, report-kind, passed-root,
/// failures-root, assert-root, exit-root,
/// probe-count, report-field-count,
/// schema-version.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str probe_async
    str probe_json
    str probe_from_async
    str probe_box
    str probe_equality
    str probe_arrays
    str probe_unicode
    str probe_utf8
    str probe_order
    str probe_io
    str qualify_fn
    str unknown_msg
    str report_kind
    str passed_root
    str failures_root
    str assert_root
    str exit_root
    int probe_count
    int report_field_count
    int schema_version
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/native-qualification-impl-run", "default", "", "offline"), "probe-async" => ok "case history/native-qualification-impl-run variant default root probe-async run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/native-qualification-impl-run", "default", "", "offline"), "probe-async" => ok evidence("probe-async", "true", "true", true, "case history/native-qualification-impl-run variant default root probe-async run offline")
        different: false, true, context("history/native-qualification-impl-run", "default", "", "offline"), "probe-async" => failed{"probe-async"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("history/native-qualification-impl-run", "default", "", "offline"), "probe-count" => ok evidence("probe-count", "10", "10", true, "case history/native-qualification-impl-run variant default root probe-count run offline")
        different: 9, 10, context("history/native-qualification-impl-run", "default", "", "offline"), "probe-count" => failed{"probe-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "isolated-async-context", "isolated-async-context", context("history/native-qualification-impl-run", "default", "", "offline"), "probe-async" => ok evidence("probe-async", "isolated-async-context", "isolated-async-context", true, "case history/native-qualification-impl-run variant default root probe-async run offline")
        different: "isolated-async-context_2", "isolated-async-context", context("history/native-qualification-impl-run", "default", "", "offline"), "probe-async" => failed{"probe-async"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
