package m36history133
    provides [decide, disposition]
    uses []

/// M36 HISTORY-133 "authoring-policies registry.json".
/// Source: tests/authoring-policies/registry.json (8004 bytes).
/// Related fixtures: the six boolean/locals/near baseline and reference
/// fixtures, candidates/README.md, x-r08-comparison-2026-09-26.md.
/// Disposition: PRESERVE. The registry is the frozen 2026-09-26 case
/// registration: prompts, held-out rename/data maps, hidden checks,
/// current-idiom runs, frozen-x-r08 trial settings, attemptsRun 0.
/// It stays as the trial-registration record; H11 preassembly cites it
/// as an A08 input. Preserved history is not execution evidence.
/// Protects: registered authoring-policy comparison inputs and recorded
/// baseline/reference evidence; agent trials explicitly remain unrun.
/// Variants: none.
/// Environment: none (stored document; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (preserved record; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_133: "HISTORY-133" => ok disposition("HISTORY-133", "preserve", "tests/authoring-policies/registry.json; H11 preassembly A08 row", "Frozen trial registration retained as the held-out/prompts record; history, not execution evidence.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-133"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-133", "preserve", "tests/authoring-policies/registry.json; H11 preassembly A08 row", "Frozen trial registration retained as the held-out/prompts record; history, not execution evidence.")
