package m36history135
    provides [decide, disposition]
    uses []

/// M36 HISTORY-135 "candidates README.md".
/// Source: tests/authoring-policies/candidates/README.md (1008 bytes).
/// Related fixtures: the six boolean/locals/near baseline and reference
/// fixtures, registry.json (frozen-x-r08 settings).
/// Disposition: PRESERVE. The candidates README is the empty agent-output
/// slot runbook: 0 attempts on every case, frozen-x-r08 settings, start
/// each attempt from a baseline copy, never show reference or held-out
/// programs in prompts. It stays as the unrun-trial runbook record.
/// Preserved history is not execution evidence.
/// Protects: registered authoring-policy comparison inputs and recorded
/// baseline/reference evidence; agent trials explicitly remain unrun.
/// Variants: none.
/// Environment: none (stored document; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (preserved record; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_135: "HISTORY-135" => ok disposition("HISTORY-135", "preserve", "tests/authoring-policies/candidates/README.md; M36 HISTORY-133", "Empty-slot trial runbook retained as the unrun-agent-trial record; history, not execution evidence.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-135"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-135", "preserve", "tests/authoring-policies/candidates/README.md; M36 HISTORY-133", "Empty-slot trial runbook retained as the unrun-agent-trial record; history, not execution evidence.")
