package m36history136
    provides [decide]
    uses []

/// M36 HISTORY-136 "boolean baseline main.can".
/// Source: tests/authoring-policies/boolean/baseline/src/main.can
/// (260 bytes, sha256 0ab75c64...).
/// Related fixtures: boolean reference (M36 HISTORY-137), registry.json
/// boolean-arm-repair entry, x-r08-comparison X-R08-1 record.
/// Disposition: RETAIN-FIXTURE. Byte-frozen true-first Boolean repair-task
/// input: `pick` matches true before false with one assert row. Named
/// consumers: the X-R08-1 deterministic legs (canlc assert exit 0 on the
/// shipped surface, canlc format rewrite leg) and future frozen-x-r08
/// agent trials starting from copies. Starting state: baseline never
/// edited after registration; candidates start from copies. Kept as data;
/// not a Can-authored scenario and not execution evidence.
/// Protects: boolean baseline Can source is a comparison subject for the
/// authoring-policy baseline/reference leg.
/// Variants: boolean, baseline.
/// Environment: none (static fixture; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (retained fixture; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_136: "HISTORY-136" => ok disposition("HISTORY-136", "retain-fixture", "tests/authoring-policies/boolean/baseline/src/main.can; M36 HISTORY-134", "Byte-frozen repair-task input kept as comparison-subject data; not an authored scenario.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-136"
