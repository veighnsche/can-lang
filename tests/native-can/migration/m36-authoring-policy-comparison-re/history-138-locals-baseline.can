package m36history138
    provides [decide]
    uses []

/// M36 HISTORY-138 "locals baseline main.can".
/// Source: tests/authoring-policies/locals/baseline/src/main.can
/// (266 bytes, sha256 4a2853c0...).
/// Related fixtures: locals reference (M36 HISTORY-139), registry.json
/// local-warning-repair entry, x-r08-comparison X-R08-2 record.
/// Disposition: RETAIN-FIXTURE. Byte-frozen final-local-alias repair-task
/// input: `forwarded` binds `total` then returns it, with one assert row.
/// Named consumers: the X-R08-2 deterministic legs (canlc assert exit 0
/// plus one CAN-CHECK-UNNECESSARY-LOCAL stderr line on the shipped
/// surface) and future frozen-x-r08 agent trials starting from copies.
/// Starting state: baseline never edited after registration; candidates
/// start from copies. Kept as data; not a Can-authored scenario and not
/// execution evidence.
/// Protects: locals baseline Can source is a comparison subject for the
/// authoring-policy baseline/reference leg.
/// Variants: locals, baseline.
/// Environment: none (static fixture; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (retained fixture; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_138: "HISTORY-138" => ok disposition("HISTORY-138", "retain-fixture", "tests/authoring-policies/locals/baseline/src/main.can; M36 HISTORY-134", "Byte-frozen repair-task input kept as comparison-subject data; not an authored scenario.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-138"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-138", "retain-fixture", "tests/authoring-policies/locals/baseline/src/main.can; M36 HISTORY-134", "Byte-frozen repair-task input kept as comparison-subject data; not an authored scenario.")
