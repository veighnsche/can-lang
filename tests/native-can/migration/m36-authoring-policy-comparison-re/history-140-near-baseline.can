package m36history140
    provides [decide]
    uses []

/// M36 HISTORY-140 "near baseline main.can".
/// Source: tests/authoring-policies/near/baseline/src/main.can
/// (504 bytes, sha256 a6254e45...).
/// Related fixtures: near reference (M36 HISTORY-141), registry.json
/// near-binding-repair entry, x-r08-comparison X-R08-3 record.
/// Disposition: RETAIN-FIXTURE. Byte-frozen shadowed-capture repair-task
/// input: `compute` calls `combine` with plain lookup so the 99 shadows
/// win and compute:first reports bare `outcome mismatch` (assert exit 1,
/// silent stderr). Named consumers: the X-R08-3 deterministic legs and
/// future frozen-x-r08 agent trials starting from copies. Starting state:
/// baseline never edited after registration; candidates start from
/// copies. Kept as data; not a Can-authored scenario and not execution
/// evidence.
/// Protects: near baseline Can source is a comparison subject for the
/// authoring-policy baseline/reference leg.
/// Variants: near, baseline.
/// Environment: none (static fixture; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (retained fixture; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_140: "HISTORY-140" => ok disposition("HISTORY-140", "retain-fixture", "tests/authoring-policies/near/baseline/src/main.can; M36 HISTORY-134", "Byte-frozen repair-task input kept as comparison-subject data; not an authored scenario.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-140"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-140", "retain-fixture", "tests/authoring-policies/near/baseline/src/main.can; M36 HISTORY-134", "Byte-frozen repair-task input kept as comparison-subject data; not an authored scenario.")
