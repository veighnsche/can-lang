package m36history141
    provides [decide]
    uses []

/// M36 HISTORY-141 "near reference main.can".
/// Source: tests/authoring-policies/near/reference/src/main.can
/// (532 bytes, sha256 57e00421...).
/// Related fixtures: near baseline (M36 HISTORY-140), registry.json
/// near-binding-repair entry, x-r08-comparison X-R08-3 record.
/// Disposition: RETAIN-FIXTURE. Owner reference repair: `with prefix = 3,
/// suffix = 5` capture restores the intended capture; compute:first
/// passes and `combine` is byte-identical to baseline. Named consumer:
/// hidden-check validation (repaired asserts green, callee untouched,
/// with-typo mutant diagnosed with CAN-CHECK-CAPTURE). Starting state:
/// reference proves the checks pass; it is NOT agent output and is never
/// shown in a trial prompt. Kept as data; not a Can-authored scenario and
/// not execution evidence.
/// Protects: near reference Can source is a comparison subject for the
/// authoring-policy baseline/reference leg.
/// Variants: near, reference.
/// Environment: none (static fixture; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (retained fixture; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_141: "HISTORY-141" => ok disposition("HISTORY-141", "retain-fixture", "tests/authoring-policies/near/reference/src/main.can; M36 HISTORY-134", "Owner reference repair kept as hidden-check validation data; not an authored scenario.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-141"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-141", "retain-fixture", "tests/authoring-policies/near/reference/src/main.can; M36 HISTORY-134", "Owner reference repair kept as hidden-check validation data; not an authored scenario.")
