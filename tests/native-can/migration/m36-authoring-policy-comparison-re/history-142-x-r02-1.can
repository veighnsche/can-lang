package m36history142
    provides [decide]
    uses []

/// M36 HISTORY-142 "x-r02-1.md".
/// Source: tests/browser-controls/x-r02-1.md (8041 bytes).
/// Related fixtures: shared/grid-controls library sources, invoice-grid
/// and invoice-compare consumers cited by the record.
/// Disposition: PRESERVE. The dated X-R02-1 experiment record pins the
/// library-first composition + error-shape alignment decision (C04, C05
/// gate, F-R02-01/02): checker/projection legs only (canlc assert/build/
/// format), with live-browser legs explicitly owned by C06 and no browser
/// launchable (C01 blocked-open). It stays as the selection-context
/// record; H10 battery/manifest and the execution evidence index cite it.
/// Preserved history is not execution evidence.
/// Protects: historical browser-control experiment records checker/build
/// observations; it does not supply live browser matrix evidence.
/// Variants: none.
/// Environment: none (stored document; no run; relevance decision needs no live qualification).
/// Delegated oracles: none. C/R/N/S/A: not bound (preserved record; no P23 port).
/// Shared old files untouched; integrator retires after linked rows and callers resolve.
record disposition
    str row
    str verdict
    str live_owner
    str rationale
fn disposition decide
    emits {}
    given
        str row
    asserts
        history_142: "HISTORY-142" => ok disposition("HISTORY-142", "preserve", "tests/browser-controls/x-r02-1.md; H10 battery/manifest", "Dated experiment record retained as checker/build selection context; history, not execution evidence.")
        unknown: "nope" => ok disposition("nope", "unreviewed", "", "")
    match row is "HISTORY-142"
        false => ok disposition(row, "unreviewed", "", "")
        true => ok disposition("HISTORY-142", "preserve", "tests/browser-controls/x-r02-1.md; H10 battery/manifest", "Dated experiment record retained as checker/build selection context; history, not execution evidence.")
