package m37history143roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M37 HISTORY-143 "distribution native
/// qualification caller" isolation pact.
/// Source: distribution/qualify.py
/// symbol "distribution native
/// qualification caller" (L31-64 plus
/// L138-150): pinned network denial plus
/// provision helpers.
/// Disposition: rewire (same row pact as
/// the stage slice; this file owns the
/// deny roots).
/// Protects (this file): the darwin plus
/// linux deny spellings (L139-147) plus
/// helper call bytes plus tallies.
/// ADAPTATION (noted, plus source lines):
/// deny pins hold isolation bytes; helper
/// pins hold call spellings; count pins
/// hold ints tallied from L40 plus L60
/// plus L138-150.
/// darwin-network pins denied by macOS
/// sandbox (L139); darwin-tool pins
/// /usr/bin/sandbox-exec (L140);
/// darwin-policy pins (version 1)(allow
/// default)(deny network*) (L140);
/// linux-network pins denied by Linux
/// network namespace (unshare -n) (L142);
/// unshare-bin pins unshare (L40 plus L143
/// plus helpers); unshare-flag pins -n
/// (L40 plus L143); caller-prefix pins
/// caller-provided:  (L147, plus one gap);
/// glibc-cmd pins getconf (L32);
/// os-release-path pins /etc/os-release
/// (L24); net-class pins /sys/class/net
/// (L50); isolation-branch-count pins int
/// (4) from L138-150; unshare-prefix-count
/// pins int (3) from L143; down-state-count
/// pins int (2) from L60.
/// Facet map (deny then helper order):
/// darwin-network, darwin-tool,
/// darwin-policy, linux-network,
/// unshare-bin, unshare-flag,
/// caller-prefix, glibc-cmd,
/// os-release-path, net-class,
/// isolation-branch-count,
/// unshare-prefix-count, down-state-count.
/// The stage layout lives in
/// history-143-base-semantics.can; the run
/// shape plus verdict live in
/// history-143-run-shape.can.
/// Variants: darwin sandbox (L139-140)
/// plus linux unshare (L141-143) or caller
/// isolation (L144-148) (row lists two
/// variants; both pinned here; no live run
/// now).
/// Environment: pinned upstream archive
/// plus distribution/target.json (row lists
/// two gates; bind at QN1; no live run now).
/// Logical gates SUITE/N1/ENV/ARCHIVE bind
/// at P23/QN1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1
/// accept gates unmet).
/// Intended consumed report: M35
/// HISTORY-127..131 parsed slices (no
/// qualified report yet; P23/QN1 unmet).
/// Rewire stays blocked; qualify.py
/// intact; no call retired.
/// Case history/native-caller-isolation
/// checks: darwin-network, darwin-tool,
/// darwin-policy, linux-network,
/// unshare-bin, unshare-flag,
/// caller-prefix, glibc-cmd,
/// os-release-path, net-class,
/// isolation-branch-count,
/// unshare-prefix-count, down-state-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str darwin_network
    str darwin_tool
    str darwin_policy
    str linux_network
    str unshare_bin
    str unshare_flag
    str caller_prefix
    str glibc_cmd
    str os_release_path
    str net_class
    int isolation_branch_count
    int unshare_prefix_count
    int down_state_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/native-caller-isolation", "default", "", "offline"), "darwin-network" => ok "case history/native-caller-isolation variant default root darwin-network run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/native-caller-isolation", "default", "", "offline"), "darwin-network" => ok evidence("darwin-network", "true", "true", true, "case history/native-caller-isolation variant default root darwin-network run offline")
        different: false, true, context("history/native-caller-isolation", "default", "", "offline"), "darwin-network" => failed{"darwin-network"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("history/native-caller-isolation", "default", "", "offline"), "isolation-branch-count" => ok evidence("isolation-branch-count", "4", "4", true, "case history/native-caller-isolation variant default root isolation-branch-count run offline")
        different: 3, 4, context("history/native-caller-isolation", "default", "", "offline"), "isolation-branch-count" => failed{"isolation-branch-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "denied by macOS sandbox", "denied by macOS sandbox", context("history/native-caller-isolation", "default", "", "offline"), "darwin-network" => ok evidence("darwin-network", "denied by macOS sandbox", "denied by macOS sandbox", true, "case history/native-caller-isolation variant default root darwin-network run offline")
        different: "denied by macOS sandbox_2", "denied by macOS sandbox", context("history/native-caller-isolation", "default", "", "offline"), "darwin-network" => failed{"darwin-network"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
