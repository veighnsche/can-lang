        m37_h143: "m37-h143" => ok [check("darwin-network", "darwin network keeps its bytes"), check("darwin-tool", "darwin tool keeps its bytes"), check("darwin-policy", "darwin policy keeps its bytes"), check("linux-network", "linux network keeps its bytes"), check("unshare-bin", "unshare bin keeps its spelling"), check("unshare-flag", "unshare flag keeps its spelling"), check("caller-prefix", "caller prefix keeps its bytes"), check("glibc-cmd", "glibc cmd keeps its spelling"), check("os-release-path", "os release path keeps its bytes"), check("net-class", "net class keeps its bytes"), check("isolation-branch-count", "four isolation arms exist"), check("unshare-prefix-count", "three unshare prefix parts exist"), check("down-state-count", "two down states exist")]
        other: "nope" => ok []
    match scope is "m37-h143"
        false => ok []
        true => ok [check("darwin-network", "darwin network keeps its bytes"), check("darwin-tool", "darwin tool keeps its bytes"), check("darwin-policy", "darwin policy keeps its bytes"), check("linux-network", "linux network keeps its bytes"), check("unshare-bin", "unshare bin keeps its spelling"), check("unshare-flag", "unshare flag keeps its spelling"), check("caller-prefix", "caller prefix keeps its bytes"), check("glibc-cmd", "glibc cmd keeps its spelling"), check("os-release-path", "os release path keeps its bytes"), check("net-class", "net class keeps its bytes"), check("isolation-branch-count", "four isolation arms exist"), check("unshare-prefix-count", "three unshare prefix parts exist"), check("down-state-count", "two down states exist")]
