fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/native-caller-isolation", "default", "", "offline") => ok
        seed_darwin_network: context("history/native-caller-isolation", "seed-darwin-network-drift", "", "offline") => failed{"darwin-network"}
        seed_darwin_tool: context("history/native-caller-isolation", "seed-darwin-tool-drift", "", "offline") => failed{"darwin-tool"}
        seed_darwin_policy: context("history/native-caller-isolation", "seed-darwin-policy-drift", "", "offline") => failed{"darwin-policy"}
        seed_linux_network: context("history/native-caller-isolation", "seed-linux-network-drift", "", "offline") => failed{"linux-network"}
        seed_unshare_bin: context("history/native-caller-isolation", "seed-unshare-bin-drift", "", "offline") => failed{"unshare-bin"}
        seed_unshare_flag: context("history/native-caller-isolation", "seed-unshare-flag-drift", "", "offline") => failed{"unshare-flag"}
        seed_caller_prefix: context("history/native-caller-isolation", "seed-caller-prefix-drift", "", "offline") => failed{"caller-prefix"}
        seed_glibc_cmd: context("history/native-caller-isolation", "seed-glibc-cmd-drift", "", "offline") => failed{"glibc-cmd"}
        seed_os_release_path: context("history/native-caller-isolation", "seed-os-release-path-drift", "", "offline") => failed{"os-release-path"}
        seed_net_class: context("history/native-caller-isolation", "seed-net-class-drift", "", "offline") => failed{"net-class"}
        seed_isolation_branch_count: context("history/native-caller-isolation", "seed-isolation-branch-count-drift", "", "offline") => failed{"isolation-branch-count"}
        seed_unshare_prefix_count: context("history/native-caller-isolation", "seed-unshare-prefix-count-drift", "", "offline") => failed{"unshare-prefix-count"}
        seed_down_state_count: context("history/native-caller-isolation", "seed-down-state-count-drift", "", "offline") => failed{"down-state-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.darwin_network, "denied by macOS sandbox", c, "darwin-network")
            failed
            ok evidence darwin_network_evidence => match call require_text(got.darwin_tool, "/usr/bin/sandbox-exec", c, "darwin-tool")
                failed
                ok evidence darwin_tool_evidence => match call require_text(got.darwin_policy, "(version 1)(allow default)(deny network*)", c, "darwin-policy")
                    failed
                    ok evidence darwin_policy_evidence => match call require_text(got.linux_network, "denied by Linux network namespace (unshare -n)", c, "linux-network")
                        failed
                        ok evidence linux_network_evidence => match call require_text(got.unshare_bin, "unshare", c, "unshare-bin")
                            failed
                            ok evidence unshare_bin_evidence => match call require_text(got.unshare_flag, "-n", c, "unshare-flag")
                                failed
                                ok evidence unshare_flag_evidence => match call require_text(got.caller_prefix, "caller-provided: ", c, "caller-prefix")
                                    failed
                                    ok evidence caller_prefix_evidence => match call require_text(got.glibc_cmd, "getconf", c, "glibc-cmd")
                                        failed
                                        ok evidence glibc_cmd_evidence => match call require_text(got.os_release_path, "/etc/os-release", c, "os-release-path")
                                            failed
                                            ok evidence os_release_path_evidence => match call require_text(got.net_class, "/sys/class/net", c, "net-class")
                                                failed
                                                ok evidence net_class_evidence => match call require_int(got.isolation_branch_count, 4, c, "isolation-branch-count")
                                                    failed
                                                    ok evidence isolation_branch_count_evidence => match call require_int(got.unshare_prefix_count, 3, c, "unshare-prefix-count")
                                                        failed
                                                        ok evidence unshare_prefix_count_evidence => match call require_int(got.down_state_count, 2, c, "down-state-count")
                                                            failed
                                                            ok evidence down_state_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m37_h143: "m37-h143" => ok test_case("history/native-caller-isolation", ["history", "m37"], [], 120000, [check_ref("darwin-network"), check_ref("darwin-tool"), check_ref("darwin-policy"), check_ref("linux-network"), check_ref("unshare-bin"), check_ref("unshare-flag"), check_ref("caller-prefix"), check_ref("glibc-cmd"), check_ref("os-release-path"), check_ref("net-class"), check_ref("isolation-branch-count"), check_ref("unshare-prefix-count"), check_ref("down-state-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m37-h143"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("history/native-caller-isolation", ["history", "m37"], [], 120000, [check_ref("darwin-network"), check_ref("darwin-tool"), check_ref("darwin-policy"), check_ref("linux-network"), check_ref("unshare-bin"), check_ref("unshare-flag"), check_ref("caller-prefix"), check_ref("glibc-cmd"), check_ref("os-release-path"), check_ref("net-class"), check_ref("isolation-branch-count"), check_ref("unshare-prefix-count"), check_ref("down-state-count")], callable case_body)
