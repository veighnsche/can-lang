fn check[] checks
    emits {}
    given
        str scope
    asserts
        m37_h143: "m37-h143" => ok [check("test-verb", "test verb keeps its spelling"), check("kind-value", "report kind keeps its bytes"), check("target-key", "target key keeps its spelling"), check("manifest-key", "manifest key keeps its spelling"), check("execution-key", "execution key keeps its spelling"), check("archive-key", "archive key keeps its spelling"), check("negative-key", "negative key keeps its spelling"), check("glibc-key", "glibc key keeps its spelling"), check("verdict-fail", "verdict fail keeps its bytes"), check("verdict-head", "verdict head keeps its bytes"), check("schema-key", "schema key keeps its spelling"), check("failures-key", "failures key keeps its spelling"), check("return-key", "return key keeps its spelling"), check("capture-key", "capture key keeps its spelling"), check("command-count", "two commands exist"), check("execution-key-count", "six execution keys exist"), check("timeout-secs", "timeout is one hundred twenty"), check("schema-version", "schema version is one")]
        other: "nope" => ok []
    match scope is "m37-h143"
        false => ok []
        true => ok [check("test-verb", "test verb keeps its spelling"), check("kind-value", "report kind keeps its bytes"), check("target-key", "target key keeps its spelling"), check("manifest-key", "manifest key keeps its spelling"), check("execution-key", "execution key keeps its spelling"), check("archive-key", "archive key keeps its spelling"), check("negative-key", "negative key keeps its spelling"), check("glibc-key", "glibc key keeps its spelling"), check("verdict-fail", "verdict fail keeps its bytes"), check("verdict-head", "verdict head keeps its bytes"), check("schema-key", "schema key keeps its spelling"), check("failures-key", "failures key keeps its spelling"), check("return-key", "return key keeps its spelling"), check("capture-key", "capture key keeps its spelling"), check("command-count", "two commands exist"), check("execution-key-count", "six execution keys exist"), check("timeout-secs", "timeout is one hundred twenty"), check("schema-version", "schema version is one")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "history/native-caller-run" => ok [expected_check("test-verb", "test"), expected_check("kind-value", "can.native-capability-report"), expected_check("target-key", "targetId"), expected_check("manifest-key", "manifestSHA256"), expected_check("execution-key", "execution"), expected_check("archive-key", "archiveSHA256"), expected_check("negative-key", "negativeTestsPassed"), expected_check("glibc-key", "glibc"), expected_check("verdict-fail", "staged qualification or rejection tests failed"), expected_check("verdict-head", "Native qualification "), expected_check("schema-key", "schemaVersion"), expected_check("failures-key", "failures"), expected_check("return-key", "returncode"), expected_check("capture-key", "capture_output"), expected_check("command-count", "2"), expected_check("execution-key-count", "6"), expected_check("timeout-secs", "120"), expected_check("schema-version", "1")]
        unknown: "nope" => ok []
    match case is "history/native-caller-run"
        false => ok []
        true => ok [expected_check("test-verb", "test"), expected_check("kind-value", "can.native-capability-report"), expected_check("target-key", "targetId"), expected_check("manifest-key", "manifestSHA256"), expected_check("execution-key", "execution"), expected_check("archive-key", "archiveSHA256"), expected_check("negative-key", "negativeTestsPassed"), expected_check("glibc-key", "glibc"), expected_check("verdict-fail", "staged qualification or rejection tests failed"), expected_check("verdict-head", "Native qualification "), expected_check("schema-key", "schemaVersion"), expected_check("failures-key", "failures"), expected_check("return-key", "returncode"), expected_check("capture-key", "capture_output"), expected_check("command-count", "2"), expected_check("execution-key-count", "6"), expected_check("timeout-secs", "120"), expected_check("schema-version", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("history/native-caller-run", "default", "", "offline") => ok
        seed_test_verb: context("history/native-caller-run", "seed-test-verb-drift", "", "offline") => failed{"test-verb"}
        seed_kind_value: context("history/native-caller-run", "seed-kind-value-drift", "", "offline") => failed{"kind-value"}
        seed_target_key: context("history/native-caller-run", "seed-target-key-drift", "", "offline") => failed{"target-key"}
        seed_manifest_key: context("history/native-caller-run", "seed-manifest-key-drift", "", "offline") => failed{"manifest-key"}
        seed_execution_key: context("history/native-caller-run", "seed-execution-key-drift", "", "offline") => failed{"execution-key"}
        seed_archive_key: context("history/native-caller-run", "seed-archive-key-drift", "", "offline") => failed{"archive-key"}
        seed_negative_key: context("history/native-caller-run", "seed-negative-key-drift", "", "offline") => failed{"negative-key"}
        seed_glibc_key: context("history/native-caller-run", "seed-glibc-key-drift", "", "offline") => failed{"glibc-key"}
        seed_verdict_fail: context("history/native-caller-run", "seed-verdict-fail-drift", "", "offline") => failed{"verdict-fail"}
        seed_verdict_head: context("history/native-caller-run", "seed-verdict-head-drift", "", "offline") => failed{"verdict-head"}
        seed_schema_key: context("history/native-caller-run", "seed-schema-key-drift", "", "offline") => failed{"schema-key"}
        seed_failures_key: context("history/native-caller-run", "seed-failures-key-drift", "", "offline") => failed{"failures-key"}
        seed_return_key: context("history/native-caller-run", "seed-return-key-drift", "", "offline") => failed{"return-key"}
        seed_capture_key: context("history/native-caller-run", "seed-capture-key-drift", "", "offline") => failed{"capture-key"}
        seed_command_count: context("history/native-caller-run", "seed-command-count-drift", "", "offline") => failed{"command-count"}
        seed_execution_key_count: context("history/native-caller-run", "seed-execution-key-count-drift", "", "offline") => failed{"execution-key-count"}
        seed_timeout_secs: context("history/native-caller-run", "seed-timeout-secs-drift", "", "offline") => failed{"timeout-secs"}
        seed_schema_version: context("history/native-caller-run", "seed-schema-version-drift", "", "offline") => failed{"schema-version"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.test_verb, "test", c, "test-verb")
            failed
            ok evidence test_verb_evidence => match call require_text(got.kind_value, "can.native-capability-report", c, "kind-value")
                failed
                ok evidence kind_value_evidence => match call require_text(got.target_key, "targetId", c, "target-key")
                    failed
                    ok evidence target_key_evidence => match call require_text(got.manifest_key, "manifestSHA256", c, "manifest-key")
                        failed
                        ok evidence manifest_key_evidence => match call require_text(got.execution_key, "execution", c, "execution-key")
