package m37history143run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M37 HISTORY-143 "distribution native
/// qualification caller" run pact.
/// Source: distribution/qualify.py
/// symbol "distribution native
/// qualification caller" (L151-172): pinned
/// calls plus exit plus report plus
/// verdict.
/// Disposition: rewire (same row pact as
/// the stage slice; this file owns the
/// call plus verdict spellings).
/// Protects (this file): the two staged
/// calls (L151-155) plus exit checks plus
/// report keys plus verdict bytes plus
/// tallies.
/// ADAPTATION (noted, plus source lines):
/// call pins hold verb spellings; key pins
/// hold report spellings; verdict pins hold
/// fail plus head bytes; count pins hold
/// ints tallied from L151-170.
/// test-verb pins test (L151);
/// kind-value pins
/// can.native-capability-report (L85);
/// target-key pins targetId (L86);
/// manifest-key pins manifestSHA256 (L86);
/// execution-key pins execution (L159);
/// archive-key pins archiveSHA256 (L161);
/// negative-key pins negativeTestsPassed
/// (L161); glibc-key pins glibc (L163);
/// verdict-fail pins staged qualification or
/// rejection tests failed (L166);
/// verdict-head pins Native qualification
/// (L171, plus one gap); schema-key pins
/// schemaVersion (L85); failures-key pins
/// failures (L87 plus L166 plus L169);
/// return-key pins returncode (L153-166);
/// capture-key pins capture_output
/// (L153 plus L155); command-count pins int
/// (2) from L151-152; execution-key-count
/// pins int (6) from L159-161; timeout-secs
/// pins int (120) from L153 plus L155;
/// schema-version pins int (1) from L85.
/// Facet map (call then report order):
/// test-verb, kind-value, target-key,
/// manifest-key, execution-key,
/// archive-key, negative-key, glibc-key,
/// verdict-fail, verdict-head, schema-key,
/// failures-key, return-key, capture-key,
/// command-count, execution-key-count,
/// timeout-secs, schema-version.
/// The stage layout lives in
/// history-143-base-semantics.can; the
/// isolation roots live in
/// history-143-roots-green.can.
/// Variants: darwin sandbox plus linux
/// unshare or caller isolation (row lists
/// two variants; calls run under the
/// chosen deny arm; arms pinned in roots).
/// Environment: pinned upstream archive
/// plus distribution/target.json (row lists
/// two gates; bind at QN1; no live run now).
/// Logical gates SUITE/N1/ENV/ARCHIVE bind
/// at P23/QN1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (no bun timeout in this row; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QN1
/// accept gates unmet).
/// Intended consumed report: M35
/// HISTORY-127..131 parsed slices (no
/// qualified report yet; P23/QN1 unmet).
/// Rewire stays blocked; qualify.py
/// intact; no call retired.
/// Related: tests/conformance/native.ts
/// plus tests/conformance/native.test.ts
/// (invoked by the caller; owned by M35).
/// Case history/native-caller-run
/// checks: test-verb, kind-value,
/// target-key, manifest-key,
/// execution-key, archive-key,
/// negative-key, glibc-key, verdict-fail,
/// verdict-head, schema-key, failures-key,
/// return-key, capture-key, command-count,
/// execution-key-count, timeout-secs,
/// schema-version.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_verb
    str kind_value
    str target_key
    str manifest_key
    str execution_key
    str archive_key
    str negative_key
    str glibc_key
    str verdict_fail
    str verdict_head
    str schema_key
    str failures_key
    str return_key
    str capture_key
    int command_count
    int execution_key_count
    int timeout_secs
    int schema_version
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("history/native-caller-run", "default", "", "offline"), "test-verb" => ok "case history/native-caller-run variant default root test-verb run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("history/native-caller-run", "default", "", "offline"), "test-verb" => ok evidence("test-verb", "true", "true", true, "case history/native-caller-run variant default root test-verb run offline")
        different: false, true, context("history/native-caller-run", "default", "", "offline"), "test-verb" => failed{"test-verb"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("history/native-caller-run", "default", "", "offline"), "command-count" => ok evidence("command-count", "2", "2", true, "case history/native-caller-run variant default root command-count run offline")
        different: 1, 2, context("history/native-caller-run", "default", "", "offline"), "command-count" => failed{"command-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "test", "test", context("history/native-caller-run", "default", "", "offline"), "test-verb" => ok evidence("test-verb", "test", "test", true, "case history/native-caller-run variant default root test-verb run offline")
        different: "test_2", "test", context("history/native-caller-run", "default", "", "offline"), "test-verb" => failed{"test-verb"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
