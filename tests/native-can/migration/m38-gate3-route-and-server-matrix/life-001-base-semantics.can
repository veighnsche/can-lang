package m38life001base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-001 TestGate3ContractEdits
/// facet one legs.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ContractEdits (L99-178):
/// five pact edit legs must each fail
/// canlc assert and build with a line
/// naming the stale use or digest.
/// Disposition: migrate (this row owns
/// the failing-edit pact as reviewable
/// Can facts; the old go check stays
/// until the integrator retires it after
/// every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): the three facet
/// one legs (L112-137): shared-route
/// lock break, mount handler mismatch,
/// and field rename, each with its file
/// path, old and new bytes, plus the
/// wanted named lines.
/// ADAPTATION (recorded, with source
/// lines): name pins hold leg names; rel
/// pins hold staged file paths; old/new
/// pins hold rewrite bytes; want pins
/// hold wanted named lines; count pins
/// hold ints tallied from the leg list.
/// edit-shared-name pins
/// shared-route-edit-breaks-lock (L114);
/// edit-shared-rel pins the vendor
/// invoice pact path (L117);
/// edit-shared-old pins the old route
/// bytes (L117); edit-shared-new pins
/// the new route bytes (L117);
/// want-shared-stale pins the stale
/// digest line (L119); edit-mount-name
/// pins mount-handler-mismatch-diagnoses
/// (L122); edit-mount-rel pins
/// src/web/web.can (L125);
/// edit-mount-old pins the save_grid
/// call bytes (L125); edit-mount-new
/// pins the load_grid call bytes (L125);
/// want-mount-handler pins the handler
/// line (L127); want-mount-contract pins
/// contract::save_invoice_grid (L127);
/// edit-field-name pins
/// field-rename-diagnoses-stale-use
/// (L130); edit-field-rel pins
/// src/records/records.can (L134);
/// field-record-name pins
/// record line_draft (L133);
/// field-old-column pins the old column
/// bytes (L133); field-new-column pins
/// the new column bytes (L134);
/// want-field-unknown pins
/// unknown field id (L136);
/// want-field-check pins check_line
/// (L136); facet-one-edit-count pins int
/// (3) from L112-137; facet-one-want-count
/// pins int (5) from L119-136.
/// Facet map (leg order): edit-shared-name,
/// edit-shared-rel, edit-shared-old,
/// edit-shared-new, want-shared-stale,
/// edit-mount-name, edit-mount-rel,
/// edit-mount-old, edit-mount-new,
/// want-mount-handler, want-mount-contract,
/// edit-field-name, edit-field-rel,
/// field-record-name, field-old-column,
/// field-new-column, want-field-unknown,
/// want-field-check, facet-one-edit-count,
/// facet-one-want-count.
/// The registry plus chain legs live in
/// life-001-roots-green.can; the harness
/// plus loop shape lives in
/// life-001-run-shape.can.
/// Variants: five edits by two commands
/// (assert plus build); default plus
/// seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes (row
/// lists two gates; bind at P23; no live
/// run now).
/// Logical gates BUILD plus DIAG bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live twelve minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/contract-edits-base
/// checks: edit-shared-name,
/// edit-shared-rel, edit-shared-old,
/// edit-shared-new, want-shared-stale,
/// edit-mount-name, edit-mount-rel,
/// edit-mount-old, edit-mount-new,
/// want-mount-handler, want-mount-contract,
/// edit-field-name, edit-field-rel,
/// field-record-name, field-old-column,
/// field-new-column, want-field-unknown,
/// want-field-check, facet-one-edit-count,
/// facet-one-want-count.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str edit_shared_name
    str edit_shared_rel
    str edit_shared_old
    str edit_shared_new
    str want_shared_stale
    str edit_mount_name
    str edit_mount_rel
    str edit_mount_old
    str edit_mount_new
    str want_mount_handler
    str want_mount_contract
    str edit_field_name
    str edit_field_rel
    str field_record_name
    str field_old_column
    str field_new_column
    str want_field_unknown
    str want_field_check
    int facet_one_edit_count
    int facet_one_want_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/contract-edits-base", "default", "", "offline"), "edit-shared-name" => ok "case life/contract-edits-base variant default root edit-shared-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/contract-edits-base", "default", "", "offline"), "edit-shared-name" => ok evidence("edit-shared-name", "true", "true", true, "case life/contract-edits-base variant default root edit-shared-name run offline")
        different: false, true, context("life/contract-edits-base", "default", "", "offline"), "edit-shared-name" => failed{"edit-shared-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("life/contract-edits-base", "default", "", "offline"), "facet-one-edit-count" => ok evidence("facet-one-edit-count", "3", "3", true, "case life/contract-edits-base variant default root facet-one-edit-count run offline")
        different: 2, 3, context("life/contract-edits-base", "default", "", "offline"), "facet-one-edit-count" => failed{"facet-one-edit-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "shared-route-edit-breaks-lock", "shared-route-edit-breaks-lock", context("life/contract-edits-base", "default", "", "offline"), "edit-shared-name" => ok evidence("edit-shared-name", "shared-route-edit-breaks-lock", "shared-route-edit-breaks-lock", true, "case life/contract-edits-base variant default root edit-shared-name run offline")
        different: "shared-route-edit-breaks-lock_2", "shared-route-edit-breaks-lock", context("life/contract-edits-base", "default", "", "offline"), "edit-shared-name" => failed{"edit-shared-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("shared-route-edit-breaks-lock", "vendor/billing/src/invoice_contract/invoice_contract.can", "    post \"/tenants/:tenant_id/invoices/:invoice_id\"", "    post \"/t/:tenant_id/i/:invoice_id\"", "stale dependency digest for \"can.project.lineage/billing\"", "mount-handler-mismatch-diagnoses", "src/web/web.can", "call action::mount(contract::save_invoice_grid, callable save_grid)", "call action::mount(contract::save_invoice_grid, callable load_grid)", "action::mount handler \"load_grid\"", "contract::save_invoice_grid", "field-rename-diagnoses-stale-use", "src/records/records.can", "record line_draft", "    str id", "    str line_id", "unknown field id", "check_line", 3, 5)
