package m38life001roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-001 TestGate3ContractEdits
/// facet two legs.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ContractEdits (L99-178): the
/// bogus registry leg and the dangling
/// chain leg must each fail canlc assert
/// and build with a named line.
/// Disposition: migrate (same row pact as
/// the base slice; this file owns the
/// registry plus chain legs only).
/// Protects (this file): the two facet
/// two legs (L138-157): bogus active
/// error registry entry and dangling
/// predecessor chain, each with its
/// can.errors.json payload bytes plus
/// the wanted named line.
/// ADAPTATION (recorded, with source
/// lines): name pins hold leg names;
/// payload pins hold raw Go literal bytes
/// (escaped quotes; Go unquote yields
/// the registry file bytes); ident pins
/// hold error names; want pins hold
/// wanted named lines; count pins hold
/// ints tallied from the leg list.
/// edit-registry-name pins
/// bogus-registry-entry-fails (L139);
/// edit-registry-file pins
/// can.errors.json (L142);
/// registry-payload pins the raw bogus
/// payload bytes (L142); registry-ident
/// pins web::bogus (L142); want-registry
/// pins the differs line (L146);
/// edit-predecessor-name pins
/// dangling-predecessor-chain-fails
/// (L149); predecessor-payload pins the
/// raw chain payload bytes (L152);
/// predecessor-from pins web::x (L152);
/// predecessor-to pins web::y (L152);
/// want-predecessor pins the lacks line
/// (L156); facet-two-edit-count pins int
/// (2) from L138-157; facet-two-want-count
/// pins int (2) from L146-156.
/// Facet map (leg order):
/// edit-registry-name, edit-registry-file,
/// registry-payload, registry-ident,
/// want-registry, edit-predecessor-name,
/// predecessor-payload, predecessor-from,
/// predecessor-to, want-predecessor,
/// facet-two-edit-count, facet-two-want-count.
/// The facet one legs live in
/// life-001-base-semantics.can; the
/// harness plus loop shape lives in
/// life-001-run-shape.can.
/// Variants: five edits by two commands
/// (assert plus build); default plus
/// seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes (row
/// lists two gates; bind at P23; no live
/// run now).
/// Logical gates BUILD plus DIAG bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live twelve minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/contract-edits-roots
/// checks: edit-registry-name,
/// edit-registry-file, registry-payload,
/// registry-ident, want-registry,
/// edit-predecessor-name,
/// predecessor-payload, predecessor-from,
/// predecessor-to, want-predecessor,
/// facet-two-edit-count, facet-two-want-count.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str edit_registry_name
    str edit_registry_file
    str registry_payload
    str registry_ident
    str want_registry
    str edit_predecessor_name
    str predecessor_payload
    str predecessor_from
    str predecessor_to
    str want_predecessor
    int facet_two_edit_count
    int facet_two_want_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/contract-edits-roots", "default", "", "offline"), "edit-registry-name" => ok "case life/contract-edits-roots variant default root edit-registry-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/contract-edits-roots", "default", "", "offline"), "edit-registry-name" => ok evidence("edit-registry-name", "true", "true", true, "case life/contract-edits-roots variant default root edit-registry-name run offline")
        different: false, true, context("life/contract-edits-roots", "default", "", "offline"), "edit-registry-name" => failed{"edit-registry-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/contract-edits-roots", "default", "", "offline"), "facet-two-edit-count" => ok evidence("facet-two-edit-count", "2", "2", true, "case life/contract-edits-roots variant default root facet-two-edit-count run offline")
        different: 1, 2, context("life/contract-edits-roots", "default", "", "offline"), "facet-two-edit-count" => failed{"facet-two-edit-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
