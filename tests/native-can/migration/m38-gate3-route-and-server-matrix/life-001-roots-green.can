    asserts
        same: "bogus-registry-entry-fails", "bogus-registry-entry-fails", context("life/contract-edits-roots", "default", "", "offline"), "edit-registry-name" => ok evidence("edit-registry-name", "bogus-registry-entry-fails", "bogus-registry-entry-fails", true, "case life/contract-edits-roots variant default root edit-registry-name run offline")
        different: "bogus-registry-entry-fails_2", "bogus-registry-entry-fails", context("life/contract-edits-roots", "default", "", "offline"), "edit-registry-name" => failed{"edit-registry-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
