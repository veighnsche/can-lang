    emits {}
    given
        str scope
    asserts
        m38_l001: "m38-l001" => ok [check("edit-registry-name", "registry leg keeps its name"), check("edit-registry-file", "registry leg keeps its file name"), check("registry-payload", "registry leg keeps its payload bytes"), check("registry-ident", "registry leg keeps its bogus name"), check("want-registry", "registry leg wants the differs line"), check("edit-predecessor-name", "chain leg keeps its name"), check("predecessor-payload", "chain leg keeps its payload bytes"), check("predecessor-from", "chain leg keeps its from name"), check("predecessor-to", "chain leg keeps its to name"), check("want-predecessor", "chain leg wants the lacks line"), check("facet-two-edit-count", "two facet two legs exist"), check("facet-two-want-count", "two facet two wants exist")]
        other: "nope" => ok []
    match scope is "m38-l001"
        false => ok []
        true => ok [check("edit-registry-name", "registry leg keeps its name"), check("edit-registry-file", "registry leg keeps its file name"), check("registry-payload", "registry leg keeps its payload bytes"), check("registry-ident", "registry leg keeps its bogus name"), check("want-registry", "registry leg wants the differs line"), check("edit-predecessor-name", "chain leg keeps its name"), check("predecessor-payload", "chain leg keeps its payload bytes"), check("predecessor-from", "chain leg keeps its from name"), check("predecessor-to", "chain leg keeps its to name"), check("want-predecessor", "chain leg wants the lacks line"), check("facet-two-edit-count", "two facet two legs exist"), check("facet-two-want-count", "two facet two wants exist")]
