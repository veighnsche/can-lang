package m38life001run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-001 TestGate3ContractEdits
/// harness plus loop shape.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ContractEdits (L99-178): env
/// gate, staged invoice app, per-edit
/// apply, then assert plus build must
/// each exit nonzero with every wanted
/// named line present.
/// Disposition: migrate (same row pact as
/// the base slice; this file owns the
/// harness plus loop spellings and
/// tallies only).
/// Protects (this file): the env gate
/// (L101-103), the edit struct plus
/// helper names, the staged app plus
/// command words, the exit plus want
/// assertion lines, and the variant
/// matrix tallies.
/// ADAPTATION (recorded, with source
/// lines): name pins hold env, struct,
/// helper, app and command spellings;
/// note pins hold assertion line bytes;
/// call pins hold call spellings; count
/// pins hold ints tallied from the loop
/// plus want lists.
/// env-name pins CAN_BUN_ARCHIVE (L101);
/// skip-note pins the skip line (L103);
/// timeout-call pins 12*time.Minute
/// (L106); edit-struct pins gate3Edit
/// (L93); helper-rewrite pins
/// rewriteGate3File (L78); helper-bundle
/// pins harnessBundle (L108);
/// helper-stage pins stageApplication
/// (L161); helper-canlc pins canlcOffline
/// (L164); stage-app pins invoice (L161);
/// command-assert pins assert (L163);
/// command-build pins build (L163);
/// exit-guard pins status == 0 (L165);
/// pass-fail-note pins the passed line
/// (L166); want-call pins
/// strings.Contains(combined, want)
/// (L170); lack-note pins the lacks line
/// (L171); done-note pins the done line
/// (L175); unique-site-note pins the one
/// site line (L86); edit-count pins int
/// (5) from L112-158; command-count pins
/// int (2) from L163; matrix-leg-count
/// pins int (10) from L159-163;
/// want-total-count pins int (7) from
/// L119-156; timeout-minutes pins int
/// (12) from L106; unique-site-count pins
/// int (1) from L85-86.
/// Facet map (loop order): env-name,
/// skip-note, timeout-call, edit-struct,
/// helper-rewrite, helper-bundle,
/// helper-stage, helper-canlc, stage-app,
/// command-assert, command-build,
/// exit-guard, pass-fail-note, want-call,
/// lack-note, done-note, unique-site-note,
/// edit-count, command-count,
/// matrix-leg-count, want-total-count,
/// timeout-minutes, unique-site-count.
/// The facet one legs live in
/// life-001-base-semantics.can; the
/// registry plus chain legs live in
/// life-001-roots-green.can.
/// Variants: five edits by two commands
/// (assert plus build); default plus
/// seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes (row
/// lists two gates; bind at P23; no live
/// run now).
/// Logical gates BUILD plus DIAG bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live twelve minute hold is
/// pinned above as timeout-minutes;
/// binds at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/contract-edits-run
/// checks: env-name, skip-note,
/// timeout-call, edit-struct,
/// helper-rewrite, helper-bundle,
/// helper-stage, helper-canlc, stage-app,
/// command-assert, command-build,
/// exit-guard, pass-fail-note, want-call,
/// lack-note, done-note, unique-site-note,
/// edit-count, command-count,
/// matrix-leg-count, want-total-count,
/// timeout-minutes, unique-site-count.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_name
    str skip_note
    str timeout_call
    str edit_struct
    str helper_rewrite
    str helper_bundle
    str helper_stage
    str helper_canlc
    str stage_app
    str command_assert
    str command_build
    str exit_guard
    str pass_fail_note
    str want_call
    str lack_note
    str done_note
    str unique_site_note
    int edit_count
    int command_count
    int matrix_leg_count
    int want_total_count
    int timeout_minutes
    int unique_site_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/contract-edits-run", "default", "", "offline"), "env-name" => ok "case life/contract-edits-run variant default root env-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/contract-edits-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "true", "true", true, "case life/contract-edits-run variant default root env-name run offline")
        different: false, true, context("life/contract-edits-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("life/contract-edits-run", "default", "", "offline"), "edit-count" => ok evidence("edit-count", "5", "5", true, "case life/contract-edits-run variant default root edit-count run offline")
        different: 4, 5, context("life/contract-edits-run", "default", "", "offline"), "edit-count" => failed{"edit-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("life/contract-edits-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case life/contract-edits-run variant default root env-name run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("life/contract-edits-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
