package m38life002base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-002 "route rebuild: base
/// semantics" green pact.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3RouteRebuildLive (L269-328):
/// a shared-route edit plus its lock update
/// rebuilds twice with one stable id, and the
/// emitted bundle carries the new route.
/// Disposition: migrate (this row owns the
/// rebuild-identity facet as reviewable Can
/// facts; the old Go check stays until the
/// integrator retires it after every linked
/// row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): facet one, namely
/// that a relocked route change yields one
/// stable rebuilt id plus an updated emitted
/// route (rewrite operands, lock lineage,
/// relock call, build pair, edited assert).
/// ADAPTATION (recorded, with source lines):
/// rewrite pins hold the two staged operand
/// spellings (L283); emitted-route pins the
/// bundle grep spelling (L293); count pins
/// hold ints tallied from the rewrite guard
/// (L85), the build pair (L288-289), the
/// assert leg (L285) and the id log slice
/// (L327).
/// test-name pins TestGate3RouteRebuildLive
/// (L269); rewrite-old pins the old staged
/// operand (L283); rewrite-new pins the new
/// staged operand (L283); emitted-route pins
/// /t/:tenant_id/i/:invoice_id (L293);
/// contract-file pins
/// vendor/billing/src/invoice_contract/invoice_contract.can
/// (L283); lock-lineage pins
/// can.project.lineage/billing (L239);
/// relock-call pins gate3WriteLock(t, root)
/// (L284); build-call pins
/// applicationBuild(t, ctx, bundle, home, root)
/// (L288-289); drift-message pins edited
/// rebuild drifted (L291); assert-message pins
/// edited assert (L286); rewrite-site-count
/// pins int (1) from L85; build-count pins int
/// (2) from L288-289; assert-status pins int
/// (0) from L285; build-id-prefix pins int
/// (12) from L327.
/// Facet map (literal order): test-name,
/// rewrite-old, rewrite-new, emitted-route,
/// contract-file, lock-lineage, relock-call,
/// build-call, drift-message, assert-message,
/// rewrite-site-count, build-count,
/// assert-status, build-id-prefix.
/// The served-page plus HTTP verdicts live in
/// life-002-roots-green.can; the run shape
/// plus row verdicts live in
/// life-002-run-shape.can.
/// Variants: old/new route plus repeat build
/// (the stale 404 leg, the rebuilt 200 leg,
/// and the twice-built stable id; default
/// plus seeded drifts only).
/// Environment: CAN_BUN_ARCHIVE plus staged
/// bundled compiler/runtime, isolated homes,
/// free loopback ports, disposable SQLite,
/// managed server and fd-3 snapshot (row lists
/// three gates; binds at QHTTP/QD1; no live
/// run now).
/// Logical gates BUILD/DIAG/DB/HTTP bind at
/// P23/QHTTP/QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the Go ten-minute staged bound is
/// pinned as timeout-minutes in the run-shape
/// file; binds at P23 like the M35 no-run
/// rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QHTTP/QD1
/// accept gates unmet).
/// Case life/route-rebuild-base
/// checks: test-name, rewrite-old,
/// rewrite-new, emitted-route, contract-file,
/// lock-lineage, relock-call, build-call,
/// drift-message, assert-message,
/// rewrite-site-count, build-count,
/// assert-status, build-id-prefix.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_name
    str rewrite_old
    str rewrite_new
    str emitted_route
    str contract_file
    str lock_lineage
    str relock_call
    str build_call
    str drift_message
    str assert_message
    int rewrite_site_count
    int build_count
    int assert_status
    int build_id_prefix
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/route-rebuild-base", "default", "", "offline"), "test-name" => ok "case life/route-rebuild-base variant default root test-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/route-rebuild-base", "default", "", "offline"), "test-name" => ok evidence("test-name", "true", "true", true, "case life/route-rebuild-base variant default root test-name run offline")
        different: false, true, context("life/route-rebuild-base", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/route-rebuild-base", "default", "", "offline"), "rewrite-site-count" => ok evidence("rewrite-site-count", "1", "1", true, "case life/route-rebuild-base variant default root rewrite-site-count run offline")
        different: 0, 1, context("life/route-rebuild-base", "default", "", "offline"), "rewrite-site-count" => failed{"rewrite-site-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestGate3RouteRebuildLive", "TestGate3RouteRebuildLive", context("life/route-rebuild-base", "default", "", "offline"), "test-name" => ok evidence("test-name", "TestGate3RouteRebuildLive", "TestGate3RouteRebuildLive", true, "case life/route-rebuild-base variant default root test-name run offline")
        different: "TestGate3RouteRebuildLive_2", "TestGate3RouteRebuildLive", context("life/route-rebuild-base", "default", "", "offline"), "test-name" => failed{"test-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
