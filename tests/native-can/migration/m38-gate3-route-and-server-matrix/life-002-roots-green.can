fn check[] checks
    emits {}
    given
        str scope
    asserts
        m38_life002: "m38-life002" => ok [check("form-path", "form path keeps its bytes"), check("checked-hx-post", "page keeps its checked post target"), check("stale-post-path", "stale post path keeps its bytes"), check("rebuilt-post-path", "rebuilt post path keeps its bytes"), check("saved-body", "saved body keeps its bytes"), check("form-message", "form refusal keeps its bytes"), check("hx-message", "checked post refusal keeps its bytes"), check("stale-message", "stale refusal keeps its bytes"), check("rebuilt-message", "rebuilt refusal keeps its bytes"), check("session-value", "session value keeps its bytes"), check("form-status", "served form wants 200"), check("stale-status", "stale post wants 404"), check("rebuilt-status", "rebuilt post wants 200"), check("page-excerpt", "page excerpt spans 800 runes")]
        other: "nope" => ok []
    match scope is "m38-life002"
        false => ok []
        true => ok [check("form-path", "form path keeps its bytes"), check("checked-hx-post", "page keeps its checked post target"), check("stale-post-path", "stale post path keeps its bytes"), check("rebuilt-post-path", "rebuilt post path keeps its bytes"), check("saved-body", "saved body keeps its bytes"), check("form-message", "form refusal keeps its bytes"), check("hx-message", "checked post refusal keeps its bytes"), check("stale-message", "stale refusal keeps its bytes"), check("rebuilt-message", "rebuilt refusal keeps its bytes"), check("session-value", "session value keeps its bytes"), check("form-status", "served form wants 200"), check("stale-status", "stale post wants 404"), check("rebuilt-status", "rebuilt post wants 200"), check("page-excerpt", "page excerpt spans 800 runes")]
