package m38life002roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-002 "route rebuild: served
/// verdicts" green pact.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3RouteRebuildLive (L269-328):
/// the served edit page follows its checked
/// action URL, the stale route answers 404,
/// and the rebuilt route answers 200 with a
/// saved revision plus row proof.
/// Disposition: migrate (this row owns the
/// served-form facet as reviewable Can facts;
/// the old Go check stays until the
/// integrator retires it after every linked
/// row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): facet two, namely
/// that the served form follows the checked
/// new URL while the old route refuses and
/// the new route commits the wanted row (form
/// path, checked post target, stale 404 leg,
/// rebuilt 200 leg, saved body; row proof in
/// the run-shape file).
/// ADAPTATION (recorded, with source lines):
/// path pins hold staged URL spellings
/// (L303, L307, L319, L322); message pins
/// hold refusal spellings (L305, L308, L320,
/// L323); status pins hold ints from the
/// guard legs (L304, L319, L322); the excerpt
/// pin holds int (800) from L308.
/// form-path pins
/// /invoices/form?tenant_id=1&invoice_id=7
/// (L303); checked-hx-post pins
/// hx-post="/t/1/i/7" (L307); stale-post-path
/// pins /tenants/1/invoices/7 (L319);
/// rebuilt-post-path pins /t/1/i/7 (L322);
/// saved-body pins saved revision 2 (L322);
/// form-message pins edited form page (L305);
/// hx-message pins the checked-post refusal
/// (L308); stale-message pins stale route
/// post (L320); rebuilt-message pins rebuilt
/// route post (L323); session-value pins
/// tok-alice (L303); form-status pins int
/// (200) from L304; stale-status pins int
/// (404) from L319; rebuilt-status pins int
/// (200) from L322; page-excerpt pins int
/// (800) from L308.
/// Facet map (literal order): form-path,
/// checked-hx-post, stale-post-path,
/// rebuilt-post-path, saved-body,
/// form-message, hx-message, stale-message,
/// rebuilt-message, session-value,
/// form-status, stale-status, rebuilt-status,
/// page-excerpt.
/// The rebuild-identity pins live in
/// life-002-base-semantics.can; the run shape
/// plus row verdicts live in
/// life-002-run-shape.can.
/// Variants: old/new route plus repeat build
/// (the stale 404 leg and the rebuilt 200 leg
/// on this page; default plus seeded drifts
/// only).
/// Environment: CAN_BUN_ARCHIVE plus staged
/// bundled compiler/runtime, isolated homes,
/// free loopback ports, disposable SQLite,
/// managed server and fd-3 snapshot (row lists
/// three gates; binds at QHTTP/QD1; no live
/// run now).
/// Logical gates BUILD/DIAG/DB/HTTP bind at
/// P23/QHTTP/QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the Go ten-minute staged bound is
/// pinned as timeout-minutes in the run-shape
/// file; binds at P23 like the M35 no-run
/// rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QHTTP/QD1
/// accept gates unmet).
/// Case life/route-rebuild-roots
/// checks: form-path, checked-hx-post,
/// stale-post-path, rebuilt-post-path,
/// saved-body, form-message, hx-message,
/// stale-message, rebuilt-message,
/// session-value, form-status, stale-status,
/// rebuilt-status, page-excerpt.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str form_path
    str checked_hx_post
    str stale_post_path
    str rebuilt_post_path
    str saved_body
    str form_message
    str hx_message
    str stale_message
    str rebuilt_message
    str session_value
    int form_status
    int stale_status
    int rebuilt_status
    int page_excerpt
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/route-rebuild-roots", "default", "", "offline"), "form-path" => ok "case life/route-rebuild-roots variant default root form-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/route-rebuild-roots", "default", "", "offline"), "form-path" => ok evidence("form-path", "true", "true", true, "case life/route-rebuild-roots variant default root form-path run offline")
        different: false, true, context("life/route-rebuild-roots", "default", "", "offline"), "form-path" => failed{"form-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("life/route-rebuild-roots", "default", "", "offline"), "form-status" => ok evidence("form-status", "200", "200", true, "case life/route-rebuild-roots variant default root form-status run offline")
        different: 199, 200, context("life/route-rebuild-roots", "default", "", "offline"), "form-status" => failed{"form-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/invoices/form?tenant_id=1&invoice_id=7", "/invoices/form?tenant_id=1&invoice_id=7", context("life/route-rebuild-roots", "default", "", "offline"), "form-path" => ok evidence("form-path", "/invoices/form?tenant_id=1&invoice_id=7", "/invoices/form?tenant_id=1&invoice_id=7", true, "case life/route-rebuild-roots variant default root form-path run offline")
        different: "/invoices/form?tenant_id=1&invoice_id=7_2", "/invoices/form?tenant_id=1&invoice_id=7", context("life/route-rebuild-roots", "default", "", "offline"), "form-path" => failed{"form-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
