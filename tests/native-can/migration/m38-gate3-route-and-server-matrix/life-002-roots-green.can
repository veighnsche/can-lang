    match case is "life/route-rebuild-roots"
        false => ok []
        true => ok [expected_check("form-path", "/invoices/form?tenant_id=1&invoice_id=7"), expected_check("checked-hx-post", "hx-post=\"/t/1/i/7\""), expected_check("stale-post-path", "/tenants/1/invoices/7"), expected_check("rebuilt-post-path", "/t/1/i/7"), expected_check("saved-body", "saved revision 2"), expected_check("form-message", "edited form page: %d %s"), expected_check("hx-message", "edited page lost its checked hx-post in %.800s"), expected_check("stale-message", "stale route post: %d %s, want 404"), expected_check("rebuilt-message", "rebuilt route post: %d %s, want 200 saved"), expected_check("session-value", "tok-alice"), expected_check("form-status", "200"), expected_check("stale-status", "404"), expected_check("rebuilt-status", "200"), expected_check("page-excerpt", "800")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/route-rebuild-roots", "default", "", "offline") => ok
        seed_form_path: context("life/route-rebuild-roots", "seed-form-path-drift", "", "offline") => failed{"form-path"}
