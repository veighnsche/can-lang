package m38life002run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-002 "route rebuild: run shape"
/// green pact.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3RouteRebuildLive (L269-328):
/// the staged run shape, namely the archive
/// gate, driver, snapshot, loopback origin,
/// health leg, posted form and the wanted
/// SQLite row.
/// Disposition: migrate (this row owns the
/// run-shape plus row facet as reviewable Can
/// facts; the old Go check stays until the
/// integrator retires it after every linked
/// row, variant, environment and control has
/// accepted evidence).
/// Protects (this file): the staged run
/// shape plus the row proof the new route
/// must commit (archive gate, driver path,
/// snapshot names, loopback origin, health
/// path, entry file, posted form fields, row
/// call with four args).
/// ADAPTATION (recorded, with source lines):
/// name pins hold staged spellings (L271-300);
/// form pins hold posted field spellings
/// (L312-315); row-call pins the SQLite proof
/// spelling (L326); count pins hold ints from
/// the staged bound (L276), the port const
/// (L67), the posted field tally (L312-318)
/// and the row arg tally (L326).
/// env-var pins CAN_BUN_ARCHIVE (L271);
/// skip-message pins the skip line (L273);
/// driver-path pins
/// tests/integration/testdata/invoice/driver.ts
/// (L296); snapshot-name pins
/// snapshot-gate3-route (L299); db-key pins
/// INVOICE_DB (L299); origin-key pins
/// PUBLIC_ORIGIN (L299); loopback-host pins
/// http://127.0.0.1: (L298); health-path pins
/// /health (L300); entry-file pins entry.ts
/// (L300); row-call pins the row proof call
/// (L326); form-seats pins the posted seats
/// line (L312); form-details pins the posted
/// details line (L313); form-revision pins
/// the posted revision line (L314);
/// form-order pins the posted order line
/// (L315); timeout-minutes pins int (10) from
/// L276; route-port pins int (18562) from
/// L67; form-field-count pins int (7) from
/// L312-318; row-arg-count pins int (4) from
/// L326.
/// Facet map (literal order): env-var,
/// skip-message, driver-path, snapshot-name,
/// db-key, origin-key, loopback-host,
/// health-path, entry-file, row-call,
/// form-seats, form-details, form-revision,
/// form-order, timeout-minutes, route-port,
/// form-field-count, row-arg-count.
/// The rebuild-identity pins live in
/// life-002-base-semantics.can; the
/// served-page plus HTTP verdicts live in
/// life-002-roots-green.can.
/// Variants: old/new route plus repeat build
/// (the posted form feeds both legs; default
/// plus seeded drifts only).
/// Environment: CAN_BUN_ARCHIVE plus staged
/// bundled compiler/runtime, isolated homes,
/// free loopback ports, disposable SQLite,
/// managed server and fd-3 snapshot (row lists
/// three gates; binds at QHTTP/QD1; no live
/// run now).
/// Logical gates BUILD/DIAG/DB/HTTP bind at
/// P23/QHTTP/QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the Go ten-minute staged bound is
/// pinned here as timeout-minutes; binds at
/// P23 like the M35 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23/QHTTP/QD1
/// accept gates unmet).
/// Case life/route-rebuild-run
/// checks: env-var, skip-message, driver-path,
/// snapshot-name, db-key, origin-key,
/// loopback-host, health-path, entry-file,
/// row-call, form-seats, form-details,
/// form-revision, form-order, timeout-minutes,
/// route-port, form-field-count, row-arg-count.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_var
    str skip_message
    str driver_path
    str snapshot_name
    str db_key
    str origin_key
    str loopback_host
    str health_path
    str entry_file
    str row_call
    str form_seats
    str form_details
    str form_revision
    str form_order
    int timeout_minutes
    int route_port
    int form_field_count
    int row_arg_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/route-rebuild-run", "default", "", "offline"), "env-var" => ok "case life/route-rebuild-run variant default root env-var run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/route-rebuild-run", "default", "", "offline"), "env-var" => ok evidence("env-var", "true", "true", true, "case life/route-rebuild-run variant default root env-var run offline")
        different: false, true, context("life/route-rebuild-run", "default", "", "offline"), "env-var" => failed{"env-var"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 10, 10, context("life/route-rebuild-run", "default", "", "offline"), "timeout-minutes" => ok evidence("timeout-minutes", "10", "10", true, "case life/route-rebuild-run variant default root timeout-minutes run offline")
        different: 9, 10, context("life/route-rebuild-run", "default", "", "offline"), "timeout-minutes" => failed{"timeout-minutes"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("life/route-rebuild-run", "default", "", "offline"), "env-var" => ok evidence("env-var", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case life/route-rebuild-run variant default root env-var run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("life/route-rebuild-run", "default", "", "offline"), "env-var" => failed{"env-var"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
