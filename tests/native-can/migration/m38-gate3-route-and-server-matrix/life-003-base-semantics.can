package m38life003base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-003 TestGate3ServerMatrix
/// save plus replay legs.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ServerMatrix (L518-899):
/// valid JSON writes commit with one
/// ledger row; identical replays merge;
/// changed or stale writes conflict;
/// invalid writes refuse and store nil.
/// Disposition: migrate (this row owns
/// the save plus replay pact as
/// reviewable Can facts; the old go
/// check stays until the integrator
/// retires it after every linked row,
/// variant, environment and control has
/// accepted evidence).
/// Protects (this file): facet one save
/// half (L553-572: JSON save, stored
/// lines, actor plus tenant plus invoice
/// scope) and facet two (L574-608: one
/// effect replay, changed plus stale
/// conflict, invalid no-write).
/// ADAPTATION (recorded, with source
/// lines): pins hold asserted literals
/// only; request-only operation ids
/// (op-m2 L595, op-m5 L639, op-m6 L647,
/// op-m7 L653, op-m8 L705) stay
/// line-refs since no ledger value
/// names them here; op-m7 plus op-m8
/// commits surface as charset-revision
/// (L656) and recovery-revision (L722)
/// in the run slice; stale 409 (L595)
/// shares conflict-status with changed
/// 409 (L588); sku plus quantity inputs
/// stay line-refs (L541) since only
/// minor price 999 (L566) is asserted.
/// save-path pins
/// /api/tenants/1/invoices/7 (L539);
/// save-op pins op-m1 (L554);
/// save-leaf pins
/// invoice_contract::grid_saved (L555);
/// save-revision pins 2 (L557);
/// save-media pins application/json
/// (L554); save-customer pins the Acme
/// label (L565); save-price pins 999
/// (L566); save-actor pins alice (L570);
/// save-tenant pins 1 (L570);
/// save-invoice pins 7 (L570);
/// conflict-leaf pins
/// invoice_contract::grid_conflict
/// (L589); conflict-message pins stale
/// revision (L589); changed-id pins
/// changed (L587); bad-op pins op-m4
/// (L597); bad-leaf pins
/// invoice_contract::grid_invalid
/// (L599); bad-field pins quantity
/// (L601); save-line-count pins int (2)
/// from L566; replay-row-count pins int
/// (1) from L584; bad-problem-count
/// pins int (1) from L601;
/// save-status pins int (200) from
/// L554; conflict-status pins int (409)
/// from L588; bad-status pins int (422)
/// from L598.
/// Facet map (leg order): save-path,
/// save-op, save-leaf, save-revision,
/// save-media, save-customer,
/// save-price, save-actor, save-tenant,
/// save-invoice, conflict-leaf,
/// conflict-message, changed-id,
/// bad-op, bad-leaf, bad-field,
/// save-line-count, replay-row-count,
/// bad-problem-count, save-status,
/// conflict-status, bad-status.
/// The load plus denial plus refused
/// media legs live in
/// life-003-roots-green.can; the pact
/// media plus outage plus reorder plus
/// swap plus crash legs live in
/// life-003-run-shape.can.
/// Variants: save plus load allow plus
/// deny grids; JSON plus form media and
/// bulk refusals; mid-flight plus
/// lost-ack crashes (this file holds
/// the JSON save plus replay cells).
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes
/// plus loopback ports plus disposable
/// SQLite plus a managed server (row
/// lists three gates; bind at P23; no
/// live run now).
/// Logical gates BUILD plus DIAG plus
/// DB plus HTTP bind at P23 plus QHTTP
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live fourteen
/// minute hold is pinned in the run
/// slice; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates
/// unmet).
/// Case life/server-matrix-save
/// checks: save-path, save-op,
/// save-leaf, save-revision,
/// save-media, save-customer,
/// save-price, save-actor, save-tenant,
/// save-invoice, conflict-leaf,
/// conflict-message, changed-id,
/// bad-op, bad-leaf, bad-field,
/// save-line-count, replay-row-count,
/// bad-problem-count, save-status,
/// conflict-status, bad-status.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str save_path
    str save_op
    str save_leaf
    str save_revision
    str save_media
    str save_customer
    str save_price
    str save_actor
    str save_tenant
    str save_invoice
    str conflict_leaf
    str conflict_message
    str changed_id
    str bad_op
    str bad_leaf
    str bad_field
    int save_line_count
    int replay_row_count
    int bad_problem_count
    int save_status
    int conflict_status
    int bad_status
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/server-matrix-save", "default", "", "offline"), "save-path" => ok "case life/server-matrix-save variant default root save-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/server-matrix-save", "default", "", "offline"), "save-path" => ok evidence("save-path", "true", "true", true, "case life/server-matrix-save variant default root save-path run offline")
        different: false, true, context("life/server-matrix-save", "default", "", "offline"), "save-path" => failed{"save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/server-matrix-save", "default", "", "offline"), "save-line-count" => ok evidence("save-line-count", "2", "2", true, "case life/server-matrix-save variant default root save-line-count run offline")
        different: 1, 2, context("life/server-matrix-save", "default", "", "offline"), "save-line-count" => failed{"save-line-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", context("life/server-matrix-save", "default", "", "offline"), "save-path" => ok evidence("save-path", "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", true, "case life/server-matrix-save variant default root save-path run offline")
        different: "/api/tenants/1/invoices/7_2", "/api/tenants/1/invoices/7", context("life/server-matrix-save", "default", "", "offline"), "save-path" => failed{"save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("/api/tenants/1/invoices/7", "op-m1", "invoice_contract::grid_saved", "2", "application/json", "Acme <em>&\" 'coop'\"", "999", "alice", "1", "7", "invoice_contract::grid_conflict", "stale revision", "changed", "op-m4", "invoice_contract::grid_invalid", "quantity", 2, 1, 1, 200, 409, 422)
        seed_save_path: "seed-save-path-drift" => ok observation("/api/tenants/1/invoices/7_2", "op-m1", "invoice_contract::grid_saved", "2", "application/json", "Acme <em>&\" 'coop'\"", "999", "alice", "1", "7", "invoice_contract::grid_conflict", "stale revision", "changed", "op-m4", "invoice_contract::grid_invalid", "quantity", 2, 1, 1, 200, 409, 422)
        seed_save_op: "seed-save-op-drift" => ok observation("/api/tenants/1/invoices/7", "op-m1_2", "invoice_contract::grid_saved", "2", "application/json", "Acme <em>&\" 'coop'\"", "999", "alice", "1", "7", "invoice_contract::grid_conflict", "stale revision", "changed", "op-m4", "invoice_contract::grid_invalid", "quantity", 2, 1, 1, 200, 409, 422)
