package m38life003roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-003 TestGate3ServerMatrix
/// load plus denial legs.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ServerMatrix (L518-899):
/// a member loads stored lines in
/// stored order with the exact total;
/// foreign, missing, anonymous,
/// revoked and ghost callers share one
/// nondisclosing 403; refused media,
/// shape and bulk never reach the
/// guarded entry.
/// Disposition: migrate (this row owns
/// the load plus denial pact as
/// reviewable Can facts; the old go
/// check stays until the integrator
/// retires it after every linked row,
/// variant, environment and control has
/// accepted evidence).
/// Protects (this file): facet one load
/// half (L661-688: member load, exact
/// total, stored line order, denied
/// loads) and facet three (L610-650:
/// five-leg 403 grid, no stored bytes
/// leak, 415 plus 400 plus 413
/// refusals).
/// ADAPTATION (recorded, with source
/// lines): caller cookie bytes stay
/// unquoted (L615-619 name the five
/// legs; note labels pin the legs);
/// path cells pin tenant 2 (L615) plus
/// invoices 8 and 9 (L615-616); the
/// plain media kind stays a line-ref
/// (L639) since only its 415 status
/// plus body are pinned; leak pins hold
/// the three probe words (L629); load
/// grid cells reuse the save grid
/// tenant plus invoice ids (L676-682).
/// load-leaf pins
/// invoice_contract::grid_loaded
/// (L667); load-revision pins 3 (L669);
/// load-total pins 4196.0 (L669);
/// load-key-first pins k1 (L673);
/// load-key-second pins k2 (L673);
/// load-forbidden-leaf pins
/// invoice_contract::grid_load_forbidden
/// (L687); denied-op pins op-denied
/// (L621); denied-leaf pins
/// invoice_contract::grid_forbidden
/// (L625); denied-note-foreign pins
/// json foreign (L615);
/// denied-note-missing pins json
/// missing (L616); denied-note-anonymous
/// pins json anonymous (L617);
/// denied-note-revoked pins json
/// revoked (L618); denied-note-ghost
/// pins json ghost (L619);
/// leak-globex pins Globex (L629);
/// leak-tenant-word pins tenant (L629);
/// leak-acme pins Acme (L629);
/// denied-invoice-foreign pins 8
/// (L615); denied-invoice-missing pins
/// 9 (L616); bad-media-body pins
/// Unsupported Media Type (L640);
/// malformed-body pins Bad Request
/// (L644); oversize-body pins Payload
/// Too Large (L648); load-line-count
/// pins int (2) from L673;
/// load-matrix-count pins int (3) from
/// L676-682; denied-count pins int (5)
/// from L612-620; denied-value-count
/// pins int (2) from L626;
/// denied-status pins int (403) from
/// L622; denied-tenant-foreign pins int
/// (2) from L615; bad-media-status pins
/// int (415) from L639;
/// malformed-status pins int (400) from
/// L643; oversize-status pins int (413)
/// from L647.
/// Facet map (leg order): load-leaf,
/// load-revision, load-total,
/// load-key-first, load-key-second,
/// load-forbidden-leaf, denied-op,
/// denied-leaf, denied-note-foreign,
/// denied-note-missing,
/// denied-note-anonymous,
/// denied-note-revoked,
/// denied-note-ghost, leak-globex,
/// leak-tenant-word, leak-acme,
/// denied-invoice-foreign,
/// denied-invoice-missing,
/// bad-media-body, malformed-body,
/// oversize-body, load-line-count,
/// load-matrix-count, denied-count,
/// denied-value-count, denied-status,
/// denied-tenant-foreign,
/// bad-media-status, malformed-status,
/// oversize-status.
/// The save plus replay legs live in
/// life-003-base-semantics.can; the
/// pact media plus outage plus reorder
/// plus swap plus crash legs live in
/// life-003-run-shape.can.
/// Variants: save plus load allow plus
/// deny grids; JSON plus form media and
/// bulk refusals; mid-flight plus
/// lost-ack crashes (this file holds
/// the load plus denial plus refused
/// media cells).
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes
/// plus loopback ports plus disposable
/// SQLite plus a managed server (row
/// lists three gates; bind at P23; no
/// live run now).
/// Logical gates BUILD plus DIAG plus
/// DB plus HTTP bind at P23 plus QHTTP
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live fourteen
/// minute hold is pinned in the run
/// slice; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates
/// unmet).
/// Case life/server-matrix-scope
/// checks: load-leaf, load-revision,
/// load-total, load-key-first,
/// load-key-second,
/// load-forbidden-leaf, denied-op,
/// denied-leaf, denied-note-foreign,
/// denied-note-missing,
/// denied-note-anonymous,
/// denied-note-revoked,
/// denied-note-ghost, leak-globex,
/// leak-tenant-word, leak-acme,
/// denied-invoice-foreign,
/// denied-invoice-missing,
/// bad-media-body, malformed-body,
/// oversize-body, load-line-count,
/// load-matrix-count, denied-count,
/// denied-value-count, denied-status,
/// denied-tenant-foreign,
/// bad-media-status, malformed-status,
/// oversize-status.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str load_leaf
    str load_revision
    str load_total
    str load_key_first
    str load_key_second
    str load_forbidden_leaf
    str denied_op
    str denied_leaf
    str denied_note_foreign
    str denied_note_missing
    str denied_note_anonymous
    str denied_note_revoked
    str denied_note_ghost
    str leak_globex
    str leak_tenant_word
    str leak_acme
    str denied_invoice_foreign
    str denied_invoice_missing
    str bad_media_body
    str malformed_body
    str oversize_body
    int load_line_count
    int load_matrix_count
    int denied_count
    int denied_value_count
    int denied_status
    int denied_tenant_foreign
    int bad_media_status
    int malformed_status
    int oversize_status
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/server-matrix-scope", "default", "", "offline"), "load-leaf" => ok "case life/server-matrix-scope variant default root load-leaf run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/server-matrix-scope", "default", "", "offline"), "load-leaf" => ok evidence("load-leaf", "true", "true", true, "case life/server-matrix-scope variant default root load-leaf run offline")
        different: false, true, context("life/server-matrix-scope", "default", "", "offline"), "load-leaf" => failed{"load-leaf"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/server-matrix-scope", "default", "", "offline"), "load-line-count" => ok evidence("load-line-count", "2", "2", true, "case life/server-matrix-scope variant default root load-line-count run offline")
        different: 1, 2, context("life/server-matrix-scope", "default", "", "offline"), "load-line-count" => failed{"load-line-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "invoice_contract::grid_loaded", "invoice_contract::grid_loaded", context("life/server-matrix-scope", "default", "", "offline"), "load-leaf" => ok evidence("load-leaf", "invoice_contract::grid_loaded", "invoice_contract::grid_loaded", true, "case life/server-matrix-scope variant default root load-leaf run offline")
        different: "invoice_contract::grid_loaded_2", "invoice_contract::grid_loaded", context("life/server-matrix-scope", "default", "", "offline"), "load-leaf" => failed{"load-leaf"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("invoice_contract::grid_loaded", "3", "4196.0", "k1", "k2", "invoice_contract::grid_load_forbidden", "op-denied", "invoice_contract::grid_forbidden", "json foreign", "json missing", "json anonymous", "json revoked", "json ghost", "Globex", "tenant", "Acme", "8", "9", "Unsupported Media Type", "Bad Request", "Payload Too Large", 2, 3, 5, 2, 403, 2, 415, 400, 413)
        seed_load_leaf: "seed-load-leaf-drift" => ok observation("invoice_contract::grid_loaded_2", "3", "4196.0", "k1", "k2", "invoice_contract::grid_load_forbidden", "op-denied", "invoice_contract::grid_forbidden", "json foreign", "json missing", "json anonymous", "json revoked", "json ghost", "Globex", "tenant", "Acme", "8", "9", "Unsupported Media Type", "Bad Request", "Payload Too Large", 2, 3, 5, 2, 403, 2, 415, 400, 413)
