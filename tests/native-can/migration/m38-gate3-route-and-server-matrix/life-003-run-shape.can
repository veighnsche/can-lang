package m38life003run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-003 TestGate3ServerMatrix
/// pact media plus outage plus reorder
/// plus swap plus crash legs.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ServerMatrix (L518-899):
/// the pact charset variant commits;
/// a GET body has zero effect;
/// captureless routes 404; a dropped
/// table turns reads plus writes into
/// truthful 503s until restore;
/// keyed reorder persists plus renders
/// new ranks; refused orders 422;
/// served swap policy plus per-rank
/// admission mirror the action pact;
/// SIGKILL legs converge to one
/// ledger effect.
/// Disposition: migrate (this row owns
/// the run shape pact as reviewable
/// Can facts; the old go check stays
/// until the integrator retires it
/// after every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): facet four
/// (L652-725: pact media, GET-body
/// no-effect, missing capture, outage
/// plus recovery), facet five
/// (L727-777: keyed reorder, refused
/// order), facet six (L779-823: served
/// noSwap plus admission) and facet
/// seven (L825-895: SIGKILL converge
/// plus lost ack).
/// ADAPTATION (recorded, with source
/// lines): rank pins hold asserted
/// ranks only; computed revision aims
/// (rev plus one L853, L876; rev L885)
/// stay line-refs; ledger tallies after
/// each crash stay line-refs (L866,
/// L893-894); seats values stay
/// line-refs (2 L565, 1 L635, 6 L747);
/// path cells reuse save grid ids;
/// absence pins (hx-status:200 L821)
/// name the unserved label.
/// charset-media pins
/// application/json; charset=utf-8
/// (L653); charset-revision pins 3
/// (L656); get-body-byte pins x (L694);
/// no-capture-path pins
/// /api/tenants/1/invoices (L698);
/// outage-fault pins drop-lines
/// (L704); outage-leaf pins
/// invoice_contract::grid_unavailable
/// (L706); load-outage-leaf pins
/// invoice_contract::grid_load_unavailable
/// (L711); recovery-revision pins 4
/// (L722); reorder-saved pins saved
/// revision 5 (L742); reorder-first-key
/// pins k2 (L748); reorder-qty pins 7
/// (L748); reorder-details pins
/// Reordered (L747);
/// reorder-first-position pins 0
/// (L748); reorder-second-position pins
/// 1 (L748); bad-order-key pins k9
/// (L765); bad-order-alert pins
/// role equals alert (L770);
/// htmx-mode pins same-origin (L803);
/// admission-403 pins the 403 label
/// (L812); admission-409 pins the 409
/// label (L813); admission-422 pins the
/// 422 label (L814); admission-503 pins
/// the 503 label (L815);
/// redundant-2xx pins hx-status:200
/// (L821); noswap-third pins 4xx
/// (L802); noswap-fourth pins 5xx
/// (L802); converge-op pins op-m11
/// (L830); precrash-op pins op-m12
/// (L873); env-name pins
/// CAN_BUN_ARCHIVE (L520); skip-note
/// pins the staged gate note (L522);
/// snapshot-name pins
/// snapshot-gate3-matrix (L534);
/// helper-serve pins gate3ServeInvoice
/// (L535); port-name pins
/// gate3MatrixPort (L533); outage-status
/// pins int (503) from L705;
/// restore-tables pins int (5) from
/// L716; no-capture-status pins int
/// (404) from L698; bad-order-status
/// pins int (422) from L770;
/// noswap-count pins int (4) from
/// L802-803; noswap-first pins int
/// (204) from L802; noswap-second pins
/// int (304) from L802;
/// converge-retries pins int (3) from
/// L846; converge-effects pins int (1)
/// from L866; timeout-minutes pins int
/// (14) from L525; port-number pins int
/// (18561) from L66.
/// Facet map (leg order):
/// charset-media, charset-revision,
/// get-body-byte, no-capture-path,
/// outage-fault, outage-leaf,
/// load-outage-leaf,
/// recovery-revision, reorder-saved,
/// reorder-first-key, reorder-qty,
/// reorder-details,
/// reorder-first-position,
/// reorder-second-position,
/// bad-order-key, bad-order-alert,
/// htmx-mode, admission-403,
/// admission-409, admission-422,
/// admission-503, redundant-2xx,
/// noswap-third, noswap-fourth,
/// converge-op, precrash-op, env-name,
/// skip-note, snapshot-name,
/// helper-serve, port-name,
/// outage-status, restore-tables,
/// no-capture-status, bad-order-status,
/// noswap-count, noswap-first,
/// noswap-second, converge-retries,
/// converge-effects, timeout-minutes,
/// port-number.
/// The save plus replay legs live in
/// life-003-base-semantics.can; the
/// load plus denial plus refused media
/// legs live in life-003-roots-green.can.
/// Variants: save plus load allow plus
/// deny grids; JSON plus form media and
/// bulk refusals; mid-flight plus
/// lost-ack crashes (this file holds
/// the media plus outage plus reorder
/// plus swap plus crash cells).
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes
/// (pinned names), loopback ports plus
/// disposable SQLite plus a managed
/// server (port plus snapshot plus
/// helper pins; row lists three gates;
/// bind at P23; no live run now).
/// Logical gates BUILD plus DIAG plus
/// DB plus HTTP bind at P23 plus QHTTP
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live fourteen
/// minute hold is pinned here as
/// timeout-minutes; binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates
/// unmet).
/// Case life/server-matrix-run
/// checks: charset-media,
/// charset-revision, get-body-byte,
/// no-capture-path, outage-fault,
/// outage-leaf, load-outage-leaf,
/// recovery-revision, reorder-saved,
/// reorder-first-key, reorder-qty,
/// reorder-details,
/// reorder-first-position,
/// reorder-second-position,
/// bad-order-key, bad-order-alert,
/// htmx-mode, admission-403,
/// admission-409, admission-422,
/// admission-503, redundant-2xx,
/// noswap-third, noswap-fourth,
/// converge-op, precrash-op, env-name,
/// skip-note, snapshot-name,
/// helper-serve, port-name,
/// outage-status, restore-tables,
/// no-capture-status, bad-order-status,
/// noswap-count, noswap-first,
/// noswap-second, converge-retries,
/// converge-effects, timeout-minutes,
/// port-number.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str charset_media
    str charset_revision
    str get_body_byte
    str no_capture_path
    str outage_fault
    str outage_leaf
    str load_outage_leaf
    str recovery_revision
    str reorder_saved
    str reorder_first_key
    str reorder_qty
    str reorder_details
    str reorder_first_position
    str reorder_second_position
    str bad_order_key
    str bad_order_alert
    str htmx_mode
    str admission_403
    str admission_409
    str admission_422
    str admission_503
    str redundant_2xx
    str noswap_third
    str noswap_fourth
    str converge_op
    str precrash_op
    str env_name
    str skip_note
    str snapshot_name
    str helper_serve
    str port_name
    int outage_status
    int restore_tables
    int no_capture_status
    int bad_order_status
    int noswap_count
    int noswap_first
    int noswap_second
    int converge_retries
    int converge_effects
    int timeout_minutes
    int port_number
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/server-matrix-run", "default", "", "offline"), "charset-media" => ok "case life/server-matrix-run variant default root charset-media run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/server-matrix-run", "default", "", "offline"), "charset-media" => ok evidence("charset-media", "true", "true", true, "case life/server-matrix-run variant default root charset-media run offline")
        different: false, true, context("life/server-matrix-run", "default", "", "offline"), "charset-media" => failed{"charset-media"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 503, 503, context("life/server-matrix-run", "default", "", "offline"), "outage-status" => ok evidence("outage-status", "503", "503", true, "case life/server-matrix-run variant default root outage-status run offline")
        different: 502, 503, context("life/server-matrix-run", "default", "", "offline"), "outage-status" => failed{"outage-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "application/json; charset=utf-8", "application/json; charset=utf-8", context("life/server-matrix-run", "default", "", "offline"), "charset-media" => ok evidence("charset-media", "application/json; charset=utf-8", "application/json; charset=utf-8", true, "case life/server-matrix-run variant default root charset-media run offline")
        different: "application/json; charset=utf-8_2", "application/json; charset=utf-8", context("life/server-matrix-run", "default", "", "offline"), "charset-media" => failed{"charset-media"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
