package m38life004base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-004 TestGate3AdapterMatrix
/// route legs: unknown plus wrong-way.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3AdapterMatrix (L909-1192):
/// missing routes answer 404 and
/// wrong-way routes answer 405 with
/// the sorted Allow set, all without
/// handler-entry effect.
/// Disposition: migrate (this row owns
/// the route legs as reviewable Can
/// facts; the old go check stays until
/// the integrator retires it after every
/// linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): facet one route
/// half (L966-1005): four unknown legs
/// plus seven wrong-way legs with path,
/// note, Allow and verdict bytes.
/// ADAPTATION (recorded, with source
/// lines): save-path pins the api save
/// route (L928); form-path pins the form
/// save route (L929); unknown-note-first
/// pins unknown GET (L970);
/// unknown-path-first pins /no-such-path
/// (L970); unknown-note-last pins
/// trailing slash (L973);
/// unknown-suffix-deep pins /extra/deep
/// (L971); unknown-prefix-path pins the
/// prefix without invoice (L972);
/// op-404-body pins the unknown op body
/// (L976); not-found-body pins Not Found
/// (L977); wrong-note-first pins api
/// delete (L988); wrong-note-last pins
/// health post (L994); allow-sorted-pair
/// pins GET, POST (L988);
/// allow-header-name pins Allow (L1001);
/// page-path pins the invoice form page
/// (L992); grid-path pins the grid page
/// (L993); health-path pins /health
/// (L994); op-405-body pins the wrong-way
/// op body (L997); method-not-allowed-body
/// pins Method Not Allowed (L998);
/// unknown-count pins int (4) from
/// L970-973; wrong-method-count pins int
/// (7) from L988-994; status-not-found
/// pins int (404) from L977;
/// status-method-not-allowed pins int (405)
/// from L998. Middle notes (unknown POST,
/// captured prefix note, api put, form
/// get, form delete, page post, grid put)
/// and the POST plus GET singleton Allow
/// sets stay cited at L971-972 plus
/// L989-994, not pinned, to bound the
/// slice.
/// Facet map (leg order): save-path,
/// form-path, unknown-note-first,
/// unknown-path-first, unknown-note-last,
/// unknown-suffix-deep, unknown-prefix-path,
/// op-404-body, not-found-body,
/// wrong-note-first, wrong-note-last,
/// allow-sorted-pair, allow-header-name,
/// page-path, grid-path, health-path,
/// op-405-body, method-not-allowed-body,
/// unknown-count, wrong-method-count,
/// status-not-found,
/// status-method-not-allowed.
/// Capture plus separator plus dot legs live
/// in life-004-roots-green.can; media plus
/// commit plus outage legs and the run
/// frame live in life-004-run-shape.can.
/// Variants: four unknown plus seven
/// wrong-way legs; default plus seeded
/// drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes (row
/// lists three gates; bind at P23; no live
/// run now).
/// Logical gates BUILD plus DIAG plus DB
/// plus HTTP bind at P23 plus QHTTP plus
/// QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fourteen minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates
/// unmet).
/// Case life/adapter-routes-base
/// checks: save-path, form-path,
/// unknown-note-first, unknown-path-first,
/// unknown-note-last, unknown-suffix-deep,
/// unknown-prefix-path, op-404-body,
/// not-found-body, wrong-note-first,
/// wrong-note-last, allow-sorted-pair,
/// allow-header-name, page-path, grid-path,
/// health-path, op-405-body,
/// method-not-allowed-body, unknown-count,
/// wrong-method-count, status-not-found,
/// status-method-not-allowed.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str save_path
    str form_path
    str unknown_note_first
    str unknown_path_first
    str unknown_note_last
    str unknown_suffix_deep
    str unknown_prefix_path
    str op_404_body
    str not_found_body
    str wrong_note_first
    str wrong_note_last
    str allow_sorted_pair
    str allow_header_name
    str page_path
    str grid_path
    str health_path
    str op_405_body
    str method_not_allowed_body
    int unknown_count
    int wrong_method_count
    int status_not_found
    int status_method_not_allowed
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/adapter-routes-base", "default", "", "offline"), "save-path" => ok "case life/adapter-routes-base variant default root save-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/adapter-routes-base", "default", "", "offline"), "save-path" => ok evidence("save-path", "true", "true", true, "case life/adapter-routes-base variant default root save-path run offline")
        different: false, true, context("life/adapter-routes-base", "default", "", "offline"), "save-path" => failed{"save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("life/adapter-routes-base", "default", "", "offline"), "unknown-count" => ok evidence("unknown-count", "4", "4", true, "case life/adapter-routes-base variant default root unknown-count run offline")
        different: 3, 4, context("life/adapter-routes-base", "default", "", "offline"), "unknown-count" => failed{"unknown-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", context("life/adapter-routes-base", "default", "", "offline"), "save-path" => ok evidence("save-path", "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", true, "case life/adapter-routes-base variant default root save-path run offline")
        different: "/api/tenants/1/invoices/7_2", "/api/tenants/1/invoices/7", context("life/adapter-routes-base", "default", "", "offline"), "save-path" => failed{"save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("/api/tenants/1/invoices/7", "/tenants/1/invoices/7", "unknown GET", "/no-such-path", "trailing slash", "/extra/deep", "/api/tenants/1/invoices", "{\"operation_id\":\"op-404\"}", "Not Found", "api delete", "health post", "GET, POST", "Allow", "/invoices/form?tenant_id=1&invoice_id=7", "/invoice-grid?tenant=1&invoice=7", "/health", "{\"operation_id\":\"op-405\"}", "Method Not Allowed", 4, 7, 404, 405)
        seed_save_path: "seed-save-path-drift" => ok observation("/api/tenants/1/invoices/7_2", "/tenants/1/invoices/7", "unknown GET", "/no-such-path", "trailing slash", "/extra/deep", "/api/tenants/1/invoices", "{\"operation_id\":\"op-404\"}", "Not Found", "api delete", "health post", "GET, POST", "Allow", "/invoices/form?tenant_id=1&invoice_id=7", "/invoice-grid?tenant=1&invoice=7", "/health", "{\"operation_id\":\"op-405\"}", "Method Not Allowed", 4, 7, 404, 405)
