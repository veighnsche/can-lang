package m38life004roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-004 TestGate3AdapterMatrix
/// guard legs: captures plus separator
/// plus dot plus media plus budget.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3AdapterMatrix (L909-1192):
/// malformed captures fail at 400, coded
/// separators and dot parts never land in
/// a handler as data, and media plus
/// budget failures stay ahead of any
/// guarded effect.
/// Disposition: migrate (this row owns
/// the guard legs as reviewable Can
/// facts; the old go check stays until
/// the integrator retires it after every
/// linked row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): facet one
/// capture plus separator plus dot legs
/// (L1007-1054) and facet two freight
/// legs (L1056-1077).
/// ADAPTATION (recorded, with source
/// lines): capture-path-padded-tenant pins
/// the 01 tenant path (L1011);
/// capture-path-alpha-tenant pins the x
/// tenant path (L1012);
/// capture-path-padded-invoice pins the
/// 007 invoice path (L1013);
/// capture-path-suffixed-invoice pins the
/// 7x invoice path (L1014); op-cap-body
/// pins the capture op body (L1017);
/// bad-request-body pins Bad Request
/// (L1018); separator-path pins the coded
/// cut path (L1028); climb-request-head
/// pins the raw climb head (L1038);
/// climb-leaf pins the forbidden leaf
/// (L1044); self-request-head pins the
/// raw self-dot head (L1049); json-media
/// pins the json media word (L976);
/// plain-media pins the plain media word
/// (L1064); form-media pins the form media
/// word (L1068); malformed-json-body pins
/// not json (L1065); unsupported-media-body
/// pins Unsupported Media Type (L1064);
/// payload-too-large-body pins Payload Too
/// Large (L1066); repeat-call pins the pad
/// call word (L1066); transport-note-first
/// pins json bad media (L1064);
/// transport-note-last pins form oversize
/// (L1068); capture-count pins int (4)
/// from L1011-1014; status-bad-request
/// pins int (400) from L1018;
/// status-unsupported-media pins int (415)
/// from L1064; status-payload-too-large
/// pins int (413) from L1066;
/// json-byte-limit pins int (8192) from
/// L1057; form-byte-limit pins int (2048)
/// from L1057; declared-row-limit pins int
/// (64) from L1058; json-pad-count pins
/// int (9000) from L1066; form-pad-count
/// pins int (4096) from L1068;
/// transport-leg-count pins int (5) from
/// L1064-1068. Middle freight notes (json
/// malformed, json oversize, form bad
/// media) and the op-t1 plus op-t2 plus
/// op-t3 leg ids stay cited at L1064-1067,
/// not pinned, to bound the slice. The
/// plain media value holds a shared
/// substring with the Can word family; it
/// is pinned verbatim inside quotes and
/// the stray-word audit strips quoted
/// spans before judging code words.
/// Facet map (leg order):
/// capture-path-padded-tenant,
/// capture-path-alpha-tenant,
/// capture-path-padded-invoice,
/// capture-path-suffixed-invoice,
/// op-cap-body, bad-request-body,
/// separator-path, climb-request-head,
/// climb-leaf, self-request-head,
/// json-media, plain-media, form-media,
/// malformed-json-body,
/// unsupported-media-body,
/// payload-too-large-body, repeat-call,
/// transport-note-first, transport-note-last,
/// capture-count, status-bad-request,
/// status-unsupported-media,
/// status-payload-too-large, json-byte-limit,
/// form-byte-limit, declared-row-limit,
/// json-pad-count, form-pad-count,
/// transport-leg-count.
/// Unknown plus wrong-way legs live in
/// life-004-base-semantics.can; missing
/// media plus row flood plus commit plus
/// outage legs and the run frame live in
/// life-004-run-shape.can.
/// Variants: four captures plus three dot
/// parts plus five freight legs; default
/// plus seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes (row
/// lists three gates; bind at P23; no live
/// run now).
/// Logical gates BUILD plus DIAG plus DB
/// plus HTTP bind at P23 plus QHTTP plus
/// QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fourteen minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates
/// unmet).
/// Case life/adapter-guards-roots
/// checks: capture-path-padded-tenant,
/// capture-path-alpha-tenant,
/// capture-path-padded-invoice,
/// capture-path-suffixed-invoice,
/// op-cap-body, bad-request-body,
/// separator-path, climb-request-head,
/// climb-leaf, self-request-head,
/// json-media, plain-media, form-media,
/// malformed-json-body,
/// unsupported-media-body,
/// payload-too-large-body, repeat-call,
/// transport-note-first, transport-note-last,
/// capture-count, status-bad-request,
/// status-unsupported-media,
/// status-payload-too-large, json-byte-limit,
/// form-byte-limit, declared-row-limit,
/// json-pad-count, form-pad-count,
/// transport-leg-count.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str capture_path_padded_tenant
    str capture_path_alpha_tenant
    str capture_path_padded_invoice
    str capture_path_suffixed_invoice
    str op_cap_body
    str bad_request_body
    str separator_path
    str climb_request_head
    str climb_leaf
    str self_request_head
    str json_media
    str plain_media
    str form_media
    str malformed_json_body
    str unsupported_media_body
    str payload_too_large_body
    str repeat_call
    str transport_note_first
    str transport_note_last
    int capture_count
    int status_bad_request
    int status_unsupported_media
    int status_payload_too_large
    int json_byte_limit
    int form_byte_limit
    int declared_row_limit
    int json_pad_count
    int form_pad_count
    int transport_leg_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/adapter-guards-roots", "default", "", "offline"), "capture-path-padded-tenant" => ok "case life/adapter-guards-roots variant default root capture-path-padded-tenant run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/adapter-guards-roots", "default", "", "offline"), "capture-path-padded-tenant" => ok evidence("capture-path-padded-tenant", "true", "true", true, "case life/adapter-guards-roots variant default root capture-path-padded-tenant run offline")
        different: false, true, context("life/adapter-guards-roots", "default", "", "offline"), "capture-path-padded-tenant" => failed{"capture-path-padded-tenant"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("life/adapter-guards-roots", "default", "", "offline"), "capture-count" => ok evidence("capture-count", "4", "4", true, "case life/adapter-guards-roots variant default root capture-count run offline")
        different: 3, 4, context("life/adapter-guards-roots", "default", "", "offline"), "capture-count" => failed{"capture-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/api/tenants/01/invoices/7", "/api/tenants/01/invoices/7", context("life/adapter-guards-roots", "default", "", "offline"), "capture-path-padded-tenant" => ok evidence("capture-path-padded-tenant", "/api/tenants/01/invoices/7", "/api/tenants/01/invoices/7", true, "case life/adapter-guards-roots variant default root capture-path-padded-tenant run offline")
        different: "/api/tenants/01/invoices/7_2", "/api/tenants/01/invoices/7", context("life/adapter-guards-roots", "default", "", "offline"), "capture-path-padded-tenant" => failed{"capture-path-padded-tenant"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("/api/tenants/01/invoices/7", "/api/tenants/x/invoices/7", "/tenants/1/invoices/007", "/tenants/1/invoices/7x", "{\"operation_id\":\"op-cap\"}", "Bad Request", "/api/tenants/1%2F2/invoices/7", "GET /api/tenants/1/invoices/7/../8 HTTP/1.1", "invoice_contract::grid_load_forbidden", "GET /api/tenants/./1/invoices/7 HTTP/1.1", "application/json", "text/plain", "application/x-www-form-urlencoded", "not json", "Unsupported Media Type", "Payload Too Large", "strings.Repeat", "json bad media", "form oversize", 4, 400, 415, 413, 8192, 2048, 64, 9000, 4096, 5)
