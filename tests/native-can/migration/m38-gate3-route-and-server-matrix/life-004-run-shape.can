package m38life004run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M38 LIFE-004 TestGate3AdapterMatrix
/// commit legs plus outage plus run
/// frame: missing media plus row flood
/// plus control plus abandoned plus
/// drop-replay plus environment.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3AdapterMatrix (L909-1192):
/// a missing media word fails on both
/// paths, sixty-five keyed rows trip the
/// 422 row cap, one valid save lands
/// revision 2, a fully written
/// disconnected save still commits once
/// with stable replay bytes and
/// conflicting edits, and a dropped
/// replay store fails truthfully at 503
/// with no revision move before the
/// restored retry commits revision 4.
/// Disposition: migrate (this row owns
/// the commit plus outage legs as
/// reviewable Can facts; the old go check
/// stays until the integrator retires it
/// after every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): facet two tail
/// (L1078-1101), facet three commit plus
/// replay legs (L1103-1151), facet four
/// outage plus restore legs (L1153-1191),
/// and the run frame (L909-964 plus
/// L68).
/// ADAPTATION (recorded, with source
/// lines): missing-media-op pins op-t4
/// (L1081); rows-rejected-fragment pins
/// the rejected form words (L1098);
/// rows-alert-fragment pins the alert role
/// (L1098); rows-limit-fragment pins
/// row_limit (L1098); control-op pins
/// op-a1 (L1106); control-revision pins
/// 2 (L1110); abandoned-op pins op-a2
/// (L1115); abandoned-revision pins 3
/// (L1135); recovered-revision pins 4
/// (L1180); changed-line-id pins changed
/// (L1146); drop-fault-name pins
/// drop-replay (L1157); drop-op pins
/// op-a3 (L1158); unavailable-leaf pins
/// the unavailable leaf (L1162);
/// saved-leaf pins the saved leaf (L1178);
/// restore-script pins schema.sql (L1167);
/// env-name pins CAN_BUN_ARCHIVE (L911);
/// skip-note pins the skip words (L913);
/// session-value pins tok-alice (L976);
/// missing-media-leg-count pins int (2)
/// from L1079; row-budget-count pins int
/// (65) from L1093; status-unprocessable
/// pins int (422) from L1098;
/// status-conflict pins int (409) from
/// L1148; status-unavailable pins int
/// (503) from L1159; status-ok pins int
/// (200) from L1107; restore-table-count
/// pins int (5) from L1171;
/// timeout-minutes pins int (14) from
/// L916; adapter-port pins int (18571)
/// from L68; one-entry-count pins int (1)
/// from the L1110 call tally;
/// ledger-excerpt-length pins int (19),
/// the unquoted rune tally of the L1135
/// ledger row.
/// Facet map (leg order): missing-media-op,
/// rows-rejected-fragment,
/// rows-alert-fragment, rows-limit-fragment,
/// control-op, control-revision,
/// abandoned-op, abandoned-revision,
/// recovered-revision, changed-line-id,
/// drop-fault-name, drop-op,
/// unavailable-leaf, saved-leaf,
/// restore-script, env-name, skip-note,
/// session-value, missing-media-leg-count,
/// row-budget-count, status-unprocessable,
/// status-conflict, status-unavailable,
/// status-ok, restore-table-count,
/// timeout-minutes, adapter-port,
/// one-entry-count, ledger-excerpt-length.
/// Unknown plus wrong-way legs live in
/// life-004-base-semantics.can; capture
/// plus separator plus dot plus media
/// plus budget legs live in
/// life-004-roots-green.can.
/// Variants: two missing media legs plus
/// the 65-row flood plus one control save
/// plus one abandoned save plus one
/// outage plus one retry; default plus
/// seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes plus
/// loopback ports plus throwaway SQLite
/// plus a kept server plus an fd-3
/// snapshot (row lists three gates; bind
/// at P23; no live run now).
/// Logical gates BUILD plus DIAG plus DB
/// plus HTTP bind at P23 plus QHTTP plus
/// QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fourteen minute hold is
/// pinned above as timeout-minutes; binds
/// at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates
/// unmet).
/// Case life/adapter-commit-run
/// checks: missing-media-op,
/// rows-rejected-fragment,
/// rows-alert-fragment, rows-limit-fragment,
/// control-op, control-revision,
/// abandoned-op, abandoned-revision,
/// recovered-revision, changed-line-id,
/// drop-fault-name, drop-op,
/// unavailable-leaf, saved-leaf,
/// restore-script, env-name, skip-note,
/// session-value, missing-media-leg-count,
/// row-budget-count, status-unprocessable,
/// status-conflict, status-unavailable,
/// status-ok, restore-table-count,
/// timeout-minutes, adapter-port,
/// one-entry-count, ledger-excerpt-length.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str missing_media_op
    str rows_rejected_fragment
    str rows_alert_fragment
    str rows_limit_fragment
    str control_op
    str control_revision
    str abandoned_op
    str abandoned_revision
    str recovered_revision
    str changed_line_id
    str drop_fault_name
    str drop_op
    str unavailable_leaf
    str saved_leaf
    str restore_script
    str env_name
    str skip_note
    str session_value
    int missing_media_leg_count
    int row_budget_count
    int status_unprocessable
    int status_conflict
    int status_unavailable
    int status_ok
    int restore_table_count
    int timeout_minutes
    int adapter_port
    int one_entry_count
    int ledger_excerpt_length
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/adapter-commit-run", "default", "", "offline"), "missing-media-op" => ok "case life/adapter-commit-run variant default root missing-media-op run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/adapter-commit-run", "default", "", "offline"), "missing-media-op" => ok evidence("missing-media-op", "true", "true", true, "case life/adapter-commit-run variant default root missing-media-op run offline")
        different: false, true, context("life/adapter-commit-run", "default", "", "offline"), "missing-media-op" => failed{"missing-media-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/adapter-commit-run", "default", "", "offline"), "missing-media-leg-count" => ok evidence("missing-media-leg-count", "2", "2", true, "case life/adapter-commit-run variant default root missing-media-leg-count run offline")
        different: 1, 2, context("life/adapter-commit-run", "default", "", "offline"), "missing-media-leg-count" => failed{"missing-media-leg-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "op-t4", "op-t4", context("life/adapter-commit-run", "default", "", "offline"), "missing-media-op" => ok evidence("missing-media-op", "op-t4", "op-t4", true, "case life/adapter-commit-run variant default root missing-media-op run offline")
        different: "op-t4_2", "op-t4", context("life/adapter-commit-run", "default", "", "offline"), "missing-media-op" => failed{"missing-media-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("op-t4", "invoice form rejected", "role=\"alert\"", "row_limit", "op-a1", "2", "op-a2", "3", "4", "changed", "drop-replay", "op-a3", "invoice_contract::grid_unavailable", "invoice_contract::grid_saved", "schema.sql", "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for staged gate 3 execution", "tok-alice", 2, 65, 422, 409, 503, 200, 5, 14, 18571, 1, 19)
        seed_missing_media_op: "seed-missing-media-op-drift" => ok observation("op-t4_2", "invoice form rejected", "role=\"alert\"", "row_limit", "op-a1", "2", "op-a2", "3", "4", "changed", "drop-replay", "op-a3", "invoice_contract::grid_unavailable", "invoice_contract::grid_saved", "schema.sql", "CAN_BUN_ARCHIVE", "set CAN_BUN_ARCHIVE for staged gate 3 execution", "tok-alice", 2, 65, 422, 409, 503, 200, 5, 14, 18571, 1, 19)
