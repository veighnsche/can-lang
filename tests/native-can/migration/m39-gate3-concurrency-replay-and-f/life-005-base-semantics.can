        seed_race_save_path: "seed-race-save-path-drift" => ok observation("/api/tenants/1/invoices/7_2", "tok-alice", "op-r", "want 200 once and 409 else", "revision race winner", "invoice_contract::grid_saved", "op-same", "want 200 or one 503 retry", "identical converge: %d %s, want 200", "identical race converged to differing bytes", "identical race", 8, 200, 409, 1, 7, 2, 1, 6, 200, 503, 3, 2)
