package m39life005base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-005 TestGate3Concurrency
/// revision plus identical races.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3Concurrency (L1232-1471) plus
/// race helper span (L1194-1224) plus race port
/// (L69): eight distinct ops racing one base
/// revision must land one 200 plus seven 409s,
/// and six identical ops must converge to one
/// shared effect with byte-identical 200s after
/// at most one 503 slip. Disposition: migrate
/// (this row owns the race pacts as reviewable
/// Can facts; the old go check stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence). Protects (this file): facet one
/// (L1283-1319): one winner plus seven conflicts
/// on one base revision, plus facet two
/// (L1321-1361): six identical racers converging
/// to one shared effect. ADAPTATION (recorded,
/// with source lines): path pins hold the save
/// URL; login pins hold the racing login; op pins
/// hold op id heads; guard pins hold want lines;
/// note pins hold case notes; tag pins hold leaf
/// tags; count pins hold ints tallied from loops
/// plus guards.
/// Pin lines: race-save-path L1250, race-session
/// L1264, distinct-op-prefix L1287,
/// distinct-want-guard L1300, distinct-note
/// L1306, distinct-tag L1306, identical-op L1327,
/// identical-want-guard L1332, converge-guard
/// L1339, differ-guard L1345, identical-note
/// L1348, distinct-race-size L1286,
/// distinct-winner-status L1294,
/// distinct-conflict-status L1297,
/// distinct-winner-count L1303,
/// distinct-conflict-count L1303,
/// distinct-winner-revision L1308,
/// distinct-ledger-rows L1316,
/// identical-race-size L1326, identical-ok-status
/// L1331, identical-transient-status L1331,
/// identical-revision L1350,
/// identical-ledger-rows L1358.
/// Facet map (leg order): race-save-path,
/// race-session, distinct-op-prefix,
/// distinct-want-guard, distinct-note,
/// distinct-tag, identical-op,
/// identical-want-guard, converge-guard,
/// differ-guard, identical-note,
/// distinct-race-size, distinct-winner-status,
/// distinct-conflict-status,
/// distinct-winner-count,
/// distinct-conflict-count,
/// distinct-winner-revision,
/// distinct-ledger-rows, identical-race-size,
/// identical-ok-status,
/// identical-transient-status,
/// identical-revision, identical-ledger-rows.
/// Siblings: revision plus identical races live
/// in life-005-base-semantics.can; membership
/// plus flap legs live in
/// life-005-roots-green.can; barrier plus harness
/// shape lives in life-005-run-shape.can.
/// Variants: eight distinct, six identical,
/// membership absent plus restored plus flapping;
/// default plus seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a staged
/// bundle plus cut-off homes plus loopback plus
/// disposable SQLite (row lists three gates; bind
/// at P23; no live run now).
/// Logical gates HTTP plus DB plus D1 plus D2
/// bind at P23 plus QHTTP plus QD1 plus QD2; no
/// live run now.
/// Timeout 120000ms is the offline default bound
/// (the live fourteen minute hold is pinned in
/// the run slice; binds at P23 like the M38
/// no-run rows).
/// Delegated oracles: none. Execution credit: NOT
/// claimed (P23 plus QHTTP plus QD1 plus QD2
/// accept gates unmet).
/// Case life/concurrency-races checks:
/// race-save-path, race-session,
/// distinct-op-prefix, distinct-want-guard,
/// distinct-note, distinct-tag, identical-op,
/// identical-want-guard, converge-guard,
/// differ-guard, identical-note,
/// distinct-race-size, distinct-winner-status,
/// distinct-conflict-status,
/// distinct-winner-count,
/// distinct-conflict-count,
/// distinct-winner-revision,
/// distinct-ledger-rows, identical-race-size,
/// identical-ok-status,
/// identical-transient-status,
/// identical-revision, identical-ledger-rows.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str race_save_path
    str race_session
    str distinct_op_prefix
    str distinct_want_guard
    str distinct_note
    str distinct_tag
    str identical_op
    str identical_want_guard
    str converge_guard
    str differ_guard
    str identical_note
    int distinct_race_size
    int distinct_winner_status
    int distinct_conflict_status
    int distinct_winner_count
    int distinct_conflict_count
    int distinct_winner_revision
    int distinct_ledger_rows
    int identical_race_size
    int identical_ok_status
    int identical_transient_status
    int identical_revision
    int identical_ledger_rows
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/concurrency-races", "default", "", "offline"), "race-save-path" => ok "case life/concurrency-races variant default root race-save-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/concurrency-races", "default", "", "offline"), "race-save-path" => ok evidence("race-save-path", "true", "true", true, "case life/concurrency-races variant default root race-save-path run offline")
        different: false, true, context("life/concurrency-races", "default", "", "offline"), "race-save-path" => failed{"race-save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 8, 8, context("life/concurrency-races", "default", "", "offline"), "distinct-race-size" => ok evidence("distinct-race-size", "8", "8", true, "case life/concurrency-races variant default root distinct-race-size run offline")
        different: 7, 8, context("life/concurrency-races", "default", "", "offline"), "distinct-race-size" => failed{"distinct-race-size"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", context("life/concurrency-races", "default", "", "offline"), "race-save-path" => ok evidence("race-save-path", "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", true, "case life/concurrency-races variant default root race-save-path run offline")
        different: "/api/tenants/1/invoices/7_2", "/api/tenants/1/invoices/7", context("life/concurrency-races", "default", "", "offline"), "race-save-path" => failed{"race-save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
