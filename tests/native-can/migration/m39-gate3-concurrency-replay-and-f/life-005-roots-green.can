package m39life005roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-005 TestGate3Concurrency
/// membership plus flap legs.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3Concurrency (L1232-1471) plus
/// race helper span (L1194-1224) plus race port
/// (L69): removing the alice row must deny saves
/// plus loads at 403 without disclosure,
/// restoring it must admit a save, and a
/// membership flap racing eight saves must permit
/// at most one coherent authorized commit with
/// matching ledger plus revision while a fresh op
/// on the landed revision commits. Disposition:
/// migrate (this row owns the membership pacts as
/// reviewable Can facts; the old go check stays
/// until the integrator retires it after every
/// linked row, variant, environment and control
/// has accepted evidence). Protects (this file):
/// facet three (L1363-1391): denial without
/// disclosure plus restore, plus facet four
/// (L1393-1469): flap race coherence plus the
/// fresh-op recovery control. ADAPTATION
/// (recorded, with source lines): call pins hold
/// membership mutation calls; op pins hold op
/// ids; note pins hold case notes; tag pins hold
/// leaf tags; guard pins hold want plus
/// disclosure lines; mode pins hold flap modes;
/// count pins hold ints tallied from loops plus
/// guards.
/// Pin lines: unmember-call L1365, unmembered-op
/// L1366, unmembered-save-note L1370,
/// unmembered-save-tag L1370,
/// unmembered-save-guard L1372,
/// unmembered-load-note L1378,
/// unmembered-load-tag L1378, member-call L1382,
/// restored-op L1383, restored-note L1387,
/// restored-tag L1387, flap-mode-off L1400,
/// flap-mode-on L1400, flap-op-prefix L1411,
/// flap-denial-note L1427, flap-denial-guard
/// L1429, flap-conflict-note L1432,
/// flap-conflict-tag L1432, flap-race-guard
/// L1434, flap-winner-note L1442, fresh-op L1461,
/// post-flap-note L1465, denied-status L1367,
/// denied-value-fields L1371, restored-status
/// L1384, restored-revision L1389, flap-rounds
/// L1399, flap-modes L1400, flap-race-size L1410,
/// flap-conflict-status L1431, flap-max-commits
/// L1437, flap-winner-revision L1444,
/// flap-quiet-revision L1448, flap-base-ledger
/// L1452.
/// Facet map (leg order): unmember-call,
/// unmembered-op, unmembered-save-note,
/// unmembered-save-tag, unmembered-save-guard,
/// unmembered-load-note, unmembered-load-tag,
/// member-call, restored-op, restored-note,
/// restored-tag, flap-mode-off, flap-mode-on,
/// flap-op-prefix, flap-denial-note,
/// flap-denial-guard, flap-conflict-note,
/// flap-conflict-tag, flap-race-guard,
/// flap-winner-note, fresh-op, post-flap-note,
/// denied-status, denied-value-fields,
/// restored-status, restored-revision,
/// flap-rounds, flap-modes, flap-race-size,
/// flap-conflict-status, flap-max-commits,
/// flap-winner-revision, flap-quiet-revision,
/// flap-base-ledger.
/// Siblings: revision plus identical races live
/// in life-005-base-semantics.can; membership
/// plus flap legs live in
/// life-005-roots-green.can; barrier plus harness
/// shape lives in life-005-run-shape.can.
/// Variants: eight distinct, six identical,
/// membership absent plus restored plus flapping;
/// default plus seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a staged
/// bundle plus cut-off homes plus loopback plus
/// disposable SQLite (row lists three gates; bind
/// at P23; no live run now).
/// Logical gates HTTP plus DB plus D1 plus D2
/// bind at P23 plus QHTTP plus QD1 plus QD2; no
/// live run now.
/// Timeout 120000ms is the offline default bound
/// (the live fourteen minute hold is pinned in
/// the run slice; binds at P23 like the M38
/// no-run rows).
/// Delegated oracles: none. Execution credit: NOT
/// claimed (P23 plus QHTTP plus QD1 plus QD2
/// accept gates unmet).
/// Case life/concurrency-membership checks:
/// unmember-call, unmembered-op,
/// unmembered-save-note, unmembered-save-tag,
/// unmembered-save-guard, unmembered-load-note,
/// unmembered-load-tag, member-call, restored-op,
/// restored-note, restored-tag, flap-mode-off,
/// flap-mode-on, flap-op-prefix,
/// flap-denial-note, flap-denial-guard,
/// flap-conflict-note, flap-conflict-tag,
/// flap-race-guard, flap-winner-note, fresh-op,
/// post-flap-note, denied-status,
/// denied-value-fields, restored-status,
/// restored-revision, flap-rounds, flap-modes,
/// flap-race-size, flap-conflict-status,
/// flap-max-commits, flap-winner-revision,
/// flap-quiet-revision, flap-base-ledger.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str unmember_call
    str unmembered_op
    str unmembered_save_note
    str unmembered_save_tag
    str unmembered_save_guard
    str unmembered_load_note
    str unmembered_load_tag
    str member_call
    str restored_op
    str restored_note
    str restored_tag
    str flap_mode_off
    str flap_mode_on
    str flap_op_prefix
    str flap_denial_note
    str flap_denial_guard
    str flap_conflict_note
    str flap_conflict_tag
    str flap_race_guard
    str flap_winner_note
    str fresh_op
    str post_flap_note
    int denied_status
    int denied_value_fields
    int restored_status
    int restored_revision
    int flap_rounds
    int flap_modes
    int flap_race_size
    int flap_conflict_status
    int flap_max_commits
    int flap_winner_revision
    int flap_quiet_revision
    int flap_base_ledger
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/concurrency-membership", "default", "", "offline"), "unmember-call" => ok "case life/concurrency-membership variant default root unmember-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/concurrency-membership", "default", "", "offline"), "unmember-call" => ok evidence("unmember-call", "true", "true", true, "case life/concurrency-membership variant default root unmember-call run offline")
        different: false, true, context("life/concurrency-membership", "default", "", "offline"), "unmember-call" => failed{"unmember-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 403, 403, context("life/concurrency-membership", "default", "", "offline"), "denied-status" => ok evidence("denied-status", "403", "403", true, "case life/concurrency-membership variant default root denied-status run offline")
        different: 402, 403, context("life/concurrency-membership", "default", "", "offline"), "denied-status" => failed{"denied-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "db, \"alice\", \"1\", false", "db, \"alice\", \"1\", false", context("life/concurrency-membership", "default", "", "offline"), "unmember-call" => ok evidence("unmember-call", "db, \"alice\", \"1\", false", "db, \"alice\", \"1\", false", true, "case life/concurrency-membership variant default root unmember-call run offline")
        different: "db, \"alice\", \"1\", false_2", "db, \"alice\", \"1\", false", context("life/concurrency-membership", "default", "", "offline"), "unmember-call" => failed{"unmember-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
