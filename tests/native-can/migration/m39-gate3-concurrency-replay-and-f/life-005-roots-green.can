        default: "default" => ok observation("db, \"alice\", \"1\", false", "op-u1", "unmembered save", "invoice_contract::grid_forbidden", "unmembered save value %+v discloses or mismatches", "unmembered load", "invoice_contract::grid_load_forbidden", "db, \"alice\", \"1\", true", "op-u2", "restored save", "invoice_contract::grid_saved", "unmember", "member", "op-f", "flap denial ", "flap denial value %+v discloses or mismatches", "flap conflict ", "invoice_contract::grid_conflict", "want 200, 403 or 409", "flap winner", "op-fresh", "post-flap save", 403, 2, 200, 4, 4, 2, 8, 409, 1, 5, 4, 3)
