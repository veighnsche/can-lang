package m39life005run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-005 TestGate3Concurrency
/// barrier plus harness shape.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3Concurrency (L1232-1471) plus
/// race helper span (L1194-1224) plus race port
/// (L69): barrier-started racers share one start
/// chan plus one wait group, the run gates on
/// CAN_BUN_ARCHIVE with a staged bundle plus
/// cut-off homes plus loopback plus disposable
/// SQLite, and the invoice driver waits out
/// contended locks with member plus unmember
/// mutation modes. Disposition: migrate (this row
/// owns the run-shape pacts as reviewable Can
/// facts; the old go check stays until the
/// integrator retires it after every linked row,
/// variant, environment and control has accepted
/// evidence). Protects (this file): the race
/// helper plus barrier shape (L1194-1270), the
/// harness plus env shape (L1232-1252), the row
/// plus ledger observation helpers, and the
/// driver modes (driver.ts). ADAPTATION
/// (recorded, with source lines): helper pins
/// hold helper names; barrier pins hold chan plus
/// group plus close spellings; env pins hold the
/// archive var plus skip note; driver pins hold
/// driver.ts mode plus guard lines; count pins
/// hold ints tallied from consts plus loops plus
/// call counts.
/// Pin lines: race-struct L1195, race-helper
/// L1201, opid-marker L1203, client-timeout
/// L1207, race-failure-guard L1210, media-json
/// L1212, cookie-name L1215, test-decl L1232,
/// env-name L1234, skip-note L1236, timeout-call
/// L1239, helper-harness L1241, helper-stage
/// L1245, helper-seed L1246, helper-serve L1247,
/// race-port-name L1247, origin-host L1249,
/// lines-fragment L1252, barrier-chan L1256,
/// barrier-group L1258, barrier-close L1267,
/// helper-inspect L1273, invoice-row-guard L1275,
/// helper-replay L1315, converge-loop L1336,
/// helper-flap L1401, summary-note L1470,
/// driver-busy-guard D49, driver-member-mode
/// D176, driver-unmember-mode D182,
/// timeout-minutes L1239, race-port L69,
/// client-timeout-secs L1207, flap-chan-cap
/// L1397, race-call-count L1289, gate3case-count
/// L1306.
/// Facet map (leg order): race-struct,
/// race-helper, opid-marker, client-timeout,
/// race-failure-guard, media-json, cookie-name,
/// test-decl, env-name, skip-note, timeout-call,
/// helper-harness, helper-stage, helper-seed,
/// helper-serve, race-port-name, origin-host,
/// lines-fragment, barrier-chan, barrier-group,
/// barrier-close, helper-inspect,
/// invoice-row-guard, helper-replay,
/// converge-loop, helper-flap, summary-note,
/// driver-busy-guard, driver-member-mode,
/// driver-unmember-mode, timeout-minutes,
/// race-port, client-timeout-secs, flap-chan-cap,
/// race-call-count, gate3case-count.
/// Siblings: revision plus identical races live
/// in life-005-base-semantics.can; membership
/// plus flap legs live in
/// life-005-roots-green.can; barrier plus harness
/// shape lives in life-005-run-shape.can.
/// Variants: eight distinct, six identical,
/// membership absent plus restored plus flapping;
/// default plus seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a staged
/// bundle plus cut-off homes plus loopback plus
/// disposable SQLite (row lists three gates; bind
/// at P23; no live run now).
/// Logical gates HTTP plus DB plus D1 plus D2
/// bind at P23 plus QHTTP plus QD1 plus QD2; no
/// live run now.
/// Timeout 120000ms is the offline default bound
/// (the live fourteen minute hold is pinned in
/// the run slice; binds at P23 like the M38
/// no-run rows).
/// Delegated oracles: none. Execution credit: NOT
/// claimed (P23 plus QHTTP plus QD1 plus QD2
/// accept gates unmet).
/// Case life/concurrency-run checks: race-struct,
/// race-helper, opid-marker, client-timeout,
/// race-failure-guard, media-json, cookie-name,
/// test-decl, env-name, skip-note, timeout-call,
/// helper-harness, helper-stage, helper-seed,
/// helper-serve, race-port-name, origin-host,
/// lines-fragment, barrier-chan, barrier-group,
/// barrier-close, helper-inspect,
/// invoice-row-guard, helper-replay,
/// converge-loop, helper-flap, summary-note,
/// driver-busy-guard, driver-member-mode,
/// driver-unmember-mode, timeout-minutes,
/// race-port, client-timeout-secs, flap-chan-cap,
/// race-call-count, gate3case-count.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str race_struct
    str race_helper
    str opid_marker
    str client_timeout
    str race_failure_guard
    str media_json
    str cookie_name
    str test_decl
    str env_name
    str skip_note
    str timeout_call
    str helper_harness
    str helper_stage
    str helper_seed
    str helper_serve
    str race_port_name
    str origin_host
    str lines_fragment
    str barrier_chan
    str barrier_group
    str barrier_close
    str helper_inspect
    str invoice_row_guard
    str helper_replay
    str converge_loop
    str helper_flap
    str summary_note
    str driver_busy_guard
    str driver_member_mode
    str driver_unmember_mode
    int timeout_minutes
    int race_port
    int client_timeout_secs
    int flap_chan_cap
    int race_call_count
    int gate3case_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/concurrency-run", "default", "", "offline"), "race-struct" => ok "case life/concurrency-run variant default root race-struct run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/concurrency-run", "default", "", "offline"), "race-struct" => ok evidence("race-struct", "true", "true", true, "case life/concurrency-run variant default root race-struct run offline")
        different: false, true, context("life/concurrency-run", "default", "", "offline"), "race-struct" => failed{"race-struct"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 14, 14, context("life/concurrency-run", "default", "", "offline"), "timeout-minutes" => ok evidence("timeout-minutes", "14", "14", true, "case life/concurrency-run variant default root timeout-minutes run offline")
        different: 13, 14, context("life/concurrency-run", "default", "", "offline"), "timeout-minutes" => failed{"timeout-minutes"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "gate3RacePost", "gate3RacePost", context("life/concurrency-run", "default", "", "offline"), "race-struct" => ok evidence("race-struct", "gate3RacePost", "gate3RacePost", true, "case life/concurrency-run variant default root race-struct run offline")
        different: "gate3RacePost_2", "gate3RacePost", context("life/concurrency-run", "default", "", "offline"), "race-struct" => failed{"race-struct"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
