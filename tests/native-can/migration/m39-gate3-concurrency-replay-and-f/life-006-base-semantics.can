package m39life006base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-006 TestGate3ReplayExpiry
/// revoked legs.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ReplayExpiry (L1481-1638):
/// a revoked login must not recover
/// saved outcomes via identical,
/// changed, or fresh posts, or via
/// loads.
/// Disposition: migrate (this row
/// owns the revoked pact as
/// reviewable Can facts; the old go
/// check stays until the integrator
/// retires it after every linked
/// row, variant, environment and
/// control has accepted evidence).
/// Protects (this file): facet one
/// (L1511-1547): revoked identical,
/// changed and fresh posts share
/// one nondisclosing 403 naming
/// only the caller-sent op id, and
/// the load denial matches; nothing
/// leaks the recorded bytes.
/// ADAPTATION (recorded, with
/// source lines): path pins hold the
/// save URL; body pins hold post
/// JSON bytes; login pins hold the
/// revoked login; op pins hold op
/// ids; note pins hold leg and
/// guard lines; leaf pins hold
/// outcome leaves; guard pins hold
/// leak-guard bytes; count pins
/// hold ints tallied from legs
/// and guards.
/// Pin lines: save-path L1500,
/// lines-body L1501, session-token L1512,
/// media-kind L1512,
/// base-operation L1512,
/// fresh-operation L1528,
/// revoke-note-setup L1514,
/// leg-identical-note L1526,
/// leg-changed-note L1527,
/// leg-changed-body L1527,
/// leg-fresh-note L1528, deny-want L1532,
/// deny-leaf L1534,
/// id-mismatch-note L1536,
/// disclose-guard-one L1538,
/// disclose-guard-two L1538,
/// disclose-note L1539, load-note L1546,
/// load-leaf L1546, load-deny-note L1544,
/// no-entry-note L1547,
/// committed-revision L1517,
/// deny-status L1531,
/// deny-value-size L1538,
/// revoked-leg-count L1526.
/// Facet map (leg order): save-path,
/// lines-body, session-token, media-kind,
/// base-operation, fresh-operation,
/// revoke-note-setup, leg-identical-note,
/// leg-changed-note, leg-changed-body,
/// leg-fresh-note, deny-want, deny-leaf,
/// id-mismatch-note, disclose-guard-one,
/// disclose-guard-two, disclose-note,
/// load-note, load-leaf, load-deny-note,
/// no-entry-note, committed-revision,
/// deny-status, deny-value-size,
/// revoked-leg-count.
/// The live plus expired legs
/// live in life-006-roots-green.can;
/// the harness plus cleanup shape
/// lives in life-006-run-shape.can.
/// Variants: revoked versus
/// unrevoked (default plus seeded
/// drifts only here; live legs
/// bind in roots).
/// Environment: CAN_BUN_ARCHIVE
/// plus a staged bundle plus
/// cut-off homes (row lists three
/// gates; bind at P23; no live
/// run now).
/// Logical gates HTTP plus DB
/// plus D1 plus D2 bind at P23
/// plus QHTTP plus QD1 plus QD2;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live fourteen
/// minute hold is pinned in the
/// run slice; binds at P23 like
/// the M38 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed
/// (P23 plus QHTTP plus QD1 plus
/// QD2 accept gates unmet).
/// Case life/replay-expiry-base
/// checks: save-path, lines-body,
/// session-token, media-kind,
/// base-operation, fresh-operation,
/// revoke-note-setup, leg-identical-note,
/// leg-changed-note, leg-changed-body,
/// leg-fresh-note, deny-want, deny-leaf,
/// id-mismatch-note, disclose-guard-one,
/// disclose-guard-two, disclose-note,
/// load-note, load-leaf, load-deny-note,
/// no-entry-note, committed-revision,
/// deny-status, deny-value-size,
/// revoked-leg-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str save_path
    str lines_body
    str session_token
    str media_kind
    str base_operation
    str fresh_operation
    str revoke_note_setup
    str leg_identical_note
    str leg_changed_note
    str leg_changed_body
    str leg_fresh_note
    str deny_want
    str deny_leaf
    str id_mismatch_note
    str disclose_guard_one
    str disclose_guard_two
    str disclose_note
    str load_note
    str load_leaf
    str load_deny_note
    str no_entry_note
    int committed_revision
    int deny_status
    int deny_value_size
    int revoked_leg_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/replay-expiry-base", "default", "", "offline"), "save-path" => ok "case life/replay-expiry-base variant default root save-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/replay-expiry-base", "default", "", "offline"), "save-path" => ok evidence("save-path", "true", "true", true, "case life/replay-expiry-base variant default root save-path run offline")
        different: false, true, context("life/replay-expiry-base", "default", "", "offline"), "save-path" => failed{"save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/replay-expiry-base", "default", "", "offline"), "committed-revision" => ok evidence("committed-revision", "2", "2", true, "case life/replay-expiry-base variant default root committed-revision run offline")
        different: 1, 2, context("life/replay-expiry-base", "default", "", "offline"), "committed-revision" => failed{"committed-revision"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", context("life/replay-expiry-base", "default", "", "offline"), "save-path" => ok evidence("save-path", "/api/tenants/1/invoices/7", "/api/tenants/1/invoices/7", true, "case life/replay-expiry-base variant default root save-path run offline")
        different: "/api/tenants/1/invoices/7_2", "/api/tenants/1/invoices/7", context("life/replay-expiry-base", "default", "", "offline"), "save-path" => failed{"save-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
