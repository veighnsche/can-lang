package m39life006roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-006 TestGate3ReplayExpiry
/// live plus expired legs.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ReplayExpiry (L1481-1638):
/// an unrevoked replay returns
/// byte-identical 200 bytes with
/// its retention stamp held; a
/// live row a minute inside the
/// cutoff replays the same way;
/// a row a minute past the
/// cutoff conflicts with 409 and
/// is gone, while the same op id
/// with a fresh base commits a
/// new revision.
/// Disposition: migrate (this row
/// owns the live plus expired
/// pact as reviewable Can facts;
/// the old go check stays until
/// the integrator retires it after
/// every linked row, variant,
/// environment and control has
/// accepted evidence).
/// Protects (this file): facet two
/// (L1549-1579): unrevoked and
/// live replays hold bytes and
/// stamp; plus facet three
/// (L1581-1611): expired replay
/// conflicts and removes its row,
/// and a fresh base commits
/// revision four.
/// ADAPTATION (recorded, with
/// source lines): stamp pins
/// hold replay stamps; note pins
/// hold guard lines; op pins hold
/// op ids; login pins hold the
/// stamp-move login; leaf pins
/// hold outcome leaves; count
/// pins hold ints tallied from
/// revisions and guards.
/// Pin lines: restore-stamp L1551,
/// replay-note-unrevoked L1554,
/// retention-slide-unrevoked L1558,
/// no-entry-unrevoked L1560,
/// setup-note-expiry L1567,
/// live-operation L1565,
/// touch-actor L1570,
/// replay-note-live L1574,
/// no-entry-live L1576,
/// retention-slide-live L1578,
/// replay-note-expired L1588,
/// expired-note L1590,
/// conflict-leaf L1590, moved-note L1592,
/// kept-note L1596, fresh-note L1604,
/// fresh-base-note L1606,
/// saved-leaf L1606,
/// fresh-rev-note L1609, ok-status L1513,
/// conflict-status L1587,
/// base-revision-e1 L1565,
/// live-revision L1577,
/// fresh-base-revision L1602,
/// fresh-revision L1608.
/// Facet map (leg order): restore-stamp,
/// replay-note-unrevoked,
/// retention-slide-unrevoked,
/// no-entry-unrevoked, setup-note-expiry,
/// live-operation, touch-actor,
/// replay-note-live, no-entry-live,
/// retention-slide-live,
/// replay-note-expired, expired-note,
/// conflict-leaf, moved-note, kept-note,
/// fresh-note, fresh-base-note,
/// saved-leaf, fresh-rev-note, ok-status,
/// conflict-status, base-revision-e1,
/// live-revision, fresh-base-revision,
/// fresh-revision.
/// The revoked legs live in
/// life-006-base-semantics.can; the
/// harness plus cleanup shape lives
/// in life-006-run-shape.can.
/// Variants: inside versus outside
/// the retention cutoff, plus
/// fresh base after expiry
/// (default plus seeded drifts
/// only here).
/// Environment: CAN_BUN_ARCHIVE
/// plus a staged bundle plus
/// cut-off homes (row lists three
/// gates; bind at P23; no live
/// run now).
/// Logical gates HTTP plus DB
/// plus D1 plus D2 bind at P23
/// plus QHTTP plus QD1 plus QD2;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live fourteen
/// minute hold is pinned in the
/// run slice; binds at P23 like
/// the M38 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed
/// (P23 plus QHTTP plus QD1 plus
/// QD2 accept gates unmet).
/// Case life/replay-expiry-roots
/// checks: restore-stamp,
/// replay-note-unrevoked,
/// retention-slide-unrevoked,
/// no-entry-unrevoked, setup-note-expiry,
/// live-operation, touch-actor,
/// replay-note-live, no-entry-live,
/// retention-slide-live,
/// replay-note-expired, expired-note,
/// conflict-leaf, moved-note, kept-note,
/// fresh-note, fresh-base-note,
/// saved-leaf, fresh-rev-note, ok-status,
/// conflict-status, base-revision-e1,
/// live-revision, fresh-base-revision,
/// fresh-revision.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str restore_stamp
    str replay_note_unrevoked
    str retention_slide_unrevoked
    str no_entry_unrevoked
    str setup_note_expiry
    str live_operation
    str touch_actor
    str replay_note_live
    str no_entry_live
    str retention_slide_live
    str replay_note_expired
    str expired_note
    str conflict_leaf
    str moved_note
    str kept_note
    str fresh_note
    str fresh_base_note
    str saved_leaf
    str fresh_rev_note
    int ok_status
    int conflict_status
    int base_revision_e1
    int live_revision
    int fresh_base_revision
    int fresh_revision
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/replay-expiry-roots", "default", "", "offline"), "restore-stamp" => ok "case life/replay-expiry-roots variant default root restore-stamp run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/replay-expiry-roots", "default", "", "offline"), "restore-stamp" => ok evidence("restore-stamp", "true", "true", true, "case life/replay-expiry-roots variant default root restore-stamp run offline")
        different: false, true, context("life/replay-expiry-roots", "default", "", "offline"), "restore-stamp" => failed{"restore-stamp"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("life/replay-expiry-roots", "default", "", "offline"), "ok-status" => ok evidence("ok-status", "200", "200", true, "case life/replay-expiry-roots variant default root ok-status run offline")
        different: 199, 200, context("life/replay-expiry-roots", "default", "", "offline"), "ok-status" => failed{"ok-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "0", "0", context("life/replay-expiry-roots", "default", "", "offline"), "restore-stamp" => ok evidence("restore-stamp", "0", "0", true, "case life/replay-expiry-roots variant default root restore-stamp run offline")
        different: "0_2", "0", context("life/replay-expiry-roots", "default", "", "offline"), "restore-stamp" => failed{"restore-stamp"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
