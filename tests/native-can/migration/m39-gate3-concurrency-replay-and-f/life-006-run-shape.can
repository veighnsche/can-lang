package m39life006run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-006 TestGate3ReplayExpiry
/// harness plus cleanup shape.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3ReplayExpiry (L1481-1638):
/// the staged run needs its
/// archive gate, helpers, port,
/// window and loopback origin;
/// cleanup then keeps the
/// near-boundary live rows and
/// drops only the ancient one.
/// Disposition: migrate (this row
/// owns the harness plus cleanup
/// pact as reviewable Can facts;
/// the old go check stays until
/// the integrator retires it after
/// every linked row, variant,
/// environment and control has
/// accepted evidence).
/// Protects (this file): facet
/// four (L1613-1636): cleanup
/// keeps op-v1, op-e1 and op-e3
/// while op-e2 falls away at
/// revision six; plus the run
/// shape (L1481-1509 plus L1637):
/// archive gate, staged helpers,
/// loopback origin, port, window
/// and closing line.
/// ADAPTATION (recorded, with
/// source lines): env pins hold
/// the archive gate; helper pins
/// hold helper names; origin pins
/// hold the loopback host; note
/// pins hold guard lines; op pins
/// hold op ids; count pins hold
/// ints tallied from the window,
/// boundary, ledger and sites.
/// Pin lines: env-name L1483,
/// skip-note L1485, timeout-call L1488,
/// helper-bundle L1490,
/// helper-stage L1494, helper-seed L1495,
/// helper-serve L1497, helper-post L1512,
/// helper-get L1542, helper-case L1534,
/// helper-snapshot L1507,
/// helper-inspect L1507,
/// helper-require-replay L1517,
/// helper-no-entry L1547,
/// helper-revoke L1518,
/// helper-touch L1570, origin-host L1499,
/// cleanup-setup-note L1619,
/// cleanup-commit-note L1625,
/// cleanup-rev-note L1628,
/// cleanup-ledger-note L1635,
/// done-note L1637,
/// ancient-operation L1617,
/// commit-operation L1623,
/// replay-port L70,
/// timeout-minutes L1488,
/// window-ms L1496,
/// boundary-offset-ms L1569,
/// cleanup-revision L1627,
/// keep-count L1634, drop-count L1634,
/// post-site-count L1512,
/// stamp-change-count L1518.
/// Facet map (leg order): env-name,
/// skip-note, timeout-call,
/// helper-bundle, helper-stage,
/// helper-seed, helper-serve,
/// helper-post, helper-get, helper-case,
/// helper-snapshot, helper-inspect,
/// helper-require-replay,
/// helper-no-entry, helper-revoke,
/// helper-touch, origin-host,
/// cleanup-setup-note,
/// cleanup-commit-note, cleanup-rev-note,
/// cleanup-ledger-note, done-note,
/// ancient-operation, commit-operation,
/// replay-port, timeout-minutes,
/// window-ms, boundary-offset-ms,
/// cleanup-revision, keep-count,
/// drop-count, post-site-count,
/// stamp-change-count.
/// The revoked legs live in
/// life-006-base-semantics.can;
/// the live plus expired legs live
/// in life-006-roots-green.can.
/// Variants: revoked versus
/// unrevoked, inside versus
/// outside the cutoff, and fresh
/// base after expiry (all bound
/// as named pins here; live legs
/// bind at P23).
/// Environment: CAN_BUN_ARCHIVE
/// plus a staged bundle, cut-off
/// homes, sandbox helpers, free
/// loopback ports, disposable
/// SQLite, a managed server and
/// an fd-3 snapshot (row lists
/// three gates; bind at P23; no
/// live run now).
/// Logical gates HTTP plus DB
/// plus D1 plus D2 bind at P23
/// plus QHTTP plus QD1 plus QD2;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live fourteen
/// minute hold is pinned here;
/// binds at P23 like the M38
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed
/// (P23 plus QHTTP plus QD1 plus
/// QD2 accept gates unmet).
/// Case life/replay-expiry-run
/// checks: env-name, skip-note,
/// timeout-call, helper-bundle,
/// helper-stage, helper-seed,
/// helper-serve, helper-post, helper-get,
/// helper-case, helper-snapshot,
/// helper-inspect, helper-require-replay,
/// helper-no-entry, helper-revoke,
/// helper-touch, origin-host,
/// cleanup-setup-note,
/// cleanup-commit-note, cleanup-rev-note,
/// cleanup-ledger-note, done-note,
/// ancient-operation, commit-operation,
/// replay-port, timeout-minutes,
/// window-ms, boundary-offset-ms,
/// cleanup-revision, keep-count,
/// drop-count, post-site-count,
/// stamp-change-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_name
    str skip_note
    str timeout_call
    str helper_bundle
    str helper_stage
    str helper_seed
    str helper_serve
    str helper_post
    str helper_get
    str helper_case
    str helper_snapshot
    str helper_inspect
    str helper_require_replay
    str helper_no_entry
    str helper_revoke
    str helper_touch
    str origin_host
    str cleanup_setup_note
    str cleanup_commit_note
    str cleanup_rev_note
    str cleanup_ledger_note
    str done_note
    str ancient_operation
    str commit_operation
    int replay_port
    int timeout_minutes
    int window_ms
    int boundary_offset_ms
    int cleanup_revision
    int keep_count
    int drop_count
    int post_site_count
    int stamp_change_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/replay-expiry-run", "default", "", "offline"), "env-name" => ok "case life/replay-expiry-run variant default root env-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/replay-expiry-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "true", "true", true, "case life/replay-expiry-run variant default root env-name run offline")
        different: false, true, context("life/replay-expiry-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 18573, 18573, context("life/replay-expiry-run", "default", "", "offline"), "replay-port" => ok evidence("replay-port", "18573", "18573", true, "case life/replay-expiry-run variant default root replay-port run offline")
        different: 18572, 18573, context("life/replay-expiry-run", "default", "", "offline"), "replay-port" => failed{"replay-port"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("life/replay-expiry-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case life/replay-expiry-run variant default root env-name run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("life/replay-expiry-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
