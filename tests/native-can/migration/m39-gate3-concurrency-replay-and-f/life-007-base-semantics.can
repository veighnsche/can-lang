package m39life007base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-007 TestGate3RendererFault
/// setup plus fault plus load.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3RendererFault (L1646-1756):
/// one form save must land revision
/// two with row proof, then a stored
/// row with a spaced key must fail
/// the page to a fixed 500 with no
/// entry effect while kept rows plus
/// JSON load stay well.
/// Disposition: migrate (this row owns
/// the setup plus fault pact as
/// reviewable Can facts; the old go
/// check stays until the integrator
/// retires it after every linked row,
/// variant, environment and control
/// has accepted proof).
/// Protects (this file): facet one
/// (L1683-1713): post-commit spaced
/// key fails the page to fixed 500
/// with body error and no entry move,
/// two kept lines stay, and JSON load
/// answers 200 with leaf grid_loaded
/// at revision two.
/// ADAPTATION (recorded, with source
/// lines): note pins hold guard lines;
/// want pins hold wanted bytes; call
/// pins hold helper names; key pins
/// hold the spaced key; guard pins hold
/// code lines; path pins hold URLs;
/// leaf pins hold outcome leaves; count
/// pins hold ints tallied from legs.
/// setup-save-note pins
/// render setup save line (L1685);
/// setup-saved-want pins saved revision
/// two bytes (L1684); setup-details pins
/// Rush order (L1683); inject-call pins
/// injectLine (L1691); inject-key pins
/// k 1 (L1691); fault-page-guard pins
/// page body line (L1694);
/// fault-page-note pins the page line
/// (L1695); no-entry-call pins
/// requireNoEntry (L1697);
/// kept-rows-note pins the kept line
/// (L1701); load-path pins the json
/// path (L1706); load-note pins the
/// load line (L1708); load-leaf pins
/// grid_loaded (L1710);
/// load-value-note pins the value line
/// (L1713); load-current-key pins
/// current key (L1711);
/// load-revision-guard pins revision key
/// (L1712); setup-ok-status pins int
/// (200) from L1684; fault-status pins
/// int (500) from L1694; load-ok-status
/// pins int (200) from L1707;
/// kept-line-count pins int (2) from
/// L1700; setup-base-revision pins int
/// (1) from L1683; setup-saved-revision
/// pins int (2) from L1684;
/// load-revision pins int (2) from L1712.
/// Facet map (leg order): setup-save-note,
/// setup-saved-want, setup-details,
/// inject-call, inject-key,
/// fault-page-guard, fault-page-note,
/// no-entry-call, kept-rows-note,
/// load-path, load-note, load-leaf,
/// load-value-note, load-current-key,
/// load-revision-guard, setup-ok-status,
/// fault-status, load-ok-status,
/// kept-line-count, setup-base-revision,
/// setup-saved-revision, load-revision.
/// The outage plus retry legs live in
/// life-007-roots-green.can; the harness
/// plus form shape lives in
/// life-007-run-shape.can.
/// Variants: spaced stored key (default
/// plus seeded drifts only here).
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes plus
/// loopback plus disposable SQLite plus
/// managed server plus fd-3 snapshot
/// (row lists three gates; bind at P23
/// plus QHTTP plus QD1; no live run now).
/// Logical gates HTTP plus DB plus D1
/// bind at P23 plus QHTTP plus QD1; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fourteen minute hold
/// is pinned in the run slice; binds at
/// P23 like the M38 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates unmet).
/// Case life/renderer-fault-base
/// checks: setup-save-note,
/// setup-saved-want, setup-details,
/// inject-call, inject-key,
/// fault-page-guard, fault-page-note,
/// no-entry-call, kept-rows-note,
/// load-path, load-note, load-leaf,
/// load-value-note, load-current-key,
/// load-revision-guard, setup-ok-status,
/// fault-status, load-ok-status,
/// kept-line-count, setup-base-revision,
/// setup-saved-revision, load-revision.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str setup_save_note
    str setup_saved_want
    str setup_details
    str inject_call
    str inject_key
    str fault_page_guard
    str fault_page_note
    str no_entry_call
    str kept_rows_note
    str load_path
    str load_note
    str load_leaf
    str load_value_note
    str load_current_key
    str load_revision_guard
    int setup_ok_status
    int fault_status
    int load_ok_status
    int kept_line_count
    int setup_base_revision
    int setup_saved_revision
    int load_revision
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/renderer-fault-base", "default", "", "offline"), "setup-save-note" => ok "case life/renderer-fault-base variant default root setup-save-note run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/renderer-fault-base", "default", "", "offline"), "setup-save-note" => ok evidence("setup-save-note", "true", "true", true, "case life/renderer-fault-base variant default root setup-save-note run offline")
        different: false, true, context("life/renderer-fault-base", "default", "", "offline"), "setup-save-note" => failed{"setup-save-note"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("life/renderer-fault-base", "default", "", "offline"), "setup-ok-status" => ok evidence("setup-ok-status", "200", "200", true, "case life/renderer-fault-base variant default root setup-ok-status run offline")
        different: 199, 200, context("life/renderer-fault-base", "default", "", "offline"), "setup-ok-status" => failed{"setup-ok-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "render setup save: %d %s", "render setup save: %d %s", context("life/renderer-fault-base", "default", "", "offline"), "setup-save-note" => ok evidence("setup-save-note", "render setup save: %d %s", "render setup save: %d %s", true, "case life/renderer-fault-base variant default root setup-save-note run offline")
        different: "render setup save: %d %s_2", "render setup save: %d %s", context("life/renderer-fault-base", "default", "", "offline"), "setup-save-note" => failed{"setup-save-note"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("render setup save: %d %s", "saved revision 2", "Rush order", "injectLine", "k 1", "page != \"error\"", "renderer fault page: %d %q, want 500 error", "requireNoEntry", "renderer fault lost committed rows %+v", "/api/tenants/1/invoices/7", "renderer fault load: %d %s, want 200", "invoice_contract::grid_loaded", "renderer fault load value %+v", "value[\"current\"]", "current[\"revision\"]", 200, 500, 200, 2, 1, 2, 2)
        seed_setup_save_note: "seed-setup-save-note-drift" => ok observation("render setup save: %d %s_2", "saved revision 2", "Rush order", "injectLine", "k 1", "page != \"error\"", "renderer fault page: %d %q, want 500 error", "requireNoEntry", "renderer fault lost committed rows %+v", "/api/tenants/1/invoices/7", "renderer fault load: %d %s, want 200", "invoice_contract::grid_loaded", "renderer fault load value %+v", "value[\"current\"]", "current[\"revision\"]", 200, 500, 200, 2, 1, 2, 2)
