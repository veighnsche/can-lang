package m39life007roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-007 TestGate3RendererFault
/// recovery plus outage plus retry.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3RendererFault (L1646-1756):
/// dropping the spaced row must bring
/// back the page with kept bytes, then
/// a dropped lines table must fail its
/// save plus page to 503 with an alert
/// and no commit, while the same save
/// lands revision three after restore.
/// Disposition: migrate (same row pact
/// as the base slice; this file owns
/// the recovery plus outage legs only).
/// Protects (this file): facet two
/// (L1717-1720): delete brings back 200
/// with Rush order plus value bytes;
/// plus facet three (L1727-1753):
/// drop-lines fails save plus page to
/// 503 with alert, holds revision with
/// no commit, restores five tables, and
/// retries to saved revision three.
/// ADAPTATION (recorded, with source
/// lines): call pins hold helper names;
/// guard pins hold code lines; want pins
/// hold wanted bytes; note pins hold
/// guard lines; name pins hold fault
/// names; mode pins hold driver words;
/// count pins hold ints tallied from
/// legs.
/// recovery-call pins deleteLine (L1717);
/// recovery-want-guard pins the name
/// line (L1719); recovery-value-guard
/// pins value bytes (L1719);
/// recovery-page-note pins the page line
/// (L1720); outage-call pins faultInvoice
/// (L1727); outage-fault-name pins
/// drop-lines (L1727); outage-save-want
/// pins down word (L1729);
/// outage-alert-guard pins alert bytes
/// (L1729); outage-save-note pins the
/// save line (L1730); outage-page-want
/// pins notice bytes (L1733);
/// outage-page-note pins the page line
/// (L1734); revision-call pins
/// invoiceRevision (L1737);
/// revision-moved-note pins the held
/// line (L1738); outage-held-note pins
/// the held log line (L1740);
/// restore-call pins invoiceDriver
/// (L1741); restore-mode pins setup word
/// (L1741); restore-schema pins schema
/// name (L1741); restore-note pins the
/// report line (L1746); retry-saved-want
/// pins saved revision three bytes
/// (L1749); retry-save-note pins the
/// save line (L1750); retry-call pins
/// recordFaultOutcome (L1752);
/// retry-note pins retry name (L1752);
/// retry-nothing-note pins nothing line
/// (L1753); done-note pins render log
/// line (L1755); recovery-ok-status pins
/// int (200) from L1719;
/// outage-save-status pins int (503)
/// from L1729; outage-page-status pins
/// int (503) from L1733; restore-tables
/// pins int (5) from L1745;
/// retry-ok-status pins int (200) from
/// L1749; retry-revision pins int (3)
/// from L1749; outage-base-revision pins
/// int (2) from L1728.
/// Facet map (leg order): recovery-call,
/// recovery-want-guard,
/// recovery-value-guard,
/// recovery-page-note, outage-call,
/// outage-fault-name, outage-save-want,
/// outage-alert-guard, outage-save-note,
/// outage-page-want, outage-page-note,
/// revision-call, revision-moved-note,
/// outage-held-note, restore-call,
/// restore-mode, restore-schema,
/// restore-note, retry-saved-want,
/// retry-save-note, retry-call,
/// retry-note, retry-nothing-note,
/// done-note, recovery-ok-status,
/// outage-save-status, outage-page-status,
/// restore-tables, retry-ok-status,
/// retry-revision, outage-base-revision.
/// The setup plus fault legs live in
/// life-007-base-semantics.can; the
/// harness plus form shape lives in
/// life-007-run-shape.can.
/// Variants: drop-lines outage plus
/// recovery (default plus seeded drifts
/// only here).
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes plus
/// loopback plus disposable SQLite plus
/// managed server plus fd-3 snapshot
/// (row lists three gates; bind at P23
/// plus QHTTP plus QD1; no live run now).
/// Logical gates HTTP plus DB plus D1
/// bind at P23 plus QHTTP plus QD1; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fourteen minute hold
/// is pinned in the run slice; binds at
/// P23 like the M38 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates unmet).
/// Case life/renderer-fault-roots
/// checks: recovery-call,
/// recovery-want-guard,
/// recovery-value-guard,
/// recovery-page-note, outage-call,
/// outage-fault-name, outage-save-want,
/// outage-alert-guard, outage-save-note,
/// outage-page-want, outage-page-note,
/// revision-call, revision-moved-note,
/// outage-held-note, restore-call,
/// restore-mode, restore-schema,
/// restore-note, retry-saved-want,
/// retry-save-note, retry-call,
/// retry-note, retry-nothing-note,
/// done-note, recovery-ok-status,
/// outage-save-status, outage-page-status,
/// restore-tables, retry-ok-status,
/// retry-revision, outage-base-revision.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str recovery_call
    str recovery_want_guard
    str recovery_value_guard
    str recovery_page_note
    str outage_call
    str outage_fault_name
    str outage_save_want
    str outage_alert_guard
    str outage_save_note
    str outage_page_want
    str outage_page_note
    str revision_call
    str revision_moved_note
    str outage_held_note
    str restore_call
    str restore_mode
    str restore_schema
    str restore_note
    str retry_saved_want
    str retry_save_note
    str retry_call
    str retry_note
    str retry_nothing_note
    str done_note
    int recovery_ok_status
    int outage_save_status
    int outage_page_status
    int restore_tables
    int retry_ok_status
    int retry_revision
    int outage_base_revision
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/renderer-fault-roots", "default", "", "offline"), "recovery-call" => ok "case life/renderer-fault-roots variant default root recovery-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/renderer-fault-roots", "default", "", "offline"), "recovery-call" => ok evidence("recovery-call", "true", "true", true, "case life/renderer-fault-roots variant default root recovery-call run offline")
        different: false, true, context("life/renderer-fault-roots", "default", "", "offline"), "recovery-call" => failed{"recovery-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("life/renderer-fault-roots", "default", "", "offline"), "recovery-ok-status" => ok evidence("recovery-ok-status", "200", "200", true, "case life/renderer-fault-roots variant default root recovery-ok-status run offline")
        different: 199, 200, context("life/renderer-fault-roots", "default", "", "offline"), "recovery-ok-status" => failed{"recovery-ok-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "deleteLine", "deleteLine", context("life/renderer-fault-roots", "default", "", "offline"), "recovery-call" => ok evidence("recovery-call", "deleteLine", "deleteLine", true, "case life/renderer-fault-roots variant default root recovery-call run offline")
        different: "deleteLine_2", "deleteLine", context("life/renderer-fault-roots", "default", "", "offline"), "recovery-call" => failed{"recovery-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("deleteLine", "strings.Contains(page, \"Rush order\")", "value=\"2\"", "renderer recovery page: %d %.500s, want 200 with committed content", "faultInvoice", "drop-lines", "unavailable", "role=\"alert\"", "form outage save: %d %s, want 503 unavailable alert", "Invoice unavailable", "form outage page: %d %.300s, want 503 notice", "invoiceRevision", "drop-lines form fault moved revision %s to %s", "fault drop-lines form: committed=false (revision %s held, lines table dropped)", "invoiceDriver", "setup", "schema.sql", "invalid invoice restore report %v %s", "saved revision 3", "form recovery save: %d %s, want 200 saved revision 3", "recordFaultOutcome", "drop-lines form retry", "drop-lines form retry committed nothing", "gate3 render: %d can assertions, post-commit renderer 500, JSON health, page recovery and form 503 fragment live with row evidence", 200, 503, 503, 5, 200, 3, 2)
