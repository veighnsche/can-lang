/// M39 LIFE-007 TestGate3RendererFault
/// harness plus form shape.
/// Source: tests/integration/
/// gate3_matrix_test.go symbol
/// TestGate3RendererFault (L1646-1756):
/// env gate, staged invoice app, form
/// lines, loopback origin, port, plus
/// helper names and site tallies.
/// Disposition: migrate (same row pact
/// as the base slice; this file owns
/// the harness plus form spellings and
/// tallies only).
/// Protects (this file): the env gate
/// (L1648-1650), the staged helpers
/// plus port plus origin plus form
/// paths plus seven form lines plus
/// helper names plus site counts.
/// ADAPTATION (recorded, with source
/// lines): name pins hold env, helper,
/// port, path and login spellings; note
/// pins hold guard lines; call pins hold
/// call spellings; form pins hold form
/// lines; count pins hold ints tallied
/// from lines plus sites.
/// test-decl pins TestGate3RendererFault
/// (L1646); env-name pins CAN_BUN_ARCHIVE
/// (L1648); skip-note pins the skip line
/// (L1650); timeout-call pins
/// 14*time.Minute (L1653); helper-bundle
/// pins harnessBundle (L1655);
/// helper-stage pins stageInvoiceBundle
/// (L1659); helper-seed pins seedInvoiceDB
/// (L1660); helper-serve pins serveInvoice
/// (L1661); render-port-name pins
/// gate3RenderPort (L1661); origin-host
/// pins loopback host (L1663); form-path
/// pins form URL (L1664); page-path pins
/// page URL (L1665); form-seats-set pins
/// seats line (L1668); form-details-set
/// pins details line (L1669);
/// form-revision-set pins revision line
/// (L1670); form-order-add pins order
/// line (L1671); form-id-set pins id line
/// (L1672); form-qty-set pins qty line
/// (L1673); form-price-set pins price line
/// (L1674); helper-post pins postInvoiceForm
/// (L1683); helper-get pins invoiceGet
/// (L1693); helper-case pins gate3Case
/// (L1710); helper-snapshot pins
/// snapshotEntries (L1679); helper-inspect
/// pins inspectInvoice (L1679);
/// helper-require pins requireInvoice
/// (L1687); entries-struct pins
/// protectedEntries (L1677); session-login
/// pins alice login (L1683);
/// timeout-minutes pins int (14) from
/// L1653; render-port pins int (18574)
/// from L71; form-field-count pins int
/// (7) from L1668-1674; post-site-count
/// pins int (3) from L1683-1748;
/// get-site-count pins int (4) from
/// L1693-1732; gate3case-count pins int
/// (1) from L1710.
/// Facet map (loop order): test-decl,
/// env-name, skip-note, timeout-call,
/// helper-bundle, helper-stage,
/// helper-seed, helper-serve,
/// render-port-name, origin-host,
/// form-path, page-path, form-seats-set,
/// form-details-set, form-revision-set,
/// form-order-add, form-id-set,
/// form-qty-set, form-price-set,
/// helper-post, helper-get, helper-case,
/// helper-snapshot, helper-inspect,
/// helper-require, entries-struct,
/// session-login, timeout-minutes,
/// render-port, form-field-count,
/// post-site-count, get-site-count,
/// gate3case-count.
/// The setup plus fault legs live in
/// life-007-base-semantics.can; the
/// recovery plus outage legs live in
/// life-007-roots-green.can.
/// Variants: spaced key plus drop-lines
/// (counts only here; legs bind in base
/// plus roots).
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes plus
/// loopback plus disposable SQLite plus
/// managed server plus fd-3 snapshot
/// (row lists three gates; bind at P23
/// plus QHTTP plus QD1; no live run now).
/// Logical gates HTTP plus DB plus D1
/// bind at P23 plus QHTTP plus QD1; no
/// live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fourteen minute hold
/// is pinned above as timeout-minutes;
/// binds at P23 like the M38 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 accept gates unmet).
/// Case life/renderer-fault-run
/// checks: test-decl, env-name, skip-note,
/// timeout-call, helper-bundle,
/// helper-stage, helper-seed, helper-serve,
/// render-port-name, origin-host,
/// form-path, page-path, form-seats-set,
/// form-details-set, form-revision-set,
/// form-order-add, form-id-set,
/// form-qty-set, form-price-set,
/// helper-post, helper-get, helper-case,
/// helper-snapshot, helper-inspect,
/// helper-require, entries-struct,
/// session-login, timeout-minutes,
/// render-port, form-field-count,
/// post-site-count, get-site-count,
/// gate3case-count.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_decl
    str env_name
    str skip_note
    str timeout_call
    str helper_bundle
    str helper_stage
    str helper_seed
    str helper_serve
    str render_port_name
    str origin_host
    str form_path
    str page_path
    str form_seats_set
    str form_details_set
    str form_revision_set
    str form_order_add
    str form_id_set
    str form_qty_set
    str form_price_set
    str helper_post
    str helper_get
    str helper_case
    str helper_snapshot
    str helper_inspect
    str helper_require
    str entries_struct
    str session_login
    int timeout_minutes
    int render_port
    int form_field_count
    int post_site_count
    int get_site_count
    int gate3case_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/renderer-fault-run", "default", "", "offline"), "test-decl" => ok "case life/renderer-fault-run variant default root test-decl run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/renderer-fault-run", "default", "", "offline"), "test-decl" => ok evidence("test-decl", "true", "true", true, "case life/renderer-fault-run variant default root test-decl run offline")
        different: false, true, context("life/renderer-fault-run", "default", "", "offline"), "test-decl" => failed{"test-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 14, 14, context("life/renderer-fault-run", "default", "", "offline"), "timeout-minutes" => ok evidence("timeout-minutes", "14", "14", true, "case life/renderer-fault-run variant default root timeout-minutes run offline")
        different: 13, 14, context("life/renderer-fault-run", "default", "", "offline"), "timeout-minutes" => failed{"timeout-minutes"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestGate3RendererFault", "TestGate3RendererFault", context("life/renderer-fault-run", "default", "", "offline"), "test-decl" => ok evidence("test-decl", "TestGate3RendererFault", "TestGate3RendererFault", true, "case life/renderer-fault-run variant default root test-decl run offline")
        different: "TestGate3RendererFault_2", "TestGate3RendererFault", context("life/renderer-fault-run", "default", "", "offline"), "test-decl" => failed{"test-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
