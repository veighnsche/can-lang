package m39life008base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-008 TestGate3Lifecycle pool plus
/// startup refusal plus clean restart.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3Lifecycle (L1795-1953) plus pool
/// helpers (L1758-1785) plus the life port (L72):
/// the emitted bundle must open its pool at exactly
/// one site plus close it at exactly one, a store
/// path in an absent dir plus a held port must each
/// fail before serving, plus SIGTERM must drain
/// clean so a restart replays recorded bytes plus
/// admits a fresh save.
/// Disposition: migrate (this row owns the pool
/// pacts as reviewable Can facts; the old go check
/// stays until the integrator retires it after
/// every linked row, variant, environment plus
/// control has accepted evidence). Protects (this
/// file): facet one (L1816-1839): one open plus one
/// close site, missing-store plus held-port
/// refusal, plus facet two (L1841-1863): clean
/// drain plus restart replay plus a fresh write.
/// ADAPTATION (recorded, with source lines): site
/// pins hold emitted call spellings; note pins hold
/// leg notes; log pins hold refusal plus drain
/// lines; op pins hold op ids; guard pins hold want
/// lines; count pins hold ints tallied from loops
/// plus guards.
/// Pin lines: open-call-site L1820, close-call-site
/// L1821, save-path L1811, missing-db-note L1828,
/// missing-db-dir L1826, missing-db-file L1826,
/// missing-db-log L1829, life-snapshot L1833,
/// occupied-note L1838, occupied-log L1839,
/// setup-op L1844, setup-guard L1847, drain-log
/// L1851, replay-guard L1856, fresh-op L1858,
/// fresh-guard L1861, restart-details L1863,
/// open-sites L1820, close-sites L1821,
/// refusal-legs L1825 plus L1835, life-port-offset
/// L1828, ok-status L1845, setup-rev L1844,
/// fresh-rev L1858, restart-rev L1863,
/// restart-seats L1863.
/// Facet map (leg order): open-call-site,
/// close-call-site, save-path, missing-db-note,
/// missing-db-dir, missing-db-file, missing-db-log,
/// life-snapshot, occupied-note, occupied-log,
/// setup-op, setup-guard, drain-log, replay-guard,
/// fresh-op, fresh-guard, restart-details,
/// open-sites, close-sites, refusal-legs,
/// life-port-offset, ok-status, setup-rev,
/// fresh-rev, restart-rev, restart-seats.
/// Siblings: pool plus restart legs live in
/// life-008-base-semantics.can; trickle plus revoke
/// legs live in life-008-roots-green.can; harness
/// shape lives in life-008-run-shape.can.
/// Variants: absent store plus held port, clean
/// plus in-flight drain, buffered plus lazy plus
/// upgraded calls; default plus seeded drifts only
/// here.
/// Environment: CAN_BUN_ARCHIVE plus a staged
/// bundle plus cut-off homes plus loopback plus
/// disposable SQLite plus a managed server plus an
/// fd-3 snapshot (row lists three gates; bind at
/// P23; no live run now).
/// Logical gates DB plus D1 plus D4 plus CHILD plus
/// CLOCK bind at P23 plus QHTTP plus QD1 plus QD4;
/// no live run now.
/// Timeout 120000ms is the offline default bound
/// (the live fourteen minute hold is pinned in the
/// run slice; binds at P23 like the M38 no-run
/// rows).
/// Delegated oracles: DELEGATE-018 is mapped in the
/// roots slice. Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 plus QD4 accept gates
/// unmet).
/// Case life/lifecycle-pool-drain checks:
/// open-call-site, close-call-site, save-path,
/// missing-db-note, missing-db-dir,
/// missing-db-file, missing-db-log, life-snapshot,
/// occupied-note, occupied-log, setup-op,
/// setup-guard, drain-log, replay-guard, fresh-op,
/// fresh-guard, restart-details, open-sites,
/// close-sites, refusal-legs, life-port-offset,
/// ok-status, setup-rev, fresh-rev, restart-rev,
/// restart-seats.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str open_call_site
    str close_call_site
    str save_path
    str missing_db_note
    str missing_db_dir
    str missing_db_file
    str missing_db_log
    str life_snapshot
    str occupied_note
    str occupied_log
    str setup_op
    str setup_guard
    str drain_log
    str replay_guard
    str fresh_op
    str fresh_guard
    str restart_details
    int open_sites
    int close_sites
    int refusal_legs
    int life_port_offset
    int ok_status
    int setup_rev
    int fresh_rev
    int restart_rev
    int restart_seats
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/lifecycle-pool-drain", "default", "", "offline"), "open-call-site" => ok "case life/lifecycle-pool-drain variant default root open-call-site run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/lifecycle-pool-drain", "default", "", "offline"), "open-call-site" => ok evidence("open-call-site", "true", "true", true, "case life/lifecycle-pool-drain variant default root open-call-site run offline")
        different: false, true, context("life/lifecycle-pool-drain", "default", "", "offline"), "open-call-site" => failed{"open-call-site"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("life/lifecycle-pool-drain", "default", "", "offline"), "open-sites" => ok evidence("open-sites", "1", "1", true, "case life/lifecycle-pool-drain variant default root open-sites run offline")
        different: 0, 1, context("life/lifecycle-pool-drain", "default", "", "offline"), "open-sites" => failed{"open-sites"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "$canSQLPools.sqliteOpenFile", "$canSQLPools.sqliteOpenFile", context("life/lifecycle-pool-drain", "default", "", "offline"), "open-call-site" => ok evidence("open-call-site", "$canSQLPools.sqliteOpenFile", "$canSQLPools.sqliteOpenFile", true, "case life/lifecycle-pool-drain variant default root open-call-site run offline")
        different: "$canSQLPools.sqliteOpenFile_2", "$canSQLPools.sqliteOpenFile", context("life/lifecycle-pool-drain", "default", "", "offline"), "open-call-site" => failed{"open-call-site"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
