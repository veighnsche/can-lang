fn check[] checks
    emits {}
    given
        str scope
    asserts
        m39_l008: "m39-l008" => ok [check("trickle-op", "trickled leg keeps its op id"), check("drain-trickle-log", "SIGTERM drains the trickled leg clean"), check("inflight-log", "either landing is logged alike"), check("inflight-never-guard", "trickled leg must return"), check("inflight-effects-guard", "pre-converge holds at most one effect"), check("converge-save-guard", "converge leg demands a commit"), check("converge-reread-guard", "converge reread demands identical bytes"), check("converge-note", "converge leg keeps its note"), check("converge-tag", "converge leg lands grid_saved"), check("converge-value-guard", "converge leg decodes its value"), check("converge-count-guard", "converge lands exactly one effect"), check("suite-sidecar", "suite runs under the staged sidecar"), check("suite-flag-env", "suite drops env files"), check("suite-flag-macros", "suite drops macros"), check("suite-flag-install", "suite drops installs"), check("suite-config", "suite pins its bunfig"), check("suite-file", "delegated suite keeps its file name"), check("suite-path-env", "suite pins a narrow PATH"), check("suite-guard", "suite failure names its output"), check("suite-pass-log", "suite pass count is logged"), check("lifecycle-summary", "row summary names every leg"), check("deleg-abandon", "abandon keeps capability, revoke ends it"), check("deleg-foreign", "foreign revoke stays silent"), check("deleg-rejected", "rejected routes abandon plus revoke"), check("deleg-buffered", "buffered legs revoke after reply"), check("deleg-lazy", "lazy legs abandon unread bodies"), check("deleg-faults", "faults revoke plus free leases"), check("deleg-child", "admitted child work pins the token"), check("deleg-upgraded", "upgraded legs revoke at close"), check("trickle-chunk", "trickle moves sixteen bytes a tick"), check("trickle-delay-ms", "trickle waits 150ms a tick"), check("trickle-wait-ms", "drain waits 400ms mid-body"), check("trickle-client-timeout-s", "trickle caller allows thirty seconds"), check("trickle-serve-timeout-s", "trickle landing allows 25 seconds"), check("trickle-base-rev", "trickled leg starts at revision three"), check("pre-cap-effects", "pre-converge admits one row"), check("converge-rev", "converged row lands revision four"), check("converge-effects", "one converged effect exists"), check("suite-flags", "three sidecar flags exist"), check("suite-env-count", "three suite env entries exist"), check("suite-tests", "eight delegated checks exist")]
        other: "nope" => ok []
    match scope is "m39-l008"
        false => ok []
