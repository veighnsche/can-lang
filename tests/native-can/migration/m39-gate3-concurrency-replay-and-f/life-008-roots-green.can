package m39life008roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-008 TestGate3Lifecycle in-flight drain
/// plus revoke legs.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3Lifecycle (L1795-1953) plus the
/// life port (L72): SIGTERM landing mid-body of a
/// trickled save must still exit clean, the
/// identical retry must converge to exactly one
/// effect at revision four, plus the staged sidecar
/// must run the delegated request-lifetime suite
/// green.
/// Disposition: migrate (this row owns the drain
/// pacts as reviewable Can facts; the old go check
/// stays until the integrator retires it after
/// every linked row, variant, environment plus
/// control has accepted evidence). Protects (this
/// file): facet three (L1865-1932): trickled drain
/// plus converge, plus facet four (L1934-1952): the
/// delegated revoke suite under the staged sidecar.
/// ADAPTATION (recorded, with source lines): op
/// pins hold op ids; log pins hold drain lines;
/// guard pins hold want lines; note pins hold case
/// notes; tag pins hold leaf tags; flag pins hold
/// sidecar flags; suite pins hold suite path plus
/// env; title pins hold DELEGATE-018 declaration
/// titles; count pins hold ints tallied from loops
/// plus guards.
/// Pin lines: trickle-op L1868, drain-trickle-log
/// L1893, inflight-log L1896, inflight-never-guard
/// L1898, inflight-effects-guard L1907,
/// converge-save-guard L1913, converge-reread-guard
/// L1917, converge-note L1919, converge-tag L1919,
/// converge-value-guard L1922, converge-count-guard
/// L1931, suite-sidecar L1936, suite-flag-env
/// L1942, suite-flag-macros L1942,
/// suite-flag-install L1942, suite-config L1943,
/// suite-file L1944, suite-path-env L1946,
/// suite-guard L1949, suite-pass-log L1951,
/// lifecycle-summary L1952, deleg-abandon R197,
/// deleg-foreign R223, deleg-rejected R255,
/// deleg-buffered R298, deleg-lazy R335,
/// deleg-faults R392, deleg-child R425,
/// deleg-upgraded R479, trickle-chunk L1871,
/// trickle-delay-ms L1871, trickle-wait-ms L1890,
/// trickle-client-timeout-s L1880,
/// trickle-serve-timeout-s L1897, trickle-base-rev
/// L1868, pre-cap-effects L1906, converge-rev
/// L1921, converge-effects L1930, suite-flags
/// L1942, suite-env-count L1946, suite-tests
/// R-file.
/// Facet map (leg order): trickle-op,
/// drain-trickle-log, inflight-log,
/// inflight-never-guard, inflight-effects-guard,
/// converge-save-guard, converge-reread-guard,
/// converge-note, converge-tag,
/// converge-value-guard, converge-count-guard,
/// suite-sidecar, suite-flag-env,
/// suite-flag-macros, suite-flag-install,
/// suite-config, suite-file, suite-path-env,
/// suite-guard, suite-pass-log, lifecycle-summary,
/// deleg-abandon, deleg-foreign, deleg-rejected,
/// deleg-buffered, deleg-lazy, deleg-faults,
/// deleg-child, deleg-upgraded, trickle-chunk,
/// trickle-delay-ms, trickle-wait-ms,
/// trickle-client-timeout-s,
/// trickle-serve-timeout-s, trickle-base-rev,
/// pre-cap-effects, converge-rev, converge-effects,
/// suite-flags, suite-env-count, suite-tests.
/// Siblings: pool plus restart legs live in
/// life-008-base-semantics.can; trickle plus revoke
/// legs live in life-008-roots-green.can; harness
/// shape lives in life-008-run-shape.can.
/// Variants: absent store plus held port, clean
/// plus in-flight drain, buffered plus lazy plus
/// upgraded calls; default plus seeded drifts only
/// here.
/// Environment: CAN_BUN_ARCHIVE plus a staged
/// bundle plus cut-off homes plus loopback plus
/// disposable SQLite plus a managed server plus an
/// fd-3 snapshot (row lists three gates; bind at
/// P23; no live run now).
/// Logical gates DB plus D1 plus D4 plus CHILD plus
/// CLOCK bind at P23 plus QHTTP plus QD1 plus QD4;
/// no live run now.
/// Timeout 120000ms is the offline default bound
/// (the live fourteen minute hold is pinned in the
/// run slice; binds at P23 like the M38 no-run
/// rows).
/// Delegated oracles: DELEGATE-018
/// (runtime/test/request-lifetime.test.ts, eight
/// declarations) is mapped here as title pins plus
/// the staged invocation pins. Execution credit:
/// NOT claimed (P23 plus QHTTP plus QD1 plus QD4
/// accept gates unmet).
/// Case life/lifecycle-trickle-revoke checks:
/// trickle-op, drain-trickle-log, inflight-log,
/// inflight-never-guard, inflight-effects-guard,
/// converge-save-guard, converge-reread-guard,
/// converge-note, converge-tag,
/// converge-value-guard, converge-count-guard,
/// suite-sidecar, suite-flag-env,
/// suite-flag-macros, suite-flag-install,
/// suite-config, suite-file, suite-path-env,
/// suite-guard, suite-pass-log, lifecycle-summary,
/// deleg-abandon, deleg-foreign, deleg-rejected,
/// deleg-buffered, deleg-lazy, deleg-faults,
/// deleg-child, deleg-upgraded, trickle-chunk,
/// trickle-delay-ms, trickle-wait-ms,
/// trickle-client-timeout-s,
/// trickle-serve-timeout-s, trickle-base-rev,
/// pre-cap-effects, converge-rev, converge-effects,
/// suite-flags, suite-env-count, suite-tests.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str trickle_op
    str drain_trickle_log
    str inflight_log
    str inflight_never_guard
    str inflight_effects_guard
    str converge_save_guard
    str converge_reread_guard
    str converge_note
    str converge_tag
    str converge_value_guard
    str converge_count_guard
    str suite_sidecar
    str suite_flag_env
    str suite_flag_macros
    str suite_flag_install
    str suite_config
    str suite_file
    str suite_path_env
    str suite_guard
    str suite_pass_log
    str lifecycle_summary
    str deleg_abandon
    str deleg_foreign
    str deleg_rejected
    str deleg_buffered
    str deleg_lazy
    str deleg_faults
    str deleg_child
    str deleg_upgraded
    int trickle_chunk
    int trickle_delay_ms
    int trickle_wait_ms
    int trickle_client_timeout_s
    int trickle_serve_timeout_s
    int trickle_base_rev
    int pre_cap_effects
    int converge_rev
    int converge_effects
    int suite_flags
    int suite_env_count
    int suite_tests
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/lifecycle-trickle-revoke", "default", "", "offline"), "trickle-op" => ok "case life/lifecycle-trickle-revoke variant default root trickle-op run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/lifecycle-trickle-revoke", "default", "", "offline"), "trickle-op" => ok evidence("trickle-op", "true", "true", true, "case life/lifecycle-trickle-revoke variant default root trickle-op run offline")
        different: false, true, context("life/lifecycle-trickle-revoke", "default", "", "offline"), "trickle-op" => failed{"trickle-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 16, 16, context("life/lifecycle-trickle-revoke", "default", "", "offline"), "trickle-chunk" => ok evidence("trickle-chunk", "16", "16", true, "case life/lifecycle-trickle-revoke variant default root trickle-chunk run offline")
        different: 15, 16, context("life/lifecycle-trickle-revoke", "default", "", "offline"), "trickle-chunk" => failed{"trickle-chunk"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "op-l3", "op-l3", context("life/lifecycle-trickle-revoke", "default", "", "offline"), "trickle-op" => ok evidence("trickle-op", "op-l3", "op-l3", true, "case life/lifecycle-trickle-revoke variant default root trickle-op run offline")
        different: "op-l3_2", "op-l3", context("life/lifecycle-trickle-revoke", "default", "", "offline"), "trickle-op" => failed{"trickle-op"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
