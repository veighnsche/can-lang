package m39life008run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M39 LIFE-008 TestGate3Lifecycle harness plus
/// driver shape.
/// Source: tests/integration/gate3_matrix_test.go
/// symbol TestGate3Lifecycle (L1795-1953) plus
/// serve plus call-site helpers (L330-401,
/// L1758-1785) plus the life port (L72): one
/// managed server per leg serves the invoice path
/// on a free loopback port with an fd-3 snapshot,
/// posts ride the alice login, replay scans share
/// one loop head, plus the suite dir comes from a
/// fresh temp dir.
/// Disposition: migrate (this row owns the harness
/// pacts as reviewable Can facts; the old go check
/// stays until the integrator retires it after
/// every linked row, variant, environment plus
/// control has accepted evidence). Protects (this
/// file): the serve plus observation helpers, the
/// harness plus env shape (L1795-1814), the loop
/// plus temp-dir shape, plus the driver modes
/// (driver.ts). ADAPTATION (recorded, with source
/// lines): helper pins hold helper names; marker
/// pins hold body fragment spellings; env pins hold
/// the archive var plus skip note; shape pins hold
/// loop plus dir spellings; driver pins hold
/// driver.ts mode lines; count pins hold ints
/// tallied from consts plus loops plus call counts.
/// Pin lines: test-decl L1795, env-name L1797,
/// skip-note L1799, timeout-call L1802,
/// helper-harness L1804, helper-stage L1808,
/// helper-seed L1809, helper-serve L1834,
/// life-port-name L1810, origin-host L1810,
/// opid-marker L1813, revision-marker L1813,
/// lines-fragment L1813, media-json L1844,
/// cookie-name L1878, life-session L1844,
/// health-path L354, helper-call-sites L1820,
/// helper-startup L1825, helper-post L1844,
/// helper-require L1863, helper-inspect L1863,
/// helper-case L1919, helper-pass L1951,
/// race-struct L1869, trickle-struct L1871,
/// snapshot-fn L1833, loop-prefix L1901,
/// tempdir-call L1937, driver-setup-mode D51,
/// driver-seed-mode D72, driver-inspect-mode D81,
/// timeout-minutes L1802, life-port L72,
/// serve-calls L1834 plus L1852 plus L1909,
/// stop-sites L1850 plus L1892 plus L1910,
/// crash-sites L1846 plus L1855 plus L1860,
/// post-calls L1844 plus L1853 plus L1858 plus
/// L1911 plus L1915, inspect-calls L1863 plus L1901
/// plus L1925, callsite-checks L1820 plus L1821,
/// gate3case-count L1919, pass-count-calls L1951.
/// Facet map (leg order): test-decl, env-name,
/// skip-note, timeout-call, helper-harness,
/// helper-stage, helper-seed, helper-serve,
/// life-port-name, origin-host, opid-marker,
/// revision-marker, lines-fragment, media-json,
/// cookie-name, life-session, health-path,
/// helper-call-sites, helper-startup, helper-post,
/// helper-require, helper-inspect, helper-case,
/// helper-pass, race-struct, trickle-struct,
/// snapshot-fn, loop-prefix, tempdir-call,
/// driver-setup-mode, driver-seed-mode,
/// driver-inspect-mode, timeout-minutes, life-port,
/// serve-calls, stop-sites, crash-sites,
/// post-calls, inspect-calls, callsite-checks,
/// gate3case-count, pass-count-calls.
/// Siblings: pool plus restart legs live in
/// life-008-base-semantics.can; trickle plus revoke
/// legs live in life-008-roots-green.can; harness
/// shape lives in life-008-run-shape.can.
/// Variants: absent store plus held port, clean
/// plus in-flight drain, buffered plus lazy plus
/// upgraded calls; default plus seeded drifts only
/// here.
/// Environment: CAN_BUN_ARCHIVE plus a staged
/// bundle plus cut-off homes plus loopback plus
/// disposable SQLite plus a managed server plus an
/// fd-3 snapshot (row lists three gates; bind at
/// P23; no live run now).
/// Logical gates DB plus D1 plus D4 plus CHILD plus
/// CLOCK bind at P23 plus QHTTP plus QD1 plus QD4;
/// no live run now.
/// Timeout 120000ms is the offline default bound
/// (the live fourteen minute hold is pinned in the
/// run slice; binds at P23 like the M38 no-run
/// rows).
/// Delegated oracles: DELEGATE-018 is mapped in the
/// roots slice. Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 plus QD4 accept gates
/// unmet).
/// Case life/lifecycle-harness checks: test-decl,
/// env-name, skip-note, timeout-call,
/// helper-harness, helper-stage, helper-seed,
/// helper-serve, life-port-name, origin-host,
/// opid-marker, revision-marker, lines-fragment,
/// media-json, cookie-name, life-session,
/// health-path, helper-call-sites, helper-startup,
/// helper-post, helper-require, helper-inspect,
/// helper-case, helper-pass, race-struct,
/// trickle-struct, snapshot-fn, loop-prefix,
/// tempdir-call, driver-setup-mode,
/// driver-seed-mode, driver-inspect-mode,
/// timeout-minutes, life-port, serve-calls,
/// stop-sites, crash-sites, post-calls,
/// inspect-calls, callsite-checks, gate3case-count,
/// pass-count-calls.
/// Shared old files untouched; retirement is a
/// later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_decl
    str env_name
    str skip_note
    str timeout_call
    str helper_harness
    str helper_stage
    str helper_seed
    str helper_serve
    str life_port_name
    str origin_host
    str opid_marker
    str revision_marker
    str lines_fragment
    str media_json
    str cookie_name
    str life_session
    str health_path
    str helper_call_sites
    str helper_startup
    str helper_post
    str helper_require
    str helper_inspect
    str helper_case
    str helper_pass
    str race_struct
    str trickle_struct
    str snapshot_fn
    str loop_prefix
    str tempdir_call
    str driver_setup_mode
    str driver_seed_mode
    str driver_inspect_mode
    int timeout_minutes
    int life_port
    int serve_calls
    int stop_sites
    int crash_sites
    int post_calls
    int inspect_calls
    int callsite_checks
    int gate3case_count
    int pass_count_calls
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/lifecycle-harness", "default", "", "offline"), "test-decl" => ok "case life/lifecycle-harness variant default root test-decl run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/lifecycle-harness", "default", "", "offline"), "test-decl" => ok evidence("test-decl", "true", "true", true, "case life/lifecycle-harness variant default root test-decl run offline")
        different: false, true, context("life/lifecycle-harness", "default", "", "offline"), "test-decl" => failed{"test-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 14, 14, context("life/lifecycle-harness", "default", "", "offline"), "timeout-minutes" => ok evidence("timeout-minutes", "14", "14", true, "case life/lifecycle-harness variant default root timeout-minutes run offline")
        different: 13, 14, context("life/lifecycle-harness", "default", "", "offline"), "timeout-minutes" => failed{"timeout-minutes"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestGate3Lifecycle", "TestGate3Lifecycle", context("life/lifecycle-harness", "default", "", "offline"), "test-decl" => ok evidence("test-decl", "TestGate3Lifecycle", "TestGate3Lifecycle", true, "case life/lifecycle-harness variant default root test-decl run offline")
        different: "TestGate3Lifecycle_2", "TestGate3Lifecycle", context("life/lifecycle-harness", "default", "", "offline"), "test-decl" => failed{"test-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
