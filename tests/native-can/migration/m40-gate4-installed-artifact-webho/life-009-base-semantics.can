package m40life009base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-009 TestGate4FaultMatrix
/// identity plus invoice legs.
/// Source: tests/integration/
/// gate4_fault_test.go symbol
/// TestGate4FaultMatrix (L261-526):
/// the host bind plus the client
/// disconnect leg pins.
/// Disposition: migrate (this row owns
/// the fault matrix as reviewable Can
/// facts; the old go check stays until
/// the integrator retires it after
/// every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): facet one
/// (installed Linux artifact versus
/// staged development identity plus
/// build determinism and no stray
/// output) and facet two (complete-body
/// disconnect commits once, identical
/// replay succeeds, changed replay
/// conflicts).
/// ADAPTATION (recorded, with source
/// lines): mode pins hold toolchain
/// names; bun pins hold the pinned
/// revision pair; platform pins hold the
/// per-host pairs; path pins hold route
/// and snapshot names; body pins hold
/// raw JSON bytes; case pins hold grid
/// case names; scope pins hold replay
/// scope; count pins hold ints tallied
/// from guards and call sites.
/// mode-installed pins installed
/// release (L273); mode-staged pins
/// staged bundle (L271); bun-version
/// pins 1.4.2 (L188); bun-revision pins
/// the forty hex digit identity
/// (L188); platform-darwin pins darwin
/// (L191); arch-arm64 pins arm64
/// (L191); platform-linux pins linux
/// (L193); arch-x64 pins x64 (L193);
/// save-path pins the save route
/// (L318); save-body pins the save
/// bytes (L319); op-id pins
/// op-gate4-disc (L319); cookie-header
/// pins the session cookie (L320);
/// changed-body pins the changed bytes
/// (L355); replay-case pins
/// invoice_contract::grid_saved (L351);
/// conflict-case pins
/// invoice_contract::grid_conflict
/// (L360); conflict-message pins stale
/// revision (L360); invoice-title pins
/// the saved title bytes (L339);
/// invoice-settled pins the settled
/// note (L373); actor-alice pins alice
/// (L341); tenant-id pins 1 (L341);
/// invoice-id pins 7 (L341);
/// invoice-snapshot pins
/// snapshot-gate4-invoice (L315);
/// invoice-port pins int (18611) from
/// L56; replay-status pins int (200)
/// from L348; conflict-status pins int
/// (409) from L357; replay-rows pins
/// int (1) from L344; poll-timeout-s
/// pins int (20) from L321;
/// poll-interval-ms pins int (250) from
/// L336; abandon-dial-s pins int (10)
/// from L212.
/// Facet map (leg order): mode-installed,
/// mode-staged, bun-version,
/// bun-revision, platform-darwin,
/// arch-arm64, platform-linux, arch-x64,
/// save-path, save-body, op-id,
/// cookie-header, changed-body,
/// replay-case, conflict-case,
/// conflict-message, invoice-title,
/// invoice-settled, actor-alice,
/// tenant-id, invoice-id,
/// invoice-snapshot, invoice-port,
/// replay-status, conflict-status,
/// replay-rows, poll-timeout-s,
/// poll-interval-ms, abandon-dial-s.
/// The webhook plus stream legs live in
/// life-009-roots-green.can; the suite
/// plus run shape lives in
/// life-009-run-shape.can.
/// Variants: installed release on
/// linux/amd64, staged bundle on other
/// hosts; default plus seeded drifts
/// only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle or installed release
/// (row lists two gates; bind at P23;
/// no live run now).
/// Logical gates ARCHIVE plus FAULT
/// bind at P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live thirty
/// minute hold is pinned in the run
/// slice; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none in this
/// file (six live in the run slice).
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/fault-matrix-base
/// checks: mode-installed,
/// mode-staged, bun-version,
/// bun-revision, platform-darwin,
/// arch-arm64, platform-linux, arch-x64,
/// save-path, save-body, op-id,
/// cookie-header, changed-body,
/// replay-case, conflict-case,
/// conflict-message, invoice-title,
/// invoice-settled, actor-alice,
/// tenant-id, invoice-id,
/// invoice-snapshot, invoice-port,
/// replay-status, conflict-status,
/// replay-rows, poll-timeout-s,
/// poll-interval-ms, abandon-dial-s.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str mode_installed
    str mode_staged
    str bun_version
    str bun_revision
    str platform_darwin
    str arch_arm64
    str platform_linux
    str arch_x64
    str save_path
    str save_body
    str op_id
    str cookie_header
    str changed_body
    str replay_case
    str conflict_case
    str conflict_message
    str invoice_title
    str invoice_settled
    str actor_alice
    str tenant_id
    str invoice_id
    str invoice_snapshot
    int invoice_port
    int replay_status
    int conflict_status
    int replay_rows
    int poll_timeout_s
    int poll_interval_ms
    int abandon_dial_s
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/fault-matrix-base", "default", "", "offline"), "mode-installed" => ok "case life/fault-matrix-base variant default root mode-installed run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/fault-matrix-base", "default", "", "offline"), "mode-installed" => ok evidence("mode-installed", "true", "true", true, "case life/fault-matrix-base variant default root mode-installed run offline")
        different: false, true, context("life/fault-matrix-base", "default", "", "offline"), "mode-installed" => failed{"mode-installed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 18611, 18611, context("life/fault-matrix-base", "default", "", "offline"), "invoice-port" => ok evidence("invoice-port", "18611", "18611", true, "case life/fault-matrix-base variant default root invoice-port run offline")
        different: 18610, 18611, context("life/fault-matrix-base", "default", "", "offline"), "invoice-port" => failed{"invoice-port"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "installed release", "installed release", context("life/fault-matrix-base", "default", "", "offline"), "mode-installed" => ok evidence("mode-installed", "installed release", "installed release", true, "case life/fault-matrix-base variant default root mode-installed run offline")
        different: "installed release_2", "installed release", context("life/fault-matrix-base", "default", "", "offline"), "mode-installed" => failed{"mode-installed"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
