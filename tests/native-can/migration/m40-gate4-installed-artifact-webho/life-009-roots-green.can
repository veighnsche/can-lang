package m40life009roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-009 TestGate4FaultMatrix
/// webhook plus stream legs.
/// Source: tests/integration/
/// gate4_fault_test.go symbol
/// TestGate4FaultMatrix (L261-526):
/// the trickled delivery plus SIGTERM
/// restart plus stream funnel pins.
/// Disposition: migrate (same row pact
/// as the base slice; this file owns
/// the webhook plus stream legs only).
/// Protects (this file): facet three
/// (trickled signed delivery accepted
/// once; SIGTERM drain and restart keep
/// duplicate and new-delivery shape)
/// and facet four (native stream
/// read-plus-close succeeds; missing
/// input fails with a diagnostic).
/// ADAPTATION (recorded, with source
/// lines): seal pins hold the provider
/// and carrier seal bytes; body pins
/// hold raw JSON bytes; path pins hold
/// route and file names; event pins
/// hold delivery names; settled pins
/// hold leg notes; count pins hold ints
/// tallied from guards and call sites.
/// webhook-secret pins
/// whsec-gate4-fault-matrix (L399);
/// carrier-secret pins
/// carrier-gate4-fault-matrix (L401);
/// webhook-snapshot pins
/// snapshot-webhook (L400); slow-body
/// pins the slow delivery bytes
/// (L406); provider-path pins
/// /webhooks/provider (L407);
/// signature-header pins
/// X-Provider-Signature (L411);
/// accepted-body pins the accepted
/// bytes (L419); duplicate-body pins
/// the duplicate bytes (L433);
/// after-body pins the new delivery
/// bytes (L436); webhook-settled pins
/// the settled note (L449);
/// stream-lines pins the three line
/// bytes (L458); stream-counted pins 3
/// (L462); stream-settled pins the
/// settled note (L475); event-name
/// pins invoice.paid (L406);
/// subscription-name pins sub-9 (L406);
/// webhook-db pins hook.sqlite (L391);
/// stream-file pins lines.txt (L457);
/// missing-file pins missing.txt
/// (L465); webhook-schema pins
/// schema.sql (L392); webhook-port pins
/// int (18612) from L57; webhook-tables
/// pins int (5) from L396; trickle-chunk
/// pins int (8) from L407;
/// trickle-delay-ms pins int (100) from
/// L407; ledger-rows pins int (2) from
/// L441; outbox-rows pins int (2) from
/// L441; webhook-status pins int (200)
/// from L419.
/// Facet map (leg order): webhook-secret,
/// carrier-secret, webhook-snapshot,
/// slow-body, provider-path,
/// signature-header, accepted-body,
/// duplicate-body, after-body,
/// webhook-settled, stream-lines,
/// stream-counted, stream-settled,
/// event-name, subscription-name,
/// webhook-db, stream-file,
/// missing-file, webhook-schema,
/// webhook-port, webhook-tables,
/// trickle-chunk, trickle-delay-ms,
/// ledger-rows, outbox-rows,
/// webhook-status.
/// The identity plus invoice legs live
/// in life-009-base-semantics.can; the
/// suite plus run shape lives in
/// life-009-run-shape.can.
/// Variants: disconnect, trickle,
/// terminate and stream legs; default
/// plus seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus
/// loopback ports plus disposable
/// SQLite (row lists two gates; bind at
/// P23; no live run now).
/// Logical gates FAULT plus DB bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none in this
/// file (six live in the run slice).
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/fault-matrix-roots
/// checks: webhook-secret,
/// carrier-secret, webhook-snapshot,
/// slow-body, provider-path,
/// signature-header, accepted-body,
/// duplicate-body, after-body,
/// webhook-settled, stream-lines,
/// stream-counted, stream-settled,
/// event-name, subscription-name,
/// webhook-db, stream-file,
/// missing-file, webhook-schema,
/// webhook-port, webhook-tables,
/// trickle-chunk, trickle-delay-ms,
/// ledger-rows, outbox-rows,
/// webhook-status.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str webhook_secret
    str carrier_secret
    str webhook_snapshot
    str slow_body
    str provider_path
    str signature_header
    str accepted_body
    str duplicate_body
    str after_body
    str webhook_settled
    str stream_lines
    str stream_counted
    str stream_settled
    str event_name
    str subscription_name
    str webhook_db
    str stream_file
    str missing_file
    str webhook_schema
    int webhook_port
    int webhook_tables
    int trickle_chunk
    int trickle_delay_ms
    int ledger_rows
    int outbox_rows
    int webhook_status
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/fault-matrix-roots", "default", "", "offline"), "webhook-secret" => ok "case life/fault-matrix-roots variant default root webhook-secret run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/fault-matrix-roots", "default", "", "offline"), "webhook-secret" => ok evidence("webhook-secret", "true", "true", true, "case life/fault-matrix-roots variant default root webhook-secret run offline")
        different: false, true, context("life/fault-matrix-roots", "default", "", "offline"), "webhook-secret" => failed{"webhook-secret"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 18612, 18612, context("life/fault-matrix-roots", "default", "", "offline"), "webhook-port" => ok evidence("webhook-port", "18612", "18612", true, "case life/fault-matrix-roots variant default root webhook-port run offline")
        different: 18611, 18612, context("life/fault-matrix-roots", "default", "", "offline"), "webhook-port" => failed{"webhook-port"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "whsec-gate4-fault-matrix", "whsec-gate4-fault-matrix", context("life/fault-matrix-roots", "default", "", "offline"), "webhook-secret" => ok evidence("webhook-secret", "whsec-gate4-fault-matrix", "whsec-gate4-fault-matrix", true, "case life/fault-matrix-roots variant default root webhook-secret run offline")
        different: "whsec-gate4-fault-matrix_2", "whsec-gate4-fault-matrix", context("life/fault-matrix-roots", "default", "", "offline"), "webhook-secret" => failed{"webhook-secret"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
