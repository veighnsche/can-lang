package m40life009run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-009 TestGate4FaultMatrix
/// suite plus run shape.
/// Source: tests/integration/
/// gate4_fault_test.go symbol
/// TestGate4FaultMatrix (L261-526): env
/// gate, staged or installed host,
/// abortable plus limitation report,
/// per-leg shape, then six named
/// runtime suites must each pass with
/// zero fail.
/// Disposition: migrate (same row pact
/// as the base slice; this file owns
/// the suite plus run shape only).
/// Protects (this file): facet five
/// (delegated shutdown, owner, server,
/// transport-owned, transport-late and
/// coordination shape with recorded
/// limitations) plus the run envelope
/// (archive gate, host log, sidecar
/// paths, driver paths, harness words,
/// report lists, leg joins).
/// ADAPTATION (recorded, with source
/// lines): env pins hold the archive
/// var and skip note; suite pins hold
/// suite file names; probe pins hold
/// the openssl probe; guard pins hold
/// the pass-count shape; settled pins
/// hold leg notes; abortable pins hold
/// report lines; limitation pins hold
/// report lines; log pins hold log
/// shapes; rel pins hold sidecar and
/// driver paths; command pins hold
/// harness words; app pins hold staged
/// app names; count pins hold ints
/// tallied from lists and call sites.
/// env-name pins CAN_BUN_ARCHIVE
/// (L263); skip-note pins the skip
/// note (L265); suite-shutdown pins
/// shutdown.test.ts (L484); suite-owner
/// pins owner.test.ts (L484);
/// suite-server pins server.test.ts
/// (L484); suite-transport-owned pins
/// transport-owned.test.ts (L484);
/// suite-transport-late pins
/// transport-late.test.ts (L484);
/// suite-coordination pins
/// coordination.test.ts (L484);
/// openssl-probe pins the probe line
/// (L488); server-skip-limitation pins
/// the server skip note (L493);
/// pass-pattern pins the pass-count
/// shape (L250); fail-word pins fail
/// (L247); zero-fail pins 0 fail
/// (L247); shutdown-settled pins the
/// settled note (L517); abortable-one
/// pins the first abortable (L285);
/// abortable-two pins the second
/// abortable (L286); abortable-three
/// pins the third abortable (L287);
/// limitation-one pins the first
/// limitation (L290); limitation-two
/// pins the second limitation (L291);
/// limitation-three pins the third
/// limitation (L292); host-log-line
/// pins the host log shape (L277);
/// report-log-line pins the report log
/// shape (L525); bunfig-rel pins
/// tools/runtime/bunfig.toml (L504);
/// runtime-test-rel pins runtime/test
/// (L505); invoice-driver-rel pins
/// tests/integration/testdata/invoice/driver.ts
/// (L312); webhook-driver-rel pins
/// tests/integration/testdata/webhook/driver.ts
/// (L390); command-assert pins assert
/// (L91); command-build pins build
/// (L122); command-runtime-check pins
/// runtime-check (L174); evidence-real
/// pins real-can (L106); entry-file
/// pins entry.ts (L316); health-path
/// pins /health (L316); app-invoice
/// pins invoice (L299); app-webhook
/// pins webhook (L380); app-stream pins
/// stream (L455); timeout-minutes pins
/// int (30) from L268; suite-count pins
/// int (6) from L484;
/// suite-count-no-openssl pins int (5)
/// from L492; abortable-count pins int
/// (3) from L284; limitation-count pins
/// int (3) from L289; leg-count pins
/// int (4) from the four leg joins;
/// failed-count pins int (0) from
/// L516.
/// Facet map (declared order): env-name,
/// skip-note, suite-shutdown,
/// suite-owner, suite-server,
/// suite-transport-owned,
/// suite-transport-late,
/// suite-coordination, openssl-probe,
/// server-skip-limitation, pass-pattern,
/// fail-word, zero-fail,
/// shutdown-settled, abortable-one,
/// abortable-two, abortable-three,
/// limitation-one, limitation-two,
/// limitation-three, host-log-line,
/// report-log-line, bunfig-rel,
/// runtime-test-rel, invoice-driver-rel,
/// webhook-driver-rel, command-assert,
/// command-build, command-runtime-check,
/// evidence-real, entry-file,
/// health-path, app-invoice, app-webhook,
/// app-stream, timeout-minutes,
/// suite-count, suite-count-no-openssl,
/// abortable-count, limitation-count,
/// leg-count, failed-count.
/// The identity plus invoice legs live
/// in life-009-base-semantics.can; the
/// webhook plus stream legs live in
/// life-009-roots-green.can.
/// Variants: six delegated runtime
/// suites, five when the host has no
/// openssl; default plus seeded drifts
/// only here.
/// Environment: CAN_BUN_ARCHIVE
/// required; no archive skips; openssl
/// absence skips server.test.ts with a
/// recorded limitation (row lists two
/// gates; bind at P23; no live run
/// now).
/// Logical gates ARCHIVE plus FAULT
/// plus CHILD bind at P23; no live run
/// now.
/// Timeout 120000ms is the offline
/// default bound (the live thirty
/// minute hold is pinned here as
/// timeout-minutes; binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: DELEGATE-009
/// coordination, DELEGATE-016 owner,
/// DELEGATE-019 server, DELEGATE-020
/// shutdown, DELEGATE-026
/// transport-late, DELEGATE-028
/// transport-owned; expected pass with
/// zero fail under the artifact
/// sidecar; server conditional on host
/// openssl; suites read, never run.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/fault-matrix-run
/// checks: env-name,
/// skip-note, suite-shutdown,
/// suite-owner, suite-server,
/// suite-transport-owned,
/// suite-transport-late,
/// suite-coordination, openssl-probe,
/// server-skip-limitation, pass-pattern,
/// fail-word, zero-fail,
/// shutdown-settled, abortable-one,
/// abortable-two, abortable-three,
/// limitation-one, limitation-two,
/// limitation-three, host-log-line,
/// report-log-line, bunfig-rel,
/// runtime-test-rel, invoice-driver-rel,
/// webhook-driver-rel, command-assert,
/// command-build, command-runtime-check,
/// evidence-real, entry-file,
/// health-path, app-invoice, app-webhook,
/// app-stream, timeout-minutes,
/// suite-count, suite-count-no-openssl,
/// abortable-count, limitation-count,
/// leg-count, failed-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_name
    str skip_note
    str suite_shutdown
    str suite_owner
    str suite_server
    str suite_transport_owned
    str suite_transport_late
    str suite_coordination
    str openssl_probe
    str server_skip_limitation
    str pass_pattern
    str fail_word
    str zero_fail
    str shutdown_settled
    str abortable_one
    str abortable_two
    str abortable_three
    str limitation_one
    str limitation_two
    str limitation_three
    str host_log_line
    str report_log_line
    str bunfig_rel
    str runtime_test_rel
    str invoice_driver_rel
    str webhook_driver_rel
    str command_assert
    str command_build
    str command_runtime_check
    str evidence_real
    str entry_file
    str health_path
    str app_invoice
    str app_webhook
    str app_stream
    int timeout_minutes
    int suite_count
    int suite_count_no_openssl
    int abortable_count
    int limitation_count
    int leg_count
    int failed_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/fault-matrix-run", "default", "", "offline"), "env-name" => ok "case life/fault-matrix-run variant default root env-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/fault-matrix-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "true", "true", true, "case life/fault-matrix-run variant default root env-name run offline")
        different: false, true, context("life/fault-matrix-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 30, 30, context("life/fault-matrix-run", "default", "", "offline"), "timeout-minutes" => ok evidence("timeout-minutes", "30", "30", true, "case life/fault-matrix-run variant default root timeout-minutes run offline")
        different: 29, 30, context("life/fault-matrix-run", "default", "", "offline"), "timeout-minutes" => failed{"timeout-minutes"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("life/fault-matrix-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case life/fault-matrix-run variant default root env-name run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("life/fault-matrix-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
