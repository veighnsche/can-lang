package m40life010base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-010 TestWebhookSliceLive
/// provider plus carrier legs.
/// Source: tests/integration/
/// webhook_test.go symbol
/// TestWebhookSliceLive (L470-939):
/// the provider HMAC matrix and the
/// carrier auth matrix must each
/// answer every leg with its exact
/// status plus body while the store
/// keeps one ledger row plus one
/// outbox row.
/// Disposition: migrate (this row owns
/// the two auth matrices as reviewable
/// Can facts; the old go check stays
/// until the integrator retires it after
/// every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): facet one
/// (L535-580): exact-byte provider auth,
/// duplicate plus conflict, malformed
/// plus blank plus oversize refusal with
/// no added rows; facet two (L582-644):
/// carrier protocol plus auth plus stale
/// plus future plus shape plus budget
/// plus nonce rollback plus replay.
/// ADAPTATION (recorded, with source
/// lines): route pins hold paths; header
/// pins hold header names; payload pins
/// hold delivery bytes; body pins hold
/// answer bytes; note pins hold remark
/// lines; status pins hold ints from the
/// named assert lines; span pins hold
/// ints from the named build lines.
/// provider-route pins
/// /webhooks/provider (helper L94);
/// provider-sig-header pins
/// X-Provider-Signature (helper L99);
/// first-payload pins the del-1
/// invoice.paid bytes (L544);
/// accept-body pins the accepted bytes
/// (L545); duplicate-body pins the
/// duplicate bytes (L554); conflict-body
/// pins the conflict bytes (L558);
/// unauthorized-body pins the
/// unauthorized bytes (L561);
/// malformed-input pins not json (L567);
/// invalid-body pins the invalid_body
/// bytes (L567); empty-id-payload pins
/// the blank id bytes (L570);
/// too-large-body pins the body_too_large
/// bytes (L574); carrier-claim-path pins
/// /outbox/claim (helper L239);
/// carrier-unsupported-body pins the
/// unsupported_protocol bytes (L593);
/// carrier-unauth-body pins the carrier
/// unauthorized bytes (L600);
/// carrier-stale-body pins the stale
/// bytes (L609); carrier-shape-body pins
/// the invalid_shape bytes (L619);
/// carrier-large-body pins the carrier
/// body_too_large bytes (L624);
/// carrier-unknown-body pins the unknown
/// heartbeat bytes (L637); carrier-worker
/// pins worker-A (L592); nonce-commit-note
/// pins the commit remark (L629);
/// provider-ok-status pins int (200) from
/// L545; provider-conflict-status pins
/// int (409) from L558;
/// provider-unauth-status pins int (401)
/// from L561; provider-invalid-status
/// pins int (400) from L567;
/// provider-large-status pins int (413)
/// from L574; carrier-unsupported-status
/// pins int (400) from L593;
/// carrier-unauth-status pins int (401)
/// from L600; carrier-stale-status pins
/// int (401) from L609; carrier-shape-status
/// pins int (400) from L619;
/// carrier-large-status pins int (413)
/// from L624; carrier-unknown-status pins
/// int (404) from L637;
/// carrier-stale-window-ms pins int
/// (600000) from L607; carrier-lease-ms
/// pins int (60000) from L592;
/// carrier-bad-lease-ms pins int (999)
/// from L617; carrier-huge-worker-len
/// pins int (2000) from L622;
/// oversize-pad-len pins int (9000) from
/// L573.
/// Facet map (leg order): provider-route,
/// provider-sig-header, first-payload,
/// accept-body, duplicate-body,
/// conflict-body, unauthorized-body,
/// malformed-input, invalid-body,
/// empty-id-payload, too-large-body,
/// carrier-claim-path,
/// carrier-unsupported-body,
/// carrier-unauth-body, carrier-stale-body,
/// carrier-shape-body, carrier-large-body,
/// carrier-unknown-body, carrier-worker,
/// nonce-commit-note, provider-ok-status,
/// provider-conflict-status,
/// provider-unauth-status,
/// provider-invalid-status,
/// provider-large-status,
/// carrier-unsupported-status,
/// carrier-unauth-status, carrier-stale-status,
/// carrier-shape-status, carrier-large-status,
/// carrier-unknown-status,
/// carrier-stale-window-ms, carrier-lease-ms,
/// carrier-bad-lease-ms,
/// carrier-huge-worker-len, oversize-pad-len.
/// The claim plus poison legs live in
/// life-010-roots-green.can; the crash
/// plus batch plus harness shape lives in
/// life-010-run-shape.can.
/// Variants: provider invalid signatures
/// plus bodies; carrier protocol plus auth
/// plus nonce cases; default plus seeded
/// drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes plus
/// loopback ports plus a disposable file
/// (row lists three gates; bind at P23;
/// no live run now).
/// Logical gates ARCHIVE plus PEER plus
/// DB plus CHILD plus CLOCK bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live ten minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/webhook-base
/// checks: provider-route,
/// provider-sig-header, first-payload,
/// accept-body, duplicate-body,
/// conflict-body, unauthorized-body,
/// malformed-input, invalid-body,
/// empty-id-payload, too-large-body,
/// carrier-claim-path,
/// carrier-unsupported-body,
/// carrier-unauth-body, carrier-stale-body,
/// carrier-shape-body, carrier-large-body,
/// carrier-unknown-body, carrier-worker,
/// nonce-commit-note, provider-ok-status,
/// provider-conflict-status,
/// provider-unauth-status,
/// provider-invalid-status,
/// provider-large-status,
/// carrier-unsupported-status,
/// carrier-unauth-status, carrier-stale-status,
/// carrier-shape-status, carrier-large-status,
/// carrier-unknown-status,
/// carrier-stale-window-ms, carrier-lease-ms,
/// carrier-bad-lease-ms,
/// carrier-huge-worker-len, oversize-pad-len.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str provider_route
    str provider_sig_header
    str first_payload
    str accept_body
    str duplicate_body
    str conflict_body
    str unauthorized_body
    str malformed_input
    str invalid_body
    str empty_id_payload
    str too_large_body
    str carrier_claim_path
    str carrier_unsupported_body
    str carrier_unauth_body
    str carrier_stale_body
    str carrier_shape_body
    str carrier_large_body
    str carrier_unknown_body
    str carrier_worker
    str nonce_commit_note
    int provider_ok_status
    int provider_conflict_status
    int provider_unauth_status
    int provider_invalid_status
    int provider_large_status
    int carrier_unsupported_status
    int carrier_unauth_status
    int carrier_stale_status
    int carrier_shape_status
    int carrier_large_status
    int carrier_unknown_status
    int carrier_stale_window_ms
    int carrier_lease_ms
    int carrier_bad_lease_ms
    int carrier_huge_worker_len
    int oversize_pad_len
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/webhook-base", "default", "", "offline"), "provider-route" => ok "case life/webhook-base variant default root provider-route run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/webhook-base", "default", "", "offline"), "provider-route" => ok evidence("provider-route", "true", "true", true, "case life/webhook-base variant default root provider-route run offline")
        different: false, true, context("life/webhook-base", "default", "", "offline"), "provider-route" => failed{"provider-route"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 200, 200, context("life/webhook-base", "default", "", "offline"), "provider-ok-status" => ok evidence("provider-ok-status", "200", "200", true, "case life/webhook-base variant default root provider-ok-status run offline")
        different: 199, 200, context("life/webhook-base", "default", "", "offline"), "provider-ok-status" => failed{"provider-ok-status"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/webhooks/provider", "/webhooks/provider", context("life/webhook-base", "default", "", "offline"), "provider-route" => ok evidence("provider-route", "/webhooks/provider", "/webhooks/provider", true, "case life/webhook-base variant default root provider-route run offline")
        different: "/webhooks/provider_2", "/webhooks/provider", context("life/webhook-base", "default", "", "offline"), "provider-route" => failed{"provider-route"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
