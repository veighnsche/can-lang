        true => ok test_case("life/webhook-roots", ["life", "m40"], [], 120000, [check_ref("heartbeat-path"), check_ref("ack-path"), check_ref("dead-letter-path"), check_ref("claimed-word"), check_ref("empty-word"), check_ref("done-one-body"), check_ref("pending-one-body"), check_ref("replay-body"), check_ref("extended-prefix"), check_ref("lease-lost-body"), check_ref("unknown-attempts-body"), check_ref("pending-prefix"), check_ref("dead-five-body"), check_ref("already-done-body"), check_ref("poison-word"), check_ref("delivered-word"), check_ref("rival-note"), check_ref("reclaim-note"), check_ref("done-note"), check_ref("short-lease-ms"), check_ref("lease-sleep-ms"), check_ref("claim-version-one"), check_ref("reclaim-version-two"), check_ref("poison-failures"), check_ref("foreign-heartbeat-status")], callable case_body)
