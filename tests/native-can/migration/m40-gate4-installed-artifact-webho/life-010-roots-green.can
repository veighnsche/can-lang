                                                                failed
                                                                ok evidence already_done_body_evidence => match call require_text(got.poison_word, "poison", c, "poison-word")
                                                                    failed
                                                                    ok evidence poison_word_evidence => match call require_text(got.delivered_word, "delivered", c, "delivered-word")
                                                                        failed
                                                                        ok evidence delivered_word_evidence => match call require_text(got.rival_note, "rival claim while held", c, "rival-note")
                                                                            failed
                                                                            ok evidence rival_note_evidence => match call require_text(got.reclaim_note, "reclaim after expiry", c, "reclaim-note")
                                                                                failed
                                                                                ok evidence reclaim_note_evidence => match call require_text(got.done_note, "heartbeat after done", c, "done-note")
                                                                                    failed
                                                                                    ok evidence done_note_evidence => match call require_int(got.short_lease_ms, 1000, c, "short-lease-ms")
                                                                                        failed
                                                                                        ok evidence short_lease_ms_evidence => match call require_int(got.lease_sleep_ms, 1200, c, "lease-sleep-ms")
                                                                                            failed
                                                                                            ok evidence lease_sleep_ms_evidence => match call require_int(got.claim_version_one, 1, c, "claim-version-one")
                                                                                                failed
                                                                                                ok evidence claim_version_one_evidence => match call require_int(got.reclaim_version_two, 2, c, "reclaim-version-two")
                                                                                                    failed
                                                                                                    ok evidence reclaim_version_two_evidence => match call require_int(got.poison_failures, 5, c, "poison-failures")
                                                                                                        failed
                                                                                                        ok evidence poison_failures_evidence => match call require_int(got.foreign_heartbeat_status, 409, c, "foreign-heartbeat-status")
                                                                                                            failed
                                                                                                            ok evidence foreign_heartbeat_status_evidence => ok
