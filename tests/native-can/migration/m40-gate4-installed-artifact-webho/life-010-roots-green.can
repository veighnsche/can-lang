        seed_reclaim_note: context("life/webhook-roots", "seed-reclaim-note-drift", "", "offline") => failed{"reclaim-note"}
        seed_done_note: context("life/webhook-roots", "seed-done-note-drift", "", "offline") => failed{"done-note"}
