package m40life010roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-010 TestWebhookSliceLive
/// claim plus poison legs.
/// Source: tests/integration/
/// webhook_test.go symbol
/// TestWebhookSliceLive (L470-939):
/// one holder at a time must own each
/// outbox row across claim plus lease
/// plus heartbeat plus ack, and five
/// failures must bury a row where all
/// replays converge.
/// Disposition: migrate (same row pact as
/// the base slice; this file owns the
/// claim plus poison legs only).
/// Protects (this file): facet three
/// (L646-741): claim exclusivity, leases,
/// failure plus reclaim, heartbeat
/// version plus holder, terminal replay;
/// facet four (L743-778): poison
/// dead-letter after five failures,
/// duplicate ack plus dead-letter
/// idempotence, unknown plus already-done
/// cases.
/// ADAPTATION (recorded, with source
/// lines): path pins hold carrier paths;
/// word pins hold status plus reason
/// words; body pins hold answer bytes;
/// head pins hold answer prefixes; note
/// pins hold remark lines; lease pins
/// hold ints from the named claim lines;
/// version pins hold ints from the named
/// claim lines; bound pins hold ints
/// from the named loop lines.
/// heartbeat-path pins
/// /outbox/heartbeat (helper L254);
/// ack-path pins /outbox/ack (helper
/// L263); dead-letter-path pins
/// /outbox/dead_letter (helper L271);
/// claimed-word pins claimed (L660);
/// empty-word pins empty (L675);
/// done-one-body pins the done bytes
/// (L679); pending-one-body pins the
/// pending bytes (L703); replay-body
/// pins the replay bytes (L663);
/// extended-prefix pins the extended
/// head (L726); lease-lost-body pins the
/// lease_lost bytes (L729);
/// unknown-attempts-body pins the
/// unknown attempts bytes (L692);
/// pending-prefix pins the poison head
/// (L751); dead-five-body pins the dead
/// bytes (L756); already-done-body pins
/// the already_done bytes (L765);
/// poison-word pins poison (L753);
/// delivered-word pins delivered (L689);
/// rival-note pins the rival remark
/// (L676); reclaim-note pins the reclaim
/// remark (L712); done-note pins the
/// terminal remark (L740);
/// short-lease-ms pins int (1000) from
/// L700; lease-sleep-ms pins int (1200)
/// from L709; claim-version-one pins int
/// (1) from L667; reclaim-version-two
/// pins int (2) from L711;
/// poison-failures pins int (5) from
/// L750; foreign-heartbeat-status pins
/// int (409) from L732.
/// Facet map (leg order): heartbeat-path,
/// ack-path, dead-letter-path,
/// claimed-word, empty-word,
/// done-one-body, pending-one-body,
/// replay-body, extended-prefix,
/// lease-lost-body, unknown-attempts-body,
/// pending-prefix, dead-five-body,
/// already-done-body, poison-word,
/// delivered-word, rival-note,
/// reclaim-note, done-note,
/// short-lease-ms, lease-sleep-ms,
/// claim-version-one, reclaim-version-two,
/// poison-failures, foreign-heartbeat-status.
/// The provider plus carrier legs live in
/// life-010-base-semantics.can; the crash
/// plus batch plus harness shape lives in
/// life-010-run-shape.can.
/// Variants: claim plus heartbeat plus
/// ack plus dead-letter; default plus
/// seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes plus
/// loopback ports plus a disposable file
/// (row lists three gates; bind at P23;
/// no live run now).
/// Logical gates ARCHIVE plus PEER plus
/// DB plus CHILD plus CLOCK bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live ten minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/webhook-roots
/// checks: heartbeat-path,
/// ack-path, dead-letter-path,
/// claimed-word, empty-word,
/// done-one-body, pending-one-body,
/// replay-body, extended-prefix,
/// lease-lost-body, unknown-attempts-body,
/// pending-prefix, dead-five-body,
/// already-done-body, poison-word,
/// delivered-word, rival-note,
/// reclaim-note, done-note,
/// short-lease-ms, lease-sleep-ms,
/// claim-version-one, reclaim-version-two,
/// poison-failures, foreign-heartbeat-status.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str heartbeat_path
    str ack_path
    str dead_letter_path
    str claimed_word
    str empty_word
    str done_one_body
    str pending_one_body
    str replay_body
    str extended_prefix
    str lease_lost_body
    str unknown_attempts_body
    str pending_prefix
    str dead_five_body
    str already_done_body
    str poison_word
    str delivered_word
    str rival_note
    str reclaim_note
    str done_note
    int short_lease_ms
    int lease_sleep_ms
    int claim_version_one
    int reclaim_version_two
    int poison_failures
    int foreign_heartbeat_status
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/webhook-roots", "default", "", "offline"), "heartbeat-path" => ok "case life/webhook-roots variant default root heartbeat-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/webhook-roots", "default", "", "offline"), "heartbeat-path" => ok evidence("heartbeat-path", "true", "true", true, "case life/webhook-roots variant default root heartbeat-path run offline")
        different: false, true, context("life/webhook-roots", "default", "", "offline"), "heartbeat-path" => failed{"heartbeat-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1000, 1000, context("life/webhook-roots", "default", "", "offline"), "short-lease-ms" => ok evidence("short-lease-ms", "1000", "1000", true, "case life/webhook-roots variant default root short-lease-ms run offline")
        different: 999, 1000, context("life/webhook-roots", "default", "", "offline"), "short-lease-ms" => failed{"short-lease-ms"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "/outbox/heartbeat", "/outbox/heartbeat", context("life/webhook-roots", "default", "", "offline"), "heartbeat-path" => ok evidence("heartbeat-path", "/outbox/heartbeat", "/outbox/heartbeat", true, "case life/webhook-roots variant default root heartbeat-path run offline")
        different: "/outbox/heartbeat_2", "/outbox/heartbeat", context("life/webhook-roots", "default", "", "offline"), "heartbeat-path" => failed{"heartbeat-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("/outbox/heartbeat", "/outbox/ack", "/outbox/dead_letter", "claimed", "empty", "{\"status\":\"done\",\"attempts\":1}", "{\"status\":\"pending\",\"attempts\":1}", "{\"status\":\"replay\",\"items\":[]}", "{\"status\":\"extended\",\"lease_until_ms\":", "{\"status\":\"lease_lost\",\"lease_until_ms\":0,\"version\":0,\"attempts\":0}", "{\"status\":\"unknown\",\"attempts\":0}", "{\"status\":\"pending\",\"attempts\":", "{\"status\":\"dead\",\"attempts\":5}", "{\"status\":\"already_done\",\"attempts\":1}", "poison", "delivered", "rival claim while held", "reclaim after expiry", "heartbeat after done", 1000, 1200, 1, 2, 5, 409)
