package m40life010run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-010 TestWebhookSliceLive
/// crash plus batch plus harness legs.
/// Source: tests/integration/
/// webhook_test.go symbol
/// TestWebhookSliceLive (L470-939):
/// each crash leg must converge to one
/// ledger effect with honest downstream
/// receipts, the batch pair must claim
/// plus settle in turn, and the harness
/// must gate plus stage plus serve plus
/// report the run.
/// Disposition: migrate (same row pact as
/// the base slice; this file owns the
/// crash plus batch plus harness legs
/// only).
/// Protects (this file): facet five
/// (L780-903): crash before ack gives
/// at-least-once downstream delivery
/// with one ledger effect, inflight
/// crash converges; facet six
/// (L905-931): two pending rows claim
/// plus settle without a candidate-read
/// failure; harness (L470-533, L933-939):
/// archive gate, staged bundle, driver
/// setup, served entry, stub receipts,
/// pair report.
/// ADAPTATION (recorded, with source
/// lines): name pins hold env plus file
/// names; path pins hold route plus
/// driver paths; payload pins hold
/// delivery bytes; note pins hold remark
/// lines; mark pins hold report marks;
/// count pins hold ints from the named
/// assert lines; line pins hold source
/// line numbers for the two signing
/// loci (bytes stay in the source and
/// are never quoted here).
/// archive-env pins CAN_BUN_ARCHIVE
/// (L472); skip-note pins the skip
/// remark (L474); timeout-call pins
/// 10*time.Minute (L477); driver-rel
/// pins the driver path (L514); db-name
/// pins hook.sqlite (L515);
/// snapshot-name pins snapshot-webhook
/// (L526); entry-name pins entry.ts
/// (L529); schema-name pins schema.sql
/// (L516); health-path pins /health
/// (helper L354); real-mark pins
/// real-can (L500); pair-log pins the
/// pair head (L937); seventh-payload
/// pins the del-A bytes (L907);
/// eighth-payload pins the del-B bytes
/// (L908); inflight-note pins the
/// inflight remark (L863); converge-note
/// pins the converge remark (L882);
/// crash-kill-note pins SIGKILL (L9);
/// seventh-note pins the seventh remark
/// (L912); eighth-note pins the eighth
/// remark (L915); webhook-port pins int
/// (18494) from L36; setup-tables pins
/// int (5) from L520;
/// live-timeout-minutes pins int (10)
/// from L477; crash-count pins int (3)
/// from L782 plus L804 plus L858;
/// crash-ledger-four pins int (4) from
/// L789; crash-outbox-four pins int (4)
/// from L789; stub-del5-two pins int (2)
/// from L818; ledger-del5-one pins int
/// (1) from L828; attempts-del5-one pins
/// int (1) from L840;
/// converged-ledger-six pins int (6)
/// from L885; del6-outbox-one pins int
/// (1) from L894; converge-retries pins
/// int (3) from L868; batch-ledger-eight
/// pins int (8) from L929;
/// batch-outbox-eight pins int (8) from
/// L929; stub-del1-one pins int (1) from
/// L934; provider-sign-line pins int
/// (524); carrier-sign-line pins int
/// (525).
/// Related driver:
/// tests/integration/testdata/webhook/
/// driver.ts applies five schema
/// statements (setup) and reports ledger
/// plus outbox plus attempt plus
/// dead-letter plus nonce rows
/// (inspect); the run pins the driver
/// path plus the table count above.
/// Facet map (leg order): archive-env,
/// skip-note, timeout-call, driver-rel,
/// db-name, snapshot-name, entry-name,
/// schema-name, health-path, real-mark,
/// pair-log, seventh-payload,
/// eighth-payload, inflight-note,
/// converge-note, crash-kill-note,
/// seventh-note, eighth-note,
/// webhook-port, setup-tables,
/// live-timeout-minutes, crash-count,
/// crash-ledger-four, crash-outbox-four,
/// stub-del5-two, ledger-del5-one,
/// attempts-del5-one, converged-ledger-six,
/// del6-outbox-one, converge-retries,
/// batch-ledger-eight, batch-outbox-eight,
/// stub-del1-one, provider-sign-line,
/// carrier-sign-line.
/// The provider plus carrier legs live in
/// life-010-base-semantics.can; the claim
/// plus poison legs live in
/// life-010-roots-green.can.
/// Variants: between-delivery plus
/// unacked plus inflight crash; two-row
/// batch; default plus seeded drifts
/// only here.
/// Environment: CAN_BUN_ARCHIVE plus a
/// staged bundle plus cut-off homes plus
/// loopback ports plus a disposable file
/// (row lists three gates; bind at P23;
/// no live run now).
/// Logical gates ARCHIVE plus PEER plus
/// DB plus CHILD plus CLOCK bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live ten minute hold is
/// pinned above as live-timeout-minutes;
/// binds at P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Case life/webhook-run
/// checks: archive-env,
/// skip-note, timeout-call, driver-rel,
/// db-name, snapshot-name, entry-name,
/// schema-name, health-path, real-mark,
/// pair-log, seventh-payload,
/// eighth-payload, inflight-note,
/// converge-note, crash-kill-note,
/// seventh-note, eighth-note,
/// webhook-port, setup-tables,
/// live-timeout-minutes, crash-count,
/// crash-ledger-four, crash-outbox-four,
/// stub-del5-two, ledger-del5-one,
/// attempts-del5-one, converged-ledger-six,
/// del6-outbox-one, converge-retries,
/// batch-ledger-eight, batch-outbox-eight,
/// stub-del1-one, provider-sign-line,
/// carrier-sign-line.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str archive_env
    str skip_note
    str timeout_call
    str driver_rel
    str db_name
    str snapshot_name
    str entry_name
    str schema_name
    str health_path
    str real_mark
    str pair_log
    str seventh_payload
    str eighth_payload
    str inflight_note
    str converge_note
    str crash_kill_note
    str seventh_note
    str eighth_note
    int webhook_port
    int setup_tables
    int live_timeout_minutes
    int crash_count
    int crash_ledger_four
    int crash_outbox_four
    int stub_del5_two
    int ledger_del5_one
    int attempts_del5_one
    int converged_ledger_six
    int del6_outbox_one
    int converge_retries
    int batch_ledger_eight
    int batch_outbox_eight
    int stub_del1_one
    int provider_sign_line
    int carrier_sign_line
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/webhook-run", "default", "", "offline"), "archive-env" => ok "case life/webhook-run variant default root archive-env run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/webhook-run", "default", "", "offline"), "archive-env" => ok evidence("archive-env", "true", "true", true, "case life/webhook-run variant default root archive-env run offline")
        different: false, true, context("life/webhook-run", "default", "", "offline"), "archive-env" => failed{"archive-env"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 18494, 18494, context("life/webhook-run", "default", "", "offline"), "webhook-port" => ok evidence("webhook-port", "18494", "18494", true, "case life/webhook-run variant default root webhook-port run offline")
        different: 18493, 18494, context("life/webhook-run", "default", "", "offline"), "webhook-port" => failed{"webhook-port"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("life/webhook-run", "default", "", "offline"), "archive-env" => ok evidence("archive-env", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case life/webhook-run variant default root archive-env run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("life/webhook-run", "default", "", "offline"), "archive-env" => failed{"archive-env"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
