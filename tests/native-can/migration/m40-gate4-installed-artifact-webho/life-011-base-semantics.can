package m40life011base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-011 TestCompanionPairLiveF06
/// report shape plus auth leg.
/// Source: tests/integration/
/// webhook_f06_test.go symbol
/// TestCompanionPairLiveF06 (L550-1190):
/// the C-A report shape pins plus
/// the leg A auth pins.
/// Disposition: migrate (this row owns
/// the companion pair as reviewable Can
/// facts; the old go check stays until
/// the integrator retires it after
/// every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): facet one
/// (actual companion report step plus
/// failure plus occurrence shape and
/// redaction of secrets and URLs) and
/// the leg A half of facet two (wrong
/// carrier plus bad flag leave the row
/// untouched; one smoke row delivers).
/// ADAPTATION (recorded, with source
/// lines): shape pins hold the finite
/// report marks; probe pins hold the
/// wrong-carrier and bad-flag bytes;
/// count pins hold ints tallied from
/// maps and guards.
/// protocol-one pins 1 (L426);
/// worker-a pins worker-A (L659);
/// worker-b pins worker-B (L673);
/// outcome-delivered pins delivered
/// (L75); outcome-failed pins failed
/// (L75); outcome-dead pins dead (L75);
/// outcome-error pins error (L75);
/// ident-ok pins ok (L79);
/// ident-downstream-status pins
/// downstream-status (L79);
/// ident-downstream-transport pins
/// downstream-transport (L79);
/// ident-downstream-timeout pins
/// downstream-timeout (L80);
/// ident-credential-missing pins
/// credential-missing (L80);
/// ident-redirect-denied pins
/// redirect-denied (L81);
/// ident-redirect-hops pins
/// redirect-hops (L81); ident-poison
/// pins poison (L81);
/// ident-destination-denied pins
/// destination-denied (L82);
/// ident-no-destination pins
/// no-destination (L82);
/// ident-lease-lost pins lease-lost
/// (L82); ident-protocol-error pins
/// protocol-error (L83);
/// ident-store-unavailable pins
/// store-unavailable (L83); leak-http
/// pins http:// (L473); leak-https
/// pins https:// (L473); auth-prefix
/// pins f06-auth- (L648);
/// wrong-carrier-label pins
/// wrong-secret (L649); wrong-stderr
/// pins unauthorized (L650);
/// badflag-stderr pins usage: (L656);
/// badflag-value pins 5 (L655);
/// outbox-pending pins pending (L654);
/// ident-count pins int (13) tallied
/// from the L78-84 map keys (no 13
/// literal lives in source);
/// outcome-count pins int (4) tallied
/// from the L74-76 map keys;
/// wrong-exit pins int (1) from L650;
/// badflag-exit pins int (2) from L656;
/// auth-steps pins int (1) from L662.
/// The three live carrier values live
/// at L583-585; values withheld,
/// labels only, never quoted.
/// Facet map (declared order):
/// protocol-one, worker-a, worker-b,
/// outcome-delivered, outcome-failed,
/// outcome-dead, outcome-error,
/// ident-ok, ident-downstream-status,
/// ident-downstream-transport,
/// ident-downstream-timeout,
/// ident-credential-missing,
/// ident-redirect-denied,
/// ident-redirect-hops, ident-poison,
/// ident-destination-denied,
/// ident-no-destination,
/// ident-lease-lost,
/// ident-protocol-error,
/// ident-store-unavailable, leak-http,
/// leak-https, auth-prefix,
/// wrong-carrier-label, wrong-stderr,
/// badflag-stderr, badflag-value,
/// outbox-pending, ident-count,
/// outcome-count, wrong-exit,
/// badflag-exit, auth-steps.
/// The pair plus concurrency plus
/// poison plus destination plus
/// credential plus timeout legs live in
/// life-011-roots-green.can; the run
/// envelope plus crash plus batch plus
/// idle legs live in
/// life-011-run-shape.can.
/// Variants: A auth here; B pair, C
/// concurrency, D poison, E
/// destination, F credential and G
/// timeout in roots; H crash, W4.3
/// batch and I idle in run; default
/// plus seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus
/// staged bundle plus loopback plus
/// disposable SQLite (row lists four
/// gates; bind at P23; no live run
/// now).
/// Logical gates CHILD plus HTTP plus
/// PEER plus DB bind at P23; no live
/// run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none in this row.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 plus QD2 plus
/// QD4 accept gates unmet).
/// Case life/companion-pair-base
/// checks: protocol-one, worker-a,
/// worker-b, outcome-delivered,
/// outcome-failed, outcome-dead,
/// outcome-error, ident-ok,
/// ident-downstream-status,
/// ident-downstream-transport,
/// ident-downstream-timeout,
/// ident-credential-missing,
/// ident-redirect-denied,
/// ident-redirect-hops, ident-poison,
/// ident-destination-denied,
/// ident-no-destination,
/// ident-lease-lost,
/// ident-protocol-error,
/// ident-store-unavailable, leak-http,
/// leak-https, auth-prefix,
/// wrong-carrier-label, wrong-stderr,
/// badflag-stderr, badflag-value,
/// outbox-pending, ident-count,
/// outcome-count, wrong-exit,
/// badflag-exit, auth-steps.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str protocol_one
    str worker_a
    str worker_b
    str outcome_delivered
    str outcome_failed
    str outcome_dead
    str outcome_error
    str ident_ok
    str ident_downstream_status
    str ident_downstream_transport
    str ident_downstream_timeout
    str ident_credential_missing
    str ident_redirect_denied
    str ident_redirect_hops
    str ident_poison
    str ident_destination_denied
    str ident_no_destination
    str ident_lease_lost
    str ident_protocol_error
    str ident_store_unavailable
    str leak_http
    str leak_https
    str auth_prefix
    str wrong_carrier_label
    str wrong_stderr
    str badflag_stderr
    str badflag_value
    str outbox_pending
    int ident_count
    int outcome_count
    int wrong_exit
    int badflag_exit
    int auth_steps
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/companion-pair-base", "default", "", "offline"), "protocol-one" => ok "case life/companion-pair-base variant default root protocol-one run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/companion-pair-base", "default", "", "offline"), "protocol-one" => ok evidence("protocol-one", "true", "true", true, "case life/companion-pair-base variant default root protocol-one run offline")
        different: false, true, context("life/companion-pair-base", "default", "", "offline"), "protocol-one" => failed{"protocol-one"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 13, 13, context("life/companion-pair-base", "default", "", "offline"), "ident-count" => ok evidence("ident-count", "13", "13", true, "case life/companion-pair-base variant default root ident-count run offline")
        different: 12, 13, context("life/companion-pair-base", "default", "", "offline"), "ident-count" => failed{"ident-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "1", "1", context("life/companion-pair-base", "default", "", "offline"), "protocol-one" => ok evidence("protocol-one", "1", "1", true, "case life/companion-pair-base variant default root protocol-one run offline")
        different: "1_2", "1", context("life/companion-pair-base", "default", "", "offline"), "protocol-one" => failed{"protocol-one"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
