package m40life011roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-011 TestCompanionPairLiveF06
/// pair plus sized plus poison plus
/// destination plus credential plus
/// timeout legs.
/// Source: tests/integration/
/// webhook_f06_test.go symbol
/// TestCompanionPairLiveF06 (L550-1190):
/// the leg B pair pins, the leg C
/// sized pins, the leg D poison pins,
/// and the leg E plus F plus G
/// policy pins.
/// Disposition: migrate (same row pact
/// as the base slice; this file owns
/// the six middle legs only).
/// Protects (this file): the leg B
/// half of facet two (two workers
/// claim disjoint capped batches) plus
/// facet three (serial plus parallel
/// concurrency bounds; five-attempt
/// poison dead-letter with no sixth
/// send) plus facet four (destination
/// policy and credential binding
/// failures never post; timeout retry
/// stays truthful).
/// ADAPTATION (recorded, with source
/// lines): prefix pins hold seed id
/// heads; flag pins hold CLI words;
/// route pins hold subscription names;
/// mark pins hold report plus row
/// reason bytes; url pins hold the
/// denied peer; count pins hold ints
/// tallied from guards and call sites.
/// pair-prefix pins f06-pair- (L671);
/// dup-note pins claimed by (L702);
/// maxbatch-flag pins --max-batch
/// (L672); conc1-prefix pins f06-c1-
/// (L740); conc4-prefix pins
/// f06-conc4- (L755); conc-flag pins
/// --concurrency (L741); poison-prefix
/// pins f06-poison- (L775);
/// poison-lease pins 1000 (L776);
/// lease-flag pins --lease-ms (L776);
/// poison-failed-occ pins 500 (L793);
/// poison-dead-occ pins 5 (L797);
/// poison-dead-state pins dead (L826);
/// poison-dead-reason pins poison
/// (L813); sub-ok pins sub-ok (L605);
/// sub-poison pins sub-poison (L607);
/// stub-500-body pins downstream
/// failed (L142); drained-note pins
/// drained run recorded (L731);
/// deny-prefix pins f06-deny- (L846);
/// unmap-prefix pins f06-unmap-
/// (L847); sub-denied pins sub-denied
/// (L608); sub-unmapped pins
/// sub-unmapped (L847 seed plus L865
/// occurrence, same spelling);
/// denied-url pins
/// http://example.com:9/hook (L608);
/// denied-occ pins no-matching-rule
/// (L862); denied-dead-reason pins
/// destination_denied (L869);
/// unmap-dead-reason pins
/// no_destination (L872); cred-prefix
/// pins f06-cred- (L883); cred-binding
/// pins F06_HOOK_TOKEN (L889, label
/// only, bound bytes never quoted);
/// bearer-prefix pins the Bearer
/// scheme plus gap (L902); sub-cred
/// pins sub-cred (L606); flaky-prefix
/// pins f06-flaky- (L911); timeout-ms
/// pins 1500 (L912; L895 holds a
/// same-spelled soak); timeout-flag
/// pins --timeout-ms (L912);
/// timeout-occ pins timeout (L917);
/// pair-rows pins int (48) from L671;
/// pair-cap pins int (24) from L672;
/// conc1-rows pins int (8) from L740;
/// conc4-rows pins int (12) from L755;
/// conc-one pins int (1) from L741;
/// conc-four pins int (4) from L756;
/// serial-peak pins int (1) from L751;
/// parallel-peak-low pins int (2) from
/// L766; conc4-delay-ms pins int
/// (100) from L151; poison-rows pins
/// int (3) from L775;
/// poison-round-cap pins int (12) from
/// L778; poison-attempts pins int (5)
/// from L834; poison-version-min pins
/// int (6) from L831; dest-steps pins
/// int (2) from L850; flaky-posts pins
/// int (2) from L928; flaky-first-
/// sleep-s pins int (3) from L147.
/// Facet map (declared order):
/// pair-prefix, dup-note,
/// maxbatch-flag, conc1-prefix,
/// conc4-prefix, conc-flag,
/// poison-prefix, poison-lease,
/// lease-flag, poison-failed-occ,
/// poison-dead-occ, poison-dead-state,
/// poison-dead-reason, sub-ok,
/// sub-poison, stub-500-body,
/// drained-note, deny-prefix,
/// unmap-prefix, sub-denied,
/// sub-unmapped, denied-url,
/// denied-occ, denied-dead-reason,
/// unmap-dead-reason, cred-prefix,
/// cred-binding, bearer-prefix,
/// sub-cred, flaky-prefix, timeout-ms,
/// timeout-flag, timeout-occ,
/// pair-rows, pair-cap, conc1-rows,
/// conc4-rows, conc-one, conc-four,
/// serial-peak, parallel-peak-low,
/// conc4-delay-ms, poison-rows,
/// poison-round-cap, poison-attempts,
/// poison-version-min, dest-steps,
/// flaky-posts, flaky-first-sleep-s.
/// The report shape plus auth leg live
/// in life-011-base-semantics.can; the
/// run envelope plus crash plus batch
/// plus idle legs live in
/// life-011-run-shape.can.
/// Variants: B pair, C concurrency, D
/// poison, E destination, F credential
/// and G timeout here; default plus
/// seeded drifts only here.
/// Environment: CAN_BUN_ARCHIVE plus
/// staged bundle plus loopback plus
/// disposable SQLite (row lists four
/// gates; bind at P23; no live run
/// now).
/// Logical gates CHILD plus HTTP plus
/// PEER plus DB bind at P23; no live
/// run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none in this row.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 plus QD2 plus
/// QD4 accept gates unmet).
/// Case life/companion-pair-roots
/// checks: pair-prefix, dup-note,
/// maxbatch-flag, conc1-prefix,
/// conc4-prefix, conc-flag,
/// poison-prefix, poison-lease,
/// lease-flag, poison-failed-occ,
/// poison-dead-occ, poison-dead-state,
/// poison-dead-reason, sub-ok,
/// sub-poison, stub-500-body,
/// drained-note, deny-prefix,
/// unmap-prefix, sub-denied,
/// sub-unmapped, denied-url,
/// denied-occ, denied-dead-reason,
/// unmap-dead-reason, cred-prefix,
/// cred-binding, bearer-prefix,
/// sub-cred, flaky-prefix, timeout-ms,
/// timeout-flag, timeout-occ,
/// pair-rows, pair-cap, conc1-rows,
/// conc4-rows, conc-one, conc-four,
/// serial-peak, parallel-peak-low,
/// conc4-delay-ms, poison-rows,
/// poison-round-cap, poison-attempts,
/// poison-version-min, dest-steps,
/// flaky-posts, flaky-first-sleep-s.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str pair_prefix
    str dup_note
    str maxbatch_flag
    str conc1_prefix
    str conc4_prefix
    str conc_flag
    str poison_prefix
    str poison_lease
    str lease_flag
    str poison_failed_occ
    str poison_dead_occ
    str poison_dead_state
    str poison_dead_reason
    str sub_ok
    str sub_poison
    str stub_500_body
    str drained_note
    str deny_prefix
    str unmap_prefix
    str sub_denied
    str sub_unmapped
    str denied_url
    str denied_occ
    str denied_dead_reason
    str unmap_dead_reason
    str cred_prefix
    str cred_binding
    str bearer_prefix
    str sub_cred
    str flaky_prefix
    str timeout_ms
    str timeout_flag
    str timeout_occ
    int pair_rows
    int pair_cap
    int conc1_rows
    int conc4_rows
    int conc_one
    int conc_four
    int serial_peak
    int parallel_peak_low
    int conc4_delay_ms
    int poison_rows
    int poison_round_cap
    int poison_attempts
    int poison_version_min
    int dest_steps
    int flaky_posts
    int flaky_first_sleep_s
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/companion-pair-roots", "default", "", "offline"), "pair-prefix" => ok "case life/companion-pair-roots variant default root pair-prefix run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/companion-pair-roots", "default", "", "offline"), "pair-prefix" => ok evidence("pair-prefix", "true", "true", true, "case life/companion-pair-roots variant default root pair-prefix run offline")
        different: false, true, context("life/companion-pair-roots", "default", "", "offline"), "pair-prefix" => failed{"pair-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 48, 48, context("life/companion-pair-roots", "default", "", "offline"), "pair-rows" => ok evidence("pair-rows", "48", "48", true, "case life/companion-pair-roots variant default root pair-rows run offline")
        different: 47, 48, context("life/companion-pair-roots", "default", "", "offline"), "pair-rows" => failed{"pair-rows"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "f06-pair-", "f06-pair-", context("life/companion-pair-roots", "default", "", "offline"), "pair-prefix" => ok evidence("pair-prefix", "f06-pair-", "f06-pair-", true, "case life/companion-pair-roots variant default root pair-prefix run offline")
        different: "f06-pair-_2", "f06-pair-", context("life/companion-pair-roots", "default", "", "offline"), "pair-prefix" => failed{"pair-prefix"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
