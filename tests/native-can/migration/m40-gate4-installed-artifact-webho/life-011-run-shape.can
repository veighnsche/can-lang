package m40life011run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M40 LIFE-011 TestCompanionPairLiveF06
/// run envelope plus crash plus batch
/// plus idle legs.
/// Source: tests/integration/
/// webhook_f06_test.go symbol
/// TestCompanionPairLiveF06 (L550-1190):
/// env gate, staged setup, per-leg
/// shape, then the H plus W4.3 plus I
/// pins.
/// Disposition: migrate (same row pact
/// as the base slice; this file owns
/// the envelope plus the last three
/// legs only).
/// Protects (this file): facet five
/// (SIGKILL with four gated sends
/// yields 4 duplicated plus 4 single
/// receipts with one ledger effect
/// each) plus facet six (bounded
/// 200-row drain completes once; wall
/// plus rss bounds stay written
/// only) plus facet seven (both
/// workers drain round one, at most 10
/// rounds, each id seen once in every
/// sink) plus facet eight (idle gaps
/// 0.7s to 6s, polling goes on, no
/// restart, clean SIGTERM) plus the
/// run envelope (archive gate, staged
/// setup, helper names, seed shape).
/// MEASUREMENT DEFERRAL: wall-bound-
/// note, rss-bound-note and gap-bound-
/// note pin the stated bounds as
/// static line observations only;
/// never as verified measurements.
/// Throughput stays logged only per
/// the L1138-1139 note; no gate.
/// ADAPTATION (recorded, with source
/// lines): env pins hold the archive
/// var and skip note; setup pins hold
/// verbs, paths and names; helper pins
/// hold setup call names; bound-note
/// pins hold stated-bound line bytes;
/// count pins hold ints tallied from
/// guards and call sites.
/// env-name pins CAN_BUN_ARCHIVE
/// (L553); skip-note pins the skip
/// note (L555); assert-command pins
/// assert (L565); app-webhook pins
/// webhook (L564); driver-rel pins
/// tests/integration/testdata/webhook/driver.ts
/// (L569); companion-rel pins
/// examples/webhook/companion/main.ts
/// (L641); db-file pins
/// hook-f06.sqlite (L574); setup-op
/// pins setup (L575); snapshot-name
/// pins snapshot-f06 (L586);
/// carrier-secret-label pins
/// CARRIER_SECRET (L587, label only,
/// bound bytes never quoted);
/// helper-bundle pins harnessBundle
/// (L560); helper-stage pins
/// stageApplication (L564);
/// helper-canlc pins canlcOffline
/// (L565); seed-accepted pins the
/// accepted body (L485); gate-prefix
/// pins f06-gate- (L941); lease-2000
/// pins 2000 (L943); once-flag pins
/// --once (L649 first use); w43-prefix
/// pins f06-w43- (L999); w43-first-
/// note pins want both workers
/// draining (L1099); wall-bound-note
/// pins want under 120s (L1134,
/// deferred); rss-bound-note pins want
/// 1..262143 (L1141, deferred);
/// throughput-note pins rows/s
/// (L1143, logged only); idle-prefix
/// pins f06-idle- (L1152); restart-
/// word pins restart (L1159); loop-
/// exit-note pins looping companion
/// exit (L1157); gap-bound-note pins
/// outside 0.7s..6s (L1184,
/// deferred); f06-port pins int
/// (18495) from L47; setup-tables pins
/// int (5) from L579; timeout-minutes
/// pins int (12) from L558; gate-rows
/// pins int (8) from L941;
/// gate-arrivals pins int (4) from
/// L945; twice-rows pins int (4) from
/// L988; once-rows pins int (4) from
/// L988; ledger-one pins int (1) from
/// L981; w43-rows pins int (200) from
/// L998; w43-round-cap pins int (10)
/// from L1005; w43-wait-minutes pins
/// int (3) from L1032; idle-rows pins
/// int (2) from L1152;
/// idle-batches-min pins int (3) from
/// L1163; idle-soak-s pins int (6)
/// from L1154; term-drain-s pins int
/// (30) from L369.
/// Facet map (declared order):
/// env-name, skip-note,
/// assert-command, app-webhook,
/// driver-rel, companion-rel, db-file,
/// setup-op, snapshot-name,
/// carrier-secret-label, helper-bundle,
/// helper-stage, helper-canlc,
/// seed-accepted, gate-prefix,
/// lease-2000, once-flag, w43-prefix,
/// w43-first-note, wall-bound-note,
/// rss-bound-note, throughput-note,
/// idle-prefix, restart-word,
/// loop-exit-note, gap-bound-note,
/// f06-port, setup-tables,
/// timeout-minutes, gate-rows,
/// gate-arrivals, twice-rows,
/// once-rows, ledger-one, w43-rows,
/// w43-round-cap, w43-wait-minutes,
/// idle-rows, idle-batches-min,
/// idle-soak-s, term-drain-s.
/// The report shape plus auth leg live
/// in life-011-base-semantics.can; the
/// pair plus sized plus poison plus
/// policy legs live in
/// life-011-roots-green.can.
/// Variants: H crash, W4.3 batch and I
/// idle here; default plus seeded
/// drifts only here.
/// Environment: CAN_BUN_ARCHIVE
/// required; absent archive skips;
/// staged bundle, cut-off homes,
/// loopback ports, disposable SQLite,
/// managed server, fd-3 snapshot
/// (row lists four gates; bind at P23;
/// no live run now).
/// Logical gates CHILD plus HTTP plus
/// PEER plus DB plus METRIC plus FAULT
/// plus CLOCK bind at P23; no live run
/// now.
/// Timeout 120000ms is the offline
/// default bound (the live twelve
/// minute hold is pinned here as
/// timeout-minutes; binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none in this row.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QD1 plus QD2 plus
/// QD4 accept gates unmet).
/// Case life/companion-pair-run
/// checks: env-name, skip-note,
/// assert-command, app-webhook,
/// driver-rel, companion-rel, db-file,
/// setup-op, snapshot-name,
/// carrier-secret-label, helper-bundle,
/// helper-stage, helper-canlc,
/// seed-accepted, gate-prefix,
/// lease-2000, once-flag, w43-prefix,
/// w43-first-note, wall-bound-note,
/// rss-bound-note, throughput-note,
/// idle-prefix, restart-word,
/// loop-exit-note, gap-bound-note,
/// f06-port, setup-tables,
/// timeout-minutes, gate-rows,
/// gate-arrivals, twice-rows,
/// once-rows, ledger-one, w43-rows,
/// w43-round-cap, w43-wait-minutes,
/// idle-rows, idle-batches-min,
/// idle-soak-s, term-drain-s.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_name
    str skip_note
    str assert_command
    str app_webhook
    str driver_rel
    str companion_rel
    str db_file
    str setup_op
    str snapshot_name
    str carrier_secret_label
    str helper_bundle
    str helper_stage
    str helper_canlc
    str seed_accepted
    str gate_prefix
    str lease_2000
    str once_flag
    str w43_prefix
    str w43_first_note
    str wall_bound_note
    str rss_bound_note
    str throughput_note
    str idle_prefix
    str restart_word
    str loop_exit_note
    str gap_bound_note
    int f06_port
    int setup_tables
    int timeout_minutes
    int gate_rows
    int gate_arrivals
    int twice_rows
    int once_rows
    int ledger_one
    int w43_rows
    int w43_round_cap
    int w43_wait_minutes
    int idle_rows
    int idle_batches_min
    int idle_soak_s
    int term_drain_s
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/companion-pair-run", "default", "", "offline"), "env-name" => ok "case life/companion-pair-run variant default root env-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/companion-pair-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "true", "true", true, "case life/companion-pair-run variant default root env-name run offline")
        different: false, true, context("life/companion-pair-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 18495, 18495, context("life/companion-pair-run", "default", "", "offline"), "f06-port" => ok evidence("f06-port", "18495", "18495", true, "case life/companion-pair-run variant default root f06-port run offline")
        different: 18494, 18495, context("life/companion-pair-run", "default", "", "offline"), "f06-port" => failed{"f06-port"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("life/companion-pair-run", "default", "", "offline"), "env-name" => ok evidence("env-name", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case life/companion-pair-run variant default root env-name run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("life/companion-pair-run", "default", "", "offline"), "env-name" => failed{"env-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
