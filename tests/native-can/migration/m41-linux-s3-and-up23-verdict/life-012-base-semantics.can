package m41life012base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-012 TestLinuxInstalledArtifactSmoke
/// install selection plus pinned runtime
/// identity.
/// Source: tests/integration/
/// linux_distribution_test.go symbol
/// TestLinuxInstalledArtifactSmoke
/// (L24-259): build, release, install,
/// then select the install root and
/// prove the pinned runtime identity
/// from the actual installed launcher.
/// Disposition: migrate (this row owns
/// the install plus identity facts as
/// reviewable Can facts; the old go
/// check stays until the integrator
/// retires it after every linked row,
/// variant, environment and control has
/// accepted evidence).
/// Protects (this file): facet one
/// (Linux build/release/install
/// selection and pinned runtime identity
/// from actual installed executable):
/// the four pipeline calls, the build
/// tag, the wrong-selection guard, the
/// launcher leaf, the runtime-check
/// command plus status note, the five
/// identity fields, the four pinned
/// values, and the three guard notes.
/// ADAPTATION (recorded, with source
/// lines): call pins hold pipeline call
/// names; tag pins hold the build tag;
/// leaf pins hold the launcher name;
/// note pins hold guard message lines;
/// field pins hold report field names;
/// want pins hold pinned values; count
/// pins hold ints tallied from the call
/// and field lists.
/// build-call pins distribution.Build
/// (L39); release-call pins
/// distribution.Release (L43);
/// install-call pins distribution.Install
/// (L48); selection-call pins
/// distribution.Selection (L52);
/// build-tag pins linux-smoke (L39);
/// wrong-selection-note pins the guard
/// line (L54); canlc-leaf pins canlc
/// (L56, L65, L252-253, L308, L310);
/// runtime-cmd pins runtime-check (L81,
/// L83, L102); runtime-status-note pins
/// the status line (L83);
/// identity-field-bun pins json:"bun"
/// (L86); identity-field-revision pins
/// json:"revision" (L87);
/// identity-field-platform pins
/// json:"platform" (L88);
/// identity-field-architecture pins
/// json:"architecture" (L89);
/// identity-field-executable pins
/// json:"executable" (L90); want-bun
/// pins 1.4.2 (L95; also L133);
/// want-revision pins the revision hex
/// (L98); want-arch pins x64 (L95; also
/// L30); identity-note pins the identity
/// guard line (L96); revision-note pins
/// the revision guard line (L99);
/// outside-note pins the outside-root
/// guard line (L102); install-step-count
/// pins int (4) from L39-52;
/// identity-field-count pins int (5)
/// from L86-90; pinned-value-count pins
/// int (4) from L95-98.
/// Facet map (pin order): build-call,
/// release-call, install-call,
/// selection-call, build-tag,
/// wrong-selection-note, canlc-leaf,
/// runtime-cmd, runtime-status-note,
/// identity-field-bun,
/// identity-field-revision,
/// identity-field-platform,
/// identity-field-architecture,
/// identity-field-executable, want-bun,
/// want-revision, want-arch,
/// identity-note, revision-note,
/// outside-note, install-step-count,
/// identity-field-count,
/// pinned-value-count.
/// The qualification legs live in
/// life-012-roots-green.can; the example
/// plus build shape lives in
/// life-012-run-shape.can.
/// Variants: example legs plus native
/// qualification when python is present;
/// default plus seeded drifts only here.
/// Environment: linux amd64 plus
/// CAN_BUN_ARCHIVE (row lists two gates;
/// bind at P23; no live run now).
/// Logical gates ARCHIVE plus N1 bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fifty minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 plus QN1 accept gates unmet).
/// Case life/installed-smoke-base
/// checks: build-call, release-call,
/// install-call, selection-call,
/// build-tag, wrong-selection-note,
/// canlc-leaf, runtime-cmd,
/// runtime-status-note,
/// identity-field-bun,
/// identity-field-revision,
/// identity-field-platform,
/// identity-field-architecture,
/// identity-field-executable, want-bun,
/// want-revision, want-arch,
/// identity-note, revision-note,
/// outside-note, install-step-count,
/// identity-field-count,
/// pinned-value-count.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str build_call
    str release_call
    str install_call
    str selection_call
    str build_tag
    str wrong_selection_note
    str canlc_leaf
    str runtime_cmd
    str runtime_status_note
    str identity_field_bun
    str identity_field_revision
    str identity_field_platform
    str identity_field_architecture
    str identity_field_executable
    str want_bun
    str want_revision
    str want_arch
    str identity_note
    str revision_note
    str outside_note
    int install_step_count
    int identity_field_count
    int pinned_value_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/installed-smoke-base", "default", "", "offline"), "build-call" => ok "case life/installed-smoke-base variant default root build-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/installed-smoke-base", "default", "", "offline"), "build-call" => ok evidence("build-call", "true", "true", true, "case life/installed-smoke-base variant default root build-call run offline")
        different: false, true, context("life/installed-smoke-base", "default", "", "offline"), "build-call" => failed{"build-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("life/installed-smoke-base", "default", "", "offline"), "install-step-count" => ok evidence("install-step-count", "4", "4", true, "case life/installed-smoke-base variant default root install-step-count run offline")
        different: 3, 4, context("life/installed-smoke-base", "default", "", "offline"), "install-step-count" => failed{"install-step-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "distribution.Build", "distribution.Build", context("life/installed-smoke-base", "default", "", "offline"), "build-call" => ok evidence("build-call", "distribution.Build", "distribution.Build", true, "case life/installed-smoke-base variant default root build-call run offline")
        different: "distribution.Build_2", "distribution.Build", context("life/installed-smoke-base", "default", "", "offline"), "build-call" => failed{"build-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
