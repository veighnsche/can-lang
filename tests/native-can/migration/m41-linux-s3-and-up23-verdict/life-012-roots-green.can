package m41life012roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-012 TestLinuxInstalledArtifactSmoke
/// native qualification legs.
/// Source: tests/integration/
/// linux_distribution_test.go symbol
/// TestLinuxInstalledArtifactSmoke
/// (L105-150): when python3 is present,
/// run qualify.py offline, then require
/// every API plus behavior probe to
/// pass with negative plus glibc proof.
/// Disposition: migrate (same row pact as
/// the base slice; this file owns the
/// qualification legs only).
/// Protects (this file): facet two
/// (Offline qualification APIs and
/// behaviors, negative controls and
/// glibc evidence): the program plus
/// absent-program note, the report name,
/// the script, the four flags, the
/// target file, the isolation note, the
/// six report fields, the target pin,
/// and the five guard notes.
/// ADAPTATION (recorded, with source
/// lines): prog pins hold the program
/// name; note pins hold guard plus log
/// lines; name pins hold file names;
/// script pins hold the script name;
/// flag pins hold flag spellings; field
/// pins hold report field names; count
/// pins hold ints tallied from the flag
/// and field lists.
/// qualify-prog pins python3 (L105-106);
/// qualify-skip-note pins the absent
/// note (L106); qualify-report-name pins
/// native-capabilities-linux.json (L108);
/// qualify-script pins qualify.py (L109;
/// also L22); qualify-flag-archive pins
/// --archive (L110); qualify-flag-report
/// pins --report (L110);
/// qualify-flag-target pins --target-file
/// (L111); qualify-flag-net pins
/// --network-isolation (L112);
/// qualify-target-file pins
/// target-linux-amd64.json (L111);
/// qualify-net-note pins the invocation
/// note (L112); report-field-passed pins
/// json:"passed" (L123; also L199);
/// report-field-target pins
/// json:"targetId" (L124);
/// report-field-caps pins
/// json:"capabilities" (L125);
/// report-field-behaviors pins
/// json:"behaviors" (L126);
/// report-field-execution pins
/// json:"execution" (L127);
/// report-field-failures pins
/// json:"failures" (L128);
/// qualify-target-id pins
/// bun-1.4.2-linux-amd64-v1 (L133);
/// qualify-not-passed-note pins the
/// failed line (L134);
/// qualify-missing-api-note pins the
/// missing line (L138);
/// qualify-failing-probe-note pins the
/// failing line (L143);
/// qualify-negative-field pins
/// negativeTestsPassed (L146);
/// qualify-glibc-field pins glibc (L146;
/// also L147); qualify-lacks-note pins
/// the lacks line (L147);
/// qualify-ok-note pins the ok line
/// (L149); qualify-flag-count pins int
/// (4) from L110-112; report-field-count
/// pins int (6) from L123-128.
/// Facet map (pin order): qualify-prog,
/// qualify-skip-note,
/// qualify-report-name, qualify-script,
/// qualify-flag-archive,
/// qualify-flag-report,
/// qualify-flag-target, qualify-flag-net,
/// qualify-target-file, qualify-net-note,
/// report-field-passed,
/// report-field-target, report-field-caps,
/// report-field-behaviors,
/// report-field-execution,
/// report-field-failures,
/// qualify-target-id,
/// qualify-not-passed-note,
/// qualify-missing-api-note,
/// qualify-failing-probe-note,
/// qualify-negative-field,
/// qualify-glibc-field, qualify-lacks-note,
/// qualify-ok-note, qualify-flag-count,
/// report-field-count.
/// The install plus identity legs live in
/// life-012-base-semantics.can; the
/// example plus build shape lives in
/// life-012-run-shape.can.
/// Variants: native qualification when
/// python is present plus example legs;
/// default plus seeded drifts only here.
/// Environment: denied network plus
/// optional python leg (row lists two
/// gates; bind at P23; no live run now).
/// Logical gates ARCHIVE plus N1 bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (the live fifty minute hold is
/// pinned in the run slice; binds at P23
/// like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 plus QN1 accept gates unmet).
/// Case life/installed-smoke-roots
/// checks: qualify-prog,
/// qualify-skip-note,
/// qualify-report-name, qualify-script,
/// qualify-flag-archive,
/// qualify-flag-report,
/// qualify-flag-target, qualify-flag-net,
/// qualify-target-file, qualify-net-note,
/// report-field-passed,
/// report-field-target, report-field-caps,
/// report-field-behaviors,
/// report-field-execution,
/// report-field-failures,
/// qualify-target-id,
/// qualify-not-passed-note,
/// qualify-missing-api-note,
/// qualify-failing-probe-note,
/// qualify-negative-field,
/// qualify-glibc-field, qualify-lacks-note,
/// qualify-ok-note, qualify-flag-count,
/// report-field-count.
/// Shared old files untouched; retirement
/// is a later integrator decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str qualify_prog
    str qualify_skip_note
    str qualify_report_name
    str qualify_script
    str qualify_flag_archive
    str qualify_flag_report
    str qualify_flag_target
    str qualify_flag_net
    str qualify_target_file
    str qualify_net_note
    str report_field_passed
    str report_field_target
    str report_field_caps
    str report_field_behaviors
    str report_field_execution
    str report_field_failures
    str qualify_target_id
    str qualify_not_passed_note
    str qualify_missing_api_note
    str qualify_failing_probe_note
    str qualify_negative_field
    str qualify_glibc_field
    str qualify_lacks_note
    str qualify_ok_note
    int qualify_flag_count
    int report_field_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/installed-smoke-roots", "default", "", "offline"), "qualify-prog" => ok "case life/installed-smoke-roots variant default root qualify-prog run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/installed-smoke-roots", "default", "", "offline"), "qualify-prog" => ok evidence("qualify-prog", "true", "true", true, "case life/installed-smoke-roots variant default root qualify-prog run offline")
        different: false, true, context("life/installed-smoke-roots", "default", "", "offline"), "qualify-prog" => failed{"qualify-prog"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("life/installed-smoke-roots", "default", "", "offline"), "qualify-flag-count" => ok evidence("qualify-flag-count", "4", "4", true, "case life/installed-smoke-roots variant default root qualify-flag-count run offline")
        different: 3, 4, context("life/installed-smoke-roots", "default", "", "offline"), "qualify-flag-count" => failed{"qualify-flag-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "python3", "python3", context("life/installed-smoke-roots", "default", "", "offline"), "qualify-prog" => ok evidence("qualify-prog", "python3", "python3", true, "case life/installed-smoke-roots variant default root qualify-prog run offline")
        different: "python3_2", "python3", context("life/installed-smoke-roots", "default", "", "offline"), "qualify-prog" => failed{"qualify-prog"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
