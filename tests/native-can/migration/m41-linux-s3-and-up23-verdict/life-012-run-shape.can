record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/installed-smoke-run", "default", "", "offline"), "example-process" => ok "case life/installed-smoke-run variant default root example-process run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/installed-smoke-run", "default", "", "offline"), "example-process" => ok evidence("example-process", "true", "true", true, "case life/installed-smoke-run variant default root example-process run offline")
        different: false, true, context("life/installed-smoke-run", "default", "", "offline"), "example-process" => failed{"example-process"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("life/installed-smoke-run", "default", "", "offline"), "example-count" => ok evidence("example-count", "4", "4", true, "case life/installed-smoke-run variant default root example-count run offline")
        different: 3, 4, context("life/installed-smoke-run", "default", "", "offline"), "example-count" => failed{"example-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "process", "process", context("life/installed-smoke-run", "default", "", "offline"), "example-process" => ok evidence("example-process", "process", "process", true, "case life/installed-smoke-run variant default root example-process run offline")
        different: "process_2", "process", context("life/installed-smoke-run", "default", "", "offline"), "example-process" => failed{"example-process"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
