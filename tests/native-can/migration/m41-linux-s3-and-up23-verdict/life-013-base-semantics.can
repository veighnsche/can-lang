        seed_postgres_ok_note: "seed-postgres-ok-note-drift" => ok observation("json:\"serverVersion\"", "json:\"id\"", "json:\"body\"", "\"17.\"", "\"7\"", "\"remember\"", "postgres roundtrip: %v %s", "wrong postgres roundtrip: %s", "postgres ok: server %s_2", "installed sidecar missing at %s", 3, 3)
