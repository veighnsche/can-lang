package m41life013base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-013 TestLinuxPostgresRoundtrip
/// facet one legs.
/// Source: tests/integration/
/// linux_distribution_test.go symbol
/// TestLinuxPostgresRoundtrip (L265-304):
/// an installed Linux sidecar must run
/// the pg driver and return one row
/// with id 7 plus body remember plus a
/// server line starting with 17 dot.
/// Disposition: migrate (this row owns
/// the roundtrip pins as reviewable
/// Can facts; the old go check stays
/// until the integrator retires it after
/// every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): facet one
/// (installed sidecar reaches PostgreSQL
/// 17 and roundtrips one row): driver
/// JSON keys plus wanted row values
/// plus guard notes (L280-303).
/// ADAPTATION (recorded, with source
/// lines): tag pins hold driver JSON
/// key spellings; want pins hold wanted
/// guard values; note pins hold fail
/// plus ok line shape.
/// driver-json-tag-server pins
/// json serverVersion (L293);
/// driver-json-tag-id pins json id
/// (L294); driver-json-tag-body pins
/// json body (L295);
/// want-version-prefix pins 17 dot
/// (L300); want-row-id pins 7 (L300);
/// want-row-body pins remember (L300);
/// roundtrip-fail-note pins the run
/// fail line (L290);
/// wrong-roundtrip-note pins the guard
/// fail line (L301); postgres-ok-note
/// pins the ok line (L303);
/// sidecar-missing-note pins the absent
/// sidecar line (L280);
/// driver-json-key-count pins int (3)
/// from L293-295; roundtrip-want-count
/// pins int (3) from L300.
/// Facet map (leg order):
/// driver-json-tag-server,
/// driver-json-tag-id,
/// driver-json-tag-body,
/// want-version-prefix, want-row-id,
/// want-row-body, roundtrip-fail-note,
/// wrong-roundtrip-note,
/// postgres-ok-note,
/// sidecar-missing-note,
/// driver-json-key-count,
/// roundtrip-want-count.
/// The native SQL legs live in
/// life-013-roots-green.can; the gate
/// plus run shape lives in
/// life-013-run-shape.can.
/// Variants: PostgreSQL 17
/// installed-sidecar profile only here.
/// Environment: linux/amd64 plus
/// CAN_LINUX_INSTALL_ROOT plus
/// DATABASE_URL labels (row lists one
/// gate; absent setup skips; bind at
/// P23; no live run now).
/// Logical gates DB plus NATIVE bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live five minute
/// hold is pinned in the run slice;
/// binds at P23 like the M38 no-run
/// rows).
/// Delegated oracles: none.
/// Database label values stay
/// unpinned: only the label spelling
/// plus its line refs ship here.
/// Execution credit: NOT claimed (P23
/// plus QD1 plus QN1 accept gates
/// unmet).
/// Case life/postgres-roundtrip-base
/// checks: driver-json-tag-server,
/// driver-json-tag-id,
/// driver-json-tag-body,
/// want-version-prefix, want-row-id,
/// want-row-body, roundtrip-fail-note,
/// wrong-roundtrip-note,
/// postgres-ok-note,
/// sidecar-missing-note,
/// driver-json-key-count,
/// roundtrip-want-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str driver_json_tag_server
    str driver_json_tag_id
    str driver_json_tag_body
    str want_version_prefix
    str want_row_id
    str want_row_body
    str roundtrip_fail_note
    str wrong_roundtrip_note
    str postgres_ok_note
    str sidecar_missing_note
    int driver_json_key_count
    int roundtrip_want_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/postgres-roundtrip-base", "default", "", "offline"), "driver-json-tag-server" => ok "case life/postgres-roundtrip-base variant default root driver-json-tag-server run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/postgres-roundtrip-base", "default", "", "offline"), "driver-json-tag-server" => ok evidence("driver-json-tag-server", "true", "true", true, "case life/postgres-roundtrip-base variant default root driver-json-tag-server run offline")
        different: false, true, context("life/postgres-roundtrip-base", "default", "", "offline"), "driver-json-tag-server" => failed{"driver-json-tag-server"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("life/postgres-roundtrip-base", "default", "", "offline"), "driver-json-key-count" => ok evidence("driver-json-key-count", "3", "3", true, "case life/postgres-roundtrip-base variant default root driver-json-key-count run offline")
        different: 2, 3, context("life/postgres-roundtrip-base", "default", "", "offline"), "driver-json-key-count" => failed{"driver-json-key-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "json:\"serverVersion\"", "json:\"serverVersion\"", context("life/postgres-roundtrip-base", "default", "", "offline"), "driver-json-tag-server" => ok evidence("driver-json-tag-server", "json:\"serverVersion\"", "json:\"serverVersion\"", true, "case life/postgres-roundtrip-base variant default root driver-json-tag-server run offline")
        different: "json:\"serverVersion\"_2", "json:\"serverVersion\"", context("life/postgres-roundtrip-base", "default", "", "offline"), "driver-json-tag-server" => failed{"driver-json-tag-server"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
