fn check[] checks
    emits {}
    given
        str scope
    asserts
        m41_l013_base: "m41-l013-base" => ok [check("driver-json-tag-server", "driver JSON keeps its server key"), check("driver-json-tag-id", "driver JSON keeps its id key"), check("driver-json-tag-body", "driver JSON keeps its body key"), check("want-version-prefix", "server line must start with 17 dot"), check("want-row-id", "row keeps its wanted id"), check("want-row-body", "row keeps its wanted body"), check("roundtrip-fail-note", "run failure names the roundtrip leg"), check("wrong-roundtrip-note", "guard failure names the wrong row"), check("postgres-ok-note", "success names the server line"), check("sidecar-missing-note", "absent sidecar names its path"), check("driver-json-key-count", "three driver JSON keys exist"), check("roundtrip-want-count", "three wanted guard values exist")]
        other: "nope" => ok []
    match scope is "m41-l013-base"
        false => ok []
        true => ok [check("driver-json-tag-server", "driver JSON keeps its server key"), check("driver-json-tag-id", "driver JSON keeps its id key"), check("driver-json-tag-body", "driver JSON keeps its body key"), check("want-version-prefix", "server line must start with 17 dot"), check("want-row-id", "row keeps its wanted id"), check("want-row-body", "row keeps its wanted body"), check("roundtrip-fail-note", "run failure names the roundtrip leg"), check("wrong-roundtrip-note", "guard failure names the wrong row"), check("postgres-ok-note", "success names the server line"), check("sidecar-missing-note", "absent sidecar names its path"), check("driver-json-key-count", "three driver JSON keys exist"), check("roundtrip-want-count", "three wanted guard values exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "life/postgres-roundtrip-base" => ok [expected_check("driver-json-tag-server", "json:\"serverVersion\""), expected_check("driver-json-tag-id", "json:\"id\""), expected_check("driver-json-tag-body", "json:\"body\""), expected_check("want-version-prefix", "\"17.\""), expected_check("want-row-id", "\"7\""), expected_check("want-row-body", "\"remember\""), expected_check("roundtrip-fail-note", "postgres roundtrip: %v %s"), expected_check("wrong-roundtrip-note", "wrong postgres roundtrip: %s"), expected_check("postgres-ok-note", "postgres ok: server %s"), expected_check("sidecar-missing-note", "installed sidecar missing at %s"), expected_check("driver-json-key-count", "3"), expected_check("roundtrip-want-count", "3")]
        unknown: "nope" => ok []
    match case is "life/postgres-roundtrip-base"
        false => ok []
        true => ok [expected_check("driver-json-tag-server", "json:\"serverVersion\""), expected_check("driver-json-tag-id", "json:\"id\""), expected_check("driver-json-tag-body", "json:\"body\""), expected_check("want-version-prefix", "\"17.\""), expected_check("want-row-id", "\"7\""), expected_check("want-row-body", "\"remember\""), expected_check("roundtrip-fail-note", "postgres roundtrip: %v %s"), expected_check("wrong-roundtrip-note", "wrong postgres roundtrip: %s"), expected_check("postgres-ok-note", "postgres ok: server %s"), expected_check("sidecar-missing-note", "installed sidecar missing at %s"), expected_check("driver-json-key-count", "3"), expected_check("roundtrip-want-count", "3")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/postgres-roundtrip-base", "default", "", "offline") => ok
        seed_driver_json_tag_server: context("life/postgres-roundtrip-base", "seed-driver-json-tag-server-drift", "", "offline") => failed{"driver-json-tag-server"}
        seed_driver_json_tag_id: context("life/postgres-roundtrip-base", "seed-driver-json-tag-id-drift", "", "offline") => failed{"driver-json-tag-id"}
        seed_driver_json_tag_body: context("life/postgres-roundtrip-base", "seed-driver-json-tag-body-drift", "", "offline") => failed{"driver-json-tag-body"}
        seed_want_version_prefix: context("life/postgres-roundtrip-base", "seed-want-version-prefix-drift", "", "offline") => failed{"want-version-prefix"}
        seed_want_row_id: context("life/postgres-roundtrip-base", "seed-want-row-id-drift", "", "offline") => failed{"want-row-id"}
        seed_want_row_body: context("life/postgres-roundtrip-base", "seed-want-row-body-drift", "", "offline") => failed{"want-row-body"}
        seed_roundtrip_fail_note: context("life/postgres-roundtrip-base", "seed-roundtrip-fail-note-drift", "", "offline") => failed{"roundtrip-fail-note"}
        seed_wrong_roundtrip_note: context("life/postgres-roundtrip-base", "seed-wrong-roundtrip-note-drift", "", "offline") => failed{"wrong-roundtrip-note"}
        seed_postgres_ok_note: context("life/postgres-roundtrip-base", "seed-postgres-ok-note-drift", "", "offline") => failed{"postgres-ok-note"}
        seed_sidecar_missing_note: context("life/postgres-roundtrip-base", "seed-sidecar-missing-note-drift", "", "offline") => failed{"sidecar-missing-note"}
        seed_driver_json_key_count: context("life/postgres-roundtrip-base", "seed-driver-json-key-count-drift", "", "offline") => failed{"driver-json-key-count"}
        seed_roundtrip_want_count: context("life/postgres-roundtrip-base", "seed-roundtrip-want-count-drift", "", "offline") => failed{"roundtrip-want-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.driver_json_tag_server, "json:\"serverVersion\"", c, "driver-json-tag-server")
            failed
            ok evidence driver_json_tag_server_evidence => match call require_text(got.driver_json_tag_id, "json:\"id\"", c, "driver-json-tag-id")
                failed
                ok evidence driver_json_tag_id_evidence => match call require_text(got.driver_json_tag_body, "json:\"body\"", c, "driver-json-tag-body")
                    failed
                    ok evidence driver_json_tag_body_evidence => match call require_text(got.want_version_prefix, "\"17.\"", c, "want-version-prefix")
                        failed
                        ok evidence want_version_prefix_evidence => match call require_text(got.want_row_id, "\"7\"", c, "want-row-id")
                            failed
                            ok evidence want_row_id_evidence => match call require_text(got.want_row_body, "\"remember\"", c, "want-row-body")
                                failed
                                ok evidence want_row_body_evidence => match call require_text(got.roundtrip_fail_note, "postgres roundtrip: %v %s", c, "roundtrip-fail-note")
                                    failed
                                    ok evidence roundtrip_fail_note_evidence => match call require_text(got.wrong_roundtrip_note, "wrong postgres roundtrip: %s", c, "wrong-roundtrip-note")
                                        failed
                                        ok evidence wrong_roundtrip_note_evidence => match call require_text(got.postgres_ok_note, "postgres ok: server %s", c, "postgres-ok-note")
                                            failed
                                            ok evidence postgres_ok_note_evidence => match call require_text(got.sidecar_missing_note, "installed sidecar missing at %s", c, "sidecar-missing-note")
                                                failed
                                                ok evidence sidecar_missing_note_evidence => match call require_int(got.driver_json_key_count, 3, c, "driver-json-key-count")
                                                    failed
                                                    ok evidence driver_json_key_count_evidence => match call require_int(got.roundtrip_want_count, 3, c, "roundtrip-want-count")
                                                        failed
                                                        ok evidence roundtrip_want_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m41_l013_base: "m41-l013-base" => ok test_case("life/postgres-roundtrip-base", ["life", "m41"], [], 120000, [check_ref("driver-json-tag-server"), check_ref("driver-json-tag-id"), check_ref("driver-json-tag-body"), check_ref("want-version-prefix"), check_ref("want-row-id"), check_ref("want-row-body"), check_ref("roundtrip-fail-note"), check_ref("wrong-roundtrip-note"), check_ref("postgres-ok-note"), check_ref("sidecar-missing-note"), check_ref("driver-json-key-count"), check_ref("roundtrip-want-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m41-l013-base"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/postgres-roundtrip-base", ["life", "m41"], [], 120000, [check_ref("driver-json-tag-server"), check_ref("driver-json-tag-id"), check_ref("driver-json-tag-body"), check_ref("want-version-prefix"), check_ref("want-row-id"), check_ref("want-row-body"), check_ref("roundtrip-fail-note"), check_ref("wrong-roundtrip-note"), check_ref("postgres-ok-note"), check_ref("sidecar-missing-note"), check_ref("driver-json-key-count"), check_ref("roundtrip-want-count")], callable case_body)
