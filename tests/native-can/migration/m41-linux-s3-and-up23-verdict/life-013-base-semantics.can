        seed_driver_json_key_count: "seed-driver-json-key-count-drift" => ok observation("json:\"serverVersion\"", "json:\"id\"", "json:\"body\"", "\"17.\"", "\"7\"", "\"remember\"", "postgres roundtrip: %v %s", "wrong postgres roundtrip: %s", "postgres ok: server %s", "installed sidecar missing at %s", 2, 3)
