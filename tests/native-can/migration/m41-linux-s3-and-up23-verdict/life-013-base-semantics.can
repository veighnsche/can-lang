    asserts
        default: "default" => ok observation("json:\"serverVersion\"", "json:\"id\"", "json:\"body\"", "\"17.\"", "\"7\"", "\"remember\"", "postgres roundtrip: %v %s", "wrong postgres roundtrip: %s", "postgres ok: server %s", "installed sidecar missing at %s", 3, 3)
        seed_driver_json_tag_server: "seed-driver-json-tag-server-drift" => ok observation("json:\"serverVersion\"_2", "json:\"id\"", "json:\"body\"", "\"17.\"", "\"7\"", "\"remember\"", "postgres roundtrip: %v %s", "wrong postgres roundtrip: %s", "postgres ok: server %s", "installed sidecar missing at %s", 3, 3)
        seed_driver_json_tag_id: "seed-driver-json-tag-id-drift" => ok observation("json:\"serverVersion\"", "json:\"id\"_2", "json:\"body\"", "\"17.\"", "\"7\"", "\"remember\"", "postgres roundtrip: %v %s", "wrong postgres roundtrip: %s", "postgres ok: server %s", "installed sidecar missing at %s", 3, 3)
