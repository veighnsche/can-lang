        seed_want_row_id: "seed-want-row-id-drift" => ok observation("json:\"serverVersion\"", "json:\"id\"", "json:\"body\"", "\"17.\"", "\"7\"_2", "\"remember\"", "postgres roundtrip: %v %s", "wrong postgres roundtrip: %s", "postgres ok: server %s", "installed sidecar missing at %s", 3, 3)
        seed_want_row_body: "seed-want-row-body-drift" => ok observation("json:\"serverVersion\"", "json:\"id\"", "json:\"body\"", "\"17.\"", "\"7\"", "\"remember\"_2", "postgres roundtrip: %v %s", "wrong postgres roundtrip: %s", "postgres ok: server %s", "installed sidecar missing at %s", 3, 3)
