fn check[] checks
    emits {}
    given
        str scope
    asserts
        m41_l013_roots: "m41-l013-roots" => ok [check("sql-show-version", "driver asks the server line first"), check("sql-drop-if-exists", "driver clears any prior smoke table"), check("sql-create-table", "driver builds the smoke table shape"), check("sql-insert-row", "driver stores the wanted row"), check("sql-select-row", "driver reads the row back by id"), check("sql-drop-table", "driver drops the smoke table last"), check("smoke-table-name", "every leg names the same table"), check("version-guard-note", "old server line refuses with its note"), check("row-missing-note", "absent row refuses with its note"), check("database-required-note", "absent database label refuses"), check("driver-output-shape", "driver prints all three keys at once"), check("driver-sql-count", "six driver SQL legs exist"), check("smoke-table-mention-count", "five table mentions exist")]
        other: "nope" => ok []
    match scope is "m41-l013-roots"
        false => ok []
        true => ok [check("sql-show-version", "driver asks the server line first"), check("sql-drop-if-exists", "driver clears any prior smoke table"), check("sql-create-table", "driver builds the smoke table shape"), check("sql-insert-row", "driver stores the wanted row"), check("sql-select-row", "driver reads the row back by id"), check("sql-drop-table", "driver drops the smoke table last"), check("smoke-table-name", "every leg names the same table"), check("version-guard-note", "old server line refuses with its note"), check("row-missing-note", "absent row refuses with its note"), check("database-required-note", "absent database label refuses"), check("driver-output-shape", "driver prints all three keys at once"), check("driver-sql-count", "six driver SQL legs exist"), check("smoke-table-mention-count", "five table mentions exist")]
