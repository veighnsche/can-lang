    match case is "life/postgres-roundtrip-roots"
        false => ok []
        true => ok [expected_check("sql-show-version", "SHOW server_version"), expected_check("sql-drop-if-exists", "DROP TABLE IF EXISTS t19_smoke"), expected_check("sql-create-table", "CREATE TABLE t19_smoke (id BIGINT PRIMARY KEY, body TEXT NOT NULL)"), expected_check("sql-insert-row", "INSERT INTO t19_smoke (id, body) VALUES (7, 'remember')"), expected_check("sql-select-row", "SELECT id, body FROM t19_smoke WHERE id = 7"), expected_check("sql-drop-table", "DROP TABLE t19_smoke"), expected_check("smoke-table-name", "t19_smoke"), expected_check("version-guard-note", "requires PostgreSQL 17, saw"), expected_check("row-missing-note", "roundtrip row missing"), expected_check("database-required-note", "DATABASE_URL is required"), expected_check("driver-output-shape", "{ serverVersion, id: String(rows[0].id), body: rows[0].body }"), expected_check("driver-sql-count", "6"), expected_check("smoke-table-mention-count", "5")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
