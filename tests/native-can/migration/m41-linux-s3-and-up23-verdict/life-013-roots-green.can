package m41life013roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-013 TestLinuxPostgresRoundtrip
/// facet two legs.
/// Source: distribution/linux/smoke/
/// pg-driver.ts (L1-34) applied by the
/// go check (L284-285): native SQL
/// legs must build plus store plus read
/// plus drop one row while the server
/// line plus row shape stay pinned
/// apart from the guard.
/// Disposition: migrate (this row owns
/// the native SQL pins as reviewable
/// Can facts; the old go check stays
/// until the integrator retires it after
/// every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): facet two
/// (native create/insert/select/drop
/// and server identity seen apart):
/// every SQL leg spelling plus guard
/// notes plus the driver print shape
/// (L15-27).
/// ADAPTATION (recorded, with source
/// lines): sql pins hold exact leg
/// spellings; name pins hold the table
/// spelling; note pins hold guard
/// lines; shape pins hold the driver
/// print line; count pins hold ints
/// tallied from the leg list.
/// sql-show-version pins SHOW
/// server_version (L18);
/// sql-drop-if-exists pins the clear
/// leg (L21); sql-create-table pins
/// the build leg (L22);
/// sql-insert-row pins the store leg
/// (L23); sql-select-row pins the read
/// leg (L24); sql-drop-table pins the
/// drop leg (L26); smoke-table-name
/// pins t19_smoke (L21-26);
/// version-guard-note pins the old
/// server note (L20);
/// row-missing-note pins the absent
/// row note (L25);
/// database-required-note pins the
/// absent label note (L15);
/// driver-output-shape pins the print
/// line (L27); driver-sql-count pins
/// int (6) from L18-26;
/// smoke-table-mention-count pins int
/// (5) from L21-26.
/// Facet map (leg order):
/// sql-show-version,
/// sql-drop-if-exists, sql-create-table,
/// sql-insert-row, sql-select-row,
/// sql-drop-table, smoke-table-name,
/// version-guard-note, row-missing-note,
/// database-required-note,
/// driver-output-shape, driver-sql-count,
/// smoke-table-mention-count.
/// The guard pins live in
/// life-013-base-semantics.can; the
/// gate plus run shape lives in
/// life-013-run-shape.can.
/// Variants: PostgreSQL 17
/// installed-sidecar profile only here.
/// Environment: linux/amd64 plus
/// install root plus database labels;
/// driver legs bind at P23 with QD1;
/// no live run now.
/// Logical gates DB plus NATIVE bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M38 no-run rows).
/// Delegated oracles: none.
/// Database label values stay
/// unpinned: only the label spelling
/// plus its line refs ship here.
/// Execution credit: NOT claimed (P23
/// plus QD1 plus QN1 accept gates
/// unmet).
/// Case life/postgres-roundtrip-roots
/// checks: sql-show-version,
/// sql-drop-if-exists, sql-create-table,
/// sql-insert-row, sql-select-row,
/// sql-drop-table, smoke-table-name,
/// version-guard-note, row-missing-note,
/// database-required-note,
/// driver-output-shape, driver-sql-count,
/// smoke-table-mention-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str sql_show_version
    str sql_drop_if_exists
    str sql_create_table
    str sql_insert_row
    str sql_select_row
    str sql_drop_table
    str smoke_table_name
    str version_guard_note
    str row_missing_note
    str database_required_note
    str driver_output_shape
    int driver_sql_count
    int smoke_table_mention_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/postgres-roundtrip-roots", "default", "", "offline"), "sql-show-version" => ok "case life/postgres-roundtrip-roots variant default root sql-show-version run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/postgres-roundtrip-roots", "default", "", "offline"), "sql-show-version" => ok evidence("sql-show-version", "true", "true", true, "case life/postgres-roundtrip-roots variant default root sql-show-version run offline")
        different: false, true, context("life/postgres-roundtrip-roots", "default", "", "offline"), "sql-show-version" => failed{"sql-show-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("life/postgres-roundtrip-roots", "default", "", "offline"), "driver-sql-count" => ok evidence("driver-sql-count", "6", "6", true, "case life/postgres-roundtrip-roots variant default root driver-sql-count run offline")
        different: 5, 6, context("life/postgres-roundtrip-roots", "default", "", "offline"), "driver-sql-count" => failed{"driver-sql-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "SHOW server_version", "SHOW server_version", context("life/postgres-roundtrip-roots", "default", "", "offline"), "sql-show-version" => ok evidence("sql-show-version", "SHOW server_version", "SHOW server_version", true, "case life/postgres-roundtrip-roots variant default root sql-show-version run offline")
        different: "SHOW server_version_2", "SHOW server_version", context("life/postgres-roundtrip-roots", "default", "", "offline"), "sql-show-version" => failed{"sql-show-version"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
