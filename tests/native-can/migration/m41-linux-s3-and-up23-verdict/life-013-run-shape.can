    asserts
        default: "default" => ok observation("TestLinuxPostgresRoundtrip", "linux amd64 postgres roundtrip only", "set CAN_LINUX_INSTALL_ROOT and DATABASE_URL for the postgres roundtrip", "CAN_LINUX_INSTALL_ROOT", "DATABASE_URL", "\"linux\"", "\"amd64\"", "\"current\", \"runtime\", \"bun\"", "distribution/linux/smoke/pg-driver.ts", "PATH=/nonexistent", "HOME=", "5*time.Minute", 2, 5, 3)
        seed_test_symbol: "seed-test-symbol-drift" => ok observation("TestLinuxPostgresRoundtrip_2", "linux amd64 postgres roundtrip only", "set CAN_LINUX_INSTALL_ROOT and DATABASE_URL for the postgres roundtrip", "CAN_LINUX_INSTALL_ROOT", "DATABASE_URL", "\"linux\"", "\"amd64\"", "\"current\", \"runtime\", \"bun\"", "distribution/linux/smoke/pg-driver.ts", "PATH=/nonexistent", "HOME=", "5*time.Minute", 2, 5, 3)
