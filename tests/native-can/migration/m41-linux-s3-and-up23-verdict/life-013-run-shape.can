package m41life013run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-013 TestLinuxPostgresRoundtrip
/// run shape legs.
/// Source: tests/integration/
/// linux_distribution_test.go symbol
/// TestLinuxPostgresRoundtrip (L265-304):
/// platform gate plus setup gate plus
/// sidecar run shape must pin every
/// skip plus label plus path plus bound
/// (L265-292).
/// Disposition: migrate (this row owns
/// the run shape pins as reviewable
/// Can facts; the old go check stays
/// until the integrator retires it after
/// every linked row, variant,
/// environment and control has accepted
/// evidence).
/// Protects (this file): the run shape
/// behind both facets: gate skips plus
/// setup labels plus sidecar invocation
/// plus the five minute bound.
/// ADAPTATION (recorded, with source
/// lines): symbol pins hold the go
/// symbol; skip pins hold skip lines;
/// label pins hold setup label
/// spellings; gate pins hold platform
/// values; path pins hold sidecar plus
/// driver paths; env pins hold run
/// entries; bound pins hold the hold
/// call; count pins hold ints tallied
/// from the run list.
/// test-symbol pins
/// TestLinuxPostgresRoundtrip (L265;
/// named in the L261 run note);
/// platform-skip-note pins the
/// off-target skip (L267);
/// env-skip-note pins the absent
/// setup skip (L272);
/// install-root-label pins
/// CAN_LINUX_INSTALL_ROOT (L269 plus
/// L272); database-label pins
/// DATABASE_URL (L270 plus L272 plus
/// L287); platform-goos pins linux
/// (L266); platform-goarch pins amd64
/// (L266); sidecar-segments pins
/// current plus runtime plus bun
/// (L278); driver-rel pins the driver
/// path (L285); path-deny-value pins
/// PATH=/nonexistent (L287);
/// home-bind-prefix pins HOME= (L287);
/// timeout-call pins 5*time.Minute
/// (L282); skip-count pins int
/// (2) from L267-272; timeout-minutes
/// pins int (5) from L282;
/// env-entry-count pins int (3) from
/// L287.
/// Facet map (leg order):
/// test-symbol, platform-skip-note,
/// env-skip-note, install-root-label,
/// database-label, platform-goos,
/// platform-goarch, sidecar-segments,
/// driver-rel, path-deny-value,
/// home-bind-prefix, timeout-call,
/// skip-count, timeout-minutes,
/// env-entry-count.
/// The guard pins live in
/// life-013-base-semantics.can; the
/// native SQL legs live in
/// life-013-roots-green.can.
/// Variants: PostgreSQL 17
/// installed-sidecar profile only here.
/// Environment: linux/amd64 plus
/// CAN_LINUX_INSTALL_ROOT plus
/// DATABASE_URL labels (row lists one
/// gate; absent setup skips; bind at
/// P23 with QD1 plus QN1; no live run
/// now).
/// Logical gates DB plus PROC plus
/// WORK plus ENV plus NATIVE bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M38 no-run rows).
/// Delegated oracles: none.
/// Database label values stay
/// unpinned: only the label spelling
/// plus its line refs ship here.
/// Execution credit: NOT claimed (P23
/// plus QD1 plus QN1 accept gates
/// unmet).
/// Case life/postgres-roundtrip-run
/// checks: test-symbol,
/// platform-skip-note, env-skip-note,
/// install-root-label, database-label,
/// platform-goos, platform-goarch,
/// sidecar-segments, driver-rel,
/// path-deny-value, home-bind-prefix,
/// timeout-call, skip-count,
/// timeout-minutes, env-entry-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str test_symbol
    str platform_skip_note
    str env_skip_note
    str install_root_label
    str database_label
    str platform_goos
    str platform_goarch
    str sidecar_segments
    str driver_rel
    str path_deny_value
    str home_bind_prefix
    str timeout_call
    int skip_count
    int timeout_minutes
    int env_entry_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/postgres-roundtrip-run", "default", "", "offline"), "test-symbol" => ok "case life/postgres-roundtrip-run variant default root test-symbol run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/postgres-roundtrip-run", "default", "", "offline"), "test-symbol" => ok evidence("test-symbol", "true", "true", true, "case life/postgres-roundtrip-run variant default root test-symbol run offline")
        different: false, true, context("life/postgres-roundtrip-run", "default", "", "offline"), "test-symbol" => failed{"test-symbol"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/postgres-roundtrip-run", "default", "", "offline"), "skip-count" => ok evidence("skip-count", "2", "2", true, "case life/postgres-roundtrip-run variant default root skip-count run offline")
        different: 1, 2, context("life/postgres-roundtrip-run", "default", "", "offline"), "skip-count" => failed{"skip-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "TestLinuxPostgresRoundtrip", "TestLinuxPostgresRoundtrip", context("life/postgres-roundtrip-run", "default", "", "offline"), "test-symbol" => ok evidence("test-symbol", "TestLinuxPostgresRoundtrip", "TestLinuxPostgresRoundtrip", true, "case life/postgres-roundtrip-run variant default root test-symbol run offline")
        different: "TestLinuxPostgresRoundtrip_2", "TestLinuxPostgresRoundtrip", context("life/postgres-roundtrip-run", "default", "", "offline"), "test-symbol" => failed{"test-symbol"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
