fn check[] checks
    emits {}
    given
        str scope
    asserts
        m41_l013_run: "m41-l013-run" => ok [check("test-symbol", "row owns its go symbol name"), check("platform-skip-note", "off-target run skips by name"), check("env-skip-note", "absent setup skips by name"), check("install-root-label", "setup names the install root label"), check("database-label", "setup names the database label"), check("platform-goos", "gate names the linux target"), check("platform-goarch", "gate names the amd64 target"), check("sidecar-segments", "sidecar path keeps its three legs"), check("driver-rel", "run names the driver path"), check("path-deny-value", "run pins PATH to denied"), check("home-bind-prefix", "run binds HOME to its own dir"), check("timeout-call", "run holds a five minute bound"), check("skip-count", "two skips exist"), check("timeout-minutes", "five minute hold exists"), check("env-entry-count", "three env entries exist")]
        other: "nope" => ok []
    match scope is "m41-l013-run"
        false => ok []
        true => ok [check("test-symbol", "row owns its go symbol name"), check("platform-skip-note", "off-target run skips by name"), check("env-skip-note", "absent setup skips by name"), check("install-root-label", "setup names the install root label"), check("database-label", "setup names the database label"), check("platform-goos", "gate names the linux target"), check("platform-goarch", "gate names the amd64 target"), check("sidecar-segments", "sidecar path keeps its three legs"), check("driver-rel", "run names the driver path"), check("path-deny-value", "run pins PATH to denied"), check("home-bind-prefix", "run binds HOME to its own dir"), check("timeout-call", "run holds a five minute bound"), check("skip-count", "two skips exist"), check("timeout-minutes", "five minute hold exists"), check("env-entry-count", "three env entries exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "life/postgres-roundtrip-run" => ok [expected_check("test-symbol", "TestLinuxPostgresRoundtrip"), expected_check("platform-skip-note", "linux amd64 postgres roundtrip only"), expected_check("env-skip-note", "set CAN_LINUX_INSTALL_ROOT and DATABASE_URL for the postgres roundtrip"), expected_check("install-root-label", "CAN_LINUX_INSTALL_ROOT"), expected_check("database-label", "DATABASE_URL"), expected_check("platform-goos", "\"linux\""), expected_check("platform-goarch", "\"amd64\""), expected_check("sidecar-segments", "\"current\", \"runtime\", \"bun\""), expected_check("driver-rel", "distribution/linux/smoke/pg-driver.ts"), expected_check("path-deny-value", "PATH=/nonexistent"), expected_check("home-bind-prefix", "HOME="), expected_check("timeout-call", "5*time.Minute"), expected_check("skip-count", "2"), expected_check("timeout-minutes", "5"), expected_check("env-entry-count", "3")]
        unknown: "nope" => ok []
    match case is "life/postgres-roundtrip-run"
        false => ok []
        true => ok [expected_check("test-symbol", "TestLinuxPostgresRoundtrip"), expected_check("platform-skip-note", "linux amd64 postgres roundtrip only"), expected_check("env-skip-note", "set CAN_LINUX_INSTALL_ROOT and DATABASE_URL for the postgres roundtrip"), expected_check("install-root-label", "CAN_LINUX_INSTALL_ROOT"), expected_check("database-label", "DATABASE_URL"), expected_check("platform-goos", "\"linux\""), expected_check("platform-goarch", "\"amd64\""), expected_check("sidecar-segments", "\"current\", \"runtime\", \"bun\""), expected_check("driver-rel", "distribution/linux/smoke/pg-driver.ts"), expected_check("path-deny-value", "PATH=/nonexistent"), expected_check("home-bind-prefix", "HOME="), expected_check("timeout-call", "5*time.Minute"), expected_check("skip-count", "2"), expected_check("timeout-minutes", "5"), expected_check("env-entry-count", "3")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/postgres-roundtrip-run", "default", "", "offline") => ok
        seed_test_symbol: context("life/postgres-roundtrip-run", "seed-test-symbol-drift", "", "offline") => failed{"test-symbol"}
