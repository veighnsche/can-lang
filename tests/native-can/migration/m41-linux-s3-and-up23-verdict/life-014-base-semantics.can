package m41life014base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-014 TestCurrentS3Objects
/// crud plus range plus stream plus size
/// slice.
/// Source: tests/integration/s3_test.go
/// symbol TestCurrentS3Objects (L44-348):
/// each CLI call opens its own client,
/// so bytes put by one process read back
/// in the next process (L239-241).
/// Disposition: migrate (this row owns
/// the S3 matrix as reviewable Can
/// facts; the old go check stays until
/// the integrator retires it after every
/// linked row, variant, environment and
/// control has accepted proof).
/// Protects (this file): facet two (put,
/// get, stat, exists, range, stream,
/// bounded wide-object refusal and
/// invalid UTF-8 payload): the six crud
/// verbs, the short-put usage want, the
/// hello round trip wants, the repeat
/// unit, the over-limit and invalid-data
/// fault codes, the doc and wide leaf
/// names, and the eight size tallies.
/// ADAPTATION (recorded, with source
/// lines): cmd pins hold CLI verbs (W
/// word counts); want pins hold exact
/// stdout wants (Q quoted counts); leaf
/// pins hold key file names (L242,
/// L251); fault pins hold fault codes
/// (L258, L337); count pins hold ints
/// recomputed from lengths and calls.
/// cmd-put pins put W9/9 (L235, L238x2,
/// L244, L253, L262, L296, L301, L334);
/// cmd-get pins get W10/10 (L235, L245,
/// L255, L258, L288, L303, L320, L324,
/// L331, L337); cmd-stat pins stat
/// W10/10 (L208, L211, L214, L217, L235,
/// L246, L254, L332, L336, L339);
/// cmd-exists pins exists W4/4 (L235,
/// L247, L328, L330); cmd-range pins
/// range W6/6 (L172, L235, L248, L259,
/// L333, L343, counts two go keywords);
/// cmd-stream pins stream W2/2 (L235,
/// L249); want-put-usage pins the short
/// usage want S2/2 (L235, L238);
/// want-hello pins hello Q5/5 (L244,
/// L245, L249, L287, L324); want-five
/// pins 5 Q3/3 (L244, L246, L323);
/// want-true pins true Q1/1 (L247);
/// want-ell pins ell Q1/1 (L248);
/// repeat-unit pins the hex chunk S1/1
/// (L250); want-over-limit pins
/// s3::over_limit S1/1 (L258);
/// want-invalid-data pins
/// codec::invalid_data S1/1 (L337);
/// doc-leaf pins doc.txt S1/1 (L242);
/// wide-leaf pins wide.txt S1/1 (L251);
/// crud-cmd-count pins int (6) verbs;
/// hello-size pins int (5) len hello;
/// range-offset pins int (1) from L248;
/// range-length pins int (3) from L248;
/// repeat-count pins int (16384) from
/// L250; wide-size pins int (262144)
/// from L253 as 16 times 16384;
/// get-cap pins int (65536) from the
/// L255 bound note; payload-size pins
/// int (8192) from L107 and L336.
/// Facet map (pin order): cmd-put,
/// cmd-get, cmd-stat, cmd-exists,
/// cmd-range, cmd-stream,
/// want-put-usage, want-hello,
/// want-five, want-true, want-ell,
/// repeat-unit, want-over-limit,
/// want-invalid-data, doc-leaf,
/// wide-leaf, crud-cmd-count,
/// hello-size, range-offset,
/// range-length, repeat-count,
/// wide-size, get-cap, payload-size.
/// The listing plus sign plus fault legs
/// live in life-014-roots-green.can;
/// the offline plus env plus run shape
/// lives in life-014-run-shape.can.
/// Variants: crud, range, stream, size;
/// default plus seeded drifts only here.
/// Environment: staged bundle plus S3
/// gates (row lists three gates; bind at
/// P23; no live run now).
/// Logical gates QHTTP plus QStore plus
/// QF1 bind at P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live six minute
/// hold is pinned in the run slice;
/// binds at P23 like the M38 no-run
/// rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QStore plus QF1
/// accept gates unmet).
/// Case life/s3-crud-base checks:
/// cmd-put, cmd-get, cmd-stat,
/// cmd-exists, cmd-range, cmd-stream,
/// want-put-usage, want-hello,
/// want-five, want-true, want-ell,
/// repeat-unit, want-over-limit,
/// want-invalid-data, doc-leaf,
/// wide-leaf, crud-cmd-count,
/// hello-size, range-offset,
/// range-length, repeat-count,
/// wide-size, get-cap, payload-size.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str cmd_put
    str cmd_get
    str cmd_stat
    str cmd_exists
    str cmd_range
    str cmd_stream
    str want_put_usage
    str want_hello
    str want_five
    str want_true
    str want_ell
    str repeat_unit
    str want_over_limit
    str want_invalid_data
    str doc_leaf
    str wide_leaf
    int crud_cmd_count
    int hello_size
    int range_offset
    int range_length
    int repeat_count
    int wide_size
    int get_cap
    int payload_size
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/s3-crud-base", "default", "", "offline"), "cmd-put" => ok "case life/s3-crud-base variant default root cmd-put run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/s3-crud-base", "default", "", "offline"), "cmd-put" => ok evidence("cmd-put", "true", "true", true, "case life/s3-crud-base variant default root cmd-put run offline")
        different: false, true, context("life/s3-crud-base", "default", "", "offline"), "cmd-put" => failed{"cmd-put"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("life/s3-crud-base", "default", "", "offline"), "crud-cmd-count" => ok evidence("crud-cmd-count", "6", "6", true, "case life/s3-crud-base variant default root crud-cmd-count run offline")
        different: 5, 6, context("life/s3-crud-base", "default", "", "offline"), "crud-cmd-count" => failed{"crud-cmd-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "put", "put", context("life/s3-crud-base", "default", "", "offline"), "cmd-put" => ok evidence("cmd-put", "put", "put", true, "case life/s3-crud-base variant default root cmd-put run offline")
        different: "put_2", "put", context("life/s3-crud-base", "default", "", "offline"), "cmd-put" => failed{"cmd-put"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("put", "get", "stat", "exists", "range", "stream", "usage: put <key> <body>", "hello", "5", "true", "ell", "0123456789abcdef", "s3::over_limit", "codec::invalid_data", "doc.txt", "wide.txt", 6, 5, 1, 3, 16384, 262144, 65536, 8192)
        seed_cmd_put: "seed-cmd-put-drift" => ok observation("put_2", "get", "stat", "exists", "range", "stream", "usage: put <key> <body>", "hello", "5", "true", "ell", "0123456789abcdef", "s3::over_limit", "codec::invalid_data", "doc.txt", "wide.txt", 6, 5, 1, 3, 16384, 262144, 65536, 8192)
