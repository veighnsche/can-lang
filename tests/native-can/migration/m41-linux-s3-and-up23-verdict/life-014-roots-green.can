    asserts
        default: "default" => ok observation("ls", "lsall", "sign", "uput", "copy", "abort", "rm", "3", "1", "0", "multipart-body", "via-url", "cancelled", "deleted", "false", "s3::missing_key", "s3::invalid_config", "invalid_number", "s3::access_denied", "X-Amz-Signature=", "X-Amz-Expires=300", "GET", "PUT", "abc", 300, 200, 403, 30, 1048576, 14, 9, 3, 10)
        seed_cmd_ls: "seed-cmd-ls-drift" => ok observation("ls_2", "lsall", "sign", "uput", "copy", "abort", "rm", "3", "1", "0", "multipart-body", "via-url", "cancelled", "deleted", "false", "s3::missing_key", "s3::invalid_config", "invalid_number", "s3::access_denied", "X-Amz-Signature=", "X-Amz-Expires=300", "GET", "PUT", "abc", 300, 200, 403, 30, 1048576, 14, 9, 3, 10)
