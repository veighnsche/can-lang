package m41life014roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-014 TestCurrentS3Objects
/// listing plus sign plus multipart plus
/// copy plus abort plus fault slice.
/// Source: tests/integration/s3_test.go
/// symbol TestCurrentS3Objects (L44-348):
/// paged listing, signed GET and PUT
/// over plain HTTP, multipart put, copy,
/// abort, delete, and the fault matrix
/// (L259-346). Signed links stay out of
/// failure output: the check pins shape
/// markers and lengths only (L220-221).
/// Disposition: migrate (this row owns
/// the S3 matrix as reviewable Can
/// facts; the old go check stays until
/// the integrator retires it after every
/// linked row, variant, environment and
/// control has accepted proof).
/// Protects (this file): facet three
/// (paged listing, signed GET and PUT,
/// method refusal, multipart, copy,
/// abort, delete); facet four (missing,
/// bad config, bad number, denied, and
/// no signed-link leak); facet five
/// (closing listing is empty; deferred
/// sweep is attempted): the seven verbs,
/// the count and body wants, the four
/// fault codes, the sign shape markers
/// and methods, the bad-limit probe, and
/// the nine run tallies.
/// ADAPTATION (recorded, with source
/// lines): cmd pins hold CLI verbs (W
/// word counts); want pins hold exact
/// stdout wants (Q quoted counts); fault
/// pins hold fault codes; sign pins hold
/// shape markers (never link bytes);
/// count pins hold ints recomputed from
/// calls and lists.
/// cmd-ls pins ls W13/13 (L235, L260,
/// L264x2, L265, L266x2, L267x2, L343x3,
/// L346); cmd-lsall pins lsall W2/2
/// (L235, L265); cmd-sign pins sign W8/8
/// (L222, L225, L227, L231, L235, L268,
/// L271, L335); cmd-uput pins uput W2/2
/// (L235, L319); cmd-copy pins copy W2/2
/// (L235, L323); cmd-abort pins abort
/// W2/2 (L235, L327); cmd-rm pins rm
/// W4/4 (L235, L180, L329, L344);
/// want-ls-count pins 3 Q3/3 (L248,
/// L264, L265); want-one pins 1 Q4/4
/// (L248, L262, L265, L333);
/// want-final-empty pins 0 Q3/3 (L267,
/// L335, L346); want-multi-body pins
/// multipart-body Q2/2 (L319, L320);
/// want-via-url pins via-url Q2/2 (L290,
/// L303); want-cancelled pins cancelled
/// Q1/1 (L327); want-deleted pins
/// deleted Q2/2 (L329, L344); want-false
/// pins false Q2/2 (L328, L330);
/// want-missing pins s3::missing_key
/// S2/2 (L331, L332); want-bad-config
/// pins s3::invalid_config S3/3 (L267,
/// L334, L335); want-bad-number pins
/// invalid_number S2/2 (L266, L333; full
/// form by line ref); want-denied pins
/// s3::access_denied S1/1 (L340);
/// sign-sig pins X-Amz-Signature= S1/1
/// (L230); sign-exp pins X-Amz-Expires=300
/// S1/1 (L230); method-get pins GET Q2/2
/// (L268, L335); method-put pins PUT
/// Q3/3 (L271, L290, L304);
/// want-bad-limit pins abc Q1/1 (L266);
/// sign-expiry pins int (300) from L225;
/// http-ok pins int (200) from L287 and
/// L300; http-forbidden pins int (403)
/// from L314; client-timeout pins int
/// (30) from L272; fetch-cap pins int
/// (1048576) from L281 as 1 left 20;
/// multi-size pins int (14) len
/// multipart-body; sweep-count pins int
/// (9) from the L343 key list;
/// ls-seed-count pins int (3) from L259;
/// ls-limit pins int (10) from L264 and
/// L346.
/// Facet map (pin order): cmd-ls,
/// cmd-lsall, cmd-sign, cmd-uput,
/// cmd-copy, cmd-abort, cmd-rm,
/// want-ls-count, want-one,
/// want-final-empty, want-multi-body,
/// want-via-url, want-cancelled,
/// want-deleted, want-false,
/// want-missing, want-bad-config,
/// want-bad-number, want-denied,
/// sign-sig, sign-exp, method-get,
/// method-put, want-bad-limit,
/// sign-expiry, http-ok,
/// http-forbidden, client-timeout,
/// fetch-cap, multi-size, sweep-count,
/// ls-seed-count, ls-limit.
/// The crud plus size legs live in
/// life-014-base-semantics.can; the
/// offline plus env plus run shape lives
/// in life-014-run-shape.can.
/// Variants: listing, signature,
/// multipart, copy, cancel, fault;
/// default plus seeded drifts only here.
/// Environment: staged bundle plus S3
/// gates (row lists three gates; bind at
/// P23; no live run now).
/// Logical gates QHTTP plus QStore plus
/// QF1 bind at P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live six minute
/// hold is pinned in the run slice;
/// binds at P23 like the M38 no-run
/// rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QStore plus QF1
/// accept gates unmet).
/// Case life/s3-roots-green checks:
/// cmd-ls, cmd-lsall, cmd-sign,
/// cmd-uput, cmd-copy, cmd-abort,
/// cmd-rm, want-ls-count, want-one,
/// want-final-empty, want-multi-body,
/// want-via-url, want-cancelled,
/// want-deleted, want-false,
/// want-missing, want-bad-config,
/// want-bad-number, want-denied,
/// sign-sig, sign-exp, method-get,
/// method-put, want-bad-limit,
/// sign-expiry, http-ok,
/// http-forbidden, client-timeout,
/// fetch-cap, multi-size, sweep-count,
/// ls-seed-count, ls-limit.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str cmd_ls
    str cmd_lsall
    str cmd_sign
    str cmd_uput
    str cmd_copy
    str cmd_abort
    str cmd_rm
    str want_ls_count
    str want_one
    str want_final_empty
    str want_multi_body
    str want_via_url
    str want_cancelled
    str want_deleted
    str want_false
    str want_missing
    str want_bad_config
    str want_bad_number
    str want_denied
    str sign_sig
    str sign_exp
    str method_get
    str method_put
    str want_bad_limit
    int sign_expiry
    int http_ok
    int http_forbidden
    int client_timeout
    int fetch_cap
    int multi_size
    int sweep_count
    int ls_seed_count
    int ls_limit
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/s3-roots-green", "default", "", "offline"), "cmd-ls" => ok "case life/s3-roots-green variant default root cmd-ls run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/s3-roots-green", "default", "", "offline"), "cmd-ls" => ok evidence("cmd-ls", "true", "true", true, "case life/s3-roots-green variant default root cmd-ls run offline")
        different: false, true, context("life/s3-roots-green", "default", "", "offline"), "cmd-ls" => failed{"cmd-ls"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 300, 300, context("life/s3-roots-green", "default", "", "offline"), "sign-expiry" => ok evidence("sign-expiry", "300", "300", true, "case life/s3-roots-green variant default root sign-expiry run offline")
        different: 299, 300, context("life/s3-roots-green", "default", "", "offline"), "sign-expiry" => failed{"sign-expiry"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "ls", "ls", context("life/s3-roots-green", "default", "", "offline"), "cmd-ls" => ok evidence("cmd-ls", "ls", "ls", true, "case life/s3-roots-green variant default root cmd-ls run offline")
        different: "ls_2", "ls", context("life/s3-roots-green", "default", "", "offline"), "cmd-ls" => failed{"cmd-ls"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
