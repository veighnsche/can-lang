package m41life014run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M41 LIFE-014 TestCurrentS3Objects
/// offline plus env plus run-shape
/// slice.
/// Source: tests/integration/s3_test.go
/// symbol TestCurrentS3Objects (L44-348):
/// archive and S3 gates skip early
/// (L46-57); offline assert plus guarded
/// build run before any live call (L74,
/// L78); driver seeds the payload (L94);
/// live calls read hidden input from
/// fd-3, never from argv or the process
/// surroundings (L110-112, L141-163).
/// Denied pair by label L131-132 only;
/// its bytes are never pinned here.
/// Disposition: migrate (this row owns
/// the S3 run shape as reviewable Can
/// facts; the old go check stays until
/// the integrator retires it after every
/// linked row, variant, environment and
/// control has accepted proof).
/// Protects (this file): facet one
/// (offline assert and build plus live
/// cross-process holds plus fd-3 hidden
/// input) and the observes plus env
/// legs: the six env names, the two skip
/// notes, the helpers and verbs, the
/// fixture path, the guard binary and
/// policy, the runtime and entry leaf
/// names, the driver and payload rel
/// paths, the snapshot leaf names, the
/// fd label, the full usage line, the
/// closing log shape, the attach call,
/// the setup verb, and the six run
/// tallies.
/// ADAPTATION (recorded, with source
/// lines): env pins hold env names by
/// label (S counts; values never
/// pinned); note pins hold skip lines;
/// helper pins hold call names; verb
/// pins hold CLI words (Q quoted
/// counts); leaf pins hold file names;
/// rel pins hold repo paths; count pins
/// hold ints recomputed from guards,
/// lists and the usage line.
/// env-archive pins CAN_BUN_ARCHIVE
/// S2/2 (L46, L48); env-endpoint pins
/// CAN_TEST_S3_ENDPOINT S5/5 (L50, L56,
/// L96, L115, L128); env-region pins
/// CAN_TEST_S3_REGION S4/4 (L51, L96,
/// L116, L129); env-bucket pins
/// CAN_TEST_S3_BUCKET S4/4 (L52, L96,
/// L117, L130); env-access pins
/// CAN_TEST_S3_ACCESS_KEY S4/4 (L53,
/// L96, L118, L131); env-secret-name
/// pins CAN_TEST_S3_SECRET_KEY S4/4
/// (L54, L96, L119, L132; label only);
/// skip-archive-note pins the L48 skip
/// line S1/1; skip-s3-note pins the L56
/// skip line S1/1; helper-bundle pins
/// harnessBundle S1/1 (L61);
/// helper-canlc pins canlcOffline S1/1
/// (L74); cmd-assert pins assert Q1/1
/// (L74); cmd-build pins build Q1/1
/// (L78); manifest-src pins the fixture
/// path S1/0 (L25 helper, outside the
/// L44-348 span); sandbox-bin pins the
/// guard binary S1/1 (L78);
/// sandbox-policy pins the guard policy
/// S1/1 (L78); runtime-leaf pins
/// runtime/bun S3/3 (L94, L148, L180);
/// entry-leaf pins entry.ts S2/2 (L148,
/// L180); driver-rel pins the driver
/// path S1/1 (L93); payload-rel pins
/// the payload path S1/1 (L92);
/// snapshot-leaf pins snapshot.json
/// S1/1 (L113); denied-leaf pins
/// denied.json S1/1 (L137); fd-label
/// pins fd-3 S1/1 (L110); usage-line
/// pins the full L235 line S1/1;
/// live-note pins the L347 log shape
/// S1/1; extrafiles-call pins
/// ExtraFiles S2/2 (L151, L183);
/// setup-cmd pins setup Q1/1 (L94);
/// timeout-minutes pins int (6) from
/// L59; env-var-count pins int (5) from
/// L50-54; skip-site-count pins int (2)
/// from L48 and L56; usage-cmd-count
/// pins int (13) pipe parts of L235;
/// setup-field-count pins int (4) from
/// L101-106; usage-probe-count pins int
/// (3) from L236-238.
/// Facet map (pin order): env-archive,
/// env-endpoint, env-region,
/// env-bucket, env-access,
/// env-secret-name, skip-archive-note,
/// skip-s3-note, helper-bundle,
/// helper-canlc, cmd-assert, cmd-build,
/// manifest-src, sandbox-bin,
/// sandbox-policy, runtime-leaf,
/// entry-leaf, driver-rel,
/// payload-rel, snapshot-leaf,
/// denied-leaf, fd-label, usage-line,
/// live-note, extrafiles-call,
/// setup-cmd, timeout-minutes,
/// env-var-count, skip-site-count,
/// usage-cmd-count, setup-field-count,
/// usage-probe-count.
/// The crud plus size legs live in
/// life-014-base-semantics.can; the
/// listing plus sign plus fault legs
/// live in life-014-roots-green.can.
/// Variants: usage plus setup plus
/// hidden-input run shape; default plus
/// seeded drifts only here.
/// Environment: staged bundle plus S3
/// gates (row lists three gates; bind at
/// P23; no live run now).
/// Logical gates QHTTP plus QStore plus
/// QF1 bind at P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (the live six minute
/// hold is pinned above; binds at P23
/// like the M38 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QHTTP plus QStore plus QF1
/// accept gates unmet).
/// Case life/s3-run-shape checks:
/// env-archive, env-endpoint,
/// env-region, env-bucket, env-access,
/// env-secret-name, skip-archive-note,
/// skip-s3-note, helper-bundle,
/// helper-canlc, cmd-assert, cmd-build,
/// manifest-src, sandbox-bin,
/// sandbox-policy, runtime-leaf,
/// entry-leaf, driver-rel,
/// payload-rel, snapshot-leaf,
/// denied-leaf, fd-label, usage-line,
/// live-note, extrafiles-call,
/// setup-cmd, timeout-minutes,
/// env-var-count, skip-site-count,
/// usage-cmd-count, setup-field-count,
/// usage-probe-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_archive
    str env_endpoint
    str env_region
    str env_bucket
    str env_access
    str env_secret_name
    str skip_archive_note
    str skip_s3_note
    str helper_bundle
    str helper_canlc
    str cmd_assert
    str cmd_build
    str manifest_src
    str sandbox_bin
    str sandbox_policy
    str runtime_leaf
    str entry_leaf
    str driver_rel
    str payload_rel
    str snapshot_leaf
    str denied_leaf
    str fd_label
    str usage_line
    str live_note
    str extrafiles_call
    str setup_cmd
    int timeout_minutes
    int env_var_count
    int skip_site_count
    int usage_cmd_count
    int setup_field_count
    int usage_probe_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/s3-run-shape", "default", "", "offline"), "env-archive" => ok "case life/s3-run-shape variant default root env-archive run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/s3-run-shape", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "true", "true", true, "case life/s3-run-shape variant default root env-archive run offline")
        different: false, true, context("life/s3-run-shape", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("life/s3-run-shape", "default", "", "offline"), "timeout-minutes" => ok evidence("timeout-minutes", "6", "6", true, "case life/s3-run-shape variant default root timeout-minutes run offline")
        different: 5, 6, context("life/s3-run-shape", "default", "", "offline"), "timeout-minutes" => failed{"timeout-minutes"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", context("life/s3-run-shape", "default", "", "offline"), "env-archive" => ok evidence("env-archive", "CAN_BUN_ARCHIVE", "CAN_BUN_ARCHIVE", true, "case life/s3-run-shape variant default root env-archive run offline")
        different: "CAN_BUN_ARCHIVE_2", "CAN_BUN_ARCHIVE", context("life/s3-run-shape", "default", "", "offline"), "env-archive" => failed{"env-archive"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
