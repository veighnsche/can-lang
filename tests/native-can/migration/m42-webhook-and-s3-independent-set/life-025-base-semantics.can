package m42life025base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M42 LIFE-025 webhook driver setup
/// schema legs.
/// Source: tests/integration/
/// testdata/webhook/driver.ts symbol
/// setup (L27-45): five schema legs
/// must each open with the guard
/// prefix; count drift refuses.
/// Disposition: replace_support (this
/// row owns setup plus inspect as
/// reviewable Can facts; driver.ts
/// stays until every webhook plus
/// lifecycle scenario uses Can setup).
/// Protects (this file): five-table
/// schema setup validation: mode word,
/// count note, guard prefix, guard
/// refusal, missing arg notes, comment
/// marker, tables key, separator, plus
/// arg index pins.
/// ADAPTATION (recorded, with source
/// lines): setup-mode-word pins setup
/// (L27); schema-count-note pins the
/// count refusal head (L38);
/// table-prefix-guard pins the CREATE
/// guard head (L40); guard-note pins
/// the refusal line (L41);
/// db-missing-note pins the db arg
/// refusal (L24); schema-missing-note
/// pins the schema arg refusal (L29);
/// comment-marker pins the dash pair
/// (L33); tables-key pins the tables
/// key (L45); statement-separator pins
/// the split mark (L35);
/// schema-statement-count pins int (5)
/// from L38; mode-arg-index pins int
/// (2) from L22; db-arg-index pins int
/// (3) from L23; schema-arg-index pins
/// int (4) from L28.
/// Facet map (leg order):
/// setup-mode-word, schema-count-note,
/// table-prefix-guard, guard-note,
/// db-missing-note,
/// schema-missing-note, comment-marker,
/// tables-key, statement-separator,
/// schema-statement-count, mode-arg-index,
/// db-arg-index, schema-arg-index.
/// The five inspect queries live in
/// life-025-roots-green.can; driver
/// shape lives in
/// life-025-run-shape.can.
/// Variants: none.
/// Environment: none (no live run
/// now; binds at P23 plus QD1).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Case life/webhook-setup-schema
/// checks: setup-mode-word,
/// schema-count-note,
/// table-prefix-guard, guard-note,
/// db-missing-note,
/// schema-missing-note, comment-marker,
/// tables-key, statement-separator,
/// schema-statement-count, mode-arg-index,
/// db-arg-index, schema-arg-index.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str setup_mode_word
    str schema_count_note
    str table_prefix_guard
    str guard_note
    str db_missing_note
    str schema_missing_note
    str comment_marker
    str tables_key
    str statement_separator
    int schema_statement_count
    int mode_arg_index
    int db_arg_index
    int schema_arg_index
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/webhook-setup-schema", "default", "", "offline"), "setup-mode-word" => ok "case life/webhook-setup-schema variant default root setup-mode-word run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/webhook-setup-schema", "default", "", "offline"), "setup-mode-word" => ok evidence("setup-mode-word", "true", "true", true, "case life/webhook-setup-schema variant default root setup-mode-word run offline")
        different: false, true, context("life/webhook-setup-schema", "default", "", "offline"), "setup-mode-word" => failed{"setup-mode-word"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("life/webhook-setup-schema", "default", "", "offline"), "schema-statement-count" => ok evidence("schema-statement-count", "5", "5", true, "case life/webhook-setup-schema variant default root schema-statement-count run offline")
        different: 4, 5, context("life/webhook-setup-schema", "default", "", "offline"), "schema-statement-count" => failed{"schema-statement-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "setup", "setup", context("life/webhook-setup-schema", "default", "", "offline"), "setup-mode-word" => ok evidence("setup-mode-word", "setup", "setup", true, "case life/webhook-setup-schema variant default root setup-mode-word run offline")
        different: "setup_2", "setup", context("life/webhook-setup-schema", "default", "", "offline"), "setup-mode-word" => failed{"setup-mode-word"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
