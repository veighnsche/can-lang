package m42life025roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M42 LIFE-025 webhook driver inspect
/// query legs.
/// Source: tests/integration/
/// testdata/webhook/driver.ts symbol
/// inspect (L46-54): five ordered
/// SELECT legs over ledger, outbox,
/// attempt, dead-letter, plus nonce;
/// large ints ride as strings.
/// Disposition: replace_support (this
/// row owns setup plus inspect as
/// reviewable Can facts; driver.ts
/// stays until every webhook plus
/// lifecycle scenario uses Can setup).
/// Protects (this file): ordered
/// ledger, outbox, attempt, dead-letter,
/// plus nonce views with large ints
/// held: mode word, five full SELECT
/// legs, three order keys, plus column
/// tallies.
/// ADAPTATION (recorded, with source
/// lines): inspect-mode-word pins
/// inspect (L46); ledger-query pins
/// the ledger SELECT (L47);
/// outbox-query pins the outbox SELECT
/// (L48); attempt-query pins the
/// attempt SELECT (L49); dead-query
/// pins the dead-letter SELECT (L50);
/// nonce-query pins the nonce SELECT
/// (L51); order-delivery-key pins the
/// delivery order key (L47);
/// order-attempt-key pins the id order
/// key (L49); order-nonce-key pins the
/// nonce order key (L51);
/// inspect-query-count pins int (5)
/// from L47-51; ledger-column-count
/// pins int (6) from L47;
/// outbox-column-count pins int (9)
/// from L48; attempt-column-count pins
/// int (4) from L49; dead-column-count
/// pins int (6) from L50;
/// nonce-column-count pins int (2)
/// from L51; observed-table-count pins
/// int (5) from L47-51.
/// Facet map (leg order):
/// inspect-mode-word, ledger-query,
/// outbox-query, attempt-query,
/// dead-query, nonce-query,
/// order-delivery-key, order-attempt-key,
/// order-nonce-key, inspect-query-count,
/// ledger-column-count,
/// outbox-column-count,
/// attempt-column-count,
/// dead-column-count, nonce-column-count,
/// observed-table-count.
/// The schema setup legs live in
/// life-025-base-semantics.can; driver
/// shape lives in
/// life-025-run-shape.can.
/// Variants: none.
/// Environment: none (no live run
/// now; binds at P23 plus QD1).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Case life/webhook-inspect-queries
/// checks: inspect-mode-word,
/// ledger-query, outbox-query,
/// attempt-query, dead-query,
/// nonce-query, order-delivery-key,
/// order-attempt-key, order-nonce-key,
/// inspect-query-count,
/// ledger-column-count,
/// outbox-column-count,
/// attempt-column-count,
/// dead-column-count, nonce-column-count,
/// observed-table-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str inspect_mode_word
    str ledger_query
    str outbox_query
    str attempt_query
    str dead_query
    str nonce_query
    str order_delivery_key
    str order_attempt_key
    str order_nonce_key
    int inspect_query_count
    int ledger_column_count
    int outbox_column_count
    int attempt_column_count
    int dead_column_count
    int nonce_column_count
    int observed_table_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/webhook-inspect-queries", "default", "", "offline"), "inspect-mode-word" => ok "case life/webhook-inspect-queries variant default root inspect-mode-word run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/webhook-inspect-queries", "default", "", "offline"), "inspect-mode-word" => ok evidence("inspect-mode-word", "true", "true", true, "case life/webhook-inspect-queries variant default root inspect-mode-word run offline")
        different: false, true, context("life/webhook-inspect-queries", "default", "", "offline"), "inspect-mode-word" => failed{"inspect-mode-word"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("life/webhook-inspect-queries", "default", "", "offline"), "inspect-query-count" => ok evidence("inspect-query-count", "5", "5", true, "case life/webhook-inspect-queries variant default root inspect-query-count run offline")
        different: 4, 5, context("life/webhook-inspect-queries", "default", "", "offline"), "inspect-query-count" => failed{"inspect-query-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "inspect", "inspect", context("life/webhook-inspect-queries", "default", "", "offline"), "inspect-mode-word" => ok evidence("inspect-mode-word", "inspect", "inspect", true, "case life/webhook-inspect-queries variant default root inspect-mode-word run offline")
        different: "inspect_2", "inspect", context("life/webhook-inspect-queries", "default", "", "offline"), "inspect-mode-word" => failed{"inspect-mode-word"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
