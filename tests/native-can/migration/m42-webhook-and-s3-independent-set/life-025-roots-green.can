        seed_ledger_column_count: context("life/webhook-inspect-queries", "seed-ledger-column-count-drift", "", "offline") => failed{"ledger-column-count"}
        seed_outbox_column_count: context("life/webhook-inspect-queries", "seed-outbox-column-count-drift", "", "offline") => failed{"outbox-column-count"}
        seed_attempt_column_count: context("life/webhook-inspect-queries", "seed-attempt-column-count-drift", "", "offline") => failed{"attempt-column-count"}
        seed_dead_column_count: context("life/webhook-inspect-queries", "seed-dead-column-count-drift", "", "offline") => failed{"dead-column-count"}
        seed_nonce_column_count: context("life/webhook-inspect-queries", "seed-nonce-column-count-drift", "", "offline") => failed{"nonce-column-count"}
        seed_observed_table_count: context("life/webhook-inspect-queries", "seed-observed-table-count-drift", "", "offline") => failed{"observed-table-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.inspect_mode_word, "inspect", c, "inspect-mode-word")
            failed
            ok evidence inspect_mode_word_evidence => match call require_text(got.ledger_query, "SELECT delivery_id, digest, event, subscription, outcome, received_ms FROM webhook_ledger ORDER BY delivery_id", c, "ledger-query")
                failed
