                                                    failed
                                                    ok evidence ledger_column_count_evidence => match call require_int(got.outbox_column_count, 9, c, "outbox-column-count")
                                                        failed
                                                        ok evidence outbox_column_count_evidence => match call require_int(got.attempt_column_count, 4, c, "attempt-column-count")
                                                            failed
                                                            ok evidence attempt_column_count_evidence => match call require_int(got.dead_column_count, 6, c, "dead-column-count")
                                                                failed
                                                                ok evidence dead_column_count_evidence => match call require_int(got.nonce_column_count, 2, c, "nonce-column-count")
                                                                    failed
                                                                    ok evidence nonce_column_count_evidence => match call require_int(got.observed_table_count, 5, c, "observed-table-count")
                                                                        failed
                                                                        ok evidence observed_table_count_evidence => ok
