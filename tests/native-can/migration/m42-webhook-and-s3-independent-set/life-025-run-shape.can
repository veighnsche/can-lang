package m42life025run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M42 LIFE-025 webhook driver run
/// shape.
/// Source: tests/integration/
/// testdata/webhook/driver.ts run
/// frame (L9-64): staticTemplate
/// call legs, bigint hold with base
/// ten, frozen JSON keys, arg names,
/// plus close.
/// Disposition: replace_support (this
/// row owns setup plus inspect as
/// reviewable Can facts; driver.ts
/// stays until every webhook plus
/// lifecycle scenario uses Can setup).
/// Protects (this file): driver run
/// shape holding the two facets:
/// adapter name, safe ints key,
/// bigint kind, toString call, unknown
/// mode head, arg names, five frozen
/// keys, static fn name, close call,
/// plus site tallies.
/// ADAPTATION (recorded, with source
/// lines): adapter-name pins sqlite
/// (L25); safe-integers-key pins the
/// safeInts key (L25); bigint-kind
/// pins bigint (L17); to-string-call
/// pins toString (L17);
/// unknown-mode-note pins the unknown
/// mode head (L56); mode-arg-name pins
/// mode (L22); db-arg-name pins dbPath
/// (L23); schema-arg-name pins
/// schemaPath (L28); freeze-ledger-key
/// pins ledger (L54); freeze-outbox-key
/// pins outbox (L54);
/// freeze-attempts-key pins attempts
/// (L54); freeze-dead-key pins dead
/// (L54); freeze-nonces-key pins
/// nonces (L54); static-fn-name pins
/// staticTemplate (L11); close-call
/// pins close (L59); run-mode-count
/// pins int (2) from L27 plus L46;
/// freeze-key-count pins int (5) from
/// L54; to-string-radix pins int (10)
/// from L17; setup-template-sites pins
/// int (1) from L43;
/// inspect-template-sites pins int (5)
/// from L47-51.
/// Facet map (leg order):
/// adapter-name, safe-integers-key,
/// bigint-kind, to-string-call,
/// unknown-mode-note, mode-arg-name,
/// db-arg-name, schema-arg-name,
/// freeze-ledger-key, freeze-outbox-key,
/// freeze-attempts-key, freeze-dead-key,
/// freeze-nonces-key, static-fn-name,
/// close-call, run-mode-count,
/// freeze-key-count, to-string-radix,
/// setup-template-sites,
/// inspect-template-sites.
/// The schema setup legs live in
/// life-025-base-semantics.can; the
/// five inspect queries live in
/// life-025-roots-green.can.
/// Variants: none.
/// Environment: none (no live run
/// now; binds at P23 plus QD1).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Case life/webhook-driver-shape
/// checks: adapter-name,
/// safe-integers-key, bigint-kind,
/// to-string-call, unknown-mode-note,
/// mode-arg-name, db-arg-name,
/// schema-arg-name, freeze-ledger-key,
/// freeze-outbox-key,
/// freeze-attempts-key, freeze-dead-key,
/// freeze-nonces-key, static-fn-name,
/// close-call, run-mode-count,
/// freeze-key-count, to-string-radix,
/// setup-template-sites,
/// inspect-template-sites.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str adapter_name
    str safe_integers_key
    str bigint_kind
    str to_string_call
    str unknown_mode_note
    str mode_arg_name
    str db_arg_name
    str schema_arg_name
    str freeze_ledger_key
    str freeze_outbox_key
    str freeze_attempts_key
    str freeze_dead_key
    str freeze_nonces_key
    str static_fn_name
    str close_call
    int run_mode_count
    int freeze_key_count
    int to_string_radix
    int setup_template_sites
    int inspect_template_sites
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/webhook-driver-shape", "default", "", "offline"), "adapter-name" => ok "case life/webhook-driver-shape variant default root adapter-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/webhook-driver-shape", "default", "", "offline"), "adapter-name" => ok evidence("adapter-name", "true", "true", true, "case life/webhook-driver-shape variant default root adapter-name run offline")
        different: false, true, context("life/webhook-driver-shape", "default", "", "offline"), "adapter-name" => failed{"adapter-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/webhook-driver-shape", "default", "", "offline"), "run-mode-count" => ok evidence("run-mode-count", "2", "2", true, "case life/webhook-driver-shape variant default root run-mode-count run offline")
        different: 1, 2, context("life/webhook-driver-shape", "default", "", "offline"), "run-mode-count" => failed{"run-mode-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "sqlite", "sqlite", context("life/webhook-driver-shape", "default", "", "offline"), "adapter-name" => ok evidence("adapter-name", "sqlite", "sqlite", true, "case life/webhook-driver-shape variant default root adapter-name run offline")
        different: "sqlite_2", "sqlite", context("life/webhook-driver-shape", "default", "", "offline"), "adapter-name" => failed{"adapter-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
