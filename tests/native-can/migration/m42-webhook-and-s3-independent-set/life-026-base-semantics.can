        "seed-payload-file-name-drift" => ok observation("setup", "payload.bin_2", "application/octet-stream", "staged", "list", "write", "stat", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
        "seed-payload-content-kind-drift" => ok observation("setup", "payload.bin", "application/octet-stream_2", "staged", "list", "write", "stat", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
        "seed-staged-key-name-drift" => ok observation("setup", "payload.bin", "application/octet-stream", "staged_2", "list", "write", "stat", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
