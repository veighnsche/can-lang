    asserts
        default: "default" => ok observation("setup", "payload.bin", "application/octet-stream", "staged", "list", "write", "stat", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
        seed_setup_command_word: "seed-setup-command-word-drift" => ok observation("setup_2", "payload.bin", "application/octet-stream", "staged", "list", "write", "stat", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
        seed_payload_file_name: "seed-payload-file-name-drift" => ok observation("setup", "payload.bin_2", "application/octet-stream", "staged", "list", "write", "stat", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
