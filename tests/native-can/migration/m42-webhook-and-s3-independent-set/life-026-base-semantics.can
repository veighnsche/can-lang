fn check[] checks
    emits {}
    given
        str scope
    asserts
        m42_l026: "m42-l026" => ok [check("setup-command-word", "seed keeps its mode word"), check("payload-file-name", "seed keeps its payload name"), check("payload-content-kind", "seed keeps its octet kind"), check("staged-key-name", "seed keeps its staged name"), check("s3-list-word", "seed keeps its list call"), check("s3-write-word", "seed keeps its write call"), check("s3-stat-word", "seed keeps its stat call"), check("payload-read-word", "seed keeps its byte read"), check("file-handle-word", "seed keeps its file grip"), check("payload-md5", "seed keeps its payload digest"), check("payload-byte-size", "seed holds its byte size"), check("list-max-keys", "list caps its probe depth")]
        other: "nope" => ok []
    match scope is "m42-l026"
        false => ok []
        true => ok [check("setup-command-word", "seed keeps its mode word"), check("payload-file-name", "seed keeps its payload name"), check("payload-content-kind", "seed keeps its octet kind"), check("staged-key-name", "seed keeps its staged name"), check("s3-list-word", "seed keeps its list call"), check("s3-write-word", "seed keeps its write call"), check("s3-stat-word", "seed keeps its stat call"), check("payload-read-word", "seed keeps its byte read"), check("file-handle-word", "seed keeps its file grip"), check("payload-md5", "seed keeps its payload digest"), check("payload-byte-size", "seed holds its byte size"), check("list-max-keys", "list caps its probe depth")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "life/s3-setup-seed" => ok [expected_check("setup-command-word", "setup"), expected_check("payload-file-name", "payload.bin"), expected_check("payload-content-kind", "application/octet-stream"), expected_check("staged-key-name", "staged"), expected_check("s3-list-word", "list"), expected_check("s3-write-word", "write"), expected_check("s3-stat-word", "stat"), expected_check("payload-read-word", "bytes()"), expected_check("file-handle-word", "client.file"), expected_check("payload-md5", "49ec8ab98244ee371f4bd7621f90281b"), expected_check("payload-byte-size", "8192"), expected_check("list-max-keys", "1")]
        unknown: "nope" => ok []
    match case is "life/s3-setup-seed"
        false => ok []
        true => ok [expected_check("setup-command-word", "setup"), expected_check("payload-file-name", "payload.bin"), expected_check("payload-content-kind", "application/octet-stream"), expected_check("staged-key-name", "staged"), expected_check("s3-list-word", "list"), expected_check("s3-write-word", "write"), expected_check("s3-stat-word", "stat"), expected_check("payload-read-word", "bytes()"), expected_check("file-handle-word", "client.file"), expected_check("payload-md5", "49ec8ab98244ee371f4bd7621f90281b"), expected_check("payload-byte-size", "8192"), expected_check("list-max-keys", "1")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/s3-setup-seed", "default", "", "offline") => ok
        seed_setup_command_word: context("life/s3-setup-seed", "seed-setup-command-word-drift", "", "offline") => failed{"setup-command-word"}
        seed_payload_file_name: context("life/s3-setup-seed", "seed-payload-file-name-drift", "", "offline") => failed{"payload-file-name"}
        seed_payload_content_kind: context("life/s3-setup-seed", "seed-payload-content-kind-drift", "", "offline") => failed{"payload-content-kind"}
        seed_staged_key_name: context("life/s3-setup-seed", "seed-staged-key-name-drift", "", "offline") => failed{"staged-key-name"}
        seed_s3_list_word: context("life/s3-setup-seed", "seed-s3-list-word-drift", "", "offline") => failed{"s3-list-word"}
        seed_s3_write_word: context("life/s3-setup-seed", "seed-s3-write-word-drift", "", "offline") => failed{"s3-write-word"}
        seed_s3_stat_word: context("life/s3-setup-seed", "seed-s3-stat-word-drift", "", "offline") => failed{"s3-stat-word"}
        seed_payload_read_word: context("life/s3-setup-seed", "seed-payload-read-word-drift", "", "offline") => failed{"payload-read-word"}
        seed_file_handle_word: context("life/s3-setup-seed", "seed-file-handle-word-drift", "", "offline") => failed{"file-handle-word"}
        seed_payload_md5: context("life/s3-setup-seed", "seed-payload-md5-drift", "", "offline") => failed{"payload-md5"}
        seed_payload_byte_size: context("life/s3-setup-seed", "seed-payload-byte-size-drift", "", "offline") => failed{"payload-byte-size"}
        seed_list_max_keys: context("life/s3-setup-seed", "seed-list-max-keys-drift", "", "offline") => failed{"list-max-keys"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.setup_command_word, "setup", c, "setup-command-word")
            failed
            ok evidence setup_command_word_evidence => match call require_text(got.payload_file_name, "payload.bin", c, "payload-file-name")
                failed
                ok evidence payload_file_name_evidence => match call require_text(got.payload_content_kind, "application/octet-stream", c, "payload-content-kind")
                    failed
                    ok evidence payload_content_kind_evidence => match call require_text(got.staged_key_name, "staged", c, "staged-key-name")
                        failed
                        ok evidence staged_key_name_evidence => match call require_text(got.s3_list_word, "list", c, "s3-list-word")
                            failed
                            ok evidence s3_list_word_evidence => match call require_text(got.s3_write_word, "write", c, "s3-write-word")
                                failed
                                ok evidence s3_write_word_evidence => match call require_text(got.s3_stat_word, "stat", c, "s3-stat-word")
                                    failed
                                    ok evidence s3_stat_word_evidence => match call require_text(got.payload_read_word, "bytes()", c, "payload-read-word")
                                        failed
                                        ok evidence payload_read_word_evidence => match call require_text(got.file_handle_word, "client.file", c, "file-handle-word")
                                            failed
                                            ok evidence file_handle_word_evidence => match call require_text(got.payload_md5, "49ec8ab98244ee371f4bd7621f90281b", c, "payload-md5")
                                                failed
                                                ok evidence payload_md5_evidence => match call require_int(got.payload_byte_size, 8192, c, "payload-byte-size")
                                                    failed
                                                    ok evidence payload_byte_size_evidence => match call require_int(got.list_max_keys, 1, c, "list-max-keys")
                                                        failed
                                                        ok evidence list_max_keys_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m42_l026: "m42-l026" => ok test_case("life/s3-setup-seed", ["life", "m42"], [], 120000, [check_ref("setup-command-word"), check_ref("payload-file-name"), check_ref("payload-content-kind"), check_ref("staged-key-name"), check_ref("s3-list-word"), check_ref("s3-write-word"), check_ref("s3-stat-word"), check_ref("payload-read-word"), check_ref("file-handle-word"), check_ref("payload-md5"), check_ref("payload-byte-size"), check_ref("list-max-keys")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m42-l026"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/s3-setup-seed", ["life", "m42"], [], 120000, [check_ref("setup-command-word"), check_ref("payload-file-name"), check_ref("payload-content-kind"), check_ref("staged-key-name"), check_ref("s3-list-word"), check_ref("s3-write-word"), check_ref("s3-stat-word"), check_ref("payload-read-word"), check_ref("file-handle-word"), check_ref("payload-md5"), check_ref("payload-byte-size"), check_ref("list-max-keys")], callable case_body)
