        seed_s3_write_word: "seed-s3-write-word-drift" => ok observation("setup", "payload.bin", "application/octet-stream", "staged", "list", "write_2", "stat", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
        seed_s3_stat_word: "seed-s3-stat-word-drift" => ok observation("setup", "payload.bin", "application/octet-stream", "staged", "list", "write", "stat_2", "bytes()", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
        seed_payload_read_word: "seed-payload-read-word-drift" => ok observation("setup", "payload.bin", "application/octet-stream", "staged", "list", "write", "stat", "bytes()_2", "client.file", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
        seed_file_handle_word: "seed-file-handle-word-drift" => ok observation("setup", "payload.bin", "application/octet-stream", "staged", "list", "write", "stat", "bytes()", "client.file_2", "49ec8ab98244ee371f4bd7621f90281b", 8192, 1)
