package m42life026base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M42 LIFE-026 s3 driver setup
/// seed legs.
/// Source: tests/integration/
/// testdata/s3/s3-driver.ts plus
/// payload.bin: setup stages the
/// binary seed under the run
/// prefix; size drift refuses.
/// Disposition: replace_support (this
/// row owns setup as reviewable Can
/// facts; s3-driver.ts plus
/// payload.bin stay until every s3
/// scenario uses Can setup).
/// Protects (this file): reachable
/// bucket seed of the 8192 byte
/// payload: mode word, payload name,
/// octet kind, staged name, list plus
/// write plus stat words, byte read,
/// file grip, payload digest, plus
/// size and depth pins.
/// ADAPTATION (recorded, with source
/// lines): setup-command-word pins
/// setup (L12); payload-file-name
/// pins payload.bin (L25);
/// payload-content-kind pins the
/// octet kind (L26); staged-key-name
/// pins staged (L25);
/// s3-list-word pins list (L23);
/// s3-write-word pins write (L26);
/// s3-stat-word pins stat (L27);
/// payload-read-word pins bytes
/// (L24); file-handle-word pins the
/// client grip (L26);
/// payload-md5 pins the fixture
/// digest (payload.bin md5);
/// payload-byte-size pins int (8192)
/// from payload.bin;
/// list-max-keys pins int (1) from
/// L23.
/// Facet map (leg order):
/// setup-command-word,
/// payload-file-name,
/// payload-content-kind,
/// staged-key-name, s3-list-word,
/// s3-write-word, s3-stat-word,
/// payload-read-word,
/// file-handle-word, payload-md5,
/// payload-byte-size, list-max-keys.
/// The credential-free report legs
/// live in life-026-roots-green.can;
/// driver shape lives in
/// life-026-run-shape.can.
/// Variants: none.
/// Environment: none (no live run
/// now; binds at P23 plus QStore).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QStore accept gates unmet).
/// Case life/s3-setup-seed
/// checks: setup-command-word,
/// payload-file-name,
/// payload-content-kind,
/// staged-key-name, s3-list-word,
/// s3-write-word, s3-stat-word,
/// payload-read-word,
/// file-handle-word, payload-md5,
/// payload-byte-size, list-max-keys.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str setup_command_word
    str payload_file_name
    str payload_content_kind
    str staged_key_name
    str s3_list_word
    str s3_write_word
    str s3_stat_word
    str payload_read_word
    str file_handle_word
    str payload_md5
    int payload_byte_size
    int list_max_keys
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/s3-setup-seed", "default", "", "offline"), "setup-command-word" => ok "case life/s3-setup-seed variant default root setup-command-word run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/s3-setup-seed", "default", "", "offline"), "setup-command-word" => ok evidence("setup-command-word", "true", "true", true, "case life/s3-setup-seed variant default root setup-command-word run offline")
        different: false, true, context("life/s3-setup-seed", "default", "", "offline"), "setup-command-word" => failed{"setup-command-word"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 8192, 8192, context("life/s3-setup-seed", "default", "", "offline"), "payload-byte-size" => ok evidence("payload-byte-size", "8192", "8192", true, "case life/s3-setup-seed variant default root payload-byte-size run offline")
        different: 8191, 8192, context("life/s3-setup-seed", "default", "", "offline"), "payload-byte-size" => failed{"payload-byte-size"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "setup", "setup", context("life/s3-setup-seed", "default", "", "offline"), "setup-command-word" => ok evidence("setup-command-word", "setup", "setup", true, "case life/s3-setup-seed variant default root setup-command-word run offline")
        different: "setup_2", "setup", context("life/s3-setup-seed", "default", "", "offline"), "setup-command-word" => failed{"setup-command-word"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
