package m42life026roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M42 LIFE-026 s3 setup report
/// legs.
/// Source: tests/integration/
/// testdata/s3/s3-driver.ts L28-29:
/// host plus bucket plus staged
/// plus size leave; alias names
/// never enter the report.
/// Disposition: replace_support (this
/// row owns setup as reviewable Can
/// facts; s3-driver.ts plus
/// payload.bin stay until every s3
/// scenario uses Can setup).
/// Protects (this file):
/// credential-free report: host key,
/// bucket key, size key, host shape,
/// size shape, encode call, emit
/// call, guard note, first plus
/// second alias names, plus field
/// and call tallies.
/// ADAPTATION (recorded, with source
/// lines): report-host-key pins host
/// (L29); report-bucket-key pins
/// bucket (L29); report-size-key
/// pins size (L29);
/// report-host-shape pins the host
/// build (L29); report-size-shape
/// pins stat.size (L29);
/// report-encode-call pins the
/// encode call (L29);
/// report-emit-call pins the emit
/// call (L29); credential-guard-note
/// pins the guard line (L28);
/// credential-first-name pins the
/// first alias (L9);
/// credential-second-name pins the
/// second alias (L10);
/// report-field-count pins int (4)
/// from L29; s3-call-count pins int
/// (3) from L23 plus L26-27.
/// Facet map (leg order):
/// report-host-key,
/// report-bucket-key, report-size-key,
/// report-host-shape,
/// report-size-shape,
/// report-encode-call,
/// report-emit-call,
/// credential-guard-note,
/// credential-first-name,
/// credential-second-name,
/// report-field-count, s3-call-count.
/// The seed legs live in
/// life-026-base-semantics.can;
/// driver shape lives in
/// life-026-run-shape.can.
/// Variants: none.
/// Environment: none (no live run
/// now; binds at P23 plus QStore).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QStore accept gates unmet).
/// Case life/s3-setup-report
/// checks: report-host-key,
/// report-bucket-key, report-size-key,
/// report-host-shape,
/// report-size-shape,
/// report-encode-call,
/// report-emit-call,
/// credential-guard-note,
/// credential-first-name,
/// credential-second-name,
/// report-field-count, s3-call-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str report_host_key
    str report_bucket_key
    str report_size_key
    str report_host_shape
    str report_size_shape
    str report_encode_call
    str report_emit_call
    str credential_guard_note
    str credential_first_name
    str credential_second_name
    int report_field_count
    int s3_call_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/s3-setup-report", "default", "", "offline"), "report-host-key" => ok "case life/s3-setup-report variant default root report-host-key run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/s3-setup-report", "default", "", "offline"), "report-host-key" => ok evidence("report-host-key", "true", "true", true, "case life/s3-setup-report variant default root report-host-key run offline")
        different: false, true, context("life/s3-setup-report", "default", "", "offline"), "report-host-key" => failed{"report-host-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("life/s3-setup-report", "default", "", "offline"), "report-field-count" => ok evidence("report-field-count", "4", "4", true, "case life/s3-setup-report variant default root report-field-count run offline")
        different: 3, 4, context("life/s3-setup-report", "default", "", "offline"), "report-field-count" => failed{"report-field-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "host", "host", context("life/s3-setup-report", "default", "", "offline"), "report-host-key" => ok evidence("report-host-key", "host", "host", true, "case life/s3-setup-report variant default root report-host-key run offline")
        different: "host_2", "host", context("life/s3-setup-report", "default", "", "offline"), "report-host-key" => failed{"report-host-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
