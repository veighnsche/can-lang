fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("life/s3-setup-report", "default", "", "offline") => ok
        seed_report_host_key: context("life/s3-setup-report", "seed-report-host-key-drift", "", "offline") => failed{"report-host-key"}
        seed_report_bucket_key: context("life/s3-setup-report", "seed-report-bucket-key-drift", "", "offline") => failed{"report-bucket-key"}
        seed_report_size_key: context("life/s3-setup-report", "seed-report-size-key-drift", "", "offline") => failed{"report-size-key"}
        seed_report_host_shape: context("life/s3-setup-report", "seed-report-host-shape-drift", "", "offline") => failed{"report-host-shape"}
        seed_report_size_shape: context("life/s3-setup-report", "seed-report-size-shape-drift", "", "offline") => failed{"report-size-shape"}
        seed_report_encode_call: context("life/s3-setup-report", "seed-report-encode-call-drift", "", "offline") => failed{"report-encode-call"}
        seed_report_emit_call: context("life/s3-setup-report", "seed-report-emit-call-drift", "", "offline") => failed{"report-emit-call"}
        seed_credential_guard_note: context("life/s3-setup-report", "seed-credential-guard-note-drift", "", "offline") => failed{"credential-guard-note"}
        seed_credential_first_name: context("life/s3-setup-report", "seed-credential-first-name-drift", "", "offline") => failed{"credential-first-name"}
        seed_credential_second_name: context("life/s3-setup-report", "seed-credential-second-name-drift", "", "offline") => failed{"credential-second-name"}
        seed_report_field_count: context("life/s3-setup-report", "seed-report-field-count-drift", "", "offline") => failed{"report-field-count"}
        seed_s3_call_count: context("life/s3-setup-report", "seed-s3-call-count-drift", "", "offline") => failed{"s3-call-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.report_host_key, "host", c, "report-host-key")
            failed
            ok evidence report_host_key_evidence => match call require_text(got.report_bucket_key, "bucket", c, "report-bucket-key")
                failed
                ok evidence report_bucket_key_evidence => match call require_text(got.report_size_key, "size", c, "report-size-key")
                    failed
                    ok evidence report_size_key_evidence => match call require_text(got.report_host_shape, "new URL(endpoint!).host", c, "report-host-shape")
                        failed
                        ok evidence report_host_shape_evidence => match call require_text(got.report_size_shape, "stat.size", c, "report-size-shape")
                            failed
                            ok evidence report_size_shape_evidence => match call require_text(got.report_encode_call, "JSON.stringify", c, "report-encode-call")
                                failed
                                ok evidence report_encode_call_evidence => match call require_text(got.report_emit_call, "console.log", c, "report-emit-call")
                                    failed
                                    ok evidence report_emit_call_evidence => match call require_text(got.credential_guard_note, "Credentials never enter the report", c, "credential-guard-note")
                                        failed
                                        ok evidence credential_guard_note_evidence => match call require_text(got.credential_first_name, "accessKeyId", c, "credential-first-name")
                                            failed
                                            ok evidence credential_first_name_evidence => match call require_text(got.credential_second_name, "secretAccessKey", c, "credential-second-name")
                                                failed
                                                ok evidence credential_second_name_evidence => match call require_int(got.report_field_count, 4, c, "report-field-count")
                                                    failed
                                                    ok evidence report_field_count_evidence => match call require_int(got.s3_call_count, 3, c, "s3-call-count")
                                                        failed
                                                        ok evidence s3_call_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        m42_l026: "m42-l026" => ok test_case("life/s3-setup-report", ["life", "m42"], [], 120000, [check_ref("report-host-key"), check_ref("report-bucket-key"), check_ref("report-size-key"), check_ref("report-host-shape"), check_ref("report-size-shape"), check_ref("report-encode-call"), check_ref("report-emit-call"), check_ref("credential-guard-note"), check_ref("credential-first-name"), check_ref("credential-second-name"), check_ref("report-field-count"), check_ref("s3-call-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m42-l026"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("life/s3-setup-report", ["life", "m42"], [], 120000, [check_ref("report-host-key"), check_ref("report-bucket-key"), check_ref("report-size-key"), check_ref("report-host-shape"), check_ref("report-size-shape"), check_ref("report-encode-call"), check_ref("report-emit-call"), check_ref("credential-guard-note"), check_ref("credential-first-name"), check_ref("credential-second-name"), check_ref("report-field-count"), check_ref("s3-call-count")], callable case_body)
