        true => ok [check("report-host-key", "report keeps its host key"), check("report-bucket-key", "report keeps its bucket key"), check("report-size-key", "report keeps its size key"), check("report-host-shape", "report keeps its host shape"), check("report-size-shape", "report keeps its size shape"), check("report-encode-call", "report keeps its encode call"), check("report-emit-call", "report keeps its emit call"), check("credential-guard-note", "report keeps its guard note"), check("credential-first-name", "guard names its first alias"), check("credential-second-name", "guard names its second alias"), check("report-field-count", "report holds four fields"), check("s3-call-count", "driver makes three s3 calls")]
