    emits {}
    given
        str scope
    asserts
        m42_l026: "m42-l026" => ok [check("driver-file-name", "driver keeps its file name"), check("usage-note", "driver keeps its usage note"), check("missing-note", "driver keeps its missing note"), check("client-name", "driver keeps its client name"), check("client-source", "driver keeps its client home"), check("endpoint-env-name", "driver keeps its endpoint name"), check("region-env-name", "driver keeps its region name"), check("bucket-env-name", "driver keeps its bucket name"), check("access-env-name", "driver keeps its access name"), check("secret-env-name", "driver keeps its hidden name"), check("argv-word", "driver keeps its argv word"), check("command-arg-name", "driver keeps its command name"), check("payload-arg-name", "driver keeps its payload name"), check("prefix-arg-name", "driver keeps its prefix name"), check("argv-index", "argv starts at index two"), check("usage-exit-code", "misuse exits with two"), check("env-name-count", "driver wants five env names"), check("driver-arg-count", "driver takes three args")]
        other: "nope" => ok []
    match scope is "m42-l026"
        false => ok []
        true => ok [check("driver-file-name", "driver keeps its file name"), check("usage-note", "driver keeps its usage note"), check("missing-note", "driver keeps its missing note"), check("client-name", "driver keeps its client name"), check("client-source", "driver keeps its client home"), check("endpoint-env-name", "driver keeps its endpoint name"), check("region-env-name", "driver keeps its region name"), check("bucket-env-name", "driver keeps its bucket name"), check("access-env-name", "driver keeps its access name"), check("secret-env-name", "driver keeps its hidden name"), check("argv-word", "driver keeps its argv word"), check("command-arg-name", "driver keeps its command name"), check("payload-arg-name", "driver keeps its payload name"), check("prefix-arg-name", "driver keeps its prefix name"), check("argv-index", "argv starts at index two"), check("usage-exit-code", "misuse exits with two"), check("env-name-count", "driver wants five env names"), check("driver-arg-count", "driver takes three args")]
fn expected_check[] expected_vector
    emits {}
    given
