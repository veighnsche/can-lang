package m42life026run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M42 LIFE-026 s3 driver run
/// shape.
/// Source: tests/integration/
/// testdata/s3/s3-driver.ts run
/// frame (L4-22): client build, env
/// guard, argv split, usage plus
/// missing refusals, plus exit code.
/// Disposition: replace_support (this
/// row owns setup as reviewable Can
/// facts; s3-driver.ts plus
/// payload.bin stay until every s3
/// scenario uses Can setup).
/// Protects (this file): driver run
/// shape holding the two facets:
/// file name, usage note, missing
/// note, client name plus home, five
/// env names, argv word, arg names,
/// plus index and tally pins.
/// ADAPTATION (recorded, with source
/// lines): driver-file-name pins the
/// file name (L3); usage-note pins
/// the usage line (L13);
/// missing-note pins the missing
/// head (L18); client-name pins
/// S3Client (L22); client-source
/// pins bun (L4); endpoint-env-name
/// pins the endpoint name (L6);
/// region-env-name pins the region
/// name (L7); bucket-env-name pins
/// the bucket name (L8);
/// access-env-name pins the access
/// name (L9); secret-env-name pins
/// the hidden name (L10);
/// argv-word pins process.argv (L11);
/// command-arg-name pins command
/// (L11); payload-arg-name pins
/// payloadPath (L11);
/// prefix-arg-name pins prefix
/// (L11); argv-index pins int (2)
/// from L11; usage-exit-code pins
/// int (2) from L14; env-name-count
/// pins int (5) from L16;
/// driver-arg-count pins int (3)
/// from L11.
/// Facet map (leg order):
/// driver-file-name, usage-note,
/// missing-note, client-name,
/// client-source, endpoint-env-name,
/// region-env-name, bucket-env-name,
/// access-env-name, secret-env-name,
/// argv-word, command-arg-name,
/// payload-arg-name, prefix-arg-name,
/// argv-index, usage-exit-code,
/// env-name-count, driver-arg-count.
/// The seed legs live in
/// life-026-base-semantics.can; the
/// report legs live in
/// life-026-roots-green.can.
/// Variants: none.
/// Environment: none (no live run
/// now; binds at P23 plus QStore).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QStore accept gates unmet).
/// Case life/s3-driver-shape
/// checks: driver-file-name,
/// usage-note, missing-note,
/// client-name, client-source,
/// endpoint-env-name,
/// region-env-name, bucket-env-name,
/// access-env-name, secret-env-name,
/// argv-word, command-arg-name,
/// payload-arg-name, prefix-arg-name,
/// argv-index, usage-exit-code,
/// env-name-count, driver-arg-count.
/// Shared old files untouched;
/// retirement is a later integrator
/// decision.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str driver_file_name
    str usage_note
    str missing_note
    str client_name
    str client_source
    str endpoint_env_name
    str region_env_name
    str bucket_env_name
    str access_env_name
    str secret_env_name
    str argv_word
    str command_arg_name
    str payload_arg_name
    str prefix_arg_name
    int argv_index
    int usage_exit_code
    int env_name_count
    int driver_arg_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("life/s3-driver-shape", "default", "", "offline"), "driver-file-name" => ok "case life/s3-driver-shape variant default root driver-file-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("life/s3-driver-shape", "default", "", "offline"), "driver-file-name" => ok evidence("driver-file-name", "true", "true", true, "case life/s3-driver-shape variant default root driver-file-name run offline")
        different: false, true, context("life/s3-driver-shape", "default", "", "offline"), "driver-file-name" => failed{"driver-file-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("life/s3-driver-shape", "default", "", "offline"), "argv-index" => ok evidence("argv-index", "2", "2", true, "case life/s3-driver-shape variant default root argv-index run offline")
        different: 1, 2, context("life/s3-driver-shape", "default", "", "offline"), "argv-index" => failed{"argv-index"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "s3-driver.ts", "s3-driver.ts", context("life/s3-driver-shape", "default", "", "offline"), "driver-file-name" => ok evidence("driver-file-name", "s3-driver.ts", "s3-driver.ts", true, "case life/s3-driver-shape variant default root driver-file-name run offline")
        different: "s3-driver.ts_2", "s3-driver.ts", context("life/s3-driver-shape", "default", "", "offline"), "driver-file-name" => failed{"driver-file-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
