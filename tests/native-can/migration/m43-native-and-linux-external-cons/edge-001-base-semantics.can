    asserts
        default: "default" => ok observation("machine_arch", "x86_64", "aarch64", "amd64", "arm64", "/etc/os-release", "getconf", "GNU_LIBC_VERSION", "minimumOSVersion", "VERSION_ID", "architecture", "linux", "darwin", "debian", "upstream", "size", "sha256", "member", "executable", "upstream archive size or SHA-256 mismatch", "extracted runtime SHA-256 mismatch", "glibc", 2, 3, 2, 2)
        seed_arch_fn: "seed-arch-fn-drift" => ok observation("machine_arch_2", "x86_64", "aarch64", "amd64", "arm64", "/etc/os-release", "getconf", "GNU_LIBC_VERSION", "minimumOSVersion", "VERSION_ID", "architecture", "linux", "darwin", "debian", "upstream", "size", "sha256", "member", "executable", "upstream archive size or SHA-256 mismatch", "extracted runtime SHA-256 mismatch", "glibc", 2, 3, 2, 2)
