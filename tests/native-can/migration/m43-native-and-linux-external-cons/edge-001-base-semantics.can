package m43edge001base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-001 "main native qualification"
/// rewire target pact.
/// Source: distribution/qualify.py symbol
/// "main native qualification" (L18-35 plus
/// L89-118): pinned target plus archive plus
/// digest gates.
/// Disposition: rewire target only (this row
/// owns the caller pact as reviewable Can
/// facts; no caller file changes here; old
/// python call stays until the integrator
/// rewires it after each linked row plus gate
/// has accepted proof).
/// Protects (this file): facet 1, target OS
/// plus arch plus minimum version plus glibc,
/// archive size plus hash plus pulled runtime
/// digest.
/// ADAPTATION (noted, plus source lines):
/// name pins hold OS plus arch spellings; key
/// pins hold dict spellings; verdict pins
/// hold refusal bytes; count pins hold ints
/// tallied from L19 plus L91 plus L98 plus
/// L113 plus L117.
/// machine-name-a pins the first L19 machine
/// name; machine-name-b pins the second L19
/// machine name.
/// arch-fn pins machine_arch (L18 plus L92);
/// machine-name-a pins x86_64 (L19);
/// machine-name-b pins aarch64 (L19);
/// amd-name pins amd64 (L19 plus L93);
/// arm-name pins arm64 (L19 plus L105);
/// os-release pins /etc/os-release (L24);
/// getconf-bin pins getconf (L32); libc-query
/// pins GNU_LIBC_VERSION (L32); min-os-key
/// pins minimumOSVersion (L98 plus L107);
/// version-id-key pins VERSION_ID (L97);
/// arch-key pins architecture (L92 plus
/// L104); linux-name pins linux (L91);
/// darwin-name pins darwin (L101 plus L138);
/// debian-id pins debian (L95); upstream-key
/// pins upstream (L2 plus L113 plus L114 plus
/// L116); size-key pins size (L113 plus
/// L114); sha-key pins sha256 (L15 plus L113
/// plus L117); member-key pins member (L116);
/// exec-key pins executable (L116 plus L117
/// plus L122 plus L124); size-mismatch pins
/// upstream archive size or SHA-256 mismatch
/// (L114); exec-mismatch pins extracted
/// runtime SHA-256 mismatch (L118); glibc-fn
/// pins glibc (L31 plus L100 plus L163);
/// arch-map-count pins 2 (L19);
/// platform-branch-count pins 3 (L91 plus
/// L101 plus L111); version-gate-count pins 2
/// (L98 plus L107); digest-gate-count pins 2
/// (L114 plus L118).
/// Facet map (pin order): arch-fn,
/// machine-name-a, machine-name-b, amd-name,
/// arm-name, os-release, getconf-bin,
/// libc-query, min-os-key, version-id-key,
/// arch-key, linux-name, darwin-name,
/// debian-id, upstream-key, size-key,
/// sha-key, member-key, exec-key,
/// size-mismatch, exec-mismatch, glibc-fn,
/// arch-map-count, platform-branch-count,
/// version-gate-count, digest-gate-count.
/// The no-ambient plus isolation roots live
/// in edge-001-roots-green.can; the combined
/// report shape plus verdict live in
/// edge-001-run-shape.can.
/// Variants: none (row lists zero variants).
/// Environment: zero gates; bind at P23 plus
/// QN1; no live run now.
/// Logical gates SUITE plus PROC plus WORK
/// plus ENV plus ARCHIVE plus NATIVE plus
/// FILES bind at P23 plus QN1; no live run
/// now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M31 no-run
/// rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 plus
/// QN1 accept gates unmet).
/// Intended consumed report: M35 HISTORY-127
/// through HISTORY-131 parsed slices (no
/// qualified report yet; P23 plus QN1 unmet).
/// Rewire stays blocked; qualify.py plus
/// smoke.sh plus verifier.yml intact; no call
/// retired.
/// Shared old files intact; retirement is a
/// later integrator choice; Z03 owns
/// activation.
/// Case edge/native-platform-archive checks:
/// arch-fn, machine-name-a, machine-name-b,
/// amd-name, arm-name, os-release,
/// getconf-bin, libc-query, min-os-key,
/// version-id-key, arch-key, linux-name,
/// darwin-name, debian-id, upstream-key,
/// size-key, sha-key, member-key, exec-key,
/// size-mismatch, exec-mismatch, glibc-fn,
/// arch-map-count, platform-branch-count,
/// version-gate-count, digest-gate-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str arch_fn
    str machine_name_a
    str machine_name_b
    str amd_name
    str arm_name
    str os_release
    str getconf_bin
    str libc_query
    str min_os_key
    str version_id_key
    str arch_key
    str linux_name
    str darwin_name
    str debian_id
    str upstream_key
    str size_key
    str sha_key
    str member_key
    str exec_key
    str size_mismatch
    str exec_mismatch
    str glibc_fn
    int arch_map_count
    int platform_branch_count
    int version_gate_count
    int digest_gate_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/native-platform-archive", "default", "", "offline"), "arch-fn" => ok "case edge/native-platform-archive variant default root arch-fn run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/native-platform-archive", "default", "", "offline"), "arch-fn" => ok evidence("arch-fn", "true", "true", true, "case edge/native-platform-archive variant default root arch-fn run offline")
        different: false, true, context("edge/native-platform-archive", "default", "", "offline"), "arch-fn" => failed{"arch-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/native-platform-archive", "default", "", "offline"), "arch-map-count" => ok evidence("arch-map-count", "2", "2", true, "case edge/native-platform-archive variant default root arch-map-count run offline")
        different: 1, 2, context("edge/native-platform-archive", "default", "", "offline"), "arch-map-count" => failed{"arch-map-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "machine_arch", "machine_arch", context("edge/native-platform-archive", "default", "", "offline"), "arch-fn" => ok evidence("arch-fn", "machine_arch", "machine_arch", true, "case edge/native-platform-archive variant default root arch-fn run offline")
        different: "machine_arch_2", "machine_arch", context("edge/native-platform-archive", "default", "", "offline"), "arch-fn" => failed{"arch-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
