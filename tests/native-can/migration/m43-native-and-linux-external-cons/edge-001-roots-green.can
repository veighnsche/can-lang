package m43edge001roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-001 "main native qualification"
/// rewire target pact.
/// Source: distribution/qualify.py symbol
/// "main native qualification" (L38-64 plus
/// L136-150): pinned deny env plus checked
/// isolation arms.
/// Disposition: rewire target only (this row
/// owns the caller pact as reviewable Can
/// facts; no caller file changes here; old
/// python call stays until the integrator
/// rewires it after each linked row plus gate
/// has accepted proof).
/// Protects (this file): facet 2, no ambient
/// config plus install plus PATH runtime;
/// offline isolation checked, never assumed.
/// ADAPTATION (noted, plus source lines): env
/// pins hold deny bytes; arm pins hold the
/// four isolation spellings; probe pins hold
/// check spellings; count pins hold ints
/// tallied from L60 plus L137 plus L138 plus
/// L143.
/// unshare-ns pins the two-word namespace
/// form; unshare-word pins all eight helper
/// plus probe plus arm spellings.
/// no-ambient-note pins No ambient Bun config
/// (L136); home-key pins HOME (L137);
/// path-key pins PATH (L136 plus L137 plus
/// L159); path-deny pins /nonexistent (L137);
/// tmp-key pins TMPDIR (L137); unshare-word
/// pins unshare (L38 plus L40 plus L49 plus
/// L75 plus L141 plus L142 plus L143 plus
/// L150); unshare-ns pins unshare -n (L142
/// plus L150); sandbox-deny pins denied by
/// macOS sandbox (L139); sandbox-exec pins
/// /usr/bin/sandbox-exec (L140);
/// sandbox-profile pins (version 1)(allow
/// default)(deny network*) (L140); ns-deny
/// pins denied by Linux network namespace
/// (unshare -n) (L142); caller-iso pins
/// caller-provided: (L147); net-class pins
/// /sys/class/net (L50); uplink-fn pins
/// no_uplink_interfaces (L46 plus L145);
/// isolation-flag pins network-isolation (L73
/// plus L103 plus L150); iface-up pins
/// non-loopback interface is up (L146);
/// isolation-branch-count pins 4 (L138
/// through L150); env-key-count pins 3
/// (L137); down-state-count pins 2 (L60);
/// unshare-prefix-count pins 3 (L143).
/// Facet map (pin order): no-ambient-note,
/// home-key, path-key, path-deny, tmp-key,
/// unshare-word, unshare-ns, sandbox-deny,
/// sandbox-exec, sandbox-profile, ns-deny,
/// caller-iso, net-class, uplink-fn,
/// isolation-flag, iface-up,
/// isolation-branch-count, env-key-count,
/// down-state-count, unshare-prefix-count.
/// The platform plus archive plus digest
/// gates live in edge-001-base-semantics.can;
/// the combined report shape plus verdict
/// live in edge-001-run-shape.can.
/// Variants: none (row lists zero variants).
/// Environment: zero gates; bind at P23 plus
/// QN1; no live run now.
/// Logical gates SUITE plus PROC plus WORK
/// plus ENV plus ARCHIVE plus NATIVE plus
/// FILES bind at P23 plus QN1; no live run
/// now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M31 no-run
/// rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 plus
/// QN1 accept gates unmet).
/// Intended consumed report: M35 HISTORY-127
/// through HISTORY-131 parsed slices (no
/// qualified report yet; P23 plus QN1 unmet).
/// Rewire stays blocked; qualify.py plus
/// smoke.sh plus verifier.yml intact; no call
/// retired.
/// Shared old files intact; retirement is a
/// later integrator choice; Z03 owns
/// activation.
/// Case edge/native-no-ambient-isolation
/// checks: no-ambient-note, home-key,
/// path-key, path-deny, tmp-key,
/// unshare-word, unshare-ns, sandbox-deny,
/// sandbox-exec, sandbox-profile, ns-deny,
/// caller-iso, net-class, uplink-fn,
/// isolation-flag, iface-up,
/// isolation-branch-count, env-key-count,
/// down-state-count, unshare-prefix-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str no_ambient_note
    str home_key
    str path_key
    str path_deny
    str tmp_key
    str unshare_word
    str unshare_ns
    str sandbox_deny
    str sandbox_exec
    str sandbox_profile
    str ns_deny
    str caller_iso
    str net_class
    str uplink_fn
    str isolation_flag
    str iface_up
    int isolation_branch_count
    int env_key_count
    int down_state_count
    int unshare_prefix_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/native-no-ambient-isolation", "default", "", "offline"), "no-ambient-note" => ok "case edge/native-no-ambient-isolation variant default root no-ambient-note run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/native-no-ambient-isolation", "default", "", "offline"), "no-ambient-note" => ok evidence("no-ambient-note", "true", "true", true, "case edge/native-no-ambient-isolation variant default root no-ambient-note run offline")
        different: false, true, context("edge/native-no-ambient-isolation", "default", "", "offline"), "no-ambient-note" => failed{"no-ambient-note"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("edge/native-no-ambient-isolation", "default", "", "offline"), "isolation-branch-count" => ok evidence("isolation-branch-count", "4", "4", true, "case edge/native-no-ambient-isolation variant default root isolation-branch-count run offline")
        different: 3, 4, context("edge/native-no-ambient-isolation", "default", "", "offline"), "isolation-branch-count" => failed{"isolation-branch-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "No ambient Bun config", "No ambient Bun config", context("edge/native-no-ambient-isolation", "default", "", "offline"), "no-ambient-note" => ok evidence("no-ambient-note", "No ambient Bun config", "No ambient Bun config", true, "case edge/native-no-ambient-isolation variant default root no-ambient-note run offline")
        different: "No ambient Bun config_2", "No ambient Bun config", context("edge/native-no-ambient-isolation", "default", "", "offline"), "no-ambient-note" => failed{"no-ambient-note"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
