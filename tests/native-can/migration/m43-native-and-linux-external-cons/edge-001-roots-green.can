    asserts
        default: "default" => ok observation("No ambient Bun config", "HOME", "PATH", "/nonexistent", "TMPDIR", "unshare", "unshare -n", "denied by macOS sandbox", "/usr/bin/sandbox-exec", "(version 1)(allow default)(deny network*)", "denied by Linux network namespace (unshare -n)", "caller-provided: ", "/sys/class/net", "no_uplink_interfaces", "network-isolation", "non-loopback interface is up", 4, 3, 2, 3)
