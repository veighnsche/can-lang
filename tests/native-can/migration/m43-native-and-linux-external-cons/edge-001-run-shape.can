package m43edge001run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-001 "main native qualification"
/// rewire target pact.
/// Source: distribution/qualify.py symbol
/// "main native qualification" (L85-87 plus
/// L151-172): pinned staged runs plus
/// provenance-bound report.
/// Disposition: rewire target only (this row
/// owns the caller pact as reviewable Can
/// facts; no caller file changes here; old
/// python call stays until the integrator
/// rewires it after each linked row plus gate
/// has accepted proof).
/// Protects (this file): facet 3, native API
/// plus behavior plus deliberate refusal
/// results joined into a provenance-bound
/// report.
/// ADAPTATION (noted, plus source lines): key
/// pins hold report dict spellings; run pins
/// hold staged command bytes; verdict pins
/// hold outcome bytes; count pins hold ints
/// tallied from L85 plus L151 plus L159.
/// suite-member-a pins the behavior probe;
/// suite-member-b pins the refusal probe;
/// both join under execution keys.
/// schema-key pins schemaVersion (L85);
/// report-kind pins
/// can.native-capability-report (L85);
/// target-id-key pins targetId (L86 plus
/// L121); manifest-key pins manifestSHA256
/// (L86); passed-key pins passed (L87 plus
/// L165 plus L168 plus L171 plus L172);
/// failures-key pins failures (L87 plus L166
/// plus L169); execution-key pins execution
/// (L159 plus L163); archive-key pins
/// archiveSHA256 (L161); neg-pass-key pins
/// negativeTestsPassed (L161); suite-member-a
/// pins native.ts (L130 plus L152);
/// suite-member-b pins native.test.ts (L130
/// plus L151); suite-dir pins
/// tests/conformance (L128 plus L131);
/// test-word pins test (L128 plus L130 plus
/// L131 plus L151 plus L153 plus L154 plus
/// L161 plus L164 plus L166); returncode-key
/// pins returncode (L33 plus L41 plus L161
/// plus L164); capture-key pins
/// capture_output (L32 plus L40 plus L153
/// plus L155); staged-fail pins staged
/// qualification or rejection tests failed
/// (L166); native-verdict pins Native
/// qualification (L171); no-report pins
/// staged runtime produced no report: (L157);
/// command-count pins 2 (L151 plus L152);
/// execution-key-count pins 6 (L159 through
/// L161); timeout-secs pins 120 (L153 plus
/// L155); schema-version pins 1 (L85);
/// report-key-count pins 6 (L85 through L87).
/// Facet map (pin order): schema-key,
/// report-kind, target-id-key, manifest-key,
/// passed-key, failures-key, execution-key,
/// archive-key, neg-pass-key, suite-member-a,
/// suite-member-b, suite-dir, test-word,
/// returncode-key, capture-key, staged-fail,
/// native-verdict, no-report, command-count,
/// execution-key-count, timeout-secs,
/// schema-version, report-key-count.
/// The platform plus archive plus digest
/// gates live in edge-001-base-semantics.can;
/// the no-ambient plus isolation roots live
/// in edge-001-roots-green.can.
/// Variants: none (row lists zero variants).
/// Environment: zero gates; bind at P23 plus
/// QN1; no live run now.
/// Logical gates SUITE plus PROC plus WORK
/// plus ENV plus ARCHIVE plus NATIVE plus
/// FILES bind at P23 plus QN1; no live run
/// now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M31 no-run
/// rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 plus
/// QN1 accept gates unmet).
/// Intended consumed report: M35 HISTORY-127
/// through HISTORY-131 parsed slices (no
/// qualified report yet; P23 plus QN1 unmet).
/// Rewire stays blocked; qualify.py plus
/// smoke.sh plus verifier.yml intact; no call
/// retired.
/// Shared old files intact; retirement is a
/// later integrator choice; Z03 owns
/// activation.
/// Case edge/native-provenance-report checks:
/// schema-key, report-kind, target-id-key,
/// manifest-key, passed-key, failures-key,
/// execution-key, archive-key, neg-pass-key,
/// suite-member-a, suite-member-b, suite-dir,
/// test-word, returncode-key, capture-key,
/// staged-fail, native-verdict, no-report,
/// command-count, execution-key-count,
/// timeout-secs, schema-version,
/// report-key-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str schema_key
    str report_kind
    str target_id_key
    str manifest_key
    str passed_key
    str failures_key
    str execution_key
    str archive_key
    str neg_pass_key
    str suite_member_a
    str suite_member_b
    str suite_dir
    str test_word
    str returncode_key
    str capture_key
    str staged_fail
    str native_verdict
    str no_report
    int command_count
    int execution_key_count
    int timeout_secs
    int schema_version
    int report_key_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/native-provenance-report", "default", "", "offline"), "schema-key" => ok "case edge/native-provenance-report variant default root schema-key run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/native-provenance-report", "default", "", "offline"), "schema-key" => ok evidence("schema-key", "true", "true", true, "case edge/native-provenance-report variant default root schema-key run offline")
        different: false, true, context("edge/native-provenance-report", "default", "", "offline"), "schema-key" => failed{"schema-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/native-provenance-report", "default", "", "offline"), "command-count" => ok evidence("command-count", "2", "2", true, "case edge/native-provenance-report variant default root command-count run offline")
        different: 1, 2, context("edge/native-provenance-report", "default", "", "offline"), "command-count" => failed{"command-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "schemaVersion", "schemaVersion", context("edge/native-provenance-report", "default", "", "offline"), "schema-key" => ok evidence("schema-key", "schemaVersion", "schemaVersion", true, "case edge/native-provenance-report variant default root schema-key run offline")
        different: "schemaVersion_2", "schemaVersion", context("edge/native-provenance-report", "default", "", "offline"), "schema-key" => failed{"schema-key"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
