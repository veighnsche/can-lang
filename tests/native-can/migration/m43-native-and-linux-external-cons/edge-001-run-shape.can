        seed_schema_key: "seed-schema-key-drift" => ok observation("schemaVersion_2", "can.native-capability-report", "targetId", "manifestSHA256", "passed", "failures", "execution", "archiveSHA256", "negativeTestsPassed", "native.ts", "native.test.ts", "tests/conformance", "test", "returncode", "capture_output", "staged qualification or rejection tests failed", "Native qualification ", "staged runtime produced no report: ", 2, 6, 120, 1, 6)
