package m43edge002base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-002 "installed artifact smoke"
/// install pact.
/// Source: distribution/linux/smoke.sh
/// symbol "installed artifact smoke"
/// (L12-43): pinned install command and
/// runtime identity gates.
/// Disposition: rewire (this row owns the
/// caller pact as reviewable Can
/// facts; smoke.sh stays until the
/// integrator rewires it after each linked
/// row and gate has accepted proof).
/// Protects (this file): the install
/// command and flags and layout and the
/// runtime kind and keys and pinned values
/// and tallies that bound setup.
/// ADAPTATION (with source lines):
/// flag pins hold CLI spellings; path pins
/// hold layout bytes; key pins hold report
/// spellings; count pins hold ints tallied
/// from L12-43.
/// distbuild-call pins
/// go run ./tools/distbuild (L27);
/// install-verb pins distbuild install
/// (L27); archive-flag pins --archive
/// (L27 and L47); sha-flag pins --sha
/// (L27); root-flag pins --root (L27);
/// canlc-path pins current/bin/canlc
/// (L28); install-root pins install-root
/// (L19); sha-suffix pins .sha256 (L24);
/// bun-archive pins
/// bun-1.4.2-linux-amd64-v1.zip (L23);
/// exec-gate pins test -x (L29);
/// runtime-kind pins
/// can.development-runtime-check (L37);
/// runtime-report pins runtime-check.json
/// (L33 and L34); runtime-verb pins
/// runtime-check (L32, L33, L34, L37 and
/// L42 with two on L33); pinned-bun pins
/// 1.4.2 (L23, L38 and L55);
/// pinned-revision pins
/// 744846f844374847c902b5e7fd59b4342a51ef99
/// (L39); kind-key pins "kind" (L37);
/// bun-key pins "bun" (L38 and L42);
/// revision-key pins "revision" (L39);
/// platform-key pins "platform" (L40 and
/// L42); arch-key pins "architecture"
/// (L41 and L42); platform-value pins
/// "linux" (L40); arch-value pins "x64"
/// (L41); install-flag-count pins
/// int (3) from L27; runtime-assert-count
/// pins int (5) from L37-41;
/// env-default-count pins int (5) from
/// L12-16.
/// Facet map (install then identity order):
/// distbuild-call, install-verb,
/// archive-flag, sha-flag, root-flag,
/// canlc-path, install-root, sha-suffix,
/// bun-archive, exec-gate, runtime-kind,
/// runtime-report, runtime-verb,
/// pinned-bun, pinned-revision, kind-key,
/// bun-key, revision-key, platform-key,
/// arch-key, platform-value, arch-value,
/// install-flag-count,
/// runtime-assert-count, env-default-count.
/// The qualify gates live in
/// edge-002-roots-green.can; the example
/// runs and build verdict live in
/// edge-002-run-shape.can.
/// Variants: row lists zero variants; this
/// file pins the one install and identity
/// span.
/// Environment: row lists zero gates;
/// offline only; no live run now.
/// Logical gates SUITE, ARCHIVE, DB and N1
/// bind at P23 and QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (no timeout in this row; binds at
/// P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 and
/// QD1 accept gates unmet).
/// Intended consumed report: M41 LIFE-012
/// and LIFE-013 parsed slices (no
/// qualified report yet; P23 and QD1
/// unmet).
/// Rewire stays blocked; smoke.sh
/// intact; no call retired.
/// Case edge/smoke-install-identity
/// checks: distbuild-call, install-verb,
/// archive-flag, sha-flag, root-flag,
/// canlc-path, install-root, sha-suffix,
/// bun-archive, exec-gate, runtime-kind,
/// runtime-report, runtime-verb,
/// pinned-bun, pinned-revision, kind-key,
/// bun-key, revision-key, platform-key,
/// arch-key, platform-value, arch-value,
/// install-flag-count,
/// runtime-assert-count, env-default-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str distbuild_call
    str install_verb
    str archive_flag
    str sha_flag
    str root_flag
    str canlc_path
    str install_root
    str sha_suffix
    str bun_archive
    str exec_gate
    str runtime_kind
    str runtime_report
    str runtime_verb
    str pinned_bun
    str pinned_revision
    str kind_key
    str bun_key
    str revision_key
    str platform_key
    str arch_key
    str platform_value
    str arch_value
    int install_flag_count
    int runtime_assert_count
    int env_default_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/smoke-install-identity", "default", "", "offline"), "distbuild-call" => ok "case edge/smoke-install-identity variant default root distbuild-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/smoke-install-identity", "default", "", "offline"), "distbuild-call" => ok evidence("distbuild-call", "true", "true", true, "case edge/smoke-install-identity variant default root distbuild-call run offline")
        different: false, true, context("edge/smoke-install-identity", "default", "", "offline"), "distbuild-call" => failed{"distbuild-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("edge/smoke-install-identity", "default", "", "offline"), "install-flag-count" => ok evidence("install-flag-count", "3", "3", true, "case edge/smoke-install-identity variant default root install-flag-count run offline")
        different: 2, 3, context("edge/smoke-install-identity", "default", "", "offline"), "install-flag-count" => failed{"install-flag-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "go run ./tools/distbuild", "go run ./tools/distbuild", context("edge/smoke-install-identity", "default", "", "offline"), "distbuild-call" => ok evidence("distbuild-call", "go run ./tools/distbuild", "go run ./tools/distbuild", true, "case edge/smoke-install-identity variant default root distbuild-call run offline")
        different: "go run ./tools/distbuild_2", "go run ./tools/distbuild", context("edge/smoke-install-identity", "default", "", "offline"), "distbuild-call" => failed{"distbuild-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("go run ./tools/distbuild", "distbuild install", "--archive", "--sha", "--root", "current/bin/canlc", "install-root", ".sha256", "bun-1.4.2-linux-amd64-v1.zip", "test -x", "can.development-runtime-check", "runtime-check.json", "runtime-check", "1.4.2", "744846f844374847c902b5e7fd59b4342a51ef99", "\"kind\"", "\"bun\"", "\"revision\"", "\"platform\"", "\"architecture\"", "\"linux\"", "\"x64\"", 3, 5, 5)
        seed_distbuild_call: "seed-distbuild-call-drift" => ok observation("go run ./tools/distbuild_2", "distbuild install", "--archive", "--sha", "--root", "current/bin/canlc", "install-root", ".sha256", "bun-1.4.2-linux-amd64-v1.zip", "test -x", "can.development-runtime-check", "runtime-check.json", "runtime-check", "1.4.2", "744846f844374847c902b5e7fd59b4342a51ef99", "\"kind\"", "\"bun\"", "\"revision\"", "\"platform\"", "\"architecture\"", "\"linux\"", "\"x64\"", 3, 5, 5)
