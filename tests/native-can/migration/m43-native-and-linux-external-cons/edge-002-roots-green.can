package m43edge002roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-002 "installed artifact smoke"
/// qualify pact.
/// Source: distribution/linux/smoke.sh
/// symbol "installed artifact smoke"
/// (L45-61): pinned native qualify call
/// and report gates.
/// Disposition: rewire (same row pact as
/// the install slice; this file owns the
/// qualify call and report spellings).
/// Protects (this file): the qualify flags
/// and target bytes and isolation value
/// and report keys and verdict value and
/// tallies.
/// ADAPTATION (with source lines):
/// flag pins hold CLI spellings; path pins
/// hold layout bytes; key pins hold report
/// spellings; count pins hold ints tallied
/// from L46-59.
/// qualify-call pins distribution/qualify.py
/// (L46); report-flag pins --report
/// (L48); target-flag pins --target-file
/// (L49); isolation-flag pins
/// --network-isolation (L50); target-default
/// pins distribution/target-linux-amd64.json
/// (L49); isolation-value pins
/// docker run --network none (L50);
/// native-report pins
/// native-capabilities-linux.json (L48 and
/// L51); target-key pins "targetId" (L55);
/// target-value pins
/// "bun-1.4.2-linux-amd64-v1" (L55);
/// capabilities-key pins "capabilities"
/// (L56); behaviors-key pins "behaviors"
/// (L57); execution-key pins "execution"
/// (L58 and L59); negative-key pins
/// negativeTestsPassed (L58); glibc-key
/// pins "glibc" (L59); failures-key pins
/// "failures" (L54); passed-key pins
/// "passed" (L54 and L75);
/// qualify-flag-count pins int (4) from
/// L46-50; qualify-assert-count pins
/// int (6) from L54-59.
/// Facet map (call then report order):
/// qualify-call, report-flag, target-flag,
/// isolation-flag, target-default,
/// isolation-value, native-report,
/// target-key, target-value,
/// capabilities-key, behaviors-key,
/// execution-key, negative-key, glibc-key,
/// failures-key, passed-key,
/// qualify-flag-count, qualify-assert-count.
/// The install and identity span lives in
/// edge-002-base-semantics.can; the example
/// runs and build verdict live in
/// edge-002-run-shape.can.
/// Variants: row lists zero variants; this
/// file pins the one qualify span.
/// Environment: row lists zero gates;
/// offline only; no live run now.
/// Logical gates SUITE, ARCHIVE, DB and N1
/// bind at P23 and QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (no timeout in this row; binds at
/// P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 and
/// QD1 accept gates unmet).
/// Intended consumed report: M41 LIFE-012
/// and LIFE-013 parsed slices (no
/// qualified report yet; P23 and QD1
/// unmet).
/// Rewire stays blocked; smoke.sh
/// intact; no call retired.
/// Case edge/smoke-native-qualify
/// checks: qualify-call, report-flag,
/// target-flag, isolation-flag,
/// target-default, isolation-value,
/// native-report, target-key, target-value,
/// capabilities-key, behaviors-key,
/// execution-key, negative-key, glibc-key,
/// failures-key, passed-key,
/// qualify-flag-count, qualify-assert-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str qualify_call
    str report_flag
    str target_flag
    str isolation_flag
    str target_default
    str isolation_value
    str native_report
    str target_key
    str target_value
    str capabilities_key
    str behaviors_key
    str execution_key
    str negative_key
    str glibc_key
    str failures_key
    str passed_key
    int qualify_flag_count
    int qualify_assert_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/smoke-native-qualify", "default", "", "offline"), "qualify-call" => ok "case edge/smoke-native-qualify variant default root qualify-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/smoke-native-qualify", "default", "", "offline"), "qualify-call" => ok evidence("qualify-call", "true", "true", true, "case edge/smoke-native-qualify variant default root qualify-call run offline")
        different: false, true, context("edge/smoke-native-qualify", "default", "", "offline"), "qualify-call" => failed{"qualify-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("edge/smoke-native-qualify", "default", "", "offline"), "qualify-flag-count" => ok evidence("qualify-flag-count", "4", "4", true, "case edge/smoke-native-qualify variant default root qualify-flag-count run offline")
        different: 3, 4, context("edge/smoke-native-qualify", "default", "", "offline"), "qualify-flag-count" => failed{"qualify-flag-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "distribution/qualify.py", "distribution/qualify.py", context("edge/smoke-native-qualify", "default", "", "offline"), "qualify-call" => ok evidence("qualify-call", "distribution/qualify.py", "distribution/qualify.py", true, "case edge/smoke-native-qualify variant default root qualify-call run offline")
        different: "distribution/qualify.py_2", "distribution/qualify.py", context("edge/smoke-native-qualify", "default", "", "offline"), "qualify-call" => failed{"qualify-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
