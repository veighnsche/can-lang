package m43edge002run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-002 "installed artifact smoke"
/// run pact.
/// Source: distribution/linux/smoke.sh
/// symbol "installed artifact smoke"
/// (L63-123): pinned example helpers and
/// runs and build verdict.
/// Disposition: rewire (same row pact as
/// the install slice; this file owns the
/// helper and run and verdict spellings).
/// Protects (this file): the two helpers
/// and four staged runs and canlc verbs
/// and example outputs and sqlite legs and
/// build bytes and tallies.
/// ADAPTATION (with source lines):
/// helper pins hold fn spellings; call pins
/// hold staged run bytes; verb pins hold
/// CLI spellings; output pins hold run
/// bytes; count pins hold ints tallied
/// from L63-123.
/// stage-fn pins stage_example (L63, L82,
/// L89, L98 and L107); assert-fn pins
/// canlc_assert (L70, L83, L90, L99 and
/// L108); stage-process pins
/// stage_example process (L82); stage-files
/// pins stage_example files (L89);
/// stage-crypto pins stage_example crypto
/// (L98); stage-sqlite pins
/// stage_example sqlite (L107); assert-verb
/// pins " assert " (L71); run-verb pins
/// " run " (L84, L93, L100, L102 and
/// L113); build-verb pins " build " (L118
/// and L119); assertions-key pins
/// assertions (L76 and L77 with two on
/// L77); process-output pins "ok" (L85);
/// process-tool pins /bin/echo (L86);
/// files-output pins file a.txt (L94 and
/// L95); crypto-match pins "match" (L101);
/// crypto-miss pins "mismatch" (L103);
/// crypto-input-hit pins "correct horse"
/// (L100); crypto-input-miss pins "wrong"
/// (L102); crypto-note pins argon2id
/// (L104); sqlite-output pins 7: remember
/// (L114 and L115); sqlite-db pins
/// notes.sqlite (L109); sqlite-driver pins
/// tests/integration/testdata/sql/sqlite-driver.ts
/// (L111); sqlite-seed pins
/// distribution/linux/smoke/sqlite-seed.ts
/// (L112); sqlite-seed-input pins
/// sqlite-seed.sql (L111); sqlite-setup
/// pins setup (L111); bun-path pins
/// current/runtime/bun (L111 and L112);
/// build-key pins buildID (L118 and L119);
/// smoke-verdict pins smoke ok (L123);
/// example-count pins int (4) from L82,
/// L89, L98 and L107; sqlite-setup-count
/// pins int (2) from L111-112;
/// build-repeat-count pins int (2) from
/// L118-119.
/// Facet map (helper then run order):
/// stage-fn, assert-fn, stage-process,
/// stage-files, stage-crypto, stage-sqlite,
/// assert-verb, run-verb, build-verb,
/// assertions-key, process-output,
/// process-tool, files-output, crypto-match,
/// crypto-miss, crypto-input-hit,
/// crypto-input-miss, crypto-note,
/// sqlite-output, sqlite-db, sqlite-driver,
/// sqlite-seed, sqlite-seed-input,
/// sqlite-setup, bun-path, build-key,
/// smoke-verdict, example-count,
/// sqlite-setup-count, build-repeat-count.
/// The install and identity span lives in
/// edge-002-base-semantics.can; the qualify
/// gates live in edge-002-roots-green.can.
/// Variants: row lists zero variants; this
/// file pins the four example runs and the
/// build verdict.
/// Environment: row lists zero gates;
/// offline only; no live run now.
/// Logical gates SUITE, ARCHIVE, DB and N1
/// bind at P23 and QD1; no live run now.
/// Timeout 120000ms is the offline default
/// bound (no timeout in this row; binds at
/// P23 like the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23 and
/// QD1 accept gates unmet).
/// Intended consumed report: M41 LIFE-012
/// and LIFE-013 parsed slices (no
/// qualified report yet; P23 and QD1
/// unmet).
/// Rewire stays blocked; smoke.sh
/// intact; no call retired.
/// Related: tests/integration/testdata/sql/sqlite-driver.ts
/// and distribution/linux/smoke/sqlite-seed.ts
/// (invoked by the caller; shared with M41).
/// Case edge/smoke-examples-determinism
/// checks: stage-fn, assert-fn,
/// stage-process, stage-files, stage-crypto,
/// stage-sqlite, assert-verb, run-verb,
/// build-verb, assertions-key,
/// process-output, process-tool,
/// files-output, crypto-match, crypto-miss,
/// crypto-input-hit, crypto-input-miss,
/// crypto-note, sqlite-output, sqlite-db,
/// sqlite-driver, sqlite-seed,
/// sqlite-seed-input, sqlite-setup,
/// bun-path, build-key, smoke-verdict,
/// example-count, sqlite-setup-count,
/// build-repeat-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str stage_fn
    str assert_fn
    str stage_process
    str stage_files
    str stage_crypto
    str stage_sqlite
    str assert_verb
    str run_verb
    str build_verb
    str assertions_key
    str process_output
    str process_tool
    str files_output
    str crypto_match
    str crypto_miss
    str crypto_input_hit
    str crypto_input_miss
    str crypto_note
    str sqlite_output
    str sqlite_db
    str sqlite_driver
    str sqlite_seed
    str sqlite_seed_input
    str sqlite_setup
    str bun_path
    str build_key
    str smoke_verdict
    int example_count
    int sqlite_setup_count
    int build_repeat_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/smoke-examples-determinism", "default", "", "offline"), "stage-fn" => ok "case edge/smoke-examples-determinism variant default root stage-fn run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/smoke-examples-determinism", "default", "", "offline"), "stage-fn" => ok evidence("stage-fn", "true", "true", true, "case edge/smoke-examples-determinism variant default root stage-fn run offline")
        different: false, true, context("edge/smoke-examples-determinism", "default", "", "offline"), "stage-fn" => failed{"stage-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("edge/smoke-examples-determinism", "default", "", "offline"), "example-count" => ok evidence("example-count", "4", "4", true, "case edge/smoke-examples-determinism variant default root example-count run offline")
        different: 3, 4, context("edge/smoke-examples-determinism", "default", "", "offline"), "example-count" => failed{"example-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "stage_example", "stage_example", context("edge/smoke-examples-determinism", "default", "", "offline"), "stage-fn" => ok evidence("stage-fn", "stage_example", "stage_example", true, "case edge/smoke-examples-determinism variant default root stage-fn run offline")
        different: "stage_example_2", "stage_example", context("edge/smoke-examples-determinism", "default", "", "offline"), "stage-fn" => failed{"stage-fn"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
