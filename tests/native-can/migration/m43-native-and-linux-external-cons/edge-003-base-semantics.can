package m43edge003base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-003 "PostgreSQL smoke"
/// rewire target pact.
/// Source: distribution/linux/postgres.sh
/// symbol "PostgreSQL smoke" (L1-9):
/// pinned shell envelope plus env
/// defaults.
/// Disposition: rewire target only (this
/// row owns the caller pact as reviewable
/// Can facts; no caller file changes
/// here; old shell call stays until the
/// integrator rewires it after each
/// linked row plus gate has accepted
/// proof).
/// Protects (this file): installed
/// sidecar plus PostgreSQL-17 row plus
/// version roundtrip wants, envelope leg:
/// shell header plus env defaults plus
/// image pin.
/// ADAPTATION (noted, plus source
/// lines): name pins hold env spellings;
/// path pins hold default bytes; count
/// pins hold ints tallied from L2 plus
/// L7 plus L8 plus L9.
/// shebang pins #!/bin/sh (L1);
/// product-name pins PostgreSQL (L2);
/// smoke-tag pins T19 (L2);
/// disposable-word pins disposable (L3
/// plus L9); network-word pins network
/// (L2 plus L3); sidecar-word pins
/// sidecar (L4); driver-kind pins
/// Bun.SQL (L4); shell-flags pins set
/// -eu (L5); src-name pins SRC (L7 plus
/// L16); src-path pins /src (L7);
/// work-name pins WORK (L8 plus L11
/// plus L12 plus L17 plus L18);
/// work-path pins /work (L8);
/// database-url-name pins DATABASE_URL
/// (L9); postgres-image pins
/// postgres:17 (L9); env-default-count
/// pins 3 (L7 plus L8 plus L9);
/// header-comment-count pins 3 (L2 plus
/// L3 plus L4).
/// Facet map (pin order): shebang,
/// product-name, smoke-tag,
/// disposable-word, network-word,
/// sidecar-word, driver-kind,
/// shell-flags, src-name, src-path,
/// work-name, work-path,
/// database-url-name, postgres-image,
/// env-default-count,
/// header-comment-count.
/// The binary plus gate plus
/// invocation roots live in
/// edge-003-roots-green.can; the
/// embedded assertion plus verdict shape
/// lives in edge-003-run-shape.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: zero gates; bind at P23
/// plus QD1; no live run now.
/// Logical gates SUITE plus PROC plus
/// WORK plus ENV plus DB bind at P23
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like the
/// M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Intended consumed report: M41
/// LIFE-013 parsed slice (no qualified
/// report yet; P23 plus QD1 plus QN1
/// unmet).
/// Rewire stays blocked; postgres.sh
/// plus pg-driver.ts plus the Go caller
/// intact; no call retired.
/// Shared old files intact; retirement
/// is a later integrator choice; Z03
/// owns activation.
/// Case edge/postgres-provision checks:
/// shebang, product-name, smoke-tag,
/// disposable-word, network-word,
/// sidecar-word, driver-kind,
/// shell-flags, src-name, src-path,
/// work-name, work-path,
/// database-url-name, postgres-image,
/// env-default-count,
/// header-comment-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str shebang
    str product_name
    str smoke_tag
    str disposable_word
    str network_word
    str sidecar_word
    str driver_kind
    str shell_flags
    str src_name
    str src_path
    str work_name
    str work_path
    str database_url_name
    str postgres_image
    int env_default_count
    int header_comment_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/postgres-provision", "default", "", "offline"), "shebang" => ok "case edge/postgres-provision variant default root shebang run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/postgres-provision", "default", "", "offline"), "shebang" => ok evidence("shebang", "true", "true", true, "case edge/postgres-provision variant default root shebang run offline")
        different: false, true, context("edge/postgres-provision", "default", "", "offline"), "shebang" => failed{"shebang"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("edge/postgres-provision", "default", "", "offline"), "env-default-count" => ok evidence("env-default-count", "3", "3", true, "case edge/postgres-provision variant default root env-default-count run offline")
        different: 2, 3, context("edge/postgres-provision", "default", "", "offline"), "env-default-count" => failed{"env-default-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "#!/bin/sh", "#!/bin/sh", context("edge/postgres-provision", "default", "", "offline"), "shebang" => ok evidence("shebang", "#!/bin/sh", "#!/bin/sh", true, "case edge/postgres-provision variant default root shebang run offline")
        different: "#!/bin/sh_2", "#!/bin/sh", context("edge/postgres-provision", "default", "", "offline"), "shebang" => failed{"shebang"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
