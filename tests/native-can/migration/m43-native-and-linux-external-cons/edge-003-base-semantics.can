fn check[] checks
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e003" => ok [check("shebang", "shebang keeps its bytes"), check("product-name", "product name keeps its spelling"), check("smoke-tag", "smoke tag keeps its bytes"), check("disposable-word", "disposable word keeps its bytes"), check("network-word", "network word keeps its bytes"), check("sidecar-word", "sidecar word keeps its bytes"), check("driver-kind", "driver kind keeps its spelling"), check("shell-flags", "shell flags keep their bytes"), check("src-name", "src name keeps its spelling"), check("src-path", "src path keeps its bytes"), check("work-name", "work name keeps its spelling"), check("work-path", "work path keeps its bytes"), check("database-url-name", "database url name keeps its spelling"), check("postgres-image", "postgres image keeps its bytes"), check("env-default-count", "three env defaults exist"), check("header-comment-count", "three header comments exist")]
        other: "nope" => ok []
    match scope is "m43-e003"
        false => ok []
        true => ok [check("shebang", "shebang keeps its bytes"), check("product-name", "product name keeps its spelling"), check("smoke-tag", "smoke tag keeps its bytes"), check("disposable-word", "disposable word keeps its bytes"), check("network-word", "network word keeps its bytes"), check("sidecar-word", "sidecar word keeps its bytes"), check("driver-kind", "driver kind keeps its spelling"), check("shell-flags", "shell flags keep their bytes"), check("src-name", "src name keeps its spelling"), check("src-path", "src path keeps its bytes"), check("work-name", "work name keeps its spelling"), check("work-path", "work path keeps its bytes"), check("database-url-name", "database url name keeps its spelling"), check("postgres-image", "postgres image keeps its bytes"), check("env-default-count", "three env defaults exist"), check("header-comment-count", "three header comments exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "edge/postgres-provision" => ok [expected_check("shebang", "#!/bin/sh"), expected_check("product-name", "PostgreSQL"), expected_check("smoke-tag", "T19"), expected_check("disposable-word", "disposable"), expected_check("network-word", "network"), expected_check("sidecar-word", "sidecar"), expected_check("driver-kind", "Bun.SQL"), expected_check("shell-flags", "set -eu"), expected_check("src-name", "SRC"), expected_check("src-path", "/src"), expected_check("work-name", "WORK"), expected_check("work-path", "/work"), expected_check("database-url-name", "DATABASE_URL"), expected_check("postgres-image", "postgres:17"), expected_check("env-default-count", "3"), expected_check("header-comment-count", "3")]
        unknown: "nope" => ok []
    match case is "edge/postgres-provision"
        false => ok []
        true => ok [expected_check("shebang", "#!/bin/sh"), expected_check("product-name", "PostgreSQL"), expected_check("smoke-tag", "T19"), expected_check("disposable-word", "disposable"), expected_check("network-word", "network"), expected_check("sidecar-word", "sidecar"), expected_check("driver-kind", "Bun.SQL"), expected_check("shell-flags", "set -eu"), expected_check("src-name", "SRC"), expected_check("src-path", "/src"), expected_check("work-name", "WORK"), expected_check("work-path", "/work"), expected_check("database-url-name", "DATABASE_URL"), expected_check("postgres-image", "postgres:17"), expected_check("env-default-count", "3"), expected_check("header-comment-count", "3")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/postgres-provision", "default", "", "offline") => ok
        seed_shebang: context("edge/postgres-provision", "seed-shebang-drift", "", "offline") => failed{"shebang"}
        seed_product_name: context("edge/postgres-provision", "seed-product-name-drift", "", "offline") => failed{"product-name"}
        seed_smoke_tag: context("edge/postgres-provision", "seed-smoke-tag-drift", "", "offline") => failed{"smoke-tag"}
        seed_disposable_word: context("edge/postgres-provision", "seed-disposable-word-drift", "", "offline") => failed{"disposable-word"}
        seed_network_word: context("edge/postgres-provision", "seed-network-word-drift", "", "offline") => failed{"network-word"}
        seed_sidecar_word: context("edge/postgres-provision", "seed-sidecar-word-drift", "", "offline") => failed{"sidecar-word"}
        seed_driver_kind: context("edge/postgres-provision", "seed-driver-kind-drift", "", "offline") => failed{"driver-kind"}
        seed_shell_flags: context("edge/postgres-provision", "seed-shell-flags-drift", "", "offline") => failed{"shell-flags"}
        seed_src_name: context("edge/postgres-provision", "seed-src-name-drift", "", "offline") => failed{"src-name"}
        seed_src_path: context("edge/postgres-provision", "seed-src-path-drift", "", "offline") => failed{"src-path"}
        seed_work_name: context("edge/postgres-provision", "seed-work-name-drift", "", "offline") => failed{"work-name"}
        seed_work_path: context("edge/postgres-provision", "seed-work-path-drift", "", "offline") => failed{"work-path"}
        seed_database_url_name: context("edge/postgres-provision", "seed-database-url-name-drift", "", "offline") => failed{"database-url-name"}
        seed_postgres_image: context("edge/postgres-provision", "seed-postgres-image-drift", "", "offline") => failed{"postgres-image"}
        seed_env_default_count: context("edge/postgres-provision", "seed-env-default-count-drift", "", "offline") => failed{"env-default-count"}
        seed_header_comment_count: context("edge/postgres-provision", "seed-header-comment-count-drift", "", "offline") => failed{"header-comment-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.shebang, "#!/bin/sh", c, "shebang")
            failed
            ok evidence shebang_evidence => match call require_text(got.product_name, "PostgreSQL", c, "product-name")
                failed
                ok evidence product_name_evidence => match call require_text(got.smoke_tag, "T19", c, "smoke-tag")
                    failed
                    ok evidence smoke_tag_evidence => match call require_text(got.disposable_word, "disposable", c, "disposable-word")
                        failed
                        ok evidence disposable_word_evidence => match call require_text(got.network_word, "network", c, "network-word")
                            failed
                            ok evidence network_word_evidence => match call require_text(got.sidecar_word, "sidecar", c, "sidecar-word")
                                failed
                                ok evidence sidecar_word_evidence => match call require_text(got.driver_kind, "Bun.SQL", c, "driver-kind")
                                    failed
                                    ok evidence driver_kind_evidence => match call require_text(got.shell_flags, "set -eu", c, "shell-flags")
                                        failed
                                        ok evidence shell_flags_evidence => match call require_text(got.src_name, "SRC", c, "src-name")
                                            failed
                                            ok evidence src_name_evidence => match call require_text(got.src_path, "/src", c, "src-path")
                                                failed
                                                ok evidence src_path_evidence => match call require_text(got.work_name, "WORK", c, "work-name")
                                                    failed
                                                    ok evidence work_name_evidence => match call require_text(got.work_path, "/work", c, "work-path")
                                                        failed
                                                        ok evidence work_path_evidence => match call require_text(got.database_url_name, "DATABASE_URL", c, "database-url-name")
                                                            failed
                                                            ok evidence database_url_name_evidence => match call require_text(got.postgres_image, "postgres:17", c, "postgres-image")
                                                                failed
                                                                ok evidence postgres_image_evidence => match call require_int(got.env_default_count, 3, c, "env-default-count")
                                                                    failed
                                                                    ok evidence env_default_count_evidence => match call require_int(got.header_comment_count, 3, c, "header-comment-count")
                                                                        failed
                                                                        ok evidence header_comment_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e003" => ok test_case("edge/postgres-provision", ["edge", "m43"], [], 120000, [check_ref("shebang"), check_ref("product-name"), check_ref("smoke-tag"), check_ref("disposable-word"), check_ref("network-word"), check_ref("sidecar-word"), check_ref("driver-kind"), check_ref("shell-flags"), check_ref("src-name"), check_ref("src-path"), check_ref("work-name"), check_ref("work-path"), check_ref("database-url-name"), check_ref("postgres-image"), check_ref("env-default-count"), check_ref("header-comment-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m43-e003"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("edge/postgres-provision", ["edge", "m43"], [], 120000, [check_ref("shebang"), check_ref("product-name"), check_ref("smoke-tag"), check_ref("disposable-word"), check_ref("network-word"), check_ref("sidecar-word"), check_ref("driver-kind"), check_ref("shell-flags"), check_ref("src-name"), check_ref("src-path"), check_ref("work-name"), check_ref("work-path"), check_ref("database-url-name"), check_ref("postgres-image"), check_ref("env-default-count"), check_ref("header-comment-count")], callable case_body)
