        _ => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e003" => ok [check("canlc-name", "canlc name keeps its spelling"), check("canlc-path", "canlc path keeps its bytes"), check("bun-name", "bun name keeps its spelling"), check("bun-path", "bun path keeps its bytes"), check("exec-gate", "exec gate keeps its bytes"), check("change-dir", "change dir keeps its bytes"), check("driver-path", "driver path keeps its bytes"), check("report-path", "report path keeps its bytes"), check("python-launch", "python launch keeps its bytes"), check("heredoc-open", "heredoc open keeps its bytes"), check("binary-path-count", "two binary paths exist"), check("exec-gate-count", "two exec gates exist"), check("stage-step-count", "three stage steps exist")]
        other: "nope" => ok []
    match scope is "m43-e003"
        false => ok []
        true => ok [check("canlc-name", "canlc name keeps its spelling"), check("canlc-path", "canlc path keeps its bytes"), check("bun-name", "bun name keeps its spelling"), check("bun-path", "bun path keeps its bytes"), check("exec-gate", "exec gate keeps its bytes"), check("change-dir", "change dir keeps its bytes"), check("driver-path", "driver path keeps its bytes"), check("report-path", "report path keeps its bytes"), check("python-launch", "python launch keeps its bytes"), check("heredoc-open", "heredoc open keeps its bytes"), check("binary-path-count", "two binary paths exist"), check("exec-gate-count", "two exec gates exist"), check("stage-step-count", "three stage steps exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "edge/postgres-invocation" => ok [expected_check("canlc-name", "CANLC"), expected_check("canlc-path", "current/bin/canlc"), expected_check("bun-name", "BUN"), expected_check("bun-path", "current/runtime/bun"), expected_check("exec-gate", "test -x"), expected_check("change-dir", "cd"), expected_check("driver-path", "distribution/linux/smoke/pg-driver.ts"), expected_check("report-path", "reports/postgres.json"), expected_check("python-launch", "python3 -"), expected_check("heredoc-open", "<<'PY'"), expected_check("binary-path-count", "2"), expected_check("exec-gate-count", "2"), expected_check("stage-step-count", "3")]
        unknown: "nope" => ok []
    match case is "edge/postgres-invocation"
        false => ok []
        true => ok [expected_check("canlc-name", "CANLC"), expected_check("canlc-path", "current/bin/canlc"), expected_check("bun-name", "BUN"), expected_check("bun-path", "current/runtime/bun"), expected_check("exec-gate", "test -x"), expected_check("change-dir", "cd"), expected_check("driver-path", "distribution/linux/smoke/pg-driver.ts"), expected_check("report-path", "reports/postgres.json"), expected_check("python-launch", "python3 -"), expected_check("heredoc-open", "<<'PY'"), expected_check("binary-path-count", "2"), expected_check("exec-gate-count", "2"), expected_check("stage-step-count", "3")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/postgres-invocation", "default", "", "offline") => ok
        seed_canlc_name: context("edge/postgres-invocation", "seed-canlc-name-drift", "", "offline") => failed{"canlc-name"}
        seed_canlc_path: context("edge/postgres-invocation", "seed-canlc-path-drift", "", "offline") => failed{"canlc-path"}
        seed_bun_name: context("edge/postgres-invocation", "seed-bun-name-drift", "", "offline") => failed{"bun-name"}
        seed_bun_path: context("edge/postgres-invocation", "seed-bun-path-drift", "", "offline") => failed{"bun-path"}
        seed_exec_gate: context("edge/postgres-invocation", "seed-exec-gate-drift", "", "offline") => failed{"exec-gate"}
        seed_change_dir: context("edge/postgres-invocation", "seed-change-dir-drift", "", "offline") => failed{"change-dir"}
        seed_driver_path: context("edge/postgres-invocation", "seed-driver-path-drift", "", "offline") => failed{"driver-path"}
        seed_report_path: context("edge/postgres-invocation", "seed-report-path-drift", "", "offline") => failed{"report-path"}
        seed_python_launch: context("edge/postgres-invocation", "seed-python-launch-drift", "", "offline") => failed{"python-launch"}
        seed_heredoc_open: context("edge/postgres-invocation", "seed-heredoc-open-drift", "", "offline") => failed{"heredoc-open"}
        seed_binary_path_count: context("edge/postgres-invocation", "seed-binary-path-count-drift", "", "offline") => failed{"binary-path-count"}
        seed_exec_gate_count: context("edge/postgres-invocation", "seed-exec-gate-count-drift", "", "offline") => failed{"exec-gate-count"}
        seed_stage_step_count: context("edge/postgres-invocation", "seed-stage-step-count-drift", "", "offline") => failed{"stage-step-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.canlc_name, "CANLC", c, "canlc-name")
            failed
            ok evidence canlc_name_evidence => match call require_text(got.canlc_path, "current/bin/canlc", c, "canlc-path")
                failed
                ok evidence canlc_path_evidence => match call require_text(got.bun_name, "BUN", c, "bun-name")
                    failed
                    ok evidence bun_name_evidence => match call require_text(got.bun_path, "current/runtime/bun", c, "bun-path")
                        failed
                        ok evidence bun_path_evidence => match call require_text(got.exec_gate, "test -x", c, "exec-gate")
                            failed
                            ok evidence exec_gate_evidence => match call require_text(got.change_dir, "cd", c, "change-dir")
                                failed
                                ok evidence change_dir_evidence => match call require_text(got.driver_path, "distribution/linux/smoke/pg-driver.ts", c, "driver-path")
                                    failed
                                    ok evidence driver_path_evidence => match call require_text(got.report_path, "reports/postgres.json", c, "report-path")
                                        failed
                                        ok evidence report_path_evidence => match call require_text(got.python_launch, "python3 -", c, "python-launch")
                                            failed
                                            ok evidence python_launch_evidence => match call require_text(got.heredoc_open, "<<'PY'", c, "heredoc-open")
                                                failed
                                                ok evidence heredoc_open_evidence => match call require_int(got.binary_path_count, 2, c, "binary-path-count")
                                                    failed
                                                    ok evidence binary_path_count_evidence => match call require_int(got.exec_gate_count, 2, c, "exec-gate-count")
                                                        failed
                                                        ok evidence exec_gate_count_evidence => match call require_int(got.stage_step_count, 3, c, "stage-step-count")
                                                            failed
                                                            ok evidence stage_step_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e003" => ok test_case("edge/postgres-invocation", ["edge", "m43"], [], 120000, [check_ref("canlc-name"), check_ref("canlc-path"), check_ref("bun-name"), check_ref("bun-path"), check_ref("exec-gate"), check_ref("change-dir"), check_ref("driver-path"), check_ref("report-path"), check_ref("python-launch"), check_ref("heredoc-open"), check_ref("binary-path-count"), check_ref("exec-gate-count"), check_ref("stage-step-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m43-e003"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("edge/postgres-invocation", ["edge", "m43"], [], 120000, [check_ref("canlc-name"), check_ref("canlc-path"), check_ref("bun-name"), check_ref("bun-path"), check_ref("exec-gate"), check_ref("change-dir"), check_ref("driver-path"), check_ref("report-path"), check_ref("python-launch"), check_ref("heredoc-open"), check_ref("binary-path-count"), check_ref("exec-gate-count"), check_ref("stage-step-count")], callable case_body)
