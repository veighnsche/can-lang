package m43edge003roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-003 "PostgreSQL smoke"
/// rewire target pact.
/// Source: distribution/linux/postgres.sh
/// symbol "PostgreSQL smoke"
/// (L11-18): pinned binary paths plus
/// exec gates plus driver invocation
/// plus report staging.
/// Disposition: rewire target only (this
/// row owns the caller pact as reviewable
/// Can facts; no caller file changes
/// here; old shell call stays until the
/// integrator rewires it after each
/// linked row plus gate has accepted
/// proof).
/// Protects (this file): installed
/// sidecar plus PostgreSQL-17 row plus
/// version roundtrip wants, roots leg:
/// binary paths plus exec gates plus
/// staged invocation.
/// ADAPTATION (noted, plus source
/// lines): name pins hold binary
/// spellings; path pins hold install
/// plus report bytes; gate pins hold
/// launch spellings; count pins hold
/// ints tallied from L11 plus L13 plus
/// L16.
/// canlc-name pins CANLC (L11 plus
/// L13); canlc-path pins
/// current/bin/canlc (L11); bun-name
/// pins BUN (L12 plus L14 plus L17);
/// bun-path pins current/runtime/bun
/// (L12); exec-gate pins test -x (L13
/// plus L14); change-dir pins cd (L16);
/// driver-path pins
/// distribution/linux/smoke/pg-driver.ts
/// (L17); report-path pins
/// reports/postgres.json (L17 plus
/// L18); python-launch pins python3 -
/// (L18); heredoc-open pins
/// <<'PY' (L18); binary-path-count pins
/// 2 (L11 plus L12); exec-gate-count
/// pins 2 (L13 plus L14);
/// stage-step-count pins 3 (L16 plus
/// L17 plus L18).
/// Facet map (pin order): canlc-name,
/// canlc-path, bun-name, bun-path,
/// exec-gate, change-dir, driver-path,
/// report-path, python-launch,
/// heredoc-open, binary-path-count,
/// exec-gate-count, stage-step-count.
/// The shell envelope plus env leg
/// lives in
/// edge-003-base-semantics.can; the
/// embedded assertion plus verdict shape
/// lives in edge-003-run-shape.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: zero gates; bind at P23
/// plus QD1; no live run now.
/// Logical gates SUITE plus PROC plus
/// WORK plus ENV plus DB bind at P23
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like the
/// M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Intended consumed report: M41
/// LIFE-013 parsed slice (no qualified
/// report yet; P23 plus QD1 plus QN1
/// unmet).
/// Rewire stays blocked; postgres.sh
/// plus pg-driver.ts plus the Go caller
/// intact; no call retired.
/// Shared old files intact; retirement
/// is a later integrator choice; Z03
/// owns activation.
/// Case edge/postgres-invocation checks:
/// canlc-name, canlc-path, bun-name,
/// bun-path, exec-gate, change-dir,
/// driver-path, report-path,
/// python-launch, heredoc-open,
/// binary-path-count, exec-gate-count,
/// stage-step-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str canlc_name
    str canlc_path
    str bun_name
    str bun_path
    str exec_gate
    str change_dir
    str driver_path
    str report_path
    str python_launch
    str heredoc_open
    int binary_path_count
    int exec_gate_count
    int stage_step_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/postgres-invocation", "default", "", "offline"), "canlc-name" => ok "case edge/postgres-invocation variant default root canlc-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/postgres-invocation", "default", "", "offline"), "canlc-name" => ok evidence("canlc-name", "true", "true", true, "case edge/postgres-invocation variant default root canlc-name run offline")
        different: false, true, context("edge/postgres-invocation", "default", "", "offline"), "canlc-name" => failed{"canlc-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/postgres-invocation", "default", "", "offline"), "binary-path-count" => ok evidence("binary-path-count", "2", "2", true, "case edge/postgres-invocation variant default root binary-path-count run offline")
        different: 1, 2, context("edge/postgres-invocation", "default", "", "offline"), "binary-path-count" => failed{"binary-path-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CANLC", "CANLC", context("edge/postgres-invocation", "default", "", "offline"), "canlc-name" => ok evidence("canlc-name", "CANLC", "CANLC", true, "case edge/postgres-invocation variant default root canlc-name run offline")
        different: "CANLC_2", "CANLC", context("edge/postgres-invocation", "default", "", "offline"), "canlc-name" => failed{"canlc-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_canlc_name: "seed-canlc-name-drift" => ok observation("CANLC_2", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_canlc_path: "seed-canlc-path-drift" => ok observation("CANLC", "current/bin/canlc_2", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_bun_name: "seed-bun-name-drift" => ok observation("CANLC", "current/bin/canlc", "BUN_2", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_bun_path: "seed-bun-path-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun_2", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_exec_gate: "seed-exec-gate-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x_2", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_change_dir: "seed-change-dir-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd_2", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_driver_path: "seed-driver-path-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts_2", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        seed_report_path: "seed-report-path-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json_2", "python3 -", "<<'PY'", 2, 2, 3)
        seed_python_launch: "seed-python-launch-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -_2", "<<'PY'", 2, 2, 3)
        seed_heredoc_open: "seed-heredoc-open-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'_2", 2, 2, 3)
        seed_binary_path_count: "seed-binary-path-count-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 1, 2, 3)
        seed_exec_gate_count: "seed-exec-gate-count-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 1, 3)
        seed_stage_step_count: "seed-stage-step-count-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 2)
    match variant_id
        "seed-canlc-name-drift" => ok observation("CANLC_2", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-canlc-path-drift" => ok observation("CANLC", "current/bin/canlc_2", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-bun-name-drift" => ok observation("CANLC", "current/bin/canlc", "BUN_2", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-bun-path-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun_2", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-exec-gate-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x_2", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-change-dir-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd_2", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-driver-path-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts_2", "reports/postgres.json", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-report-path-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json_2", "python3 -", "<<'PY'", 2, 2, 3)
        "seed-python-launch-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -_2", "<<'PY'", 2, 2, 3)
        "seed-heredoc-open-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'_2", 2, 2, 3)
        "seed-binary-path-count-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 1, 2, 3)
        "seed-exec-gate-count-drift" => ok observation("CANLC", "current/bin/canlc", "BUN", "current/runtime/bun", "test -x", "cd", "distribution/linux/smoke/pg-driver.ts", "reports/postgres.json", "python3 -", "<<'PY'", 2, 1, 3)
