package m43edge003run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-003 "PostgreSQL smoke"
/// rewire target pact.
/// Source: distribution/linux/postgres.sh
/// symbol "PostgreSQL smoke"
/// (L19-25): pinned embedded python
/// assertions plus verdict lines.
/// Disposition: rewire target only (this
/// row owns the caller pact as reviewable
/// Can facts; no caller file changes
/// here; old shell call stays until the
/// integrator rewires it after each
/// linked row plus gate has accepted
/// proof).
/// Protects (this file): installed
/// sidecar plus PostgreSQL-17 row plus
/// version roundtrip wants, verdict leg:
/// embedded assertions plus ok lines.
/// ADAPTATION (noted, plus source
/// lines): key pins hold report spellings;
/// want pins hold refused-drift bytes;
/// verdict pins hold ok lines; count
/// pins hold ints tallied from L19 plus
/// L21 plus L23.
/// py-imports pins import json, sys
/// (L19); argv-word pins sys.argv (L20);
/// server-version-key pins serverVersion
/// (L21 plus L23); prefix-check pins
/// startswith (L21); major-want pins
/// 17. (L21); body-want pins remember
/// (L22); roundtrip-word pins roundtrip
/// (L23); inline-verdict pins postgres
/// ok (L23); shell-verdict pins postgres
/// smoke ok (L25); assert-word pins
/// assert (L21 plus L22); heredoc-fence
/// pins PY (L18 plus L24); assert-count
/// pins 2 (L21 plus L22); verdict-count
/// pins 2 (L23 plus L25);
/// python-line-count pins 5 (L19 plus
/// L20 plus L21 plus L22 plus L23).
/// Facet map (pin order): py-imports,
/// argv-word, server-version-key,
/// prefix-check, major-want, body-want,
/// roundtrip-word, inline-verdict,
/// shell-verdict, assert-word,
/// heredoc-fence, assert-count,
/// verdict-count, python-line-count.
/// The shell envelope plus env leg
/// lives in
/// edge-003-base-semantics.can; the
/// binary plus gate plus invocation
/// roots live in
/// edge-003-roots-green.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: zero gates; bind at P23
/// plus QD1; no live run now.
/// Logical gates SUITE plus PROC plus
/// WORK plus ENV plus DB bind at P23
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like the
/// M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Intended consumed report: M41
/// LIFE-013 parsed slice (no qualified
/// report yet; P23 plus QD1 plus QN1
/// unmet).
/// Rewire stays blocked; postgres.sh
/// plus pg-driver.ts plus the Go caller
/// intact; no call retired.
/// Shared old files intact; retirement
/// is a later integrator choice; Z03
/// owns activation.
/// Case edge/postgres-assertions checks:
/// py-imports, argv-word,
/// server-version-key, prefix-check,
/// major-want, body-want,
/// roundtrip-word, inline-verdict,
/// shell-verdict, assert-word,
/// heredoc-fence, assert-count,
/// verdict-count, python-line-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str py_imports
    str argv_word
    str server_version_key
    str prefix_check
    str major_want
    str body_want
    str roundtrip_word
    str inline_verdict
    str shell_verdict
    str assert_word
    str heredoc_fence
    int assert_count
    int verdict_count
    int python_line_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/postgres-assertions", "default", "", "offline"), "py-imports" => ok "case edge/postgres-assertions variant default root py-imports run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/postgres-assertions", "default", "", "offline"), "py-imports" => ok evidence("py-imports", "true", "true", true, "case edge/postgres-assertions variant default root py-imports run offline")
        different: false, true, context("edge/postgres-assertions", "default", "", "offline"), "py-imports" => failed{"py-imports"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/postgres-assertions", "default", "", "offline"), "assert-count" => ok evidence("assert-count", "2", "2", true, "case edge/postgres-assertions variant default root assert-count run offline")
        different: 1, 2, context("edge/postgres-assertions", "default", "", "offline"), "assert-count" => failed{"assert-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "import json, sys", "import json, sys", context("edge/postgres-assertions", "default", "", "offline"), "py-imports" => ok evidence("py-imports", "import json, sys", "import json, sys", true, "case edge/postgres-assertions variant default root py-imports run offline")
        different: "import json, sys_2", "import json, sys", context("edge/postgres-assertions", "default", "", "offline"), "py-imports" => failed{"py-imports"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_py_imports: "seed-py-imports-drift" => ok observation("import json, sys_2", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_argv_word: "seed-argv-word-drift" => ok observation("import json, sys", "sys.argv_2", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_server_version_key: "seed-server-version-key-drift" => ok observation("import json, sys", "sys.argv", "serverVersion_2", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_prefix_check: "seed-prefix-check-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith_2", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_major_want: "seed-major-want-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17._2", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_body_want: "seed-body-want-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember_2", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_roundtrip_word: "seed-roundtrip-word-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip_2", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_inline_verdict: "seed-inline-verdict-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok_2", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        seed_shell_verdict: "seed-shell-verdict-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok_2", "assert", "PY", 2, 2, 5)
        seed_assert_word: "seed-assert-word-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert_2", "PY", 2, 2, 5)
        seed_heredoc_fence: "seed-heredoc-fence-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY_2", 2, 2, 5)
        seed_assert_count: "seed-assert-count-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 1, 2, 5)
        seed_verdict_count: "seed-verdict-count-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 1, 5)
        seed_python_line_count: "seed-python-line-count-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 4)
    match variant_id
        "seed-py-imports-drift" => ok observation("import json, sys_2", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-argv-word-drift" => ok observation("import json, sys", "sys.argv_2", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-server-version-key-drift" => ok observation("import json, sys", "sys.argv", "serverVersion_2", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-prefix-check-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith_2", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-major-want-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17._2", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-body-want-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember_2", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-roundtrip-word-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip_2", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-inline-verdict-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok_2", "postgres smoke ok", "assert", "PY", 2, 2, 5)
        "seed-shell-verdict-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok_2", "assert", "PY", 2, 2, 5)
        "seed-assert-word-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert_2", "PY", 2, 2, 5)
        "seed-heredoc-fence-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY_2", 2, 2, 5)
        "seed-assert-count-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 1, 2, 5)
        "seed-verdict-count-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 1, 5)
        "seed-python-line-count-drift" => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 4)
        _ => ok observation("import json, sys", "sys.argv", "serverVersion", "startswith", "17.", "remember", "roundtrip", "postgres ok", "postgres smoke ok", "assert", "PY", 2, 2, 5)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e003" => ok [check("py-imports", "python imports keep their bytes"), check("argv-word", "argv word keeps its bytes"), check("server-version-key", "server version key keeps its spelling"), check("prefix-check", "prefix check keeps its spelling"), check("major-want", "major want keeps its bytes"), check("body-want", "body want keeps its bytes"), check("roundtrip-word", "roundtrip word keeps its bytes"), check("inline-verdict", "inline verdict keeps its bytes"), check("shell-verdict", "shell verdict keeps its bytes"), check("assert-word", "assert word keeps its bytes"), check("heredoc-fence", "heredoc fence keeps its bytes"), check("assert-count", "two asserts exist"), check("verdict-count", "two verdicts exist"), check("python-line-count", "five python lines exist")]
        other: "nope" => ok []
    match scope is "m43-e003"
        false => ok []
        true => ok [check("py-imports", "python imports keep their bytes"), check("argv-word", "argv word keeps its bytes"), check("server-version-key", "server version key keeps its spelling"), check("prefix-check", "prefix check keeps its spelling"), check("major-want", "major want keeps its bytes"), check("body-want", "body want keeps its bytes"), check("roundtrip-word", "roundtrip word keeps its bytes"), check("inline-verdict", "inline verdict keeps its bytes"), check("shell-verdict", "shell verdict keeps its bytes"), check("assert-word", "assert word keeps its bytes"), check("heredoc-fence", "heredoc fence keeps its bytes"), check("assert-count", "two asserts exist"), check("verdict-count", "two verdicts exist"), check("python-line-count", "five python lines exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "edge/postgres-assertions" => ok [expected_check("py-imports", "import json, sys"), expected_check("argv-word", "sys.argv"), expected_check("server-version-key", "serverVersion"), expected_check("prefix-check", "startswith"), expected_check("major-want", "17."), expected_check("body-want", "remember"), expected_check("roundtrip-word", "roundtrip"), expected_check("inline-verdict", "postgres ok"), expected_check("shell-verdict", "postgres smoke ok"), expected_check("assert-word", "assert"), expected_check("heredoc-fence", "PY"), expected_check("assert-count", "2"), expected_check("verdict-count", "2"), expected_check("python-line-count", "5")]
        unknown: "nope" => ok []
    match case is "edge/postgres-assertions"
        false => ok []
        true => ok [expected_check("py-imports", "import json, sys"), expected_check("argv-word", "sys.argv"), expected_check("server-version-key", "serverVersion"), expected_check("prefix-check", "startswith"), expected_check("major-want", "17."), expected_check("body-want", "remember"), expected_check("roundtrip-word", "roundtrip"), expected_check("inline-verdict", "postgres ok"), expected_check("shell-verdict", "postgres smoke ok"), expected_check("assert-word", "assert"), expected_check("heredoc-fence", "PY"), expected_check("assert-count", "2"), expected_check("verdict-count", "2"), expected_check("python-line-count", "5")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/postgres-assertions", "default", "", "offline") => ok
        seed_py_imports: context("edge/postgres-assertions", "seed-py-imports-drift", "", "offline") => failed{"py-imports"}
        seed_argv_word: context("edge/postgres-assertions", "seed-argv-word-drift", "", "offline") => failed{"argv-word"}
        seed_server_version_key: context("edge/postgres-assertions", "seed-server-version-key-drift", "", "offline") => failed{"server-version-key"}
        seed_prefix_check: context("edge/postgres-assertions", "seed-prefix-check-drift", "", "offline") => failed{"prefix-check"}
        seed_major_want: context("edge/postgres-assertions", "seed-major-want-drift", "", "offline") => failed{"major-want"}
        seed_body_want: context("edge/postgres-assertions", "seed-body-want-drift", "", "offline") => failed{"body-want"}
        seed_roundtrip_word: context("edge/postgres-assertions", "seed-roundtrip-word-drift", "", "offline") => failed{"roundtrip-word"}
        seed_inline_verdict: context("edge/postgres-assertions", "seed-inline-verdict-drift", "", "offline") => failed{"inline-verdict"}
        seed_shell_verdict: context("edge/postgres-assertions", "seed-shell-verdict-drift", "", "offline") => failed{"shell-verdict"}
        seed_assert_word: context("edge/postgres-assertions", "seed-assert-word-drift", "", "offline") => failed{"assert-word"}
        seed_heredoc_fence: context("edge/postgres-assertions", "seed-heredoc-fence-drift", "", "offline") => failed{"heredoc-fence"}
        seed_assert_count: context("edge/postgres-assertions", "seed-assert-count-drift", "", "offline") => failed{"assert-count"}
        seed_verdict_count: context("edge/postgres-assertions", "seed-verdict-count-drift", "", "offline") => failed{"verdict-count"}
        seed_python_line_count: context("edge/postgres-assertions", "seed-python-line-count-drift", "", "offline") => failed{"python-line-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.py_imports, "import json, sys", c, "py-imports")
            failed
            ok evidence py_imports_evidence => match call require_text(got.argv_word, "sys.argv", c, "argv-word")
                failed
                ok evidence argv_word_evidence => match call require_text(got.server_version_key, "serverVersion", c, "server-version-key")
                    failed
                    ok evidence server_version_key_evidence => match call require_text(got.prefix_check, "startswith", c, "prefix-check")
                        failed
                        ok evidence prefix_check_evidence => match call require_text(got.major_want, "17.", c, "major-want")
                            failed
                            ok evidence major_want_evidence => match call require_text(got.body_want, "remember", c, "body-want")
                                failed
                                ok evidence body_want_evidence => match call require_text(got.roundtrip_word, "roundtrip", c, "roundtrip-word")
                                    failed
                                    ok evidence roundtrip_word_evidence => match call require_text(got.inline_verdict, "postgres ok", c, "inline-verdict")
                                        failed
                                        ok evidence inline_verdict_evidence => match call require_text(got.shell_verdict, "postgres smoke ok", c, "shell-verdict")
                                            failed
                                            ok evidence shell_verdict_evidence => match call require_text(got.assert_word, "assert", c, "assert-word")
                                                failed
                                                ok evidence assert_word_evidence => match call require_text(got.heredoc_fence, "PY", c, "heredoc-fence")
                                                    failed
                                                    ok evidence heredoc_fence_evidence => match call require_int(got.assert_count, 2, c, "assert-count")
                                                        failed
                                                        ok evidence assert_count_evidence => match call require_int(got.verdict_count, 2, c, "verdict-count")
                                                            failed
                                                            ok evidence verdict_count_evidence => match call require_int(got.python_line_count, 5, c, "python-line-count")
                                                                failed
                                                                ok evidence python_line_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e003" => ok test_case("edge/postgres-assertions", ["edge", "m43"], [], 120000, [check_ref("py-imports"), check_ref("argv-word"), check_ref("server-version-key"), check_ref("prefix-check"), check_ref("major-want"), check_ref("body-want"), check_ref("roundtrip-word"), check_ref("inline-verdict"), check_ref("shell-verdict"), check_ref("assert-word"), check_ref("heredoc-fence"), check_ref("assert-count"), check_ref("verdict-count"), check_ref("python-line-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m43-e003"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("edge/postgres-assertions", ["edge", "m43"], [], 120000, [check_ref("py-imports"), check_ref("argv-word"), check_ref("server-version-key"), check_ref("prefix-check"), check_ref("major-want"), check_ref("body-want"), check_ref("roundtrip-word"), check_ref("inline-verdict"), check_ref("shell-verdict"), check_ref("assert-word"), check_ref("heredoc-fence"), check_ref("assert-count"), check_ref("verdict-count"), check_ref("python-line-count")], callable case_body)
