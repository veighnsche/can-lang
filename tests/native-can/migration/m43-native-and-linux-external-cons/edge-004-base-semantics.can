    asserts
        known: "edge/pg-driver-envelope" => ok [expected_check("driver-tag", "T19"), expected_check("product-name", "PostgreSQL"), expected_check("roundtrip-verbs", "create/insert/select/drop"), expected_check("env-source", "DATABASE_URL"), expected_check("bun-env", "Bun.env"), expected_check("import-word", "import"), expected_check("sql-name", "{ SQL }"), expected_check("bun-name", "bun"), expected_check("helper-name", "staticTemplate"), expected_check("template-word", "TemplateStringsArray"), expected_check("freeze-word", "Object.freeze"), expected_check("new-pool", "new SQL"), expected_check("guard-word", "required"), expected_check("disposable-word", "disposable"), expected_check("sidecar-word", "sidecar"), expected_check("image-pin", "postgres:17"), expected_check("header-comment-count", "5"), expected_check("env-name-count", "3"), expected_check("sql-call-count", "6")]
