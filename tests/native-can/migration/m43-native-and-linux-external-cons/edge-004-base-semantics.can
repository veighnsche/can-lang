        seed_driver_tag: "seed-driver-tag-drift" => ok observation("T19_2", "PostgreSQL", "create/insert/select/drop", "DATABASE_URL", "Bun.env", "import", "{ SQL }", "bun", "staticTemplate", "TemplateStringsArray", "Object.freeze", "new SQL", "required", "disposable", "sidecar", "postgres:17", 5, 3, 6)
