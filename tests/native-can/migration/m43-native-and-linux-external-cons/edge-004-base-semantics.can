    match case is "edge/pg-driver-envelope"
        false => ok []
        true => ok [expected_check("driver-tag", "T19"), expected_check("product-name", "PostgreSQL"), expected_check("roundtrip-verbs", "create/insert/select/drop"), expected_check("env-source", "DATABASE_URL"), expected_check("bun-env", "Bun.env"), expected_check("import-word", "import"), expected_check("sql-name", "{ SQL }"), expected_check("bun-name", "bun"), expected_check("helper-name", "staticTemplate"), expected_check("template-word", "TemplateStringsArray"), expected_check("freeze-word", "Object.freeze"), expected_check("new-pool", "new SQL"), expected_check("guard-word", "required"), expected_check("disposable-word", "disposable"), expected_check("sidecar-word", "sidecar"), expected_check("image-pin", "postgres:17"), expected_check("header-comment-count", "5"), expected_check("env-name-count", "3"), expected_check("sql-call-count", "6")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/pg-driver-envelope", "default", "", "offline") => ok
        seed_driver_tag: context("edge/pg-driver-envelope", "seed-driver-tag-drift", "", "offline") => failed{"driver-tag"}
        seed_product_name: context("edge/pg-driver-envelope", "seed-product-name-drift", "", "offline") => failed{"product-name"}
        seed_roundtrip_verbs: context("edge/pg-driver-envelope", "seed-roundtrip-verbs-drift", "", "offline") => failed{"roundtrip-verbs"}
        seed_env_source: context("edge/pg-driver-envelope", "seed-env-source-drift", "", "offline") => failed{"env-source"}
        seed_bun_env: context("edge/pg-driver-envelope", "seed-bun-env-drift", "", "offline") => failed{"bun-env"}
        seed_import_word: context("edge/pg-driver-envelope", "seed-import-word-drift", "", "offline") => failed{"import-word"}
        seed_sql_name: context("edge/pg-driver-envelope", "seed-sql-name-drift", "", "offline") => failed{"sql-name"}
