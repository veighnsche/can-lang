package m43edge004base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

///M43 EDGE-004 "native PostgreSQL
///roundtrip"
///migrate row pact.
///Source:
///distribution/linux/smoke/pg-driver.ts
///symbol "native PostgreSQL roundtrip"
///(L1-16): pinned header plus import
///plus helper plus env plus pool
///creation.
///Disposition: migrate (this row owns
///Can scenarios as reviewable Can
///facts; no caller file changes here;
///pg-driver.ts stays until the
///integrator rewires it after each
///linked row plus gate has accepted
///proof).
///Protects (this file): direct native
///create/insert/select/drop, PostgreSQL
///version, row count/content and pool
///closure, envelope leg: header plus
///import plus helper plus env plus pool
///creation.
///ADAPTATION (noted, plus source
///lines): name pins hold import plus
///helper spellings; word pins hold
///header plus guard bytes; count pins
///hold ints tallied from L1 plus L2
///plus L3 plus L4 plus L5 plus L14 plus
///L15 plus L18 plus L21 plus L22 plus
///L23 plus L24 plus L26.
///driver-tag pins T19 (L1);
///product-name pins PostgreSQL (L1 plus
///L20); roundtrip-verbs pins
///create/insert/select/drop (L1);
///env-source pins DATABASE_URL (L2 plus
///L14 plus L15); bun-env pins Bun.env
///(L14); import-word pins import (L6);
///sql-name pins { SQL } (L6); bun-name
///pins bun (L6); helper-name pins
///staticTemplate (L8 plus L18 plus L21
///plus L22 plus L23 plus L24 plus L26);
///template-word pins
///TemplateStringsArray (L8 plus L10);
///freeze-word pins Object.freeze (L10
///twice); new-pool pins new SQL (L16);
///guard-word pins required (L15);
///disposable-word pins disposable (L4);
///sidecar-word pins sidecar (L2);
///image-pin pins postgres:17 (L4);
///header-comment-count pins 5 (L1 plus
///L2 plus L3 plus L4 plus L5);
///env-name-count pins 3 (L2 plus L14
///plus L15); sql-call-count pins 6 (L18
///plus L21 plus L22 plus L23 plus L24
///plus L26).
///Facet map (pin order): driver-tag,
///product-name, roundtrip-verbs,
///env-source, bun-env, import-word,
///sql-name, bun-name, helper-name,
///template-word, freeze-word, new-pool,
///guard-word, disposable-word,
///sidecar-word, image-pin,
///header-comment-count, env-name-count,
///sql-call-count.
///The roundtrip statements leg lives in
///edge-004-roots-green.can; the report
///plus closure leg lives in
///edge-004-run-shape.can.
///Variants: none (row lists zero
///variants).
///Environment: zero gates; bind at P23
///plus QD1; no live run now.
///Logical gates SUITE plus DB bind at
///P23 plus QD1; no live run now.
///Timeout 120000ms is the offline
///default bound (binds at P23 like the
///M31 no-run rows).
///Delegated oracles: none.
///Execution credit: NOT claimed (P23
///plus QD1 accept gates unmet).
///Intended live report: none yet
///(migrate owns fresh scenarios; binds
///at P23 plus QD1).
///Migration stays open; pg-driver.ts
///plus postgres.sh plus the Go caller
///intact; no call retired.
///Shared old files intact; retirement
///is a later integrator choice; Z03
///owns activation; Z02 owns retirement.
///Case edge/pg-driver-envelope checks:
///driver-tag, product-name,
///roundtrip-verbs, env-source, bun-env,
///import-word, sql-name, bun-name,
///helper-name, template-word,
///freeze-word, new-pool, guard-word,
///disposable-word, sidecar-word,
///image-pin, header-comment-count,
///env-name-count, sql-call-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str driver_tag
    str product_name
    str roundtrip_verbs
    str env_source
    str bun_env
    str import_word
    str sql_name
    str bun_name
    str helper_name
    str template_word
    str freeze_word
    str new_pool
    str guard_word
    str disposable_word
    str sidecar_word
    str image_pin
    int header_comment_count
    int env_name_count
    int sql_call_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/pg-driver-envelope", "default", "", "offline"), "driver-tag" => ok "case edge/pg-driver-envelope variant default root driver-tag run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/pg-driver-envelope", "default", "", "offline"), "driver-tag" => ok evidence("driver-tag", "true", "true", true, "case edge/pg-driver-envelope variant default root driver-tag run offline")
        different: false, true, context("edge/pg-driver-envelope", "default", "", "offline"), "driver-tag" => failed{"driver-tag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("edge/pg-driver-envelope", "default", "", "offline"), "header-comment-count" => ok evidence("header-comment-count", "5", "5", true, "case edge/pg-driver-envelope variant default root header-comment-count run offline")
        different: 4, 5, context("edge/pg-driver-envelope", "default", "", "offline"), "header-comment-count" => failed{"header-comment-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "T19", "T19", context("edge/pg-driver-envelope", "default", "", "offline"), "driver-tag" => ok evidence("driver-tag", "T19", "T19", true, "case edge/pg-driver-envelope variant default root driver-tag run offline")
        different: "T19_2", "T19", context("edge/pg-driver-envelope", "default", "", "offline"), "driver-tag" => failed{"driver-tag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
