fn check[] checks
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e004" => ok [check("driver-tag", "driver tag keeps its bytes"), check("product-name", "product name keeps its spelling"), check("roundtrip-verbs", "roundtrip verbs keep their bytes"), check("env-source", "env source keeps its spelling"), check("bun-env", "bun env keeps its spelling"), check("import-word", "import word keeps its bytes"), check("sql-name", "sql name keeps its spelling"), check("bun-name", "bun name keeps its spelling"), check("helper-name", "helper name keeps its spelling"), check("template-word", "template word keeps its spelling"), check("freeze-word", "freeze word keeps its spelling"), check("new-pool", "new pool keeps its bytes"), check("guard-word", "guard word keeps its bytes"), check("disposable-word", "disposable word keeps its bytes"), check("sidecar-word", "sidecar word keeps its bytes"), check("image-pin", "image pin keeps its bytes"), check("header-comment-count", "five header comments exist"), check("env-name-count", "three env names exist"), check("sql-call-count", "six sql calls exist")]
        other: "nope" => ok []
    match scope is "m43-e004"
        false => ok []
        true => ok [check("driver-tag", "driver tag keeps its bytes"), check("product-name", "product name keeps its spelling"), check("roundtrip-verbs", "roundtrip verbs keep their bytes"), check("env-source", "env source keeps its spelling"), check("bun-env", "bun env keeps its spelling"), check("import-word", "import word keeps its bytes"), check("sql-name", "sql name keeps its spelling"), check("bun-name", "bun name keeps its spelling"), check("helper-name", "helper name keeps its spelling"), check("template-word", "template word keeps its spelling"), check("freeze-word", "freeze word keeps its spelling"), check("new-pool", "new pool keeps its bytes"), check("guard-word", "guard word keeps its bytes"), check("disposable-word", "disposable word keeps its bytes"), check("sidecar-word", "sidecar word keeps its bytes"), check("image-pin", "image pin keeps its bytes"), check("header-comment-count", "five header comments exist"), check("env-name-count", "three env names exist"), check("sql-call-count", "six sql calls exist")]
