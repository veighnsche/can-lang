package m43edge004roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

///M43 EDGE-004 "native PostgreSQL
///roundtrip"
///migrate row pact.
///Source:
///distribution/linux/smoke/pg-driver.ts
///symbol "native PostgreSQL roundtrip"
///(L18-26): pinned version gate plus
///create plus insert plus select plus
///drops plus row wants.
///Disposition: migrate (this row owns
///Can scenarios as reviewable Can
///facts; no caller file changes here;
///pg-driver.ts stays until the
///integrator rewires it after each
///linked row plus gate has accepted
///proof).
///Protects (this file): direct native
///create/insert/select/drop, PostgreSQL
///version, row count/content and pool
///closure, statements leg: version gate
///plus roundtrip statements plus row
///wants.
///ADAPTATION (noted, plus source
///lines): stmt pins hold full statement
///bytes; want pins hold refused-drift
///bytes; name pins hold table plus
///column spellings; count pins hold
///ints tallied from L21 plus L22 plus
///L23 plus L24 plus L25 plus L26.
///show-stmt pins SHOW server_version
///(L18); version-field pins
///server_version (L18 plus L19 twice);
///prefix-check pins startsWith (L20);
///major-want pins 17. (L20);
///version-guard pins requires
///PostgreSQL 17, saw plus one blank
///(L20); drop-probe pins DROP TABLE IF
///EXISTS t19_smoke (L21); create-prefix
///pins CREATE TABLE t19_smoke (id
///BIGINT PRIMARY KEY, body plus blank
///(L22); not-null-suffix pins blank
///plus NOT NULL plus close-paren (L22);
///four column-type bytes between the
///prefix plus the suffix stay unpinned
///(SRIL vocab cannot spell them);
///table-name pins t19_smoke (L21 plus
///L22 plus L23 plus L24 plus L26);
///insert-stmt pins INSERT INTO
///t19_smoke (id, body) VALUES (7,
///'remember') (L23); select-stmt pins
///SELECT id, body FROM t19_smoke WHERE
///id = 7 (L24); id-body-pair pins id,
///body (L23 plus L24); body-want pins
///remember (L23 plus L25); missing-word
///pins roundtrip row missing (L25);
///drop-stmt pins DROP TABLE t19_smoke
///(L26); id-want pins 7 (L23 plus L24);
///row-count-want pins 1 (L25);
///drop-count pins 2 (L21 plus L26);
///table-mention-count pins 5 (L21 plus
///L22 plus L23 plus L24 plus L26).
///Facet map (pin order): show-stmt,
///version-field, prefix-check,
///major-want, version-guard,
///drop-probe, create-prefix,
///not-null-suffix, table-name,
///insert-stmt, select-stmt,
///id-body-pair, body-want,
///missing-word, drop-stmt, id-want,
///row-count-want, drop-count,
///table-mention-count.
///The header plus env leg lives in
///edge-004-base-semantics.can; the
///report plus closure leg lives in
///edge-004-run-shape.can.
///Variants: none (row lists zero
///variants).
///Environment: zero gates; bind at P23
///plus QD1; no live run now.
///Logical gates SUITE plus DB bind at
///P23 plus QD1; no live run now.
///Timeout 120000ms is the offline
///default bound (binds at P23 like the
///M31 no-run rows).
///Delegated oracles: none.
///Execution credit: NOT claimed (P23
///plus QD1 accept gates unmet).
///Intended live report: none yet
///(migrate owns fresh scenarios; binds
///at P23 plus QD1).
///Migration stays open; pg-driver.ts
///plus postgres.sh plus the Go caller
///intact; no call retired.
///Shared old files intact; retirement
///is a later integrator choice; Z03
///owns activation; Z02 owns retirement.
///Case edge/pg-roundtrip-statements
///checks: show-stmt, version-field,
///prefix-check, major-want,
///version-guard, drop-probe,
///create-prefix, not-null-suffix,
///table-name, insert-stmt, select-stmt,
///id-body-pair, body-want,
///missing-word, drop-stmt, id-want,
///row-count-want, drop-count,
///table-mention-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str show_stmt
    str version_field
    str prefix_check
    str major_want
    str version_guard
    str drop_probe
    str create_prefix
    str not_null_suffix
    str table_name
    str insert_stmt
    str select_stmt
    str id_body_pair
    str body_want
    str missing_word
    str drop_stmt
    int id_want
    int row_count_want
    int drop_count
    int table_mention_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/pg-roundtrip-statements", "default", "", "offline"), "show-stmt" => ok "case edge/pg-roundtrip-statements variant default root show-stmt run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/pg-roundtrip-statements", "default", "", "offline"), "show-stmt" => ok evidence("show-stmt", "true", "true", true, "case edge/pg-roundtrip-statements variant default root show-stmt run offline")
        different: false, true, context("edge/pg-roundtrip-statements", "default", "", "offline"), "show-stmt" => failed{"show-stmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 7, 7, context("edge/pg-roundtrip-statements", "default", "", "offline"), "id-want" => ok evidence("id-want", "7", "7", true, "case edge/pg-roundtrip-statements variant default root id-want run offline")
        different: 6, 7, context("edge/pg-roundtrip-statements", "default", "", "offline"), "id-want" => failed{"id-want"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "SHOW server_version", "SHOW server_version", context("edge/pg-roundtrip-statements", "default", "", "offline"), "show-stmt" => ok evidence("show-stmt", "SHOW server_version", "SHOW server_version", true, "case edge/pg-roundtrip-statements variant default root show-stmt run offline")
        different: "SHOW server_version_2", "SHOW server_version", context("edge/pg-roundtrip-statements", "default", "", "offline"), "show-stmt" => failed{"show-stmt"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("SHOW server_version", "server_version", "startsWith", "17.", "requires PostgreSQL 17, saw ", "DROP TABLE IF EXISTS t19_smoke", "CREATE TABLE t19_smoke (id BIGINT PRIMARY KEY, body ", " NOT NULL)", "t19_smoke", "INSERT INTO t19_smoke (id, body) VALUES (7, 'remember')", "SELECT id, body FROM t19_smoke WHERE id = 7", "id, body", "remember", "roundtrip row missing", "DROP TABLE t19_smoke", 7, 1, 2, 5)
        seed_show_stmt: "seed-show-stmt-drift" => ok observation("SHOW server_version_2", "server_version", "startsWith", "17.", "requires PostgreSQL 17, saw ", "DROP TABLE IF EXISTS t19_smoke", "CREATE TABLE t19_smoke (id BIGINT PRIMARY KEY, body ", " NOT NULL)", "t19_smoke", "INSERT INTO t19_smoke (id, body) VALUES (7, 'remember')", "SELECT id, body FROM t19_smoke WHERE id = 7", "id, body", "remember", "roundtrip row missing", "DROP TABLE t19_smoke", 7, 1, 2, 5)
        seed_version_field: "seed-version-field-drift" => ok observation("SHOW server_version", "server_version_2", "startsWith", "17.", "requires PostgreSQL 17, saw ", "DROP TABLE IF EXISTS t19_smoke", "CREATE TABLE t19_smoke (id BIGINT PRIMARY KEY, body ", " NOT NULL)", "t19_smoke", "INSERT INTO t19_smoke (id, body) VALUES (7, 'remember')", "SELECT id, body FROM t19_smoke WHERE id = 7", "id, body", "remember", "roundtrip row missing", "DROP TABLE t19_smoke", 7, 1, 2, 5)
        seed_prefix_check: "seed-prefix-check-drift" => ok observation("SHOW server_version", "server_version", "startsWith_2", "17.", "requires PostgreSQL 17, saw ", "DROP TABLE IF EXISTS t19_smoke", "CREATE TABLE t19_smoke (id BIGINT PRIMARY KEY, body ", " NOT NULL)", "t19_smoke", "INSERT INTO t19_smoke (id, body) VALUES (7, 'remember')", "SELECT id, body FROM t19_smoke WHERE id = 7", "id, body", "remember", "roundtrip row missing", "DROP TABLE t19_smoke", 7, 1, 2, 5)
        seed_major_want: "seed-major-want-drift" => ok observation("SHOW server_version", "server_version", "startsWith", "17._2", "requires PostgreSQL 17, saw ", "DROP TABLE IF EXISTS t19_smoke", "CREATE TABLE t19_smoke (id BIGINT PRIMARY KEY, body ", " NOT NULL)", "t19_smoke", "INSERT INTO t19_smoke (id, body) VALUES (7, 'remember')", "SELECT id, body FROM t19_smoke WHERE id = 7", "id, body", "remember", "roundtrip row missing", "DROP TABLE t19_smoke", 7, 1, 2, 5)
