package m43edge004run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

///M43 EDGE-004 "native PostgreSQL
///roundtrip"
///migrate row pact.
///Source:
///distribution/linux/smoke/pg-driver.ts
///symbol "native PostgreSQL roundtrip"
///(L27-34): pinned report keys plus
///pool closure plus failure shape.
///Disposition: migrate (this row owns
///Can scenarios as reviewable Can
///facts; no caller file changes here;
///pg-driver.ts stays until the
///integrator rewires it after each
///linked row plus gate has accepted
///proof).
///Protects (this file): direct native
///create/insert/select/drop, PostgreSQL
///version, row count/content and pool
///closure, report leg: report keys plus
///pool closure plus failure shape.
///ADAPTATION (noted, plus source
///lines): call pins hold console plus
///close plus exit spellings; key pins
///hold report bytes; word pins hold
///guard bytes; count pins hold ints
///tallied from L15 plus L18 plus L20
///plus L21 plus L22 plus L23 plus L24
///plus L25 plus L26 plus L27 plus L29
///plus L32 plus L33.
///report-call pins console.log (L27);
///report-keys pins serverVersion, id:
///(L27); id-string pins
///String(rows[0].id) (L27); rows-word
///pins rows[0] (L25 plus L27 twice);
///rows-length pins rows.length (L25);
///close-call pins sql.close (L29);
///finally-word pins finally (L28);
///try-open pins try plus brace-open
///(L13 plus L17); await-word pins await
///(L18 plus L21 plus L22 plus L23 plus
///L24 plus L26 plus L29); catch-word
///pins catch (L31); error-call pins
///console.error (L32); exit-call pins
///process.exit (L33); error-name pins
///Error (L15 plus L20 plus L25 plus
///L32); exit-code-want pins 1 (L33);
///await-count pins 7 (L18 plus L21 plus
///L22 plus L23 plus L24 plus L26 plus
///L29); error-count pins 4 (L15 plus
///L20 plus L25 plus L32); console-count
///pins 2 (L27 plus L32).
///Facet map (pin order): report-call,
///report-keys, id-string, rows-word,
///rows-length, close-call,
///finally-word, try-open, await-word,
///catch-word, error-call, exit-call,
///error-name, exit-code-want,
///await-count, error-count,
///console-count.
///The header plus env leg lives in
///edge-004-base-semantics.can; the
///roundtrip statements leg lives in
///edge-004-roots-green.can.
///Variants: none (row lists zero
///variants).
///Environment: zero gates; bind at P23
///plus QD1; no live run now.
///Logical gates SUITE plus DB bind at
///P23 plus QD1; no live run now.
///Timeout 120000ms is the offline
///default bound (binds at P23 like the
///M31 no-run rows).
///Delegated oracles: none.
///Execution credit: NOT claimed (P23
///plus QD1 accept gates unmet).
///Intended live report: none yet
///(migrate owns fresh scenarios; binds
///at P23 plus QD1).
///Migration stays open; pg-driver.ts
///plus postgres.sh plus the Go caller
///intact; no call retired.
///Shared old files intact; retirement
///is a later integrator choice; Z03
///owns activation; Z02 owns retirement.
///Case edge/pg-report-closure checks:
///report-call, report-keys, id-string,
///rows-word, rows-length, close-call,
///finally-word, try-open, await-word,
///catch-word, error-call, exit-call,
///error-name, exit-code-want,
///await-count, error-count,
///console-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str report_call
    str report_keys
    str id_string
    str rows_word
    str rows_length
    str close_call
    str finally_word
    str try_open
    str await_word
    str catch_word
    str error_call
    str exit_call
    str error_name
    int exit_code_want
    int await_count
    int error_count
    int console_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/pg-report-closure", "default", "", "offline"), "report-call" => ok "case edge/pg-report-closure variant default root report-call run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/pg-report-closure", "default", "", "offline"), "report-call" => ok evidence("report-call", "true", "true", true, "case edge/pg-report-closure variant default root report-call run offline")
        different: false, true, context("edge/pg-report-closure", "default", "", "offline"), "report-call" => failed{"report-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 1, 1, context("edge/pg-report-closure", "default", "", "offline"), "exit-code-want" => ok evidence("exit-code-want", "1", "1", true, "case edge/pg-report-closure variant default root exit-code-want run offline")
        different: 0, 1, context("edge/pg-report-closure", "default", "", "offline"), "exit-code-want" => failed{"exit-code-want"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "console.log", "console.log", context("edge/pg-report-closure", "default", "", "offline"), "report-call" => ok evidence("report-call", "console.log", "console.log", true, "case edge/pg-report-closure variant default root report-call run offline")
        different: "console.log_2", "console.log", context("edge/pg-report-closure", "default", "", "offline"), "report-call" => failed{"report-call"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("console.log", "serverVersion, id:", "String(rows[0].id)", "rows[0]", "rows.length", "sql.close", "finally", "try {", "await", "catch", "console.error", "process.exit", "Error", 1, 7, 4, 2)
        seed_report_call: "seed-report-call-drift" => ok observation("console.log_2", "serverVersion, id:", "String(rows[0].id)", "rows[0]", "rows.length", "sql.close", "finally", "try {", "await", "catch", "console.error", "process.exit", "Error", 1, 7, 4, 2)
        seed_report_keys: "seed-report-keys-drift" => ok observation("console.log", "serverVersion, id:_2", "String(rows[0].id)", "rows[0]", "rows.length", "sql.close", "finally", "try {", "await", "catch", "console.error", "process.exit", "Error", 1, 7, 4, 2)
        seed_id_string: "seed-id-string-drift" => ok observation("console.log", "serverVersion, id:", "String(rows[0].id)_2", "rows[0]", "rows.length", "sql.close", "finally", "try {", "await", "catch", "console.error", "process.exit", "Error", 1, 7, 4, 2)
