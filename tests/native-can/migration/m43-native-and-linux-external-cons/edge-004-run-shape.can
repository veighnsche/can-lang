fn check[] checks
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e004" => ok [check("report-call", "report call keeps its bytes"), check("report-keys", "report keys keep their bytes"), check("id-string", "id string keeps its bytes"), check("rows-word", "rows word keeps its bytes"), check("rows-length", "rows length keeps its bytes"), check("close-call", "close call keeps its bytes"), check("finally-word", "finally word keeps its bytes"), check("try-open", "try open keeps its bytes"), check("await-word", "await word keeps its bytes"), check("catch-word", "catch word keeps its bytes"), check("error-call", "error call keeps its bytes"), check("exit-call", "exit call keeps its bytes"), check("error-name", "error name keeps its spelling"), check("exit-code-want", "exit code wants one"), check("await-count", "seven awaits exist"), check("error-count", "four errors exist"), check("console-count", "two consoles exist")]
        other: "nope" => ok []
    match scope is "m43-e004"
        false => ok []
        true => ok [check("report-call", "report call keeps its bytes"), check("report-keys", "report keys keep their bytes"), check("id-string", "id string keeps its bytes"), check("rows-word", "rows word keeps its bytes"), check("rows-length", "rows length keeps its bytes"), check("close-call", "close call keeps its bytes"), check("finally-word", "finally word keeps its bytes"), check("try-open", "try open keeps its bytes"), check("await-word", "await word keeps its bytes"), check("catch-word", "catch word keeps its bytes"), check("error-call", "error call keeps its bytes"), check("exit-call", "exit call keeps its bytes"), check("error-name", "error name keeps its spelling"), check("exit-code-want", "exit code wants one"), check("await-count", "seven awaits exist"), check("error-count", "four errors exist"), check("console-count", "two consoles exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "edge/pg-report-closure" => ok [expected_check("report-call", "console.log"), expected_check("report-keys", "serverVersion, id:"), expected_check("id-string", "String(rows[0].id)"), expected_check("rows-word", "rows[0]"), expected_check("rows-length", "rows.length"), expected_check("close-call", "sql.close"), expected_check("finally-word", "finally"), expected_check("try-open", "try {"), expected_check("await-word", "await"), expected_check("catch-word", "catch"), expected_check("error-call", "console.error"), expected_check("exit-call", "process.exit"), expected_check("error-name", "Error"), expected_check("exit-code-want", "1"), expected_check("await-count", "7"), expected_check("error-count", "4"), expected_check("console-count", "2")]
        unknown: "nope" => ok []
    match case is "edge/pg-report-closure"
        false => ok []
        true => ok [expected_check("report-call", "console.log"), expected_check("report-keys", "serverVersion, id:"), expected_check("id-string", "String(rows[0].id)"), expected_check("rows-word", "rows[0]"), expected_check("rows-length", "rows.length"), expected_check("close-call", "sql.close"), expected_check("finally-word", "finally"), expected_check("try-open", "try {"), expected_check("await-word", "await"), expected_check("catch-word", "catch"), expected_check("error-call", "console.error"), expected_check("exit-call", "process.exit"), expected_check("error-name", "Error"), expected_check("exit-code-want", "1"), expected_check("await-count", "7"), expected_check("error-count", "4"), expected_check("console-count", "2")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/pg-report-closure", "default", "", "offline") => ok
        seed_report_call: context("edge/pg-report-closure", "seed-report-call-drift", "", "offline") => failed{"report-call"}
        seed_report_keys: context("edge/pg-report-closure", "seed-report-keys-drift", "", "offline") => failed{"report-keys"}
        seed_id_string: context("edge/pg-report-closure", "seed-id-string-drift", "", "offline") => failed{"id-string"}
        seed_rows_word: context("edge/pg-report-closure", "seed-rows-word-drift", "", "offline") => failed{"rows-word"}
        seed_rows_length: context("edge/pg-report-closure", "seed-rows-length-drift", "", "offline") => failed{"rows-length"}
        seed_close_call: context("edge/pg-report-closure", "seed-close-call-drift", "", "offline") => failed{"close-call"}
        seed_finally_word: context("edge/pg-report-closure", "seed-finally-word-drift", "", "offline") => failed{"finally-word"}
        seed_try_open: context("edge/pg-report-closure", "seed-try-open-drift", "", "offline") => failed{"try-open"}
        seed_await_word: context("edge/pg-report-closure", "seed-await-word-drift", "", "offline") => failed{"await-word"}
        seed_catch_word: context("edge/pg-report-closure", "seed-catch-word-drift", "", "offline") => failed{"catch-word"}
        seed_error_call: context("edge/pg-report-closure", "seed-error-call-drift", "", "offline") => failed{"error-call"}
        seed_exit_call: context("edge/pg-report-closure", "seed-exit-call-drift", "", "offline") => failed{"exit-call"}
        seed_error_name: context("edge/pg-report-closure", "seed-error-name-drift", "", "offline") => failed{"error-name"}
        seed_exit_code_want: context("edge/pg-report-closure", "seed-exit-code-want-drift", "", "offline") => failed{"exit-code-want"}
        seed_await_count: context("edge/pg-report-closure", "seed-await-count-drift", "", "offline") => failed{"await-count"}
        seed_error_count: context("edge/pg-report-closure", "seed-error-count-drift", "", "offline") => failed{"error-count"}
        seed_console_count: context("edge/pg-report-closure", "seed-console-count-drift", "", "offline") => failed{"console-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.report_call, "console.log", c, "report-call")
            failed
            ok evidence report_call_evidence => match call require_text(got.report_keys, "serverVersion, id:", c, "report-keys")
                failed
                ok evidence report_keys_evidence => match call require_text(got.id_string, "String(rows[0].id)", c, "id-string")
                    failed
                    ok evidence id_string_evidence => match call require_text(got.rows_word, "rows[0]", c, "rows-word")
                        failed
                        ok evidence rows_word_evidence => match call require_text(got.rows_length, "rows.length", c, "rows-length")
                            failed
                            ok evidence rows_length_evidence => match call require_text(got.close_call, "sql.close", c, "close-call")
                                failed
                                ok evidence close_call_evidence => match call require_text(got.finally_word, "finally", c, "finally-word")
                                    failed
                                    ok evidence finally_word_evidence => match call require_text(got.try_open, "try {", c, "try-open")
                                        failed
                                        ok evidence try_open_evidence => match call require_text(got.await_word, "await", c, "await-word")
                                            failed
                                            ok evidence await_word_evidence => match call require_text(got.catch_word, "catch", c, "catch-word")
                                                failed
                                                ok evidence catch_word_evidence => match call require_text(got.error_call, "console.error", c, "error-call")
                                                    failed
                                                    ok evidence error_call_evidence => match call require_text(got.exit_call, "process.exit", c, "exit-call")
                                                        failed
                                                        ok evidence exit_call_evidence => match call require_text(got.error_name, "Error", c, "error-name")
                                                            failed
                                                            ok evidence error_name_evidence => match call require_int(got.exit_code_want, 1, c, "exit-code-want")
                                                                failed
                                                                ok evidence exit_code_want_evidence => match call require_int(got.await_count, 7, c, "await-count")
                                                                    failed
                                                                    ok evidence await_count_evidence => match call require_int(got.error_count, 4, c, "error-count")
                                                                        failed
                                                                        ok evidence error_count_evidence => match call require_int(got.console_count, 2, c, "console-count")
                                                                            failed
                                                                            ok evidence console_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
