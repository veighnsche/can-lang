package m43edge005base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-005 "native SQLite seed"
/// migrate slice pact.
/// Source: distribution/linux/smoke/sqlite-seed.ts
/// symbol "native SQLite seed" (L1-10):
/// pinned shell header plus import
/// plus helper shape.
/// Disposition: migrate slice only (this
/// row owns the seed pact as reviewable
/// Can facts; no seed file changes
/// here; old driver call stays until the
/// integrator rewires it after each
/// linked row plus gate has accepted
/// proof).
/// Protects (this file): native
/// insertion plus readback plus pool
/// closure wants, envelope leg:
/// header words plus import plus helper.
/// ADAPTATION (noted, plus source
/// lines): name pins hold spellings;
/// word pins hold header bytes; count
/// pins hold ints tallied from L1 plus
/// L2 plus L3 plus L4 plus L9.
/// smoke-tag pins T19 (L1);
/// smoke-word pins smoke-only (L1);
/// seed-helper pins seed helper (L1);
/// insert-word pins Inserts (L1);
/// rename-word pins renames (L2);
/// sidecar-word pins sidecar (L3);
/// driver-word pins driver (L4);
/// import-word pins import (L5);
/// sql-name pins SQL (L3 plus L5 plus L15);
/// bun-name pins bun (L5);
/// function-word pins function (L7);
/// helper-name pins staticTemplate (L7 plus L17 plus L18);
/// header-comment-count pins 4 (L1 plus L2 plus L3 plus L4);
/// freeze-call-count pins 2 (L9 twice).
/// Facet map (pin order): smoke-tag,
/// smoke-word, seed-helper,
/// insert-word, rename-word,
/// sidecar-word, driver-word,
/// import-word, sql-name,
/// bun-name, function-word,
/// helper-name,
/// header-comment-count,
/// freeze-call-count.
/// The provision plus insertion roots live in
/// edge-005-roots-green.can; the
/// readback plus verdict plus close shape
/// lives in edge-005-run-shape.can.
/// Helper first param bytes live in L7 plus L8;
/// not pinned as values to keep the fence.
/// Variants: none (row lists zero
/// variants).
/// Environment: zero gates; bind at P23
/// plus QD1; no live run now.
/// Logical gates SUITE plus WORK plus
/// DB plus NATIVE bind at P23
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like the
/// M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Intended consumed report: M26
/// HISTORY-010 plus HISTORY-016 parsed slices (no qualified
/// report yet; P23 plus QD1
/// unmet).
/// Caller stays as is; sqlite-seed.ts
/// plus smoke.sh plus the Go caller
/// intact; no call retired.
/// Shared old files intact; retirement
/// is a later integrator choice; Z03
/// owns activation.
/// Case edge/sqlite-provision checks:
/// smoke-tag, smoke-word, seed-helper,
/// insert-word, rename-word,
/// sidecar-word, driver-word,
/// import-word, sql-name,
/// bun-name, function-word,
/// helper-name,
/// header-comment-count,
/// freeze-call-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str smoke_tag
    str smoke_word
    str seed_helper
    str insert_word
    str rename_word
    str sidecar_word
    str driver_word
    str import_word
    str sql_name
    str bun_name
    str function_word
    str helper_name
    int header_comment_count
    int freeze_call_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/sqlite-provision", "default", "", "offline"), "smoke-tag" => ok "case edge/sqlite-provision variant default root smoke-tag run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/sqlite-provision", "default", "", "offline"), "smoke-tag" => ok evidence("smoke-tag", "true", "true", true, "case edge/sqlite-provision variant default root smoke-tag run offline")
        different: false, true, context("edge/sqlite-provision", "default", "", "offline"), "smoke-tag" => failed{"smoke-tag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("edge/sqlite-provision", "default", "", "offline"), "header-comment-count" => ok evidence("header-comment-count", "4", "4", true, "case edge/sqlite-provision variant default root header-comment-count run offline")
        different: 3, 4, context("edge/sqlite-provision", "default", "", "offline"), "header-comment-count" => failed{"header-comment-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "T19", "T19", context("edge/sqlite-provision", "default", "", "offline"), "smoke-tag" => ok evidence("smoke-tag", "T19", "T19", true, "case edge/sqlite-provision variant default root smoke-tag run offline")
        different: "T19_2", "T19", context("edge/sqlite-provision", "default", "", "offline"), "smoke-tag" => failed{"smoke-tag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_smoke_tag: "seed-smoke-tag-drift" => ok observation("T19_2", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_smoke_word: "seed-smoke-word-drift" => ok observation("T19", "smoke-only_2", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_seed_helper: "seed-seed-helper-drift" => ok observation("T19", "smoke-only", "seed helper_2", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_insert_word: "seed-insert-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts_2", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_rename_word: "seed-rename-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames_2", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_sidecar_word: "seed-sidecar-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar_2", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_driver_word: "seed-driver-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver_2", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_import_word: "seed-import-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import_2", "SQL", "bun", "function", "staticTemplate", 4, 2)
        seed_sql_name: "seed-sql-name-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL_2", "bun", "function", "staticTemplate", 4, 2)
        seed_bun_name: "seed-bun-name-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun_2", "function", "staticTemplate", 4, 2)
        seed_function_word: "seed-function-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function_2", "staticTemplate", 4, 2)
        seed_helper_name: "seed-helper-name-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate_2", 4, 2)
        seed_header_comment_count: "seed-header-comment-count-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 3, 2)
        seed_freeze_call_count: "seed-freeze-call-count-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 1)
    match variant_id
        "seed-smoke-tag-drift" => ok observation("T19_2", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-smoke-word-drift" => ok observation("T19", "smoke-only_2", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-seed-helper-drift" => ok observation("T19", "smoke-only", "seed helper_2", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-insert-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts_2", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-rename-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames_2", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-sidecar-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar_2", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-driver-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver_2", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-import-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import_2", "SQL", "bun", "function", "staticTemplate", 4, 2)
        "seed-sql-name-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL_2", "bun", "function", "staticTemplate", 4, 2)
        "seed-bun-name-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun_2", "function", "staticTemplate", 4, 2)
        "seed-function-word-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function_2", "staticTemplate", 4, 2)
        "seed-helper-name-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate_2", 4, 2)
        "seed-header-comment-count-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 3, 2)
        "seed-freeze-call-count-drift" => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 1)
        _ => ok observation("T19", "smoke-only", "seed helper", "Inserts", "renames", "sidecar", "driver", "import", "SQL", "bun", "function", "staticTemplate", 4, 2)
fn check[] checks
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e005" => ok [check("smoke-tag", "smoke tag keeps its bytes"), check("smoke-word", "smoke word keeps its bytes"), check("seed-helper", "seed helper keeps its bytes"), check("insert-word", "insert word keeps its spelling"), check("rename-word", "rename word keeps its bytes"), check("sidecar-word", "sidecar word keeps its bytes"), check("driver-word", "driver word keeps its bytes"), check("import-word", "import word keeps its bytes"), check("sql-name", "sql name keeps its spelling"), check("bun-name", "bun name keeps its spelling"), check("function-word", "function word keeps its bytes"), check("helper-name", "helper name keeps its spelling"), check("header-comment-count", "four header comments exist"), check("freeze-call-count", "two freeze calls exist")]
        other: "nope" => ok []
    match scope is "m43-e005"
        false => ok []
        true => ok [check("smoke-tag", "smoke tag keeps its bytes"), check("smoke-word", "smoke word keeps its bytes"), check("seed-helper", "seed helper keeps its bytes"), check("insert-word", "insert word keeps its spelling"), check("rename-word", "rename word keeps its bytes"), check("sidecar-word", "sidecar word keeps its bytes"), check("driver-word", "driver word keeps its bytes"), check("import-word", "import word keeps its bytes"), check("sql-name", "sql name keeps its spelling"), check("bun-name", "bun name keeps its spelling"), check("function-word", "function word keeps its bytes"), check("helper-name", "helper name keeps its spelling"), check("header-comment-count", "four header comments exist"), check("freeze-call-count", "two freeze calls exist")]
fn expected_check[] expected_vector
    emits {}
    given
        str case
    asserts
        known: "edge/sqlite-provision" => ok [expected_check("smoke-tag", "T19"), expected_check("smoke-word", "smoke-only"), expected_check("seed-helper", "seed helper"), expected_check("insert-word", "Inserts"), expected_check("rename-word", "renames"), expected_check("sidecar-word", "sidecar"), expected_check("driver-word", "driver"), expected_check("import-word", "import"), expected_check("sql-name", "SQL"), expected_check("bun-name", "bun"), expected_check("function-word", "function"), expected_check("helper-name", "staticTemplate"), expected_check("header-comment-count", "4"), expected_check("freeze-call-count", "2")]
        unknown: "nope" => ok []
    match case is "edge/sqlite-provision"
        false => ok []
        true => ok [expected_check("smoke-tag", "T19"), expected_check("smoke-word", "smoke-only"), expected_check("seed-helper", "seed helper"), expected_check("insert-word", "Inserts"), expected_check("rename-word", "renames"), expected_check("sidecar-word", "sidecar"), expected_check("driver-word", "driver"), expected_check("import-word", "import"), expected_check("sql-name", "SQL"), expected_check("bun-name", "bun"), expected_check("function-word", "function"), expected_check("helper-name", "staticTemplate"), expected_check("header-comment-count", "4"), expected_check("freeze-call-count", "2")]
fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/sqlite-provision", "default", "", "offline") => ok
        seed_smoke_tag: context("edge/sqlite-provision", "seed-smoke-tag-drift", "", "offline") => failed{"smoke-tag"}
        seed_smoke_word: context("edge/sqlite-provision", "seed-smoke-word-drift", "", "offline") => failed{"smoke-word"}
        seed_seed_helper: context("edge/sqlite-provision", "seed-seed-helper-drift", "", "offline") => failed{"seed-helper"}
        seed_insert_word: context("edge/sqlite-provision", "seed-insert-word-drift", "", "offline") => failed{"insert-word"}
        seed_rename_word: context("edge/sqlite-provision", "seed-rename-word-drift", "", "offline") => failed{"rename-word"}
        seed_sidecar_word: context("edge/sqlite-provision", "seed-sidecar-word-drift", "", "offline") => failed{"sidecar-word"}
        seed_driver_word: context("edge/sqlite-provision", "seed-driver-word-drift", "", "offline") => failed{"driver-word"}
        seed_import_word: context("edge/sqlite-provision", "seed-import-word-drift", "", "offline") => failed{"import-word"}
        seed_sql_name: context("edge/sqlite-provision", "seed-sql-name-drift", "", "offline") => failed{"sql-name"}
        seed_bun_name: context("edge/sqlite-provision", "seed-bun-name-drift", "", "offline") => failed{"bun-name"}
        seed_function_word: context("edge/sqlite-provision", "seed-function-word-drift", "", "offline") => failed{"function-word"}
        seed_helper_name: context("edge/sqlite-provision", "seed-helper-name-drift", "", "offline") => failed{"helper-name"}
        seed_header_comment_count: context("edge/sqlite-provision", "seed-header-comment-count-drift", "", "offline") => failed{"header-comment-count"}
        seed_freeze_call_count: context("edge/sqlite-provision", "seed-freeze-call-count-drift", "", "offline") => failed{"freeze-call-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.smoke_tag, "T19", c, "smoke-tag")
            failed
            ok evidence smoke_tag_evidence => match call require_text(got.smoke_word, "smoke-only", c, "smoke-word")
                failed
                ok evidence smoke_word_evidence => match call require_text(got.seed_helper, "seed helper", c, "seed-helper")
                    failed
                    ok evidence seed_helper_evidence => match call require_text(got.insert_word, "Inserts", c, "insert-word")
                        failed
                        ok evidence insert_word_evidence => match call require_text(got.rename_word, "renames", c, "rename-word")
                            failed
                            ok evidence rename_word_evidence => match call require_text(got.sidecar_word, "sidecar", c, "sidecar-word")
                                failed
                                ok evidence sidecar_word_evidence => match call require_text(got.driver_word, "driver", c, "driver-word")
                                    failed
                                    ok evidence driver_word_evidence => match call require_text(got.import_word, "import", c, "import-word")
                                        failed
                                        ok evidence import_word_evidence => match call require_text(got.sql_name, "SQL", c, "sql-name")
                                            failed
                                            ok evidence sql_name_evidence => match call require_text(got.bun_name, "bun", c, "bun-name")
                                                failed
                                                ok evidence bun_name_evidence => match call require_text(got.function_word, "function", c, "function-word")
                                                    failed
                                                    ok evidence function_word_evidence => match call require_text(got.helper_name, "staticTemplate", c, "helper-name")
                                                        failed
                                                        ok evidence helper_name_evidence => match call require_int(got.header_comment_count, 4, c, "header-comment-count")
                                                            failed
                                                            ok evidence header_comment_count_evidence => match call require_int(got.freeze_call_count, 2, c, "freeze-call-count")
                                                                failed
                                                                ok evidence freeze_call_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e005" => ok test_case("edge/sqlite-provision", ["edge", "m43"], [], 120000, [check_ref("smoke-tag"), check_ref("smoke-word"), check_ref("seed-helper"), check_ref("insert-word"), check_ref("rename-word"), check_ref("sidecar-word"), check_ref("driver-word"), check_ref("import-word"), check_ref("sql-name"), check_ref("bun-name"), check_ref("function-word"), check_ref("helper-name"), check_ref("header-comment-count"), check_ref("freeze-call-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m43-e005"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("edge/sqlite-provision", ["edge", "m43"], [], 120000, [check_ref("smoke-tag"), check_ref("smoke-word"), check_ref("seed-helper"), check_ref("insert-word"), check_ref("rename-word"), check_ref("sidecar-word"), check_ref("driver-word"), check_ref("import-word"), check_ref("sql-name"), check_ref("bun-name"), check_ref("function-word"), check_ref("helper-name"), check_ref("header-comment-count"), check_ref("freeze-call-count")], callable case_body)
