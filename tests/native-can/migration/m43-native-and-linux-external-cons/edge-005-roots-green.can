fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/sqlite-insertion", "default", "", "offline") => ok
        seed_dbpath_name: context("edge/sqlite-insertion", "seed-dbpath-name-drift", "", "offline") => failed{"dbpath-name"}
        seed_argv_index: context("edge/sqlite-insertion", "seed-argv-index-drift", "", "offline") => failed{"argv-index"}
        seed_typeof_word: context("edge/sqlite-insertion", "seed-typeof-word-drift", "", "offline") => failed{"typeof-word"}
        seed_missing_want: context("edge/sqlite-insertion", "seed-missing-want-drift", "", "offline") => failed{"missing-want"}
        seed_adapter_name: context("edge/sqlite-insertion", "seed-adapter-name-drift", "", "offline") => failed{"adapter-name"}
        seed_sqlite_word: context("edge/sqlite-insertion", "seed-sqlite-word-drift", "", "offline") => failed{"sqlite-word"}
        seed_filename_word: context("edge/sqlite-insertion", "seed-filename-word-drift", "", "offline") => failed{"filename-word"}
        seed_safe_word: context("edge/sqlite-insertion", "seed-safe-word-drift", "", "offline") => failed{"safe-word"}
        seed_insert_statement: context("edge/sqlite-insertion", "seed-insert-statement-drift", "", "offline") => failed{"insert-statement"}
        seed_select_statement: context("edge/sqlite-insertion", "seed-select-statement-drift", "", "offline") => failed{"select-statement"}
        seed_table_name: context("edge/sqlite-insertion", "seed-table-name-drift", "", "offline") => failed{"table-name"}
        seed_row_id: context("edge/sqlite-insertion", "seed-row-id-drift", "", "offline") => failed{"row-id"}
        seed_try_block_count: context("edge/sqlite-insertion", "seed-try-block-count-drift", "", "offline") => failed{"try-block-count"}
        seed_await_sql_count: context("edge/sqlite-insertion", "seed-await-sql-count-drift", "", "offline") => failed{"await-sql-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.dbpath_name, "dbPath", c, "dbpath-name")
            failed
            ok evidence dbpath_name_evidence => match call require_text(got.argv_index, "process.argv[2]", c, "argv-index")
                failed
                ok evidence argv_index_evidence => match call require_text(got.typeof_word, "typeof", c, "typeof-word")
                    failed
                    ok evidence typeof_word_evidence => match call require_text(got.missing_want, "missing database path argument", c, "missing-want")
                        failed
                        ok evidence missing_want_evidence => match call require_text(got.adapter_name, "adapter", c, "adapter-name")
                            failed
                            ok evidence adapter_name_evidence => match call require_text(got.sqlite_word, "sqlite", c, "sqlite-word")
                                failed
                                ok evidence sqlite_word_evidence => match call require_text(got.filename_word, "filename", c, "filename-word")
                                    failed
                                    ok evidence filename_word_evidence => match call require_text(got.safe_word, "safeIntegers", c, "safe-word")
                                        failed
                                        ok evidence safe_word_evidence => match call require_text(got.insert_statement, "INSERT INTO notes (id, body) VALUES (7, 'seed')", c, "insert-statement")
                                            failed
                                            ok evidence insert_statement_evidence => match call require_text(got.select_statement, "SELECT id, body FROM notes WHERE id = 7", c, "select-statement")
                                                failed
                                                ok evidence select_statement_evidence => match call require_text(got.table_name, "notes", c, "table-name")
                                                    failed
                                                    ok evidence table_name_evidence => match call require_int(got.row_id, 7, c, "row-id")
                                                        failed
                                                        ok evidence row_id_evidence => match call require_int(got.try_block_count, 2, c, "try-block-count")
                                                            failed
                                                            ok evidence try_block_count_evidence => match call require_int(got.await_sql_count, 3, c, "await-sql-count")
                                                                failed
                                                                ok evidence await_sql_count_evidence => ok
fn test_case descriptor
    emits {}
    given
        str scope
    asserts
        edge_scope: "m43-e005" => ok test_case("edge/sqlite-insertion", ["edge", "m43"], [], 120000, [check_ref("dbpath-name"), check_ref("argv-index"), check_ref("typeof-word"), check_ref("missing-want"), check_ref("adapter-name"), check_ref("sqlite-word"), check_ref("filename-word"), check_ref("safe-word"), check_ref("insert-statement"), check_ref("select-statement"), check_ref("table-name"), check_ref("row-id"), check_ref("try-block-count"), check_ref("await-sql-count")], callable case_body)
        other: "nope" => ok test_case("", [], [], 0, [], callable case_body)
    match scope is "m43-e005"
        false => ok test_case("", [], [], 0, [], callable case_body)
        true => ok test_case("edge/sqlite-insertion", ["edge", "m43"], [], 120000, [check_ref("dbpath-name"), check_ref("argv-index"), check_ref("typeof-word"), check_ref("missing-want"), check_ref("adapter-name"), check_ref("sqlite-word"), check_ref("filename-word"), check_ref("safe-word"), check_ref("insert-statement"), check_ref("select-statement"), check_ref("table-name"), check_ref("row-id"), check_ref("try-block-count"), check_ref("await-sql-count")], callable case_body)
