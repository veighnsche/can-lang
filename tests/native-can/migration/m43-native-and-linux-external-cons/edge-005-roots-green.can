package m43edge005roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M43 EDGE-005 "native SQLite seed"
/// migrate slice pact.
/// Source: distribution/linux/smoke/sqlite-seed.ts
/// symbol "native SQLite seed" (L12-18):
/// pinned provision plus insertion
/// shape.
/// Disposition: migrate slice only (this
/// row owns the seed pact as reviewable
/// Can facts; no seed file changes
/// here; old driver call stays until the
/// integrator rewires it after each
/// linked row plus gate has accepted
/// proof).
/// Protects (this file): native
/// insertion plus readback plus pool
/// closure wants, roots leg:
/// provision plus insert plus select.
/// ADAPTATION (noted, plus source
/// lines): name pins hold spellings;
/// statement pins hold SQL bytes; count
/// pins hold ints tallied from L12 plus
/// L16 plus L17 plus L18 plus L22.
/// dbpath-name pins dbPath (L13 plus L14 plus L15; L14 holds two);
/// argv-index pins process.argv[2] (L13);
/// typeof-word pins typeof (L14);
/// missing-want pins missing database path argument (L14);
/// adapter-name pins adapter (L15);
/// sqlite-word pins sqlite (L1 plus L15);
/// filename-word pins filename (L15);
/// safe-word pins safeIntegers (L15);
/// insert-statement pins INSERT INTO notes (id, body) VALUES (7, 'seed') (L17);
/// select-statement pins SELECT id, body FROM notes WHERE id = 7 (L18);
/// table-name pins notes (L17 plus L18);
/// row-id pins 7 (L17 plus L18);
/// try-block-count pins 2 (L12 plus L16);
/// await-sql-count pins 3 (L17 plus L18 plus L22).
/// Facet map (pin order): dbpath-name,
/// argv-index, typeof-word,
/// missing-want, adapter-name,
/// sqlite-word, filename-word,
/// safe-word, insert-statement,
/// select-statement, table-name,
/// row-id, try-block-count,
/// await-sql-count.
/// The envelope plus helper shape lives in
/// edge-005-base-semantics.can; the
/// readback plus verdict plus close shape
/// lives in edge-005-run-shape.can.
/// Row id seven comes from VALUES plus WHERE;
/// wanted count one lives in the run file.
/// Variants: none (row lists zero
/// variants).
/// Environment: zero gates; bind at P23
/// plus QD1; no live run now.
/// Logical gates SUITE plus WORK plus
/// DB plus NATIVE bind at P23
/// plus QD1; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like the
/// M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// plus QD1 accept gates unmet).
/// Intended consumed report: M26
/// HISTORY-010 plus HISTORY-016 parsed slices (no qualified
/// report yet; P23 plus QD1
/// unmet).
/// Caller stays as is; sqlite-seed.ts
/// plus smoke.sh plus the Go caller
/// intact; no call retired.
/// Shared old files intact; retirement
/// is a later integrator choice; Z03
/// owns activation.
/// Case edge/sqlite-insertion checks:
/// dbpath-name, argv-index, typeof-word,
/// missing-want, adapter-name,
/// sqlite-word, filename-word,
/// safe-word, insert-statement,
/// select-statement, table-name,
/// row-id, try-block-count,
/// await-sql-count.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str dbpath_name
    str argv_index
    str typeof_word
    str missing_want
    str adapter_name
    str sqlite_word
    str filename_word
    str safe_word
    str insert_statement
    str select_statement
    str table_name
    int row_id
    int try_block_count
    int await_sql_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/sqlite-insertion", "default", "", "offline"), "dbpath-name" => ok "case edge/sqlite-insertion variant default root dbpath-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/sqlite-insertion", "default", "", "offline"), "dbpath-name" => ok evidence("dbpath-name", "true", "true", true, "case edge/sqlite-insertion variant default root dbpath-name run offline")
        different: false, true, context("edge/sqlite-insertion", "default", "", "offline"), "dbpath-name" => failed{"dbpath-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 7, 7, context("edge/sqlite-insertion", "default", "", "offline"), "row-id" => ok evidence("row-id", "7", "7", true, "case edge/sqlite-insertion variant default root row-id run offline")
        different: 6, 7, context("edge/sqlite-insertion", "default", "", "offline"), "row-id" => failed{"row-id"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "dbPath", "dbPath", context("edge/sqlite-insertion", "default", "", "offline"), "dbpath-name" => ok evidence("dbpath-name", "dbPath", "dbPath", true, "case edge/sqlite-insertion variant default root dbpath-name run offline")
        different: "dbPath_2", "dbPath", context("edge/sqlite-insertion", "default", "", "offline"), "dbpath-name" => failed{"dbpath-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
