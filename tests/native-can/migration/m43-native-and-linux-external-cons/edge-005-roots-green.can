    asserts
        edge_scope: "m43-e005" => ok [check("dbpath-name", "dbpath name keeps its spelling"), check("argv-index", "argv index keeps its bytes"), check("typeof-word", "typeof word keeps its bytes"), check("missing-want", "missing want keeps its bytes"), check("adapter-name", "adapter name keeps its spelling"), check("sqlite-word", "sqlite word keeps its bytes"), check("filename-word", "filename word keeps its bytes"), check("safe-word", "safe word keeps its spelling"), check("insert-statement", "insert statement keeps its bytes"), check("select-statement", "select statement keeps its bytes"), check("table-name", "table name keeps its spelling"), check("row-id", "row id is seven"), check("try-block-count", "two try blocks exist"), check("await-sql-count", "three await sql uses exist")]
        other: "nope" => ok []
    match scope is "m43-e005"
        false => ok []
        true => ok [check("dbpath-name", "dbpath name keeps its spelling"), check("argv-index", "argv index keeps its bytes"), check("typeof-word", "typeof word keeps its bytes"), check("missing-want", "missing want keeps its bytes"), check("adapter-name", "adapter name keeps its spelling"), check("sqlite-word", "sqlite word keeps its bytes"), check("filename-word", "filename word keeps its bytes"), check("safe-word", "safe word keeps its spelling"), check("insert-statement", "insert statement keeps its bytes"), check("select-statement", "select statement keeps its bytes"), check("table-name", "table name keeps its spelling"), check("row-id", "row id is seven"), check("try-block-count", "two try blocks exist"), check("await-sql-count", "three await sql uses exist")]
