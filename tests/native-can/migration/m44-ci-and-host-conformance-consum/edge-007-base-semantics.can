package m44edge007base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-007 "release
/// qualification" provision pact.
/// Source:
/// .github/workflows/release-qualify.yml
/// symbol "release qualification"
/// (L1-34): pinned name plus triggers
/// plus provision steps.
/// Disposition: rewire (this row owns
/// the caller pact as reviewable Can
/// facts; the workflow stays until the
/// integrator rewires it after each
/// linked row has accepted proof).
/// Protects (this file): workflow name
/// plus offline head plus provision
/// pins plus tallies that bound setup.
/// ADAPTATION (noted, plus source
/// lines): name pins hold workflow
/// spellings; path pins hold staged
/// bytes; flag pins hold setup
/// spellings; count pins hold ints
/// tallied from L12-33.
/// workflow-name pins release
/// qualification (L1);
/// offline-head pins Offline
/// release/install/update qualification
/// (L3); zip-note pins one zip plus
/// integrity (L4); smoke-note pins
/// smoke-tests (L5); notary-note pins
/// notarization (L7); readme-note pins
/// distribution/README.md (L9);
/// branch-pin pins branches: [main]
/// (L13); pr-pin pins pull_request
/// (L14); job-pin pins release-offline
/// (L17); runner-pin pins macos-15
/// (L18); checkout-pin pins
/// actions/checkout@v6 (L20);
/// acquire-pin pins Acquire the pinned
/// upstream archive (L21); heredoc-pin
/// pins python3 - <<'PY' (L23);
/// target-pin pins
/// distribution/target.json (L25);
/// bunzip-pin pins bun.zip (L26 plus
/// L37 plus L49); setupgo-pin pins
/// actions/setup-go@v6 (L28);
/// gomod-pin pins go-version-file:
/// go.mod (L30); proxy-pin pins
/// GOPROXY=off (L31); moddl-pin pins
/// go mod download (L34);
/// trigger-count pins int (2) from
/// L12 plus L14; provision-step-count
/// pins int (4) from L20 plus L21 plus
/// L28 plus L33; heredoc-line-count
/// pins int (5) from L23-27.
/// Facet map (head then setup order):
/// workflow-name, offline-head,
/// zip-note, smoke-note, notary-note,
/// readme-note, branch-pin, pr-pin,
/// job-pin, runner-pin, checkout-pin,
/// acquire-pin, heredoc-pin,
/// target-pin, bunzip-pin,
/// setupgo-pin, gomod-pin, proxy-pin,
/// moddl-pin, trigger-count,
/// provision-step-count,
/// heredoc-line-count.
/// The offline build plus install plus
/// smoke shape lives in
/// edge-007-roots-green.can; the suite
/// plus upload shape lives in
/// edge-007-run-shape.can.
/// Variants: none listed (row lists
/// zero variants).
/// Environment: no gates listed (binds
/// at P23; no live run now).
/// Logical gates SUITE/ENV/ARCHIVE/
/// WORK/BUILD bind at P23; no live run
/// now.
/// Timeout 120000ms is the offline
/// default bound (no bun timeout in
/// this row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 Linux distribution slices
/// (no qualified report yet; P23/QD1/
/// QN1 unmet).
/// Rewire stays blocked; the workflow
/// stays intact; no call retired.
/// Related: tests/integration/
/// release_test.go plus
/// tests/integration/
/// distribution_test.go (invoked by
/// the caller; owned outside M44).
/// Case release/qualify-provision
/// checks: workflow-name,
/// offline-head, zip-note, smoke-note,
/// notary-note, readme-note,
/// branch-pin, pr-pin, job-pin,
/// runner-pin, checkout-pin,
/// acquire-pin, heredoc-pin,
/// target-pin, bunzip-pin,
/// setupgo-pin, gomod-pin, proxy-pin,
/// moddl-pin, trigger-count,
/// provision-step-count,
/// heredoc-line-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str workflow_name
    str offline_head
    str zip_note
    str smoke_note
    str notary_note
    str readme_note
    str branch_pin
    str pr_pin
    str job_pin
    str runner_pin
    str checkout_pin
    str acquire_pin
    str heredoc_pin
    str target_pin
    str bunzip_pin
    str setupgo_pin
    str gomod_pin
    str proxy_pin
    str moddl_pin
    int trigger_count
    int provision_step_count
    int heredoc_line_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("release/qualify-provision", "default", "", "offline"), "workflow-name" => ok "case release/qualify-provision variant default root workflow-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("release/qualify-provision", "default", "", "offline"), "workflow-name" => ok evidence("workflow-name", "true", "true", true, "case release/qualify-provision variant default root workflow-name run offline")
        different: false, true, context("release/qualify-provision", "default", "", "offline"), "workflow-name" => failed{"workflow-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("release/qualify-provision", "default", "", "offline"), "trigger-count" => ok evidence("trigger-count", "2", "2", true, "case release/qualify-provision variant default root trigger-count run offline")
        different: 1, 2, context("release/qualify-provision", "default", "", "offline"), "trigger-count" => failed{"trigger-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "release qualification", "release qualification", context("release/qualify-provision", "default", "", "offline"), "workflow-name" => ok evidence("workflow-name", "release qualification", "release qualification", true, "case release/qualify-provision variant default root workflow-name run offline")
        different: "release qualification_2", "release qualification", context("release/qualify-provision", "default", "", "offline"), "workflow-name" => failed{"workflow-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
