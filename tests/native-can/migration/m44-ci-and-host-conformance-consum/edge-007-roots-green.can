package m44edge007roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-007 "release
/// qualification" offline pact.
/// Source:
/// .github/workflows/release-qualify.yml
/// symbol "release qualification"
/// (L35-46): pinned offline build plus
/// release plus install plus smoke.
/// Disposition: rewire (same row pact
/// as the provision slice; this file
/// owns the offline call spellings).
/// Protects (this file): the offline
/// build call plus install call plus
/// sandbox plus runtime pins plus
/// tallies.
/// ADAPTATION (noted, plus source
/// lines): call pins hold verb
/// spellings; flag pins hold option
/// spellings; path pins hold staged
/// bytes; count pins hold ints tallied
/// from L40-46.
/// build-name pins Build, release,
/// install, and smoke-test offline
/// (L35); archive-env pins
/// CAN_BUN_ARCHIVE (L37 plus L40 plus
/// L49); strict-shell pins set -euo
/// pipefail (L39); distbuild-call pins
/// go run ./tools/distbuild (L40 plus
/// L43); release-out-flag pins
/// --release-out (L40); ci-version
/// pins ci-$GITHUB_SHA (L40);
/// artifact-var pins ARTIFACT (L42
/// plus L43); zip-glob pins *.zip
/// (L42); install-subcmd pins install
/// --archive (L43); sha-flag pins
/// --sha (L43); root-flag pins --root
/// (L43); install-root-dir pins
/// install-root (L43 plus L44 plus
/// L46); sandbox-exec-bin pins
/// /usr/bin/sandbox-exec (L44 plus
/// L46); sandbox-profile pins (version
/// 1)(allow default)(deny network*)
/// (L44 plus L46); runtime-cmd pins
/// runtime-check (L44 plus L46);
/// want-bun pins 1.4.2 (L44);
/// json-load-call pins
/// json.load(sys.stdin) (L44);
/// deny-path pins PATH=/nonexistent
/// (L46); empty-home-dir pins
/// empty-home (L45 plus L46);
/// null-sink pins >/dev/null (L46);
/// build-flag-count pins int (4) from
/// L40; install-flag-count pins int
/// (3) from L43; sandbox-call-count
/// pins int (2) from L44 plus L46.
/// Facet map (call then guard order):
/// build-name, archive-env,
/// strict-shell, distbuild-call,
/// release-out-flag, ci-version,
/// artifact-var, zip-glob,
/// install-subcmd, sha-flag, root-flag,
/// install-root-dir, sandbox-exec-bin,
/// sandbox-profile, runtime-cmd,
/// want-bun, json-load-call,
/// deny-path, empty-home-dir,
/// null-sink, build-flag-count,
/// install-flag-count,
/// sandbox-call-count.
/// The provision pact lives in
/// edge-007-base-semantics.can; the
/// suite plus upload shape lives in
/// edge-007-run-shape.can.
/// Variants: none listed (row lists
/// zero variants).
/// Environment: no gates listed (binds
/// at P23; no live run now).
/// Logical gates SUITE/ENV/ARCHIVE/
/// WORK/BUILD bind at P23; no live run
/// now.
/// Timeout 120000ms is the offline
/// default bound (no bun timeout in
/// this row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 Linux distribution slices
/// (no qualified report yet; P23/QD1/
/// QN1 unmet).
/// Rewire stays blocked; the workflow
/// stays intact; no call retired.
/// Related: tests/integration/
/// release_test.go plus
/// tests/integration/
/// distribution_test.go (invoked by
/// the caller; owned outside M44).
/// Case release/qualify-offline
/// checks: build-name, archive-env,
/// strict-shell, distbuild-call,
/// release-out-flag, ci-version,
/// artifact-var, zip-glob,
/// install-subcmd, sha-flag, root-flag,
/// install-root-dir, sandbox-exec-bin,
/// sandbox-profile, runtime-cmd,
/// want-bun, json-load-call,
/// deny-path, empty-home-dir,
/// null-sink, build-flag-count,
/// install-flag-count,
/// sandbox-call-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str build_name
    str archive_env
    str strict_shell
    str distbuild_call
    str release_out_flag
    str ci_version
    str artifact_var
    str zip_glob
    str install_subcmd
    str sha_flag
    str root_flag
    str install_root_dir
    str sandbox_exec_bin
    str sandbox_profile
    str runtime_cmd
    str want_bun
    str json_load_call
    str deny_path
    str empty_home_dir
    str null_sink
    int build_flag_count
    int install_flag_count
    int sandbox_call_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("release/qualify-offline", "default", "", "offline"), "build-name" => ok "case release/qualify-offline variant default root build-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("release/qualify-offline", "default", "", "offline"), "build-name" => ok evidence("build-name", "true", "true", true, "case release/qualify-offline variant default root build-name run offline")
        different: false, true, context("release/qualify-offline", "default", "", "offline"), "build-name" => failed{"build-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("release/qualify-offline", "default", "", "offline"), "build-flag-count" => ok evidence("build-flag-count", "4", "4", true, "case release/qualify-offline variant default root build-flag-count run offline")
        different: 3, 4, context("release/qualify-offline", "default", "", "offline"), "build-flag-count" => failed{"build-flag-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "Build, release, install, and smoke-test offline", "Build, release, install, and smoke-test offline", context("release/qualify-offline", "default", "", "offline"), "build-name" => ok evidence("build-name", "Build, release, install, and smoke-test offline", "Build, release, install, and smoke-test offline", true, "case release/qualify-offline variant default root build-name run offline")
        different: "Build, release, install, and smoke-test offline_2", "Build, release, install, and smoke-test offline", context("release/qualify-offline", "default", "", "offline"), "build-name" => failed{"build-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
