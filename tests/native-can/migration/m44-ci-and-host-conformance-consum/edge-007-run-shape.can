package m44edge007run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-007 "release
/// qualification" suite pact.
/// Source:
/// .github/workflows/release-qualify.yml
/// symbol "release qualification"
/// (L47-63): pinned suite calls plus
/// select names plus upload records.
/// Disposition: rewire (same row pact
/// as the provision slice; this file
/// owns the suite plus receipt
/// spellings).
/// Protects (this file): the two go
/// suite calls plus select names plus
/// log names plus upload records plus
/// tallies.
/// ADAPTATION (noted, plus source
/// lines): call pins hold suite verb
/// spellings; name pins hold select
/// plus log spellings; glob pins hold
/// upload bytes; count pins hold ints
/// tallied from L52-62.
/// suite-name pins Run release,
/// install, and update tests (L47);
/// pipefail-shell pins set -o pipefail
/// (L51); unit-suite-call pins go test
/// -count=1 -v ./distribution (L52);
/// unit-log-name pins
/// release-unit-v1.txt (L52 plus L61);
/// select-release pins
/// TestReleaseInstallUpdate (L53);
/// select-refusals pins
/// TestInstallRootRefusals (L53);
/// select-sidecar pins
/// TestDevelopmentSidecar (L53);
/// integration-dir pins
/// ./tests/integration (L53);
/// integration-log-name pins
/// release-integration-v1.txt (L53
/// plus L62); upload-action pins
/// actions/upload-artifact@v4 (L54);
/// always-guard pins always() (L55);
/// artifact-name pins
/// release-qualification-v1 (L57);
/// sha-glob pins *.sha256 (L59);
/// inspection-glob pins
/// *.inspection.json (L60);
/// no-files-found pins
/// if-no-files-found: error (L63);
/// tee-call pins tee (L52 plus L53);
/// go-test-count pins int (2) from L52
/// plus L53; upload-path-count pins
/// int (4) from L59-62;
/// select-name-count pins int (3) from
/// L53.
/// Facet map (suite then upload
/// order): suite-name, pipefail-shell,
/// unit-suite-call, unit-log-name,
/// select-release, select-refusals,
/// select-sidecar, integration-dir,
/// integration-log-name, upload-action,
/// always-guard, artifact-name,
/// sha-glob, inspection-glob,
/// no-files-found, tee-call,
/// go-test-count, upload-path-count,
/// select-name-count.
/// The provision pact lives in
/// edge-007-base-semantics.can; the
/// offline shape lives in
/// edge-007-roots-green.can.
/// Variants: none listed (row lists
/// zero variants).
/// Environment: no gates listed (binds
/// at P23; no live run now).
/// Logical gates SUITE/ENV/ARCHIVE/
/// WORK/BUILD bind at P23; no live run
/// now.
/// Timeout 120000ms is the offline
/// default bound (no bun timeout in
/// this row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 Linux distribution slices
/// (no qualified report yet; P23/QD1/
/// QN1 unmet).
/// Rewire stays blocked; the workflow
/// stays intact; no call retired.
/// Caller pact note: the suite plus
/// upload pins above are the exact
/// calls Z03 will rewire once a
/// qualified Can report exists; the
/// staged probe below already proves
/// the report plus receipt handling
/// shape (require plus observe plus
/// expected vector).
/// Related: tests/integration/
/// release_test.go plus
/// tests/integration/
/// distribution_test.go (invoked by
/// the caller; owned outside M44).
/// Case release/qualify-suites checks:
/// suite-name, pipefail-shell,
/// unit-suite-call, unit-log-name,
/// select-release, select-refusals,
/// select-sidecar, integration-dir,
/// integration-log-name, upload-action,
/// always-guard, artifact-name,
/// sha-glob, inspection-glob,
/// no-files-found, tee-call,
/// go-test-count, upload-path-count,
/// select-name-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str suite_name
    str pipefail_shell
    str unit_suite_call
    str unit_log_name
    str select_release
    str select_refusals
    str select_sidecar
    str integration_dir
    str integration_log_name
    str upload_action
    str always_guard
    str artifact_name
    str sha_glob
    str inspection_glob
    str no_files_found
    str tee_call
    int go_test_count
    int upload_path_count
    int select_name_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("release/qualify-suites", "default", "", "offline"), "suite-name" => ok "case release/qualify-suites variant default root suite-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("release/qualify-suites", "default", "", "offline"), "suite-name" => ok evidence("suite-name", "true", "true", true, "case release/qualify-suites variant default root suite-name run offline")
        different: false, true, context("release/qualify-suites", "default", "", "offline"), "suite-name" => failed{"suite-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("release/qualify-suites", "default", "", "offline"), "go-test-count" => ok evidence("go-test-count", "2", "2", true, "case release/qualify-suites variant default root go-test-count run offline")
        different: 1, 2, context("release/qualify-suites", "default", "", "offline"), "go-test-count" => failed{"go-test-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "Run release, install, and update tests", "Run release, install, and update tests", context("release/qualify-suites", "default", "", "offline"), "suite-name" => ok evidence("suite-name", "Run release, install, and update tests", "Run release, install, and update tests", true, "case release/qualify-suites variant default root suite-name run offline")
        different: "Run release, install, and update tests_2", "Run release, install, and update tests", context("release/qualify-suites", "default", "", "offline"), "suite-name" => failed{"suite-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("Run release, install, and update tests", "set -o pipefail", "go test -count=1 -v ./distribution", "release-unit-v1.txt", "TestReleaseInstallUpdate", "TestInstallRootRefusals", "TestDevelopmentSidecar", "./tests/integration", "release-integration-v1.txt", "actions/upload-artifact@v4", "always()", "release-qualification-v1", "*.sha256", "*.inspection.json", "if-no-files-found: error", "tee", 2, 4, 3)
        seed_suite_name: "seed-suite-name-drift" => ok observation("Run release, install, and update tests_2", "set -o pipefail", "go test -count=1 -v ./distribution", "release-unit-v1.txt", "TestReleaseInstallUpdate", "TestInstallRootRefusals", "TestDevelopmentSidecar", "./tests/integration", "release-integration-v1.txt", "actions/upload-artifact@v4", "always()", "release-qualification-v1", "*.sha256", "*.inspection.json", "if-no-files-found: error", "tee", 2, 4, 3)
