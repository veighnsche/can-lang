package m44edge008base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-008 "fresh emit plus strict
/// TypeScript gate" caller pact.
/// Source: .github/workflows/tsc.yml
/// symbol "fresh emit plus strict
/// TypeScript gate" (L1-17 plus L42-49):
/// pinned caller identity plus fresh
/// emit invocation.
/// Disposition: rewire (this row owns the
/// caller pact as reviewable Can
/// facts; old yaml call stays until
/// integrator rewires it after each linked
/// row, variant, plus gate has accepted
/// proof).
/// Protects (this file): the workflow name
/// plus job id plus runner plus triggers
/// (L1-17) plus emit env plus go run plus
/// clean step (L42-49) plus tallies that
/// bound the emit.
/// ADAPTATION (noted, plus source lines):
/// name pins hold caller spellings; env
/// pins hold emit dir bytes; flag pins
/// hold go run spellings; count pins hold
/// ints tallied from L10-12 plus L44-49.
/// workflow-name pins tsc gate (L1);
/// job-id pins fresh-emit-tsc (L15 plus
/// L54 plus L59 plus L62, four hits);
/// runner-os pins macos-15 (L16);
/// trigger-push pins push (L10);
/// trigger-pr pins pull_request (L12);
/// branch-main pins [main] (L11);
/// emit-env-archive pins CAN_BUN_ARCHIVE
/// (L44); emit-env-dir pins
/// CAN_FRESH_EMIT_DIR (L45 plus L48);
/// emit-workspace pins github.workspace
/// (L45); emit-dir-path pins
/// tscheck/.fresh-emit (L5 plus L45 plus
/// L61); emit-runner pins go test (L49);
/// emit-timeout pins -timeout=20m (L49);
/// emit-count pins -count=1 (L49);
/// emit-run-flag pins -run (L49);
/// emit-target pins TestStdlibMaintained
/// (L49; def in tests/integration/
/// stdlib_test.go L199); emit-package pins
/// ./tests/integration (L49); emit-clean
/// pins rm -rf (L48); trigger-count pins
/// int (2) from L10 plus L12;
/// emit-env-count pins int (2) from L44
/// plus L45; go-flag-count pins int (3)
/// from L49; timeout-mins pins int (20)
/// from L49.
/// Facet map (caller then emit order):
/// workflow-name, job-id, runner-os,
/// trigger-push, trigger-pr, branch-main,
/// emit-env-archive, emit-env-dir,
/// emit-workspace, emit-dir-path,
/// emit-runner, emit-timeout, emit-count,
/// emit-run-flag, emit-target,
/// emit-package, emit-clean,
/// trigger-count, emit-env-count,
/// go-flag-count, timeout-mins.
/// The provision roots live in
/// edge-008-roots-green.can; the gate
/// shape plus upload live in
/// edge-008-run-shape.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates SUITE/BUILD/CAN/PROC/
/// FILES/WORK bind at P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet).
/// Rewire stays blocked; tsc.yml
/// intact; no call retired.
/// Case edge/fresh-emit-stage
/// checks: workflow-name, job-id,
/// runner-os, trigger-push, trigger-pr,
/// branch-main, emit-env-archive,
/// emit-env-dir, emit-workspace,
/// emit-dir-path, emit-runner,
/// emit-timeout, emit-count, emit-run-flag,
/// emit-target, emit-package, emit-clean,
/// trigger-count, emit-env-count,
/// go-flag-count, timeout-mins.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str workflow_name
    str job_id
    str runner_os
    str trigger_push
    str trigger_pr
    str branch_main
    str emit_env_archive
    str emit_env_dir
    str emit_workspace
    str emit_dir_path
    str emit_runner
    str emit_timeout
    str emit_count
    str emit_run_flag
    str emit_target
    str emit_package
    str emit_clean
    int trigger_count
    int emit_env_count
    int go_flag_count
    int timeout_mins
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/fresh-emit-stage", "default", "", "offline"), "workflow-name" => ok "case edge/fresh-emit-stage variant default root workflow-name run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/fresh-emit-stage", "default", "", "offline"), "workflow-name" => ok evidence("workflow-name", "true", "true", true, "case edge/fresh-emit-stage variant default root workflow-name run offline")
        different: false, true, context("edge/fresh-emit-stage", "default", "", "offline"), "workflow-name" => failed{"workflow-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/fresh-emit-stage", "default", "", "offline"), "trigger-count" => ok evidence("trigger-count", "2", "2", true, "case edge/fresh-emit-stage variant default root trigger-count run offline")
        different: 1, 2, context("edge/fresh-emit-stage", "default", "", "offline"), "trigger-count" => failed{"trigger-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "tsc gate", "tsc gate", context("edge/fresh-emit-stage", "default", "", "offline"), "workflow-name" => ok evidence("workflow-name", "tsc gate", "tsc gate", true, "case edge/fresh-emit-stage variant default root workflow-name run offline")
        different: "tsc gate_2", "tsc gate", context("edge/fresh-emit-stage", "default", "", "offline"), "workflow-name" => failed{"workflow-name"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
