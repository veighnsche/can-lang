package m44edge008roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-008 "fresh emit plus strict
/// TypeScript gate" provision pact.
/// Source: .github/workflows/tsc.yml
/// symbol "fresh emit plus strict
/// TypeScript gate" (L18-41): pinned
/// provision toolchain plus pin-check
/// gates.
/// Disposition: rewire (same row pact as
/// the stage slice; this file owns the
/// provision roots).
/// Protects (this file): the checkout plus
/// setup-go plus mod prime (L18-25) plus
/// archive fetch plus unzip plus pin
/// checks (L26-39) plus ci install (L40)
/// plus tallies that bound provision.
/// ADAPTATION (noted, plus source lines):
/// ref pins hold action bytes; fetch pins
/// hold archive bytes; pin pins hold
/// shasum plus revision bytes; count pins
/// hold ints tallied from L18-40.
/// co-ref pins actions/checkout@v6 (L18);
/// go-ref pins actions/setup-go@v6 (L19);
/// go-version-key pins go-version-file
/// (L21); go-mod pins go.mod (L21);
/// mod-download pins go mod download
/// (L25); target-json pins
/// distribution/target.json (L30);
/// fetch-verb pins urlretrieve (L31);
/// upstream-key pins ['upstream'] (L31);
/// bun-archive pins bun.zip (L31 plus L36
/// plus L37 plus L44, four hits);
/// unzip-bin pins unzip (L36); shasum-bin
/// pins shasum (L37); bun-sha pins the
/// pinned digest (L37, 64 hex);
/// revision-flag pins --revision (L38);
/// bun-revision pins 1.4.2+744846f84
/// (L38); bun-triple pins
/// bun-darwin-aarch64 (L38 plus L39);
/// path-export pins GITHUB_PATH (L39);
/// runner-tmp pins RUNNER_TEMP (L31 plus
/// L36 plus L37 plus L38 plus L39, six
/// hits); ci-verb pins bun ci (L40);
/// shell-strict pins set -euo pipefail
/// (L35); fetch-runtime pins python3
/// (L28); provision-step-count pins int
/// (6) from L18-40; pin-test-count pins
/// int (2) from L37 plus L38;
/// runner-temp-count pins int (6) from
/// L31 plus L36-39; shasum-bits pins int
/// (256) from L37.
/// Facet map (provision order): co-ref,
/// go-ref, go-version-key, go-mod,
/// mod-download, target-json, fetch-verb,
/// upstream-key, bun-archive, unzip-bin,
/// shasum-bin, bun-sha, revision-flag,
/// bun-revision, bun-triple, path-export,
/// runner-tmp, ci-verb, shell-strict,
/// fetch-runtime, provision-step-count,
/// pin-test-count, runner-temp-count,
/// shasum-bits.
/// The stage pact lives in
/// edge-008-base-semantics.can; the gate
/// shape plus upload live in
/// edge-008-run-shape.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates SUITE/BUILD/CAN/PROC/
/// FILES/WORK bind at P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet).
/// Rewire stays blocked; tsc.yml
/// intact; no call retired.
/// Case edge/fresh-emit-roots
/// checks: co-ref, go-ref, go-version-key,
/// go-mod, mod-download, target-json,
/// fetch-verb, upstream-key, bun-archive,
/// unzip-bin, shasum-bin, bun-sha,
/// revision-flag, bun-revision, bun-triple,
/// path-export, runner-tmp, ci-verb,
/// shell-strict, fetch-runtime,
/// provision-step-count, pin-test-count,
/// runner-temp-count, shasum-bits.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str co_ref
    str go_ref
    str go_version_key
    str go_mod
    str mod_download
    str target_json
    str fetch_verb
    str upstream_key
    str bun_archive
    str unzip_bin
    str shasum_bin
    str bun_sha
    str revision_flag
    str bun_revision
    str bun_triple
    str path_export
    str runner_tmp
    str ci_verb
    str shell_strict
    str fetch_runtime
    int provision_step_count
    int pin_test_count
    int runner_temp_count
    int shasum_bits
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/fresh-emit-roots", "default", "", "offline"), "co-ref" => ok "case edge/fresh-emit-roots variant default root co-ref run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/fresh-emit-roots", "default", "", "offline"), "co-ref" => ok evidence("co-ref", "true", "true", true, "case edge/fresh-emit-roots variant default root co-ref run offline")
        different: false, true, context("edge/fresh-emit-roots", "default", "", "offline"), "co-ref" => failed{"co-ref"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 6, 6, context("edge/fresh-emit-roots", "default", "", "offline"), "provision-step-count" => ok evidence("provision-step-count", "6", "6", true, "case edge/fresh-emit-roots variant default root provision-step-count run offline")
        different: 5, 6, context("edge/fresh-emit-roots", "default", "", "offline"), "provision-step-count" => failed{"provision-step-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "actions/checkout@v6", "actions/checkout@v6", context("edge/fresh-emit-roots", "default", "", "offline"), "co-ref" => ok evidence("co-ref", "actions/checkout@v6", "actions/checkout@v6", true, "case edge/fresh-emit-roots variant default root co-ref run offline")
        different: "actions/checkout@v6_2", "actions/checkout@v6", context("edge/fresh-emit-roots", "default", "", "offline"), "co-ref" => failed{"co-ref"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
