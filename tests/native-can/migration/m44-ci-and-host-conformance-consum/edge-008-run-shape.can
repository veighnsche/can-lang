package m44edge008run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-008 "fresh emit plus strict
/// TypeScript gate" verdict pact.
/// Source: .github/workflows/tsc.yml
/// symbol "fresh emit plus strict
/// TypeScript gate" (L50-63): pinned
/// strict tsc run plus upload shape.
/// Disposition: rewire (same row pact as
/// the stage slice; this file owns the
/// gate run plus verdict).
/// Protects (this file): the tsc run plus
/// log capture plus exit gate (L50-55)
/// plus artifact upload (L56-63) plus
/// tallies that bound the gate.
/// ADAPTATION (noted, plus source lines):
/// gate pins hold tsc run bytes; verdict
/// pins hold exit bytes; upload pins hold
/// artifact bytes; count pins hold ints
/// tallied from L47 plus L53-63.
/// work-dir pins working-directory (L41
/// plus L51); check-dir pins tscheck (L5
/// plus L41 plus L45 plus L51 plus L61,
/// five hits); tsc-bin pins
/// typescript/bin/tsc (L54); tsc-project
/// pins -p (L54); tsc-config pins
/// tsconfig.json (L54); pipe-tee pins tee
/// (L54); gate-log pins
/// fresh-emit-tsc-v1.txt (L54 plus L62);
/// gate-name pins fresh-emit-tsc-v1 (L54
/// plus L59 plus L62, three hits);
/// pipe-status pins PIPESTATUS (L55);
/// exit-eq pins -eq 0 (L55); runner-gh
/// pins runner.temp (L44 plus L54 plus
/// L62); upload-ref pins
/// actions/upload-artifact@v4 (L56);
/// upload-always pins always() (L57);
/// upload-missing pins if-no-files-found
/// (L63); missing-mode pins error (L63);
/// pipefail-shell pins set -o pipefail
/// (L47 plus L53); upload-path-count pins
/// int (2) from L61 plus L62;
/// pipefail-count pins int (2) from L47
/// plus L53; emit-name-count pins int (3)
/// from L54 plus L59 plus L62.
/// Facet map (gate then upload order):
/// work-dir, check-dir, tsc-bin,
/// tsc-project, tsc-config, pipe-tee,
/// gate-log, gate-name, pipe-status,
/// exit-eq, runner-gh, upload-ref,
/// upload-always, upload-missing,
/// missing-mode, pipefail-shell,
/// upload-path-count, pipefail-count,
/// emit-name-count.
/// The stage pact lives in
/// edge-008-base-semantics.can; the
/// provision roots live in
/// edge-008-roots-green.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates SUITE/BUILD/CAN/PROC/
/// FILES/WORK bind at P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet).
/// Rewire stays blocked; tsc.yml
/// intact; no call retired.
/// Case edge/strict-tsc-gate
/// checks: work-dir, check-dir, tsc-bin,
/// tsc-project, tsc-config, pipe-tee,
/// gate-log, gate-name, pipe-status,
/// exit-eq, runner-gh, upload-ref,
/// upload-always, upload-missing,
/// missing-mode, pipefail-shell,
/// upload-path-count, pipefail-count,
/// emit-name-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str work_dir
    str check_dir
    str tsc_bin
    str tsc_project
    str tsc_config
    str pipe_tee
    str gate_log
    str gate_name
    str pipe_status
    str exit_eq
    str runner_gh
    str upload_ref
    str upload_always
    str upload_missing
    str missing_mode
    str pipefail_shell
    int upload_path_count
    int pipefail_count
    int emit_name_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/strict-tsc-gate", "default", "", "offline"), "work-dir" => ok "case edge/strict-tsc-gate variant default root work-dir run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/strict-tsc-gate", "default", "", "offline"), "work-dir" => ok evidence("work-dir", "true", "true", true, "case edge/strict-tsc-gate variant default root work-dir run offline")
        different: false, true, context("edge/strict-tsc-gate", "default", "", "offline"), "work-dir" => failed{"work-dir"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/strict-tsc-gate", "default", "", "offline"), "upload-path-count" => ok evidence("upload-path-count", "2", "2", true, "case edge/strict-tsc-gate variant default root upload-path-count run offline")
        different: 1, 2, context("edge/strict-tsc-gate", "default", "", "offline"), "upload-path-count" => failed{"upload-path-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "working-directory", "working-directory", context("edge/strict-tsc-gate", "default", "", "offline"), "work-dir" => ok evidence("work-dir", "working-directory", "working-directory", true, "case edge/strict-tsc-gate variant default root work-dir run offline")
        different: "working-directory_2", "working-directory", context("edge/strict-tsc-gate", "default", "", "offline"), "work-dir" => failed{"work-dir"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
