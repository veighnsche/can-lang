/// M44 EDGE-009 "canlcCache slash TestMain
/// slash canlcBinary" caller pact.
/// Source: host/conformance/
/// admission_test.go
/// symbol "canlcCache slash TestMain
/// slash canlcBinary" (L19 plus L234-237
/// plus L259-266): pinned import plus
/// module vars plus cache open surface.
/// Disposition: rewire (this row owns the
/// caller pact as reviewable Can
/// facts; old go call stays until
/// integrator rewires it after each linked
/// row, variant, plus gate has accepted
/// proof).
/// Protects (this file): the tempcache
/// import (L19) plus four module vars
/// (L234-237) plus open plus store plus
/// path (L259-266) plus consumed cache
/// surface (cache.go L3 plus L21 plus L47
/// plus L65 plus L100 plus L101 plus
/// L114) plus tallies that bound the
/// provision.
/// ADAPTATION (noted, plus source lines):
/// decl pins hold var spellings; call pins
/// hold open plus store plus path bytes;
/// cache pins hold consumed cache.go
/// decl plus call bytes; count pins hold
/// ints tallied from decl plus hit lines.
/// import-path pins the module import
/// (L19); cache-type pins the cache
/// pointer (L237); once-decl pins the
/// once var (L234); path-decl pins the
/// path var (L235); err-decl pins the err
/// var (L236); cache-decl pins the cache
/// var (L237); open-call pins the open
/// ref (L260); open-assign pins the open
/// bind (L260); cache-store pins the
/// store (L265); cache-path pins the path
/// ref (L266); package-name pins the
/// cache package (cache.go L3);
/// open-decl pins cache open (cache.go
/// L47); close-decl pins cache close
/// (cache.go L100); cache-prefix pins
/// the dir prefix (cache.go L21);
/// mkdir-call pins dir make (cache.go
/// L65); nil-guard pins the nil arm
/// (cache.go L101); remove-call pins dir
/// removal (cache.go L114);
/// module-var-count pins int (4) from
/// L234-237; cache-hit-count pins int (3)
/// from L237 plus L245 plus L265;
/// err-hit-count pins int (5) from L236
/// plus L262 plus L270 plus L275 plus
/// L276; path-hit-count pins int (3) from
/// L235 plus L273 plus L278.
/// Facet map (import then var then cache
/// order): import-path, cache-type,
/// once-decl, path-decl, err-decl,
/// cache-decl, open-call, open-assign,
/// cache-store, cache-path, package-name,
/// open-decl, close-decl, cache-prefix,
/// mkdir-call, nil-guard, remove-call,
/// module-var-count, cache-hit-count,
/// err-hit-count, path-hit-count.
/// The build roots live in
/// edge-009-roots-green.can; the TestMain
/// cleanup plus verdict live in
/// edge-009-run-shape.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates WORK/PROC/BUILD bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet; M29 LIFE-024 parsed only).
/// Rewire stays blocked; admission_test.go
/// intact; no call retired.
/// Case edge/run-owned-cache
/// checks: import-path, cache-type,
/// once-decl, path-decl, err-decl,
/// cache-decl, open-call, open-assign,
/// cache-store, cache-path, package-name,
/// open-decl, close-decl, cache-prefix,
/// mkdir-call, nil-guard, remove-call,
/// module-var-count, cache-hit-count,
/// err-hit-count, path-hit-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str import_path
    str cache_type
    str once_decl
    str path_decl
    str err_decl
    str cache_decl
    str open_call
    str open_assign
    str cache_store
    str cache_path
    str package_name
    str open_decl
    str close_decl
    str cache_prefix
    str mkdir_call
    str nil_guard
    str remove_call
    int module_var_count
    int cache_hit_count
    int err_hit_count
    int path_hit_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/run-owned-cache", "default", "", "offline"), "import-path" => ok "case edge/run-owned-cache variant default root import-path run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/run-owned-cache", "default", "", "offline"), "import-path" => ok evidence("import-path", "true", "true", true, "case edge/run-owned-cache variant default root import-path run offline")
        different: false, true, context("edge/run-owned-cache", "default", "", "offline"), "import-path" => failed{"import-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("edge/run-owned-cache", "default", "", "offline"), "module-var-count" => ok evidence("module-var-count", "4", "4", true, "case edge/run-owned-cache variant default root module-var-count run offline")
        different: 3, 4, context("edge/run-owned-cache", "default", "", "offline"), "module-var-count" => failed{"module-var-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "github.com/veighnsche/can-lang/tests/support/tempcache", "github.com/veighnsche/can-lang/tests/support/tempcache", context("edge/run-owned-cache", "default", "", "offline"), "import-path" => ok evidence("import-path", "github.com/veighnsche/can-lang/tests/support/tempcache", "github.com/veighnsche/can-lang/tests/support/tempcache", true, "case edge/run-owned-cache variant default root import-path run offline")
        different: "github.com/veighnsche/can-lang/tests/support/tempcache_2", "github.com/veighnsche/can-lang/tests/support/tempcache", context("edge/run-owned-cache", "default", "", "offline"), "import-path" => failed{"import-path"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
