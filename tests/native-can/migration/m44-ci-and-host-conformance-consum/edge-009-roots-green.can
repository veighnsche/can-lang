package m44edge009roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-009 "canlcCache slash TestMain
/// slash canlcBinary" build pact.
/// Source: host/conformance/
/// admission_test.go
/// symbol "canlcCache slash TestMain
/// slash canlcBinary" (L253-281 plus
/// L286 plus L351-359): pinned
/// once-per-run go build plus error wrap.
/// Disposition: rewire (same row pact as
/// the cache slice; this file owns the
/// build roots).
/// Protects (this file): the binary decl
/// plus once run (L257-259) plus out
/// join plus go build plus dir plus
/// capture (L266-269) plus wrap plus
/// guard plus fatal plus return
/// (L270-278) plus buildError plus root
/// helper (L281 plus L286 plus L353)
/// plus tallies that bound the build.
/// ADAPTATION (noted, plus source lines):
/// decl pins hold fn spellings; build pins
/// hold command plus dir plus capture
/// bytes; wrap pins hold error wrap
/// bytes; count pins hold ints tallied
/// from call plus hit lines.
/// binary-decl pins the binary fn (L257);
/// binary-symbol pins the symbol (L253
/// plus L257 plus L293, three hits);
/// once-do pins the once run (L259);
/// once-type pins the once type (L234
/// plus L352, two hits); exec-call pins
/// command runs (L267 plus L320, two
/// hits); build-target pins the build
/// package (L267); build-dir pins the
/// build dir (L268); build-root pins the
/// root helper (L268 plus L353, two
/// hits); build-capture pins output
/// capture (L269 plus L321, two hits);
/// build-assign pins the capture bind
/// (L269); out-join pins the out join
/// (L266); fatal-wording pins the fatal
/// bytes (L276); err-guard pins the err
/// arm (L275); wrap-call pins error wrap
/// (L270); wrap-decl pins the wrap type
/// (L281); wrap-error pins the wrap
/// message fn (L286); return-path pins
/// the path return (L278); root-decl
/// pins the root fn (L353); exec-count
/// pins int (2) from L267 plus L320;
/// capture-count pins int (2) from L269
/// plus L321; build-arg-count pins int
/// (5) from L267; binary-hit-count pins
/// int (3) from L253 plus L257 plus
/// L293; once-hit-count pins int (2)
/// from L234 plus L259.
/// Facet map (decl then build then wrap
/// order): binary-decl, binary-symbol,
/// once-do, once-type, exec-call,
/// build-target, build-dir, build-root,
/// build-capture, build-assign, out-join,
/// fatal-wording, err-guard, wrap-call,
/// wrap-decl, wrap-error, return-path,
/// root-decl, exec-count, capture-count,
/// build-arg-count, binary-hit-count,
/// once-hit-count.
/// The cache pact lives in
/// edge-009-base-semantics.can; the
/// TestMain cleanup plus verdict live in
/// edge-009-run-shape.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates WORK/PROC/BUILD bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet; M29 LIFE-024 parsed only).
/// Rewire stays blocked; admission_test.go
/// intact; no call retired.
/// Case edge/once-per-run-build
/// checks: binary-decl, binary-symbol,
/// once-do, once-type, exec-call,
/// build-target, build-dir, build-root,
/// build-capture, build-assign, out-join,
/// fatal-wording, err-guard, wrap-call,
/// wrap-decl, wrap-error, return-path,
/// root-decl, exec-count, capture-count,
/// build-arg-count, binary-hit-count,
/// once-hit-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str binary_decl
    str binary_symbol
    str once_do
    str once_type
    str exec_call
    str build_target
    str build_dir
    str build_root
    str build_capture
    str build_assign
    str out_join
    str fatal_wording
    str err_guard
    str wrap_call
    str wrap_decl
    str wrap_error
    str return_path
    str root_decl
    int exec_count
    int capture_count
    int build_arg_count
    int binary_hit_count
    int once_hit_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/once-per-run-build", "default", "", "offline"), "binary-decl" => ok "case edge/once-per-run-build variant default root binary-decl run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/once-per-run-build", "default", "", "offline"), "binary-decl" => ok evidence("binary-decl", "true", "true", true, "case edge/once-per-run-build variant default root binary-decl run offline")
        different: false, true, context("edge/once-per-run-build", "default", "", "offline"), "binary-decl" => failed{"binary-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/once-per-run-build", "default", "", "offline"), "exec-count" => ok evidence("exec-count", "2", "2", true, "case edge/once-per-run-build variant default root exec-count run offline")
        different: 1, 2, context("edge/once-per-run-build", "default", "", "offline"), "exec-count" => failed{"exec-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "func canlcBinary(t *testing.T) string", "func canlcBinary(t *testing.T) string", context("edge/once-per-run-build", "default", "", "offline"), "binary-decl" => ok evidence("binary-decl", "func canlcBinary(t *testing.T) string", "func canlcBinary(t *testing.T) string", true, "case edge/once-per-run-build variant default root binary-decl run offline")
        different: "func canlcBinary(t *testing.T) string_2", "func canlcBinary(t *testing.T) string", context("edge/once-per-run-build", "default", "", "offline"), "binary-decl" => failed{"binary-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
