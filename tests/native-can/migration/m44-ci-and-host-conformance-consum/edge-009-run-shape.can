package m44edge009run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-009 "canlcCache slash TestMain
/// slash canlcBinary" verdict pact.
/// Source: host/conformance/
/// admission_test.go
/// symbol "canlcCache slash TestMain
/// slash canlcBinary" (L239-251 plus
/// L293 plus L320-323): pinned TestMain
/// entry plus cleanup plus propagation.
/// Disposition: rewire (same row pact as
/// the cache slice; this file owns the
/// entry plus cleanup plus verdict).
/// Protects (this file): the TestMain
/// entry (L239-240) plus run wrapper
/// plus defer plus close arm (L243-245)
/// plus stderr plus code override
/// (L246-247) plus run return (L250)
/// plus binary handoff plus invoke
/// (L293 plus L320) plus tallies that
/// bound the verdict.
/// ADAPTATION (noted, plus source lines):
/// entry pins hold TestMain spellings;
/// cleanup pins hold close plus stderr
/// plus override bytes; handoff pins hold
/// leg consume bytes; count pins hold
/// ints tallied from hit plus stmt lines.
/// main-decl pins the entry fn (L239);
/// main-exit pins the exit wrap (L240);
/// run-symbol pins the wrapper (L240
/// plus L243, two hits); run-decl pins
/// the wrapper decl (L243); defer-shape
/// pins the defer arm (L244);
/// close-guard pins the close arm (L245);
/// close-call pins the close ref (L245);
/// stderr-wording pins the failure bytes
/// (L246); code-override pins the code
/// set (L247); run-return pins the run
/// return (L250); binary-handoff pins
/// the leg handoff (L293); binary-invoke
/// pins the leg invoke (L320);
/// inspect-verb pins the leg verb (L255
/// plus L320 plus L323, three hits);
/// m-type pins the run handle type (L239
/// plus L243, two hits); named-code pins
/// the named code (L243); stderr-fn pins
/// the write fn (L246); stderr-handle
/// pins the write target (L246);
/// run-hit-count pins int (2) from L240
/// plus L243; inspect-hit-count pins int
/// (3) from L255 plus L320 plus L323;
/// m-type-count pins int (2) from L239
/// plus L243; cleanup-stmt-count pins int
/// (3) from L245 plus L246 plus L247.
/// Facet map (entry then cleanup then
/// handoff order): main-decl, main-exit,
/// run-symbol, run-decl, defer-shape,
/// close-guard, close-call, stderr-wording,
/// code-override, run-return,
/// binary-handoff, binary-invoke,
/// inspect-verb, m-type, named-code,
/// stderr-fn, stderr-handle,
/// run-hit-count, inspect-hit-count,
/// m-type-count, cleanup-stmt-count.
/// The cache pact lives in
/// edge-009-base-semantics.can; the
/// build roots live in
/// edge-009-roots-green.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates WORK/PROC/BUILD bind at
/// P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet; M29 LIFE-024 parsed only).
/// Rewire stays blocked; admission_test.go
/// intact; no call retired.
/// Case edge/cleanup-verdict
/// checks: main-decl, main-exit,
/// run-symbol, run-decl, defer-shape,
/// close-guard, close-call, stderr-wording,
/// code-override, run-return,
/// binary-handoff, binary-invoke,
/// inspect-verb, m-type, named-code,
/// stderr-fn, stderr-handle,
/// run-hit-count, inspect-hit-count,
/// m-type-count, cleanup-stmt-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str main_decl
    str main_exit
    str run_symbol
    str run_decl
    str defer_shape
    str close_guard
    str close_call
    str stderr_wording
    str code_override
    str run_return
    str binary_handoff
    str binary_invoke
    str inspect_verb
    str m_type
    str named_code
    str stderr_fn
    str stderr_handle
    int run_hit_count
    int inspect_hit_count
    int m_type_count
    int cleanup_stmt_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/cleanup-verdict", "default", "", "offline"), "main-decl" => ok "case edge/cleanup-verdict variant default root main-decl run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/cleanup-verdict", "default", "", "offline"), "main-decl" => ok evidence("main-decl", "true", "true", true, "case edge/cleanup-verdict variant default root main-decl run offline")
        different: false, true, context("edge/cleanup-verdict", "default", "", "offline"), "main-decl" => failed{"main-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/cleanup-verdict", "default", "", "offline"), "run-hit-count" => ok evidence("run-hit-count", "2", "2", true, "case edge/cleanup-verdict variant default root run-hit-count run offline")
        different: 1, 2, context("edge/cleanup-verdict", "default", "", "offline"), "run-hit-count" => failed{"run-hit-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "func TestMain(m *testing.M)", "func TestMain(m *testing.M)", context("edge/cleanup-verdict", "default", "", "offline"), "main-decl" => ok evidence("main-decl", "func TestMain(m *testing.M)", "func TestMain(m *testing.M)", true, "case edge/cleanup-verdict variant default root main-decl run offline")
        different: "func TestMain(m *testing.M)_2", "func TestMain(m *testing.M)", context("edge/cleanup-verdict", "default", "", "offline"), "main-decl" => failed{"main-decl"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
