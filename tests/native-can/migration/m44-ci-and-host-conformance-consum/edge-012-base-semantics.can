package m44edge012base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-012 "Linux
/// provisioning/launcher" provision
/// pact.
/// Source:
/// distribution/linux/run.sh
/// symbol "Linux
/// provisioning/launcher" (L1-31):
/// pinned env plus dirs plus
/// provenance gates.
/// Disposition: rewire (this row owns
/// the caller pact as reviewable Can
/// facts; run.sh stays until the
/// integrator rewires it after each
/// linked row has accepted proof).
/// Protects (this file): header plus
/// env defaults plus dir layout plus
/// provenance pins plus tallies that
/// bound setup.
/// ADAPTATION (noted, plus source
/// lines): name pins hold header
/// spellings; path pins hold staged
/// bytes; flag pins hold setup
/// spellings; count pins hold ints
/// tallied from L12-28.
/// shebang pins #!/bin/sh (L1);
/// orch-head pins T19 host
/// orchestrator (L2); strict-shell
/// pins set -eu (L10); bun-zip pins
/// bun-linux-x64.zip (L5 plus L12);
/// version-pin pins t19-1 (L13);
/// image-pin pins can-linux/t19
/// (L14); rev-parse-top pins git
/// rev-parse --show-toplevel (L16);
/// root-var pins $ROOT (L17 plus L18
/// plus L19); out-assign pins OUT=
/// (L18); work-assign pins WORK=
/// (L19); mkdir-cmd pins mkdir -p
/// (L20); provenance-head pins ---
/// provenance check (L22);
/// provenance-file pins
/// distribution/linux/provenance.json
/// (L23 plus L49); heredoc-fence
/// pins <<'PY' (L23); py-imports
/// pins import hashlib, json, sys
/// (L24); size-mismatch pins archive
/// size mismatch (L27);
/// digest-mismatch pins archive
/// digest mismatch (L28); archive-ok
/// pins archive ok: (L29);
/// source-rev pins sourceRevision=
/// (L31); hash-call pins
/// hashlib.sha256 (L28);
/// env-default-count pins int (3)
/// from L12 plus L13 plus L14;
/// out-dir-count pins int (2) from
/// L18 plus L19;
/// provenance-assert-count pins int
/// (2) from L27 plus L28.
/// Facet map (head then setup order):
/// shebang, orch-head,
/// strict-shell, bun-zip,
/// version-pin, image-pin,
/// rev-parse-top, root-var,
/// out-assign, work-assign,
/// mkdir-cmd, provenance-head,
/// provenance-file, heredoc-fence,
/// py-imports, size-mismatch,
/// digest-mismatch, archive-ok,
/// source-rev, hash-call,
/// env-default-count, out-dir-count,
/// provenance-assert-count.
/// The build plus smoke pins live in
/// edge-012-roots-green.can; the
/// postgres plus done pins live in
/// edge-012-run-shape.can.
/// Variants: none listed (row lists
/// zero variants).
/// Environment: no gates listed (binds
/// at P23; no live run now).
/// Logical gates ENV/WORK/PROC bind
/// at P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 plus LIFE-013 Linux
/// slices (no qualified report yet;
/// P23/QD1/QN1 unmet).
/// Rewire stays blocked; run.sh stays
/// intact; no call retired.
/// Related:
/// distribution/linux/smoke.sh
/// (invoked by the caller; owned
/// outside M44).
/// Case linux/launcher-provision
/// checks: shebang, orch-head,
/// strict-shell, bun-zip,
/// version-pin, image-pin,
/// rev-parse-top, root-var,
/// out-assign, work-assign,
/// mkdir-cmd, provenance-head,
/// provenance-file, heredoc-fence,
/// py-imports, size-mismatch,
/// digest-mismatch, archive-ok,
/// source-rev, hash-call,
/// env-default-count, out-dir-count,
/// provenance-assert-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str shebang
    str orch_head
    str strict_shell
    str bun_zip
    str version_pin
    str image_pin
    str rev_parse_top
    str root_var
    str out_assign
    str work_assign
    str mkdir_cmd
    str provenance_head
    str provenance_file
    str heredoc_fence
    str py_imports
    str size_mismatch
    str digest_mismatch
    str archive_ok
    str source_rev
    str hash_call
    int env_default_count
    int out_dir_count
    int provenance_assert_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("linux/launcher-provision", "default", "", "offline"), "shebang" => ok "case linux/launcher-provision variant default root shebang run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("linux/launcher-provision", "default", "", "offline"), "shebang" => ok evidence("shebang", "true", "true", true, "case linux/launcher-provision variant default root shebang run offline")
        different: false, true, context("linux/launcher-provision", "default", "", "offline"), "shebang" => failed{"shebang"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("linux/launcher-provision", "default", "", "offline"), "env-default-count" => ok evidence("env-default-count", "3", "3", true, "case linux/launcher-provision variant default root env-default-count run offline")
        different: 2, 3, context("linux/launcher-provision", "default", "", "offline"), "env-default-count" => failed{"env-default-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "#!/bin/sh", "#!/bin/sh", context("linux/launcher-provision", "default", "", "offline"), "shebang" => ok evidence("shebang", "#!/bin/sh", "#!/bin/sh", true, "case linux/launcher-provision variant default root shebang run offline")
        different: "#!/bin/sh_2", "#!/bin/sh", context("linux/launcher-provision", "default", "", "offline"), "shebang" => failed{"shebang"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("#!/bin/sh", "T19 host orchestrator", "set -eu", "bun-linux-x64.zip", "t19-1", "can-linux/t19", "git rev-parse --show-toplevel", "$ROOT", "OUT=", "WORK=", "mkdir -p", "--- provenance check", "distribution/linux/provenance.json", "<<'PY'", "import hashlib, json, sys", "archive size mismatch", "archive digest mismatch", "archive ok:", "sourceRevision=", "hashlib.sha256", 3, 2, 2)
        seed_shebang: "seed-shebang-drift" => ok observation("#!/bin/sh_2", "T19 host orchestrator", "set -eu", "bun-linux-x64.zip", "t19-1", "can-linux/t19", "git rev-parse --show-toplevel", "$ROOT", "OUT=", "WORK=", "mkdir -p", "--- provenance check", "distribution/linux/provenance.json", "<<'PY'", "import hashlib, json, sys", "archive size mismatch", "archive digest mismatch", "archive ok:", "sourceRevision=", "hashlib.sha256", 3, 2, 2)
