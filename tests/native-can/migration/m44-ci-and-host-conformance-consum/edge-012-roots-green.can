package m44edge012roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-012 "Linux
/// provisioning/launcher" build plus
/// smoke pact.
/// Source:
/// distribution/linux/run.sh
/// symbol "Linux
/// provisioning/launcher" (L33-46):
/// pinned image build plus release
/// plus smoke call.
/// Disposition: rewire (same row pact
/// as the provision slice; this file
/// owns the build plus smoke call
/// spellings).
/// Protects (this file): image build
/// plus release mounts plus env plus
/// smoke call plus tallies that
/// bound launch.
/// ADAPTATION (noted, plus source
/// lines): verb pins hold docker
/// spellings; mount pins hold -v
/// bytes; env pins hold -e bytes;
/// count pins hold ints tallied
/// from L33-46.
/// build-head pins --- image build
/// (L33); build-verb pins docker
/// build (L34); platform-flag pins
/// --platform linux/amd64 (L34 plus
/// L37 plus L43 plus L50 plus L54
/// plus L58 plus L63);
/// dockerfile-flag pins -f
/// distribution/linux/Dockerfile
/// (L34); tag-flag pins -t plus gap
/// (L34); release-head pins ---
/// release (L36); run-verb pins
/// docker run (L37 plus L43 plus L54
/// plus L58 plus L63); rm-flag pins
/// --rm (same five lines);
/// archive-path pins /archive/bun.zip
/// (L38 plus L39 plus L44 plus L45);
/// bun-var pins BUN_ARCHIVE (eight
/// hits file-wide); ro-flag pins :ro
/// (L38 plus L44 twice); out-var
/// pins $OUT (L20 plus L38 plus L44
/// plus L69); bun-env pins
/// BUN_ARCHIVE=/archive/bun.zip
/// (L39 plus L45); version-var pins
/// VERSION (L13 plus L39 twice plus
/// L45 twice); build-script pins
/// /src/distribution/linux/build.sh
/// (L40); smoke-head pins ---
/// install and smoke (no network)
/// (L42); none-net pins --network
/// none (L43); work-var pins $WORK
/// (L20 plus L44 plus L64 plus L70);
/// smoke-script pins
/// /src/distribution/linux/smoke.sh
/// (L46); env-flag pins -e plus gap
/// (seven hits file-wide);
/// run-count pins int (5) from L37
/// plus L43 plus L54 plus L58 plus
/// L63; platform-count pins int (7)
/// from L34 plus L37 plus L43 plus
/// L50 plus L54 plus L58 plus L63;
/// stage-head-count pins int (3)
/// from L33 plus L36 plus L42.
/// Facet map (build then smoke order):
/// build-head, build-verb,
/// platform-flag, dockerfile-flag,
/// tag-flag, release-head,
/// run-verb, rm-flag,
/// archive-path, bun-var, ro-flag,
/// out-var, bun-env, version-var,
/// build-script, smoke-head,
/// none-net, work-var,
/// smoke-script, env-flag,
/// run-count, platform-count,
/// stage-head-count.
/// The provision pins live in
/// edge-012-base-semantics.can; the
/// postgres plus done pins live in
/// edge-012-run-shape.can.
/// Variants: none listed (row lists
/// zero variants).
/// Environment: no gates listed (binds
/// at P23; no live run now).
/// Logical gates ENV/WORK/PROC bind
/// at P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 plus LIFE-013 Linux
/// slices (no qualified report yet;
/// P23/QD1/QN1 unmet).
/// Rewire stays blocked; run.sh stays
/// intact; no call retired.
/// Related:
/// distribution/linux/smoke.sh
/// (invoked by the caller; owned
/// outside M44).
/// Case linux/launcher-build-smoke
/// checks: build-head, build-verb,
/// platform-flag, dockerfile-flag,
/// tag-flag, release-head,
/// run-verb, rm-flag,
/// archive-path, bun-var, ro-flag,
/// out-var, bun-env, version-var,
/// build-script, smoke-head,
/// none-net, work-var,
/// smoke-script, env-flag,
/// run-count, platform-count,
/// stage-head-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str build_head
    str build_verb
    str platform_flag
    str dockerfile_flag
    str tag_flag
    str release_head
    str run_verb
    str rm_flag
    str archive_path
    str bun_var
    str ro_flag
    str out_var
    str bun_env
    str version_var
    str build_script
    str smoke_head
    str none_net
    str work_var
    str smoke_script
    str env_flag
    int run_count
    int platform_count
    int stage_head_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("linux/launcher-build-smoke", "default", "", "offline"), "build-head" => ok "case linux/launcher-build-smoke variant default root build-head run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("linux/launcher-build-smoke", "default", "", "offline"), "build-head" => ok evidence("build-head", "true", "true", true, "case linux/launcher-build-smoke variant default root build-head run offline")
        different: false, true, context("linux/launcher-build-smoke", "default", "", "offline"), "build-head" => failed{"build-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("linux/launcher-build-smoke", "default", "", "offline"), "run-count" => ok evidence("run-count", "5", "5", true, "case linux/launcher-build-smoke variant default root run-count run offline")
        different: 4, 5, context("linux/launcher-build-smoke", "default", "", "offline"), "run-count" => failed{"run-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "--- image build", "--- image build", context("linux/launcher-build-smoke", "default", "", "offline"), "build-head" => ok evidence("build-head", "--- image build", "--- image build", true, "case linux/launcher-build-smoke variant default root build-head run offline")
        different: "--- image build_2", "--- image build", context("linux/launcher-build-smoke", "default", "", "offline"), "build-head" => failed{"build-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
