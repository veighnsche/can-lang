fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("linux/launcher-postgres-done", "default", "", "offline") => ok
        seed_pg_head: context("linux/launcher-postgres-done", "seed-pg-head-drift", "", "offline") => failed{"pg-head"}
        seed_prov_var: context("linux/launcher-postgres-done", "seed-prov-var-drift", "", "offline") => failed{"prov-var"}
        seed_pg_qualifier: context("linux/launcher-postgres-done", "seed-pg-qualifier-drift", "", "offline") => failed{"pg-qualifier"}
        seed_pg_digest: context("linux/launcher-postgres-done", "seed-pg-digest-drift", "", "offline") => failed{"pg-digest"}
        seed_pull_verb: context("linux/launcher-postgres-done", "seed-pull-verb-drift", "", "offline") => failed{"pull-verb"}
        seed_pg_image: context("linux/launcher-postgres-done", "seed-pg-image-drift", "", "offline") => failed{"pg-image"}
        seed_null_sink: context("linux/launcher-postgres-done", "seed-null-sink-drift", "", "offline") => failed{"null-sink"}
        seed_net_create: context("linux/launcher-postgres-done", "seed-net-create-drift", "", "offline") => failed{"net-create"}
        seed_smoke_net: context("linux/launcher-postgres-done", "seed-smoke-net-drift", "", "offline") => failed{"smoke-net"}
        seed_stderr_merge: context("linux/launcher-postgres-done", "seed-stderr-merge-drift", "", "offline") => failed{"stderr-merge"}
        seed_true_guard: context("linux/launcher-postgres-done", "seed-true-guard-drift", "", "offline") => failed{"true-guard"}
        seed_cleanup_fn: context("linux/launcher-postgres-done", "seed-cleanup-fn-drift", "", "offline") => failed{"cleanup-fn"}
        seed_pg_name: context("linux/launcher-postgres-done", "seed-pg-name-drift", "", "offline") => failed{"pg-name"}
        seed_trap_line: context("linux/launcher-postgres-done", "seed-trap-line-drift", "", "offline") => failed{"trap-line"}
        seed_run_detached: context("linux/launcher-postgres-done", "seed-run-detached-drift", "", "offline") => failed{"run-detached"}
        seed_net_flag: context("linux/launcher-postgres-done", "seed-net-flag-drift", "", "offline") => failed{"net-flag"}
        seed_db_env: context("linux/launcher-postgres-done", "seed-db-env-drift", "", "offline") => failed{"db-env"}
        seed_retry_bound: context("linux/launcher-postgres-done", "seed-retry-bound-drift", "", "offline") => failed{"retry-bound"}
        seed_ready_probe: context("linux/launcher-postgres-done", "seed-ready-probe-drift", "", "offline") => failed{"ready-probe"}
        seed_pg_script: context("linux/launcher-postgres-done", "seed-pg-script-drift", "", "offline") => failed{"pg-script"}
        seed_db_url_var: context("linux/launcher-postgres-done", "seed-db-url-var-drift", "", "offline") => failed{"db-url-var"}
        seed_done_head: context("linux/launcher-postgres-done", "seed-done-head-drift", "", "offline") => failed{"done-head"}
        seed_reports_line: context("linux/launcher-postgres-done", "seed-reports-line-drift", "", "offline") => failed{"reports-line"}
        seed_pg_ref_count: context("linux/launcher-postgres-done", "seed-pg-ref-count-drift", "", "offline") => failed{"pg-ref-count"}
        seed_stderr_merge_count: context("linux/launcher-postgres-done", "seed-stderr-merge-count-drift", "", "offline") => failed{"stderr-merge-count"}
        seed_ready_retry_bound: context("linux/launcher-postgres-done", "seed-ready-retry-bound-drift", "", "offline") => failed{"ready-retry-bound"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.pg_head, "--- postgres leg", c, "pg-head")
            failed
            ok evidence pg_head_evidence => match call require_text(got.prov_var, "PROV_PG", c, "prov-var")
                failed
                ok evidence prov_var_evidence => match call require_text(got.pg_qualifier, "postgresQualificationImage", c, "pg-qualifier")
                    failed
                    ok evidence pg_qualifier_evidence => match call require_text(got.pg_digest, "amd64ManifestDigest", c, "pg-digest")
                        failed
                        ok evidence pg_digest_evidence => match call require_text(got.pull_verb, "docker pull", c, "pull-verb")
                            failed
