package m44edge012run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-012 "Linux
/// provisioning/launcher" postgres
/// plus done pact.
/// Source:
/// distribution/linux/run.sh
/// symbol "Linux
/// provisioning/launcher" (L48-70):
/// pinned postgres leg plus done
/// plus report dirs.
/// Disposition: rewire (same row pact
/// as the provision slice; this file
/// owns the postgres plus done
/// spellings).
/// Protects (this file): postgres
/// provision plus readiness plus pg
/// call plus done plus tallies that
/// bound the leg.
/// ADAPTATION (noted, plus source
/// lines): name pins hold docker
/// spellings; net pins hold network
/// bytes; probe pins hold pg bytes;
/// count pins hold ints tallied
/// from L49-60.
/// pg-head pins --- postgres leg
/// (L48); prov-var pins PROV_PG
/// (L49 plus L50 plus L56 plus L59);
/// pg-qualifier pins
/// postgresQualificationImage (L49);
/// pg-digest pins amd64ManifestDigest
/// (L49); pull-verb pins docker pull
/// (L50); pg-image pins
/// docker.io/library/postgres:17@
/// (L50 plus L56 plus L59);
/// null-sink pins >/dev/null (eight
/// hits file-wide); net-create pins
/// docker network create (L51);
/// smoke-net pins can-t19-smoke
/// (five hits file-wide);
/// stderr-merge pins 2>&1 (L51 plus
/// L52 twice plus L60); true-guard
/// pins || true (L51 plus L52 twice);
/// cleanup-fn pins cleanup() (L52);
/// pg-name pins can-t19-pg (L52 plus
/// L54 plus L60 plus L65);
/// trap-line pins trap cleanup EXIT
/// (L53); run-detached pins docker
/// run -d (L54); net-flag pins
/// --network can-t19-smoke (L54 plus
/// L58 plus L63); db-env pins
/// POSTGRES_DB=smoke (L55; second -e
/// var on L55 noted but not pinned);
/// retry-bound pins seq 1 60 (L57);
/// ready-probe pins pg_isready (L60);
/// pg-script pins
/// /src/distribution/linux/postgres.sh
/// (L66); db-url-var pins
/// DATABASE_URL (L65; name only, no
/// value pinned); done-head pins
/// --- done (L68); reports-line pins
/// reports: plus gaps plus
/// $WORK/reports (L70);
/// pg-ref-count pins int (3) from
/// L50 plus L56 plus L59;
/// stderr-merge-count pins int (4)
/// from L51 plus L52 twice plus L60;
/// ready-retry-bound pins int (60)
/// from L57.
/// Facet map (leg then done order):
/// pg-head, prov-var,
/// pg-qualifier, pg-digest,
/// pull-verb, pg-image, null-sink,
/// net-create, smoke-net,
/// stderr-merge, true-guard,
/// cleanup-fn, pg-name, trap-line,
/// run-detached, net-flag, db-env,
/// retry-bound, ready-probe,
/// pg-script, db-url-var,
/// done-head, reports-line,
/// pg-ref-count,
/// stderr-merge-count,
/// ready-retry-bound.
/// The provision pins live in
/// edge-012-base-semantics.can; the
/// build plus smoke pins live in
/// edge-012-roots-green.can.
/// Variants: none listed (row lists
/// zero variants).
/// Environment: no gates listed (binds
/// at P23; no live run now).
/// Logical gates ENV/WORK/PROC bind
/// at P23; no live run now.
/// Timeout 120000ms is the offline
/// default bound (binds at P23 like
/// the M31 no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 plus LIFE-013 Linux
/// slices (no qualified report yet;
/// P23/QD1/QN1 unmet).
/// Rewire stays blocked; run.sh stays
/// intact; no call retired.
/// Related:
/// distribution/linux/smoke.sh
/// (invoked by the caller; owned
/// outside M44).
/// Case linux/launcher-postgres-done
/// checks: pg-head, prov-var,
/// pg-qualifier, pg-digest,
/// pull-verb, pg-image, null-sink,
/// net-create, smoke-net,
/// stderr-merge, true-guard,
/// cleanup-fn, pg-name, trap-line,
/// run-detached, net-flag, db-env,
/// retry-bound, ready-probe,
/// pg-script, db-url-var,
/// done-head, reports-line,
/// pg-ref-count,
/// stderr-merge-count,
/// ready-retry-bound.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str pg_head
    str prov_var
    str pg_qualifier
    str pg_digest
    str pull_verb
    str pg_image
    str null_sink
    str net_create
    str smoke_net
    str stderr_merge
    str true_guard
    str cleanup_fn
    str pg_name
    str trap_line
    str run_detached
    str net_flag
    str db_env
    str retry_bound
    str ready_probe
    str pg_script
    str db_url_var
    str done_head
    str reports_line
    int pg_ref_count
    int stderr_merge_count
    int ready_retry_bound
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("linux/launcher-postgres-done", "default", "", "offline"), "pg-head" => ok "case linux/launcher-postgres-done variant default root pg-head run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("linux/launcher-postgres-done", "default", "", "offline"), "pg-head" => ok evidence("pg-head", "true", "true", true, "case linux/launcher-postgres-done variant default root pg-head run offline")
        different: false, true, context("linux/launcher-postgres-done", "default", "", "offline"), "pg-head" => failed{"pg-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("linux/launcher-postgres-done", "default", "", "offline"), "pg-ref-count" => ok evidence("pg-ref-count", "3", "3", true, "case linux/launcher-postgres-done variant default root pg-ref-count run offline")
        different: 2, 3, context("linux/launcher-postgres-done", "default", "", "offline"), "pg-ref-count" => failed{"pg-ref-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "--- postgres leg", "--- postgres leg", context("linux/launcher-postgres-done", "default", "", "offline"), "pg-head" => ok evidence("pg-head", "--- postgres leg", "--- postgres leg", true, "case linux/launcher-postgres-done variant default root pg-head run offline")
        different: "--- postgres leg_2", "--- postgres leg", context("linux/launcher-postgres-done", "default", "", "offline"), "pg-head" => failed{"pg-head"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("--- postgres leg", "PROV_PG", "postgresQualificationImage", "amd64ManifestDigest", "docker pull", "docker.io/library/postgres:17@", ">/dev/null", "docker network create", "can-t19-smoke", "2>&1", "|| true", "cleanup()", "can-t19-pg", "trap cleanup EXIT", "docker run -d", "--network can-t19-smoke", "POSTGRES_DB=smoke", "seq 1 60", "pg_isready", "/src/distribution/linux/postgres.sh", "DATABASE_URL", "--- done", "reports:   $WORK/reports", 3, 4, 60)
        seed_pg_head: "seed-pg-head-drift" => ok observation("--- postgres leg_2", "PROV_PG", "postgresQualificationImage", "amd64ManifestDigest", "docker pull", "docker.io/library/postgres:17@", ">/dev/null", "docker network create", "can-t19-smoke", "2>&1", "|| true", "cleanup()", "can-t19-pg", "trap cleanup EXIT", "docker run -d", "--network can-t19-smoke", "POSTGRES_DB=smoke", "seq 1 60", "pg_isready", "/src/distribution/linux/postgres.sh", "DATABASE_URL", "--- done", "reports:   $WORK/reports", 3, 4, 60)
