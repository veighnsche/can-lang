    asserts
        m44_e012: "m44-e012" => ok [check("pg-head", "pg head keeps its bytes"), check("prov-var", "prov var keeps its spelling"), check("pg-qualifier", "pg qualifier keeps its bytes"), check("pg-digest", "pg digest keeps its bytes"), check("pull-verb", "pull verb keeps its bytes"), check("pg-image", "pg image keeps its bytes"), check("null-sink", "null sink keeps its bytes"), check("net-create", "net create keeps its bytes"), check("smoke-net", "smoke net keeps its bytes"), check("stderr-merge", "stderr merge keeps its bytes"), check("true-guard", "true guard keeps its bytes"), check("cleanup-fn", "cleanup fn keeps its spelling"), check("pg-name", "pg name keeps its bytes"), check("trap-line", "trap line keeps its bytes"), check("run-detached", "run detached keeps its bytes"), check("net-flag", "net flag keeps its bytes"), check("db-env", "db env keeps its bytes"), check("retry-bound", "retry bound keeps its bytes"), check("ready-probe", "ready probe keeps its spelling"), check("pg-script", "pg script keeps its bytes"), check("db-url-var", "db url var keeps its spelling"), check("done-head", "done head keeps its bytes"), check("reports-line", "reports line keeps its bytes"), check("pg-ref-count", "three pg refs exist"), check("stderr-merge-count", "four stderr merges exist"), check("ready-retry-bound", "retry bound is sixty")]
