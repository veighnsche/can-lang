package m44edge013base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-013 "qualification
/// prerequisites plus browser-path
/// preflight" caller pact.
/// Source: distribution/h12/
/// window-check.sh
/// symbol "qualification
/// prerequisites plus browser-path
/// preflight" (L1-65): pinned script
/// identity plus verdict helpers plus
/// host plus emulation probes.
/// Disposition: rewire (this row owns the
/// caller pact as reviewable Can
/// facts; old shell call stays until
/// integrator rewires it after each linked
/// row, variant, plus gate has accepted
/// proof).
/// Protects (this file): the script head
/// plus helper defs plus host probes
/// (L19-39) plus emulation probes
/// (L41-65) plus tallies that bound the
/// head.
/// ADAPTATION (noted, plus source lines):
/// name pins hold caller spellings; probe
/// pins hold shell probe bytes; count pins
/// hold ints tallied from L6 plus L15-17
/// plus L19 plus L41.
/// shebang-line pins #!/bin/sh (L1);
/// window-tag pins H12 UP25 (L2);
/// usage-name pins window-check.sh (L7);
/// target-path pins
/// distribution/target-linux-amd64.json
/// (L11); fail-init pins fail=0 (L12);
/// warn-init pins warn=0 (L13);
/// pass-body pins PASS: $1 (L15);
/// block-body pins BLOCKED: $1 (L16);
/// note-body pins warn=$((warn + 1))
/// (L17); arch-probe pins uname -m (L20
/// plus L21, three hits); arch-want pins
/// x86_64 (L21 twice plus L42);
/// os-release-path pins /etc/os-release
/// (L22 plus L24 plus L33); version-id-name
/// pins VERSION_ID (L25 twice plus L27
/// plus L28 twice); major-name pins MAJOR
/// (L27 plus L28); debian-floor pins -ge 13
/// (L28); glibc-probe pins getconf
/// GNU_LIBC_VERSION (L35 plus L36 plus
/// L38); qemu-name pins qemu-x86_64 (L42);
/// qemu-glob pins /usr/bin/qemu-* (L42);
/// docker-probe pins docker ps --format
/// (L48); emu-platform pins linux/amd64
/// (L41 plus L48 plus L49 plus L51);
/// dockerenv-path pins /.dockerenv (L56
/// plus L57); pid1-environ pins
/// /proc/1/environ (L61); container-needle
/// pins container= (L61); helper-count pins
/// int (3) from L15-17; banner-count pins
/// int (2) from L19 plus L41; env-name-count
/// pins int (2) from L6.
/// Facet map (head then probe order):
/// shebang-line, window-tag,
/// usage-name, target-path, fail-init,
/// warn-init, pass-body, block-body,
/// note-body, arch-probe, arch-want,
/// os-release-path, version-id-name,
/// major-name, debian-floor, glibc-probe,
/// qemu-name, qemu-glob, docker-probe,
/// emu-platform, dockerenv-path,
/// pid1-environ, container-needle,
/// helper-count, banner-count,
/// env-name-count.
/// The toolchain plus archive roots live in
/// edge-013-roots-green.can; the verdict
/// shape plus summaries live in
/// edge-013-run-shape.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates SUITE/BUILD/B1/ENV/WORK
/// bind at P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet).
/// Rewire stays blocked; window-check.sh
/// intact; no call retired.
/// Case edge/preflight-host
/// checks: shebang-line, window-tag,
/// usage-name, target-path, fail-init,
/// warn-init, pass-body, block-body,
/// note-body, arch-probe, arch-want,
/// os-release-path, version-id-name,
/// major-name, debian-floor, glibc-probe,
/// qemu-name, qemu-glob, docker-probe,
/// emu-platform, dockerenv-path,
/// pid1-environ, container-needle,
/// helper-count, banner-count,
/// env-name-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str shebang_line
    str window_tag
    str usage_name
    str target_path
    str fail_init
    str warn_init
    str pass_body
    str block_body
    str note_body
    str arch_probe
    str arch_want
    str os_release_path
    str version_id_name
    str major_name
    str debian_floor
    str glibc_probe
    str qemu_name
    str qemu_glob
    str docker_probe
    str emu_platform
    str dockerenv_path
    str pid1_environ
    str container_needle
    int helper_count
    int banner_count
    int env_name_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/preflight-host", "default", "", "offline"), "shebang-line" => ok "case edge/preflight-host variant default root shebang-line run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/preflight-host", "default", "", "offline"), "shebang-line" => ok evidence("shebang-line", "true", "true", true, "case edge/preflight-host variant default root shebang-line run offline")
        different: false, true, context("edge/preflight-host", "default", "", "offline"), "shebang-line" => failed{"shebang-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("edge/preflight-host", "default", "", "offline"), "helper-count" => ok evidence("helper-count", "3", "3", true, "case edge/preflight-host variant default root helper-count run offline")
        different: 2, 3, context("edge/preflight-host", "default", "", "offline"), "helper-count" => failed{"helper-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "#!/bin/sh", "#!/bin/sh", context("edge/preflight-host", "default", "", "offline"), "shebang-line" => ok evidence("shebang-line", "#!/bin/sh", "#!/bin/sh", true, "case edge/preflight-host variant default root shebang-line run offline")
        different: "#!/bin/sh_2", "#!/bin/sh", context("edge/preflight-host", "default", "", "offline"), "shebang-line" => failed{"shebang-line"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("#!/bin/sh", "H12 UP25", "window-check.sh", "distribution/target-linux-amd64.json", "fail=0", "warn=0", "PASS: $1", "BLOCKED: $1", "warn=$((warn + 1))", "uname -m", "x86_64", "/etc/os-release", "VERSION_ID", "MAJOR", "-ge 13", "getconf GNU_LIBC_VERSION", "qemu-x86_64", "/usr/bin/qemu-*", "docker ps --format", "linux/amd64", "/.dockerenv", "/proc/1/environ", "container=", 3, 2, 2)
        seed_shebang_line: "seed-shebang-line-drift" => ok observation("#!/bin/sh_2", "H12 UP25", "window-check.sh", "distribution/target-linux-amd64.json", "fail=0", "warn=0", "PASS: $1", "BLOCKED: $1", "warn=$((warn + 1))", "uname -m", "x86_64", "/etc/os-release", "VERSION_ID", "MAJOR", "-ge 13", "getconf GNU_LIBC_VERSION", "qemu-x86_64", "/usr/bin/qemu-*", "docker ps --format", "linux/amd64", "/.dockerenv", "/proc/1/environ", "container=", 3, 2, 2)
