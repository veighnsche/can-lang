package m44edge013roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-013 "qualification
/// prerequisites plus browser-path
/// preflight" caller pact.
/// Source: distribution/h12/
/// window-check.sh
/// symbol "qualification
/// prerequisites plus browser-path
/// preflight" (L67-100): pinned tooling
/// plus embedded archive check.
/// Disposition: rewire (this row owns the
/// caller pact as reviewable Can
/// facts; old shell call stays until
/// integrator rewires it after each linked
/// row, variant, plus gate has accepted
/// proof).
/// Protects (this file): the four tool
/// probes (L68-84, plus the stale
/// qualify.py note) plus the archive env
/// plus embedded python size plus digest
/// check (L86-100) plus tallies that bound
/// the span.
/// ADAPTATION (noted, plus source lines):
/// probe pins hold tool spellings; want
/// pins hold pinned versions; check pins
/// hold embedded python bytes; count pins
/// hold ints tallied from L67-68 plus
/// L74 plus L83-84 plus L96-97.
/// probe-bun pins command -v bun (L68);
/// bun-version-call pins bun --version
/// (L69); want-bun pins 1.4.2 (L70 twice);
/// probe-go pins command -v go (L74);
/// go-version-call pins go version (L75
/// plus L77); want-go pins go1.27.1 (L77
/// plus L78 plus L81); probe-gcc pins
/// command -v gcc (L83); gcc-dump-call
/// pins gcc -dumpversion (L83); probe-python
/// pins command -v python3 (L84);
/// python-version-call pins python3
/// --version (L84); stale-qualify-need pins
/// qualify.py needs it (L84, stale Python
/// assumption kept as fact); archive-env
/// pins CAN_BUN_ARCHIVE (L6 plus L87-90
/// plus L92, seven hits); archive-kind pins
/// bun-linux-x64.zip (L88); py-heredoc pins
/// <<'PY' (L92); py-imports pins import
/// hashlib, json, sys (L93); argv-use pins
/// sys.argv (L94 plus L95); upstream-field
/// pins upstream (L96 plus L97); len-call
/// pins len(archive) (L96 plus L98);
/// digest-call pins hexdigest (L97 plus
/// L98); size-msg pins archive size
/// mismatch (L96); digest-msg pins archive
/// digest mismatch (L97); target-id-name
/// pins targetId (L98); archive-pass pins
/// PASS: archive (L98); tool-probe-count
/// pins int (4) from L68 plus L74 plus
/// L83-84; archive-assert-count pins int
/// (2) from L96-97; banner-count pins int
/// (2) from L67 plus L86.
/// Facet map (tool then check order):
/// probe-bun, bun-version-call,
/// want-bun, probe-go, go-version-call,
/// want-go, probe-gcc, gcc-dump-call,
/// probe-python, python-version-call,
/// stale-qualify-need, archive-env,
/// archive-kind, py-heredoc, py-imports,
/// argv-use, upstream-field, len-call,
/// digest-call, size-msg, digest-msg,
/// target-id-name, archive-pass,
/// tool-probe-count, archive-assert-count,
/// banner-count.
/// The host plus emulation probes live in
/// edge-013-base-semantics.can; the verdict
/// shape plus summaries live in
/// edge-013-run-shape.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates SUITE/BUILD/B1/ENV/WORK
/// bind at P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet).
/// Rewire stays blocked; window-check.sh
/// intact; no call retired.
/// Case edge/preflight-toolchain
/// checks: probe-bun, bun-version-call,
/// want-bun, probe-go, go-version-call,
/// want-go, probe-gcc, gcc-dump-call,
/// probe-python, python-version-call,
/// stale-qualify-need, archive-env,
/// archive-kind, py-heredoc, py-imports,
/// argv-use, upstream-field, len-call,
/// digest-call, size-msg, digest-msg,
/// target-id-name, archive-pass,
/// tool-probe-count, archive-assert-count,
/// banner-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str probe_bun
    str bun_version_call
    str want_bun
    str probe_go
    str go_version_call
    str want_go
    str probe_gcc
    str gcc_dump_call
    str probe_python
    str python_version_call
    str stale_qualify_need
    str archive_env
    str archive_kind
    str py_heredoc
    str py_imports
    str argv_use
    str upstream_field
    str len_call
    str digest_call
    str size_msg
    str digest_msg
    str target_id_name
    str archive_pass
    int tool_probe_count
    int archive_assert_count
    int banner_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/preflight-toolchain", "default", "", "offline"), "probe-bun" => ok "case edge/preflight-toolchain variant default root probe-bun run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/preflight-toolchain", "default", "", "offline"), "probe-bun" => ok evidence("probe-bun", "true", "true", true, "case edge/preflight-toolchain variant default root probe-bun run offline")
        different: false, true, context("edge/preflight-toolchain", "default", "", "offline"), "probe-bun" => failed{"probe-bun"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("edge/preflight-toolchain", "default", "", "offline"), "tool-probe-count" => ok evidence("tool-probe-count", "4", "4", true, "case edge/preflight-toolchain variant default root tool-probe-count run offline")
        different: 3, 4, context("edge/preflight-toolchain", "default", "", "offline"), "tool-probe-count" => failed{"tool-probe-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "command -v bun", "command -v bun", context("edge/preflight-toolchain", "default", "", "offline"), "probe-bun" => ok evidence("probe-bun", "command -v bun", "command -v bun", true, "case edge/preflight-toolchain variant default root probe-bun run offline")
        different: "command -v bun_2", "command -v bun", context("edge/preflight-toolchain", "default", "", "offline"), "probe-bun" => failed{"probe-bun"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("command -v bun", "bun --version", "1.4.2", "command -v go", "go version", "go1.27.1", "command -v gcc", "gcc -dumpversion", "command -v python3", "python3 --version", "qualify.py needs it", "CAN_BUN_ARCHIVE", "bun-linux-x64.zip", "<<'PY'", "import hashlib, json, sys", "sys.argv", "upstream", "len(archive)", "hexdigest", "archive size mismatch", "archive digest mismatch", "targetId", "PASS: archive", 4, 2, 2)
