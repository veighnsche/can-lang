package m44edge013run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M44 EDGE-013 "qualification
/// prerequisites plus browser-path
/// preflight" caller pact.
/// Source: distribution/h12/
/// window-check.sh
/// symbol "qualification
/// prerequisites plus browser-path
/// preflight" (L102-132): offline plus
/// browser plus verdict summaries.
/// Disposition: rewire (this row owns the
/// caller pact as reviewable Can
/// facts; old shell call stays until
/// integrator rewires it after each linked
/// row, variant, plus gate has accepted
/// proof).
/// Protects (this file): the offline gate
/// (L102-107) plus the old-browser leg
/// (L109-118, stale dir kept as fact)
/// plus db env names (L120-125, names
/// only; values never pinned) plus the
/// verdict summaries (L127-132) plus
/// tallies that bound the span.
/// ADAPTATION (noted, plus source lines):
/// gate pins hold offline spellings; dir
/// pins hold browser path bytes; verdict
/// pins hold summary bytes; count pins
/// hold ints tallied from L102 plus L109
/// plus L120 plus L127-132.
/// unshare-flag pins unshare -n (L103 plus
/// L104 plus L106); offline-note pins outer
/// offline wrapper (L104); no-fallback-note
/// pins no quiet fallback (L106);
/// old-browser-tag pins old-browser leg
/// (L109); browser-dir pins
/// tests/integration/browser (L110 plus L111
/// plus L117); playwright-call pins bunx
/// --bun playwright@1.55.1 --version (L111);
/// playwright-pass pins playwright 1.55.1
/// resolvable (L112); want-playwright pins
/// 1.55.1 (L111 twice plus L112 plus L114);
/// db-env pins DATABASE_URL (L6 plus L121
/// plus L122 plus L124); never-printed-note
/// pins value never printed (L124);
/// entry-blocked pins WINDOW-ENTRY: BLOCKED
/// (L129); entry-ready pins WINDOW-ENTRY:
/// READY (L132); blocked-tally-words pins
/// blocking failures (L129);
/// ready-tally-words pins notes to clear
/// (L132); fail-use pins $fail (L128 plus
/// L129); warn-use pins $warn (L129 plus
/// L132); banner-count pins int (4) from
/// L102 plus L109 plus L120 plus L127;
/// verdict-line-count pins int (2) from
/// L129 plus L132; fail-use-count pins int
/// (2) from L128-129; warn-use-count pins
/// int (2) from L129 plus L132.
/// Facet map (gate then verdict order):
/// unshare-flag, offline-note,
/// no-fallback-note, old-browser-tag,
/// browser-dir, playwright-call,
/// playwright-pass, want-playwright, db-env,
/// never-printed-note, entry-blocked,
/// entry-ready, blocked-tally-words,
/// ready-tally-words, fail-use, warn-use,
/// banner-count, verdict-line-count,
/// fail-use-count, warn-use-count.
/// The host plus emulation probes live in
/// edge-013-base-semantics.can; the
/// toolchain plus archive roots live in
/// edge-013-roots-green.can.
/// Variants: none listed (row lists zero
/// variants; one default run).
/// Environment: none listed (row lists
/// zero gates; bind at P23; no live run
/// now).
/// Logical gates SUITE/BUILD/B1/ENV/WORK
/// bind at P23; no live run now.
/// Timeout 120000ms is the offline default
/// bound (binds at P23 like the M37
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: none exists
/// (no P23-qualified Can report yet; P23
/// unmet).
/// Rewire stays blocked; window-check.sh
/// intact; no call retired.
/// Case edge/preflight-verdict
/// checks: unshare-flag, offline-note,
/// no-fallback-note, old-browser-tag,
/// browser-dir, playwright-call,
/// playwright-pass, want-playwright, db-env,
/// never-printed-note, entry-blocked,
/// entry-ready, blocked-tally-words,
/// ready-tally-words, fail-use, warn-use,
/// banner-count, verdict-line-count,
/// fail-use-count, warn-use-count.
/// Shared old files intact; retirement is a
/// later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str unshare_flag
    str offline_note
    str no_fallback_note
    str old_browser_tag
    str browser_dir
    str playwright_call
    str playwright_pass
    str want_playwright
    str db_env
    str never_printed_note
    str entry_blocked
    str entry_ready
    str blocked_tally_words
    str ready_tally_words
    str fail_use
    str warn_use
    int banner_count
    int verdict_line_count
    int fail_use_count
    int warn_use_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/preflight-verdict", "default", "", "offline"), "unshare-flag" => ok "case edge/preflight-verdict variant default root unshare-flag run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/preflight-verdict", "default", "", "offline"), "unshare-flag" => ok evidence("unshare-flag", "true", "true", true, "case edge/preflight-verdict variant default root unshare-flag run offline")
        different: false, true, context("edge/preflight-verdict", "default", "", "offline"), "unshare-flag" => failed{"unshare-flag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 4, 4, context("edge/preflight-verdict", "default", "", "offline"), "banner-count" => ok evidence("banner-count", "4", "4", true, "case edge/preflight-verdict variant default root banner-count run offline")
        different: 3, 4, context("edge/preflight-verdict", "default", "", "offline"), "banner-count" => failed{"banner-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "unshare -n", "unshare -n", context("edge/preflight-verdict", "default", "", "offline"), "unshare-flag" => ok evidence("unshare-flag", "unshare -n", "unshare -n", true, "case edge/preflight-verdict variant default root unshare-flag run offline")
        different: "unshare -n_2", "unshare -n", context("edge/preflight-verdict", "default", "", "offline"), "unshare-flag" => failed{"unshare-flag"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("unshare -n", "outer offline wrapper", "no quiet fallback", "old-browser leg", "tests/integration/browser", "bunx --bun playwright@1.55.1 --version", "playwright 1.55.1 resolvable", "1.55.1", "DATABASE_URL", "value never printed", "WINDOW-ENTRY: BLOCKED", "WINDOW-ENTRY: READY", "blocking failures", "notes to clear", "$fail", "$warn", 4, 2, 2, 2)
        seed_unshare_flag: "seed-unshare-flag-drift" => ok observation("unshare -n_2", "outer offline wrapper", "no quiet fallback", "old-browser leg", "tests/integration/browser", "bunx --bun playwright@1.55.1 --version", "playwright 1.55.1 resolvable", "1.55.1", "DATABASE_URL", "value never printed", "WINDOW-ENTRY: BLOCKED", "WINDOW-ENTRY: READY", "blocking failures", "notes to clear", "$fail", "$warn", 4, 2, 2, 2)
        seed_offline_note: "seed-offline-note-drift" => ok observation("unshare -n", "outer offline wrapper_2", "no quiet fallback", "old-browser leg", "tests/integration/browser", "bunx --bun playwright@1.55.1 --version", "playwright 1.55.1 resolvable", "1.55.1", "DATABASE_URL", "value never printed", "WINDOW-ENTRY: BLOCKED", "WINDOW-ENTRY: READY", "blocking failures", "notes to clear", "$fail", "$warn", 4, 2, 2, 2)
