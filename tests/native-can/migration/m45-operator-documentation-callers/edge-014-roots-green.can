        known: "edge/operator-integration-entry" => ok [expected_check("env-assign", "CAN_BUN_ARCHIVE="), expected_check("go-verb", "go test"), expected_check("count-flag", "-count=1"), expected_check("verbose-tail", "-v ./tests/integration"), expected_check("suite-dir", "tests/integration"), expected_check("deny-tool", "sandbox-exec"), expected_check("deny-all", "deny all network"), expected_check("native-deny", "network access denied"), expected_check("acquired-note", "already acquired archive"), expected_check("go-flag-count", "2"), expected_check("sandbox-exec-count", "2"), expected_check("env-assign-count", "1")]
