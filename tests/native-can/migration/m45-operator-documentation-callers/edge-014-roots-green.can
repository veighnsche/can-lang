        "seed-suite-dir-drift" => ok observation("CAN_BUN_ARCHIVE=", "go test", "-count=1", "-v ./tests/integration", "tests/integration_2", "sandbox-exec", "deny all network", "network access denied", "already acquired archive", 2, 2, 1)
