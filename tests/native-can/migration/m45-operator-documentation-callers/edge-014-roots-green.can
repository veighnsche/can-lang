fn check[] checks
    emits {}
    given
        str scope
    asserts
        m45_e014: "m45-e014" => ok [check("env-assign", "env assign keeps its bytes"), check("go-verb", "go verb keeps its spelling"), check("count-flag", "count flag keeps its spelling"), check("verbose-tail", "verbose tail keeps its bytes"), check("suite-dir", "suite dir keeps its bytes"), check("deny-tool", "deny tool keeps its spelling"), check("deny-all", "deny all keeps its bytes"), check("native-deny", "native deny keeps its bytes"), check("acquired-note", "acquired note keeps its bytes"), check("go-flag-count", "two go flags exist"), check("sandbox-exec-count", "two sandbox execs exist"), check("env-assign-count", "one env assign exists")]
        other: "nope" => ok []
    match scope is "m45-e014"
        false => ok []
        true => ok [check("env-assign", "env assign keeps its bytes"), check("go-verb", "go verb keeps its spelling"), check("count-flag", "count flag keeps its spelling"), check("verbose-tail", "verbose tail keeps its bytes"), check("suite-dir", "suite dir keeps its bytes"), check("deny-tool", "deny tool keeps its spelling"), check("deny-all", "deny all keeps its bytes"), check("native-deny", "native deny keeps its bytes"), check("acquired-note", "acquired note keeps its bytes"), check("go-flag-count", "two go flags exist"), check("sandbox-exec-count", "two sandbox execs exist"), check("env-assign-count", "one env assign exists")]
