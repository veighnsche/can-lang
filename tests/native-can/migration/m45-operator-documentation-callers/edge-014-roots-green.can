fn void case_body
    emits {failed}
    given
        context c
    asserts
        expected: context("edge/operator-integration-entry", "default", "", "offline") => ok
        seed_env_assign: context("edge/operator-integration-entry", "seed-env-assign-drift", "", "offline") => failed{"env-assign"}
        seed_go_verb: context("edge/operator-integration-entry", "seed-go-verb-drift", "", "offline") => failed{"go-verb"}
        seed_count_flag: context("edge/operator-integration-entry", "seed-count-flag-drift", "", "offline") => failed{"count-flag"}
        seed_verbose_tail: context("edge/operator-integration-entry", "seed-verbose-tail-drift", "", "offline") => failed{"verbose-tail"}
        seed_suite_dir: context("edge/operator-integration-entry", "seed-suite-dir-drift", "", "offline") => failed{"suite-dir"}
        seed_deny_tool: context("edge/operator-integration-entry", "seed-deny-tool-drift", "", "offline") => failed{"deny-tool"}
        seed_deny_all: context("edge/operator-integration-entry", "seed-deny-all-drift", "", "offline") => failed{"deny-all"}
        seed_native_deny: context("edge/operator-integration-entry", "seed-native-deny-drift", "", "offline") => failed{"native-deny"}
        seed_acquired_note: context("edge/operator-integration-entry", "seed-acquired-note-drift", "", "offline") => failed{"acquired-note"}
        seed_go_flag_count: context("edge/operator-integration-entry", "seed-go-flag-count-drift", "", "offline") => failed{"go-flag-count"}
        seed_sandbox_exec_count: context("edge/operator-integration-entry", "seed-sandbox-exec-count-drift", "", "offline") => failed{"sandbox-exec-count"}
        seed_env_assign_count: context("edge/operator-integration-entry", "seed-env-assign-count-drift", "", "offline") => failed{"env-assign-count"}
    match call observe(c.variant_id)
        ok observation got => match call require_text(got.env_assign, "CAN_BUN_ARCHIVE=", c, "env-assign")
            failed
            ok evidence env_assign_evidence => match call require_text(got.go_verb, "go test", c, "go-verb")
                failed
                ok evidence go_verb_evidence => match call require_text(got.count_flag, "-count=1", c, "count-flag")
                    failed
                    ok evidence count_flag_evidence => match call require_text(got.verbose_tail, "-v ./tests/integration", c, "verbose-tail")
                        failed
                        ok evidence verbose_tail_evidence => match call require_text(got.suite_dir, "tests/integration", c, "suite-dir")
                            failed
                            ok evidence suite_dir_evidence => match call require_text(got.deny_tool, "sandbox-exec", c, "deny-tool")
                                failed
                                ok evidence deny_tool_evidence => match call require_text(got.deny_all, "deny all network", c, "deny-all")
                                    failed
                                    ok evidence deny_all_evidence => match call require_text(got.native_deny, "network access denied", c, "native-deny")
                                        failed
                                        ok evidence native_deny_evidence => match call require_text(got.acquired_note, "already acquired archive", c, "acquired-note")
                                            failed
                                            ok evidence acquired_note_evidence => match call require_int(got.go_flag_count, 2, c, "go-flag-count")
                                                failed
                                                ok evidence go_flag_count_evidence => match call require_int(got.sandbox_exec_count, 2, c, "sandbox-exec-count")
                                                    failed
                                                    ok evidence sandbox_exec_count_evidence => match call require_int(got.env_assign_count, 1, c, "env-assign-count")
                                                        failed
                                                        ok evidence env_assign_count_evidence => ok
