package m45edge014roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M45 EDGE-014 "operator commands"
/// integration entry pact.
/// Source: distribution/README.md
/// symbol "operator commands"
/// (L90-99): pinned integration
/// command plus deny roots plus
/// provision bytes.
/// Disposition: rewire (same row pact
/// as the native slice; this file owns
/// the deny plus provision roots).
/// Protects (this file): the go
/// integration command (L94) plus deny
/// spellings (L22 plus L90-91) plus
/// provision pins plus tallies.
/// ADAPTATION (noted, plus source
/// lines): assign pins hold env
/// spellings; verb pins hold command
/// spellings; flag pins hold option
/// spellings; deny pins hold deny
/// bytes; count pins hold ints tallied
/// from L94 plus file census.
/// env-assign pins CAN_BUN_ARCHIVE=
/// (L94); go-verb pins go test (L94);
/// count-flag pins -count=1 (L94);
/// verbose-tail pins -v
/// ./tests/integration (L94); suite-dir
/// pins tests/integration (L94);
/// deny-tool pins sandbox-exec (L22
/// plus L91); deny-all pins deny all
/// network (L90); native-deny pins
/// network access denied (L22);
/// acquired-note pins already acquired
/// archive (L97); go-flag-count pins int
/// (2) from L94; sandbox-exec-count pins
/// int (2) file-wide; env-assign-count
/// pins int (1) from L94.
/// Facet map (command then deny order):
/// env-assign, go-verb, count-flag,
/// verbose-tail, suite-dir, deny-tool,
/// deny-all, native-deny,
/// acquired-note, go-flag-count,
/// sandbox-exec-count, env-assign-count.
/// The native entry lives in
/// edge-014-base-semantics.can; the
/// report plus receipt shape lives in
/// edge-014-run-shape.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: none (row lists zero
/// gates; no live run now).
/// Logical gates DOC/SUITE bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (no run timeout in this
/// row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M35
/// HISTORY-127..131 parsed slices for
/// the native leg plus a future
/// qualified integration row (no
/// qualified report yet; P23 unmet).
/// Rewire stays blocked; README
/// intact; no call retired.
/// Case edge/operator-integration-entry
/// checks: env-assign, go-verb,
/// count-flag, verbose-tail, suite-dir,
/// deny-tool, deny-all, native-deny,
/// acquired-note, go-flag-count,
/// sandbox-exec-count, env-assign-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str env_assign
    str go_verb
    str count_flag
    str verbose_tail
    str suite_dir
    str deny_tool
    str deny_all
    str native_deny
    str acquired_note
    int go_flag_count
    int sandbox_exec_count
    int env_assign_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/operator-integration-entry", "default", "", "offline"), "env-assign" => ok "case edge/operator-integration-entry variant default root env-assign run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/operator-integration-entry", "default", "", "offline"), "env-assign" => ok evidence("env-assign", "true", "true", true, "case edge/operator-integration-entry variant default root env-assign run offline")
        different: false, true, context("edge/operator-integration-entry", "default", "", "offline"), "env-assign" => failed{"env-assign"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/operator-integration-entry", "default", "", "offline"), "go-flag-count" => ok evidence("go-flag-count", "2", "2", true, "case edge/operator-integration-entry variant default root go-flag-count run offline")
        different: 1, 2, context("edge/operator-integration-entry", "default", "", "offline"), "go-flag-count" => failed{"go-flag-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "CAN_BUN_ARCHIVE=", "CAN_BUN_ARCHIVE=", context("edge/operator-integration-entry", "default", "", "offline"), "env-assign" => ok evidence("env-assign", "CAN_BUN_ARCHIVE=", "CAN_BUN_ARCHIVE=", true, "case edge/operator-integration-entry variant default root env-assign run offline")
        different: "CAN_BUN_ARCHIVE=_2", "CAN_BUN_ARCHIVE=", context("edge/operator-integration-entry", "default", "", "offline"), "env-assign" => failed{"env-assign"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
