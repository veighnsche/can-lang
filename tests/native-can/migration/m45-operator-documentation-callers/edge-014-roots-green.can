        true => ok test_case("edge/operator-integration-entry", ["edge", "m45"], [], 120000, [check_ref("env-assign"), check_ref("go-verb"), check_ref("count-flag"), check_ref("verbose-tail"), check_ref("suite-dir"), check_ref("deny-tool"), check_ref("deny-all"), check_ref("native-deny"), check_ref("acquired-note"), check_ref("go-flag-count"), check_ref("sandbox-exec-count"), check_ref("env-assign-count")], callable case_body)
