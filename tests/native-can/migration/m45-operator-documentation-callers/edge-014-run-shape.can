    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/operator-report-shape", "default", "", "offline"), "gate-fail" => ok evidence("gate-fail", "true", "true", true, "case edge/operator-report-shape variant default root gate-fail run offline")
        different: false, true, context("edge/operator-report-shape", "default", "", "offline"), "gate-fail" => failed{"gate-fail"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
