    asserts
        sample: context("edge/operator-report-shape", "default", "", "offline"), "gate-fail" => ok "case edge/operator-report-shape variant default root gate-fail run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
