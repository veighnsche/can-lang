    asserts
        same: 1, 1, context("edge/operator-report-shape", "default", "", "offline"), "schema-version" => ok evidence("schema-version", "1", "1", true, "case edge/operator-report-shape variant default root schema-version run offline")
        different: 0, 1, context("edge/operator-report-shape", "default", "", "offline"), "schema-version" => failed{"schema-version"}
    match observed is expected
