package m45edge014run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M45 EDGE-014 "operator commands"
/// report shape pact.
/// Source: distribution/README.md
/// symbol "operator commands" (L22-23
/// plus L26-36 plus L97-99): pinned
/// verdict plus report plus receipt.
/// Disposition: rewire (same row pact
/// as the native slice; this file owns
/// the report plus receipt handling
/// shape).
/// Protects (this file): verdict bytes
/// plus report keys plus CI receipt
/// pins plus tallies.
/// ADAPTATION (noted, plus source
/// lines): verdict pins hold gate
/// spellings; report pins hold schema
/// plus kind bytes; receipt pins hold CI
/// spellings; count pins hold ints
/// tallied from L26 plus L33 plus L98
/// plus entry spans.
/// gate-fail pins Sandbox failure is a
/// gate failure (L22); no-fallback pins
/// no online fallback (L23); schema-note
/// pins schema version 1 (L26);
/// kind-value pins
/// can.native-capability-report (L26);
/// fail-closed pins fails closed (L28);
/// ci-name pins native-capabilities-v1
/// (L33; plus L15); ci-separate pins
/// separately (L33; plus L12 plus L98);
/// ci-exec pins CI executes this test
/// (L97); retain-note pins retains its
/// report (L97); skip-note pins ordinary
/// Go tests skip (L98); no-claim-note
/// pins do not claim offline-distribution
/// coverage (L99); schema-version pins
/// int (1) from L26; separately-count
/// pins int (3) file-wide;
/// entrypoint-count pins int (2) from
/// L15 plus L94.
/// Facet map (verdict then report then
/// receipt order): gate-fail,
/// no-fallback, schema-note,
/// kind-value, fail-closed, ci-name,
/// ci-separate, ci-exec, retain-note,
/// skip-note, no-claim-note,
/// schema-version, separately-count,
/// entrypoint-count.
/// The native entry lives in
/// edge-014-base-semantics.can; the
/// integration roots live in
/// edge-014-roots-green.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: none (row lists zero
/// gates; no live run now).
/// Logical gates DOC/SUITE bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (no run timeout in this
/// row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M35
/// HISTORY-127..131 parsed slices for
/// the native leg plus a future
/// qualified integration row (no
/// qualified report yet; P23 unmet).
/// Rewire stays blocked; README
/// intact; no call retired.
/// Case edge/operator-report-shape
/// checks: gate-fail, no-fallback,
/// schema-note, kind-value, fail-closed,
/// ci-name, ci-separate, ci-exec,
/// retain-note, skip-note,
/// no-claim-note, schema-version,
/// separately-count, entrypoint-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str gate_fail
    str no_fallback
    str schema_note
    str kind_value
    str fail_closed
    str ci_name
    str ci_separate
    str ci_exec
    str retain_note
    str skip_note
    str no_claim_note
    int schema_version
    int separately_count
    int entrypoint_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
