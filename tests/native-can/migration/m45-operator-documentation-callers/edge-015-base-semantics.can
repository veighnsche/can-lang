    emits {}
    given
        str scope
    asserts
        m45_e015: "m45-e015" => ok [check("archive-assign", "archive assign keeps its bytes"), check("run-entry", "run entry keeps its bytes"), check("export-verb", "export verb keeps its spelling"), check("version-assign", "version assign keeps its bytes"), check("docker-build", "docker build keeps its spelling"), check("dockerfile-flag", "dockerfile flag keeps its bytes"), check("tag-flag", "tag flag keeps its bytes"), check("mkdir-line", "mkdir line keeps its bytes"), check("build-entry", "build entry keeps its bytes"), check("verify-note", "verify note keeps its bytes"), check("smoke-note", "smoke note keeps its bytes"), check("land-note", "land note keeps its bytes"), check("state-note", "state note keeps its bytes"), check("workdir-note", "workdir note keeps its bytes"), check("platform-count", "five platforms exist"), check("image-count", "five images exist"), check("run-count", "four runs exist")]
        other: "nope" => ok []
