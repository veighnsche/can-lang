package m45edge015base
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M45 EDGE-015 "Linux operator
/// commands" run entry pact.
/// Source: distribution/linux/README.md
/// symbol "Linux operator commands"
/// (L12-34): pinned run.sh entry
/// plus manual build steps plus out
/// dirs.
/// Disposition: rewire (this row owns
/// the caller pact as reviewable Can
/// facts; the README stays until the
/// integrator rewires callers after
/// each linked row has accepted
/// proof).
/// Protects (this file): the run.sh
/// one-liner (L15) plus manual build
/// steps (L28-34) plus out dir bytes
/// plus tallies that bound its runs.
/// ADAPTATION (noted, plus source
/// lines): verb pins hold command
/// spellings; flag pins hold option
/// spellings; path pins hold arg bytes;
/// note pins hold prose bytes; count
/// pins hold ints tallied from fences
/// plus file census.
/// archive-assign pins BUN_ARCHIVE
/// plus zip path (L15 plus L28);
/// run-entry pins run.sh path (L15);
/// export-verb pins export (L28);
/// version-assign pins VERSION=t19-1
/// (L28); docker-build pins docker
/// build (L29); dockerfile-flag pins
/// -f plus Dockerfile path (L29);
/// tag-flag pins -t plus image (L29);
/// mkdir-line pins mkdir plus out dirs
/// (L30); build-entry pins build.sh
/// path (L34); verify-note pins
/// verifies prose (L18); smoke-note
/// pins smokes prose (L20);
/// land-note pins Release prose (L22);
/// state-note pins install state
/// prose (L22); workdir-note pins
/// out/linux-work (L23 plus L30 plus
/// L36 plus L58); platform-count pins
/// int (5) file-wide; image-count pins
/// int (5) file-wide; run-count pins
/// int (4) file-wide.
/// Facet map (entry then build order):
/// archive-assign, run-entry,
/// export-verb, version-assign,
/// docker-build, dockerfile-flag,
/// tag-flag, mkdir-line, build-entry,
/// verify-note, smoke-note,
/// land-note, state-note,
/// workdir-note, platform-count,
/// image-count, run-count.
/// The smoke matrix lives in
/// edge-015-roots-green.can; the
/// postgres leg plus verdict live in
/// edge-015-run-shape.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: none (row lists zero
/// gates; no live run now).
/// Logical gates DOC/SUITE bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (no run timeout in this
/// row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 plus LIFE-013 linux rows
/// plus M43 EDGE-002 plus EDGE-003
/// smoke caller rows (no qualified
/// report yet; P23 unmet).
/// Rewire stays blocked; README
/// intact; no call retired.
/// Case edge/linux-run-entry
/// checks: archive-assign, run-entry,
/// export-verb, version-assign,
/// docker-build, dockerfile-flag,
/// tag-flag, mkdir-line, build-entry,
/// verify-note, smoke-note,
/// land-note, state-note,
/// workdir-note, platform-count,
/// image-count, run-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str archive_assign
    str run_entry
    str export_verb
    str version_assign
    str docker_build
    str dockerfile_flag
    str tag_flag
    str mkdir_line
    str build_entry
    str verify_note
    str smoke_note
    str land_note
    str state_note
    str workdir_note
    int platform_count
    int image_count
    int run_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/linux-run-entry", "default", "", "offline"), "archive-assign" => ok "case edge/linux-run-entry variant default root archive-assign run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/linux-run-entry", "default", "", "offline"), "archive-assign" => ok evidence("archive-assign", "true", "true", true, "case edge/linux-run-entry variant default root archive-assign run offline")
        different: false, true, context("edge/linux-run-entry", "default", "", "offline"), "archive-assign" => failed{"archive-assign"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 5, 5, context("edge/linux-run-entry", "default", "", "offline"), "platform-count" => ok evidence("platform-count", "5", "5", true, "case edge/linux-run-entry variant default root platform-count run offline")
        different: 4, 5, context("edge/linux-run-entry", "default", "", "offline"), "platform-count" => failed{"platform-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "BUN_ARCHIVE=/absolute/path/bun-linux-x64.zip", "BUN_ARCHIVE=/absolute/path/bun-linux-x64.zip", context("edge/linux-run-entry", "default", "", "offline"), "archive-assign" => ok evidence("archive-assign", "BUN_ARCHIVE=/absolute/path/bun-linux-x64.zip", "BUN_ARCHIVE=/absolute/path/bun-linux-x64.zip", true, "case edge/linux-run-entry variant default root archive-assign run offline")
        different: "BUN_ARCHIVE=/absolute/path/bun-linux-x64.zip_2", "BUN_ARCHIVE=/absolute/path/bun-linux-x64.zip", context("edge/linux-run-entry", "default", "", "offline"), "archive-assign" => failed{"archive-assign"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
