fn check[] checks
    emits {}
    given
        str scope
    asserts
        m45_e015: "m45-e015" => ok [check("smoke-run", "smoke run keeps its bytes"), check("smoke-entry", "smoke entry keeps its bytes"), check("staged-archive", "staged archive keeps its bytes"), check("archive-mount", "archive mount keeps its bytes"), check("go-archive", "go archive keeps its bytes"), check("shell-verb", "shell verb keeps its spelling"), check("src-dir", "src dir keeps its spelling"), check("dist-suite", "dist suite keeps its bytes"), check("artifact-suite", "artifact suite keeps its bytes"), check("artifact-name", "artifact name keeps its spelling"), check("suite-dir", "suite dir keeps its bytes"), check("no-sandbox", "no sandbox keeps its spelling"), check("deny-count", "two denies exist"), check("gotest-count", "three go tests exist"), check("rm-count", "four rm flags exist")]
        other: "nope" => ok []
    match scope is "m45-e015"
        false => ok []
        true => ok [check("smoke-run", "smoke run keeps its bytes"), check("smoke-entry", "smoke entry keeps its bytes"), check("staged-archive", "staged archive keeps its bytes"), check("archive-mount", "archive mount keeps its bytes"), check("go-archive", "go archive keeps its bytes"), check("shell-verb", "shell verb keeps its spelling"), check("src-dir", "src dir keeps its spelling"), check("dist-suite", "dist suite keeps its bytes"), check("artifact-suite", "artifact suite keeps its bytes"), check("artifact-name", "artifact name keeps its spelling"), check("suite-dir", "suite dir keeps its bytes"), check("no-sandbox", "no sandbox keeps its spelling"), check("deny-count", "two denies exist"), check("gotest-count", "three go tests exist"), check("rm-count", "four rm flags exist")]
fn expected_check[] expected_vector
    emits {}
    given
