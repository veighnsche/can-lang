package m45edge015roots
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M45 EDGE-015 "Linux operator
/// commands" smoke matrix pact.
/// Source: distribution/linux/README.md
/// symbol "Linux operator commands"
/// (L35-50): pinned smoke.sh call
/// plus Go suite mirror plus deny
/// roots.
/// Disposition: rewire (same row pact
/// as the run slice; this file owns
/// the smoke plus suite roots).
/// Protects (this file): the smoke.sh
/// docker call (L35-38) plus Go suite
/// spellings (L46-49) plus deny pins
/// plus tallies.
/// ADAPTATION (noted, plus source
/// lines): call pins hold docker
/// spellings; suite pins hold go
/// command bytes; name pins hold Go
/// symbol spellings; deny pins hold
/// deny bytes; count pins hold ints
/// tallied from L35 plus L46 plus
/// file census.
/// smoke-run pins docker run plus
/// deny arm (L35 plus L46);
/// smoke-entry pins smoke.sh path
/// (L38); staged-archive pins
/// BUN_ARCHIVE plus staged zip
/// (L33 plus L37 plus L48);
/// archive-mount pins zip mount
/// (L32 plus L36 plus L47);
/// go-archive pins CAN_BUN_ARCHIVE
/// plus zip (L48); shell-verb pins
/// sh -c (L49 plus L61); src-dir
/// pins cd /src (L49 plus L61);
/// dist-suite pins go plus timeout
/// 20m plus suite (L49);
/// artifact-suite pins go plus
/// timeout 50m plus smoke name
/// (L49); artifact-name pins smoke
/// Go name (L49); suite-dir pins
/// ./tests/integration/ (L49 plus
/// L61); no-sandbox pins
/// sandbox-exec (L41); deny-count
/// pins int (2) from L35 plus L46;
/// gotest-count pins int (3)
/// file-wide; rm-count pins int (4)
/// file-wide.
/// Facet map (call then suite order):
/// smoke-run, smoke-entry,
/// staged-archive, archive-mount,
/// go-archive, shell-verb, src-dir,
/// dist-suite, artifact-suite,
/// artifact-name, suite-dir,
/// no-sandbox, deny-count,
/// gotest-count, rm-count.
/// The run entry lives in
/// edge-015-base-semantics.can; the
/// postgres leg plus verdict live in
/// edge-015-run-shape.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: none (row lists zero
/// gates; no live run now).
/// Logical gates DOC/SUITE bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (no run timeout in this
/// row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 plus LIFE-013 linux rows
/// plus M43 EDGE-002 plus EDGE-003
/// smoke caller rows (no qualified
/// report yet; P23 unmet).
/// Rewire stays blocked; README
/// intact; no call retired.
/// Case edge/linux-smoke-matrix
/// checks: smoke-run, smoke-entry,
/// staged-archive, archive-mount,
/// go-archive, shell-verb, src-dir,
/// dist-suite, artifact-suite,
/// artifact-name, suite-dir,
/// no-sandbox, deny-count,
/// gotest-count, rm-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str smoke_run
    str smoke_entry
    str staged_archive
    str archive_mount
    str go_archive
    str shell_verb
    str src_dir
    str dist_suite
    str artifact_suite
    str artifact_name
    str suite_dir
    str no_sandbox
    int deny_count
    int gotest_count
    int rm_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/linux-smoke-matrix", "default", "", "offline"), "smoke-run" => ok "case edge/linux-smoke-matrix variant default root smoke-run run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/linux-smoke-matrix", "default", "", "offline"), "smoke-run" => ok evidence("smoke-run", "true", "true", true, "case edge/linux-smoke-matrix variant default root smoke-run run offline")
        different: false, true, context("edge/linux-smoke-matrix", "default", "", "offline"), "smoke-run" => failed{"smoke-run"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 2, 2, context("edge/linux-smoke-matrix", "default", "", "offline"), "deny-count" => ok evidence("deny-count", "2", "2", true, "case edge/linux-smoke-matrix variant default root deny-count run offline")
        different: 1, 2, context("edge/linux-smoke-matrix", "default", "", "offline"), "deny-count" => failed{"deny-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "docker run --rm --platform linux/amd64 --network none", "docker run --rm --platform linux/amd64 --network none", context("edge/linux-smoke-matrix", "default", "", "offline"), "smoke-run" => ok evidence("smoke-run", "docker run --rm --platform linux/amd64 --network none", "docker run --rm --platform linux/amd64 --network none", true, "case edge/linux-smoke-matrix variant default root smoke-run run offline")
        different: "docker run --rm --platform linux/amd64 --network none_2", "docker run --rm --platform linux/amd64 --network none", context("edge/linux-smoke-matrix", "default", "", "offline"), "smoke-run" => failed{"smoke-run"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
fn observation observe
    emits {}
    given
        str variant_id
    asserts
        default: "default" => ok observation("docker run --rm --platform linux/amd64 --network none", "/src/distribution/linux/smoke.sh", "BUN_ARCHIVE=/archive/bun.zip", "/archive/bun.zip:ro", "CAN_BUN_ARCHIVE=/archive/bun.zip", "sh -c", "cd /src", "go test -count=1 -timeout 20m ./distribution/", "go test -count=1 -timeout 50m -run TestLinuxInstalledArtifactSmoke -v ./tests/integration/", "TestLinuxInstalledArtifactSmoke", "./tests/integration/", "sandbox-exec", 2, 3, 4)
