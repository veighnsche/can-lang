package m45edge015run
    provides [checks, expected_vector, observe, case_body, descriptor, context, check, check_ref, expected_check, evidence, observation, failed, test_case]
    uses [text]

/// M45 EDGE-015 "Linux operator
/// commands" postgres leg pact.
/// Source: distribution/linux/README.md
/// symbol "Linux operator commands"
/// (L52-62 plus L64-79): pinned
/// postgres call plus verdict plus
/// receipt bytes.
/// Disposition: rewire (same row pact
/// as the run slice; this file owns
/// the postgres plus verdict shape).
/// Protects (this file): the postgres
/// docker call (L57-61) plus verdict
/// bytes (L64-79) plus tallies.
/// ADAPTATION (noted, plus source
/// lines): call pins hold docker
/// spellings; env pins hold assign
/// bytes; suite pins hold go command
/// bytes; verdict pins hold proves
/// prose; count pins hold ints
/// tallied from L57 plus L60 plus
/// file census.
/// pg-run pins docker run plus pg
/// net (L57); pg-net pins network
/// flag plus net (L57); work-mount
/// pins work mount (L36 plus L58);
/// install-env pins install root
/// assign (L59); db-url pins
/// DATABASE_URL plus pg host bytes
/// (L60); pg-suite pins go plus pg
/// Go name plus suite (L61);
/// pg-name pins pg Go name (L61);
/// pg-image pins postgres:17 (L21);
/// pg-seventeen pins PostgreSQL 17
/// (L54); sql-note pins Bun.SQL
/// (L52 plus L78); deny-note pins
/// networking denied (L20 plus L43);
/// runtime-note pins runtime-check
/// (L68); qualify-note pins
/// qualify.py (L70); canlc-assert
/// pins canlc assert (L74);
/// canlc-run pins canlc run (L74);
/// build-note pins stable build ID
/// (L77); version-note pins
/// records prose (L79);
/// network-count pins int (3)
/// file-wide; disposable-count pins
/// int (3) file-wide; sh-fence-count
/// pins int (4) file-wide.
/// Facet map (call then verdict order):
/// pg-run, pg-net, work-mount,
/// install-env, db-url, pg-suite,
/// pg-name, pg-image, pg-seventeen,
/// sql-note, deny-note,
/// runtime-note, qualify-note,
/// canlc-assert, canlc-run,
/// build-note, version-note,
/// network-count, disposable-count,
/// sh-fence-count.
/// The run entry lives in
/// edge-015-base-semantics.can; the
/// smoke matrix lives in
/// edge-015-roots-green.can.
/// Variants: none (row lists zero
/// variants).
/// Environment: none (row lists zero
/// gates; no live run now).
/// Logical gates DOC/SUITE bind at P23;
/// no live run now.
/// Timeout 120000ms is the offline
/// default bound (no run timeout in this
/// row; binds at P23 like the M31
/// no-run rows).
/// Delegated oracles: none.
/// Execution credit: NOT claimed (P23
/// accept gate unmet).
/// Intended consumed report: M41
/// LIFE-012 plus LIFE-013 linux rows
/// plus M43 EDGE-002 plus EDGE-003
/// smoke caller rows (no qualified
/// report yet; P23 unmet).
/// Rewire stays blocked; README
/// intact; no call retired.
/// Case edge/linux-postgres-leg
/// checks: pg-run, pg-net,
/// work-mount, install-env, db-url,
/// pg-suite, pg-name, pg-image,
/// pg-seventeen, sql-note,
/// deny-note, runtime-note,
/// qualify-note, canlc-assert,
/// canlc-run, build-note,
/// version-note, network-count,
/// disposable-count, sh-fence-count.
/// Shared old files intact; retirement
/// is a later integrator choice.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
record check
    str id
    str title
record check_ref
    str id
record expected_check
    str check
    str expected
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
record observation
    str pg_run
    str pg_net
    str work_mount
    str install_env
    str db_url
    str pg_suite
    str pg_name
    str pg_image
    str pg_seventeen
    str sql_note
    str deny_note
    str runtime_note
    str qualify_note
    str canlc_assert
    str canlc_run
    str build_note
    str version_note
    int network_count
    int disposable_count
    int sh_fence_count
error failed{str check}
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed} body
fn str selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("edge/linux-postgres-leg", "default", "", "offline"), "pg-run" => ok "case edge/linux-postgres-leg variant default root pg-run run offline"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("edge/linux-postgres-leg", "default", "", "offline"), "pg-run" => ok evidence("pg-run", "true", "true", true, "case edge/linux-postgres-leg variant default root pg-run run offline")
        different: false, true, context("edge/linux-postgres-leg", "default", "", "offline"), "pg-run" => failed{"pg-run"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call selector(c, check))
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("edge/linux-postgres-leg", "default", "", "offline"), "network-count" => ok evidence("network-count", "3", "3", true, "case edge/linux-postgres-leg variant default root network-count run offline")
        different: 2, 3, context("edge/linux-postgres-leg", "default", "", "offline"), "network-count" => failed{"network-count"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call selector(c, check))
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "docker run --rm --platform linux/amd64 --network can-t19-smoke", "docker run --rm --platform linux/amd64 --network can-t19-smoke", context("edge/linux-postgres-leg", "default", "", "offline"), "pg-run" => ok evidence("pg-run", "docker run --rm --platform linux/amd64 --network can-t19-smoke", "docker run --rm --platform linux/amd64 --network can-t19-smoke", true, "case edge/linux-postgres-leg variant default root pg-run run offline")
        different: "docker run --rm --platform linux/amd64 --network can-t19-smoke_2", "docker run --rm --platform linux/amd64 --network can-t19-smoke", context("edge/linux-postgres-leg", "default", "", "offline"), "pg-run" => failed{"pg-run"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call selector(c, check))
