package i01
    provides [observe_scalar_tag, observe_ieee_bits, observe_lexeme, observe_descriptor, observe_entries, observe_identity, observe_counters, observe_ieee_gap, observe_lexeme_of_bits, observe_entries_of_entries, observe_lexeme_of_hostile]
    uses [native, option, test]

/// Native value observers (I01): one composed make+observe projection per
/// observe kind. Rows cannot name value handles (opaque, and the service
/// rejects empty handle lists), so each wrapper makes its own cell from
/// the row-supplied payload and returns the first observation result (or
/// the counters option): whole values, no dead match arms. Pins are the
/// exact K02 observeOne/lexemeOf/entriesOf outputs under a fresh scope
/// (first cell is cell1). When-stub handle strings are check-time-only
/// scaffolding ("stub-handle" never executes); live ids are minted by the
/// future N transport. Rows are offline/provisional asserts, static until
/// qualified execution.

/// Observe the scalar tag of a text cell: exactly "text".
fn native::observation_result observe_scalar_tag
    emits {}
    given
        native::session s
        native::inert_literal payload
        native::observe_bounds b
    asserts
        greeting: native::inert_literal("text", option::none(), option::none(), option::some("hi"), option::none(), option::none()), native::observe_bounds(64, 65536) => ok native::observation_result(option::some("text"), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none())
    match call native::make(s, "text", payload)
        when
            greeting: s, "text", payload => ok
        ok native::value_handle h => do
            native::value_handle[] hs = [h]
            match call native::observe(s, hs, "scalar_tag", b)
                when
                    greeting: s, hs, "scalar_tag", b => ok native::inert_facts("scalar_tag", [native::observation("stub-handle", "cell1", native::observation_result(option::some("text"), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none(), option::none()))], option::none(), option::none())
                ok native::inert_facts got => do
                    native::observation[] obs = got.observations
                    native::observation first = obs[0]
                    ok first.result
/// Observe the exact f64 bits of a bits cell: construction words plus the
/// K02 classification (1.0 is normal, sign 0, exponent 1023, zero mantissa).
fn native::observation_result observe_ieee_bits
    emits {}
    given
        native::session s
        native::inert_literal payload
        native::observe_bounds b
    asserts
        one: native::inert_literal("f64_bits", option::some(1071644672), option::some(0), option::none(), option::none(), option::none()), native::observe_bounds(64, 65536) => ok native::observation_result(option::none(), option::none(), option::none(), option::none(), option::none(), option::some("f64_bits"), option::some(1071644672), option::some(0), option::some("normal"), option::some(0), option::some(1023), option::some(0), option::some(0), option::none(), option::none(), option::none(), option::none())
    match call native::make(s, "primitive_bits", payload)
        when
            one: s, "primitive_bits", payload => ok
        ok native::value_handle h => do
            native::value_handle[] hs = [h]
            match call native::observe(s, hs, "ieee_bits", b)
                when
                    one: s, hs, "ieee_bits", b => ok native::inert_facts("ieee_bits", [native::observation("stub-handle", "cell1", native::observation_result(option::none(), option::none(), option::none(), option::none(), option::none(), option::some("f64_bits"), option::some(1071644672), option::some(0), option::some("normal"), option::some(0), option::some(1023), option::some(0), option::some(0), option::none(), option::none(), option::none(), option::none()))], option::none(), option::none())
                ok native::inert_facts got => do
                    native::observation[] obs = got.observations
                    native::observation first = obs[0]
                    ok first.result
