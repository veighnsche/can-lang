package i01
    provides [make_kind_known, observe_kind_known, hostile_descriptor_known, read_op_known, deadline_clock_known, open_session, make_primitive_bits, make_text, make_ordered_entries, make_hostile_descriptor]
    uses [native, option, test]

/// Native value helpers (I01): session open, per-kind value construction,
/// and the closed K02 vocabulary predicates. Every native::make kind gets
/// its own wrapper because the checker admits only static literal kinds
/// (NT-I01): a generic kind: str parameter would refuse at check time.
/// Results are opaque handles, so rows use bare ok; payloads are the exact
/// K02-accepted shapes (buildRawValue tags f64_bits/text/entries/hostile).
/// Rows are offline/provisional asserts, static until qualified execution.

/// Closed make-kind vocabulary: exactly the four NATIVE_MAKE_KINDS.
fn bool make_kind_known
    emits {}
    given
        str kind
    asserts
        bits: "primitive_bits" => ok true
        text: "text" => ok true
        entries: "ordered_entries" => ok true
        hostile: "hostile_descriptor" => ok true
        bytes: "bytes" => ok false
        upper: "TEXT" => ok false
        empty: "" => ok false
    match kind
        "primitive_bits" => ok true
        "text" => ok true
        "ordered_entries" => ok true
        "hostile_descriptor" => ok true
        _ => ok false
/// Closed observe-kind vocabulary: exactly the seven NATIVE_OBSERVE_KINDS.
fn bool observe_kind_known
    emits {}
    given
        str kind
    asserts
        scalar_tag: "scalar_tag" => ok true
        ieee_bits: "ieee_bits" => ok true
        lexeme: "lexeme" => ok true
        descriptor: "descriptor" => ok true
        entries: "entries" => ok true
        identity: "identity" => ok true
        counters: "counters" => ok true
        bytes: "bytes" => ok false
        events: "events" => ok false
        empty: "" => ok false
    match kind
        "scalar_tag" => ok true
        "ieee_bits" => ok true
        "lexeme" => ok true
        "descriptor" => ok true
        "entries" => ok true
        "identity" => ok true
        "counters" => ok true
        _ => ok false
/// Closed hostile-descriptor vocabulary: exactly NATIVE_HOSTILE_DESCRIPTORS.
fn bool hostile_descriptor_known
    emits {}
    given
        str descriptor
    asserts
        getter: "getter_then" => ok true
        thenable: "throwing_thenable" => ok true
        proxy: "revoked_proxy" => ok true
        symbol: "symbol" => ok false
        empty: "" => ok false
    match descriptor
        "getter_then" => ok true
        "throwing_thenable" => ok true
        "revoked_proxy" => ok true
        _ => ok false
/// Closed effectful-read vocabulary: exactly NATIVE_READ_OPS. No native::
/// read op exists yet; this pins the K02 table for the future surface.
fn bool read_op_known
    emits {}
    given
        str op
    asserts
        bits: "bits" => ok true
        text: "text" => ok true
        entries: "entries" => ok true
        property: "property_then" => ok true
        call_then: "call_then" => ok true
        peek: "peek" => ok false
        empty: "" => ok false
    match op
        "bits" => ok true
        "text" => ok true
        "entries" => ok true
        "property_then" => ok true
        "call_then" => ok true
        _ => ok false
/// Closed deadline-clock vocabulary: exactly the schema clock union.
fn bool deadline_clock_known
    emits {}
    given
        str clock
    asserts
        wall: "wall-utc" => ok true
        monotonic: "n-monotonic" => ok true
        utc: "utc" => ok false
        empty: "" => ok false
    match clock
        "wall-utc" => ok true
        "n-monotonic" => ok true
        _ => ok false
/// Open one N-owner isolated subject/observation session. The owner is
/// admission-first (test::owner elides in rows); limits flow to the
/// transport unchanged. Bare ok: sessions are opaque.
fn native::session open_session
    emits {}
    given
        test::owner owner
        str runtime
        str observer
        str scope
        native::limits limits
    asserts
        run: "bun", "observer-a", "run-1", native::limits(1, 8, 8, 64, 65536, 4, 4) => ok
        probe: "bun", "observer-b", "probe-2", native::limits(1, 1, 1, 1, 1024, 1, 1) => ok
    match call native::open(owner, runtime, observer, scope, limits)
        when
            run: owner, runtime, observer, scope, limits => ok
            probe: owner, runtime, observer, scope, limits => ok
        ok native::session got => ok got
/// Construct one f64 cell from exact 32-bit words. Tag is f64_bits with
/// uint32 hi/lo (K02); the words round-trip bit-exact, never canonicalized.
fn native::value_handle make_primitive_bits
    emits {}
    given
        native::session s
        native::inert_literal payload
    asserts
        one: native::inert_literal("f64_bits", option::some(1071644672), option::some(0), option::none(), option::none(), option::none()) => ok
        zero: native::inert_literal("f64_bits", option::some(0), option::some(0), option::none(), option::none(), option::none()) => ok
    match call native::make(s, "primitive_bits", payload)
        when
            one: s, "primitive_bits", payload => ok
            zero: s, "primitive_bits", payload => ok
        ok native::value_handle got => ok got
/// Construct one text cell. Tag is text with a string field within the
/// byte cap (K02); bytes equal the string length.
fn native::value_handle make_text
    emits {}
    given
        native::session s
        native::inert_literal payload
    asserts
        greeting: native::inert_literal("text", option::none(), option::none(), option::some("hi"), option::none(), option::none()) => ok
        empty: native::inert_literal("text", option::none(), option::none(), option::some(""), option::none(), option::none()) => ok
    match call native::make(s, "text", payload)
        when
            greeting: s, "text", payload => ok
            empty: s, "text", payload => ok
        ok native::value_handle got => ok got
/// Construct one ordered-entries cell. Tag is entries with an entries
/// array (K02); the empty array is accepted (two bytes: "[]").
fn native::value_handle make_ordered_entries
    emits {}
    given
        native::session s
        native::inert_literal payload
    asserts
        empty: native::inert_literal("entries", option::none(), option::none(), option::none(), option::some([]), option::none()) => ok
    match call native::make(s, "ordered_entries", payload)
        when
            empty: s, "ordered_entries", payload => ok
        ok native::value_handle got => ok got
/// Construct one hostile-descriptor cell. Tag is hostile with a closed
/// descriptor (K02); construction touches nothing effectful.
fn native::value_handle make_hostile_descriptor
    emits {}
    given
        native::session s
        native::inert_literal payload
    asserts
        proxy: native::inert_literal("hostile", option::none(), option::none(), option::none(), option::none(), option::some("revoked_proxy")) => ok
        thenable: native::inert_literal("hostile", option::none(), option::none(), option::none(), option::none(), option::some("throwing_thenable")) => ok
    match call native::make(s, "hostile_descriptor", payload)
        when
            proxy: s, "hostile_descriptor", payload => ok
            thenable: s, "hostile_descriptor", payload => ok
        ok native::value_handle got => ok got
