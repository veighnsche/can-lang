package i02
    provides [seam_module_ok, exports_equal_from, exports_exact, case_module_ok]
    uses [c, option, test, text]

/// C-ingress module validators (I02): the K04 module-level seam rules in
/// pure Can. seam_module_ok pins the edge/shape half (no dynamic import,
/// every edge seam-ok); case_module_ok adds the exact export list. Export
/// comparison is exact-order (exports_exact), which is stricter than the
/// K04 sorted comparison the adapter applies: a module passing here also
/// passes the adapter's export gate, but the adapter admits orders this
/// predicate rejects. Fixed-edge coverage and runtime-root unification
/// need manifest resolution, so they stay adapter-owned. Regex failures
/// relay invalid_regex/invalid_limit; every assert pins a real computed
/// answer.

/// K04 module shape: no dynamic import and every edge seam-ok.
fn bool seam_module_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        c::parsed_module parsed
    asserts
        fresh: c::parsed_module([c::parsed_edge("./rt.ts", false, [c::parsed_name("x", "$canX", true)], false)], ["$canCase"], false, "const a = 1;") => ok true
        dynamic: c::parsed_module([], ["$canCase"], true, "const n = import(\"late\");") => ok false
        bare: c::parsed_module([c::parsed_edge("bare", false, [c::parsed_name("x", "$canX", true)], false)], [], false, "") => ok false
        empty: c::parsed_module([], [], false, "") => ok true
    match parsed.dynamic_import
        true => ok false
        false => relay call module_edges_ok(parsed.imports, 0)
/// Pairwise export equality from an index (exact order).
fn bool exports_equal_from
    emits {}
    given
        str[] got
        str[] wanted
        int index
    asserts
        pair: ["a", "b"], ["a", "b"], 0 => ok true
        flipped: ["b", "a"], ["a", "b"], 0 => ok false
        short: ["a"], ["a", "b"], 0 => ok false
        empty: [], [], 0 => ok true
    match index >= got.length
        true => match index >= wanted.length
            true => ok true
            false => ok false
        false => match index >= wanted.length
            true => ok false
            false => match got[index] is wanted[index]
                false => ok false
                true => relay call exports_equal_from(got, wanted, index + 1)
/// Exact-order export-list equality.
fn bool exports_exact
    emits {}
    given
        str[] got
        str[] wanted
    asserts
        pair: ["a", "b"], ["a", "b"] => ok true
        flipped: ["b", "a"], ["a", "b"] => ok false
        long: ["a", "b"], ["a"] => ok false
        empty: [], [] => ok true
    match got.length is wanted.length
        false => ok false
        true => relay call exports_equal_from(got, wanted, 0)
/// K04 assertion-case shape: seam-ok module with exactly the wanted exports.
fn bool case_module_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        c::parsed_module parsed
        str[] wanted
    asserts
        fresh: c::parsed_module([c::parsed_edge("./rt.ts", false, [c::parsed_name("x", "$canX", true)], false)], ["$canCase"], false, "const a = 1;"), ["$canCase"] => ok true
        extra: c::parsed_module([], ["$canCase", "leak"], false, ""), ["$canCase"] => ok false
        dynamic: c::parsed_module([], ["$canCase"], true, ""), ["$canCase"] => ok false
    match call seam_module_ok(parsed)
        text::invalid_regex
        text::invalid_limit
        ok bool seam => match seam
            false => ok false
            true => relay call exports_exact(parsed.exports, wanted)
