package i02
    provides [entry_kind_known, pattern_ok, specifier_relative, can_prefixed, name_ok, edge_names_ok, edge_ok, module_edges_ok]
    uses [c, option, test, text]

/// C-ingress seam vocabularies and edge predicates (I02). entry_kind_known
/// is exactly the NT-I02 checker allowlist (executable/assertion_root/
/// assertion_case); the edge predicates compile the K04 per-edge seam
/// rules (relative specifier, no side-effect imports, every binding
/// aliased with the $can local prefix). Regex failures relay
/// invalid_regex/invalid_limit (the seam patterns are static literals, so
/// rows never see them); every assert pins a real computed answer.

/// Closed entry-kind vocabulary: exactly the three K04 entry kinds.
fn bool entry_kind_known
    emits {}
    given
        str kind
    asserts
        executable: "executable" => ok true
        root: "assertion_root" => ok true
        case: "assertion_case" => ok true
        plural: "executables" => ok false
        empty: "" => ok false
    match kind
        "executable" => ok true
        "assertion_root" => ok true
        "assertion_case" => ok true
        _ => ok false
/// Caller-supplied regex shape probe: value matches pattern at least once.
/// Callers pass static seam patterns; arbitrary caller patterns are the
/// caller's responsibility.
fn bool pattern_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str value
        str pattern
    asserts
        dot: "./a.ts", "^\\." => ok true
        bare: "bare", "^\\." => ok false
        can: "$canX", "^\\$can" => ok true
        plain: "plain", "^\\$can" => ok false
    match call text::compile_regex(pattern, "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, value, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K04 seam rule: the import specifier is relative (starts with a dot).
fn bool specifier_relative
    emits {text::invalid_regex, text::invalid_limit}
    given
        str specifier
    asserts
        dotfile: "./rt.ts" => ok true
        parent: "../rt/completion.ts" => ok true
        bare: "bare" => ok false
        absolute: "/rt.ts" => ok false
    relay call pattern_ok(specifier, "^\\.")
/// K04 seam rule: the binding local carries the $can prefix.
fn bool can_prefixed
    emits {text::invalid_regex, text::invalid_limit}
    given
        str local
    asserts
        bound: "$canX" => ok true
        main: "$canMain" => ok true
        plain: "plain" => ok false
        empty: "" => ok false
    relay call pattern_ok(local, "^\\$can")
/// K04 seam rule: one imported binding is aliased and $can-prefixed.
fn bool name_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        c::parsed_name name
    asserts
        bound: c::parsed_name("x", "$canX", true) => ok true
        bare: c::parsed_name("y", "y", false) => ok false
        plain: c::parsed_name("y", "plain", true) => ok false
    match name.aliased
        false => ok false
        true => relay call can_prefixed(name.local)
/// Every binding on one edge is seam-ok from an index.
fn bool edge_names_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        c::parsed_name[] names
        int index
    asserts
        pair: [c::parsed_name("x", "$canX", true), c::parsed_name("y", "$canY", true)], 0 => ok true
        bare: [c::parsed_name("y", "y", false)], 0 => ok false
        empty: [], 0 => ok true
    match index >= names.length
        true => ok true
        false => match call name_ok(names[index])
            text::invalid_regex
            text::invalid_limit
            ok bool good => match good
                false => ok false
                true => relay call edge_names_ok(names, index + 1)
/// K04 seam rule: one edge is relative, bound (no side-effect import),
/// and carries only seam-ok bindings.
fn bool edge_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        c::parsed_edge edge
    asserts
        bound: c::parsed_edge("./rt.ts", false, [c::parsed_name("x", "$canX", true)], false) => ok true
        bare: c::parsed_edge("bare", false, [c::parsed_name("x", "$canX", true)], false) => ok false
        side: c::parsed_edge("./run.ts", false, [], true) => ok false
        plain: c::parsed_edge("./o.ts", false, [c::parsed_name("y", "y", false)], false) => ok false
    match call specifier_relative(edge.specifier)
        text::invalid_regex
        text::invalid_limit
        ok bool relative => match relative
            false => ok false
            true => match edge.side_effect
                true => ok false
                false => relay call edge_names_ok(edge.names, 0)
/// Every import edge of a module is seam-ok from an index.
fn bool module_edges_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        c::parsed_edge[] imports
        int index
    asserts
        pair: [c::parsed_edge("./a.ts", false, [c::parsed_name("x", "$canX", true)], false), c::parsed_edge("../b.ts", false, [c::parsed_name("y", "$canY", true)], false)], 0 => ok true
        bare: [c::parsed_edge("bare", false, [c::parsed_name("x", "$canX", true)], false)], 0 => ok false
        empty: [], 0 => ok true
    match index >= imports.length
        true => ok true
        false => match call edge_ok(imports[index])
            text::invalid_regex
            text::invalid_limit
            ok bool good => match good
                false => ok false
                true => relay call module_edges_ok(imports, index + 1)
