package i03
    provides [select_alpha, select_beta, enroll_worker, enroll_observer, gate_worker, gate_observer, emit_worker_fault, emit_worker_use, emit_worker_terminal, emit_observer_fault, emit_observer_use, emit_observer_terminal, seal_worker_completed, seal_worker_rejected, seal_worker_failed, seal_observer_completed, seal_observer_rejected, seal_observer_failed, observe_worker, observe_observer, lease_worker, lease_observer, read_lease_worker, read_lease_observer, free_lease_worker, free_lease_observer, tally_worker, tally_observer, kill_worker_now, read_outcome_now, read_counters_now]
    uses [late, option, test]

/// Late-occurrence operation wrappers (I03): one function per static
/// word, forced by the NT-I03 literal allowlists (I01 per-kind
/// precedent). Wrappers are check-time-only: when-stubs pin the call
/// shape and stub facts; rows execute live at the Q gate. Owners are
/// admission-first (test::owner elides in rows). Swap-claim wrappers
/// are intentionally absent: mismatched claimant/participant always
/// rejects wrong-owner, which when-stubs cannot pin as ok (the
/// adapter contract tests pin those verdicts instead).

/// Select late.alpha as the run identity.
fn late::select_facts select_alpha
    emits {test::stale_handle, late::late_fault}
    given
        test::owner owner
    asserts
        fresh: => ok late::select_facts("late.alpha", false)
    match call late::select(owner, "late.alpha")
        when
            fresh: owner, "late.alpha" => ok late::select_facts("late.alpha", false)
        test::stale_handle
        late::late_fault
        ok late::select_facts got => ok got
/// Select late.beta as the run identity.
fn late::select_facts select_beta
    emits {test::stale_handle, late::late_fault}
    given
