/// Reconcile worker admitted/late/dropped sequences.
fn late::reconcile_facts tally_worker
    emits {test::stale_handle, late::late_fault}
    given
        test::owner owner
    asserts
        fresh: => ok late::reconcile_facts("worker", 0, 0, [], 1)
    match call late::reconcile(owner, "worker")
        when
            fresh: owner, "worker" => ok late::reconcile_facts("worker", 0, 0, [], 1)
        test::stale_handle
        late::late_fault
        ok late::reconcile_facts got => ok got
