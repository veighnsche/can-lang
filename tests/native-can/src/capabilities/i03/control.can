/// Mark the worker dead; the outcome stays incomplete.
fn late::outcome_facts kill_worker_now
    emits {test::stale_handle}
    given
        test::owner owner
    asserts
        fresh: => ok late::outcome_facts("incomplete", "worker-dead", option::none(), option::none(), true)
    match call late::kill_worker(owner)
        when
            fresh: owner => ok late::outcome_facts("incomplete", "worker-dead", option::none(), option::none(), true)
        test::stale_handle
        ok late::outcome_facts got => ok got
/// Read the terminal run outcome.
fn late::outcome_facts read_outcome_now
    emits {test::stale_handle}
    given
        test::owner owner
    asserts
        fresh: => ok late::outcome_facts("incomplete", "terminal proof incomplete", option::none(), option::none(), false)
    match call late::read_outcome(owner)
        when
            fresh: owner => ok late::outcome_facts("incomplete", "terminal proof incomplete", option::none(), option::none(), false)
        test::stale_handle
        ok late::outcome_facts got => ok got
/// Read the nine service counters.
fn late::counters read_counters_now
    emits {test::stale_handle}
    given
        test::owner owner
    asserts
        fresh: => ok late::counters(0, 0, 0, 0, 0, 0, 0, 0, 0)
    match call late::read_counters(owner)
        when
            fresh: owner => ok late::counters(0, 0, 0, 0, 0, 0, 0, 0, 0)
        test::stale_handle
        ok late::counters got => ok got
