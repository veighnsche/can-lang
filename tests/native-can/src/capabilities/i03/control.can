/// Read a worker-held lease as the worker.
fn late::lease_facts read_lease_worker
    emits {test::stale_handle, late::late_fault}
    given
        test::owner owner
        str lease
    asserts
        first: "llease1" => ok late::lease_facts("llease1", "worker", "late.alpha", 1, false)
    match call late::observe_lease(owner, "worker", lease)
        when
            first: owner, "worker", "llease1" => ok late::lease_facts("llease1", "worker", "late.alpha", 1, false)
        test::stale_handle
        late::late_fault
        ok late::lease_facts got => ok got
