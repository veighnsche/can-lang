    asserts
        fresh: => ok late::select_facts("late.beta", false)
    match call late::select(owner, "late.beta")
        when
            fresh: owner, "late.beta" => ok late::select_facts("late.beta", false)
        test::stale_handle
        late::late_fault
        ok late::select_facts got => ok got
