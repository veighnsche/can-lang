/// Observe a worker occurrence as the worker (no swap).
fn late::observation_facts observe_worker
    emits {test::stale_handle, late::late_fault}
    given
        test::owner owner
        int seq
    asserts
        first: 1 => ok late::observation_facts("worker", "late.alpha", "fault", 1, false, option::none(), option::none())
    match call late::observe(owner, "worker", "worker", seq)
        when
            first: owner, "worker", "worker", 1 => ok late::observation_facts("worker", "late.alpha", "fault", 1, false, option::none(), option::none())
        test::stale_handle
        late::late_fault
        ok late::observation_facts got => ok got
