/// Admit a worker fault occurrence at a sequence.
fn late::event_facts emit_worker_fault
    emits {test::stale_handle, late::late_fault}
    given
        test::owner owner
        int seq
    asserts
        first: 1 => ok late::event_facts("worker", "late.alpha", "fault", 1, false, [])
    match call late::emit(owner, "worker", "fault", seq)
        when
            first: owner, "worker", "fault", 1 => ok late::event_facts("worker", "late.alpha", "fault", 1, false, [])
        test::stale_handle
        late::late_fault
        ok late::event_facts got => ok got
