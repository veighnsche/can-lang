package i03
    provides [identity_known, participant_known, kind_known, terminal_known, outcome_known, lease_id_ok, seq_ok]
    uses [late, option, test, text]

/// Late-occurrence closed vocabularies and id shapes (I03). The word
/// sets are exactly the K06 closed vocabularies; lease_id_ok compiles
/// the K06 LEASE_PATTERN (^llease[1-9][0-9]*$) and seq_ok pins the
/// positive-integer sequence gate. These mirror the NT-I03 checker
/// allowlists statically; the adapter re-validates at runtime and
/// fails unknown words as late_fault. Regex failures relay
/// invalid_regex/invalid_limit (the pattern is a static literal, so
/// rows never see them); every assert pins a real computed answer.

/// Closed identity vocabulary: exactly late.alpha/late.beta.
fn bool identity_known
    emits {}
    given
        str identity
    asserts
        alpha: "late.alpha" => ok true
        beta: "late.beta" => ok true
        gamma: "late.gamma" => ok false
        empty: "" => ok false
    match identity
        "late.alpha" => ok true
        "late.beta" => ok true
        _ => ok false
/// Closed participant vocabulary: exactly worker/observer.
fn bool participant_known
    emits {}
    given
        str participant
    asserts
        worker: "worker" => ok true
        observer: "observer" => ok true
        stranger: "stranger" => ok false
        empty: "" => ok false
    match participant
        "worker" => ok true
        "observer" => ok true
        _ => ok false
/// Closed event-kind vocabulary: exactly fault/use/terminal.
fn bool kind_known
    emits {}
    given
        str kind
    asserts
        fault: "fault" => ok true
        use: "use" => ok true
        terminal: "terminal" => ok true
        using: "using" => ok false
        empty: "" => ok false
    match kind
        "fault" => ok true
        "use" => ok true
        "terminal" => ok true
        _ => ok false
/// Closed terminal vocabulary: exactly completed/rejected/failed.
fn bool terminal_known
    emits {}
    given
        str terminal
    asserts
        completed: "completed" => ok true
        rejected: "rejected" => ok true
        failed: "failed" => ok true
        done: "done" => ok false
        empty: "" => ok false
    match terminal
        "completed" => ok true
        "rejected" => ok true
        "failed" => ok true
        _ => ok false
/// Closed outcome vocabulary: exactly complete/incomplete.
fn bool outcome_known
    emits {}
    given
        str outcome
    asserts
        complete: "complete" => ok true
        incomplete: "incomplete" => ok true
        done: "done" => ok false
        empty: "" => ok false
    match outcome
        "complete" => ok true
        "incomplete" => ok true
        _ => ok false
/// K06 lease id shape: ^llease[1-9][0-9]*$ (grantLease mints lleaseN).
fn bool lease_id_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str lease
    asserts
        first: "llease1" => ok true
        twelfth: "llease12" => ok true
        zero: "llease0" => ok false
        bare: "lease1" => ok false
        empty: "" => ok false
    match call text::compile_regex("^llease[1-9][0-9]*$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, lease, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K06 sequence gate: positive integers only (emit seq).
fn bool seq_ok
    emits {}
    given
        int seq
    asserts
        first: 1 => ok true
        tenth: 10 => ok true
        zero: 0 => ok false
        negative: -1 => ok false
    match seq >= 1
        true => ok true
        false => ok false
