package i04
    provides [http_exchange, open_request, add_header, send_body_chunk, end_upload, deliver_response, read_body_chunk, reissue, close_request, read_request_facts, read_response_facts, run_http_exchange, http_method_known, http_version_known, http_header_known, http_status_known, request_state_known]
    uses [http, http_peer, option, test]

/// HTTP helpers (I04). Ordinary Can owns the typed wrapper surface over
/// the ten http_peer:: http operations: one wrapper per catalogue op with
/// the sealed owner-first signature and emits set, one composed
/// end->deliver->read->close exchange, and pure closed-vocabulary
/// predicates mirroring the K20 http service exactly. Request handles
/// stay opaque and are never constructed here. Every row below is an
/// offline/provisional assert (static until qualified execution): `when`
/// supplies the native result and rows pin propagation plus the K20 kind
/// vocabulary. Live-only host behavior is excluded until the Q gate.

/// Observed outcome of one http exchange: the delivered status, response
/// bytes consumed by the read, the chunk itself, whether the read reached
/// EOF, and response bytes left unread at close.
record http_exchange
    int status
    int accepted
    int[] chunk
    bool eof
    int unread
/// Open one request against a declared origin. Methods are GET/POST and
/// the version is "1.1" (closed vocabularies); anything else faults. The
/// target must start with "/" and fit the target cap. A foreign origin
/// rejects before any state changes; a foreign owner yields
/// test::stale_handle (admission-first, P28-established).
fn http_peer::request open_request
    emits {test::stale_handle, http_peer::http_fault}
    given
        test::owner owner
        str origin
        str method
        str target
        str version
    asserts
        post: "origin-a", "POST", "/upload", "1.1" => ok
        get: "origin-a", "GET", "/items", "1.1" => ok
        foreign: "origin-evil", "POST", "/upload", "1.1" => http_peer::http_fault{"foreign-destination", "origin is not declared"}
        bad_method: "origin-a", "DELETE", "/x", "1.1" => http_peer::http_fault{"unsupported-capability", "http method is not supported"}
        bad_version: "origin-a", "GET", "/x", "2" => http_peer::http_fault{"unsupported-capability", "http version is not supported"}
        bad_target: "origin-a", "GET", "nope", "1.1" => http_peer::http_fault{"invalid-request", "target must start with / and fit the target cap"}
        stale: "origin-a", "POST", "/upload", "1.1" => test::stale_handle{"owner"}
    match call http_peer::open_request(owner, origin, method, target, version)
        when
            post: owner, origin, method, target, version => ok
            get: owner, origin, method, target, version => ok
            foreign: owner, origin, method, target, version => http_peer::http_fault{"foreign-destination", "origin is not declared"}
            bad_method: owner, origin, method, target, version => http_peer::http_fault{"unsupported-capability", "http method is not supported"}
            bad_version: owner, origin, method, target, version => http_peer::http_fault{"unsupported-capability", "http version is not supported"}
            bad_target: owner, origin, method, target, version => http_peer::http_fault{"invalid-request", "target must start with / and fit the target cap"}
            stale: owner, origin, method, target, version => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::http_fault
        ok http_peer::request got => ok got
/// Add one header while the upload is open. Names come from the closed
/// K20 set; values must be printable ASCII within the value cap. Header
/// bytes follow the deterministic block model (name + ": " + value +
/// CRLF). An over-cap add rejects AND sets the sticky headers_truncated
/// fact on the request.
fn http_peer::header_receipt add_header
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
        str header_name
        str header_value
    asserts
        host: "host", "example" => ok http_peer::header_receipt(1, 15)
        second: "x-trace", "t-1" => ok http_peer::header_receipt(2, 29)
        bad_name: "x-nope", "v" => http_peer::http_fault{"unsupported-capability", "http header name is not known"}
        capped: "cookie", "c" => http_peer::http_fault{"header-limit", "request header block is full"}
        sealed: "host", "example" => http_peer::http_fault{"invalid-state", "upload is already complete"}
        closed: "host", "example" => test::closed_handle{"request"}
        stale: "host", "example" => test::stale_handle{"owner"}
    match call http_peer::add_header(owner, request, header_name, header_value)
        when
            host: owner, request, header_name, header_value => ok http_peer::header_receipt(1, 15)
            second: owner, request, header_name, header_value => ok http_peer::header_receipt(2, 29)
            bad_name: owner, request, header_name, header_value => http_peer::http_fault{"unsupported-capability", "http header name is not known"}
            capped: owner, request, header_name, header_value => http_peer::http_fault{"header-limit", "request header block is full"}
            sealed: owner, request, header_name, header_value => http_peer::http_fault{"invalid-state", "upload is already complete"}
            closed: owner, request, header_name, header_value => test::closed_handle{"request"}
            stale: owner, request, header_name, header_value => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::header_receipt got => ok got
/// Send one upload chunk while the upload is open. Only POST requests
/// carry a body. An over-cap chunk rejects AND sets the sticky
/// upload_truncated fact on the request.
fn http_peer::body_chunk_receipt send_body_chunk
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
        int[] bytes
    asserts
        first: [104, 105] => ok http_peer::body_chunk_receipt(2, 2)
        more: [33] => ok http_peer::body_chunk_receipt(1, 3)
        get: [1] => http_peer::http_fault{"invalid-state", "only POST requests carry a body"}
        capped: [1] => http_peer::http_fault{"body-limit", "upload would exceed the body cap"}
        sealed: [1] => http_peer::http_fault{"invalid-state", "upload is already complete"}
        closed: [1] => test::closed_handle{"request"}
        stale: [1] => test::stale_handle{"owner"}
    match call http_peer::send_body_chunk(owner, request, bytes)
        when
            first: owner, request, bytes => ok http_peer::body_chunk_receipt(2, 2)
            more: owner, request, bytes => ok http_peer::body_chunk_receipt(1, 3)
            get: owner, request, bytes => http_peer::http_fault{"invalid-state", "only POST requests carry a body"}
            capped: owner, request, bytes => http_peer::http_fault{"body-limit", "upload would exceed the body cap"}
            sealed: owner, request, bytes => http_peer::http_fault{"invalid-state", "upload is already complete"}
            closed: owner, request, bytes => test::closed_handle{"request"}
            stale: owner, request, bytes => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::body_chunk_receipt got => ok got
/// End the upload. When a content-length header is present (last
/// occurrence governs), a short or long upload completes with an
/// explicit upload_length_mismatch fact; a malformed length faults.
fn http_peer::request_facts end_upload
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
    asserts
        sealed: => ok http_peer::request_facts("q1", "owner-a", "origin-a", "POST", "/upload", "1.1", "upload_complete", 1, [http::header("host", "example")], 15, false, 2, true, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
        mismatch: => ok http_peer::request_facts("q1", "owner-a", "origin-a", "POST", "/upload", "1.1", "upload_complete", 1, [http::header("content-length", "9")], 19, false, 2, true, false, true, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
        malformed: => http_peer::http_fault{"invalid-request", "upload content-length is malformed"}
        sealed_again: => http_peer::http_fault{"invalid-state", "upload is already complete"}
        closed: => test::closed_handle{"request"}
        stale: => test::stale_handle{"owner"}
    match call http_peer::end_upload(owner, request)
        when
            sealed: owner, request => ok http_peer::request_facts("q1", "owner-a", "origin-a", "POST", "/upload", "1.1", "upload_complete", 1, [http::header("host", "example")], 15, false, 2, true, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
            mismatch: owner, request => ok http_peer::request_facts("q1", "owner-a", "origin-a", "POST", "/upload", "1.1", "upload_complete", 1, [http::header("content-length", "9")], 19, false, 2, true, false, true, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
            malformed: owner, request => http_peer::http_fault{"invalid-request", "upload content-length is malformed"}
            sealed_again: owner, request => http_peer::http_fault{"invalid-state", "upload is already complete"}
            closed: owner, request => test::closed_handle{"request"}
            stale: owner, request => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::request_facts got => ok got
/// Deliver the server response explicitly. Responses never arrive on
/// their own. The upload must be ended first and only one response is
/// delivered; a 302 surfaces a redirect fact (never followed: a 302
/// without location sets redirect_incomplete). Over-cap header/body
/// blocks reject AND set sticky truncated facts so the caller may
/// re-deliver a smaller response while the loss stays observable.
fn http_peer::response_facts deliver_response
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
        int status
        http::header[] headers
        int[] body
    asserts
        ok_200: 200, [http::header("content-type", "text/plain")], [104, 105] => ok http_peer::response_facts(200, 1, [http::header("content-type", "text/plain")], 26, 2, 0, false, false, option::none(), false)
        redirect: 302, [http::header("location", "/next")], [] => ok http_peer::response_facts(302, 1, [http::header("location", "/next")], 17, 0, 0, true, false, option::some(http_peer::redirect(302, "/next")), false)
        bare_redirect: 302, [], [] => ok http_peer::response_facts(302, 0, [], 0, 0, 0, true, false, option::none(), true)
        early: 200, [], [] => http_peer::http_fault{"invalid-state", "end the upload before delivering"}
        twice: 200, [], [] => http_peer::http_fault{"invalid-state", "response already delivered"}
        bad_status: 418, [], [] => http_peer::http_fault{"unsupported-capability", "http status is not supported"}
        closed: 200, [], [] => test::closed_handle{"request"}
        stale: 200, [], [] => test::stale_handle{"owner"}
    match call http_peer::deliver_response(owner, request, status, headers, body)
        when
            ok_200: owner, request, status, headers, body => ok http_peer::response_facts(200, 1, [http::header("content-type", "text/plain")], 26, 2, 0, false, false, option::none(), false)
            redirect: owner, request, status, headers, body => ok http_peer::response_facts(302, 1, [http::header("location", "/next")], 17, 0, 0, true, false, option::some(http_peer::redirect(302, "/next")), false)
            bare_redirect: owner, request, status, headers, body => ok http_peer::response_facts(302, 0, [], 0, 0, 0, true, false, option::none(), true)
            early: owner, request, status, headers, body => http_peer::http_fault{"invalid-state", "end the upload before delivering"}
            twice: owner, request, status, headers, body => http_peer::http_fault{"invalid-state", "response already delivered"}
            bad_status: owner, request, status, headers, body => http_peer::http_fault{"unsupported-capability", "http status is not supported"}
            closed: owner, request, status, headers, body => test::closed_handle{"request"}
            stale: owner, request, status, headers, body => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::response_facts got => ok got
/// Read up to max_bytes of the delivered response body. Reads before
/// delivery report eof:false with empty bytes; EOF is true only after
/// the delivered body is fully consumed. Short reads report
/// truncated:true with the remainder still buffered. Accepted
/// (admitted by delivery) and consumed (handed out) stay independent.
fn http_peer::read_result read_body_chunk
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
        int max_bytes
    asserts
        full: 16 => ok http_peer::read_result([104, 105], true, false, 2, 2)
        short: 1 => ok http_peer::read_result([104], false, true, 1, 2)
        pending: 16 => ok http_peer::read_result([], false, false, 0, 0)
        closed: 16 => test::closed_handle{"request"}
        stale: 16 => test::stale_handle{"owner"}
    match call http_peer::read_body_chunk(owner, request, max_bytes)
        when
            full: owner, request, max_bytes => ok http_peer::read_result([104, 105], true, false, 2, 2)
            short: owner, request, max_bytes => ok http_peer::read_result([104], false, true, 1, 2)
            pending: owner, request, max_bytes => ok http_peer::read_result([], false, false, 0, 0)
            closed: owner, request, max_bytes => test::closed_handle{"request"}
            stale: owner, request, max_bytes => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::read_result got => ok got
/// Reissue one request explicitly: the ONLY path from a response to a
/// new request. Truncated/failed responses never create follow-ups on
/// their own. Headers and body are never copied over; the chain is
/// counted in reissue_count and linked via supersedes.
fn http_peer::request reissue
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
    asserts
        sample: => ok
        early: => http_peer::http_fault{"invalid-state", "end the upload before reissuing"}
        budget: => http_peer::http_fault{"resource-limit", "explicit reissue budget exhausted"}
        closed: => test::closed_handle{"request"}
        stale: => test::stale_handle{"owner"}
    match call http_peer::reissue(owner, request)
        when
            sample: owner, request => ok
            early: owner, request => http_peer::http_fault{"invalid-state", "end the upload before reissuing"}
            budget: owner, request => http_peer::http_fault{"resource-limit", "explicit reissue budget exhausted"}
            closed: owner, request => test::closed_handle{"request"}
            stale: owner, request => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::request got => ok got
/// Close one request. The receipt keeps the upload bytes plus the
/// response accepted/consumed/unread accounting.
fn http_peer::request_close_receipt close_request
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
    asserts
        drained: => ok http_peer::request_close_receipt(2, 2, 2, 0)
        unread: => ok http_peer::request_close_receipt(0, 4, 1, 3)
        pending: => ok http_peer::request_close_receipt(2, 0, 0, 0)
        closed: => test::closed_handle{"request"}
        stale: => test::stale_handle{"owner"}
    match call http_peer::close_request(owner, request)
        when
            drained: owner, request => ok http_peer::request_close_receipt(2, 2, 2, 0)
            unread: owner, request => ok http_peer::request_close_receipt(0, 4, 1, 3)
            pending: owner, request => ok http_peer::request_close_receipt(2, 0, 0, 0)
            closed: owner, request => test::closed_handle{"request"}
            stale: owner, request => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::request_close_receipt got => ok got
/// Read request facts: identity, request line, state, headers, upload
/// accounting, response accounting, redirect and reissue chain.
fn http_peer::request_facts read_request_facts
    emits {test::stale_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
    asserts
        open: => ok http_peer::request_facts("q1", "owner-a", "origin-a", "POST", "/upload", "1.1", "upload_open", 0, [], 0, false, 0, false, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
        responded: => ok http_peer::request_facts("q1", "owner-a", "origin-a", "GET", "/items", "1.1", "responded", 1, [http::header("host", "example")], 15, false, 0, true, false, false, true, option::some(200), 2, 2, false, false, false, option::none(), false, 0, option::none())
        reissued: => ok http_peer::request_facts("q2", "owner-a", "origin-a", "GET", "/items", "1.1", "upload_open", 0, [], 0, false, 0, false, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 1, option::some("q1"))
        stale: => test::stale_handle{"owner"}
    match call http_peer::read_request_facts(owner, request)
        when
            open: owner, request => ok http_peer::request_facts("q1", "owner-a", "origin-a", "POST", "/upload", "1.1", "upload_open", 0, [], 0, false, 0, false, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
            responded: owner, request => ok http_peer::request_facts("q1", "owner-a", "origin-a", "GET", "/items", "1.1", "responded", 1, [http::header("host", "example")], 15, false, 0, true, false, false, true, option::some(200), 2, 2, false, false, false, option::none(), false, 0, option::none())
            reissued: owner, request => ok http_peer::request_facts("q2", "owner-a", "origin-a", "GET", "/items", "1.1", "upload_open", 0, [], 0, false, 0, false, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 1, option::some("q1"))
            stale: owner, request => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::http_fault
        ok http_peer::request_facts got => ok got
/// Read response facts when a response was delivered, or none while the
/// request is still pending.
fn option::value<http_peer::response_facts> read_response_facts
    emits {test::stale_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
    asserts
        delivered: => ok option::some(http_peer::response_facts(200, 1, [http::header("content-type", "text/plain")], 26, 2, 2, true, false, option::none(), false))
        pending: => ok option::none()
        stale: => test::stale_handle{"owner"}
    match call http_peer::read_response_facts(owner, request)
        when
            delivered: owner, request => ok option::some(http_peer::response_facts(200, 1, [http::header("content-type", "text/plain")], 26, 2, 2, true, false, option::none(), false))
            pending: owner, request => ok option::none()
            stale: owner, request => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::http_fault
        ok option::value<http_peer::response_facts> got => ok got
/// End the upload, deliver the response, read one body chunk, then close
/// the request. The composed end->deliver->read->close leg of the
/// request->deliver->read->close flow; open/add_header/send_body_chunk
/// stay with the caller so the example threads request setup.
fn http_exchange run_http_exchange
    emits {test::stale_handle, test::closed_handle, http_peer::http_fault}
    given
        test::owner owner
        http_peer::request request
        int status
        http::header[] headers
        int[] body
        int max_bytes
    asserts
        sample: 200, [http::header("content-type", "text/plain")], [104, 105], 16 => ok http_exchange(200, 2, [104, 105], true, 0)
        sealed: 200, [], [], 16 => http_peer::http_fault{"invalid-state", "upload is already complete"}
        bad_status: 418, [], [], 16 => http_peer::http_fault{"unsupported-capability", "http status is not supported"}
    match call http_peer::end_upload(owner, request)
        when
            sample: owner, request => ok http_peer::request_facts("q1", "owner-a", "origin-a", "POST", "/upload", "1.1", "upload_complete", 1, [http::header("host", "example")], 15, false, 2, true, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
            sealed: owner, request => http_peer::http_fault{"invalid-state", "upload is already complete"}
            bad_status: owner, request => ok http_peer::request_facts("q1", "owner-a", "origin-a", "GET", "/x", "1.1", "upload_complete", 0, [], 0, false, 0, true, false, false, false, option::none(), 0, 0, false, false, false, option::none(), false, 0, option::none())
        test::stale_handle
        test::closed_handle
        http_peer::http_fault
        ok http_peer::request_facts sealed_upload => match call http_peer::deliver_response(owner, request, status, headers, body)
            when
                sample: owner, request, status, headers, body => ok http_peer::response_facts(200, 1, [http::header("content-type", "text/plain")], 26, 2, 0, false, false, option::none(), false)
                bad_status: owner, request, status, headers, body => http_peer::http_fault{"unsupported-capability", "http status is not supported"}
            test::stale_handle
            test::closed_handle
            http_peer::http_fault
            ok http_peer::response_facts delivered => match call http_peer::read_body_chunk(owner, request, max_bytes)
                when
                    sample: owner, request, max_bytes => ok http_peer::read_result([104, 105], true, false, 2, 2)
                test::stale_handle
                test::closed_handle
                http_peer::http_fault
                ok http_peer::read_result got => match call http_peer::close_request(owner, request)
                    when
                        sample: owner, request => ok http_peer::request_close_receipt(2, 2, 2, 0)
                    test::stale_handle
                    test::closed_handle
                    http_peer::http_fault
                    ok http_peer::request_close_receipt shut => ok http_exchange(delivered.status, got.consumed_total, got.bytes, got.eof, shut.response_body_unread)
/// Closed method vocabulary: exactly GET and POST (K20 HTTP_METHODS).
fn bool http_method_known
    emits {}
    given
        str method
    asserts
        get: "GET" => ok true
        post: "POST" => ok true
        delete: "DELETE" => ok false
        lower: "get" => ok false
        empty: "" => ok false
    match method
        "GET" => ok true
        "POST" => ok true
        _ => ok false
/// Closed version vocabulary: exactly "1.1" (K20 HTTP_VERSIONS).
fn bool http_version_known
    emits {}
    given
        str version
    asserts
        one_one: "1.1" => ok true
        two: "2" => ok false
        one_zero: "1.0" => ok false
        empty: "" => ok false
    match version
        "1.1" => ok true
        _ => ok false
/// Closed header-name vocabulary (K20 HTTP_HEADER_NAMES), shared by
/// request and response header blocks.
fn bool http_header_known
    emits {}
    given
        str header_name
    asserts
        host: "host" => ok true
        content_type: "content-type" => ok true
        content_length: "content-length" => ok true
        location: "location" => ok true
        set_cookie: "set-cookie" => ok true
        cookie: "cookie" => ok true
        x_trace: "x-trace" => ok true
        x_checksum: "x-checksum" => ok true
        auth: "authorization" => ok false
        empty: "" => ok false
    match header_name
        "host" => ok true
        "content-type" => ok true
        "content-length" => ok true
        "location" => ok true
        "set-cookie" => ok true
        "cookie" => ok true
        "x-trace" => ok true
        "x-checksum" => ok true
        _ => ok false
/// Closed status vocabulary (K20 HTTP_STATUSES). 302 surfaces a
/// redirect fact; it is never followed.
fn bool http_status_known
    emits {}
    given
        int status
    asserts
        ok_200: 200 => ok true
        created: 201 => ok true
        redirect: 302 => ok true
        bad_request: 400 => ok true
        not_found: 404 => ok true
        server_error: 500 => ok true
        teapot: 418 => ok false
        zero: 0 => ok false
    match status
        200 => ok true
        201 => ok true
        302 => ok true
        400 => ok true
        404 => ok true
        500 => ok true
        _ => ok false
/// Closed request-state vocabulary (K20 HTTP_REQUEST_STATES).
fn bool request_state_known
    emits {}
    given
        str state
    asserts
        open: "upload_open" => ok true
        complete: "upload_complete" => ok true
        responded: "responded" => ok true
        closed: "closed" => ok true
        pending: "pending" => ok false
        empty: "" => ok false
    match state
        "upload_open" => ok true
        "upload_complete" => ok true
        "responded" => ok true
        "closed" => ok true
        _ => ok false
