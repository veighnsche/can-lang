package i04
    provides [peer_exchange, open_listener, close_listener, dial_peer, retry_dial, accept, write, read, half_close, close_connection, read_listener_facts, read_connection_facts, read_dial_facts, run_peer_exchange, half_close_direction_known, peer_side_known, dial_state_known, dial_fail_reason_known, fault_kind_known]
    uses [http_peer, option, test]

/// Controlled-peer helpers (I04). Ordinary Can owns the typed wrapper
/// surface over the twelve http_peer:: peer operations: one wrapper per
/// catalogue op with the sealed owner-first signature and emits set, one
/// composed write->read->close transfer, and pure closed-vocabulary
/// predicates mirroring the K20 peer service exactly. Handles stay opaque:
/// listener, connection and dial values cross as http_peer:: handles and
/// are never constructed here. Every row below is an offline/provisional
/// assert (static until qualified execution): `when` supplies the native
/// result and rows pin propagation plus the K20 kind vocabulary. Live-only
/// host behavior is excluded until the Q gate.

/// Observed outcome of one peer transfer: bytes the peer accepted, bytes
/// echoed back, whether the read reached EOF, and bytes left unread on the
/// server side at close.
record peer_exchange
    int accepted
    int[] echoed
    bool eof
    int unread
/// Declare one listener on a destination. A foreign destination rejects
/// with peer_fault before any state changes; a foreign owner yields
/// test::stale_handle (admission-first, P28-established).
fn http_peer::listener open_listener
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        str destination
    asserts
        sample: "peer-a" => ok
        foreign: "peer-evil" => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
        capped: "peer-a" => http_peer::peer_fault{"resource-limit", "listener cap reached"}
        stale: "peer-a" => test::stale_handle{"owner"}
    match call http_peer::open_listener(owner, destination)
        when
            sample: owner, destination => ok
            foreign: owner, destination => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
            capped: owner, destination => http_peer::peer_fault{"resource-limit", "listener cap reached"}
            stale: owner, destination => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::listener got => ok got
/// Close one listener. Pending dialers observe peer-gone; the receipt
/// counts dropped accepts, lifetime accepts and stale skips. Closing a
/// closed listener yields test::closed_handle.
fn http_peer::listener_close_receipt close_listener
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::listener listener
    asserts
        drained: => ok http_peer::listener_close_receipt(2, 1, 0)
        closed: => test::closed_handle{"listener"}
        stale: => test::stale_handle{"owner"}
    match call http_peer::close_listener(owner, listener)
        when
            drained: owner, listener => ok http_peer::listener_close_receipt(2, 1, 0)
            closed: owner, listener => test::closed_handle{"listener"}
            stale: owner, listener => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::listener_close_receipt got => ok got
/// Dial one destination. The dial resolves synchronously to completed or
/// failed; a failed dial stays failed until an explicit retry_dial (no
/// implicit retry). Completed/failed dial_result shapes are live-tested:
/// no Can expression can construct the opaque dial the fixture would need
/// (ws precedent); read_dial_facts pins the shape statically instead.
fn http_peer::dial_result dial_peer
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        str destination
    asserts
        foreign: "peer-evil" => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
        dials_full: "peer-a" => http_peer::peer_fault{"resource-limit", "dial table full"}
        stale: "peer-a" => test::stale_handle{"owner"}
    match call http_peer::dial_peer(owner, destination)
        when
            foreign: owner, destination => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
            dials_full: owner, destination => http_peer::peer_fault{"resource-limit", "dial table full"}
            stale: owner, destination => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::dial_result got => ok got
/// Retry one failed dial explicitly. Each retry counts in attempt_count /
/// retry_count; retrying a completed dial or an exhausted budget faults.
fn http_peer::dial_result retry_dial
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::dial dial
    asserts
        completed: => http_peer::peer_fault{"invalid-state", "dial already completed"}
        budget: => http_peer::peer_fault{"resource-limit", "explicit retry budget exhausted"}
        stale: => test::stale_handle{"owner"}
    match call http_peer::retry_dial(owner, dial)
        when
            completed: owner, dial => http_peer::peer_fault{"invalid-state", "dial already completed"}
            budget: owner, dial => http_peer::peer_fault{"resource-limit", "explicit retry budget exhausted"}
            stale: owner, dial => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::dial_result got => ok got
/// Accept one pending dialer. Dialers that closed before accept are
/// skipped FIFO and counted in stale_skipped; an empty queue faults.
fn http_peer::connection accept
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::listener listener
    asserts
        sample: => ok
        empty: => http_peer::peer_fault{"invalid-state", "accept queue is empty"}
        conns_full: => http_peer::peer_fault{"resource-limit", "connection cap reached"}
        closed: => test::closed_handle{"listener"}
        stale: => test::stale_handle{"owner"}
    match call http_peer::accept(owner, listener)
        when
            sample: owner, listener => ok
            empty: owner, listener => http_peer::peer_fault{"invalid-state", "accept queue is empty"}
            conns_full: owner, listener => http_peer::peer_fault{"resource-limit", "connection cap reached"}
            closed: owner, listener => test::closed_handle{"listener"}
            stale: owner, listener => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::connection got => ok got
/// Write one chunk into the peer inbound buffer. Backpressure rejects the
/// whole chunk: nothing is partially accepted. Writes to a gone peer, a
/// half-closed write side, or a half-closed peer read side fault.
fn http_peer::write_receipt write
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::connection connection
        int[] bytes
    asserts
        sample: [104, 105] => ok http_peer::write_receipt(2, 2, 2)
        backpressure: [1, 2, 3, 4] => http_peer::peer_fault{"backpressure", "peer inbound buffer is full"}
        peer_gone: [9] => http_peer::peer_fault{"invalid-state", "peer is gone"}
        write_closed: [9] => http_peer::peer_fault{"invalid-state", "write side is half-closed"}
        closed: [9] => test::closed_handle{"connection"}
        stale: [9] => test::stale_handle{"owner"}
    match call http_peer::write(owner, connection, bytes)
        when
            sample: owner, connection, bytes => ok http_peer::write_receipt(2, 2, 2)
            backpressure: owner, connection, bytes => http_peer::peer_fault{"backpressure", "peer inbound buffer is full"}
            peer_gone: owner, connection, bytes => http_peer::peer_fault{"invalid-state", "peer is gone"}
            write_closed: owner, connection, bytes => http_peer::peer_fault{"invalid-state", "write side is half-closed"}
            closed: owner, connection, bytes => test::closed_handle{"connection"}
            stale: owner, connection, bytes => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::write_receipt got => ok got
/// Read up to max_bytes from the inbound buffer. EOF is explicit: an
/// empty read on a live connection reports eof:false; eof is true only
/// when the peer write side is gone AND the buffer is drained. Short
/// reads report truncated:true with the remainder still buffered.
/// Accepted (admitted) and consumed (handed out) stay independent.
fn http_peer::read_result read
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::connection connection
        int max_bytes
    asserts
        sample: 16 => ok http_peer::read_result([104, 105], false, false, 2, 2)
        short: 1 => ok http_peer::read_result([104], false, true, 1, 2)
        eof: 16 => ok http_peer::read_result([], true, false, 2, 2)
        read_closed: 16 => http_peer::peer_fault{"invalid-state", "read side is half-closed"}
        closed: 16 => test::closed_handle{"connection"}
        stale: 16 => test::stale_handle{"owner"}
    match call http_peer::read(owner, connection, max_bytes)
        when
            sample: owner, connection, max_bytes => ok http_peer::read_result([104, 105], false, false, 2, 2)
            short: owner, connection, max_bytes => ok http_peer::read_result([104], false, true, 1, 2)
            eof: owner, connection, max_bytes => ok http_peer::read_result([], true, false, 2, 2)
            read_closed: owner, connection, max_bytes => http_peer::peer_fault{"invalid-state", "read side is half-closed"}
            closed: owner, connection, max_bytes => test::closed_handle{"connection"}
            stale: owner, connection, max_bytes => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::read_result got => ok got
/// Half-close one direction ("read" or "write"). A write half-close sets
/// peer_write_closed on the peer; a read half-close discards buffered
/// inbound bytes explicitly and counts them in discarded_bytes.
fn http_peer::connection_facts half_close
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::connection connection
        str direction
    asserts
        write: "write" => ok http_peer::connection_facts("c1", "owner-a", "peer-a", "dialer", option::some("c2"), false, false, true, false, false, 0, 0, 0, 0)
        read: "read" => ok http_peer::connection_facts("c2", "owner-a", "peer-a", "acceptor", option::some("c1"), false, true, false, false, false, 0, 2, 0, 2)
        bad_direction: "both" => http_peer::peer_fault{"unsupported-capability", "half-close direction must be read or write"}
        already: "write" => http_peer::peer_fault{"invalid-state", "write side is already half-closed"}
        closed: "write" => test::closed_handle{"connection"}
        stale: "write" => test::stale_handle{"owner"}
    match call http_peer::half_close(owner, connection, direction)
        when
            write: owner, connection, direction => ok http_peer::connection_facts("c1", "owner-a", "peer-a", "dialer", option::some("c2"), false, false, true, false, false, 0, 0, 0, 0)
            read: owner, connection, direction => ok http_peer::connection_facts("c2", "owner-a", "peer-a", "acceptor", option::some("c1"), false, true, false, false, false, 0, 2, 0, 2)
            bad_direction: owner, connection, direction => http_peer::peer_fault{"unsupported-capability", "half-close direction must be read or write"}
            already: owner, connection, direction => http_peer::peer_fault{"invalid-state", "write side is already half-closed"}
            closed: owner, connection, direction => test::closed_handle{"connection"}
            stale: owner, connection, direction => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::connection_facts got => ok got
/// Close one connection. The surviving peer observes peer-gone; pending
/// writes reject and pending reads drain to an explicit EOF. The receipt
/// keeps unread, accepted, consumed and discarded counts.
fn http_peer::connection_close_receipt close_connection
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::connection connection
    asserts
        drained: => ok http_peer::connection_close_receipt(0, 2, 2, 0)
        unread: => ok http_peer::connection_close_receipt(3, 5, 2, 0)
        closed: => test::closed_handle{"connection"}
        stale: => test::stale_handle{"owner"}
    match call http_peer::close_connection(owner, connection)
        when
            drained: owner, connection => ok http_peer::connection_close_receipt(0, 2, 2, 0)
            unread: owner, connection => ok http_peer::connection_close_receipt(3, 5, 2, 0)
            closed: owner, connection => test::closed_handle{"connection"}
            stale: owner, connection => test::stale_handle{"owner"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::connection_close_receipt got => ok got
/// Read listener facts. Reads never fault on the typed path beyond
/// admission: even a closed listener reports its counts.
fn http_peer::listener_facts read_listener_facts
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::listener listener
    asserts
        sample: => ok http_peer::listener_facts("l1", "owner-a", "peer-a", false, 1, 0, 0, 0)
        closed: => ok http_peer::listener_facts("l1", "owner-a", "peer-a", true, 0, 1, 0, 2)
        stale: => test::stale_handle{"owner"}
    match call http_peer::read_listener_facts(owner, listener)
        when
            sample: owner, listener => ok http_peer::listener_facts("l1", "owner-a", "peer-a", false, 1, 0, 0, 0)
            closed: owner, listener => ok http_peer::listener_facts("l1", "owner-a", "peer-a", true, 0, 1, 0, 2)
            stale: owner, listener => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::listener_facts got => ok got
/// Read connection facts: pairing, half-close flags, and the accepted /
/// consumed / discarded byte accounting.
fn http_peer::connection_facts read_connection_facts
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::connection connection
    asserts
        paired: => ok http_peer::connection_facts("c2", "owner-a", "peer-a", "acceptor", option::some("c1"), false, false, false, true, false, 2, 2, 0, 0)
        orphan: => ok http_peer::connection_facts("c1", "owner-a", "peer-a", "dialer", option::none(), true, false, false, false, false, 0, 0, 0, 0)
        stale: => test::stale_handle{"owner"}
    match call http_peer::read_connection_facts(owner, connection)
        when
            paired: owner, connection => ok http_peer::connection_facts("c2", "owner-a", "peer-a", "acceptor", option::some("c1"), false, false, false, true, false, 2, 2, 0, 0)
            orphan: owner, connection => ok http_peer::connection_facts("c1", "owner-a", "peer-a", "dialer", option::none(), true, false, false, false, false, 0, 0, 0, 0)
            stale: owner, connection => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::connection_facts got => ok got
/// Read dial facts: the completed/failed state, fail reason, counted
/// attempts (retry_count is attempt_count minus one) and the minted
/// connection id. This pins the dial shape statically; dial_result
/// threading itself is live-tested.
fn http_peer::dial_facts read_dial_facts
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::dial dial
    asserts
        completed: => ok http_peer::dial_facts("d1", "owner-a", "peer-a", "completed", option::none(), 1, 0, option::some("c1"))
        failed: => ok http_peer::dial_facts("d2", "owner-a", "peer-a", "failed", option::some("no-listener"), 1, 0, option::none())
        retried: => ok http_peer::dial_facts("d2", "owner-a", "peer-a", "completed", option::none(), 2, 1, option::some("c3"))
        stale: => test::stale_handle{"owner"}
    match call http_peer::read_dial_facts(owner, dial)
        when
            completed: owner, dial => ok http_peer::dial_facts("d1", "owner-a", "peer-a", "completed", option::none(), 1, 0, option::some("c1"))
            failed: owner, dial => ok http_peer::dial_facts("d2", "owner-a", "peer-a", "failed", option::some("no-listener"), 1, 0, option::none())
            retried: owner, dial => ok http_peer::dial_facts("d2", "owner-a", "peer-a", "completed", option::none(), 2, 1, option::some("c3"))
            stale: owner, dial => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::dial_facts got => ok got
/// Write bytes from the client, read them on the server, then close both
/// ends. The composed write->read->close leg of the declare->dial->
/// accept->write->read->close flow; declare/dial/accept stay with the
/// caller so the example threads the listener lifetime.
fn peer_exchange run_peer_exchange
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        http_peer::connection client
        http_peer::connection server
        int[] bytes
        int max_bytes
    asserts
        sample: [104, 105], 16 => ok peer_exchange(2, [104, 105], false, 0)
        backpressure: [1, 2, 3, 4], 16 => http_peer::peer_fault{"backpressure", "peer inbound buffer is full"}
        read_closed: [104, 105], 16 => http_peer::peer_fault{"invalid-state", "read side is half-closed"}
    match call http_peer::write(owner, client, bytes)
        when
            sample: owner, client, bytes => ok http_peer::write_receipt(2, 2, 2)
            backpressure: owner, client, bytes => http_peer::peer_fault{"backpressure", "peer inbound buffer is full"}
            read_closed: owner, client, bytes => ok http_peer::write_receipt(2, 2, 2)
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::write_receipt sent => match call http_peer::read(owner, server, max_bytes)
            when
                sample: owner, server, max_bytes => ok http_peer::read_result([104, 105], false, false, 2, 2)
                read_closed: owner, server, max_bytes => http_peer::peer_fault{"invalid-state", "read side is half-closed"}
            test::stale_handle
            test::closed_handle
            http_peer::peer_fault
            ok http_peer::read_result got => match call http_peer::close_connection(owner, server)
                when
                    sample: owner, server => ok http_peer::connection_close_receipt(0, 2, 2, 0)
                test::stale_handle
                test::closed_handle
                http_peer::peer_fault
                ok http_peer::connection_close_receipt server_shut => match call http_peer::close_connection(owner, client)
                    when
                        sample: owner, client => ok http_peer::connection_close_receipt(0, 0, 0, 0)
                    test::stale_handle
                    test::closed_handle
                    http_peer::peer_fault
                    ok http_peer::connection_close_receipt client_shut => ok peer_exchange(sent.accepted, got.bytes, got.eof, server_shut.unread_bytes)
/// Closed half-close vocabulary: exactly "read" and "write" (K20
/// PEER_HALF_CLOSE_DIRECTIONS). Anything else faults at the boundary.
fn bool half_close_direction_known
    emits {}
    given
        str direction
    asserts
        read: "read" => ok true
        write: "write" => ok true
        both: "both" => ok false
        empty: "" => ok false
    match direction
        "read" => ok true
        "write" => ok true
        _ => ok false
/// Closed endpoint-side vocabulary: exactly "dialer" and "acceptor"
/// (K20 PEER_SIDES).
fn bool peer_side_known
    emits {}
    given
        str side
    asserts
        dialer: "dialer" => ok true
        acceptor: "acceptor" => ok true
        server: "server" => ok false
        empty: "" => ok false
    match side
        "dialer" => ok true
        "acceptor" => ok true
        _ => ok false
/// Closed dial-state vocabulary: exactly "completed" and "failed" (K20
/// PEER_DIAL_STATES). No pending state exists: dials resolve at the call.
fn bool dial_state_known
    emits {}
    given
        str state
    asserts
        completed: "completed" => ok true
        failed: "failed" => ok true
        pending: "pending" => ok false
        empty: "" => ok false
    match state
        "completed" => ok true
        "failed" => ok true
        _ => ok false
/// Closed dial-failure vocabulary (K20 PEER_DIAL_FAIL_REASONS).
fn bool dial_fail_reason_known
    emits {}
    given
        str reason
    asserts
        no_listener: "no-listener" => ok true
        listener_closed: "listener-closed" => ok true
        queue_full: "accept-queue-full" => ok true
        conn_cap: "connection-cap" => ok true
        timeout: "timeout" => ok false
        empty: "" => ok false
    match reason
        "no-listener" => ok true
        "listener-closed" => ok true
        "accept-queue-full" => ok true
        "connection-cap" => ok true
        _ => ok false
/// Closed fault-kind vocabulary shared by peer_fault and http_fault
/// (K20 HTTP_PEER_KINDS). At the Can boundary, wrong-owner surfaces as
/// test::stale_handle and closed-handle as test::closed_handle; the
/// remaining kinds arrive as the fault kind.
fn bool fault_kind_known
    emits {}
    given
        str kind
    asserts
        invalid_request: "invalid-request" => ok true
        unsupported: "unsupported-capability" => ok true
        foreign: "foreign-destination" => ok true
        resource: "resource-limit" => ok true
        owner: "wrong-owner" => ok true
        closed: "closed-handle" => ok true
        backpressure: "backpressure" => ok true
        no_listener: "no-listener" => ok true
        invalid_state: "invalid-state" => ok true
        header_limit: "header-limit" => ok true
        body_limit: "body-limit" => ok true
        timeout: "timeout" => ok false
        empty: "" => ok false
    match kind
        "invalid-request" => ok true
        "unsupported-capability" => ok true
        "foreign-destination" => ok true
        "resource-limit" => ok true
        "wrong-owner" => ok true
        "closed-handle" => ok true
        "backpressure" => ok true
        "no-listener" => ok true
        "invalid-state" => ok true
        "header-limit" => ok true
        "body-limit" => ok true
        _ => ok false
