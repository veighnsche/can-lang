/// Send one ping frame on an open connection.
fn http_peer::ws_send_receipt send_ping
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        str connection
        int[] payload
    asserts
        first: "w1", [] => ok http_peer::ws_send_receipt("ping", 0, 1, 0)
        half: "w1", [] => http_peer::peer_fault{"invalid-state", "connection is half-closed"}
        closed: "w1", [] => test::closed_handle{"connection"}
    match call http_peer::ws_send(owner, connection, "ping", payload)
        when
            first: owner, "w1", "ping", [] => ok http_peer::ws_send_receipt("ping", 0, 1, 0)
            half: owner, "w1", "ping", [] => http_peer::peer_fault{"invalid-state", "connection is half-closed"}
            closed: owner, "w1", "ping", [] => test::closed_handle{"connection"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::ws_send_receipt got => ok got
