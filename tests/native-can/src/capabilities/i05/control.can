/// Inject one scripted remote text event.
fn http_peer::ws_deliver_receipt deliver_text
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        str connection
        int[] payload
    asserts
        first: "w1", [9, 8] => ok http_peer::ws_deliver_receipt("text", 1, 2, 1)
        full: "w1", [1] => http_peer::peer_fault{"backpressure", "pending event queue is full"}
        gone: "w1", [1] => http_peer::peer_fault{"invalid-state", "remote side already closed"}
    match call http_peer::ws_deliver_event(owner, connection, "text", payload)
        when
            first: owner, "w1", "text", [9, 8] => ok http_peer::ws_deliver_receipt("text", 1, 2, 1)
            full: owner, "w1", "text", [1] => http_peer::peer_fault{"backpressure", "pending event queue is full"}
            gone: owner, "w1", "text", [1] => http_peer::peer_fault{"invalid-state", "remote side already closed"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::ws_deliver_receipt got => ok got
