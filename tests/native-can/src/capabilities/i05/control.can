/// Poll one queued event; empty polls return event none.
fn http_peer::ws_poll_result poll_event
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        str connection
    asserts
        first: "w1" => ok http_peer::ws_poll_result(option::some(http_peer::ws_event("text", [9, 8])), 0, 1, 1)
        quiet: "w1" => ok http_peer::ws_poll_result(option::none(), 0, 0, 0)
        closed: "w1" => test::closed_handle{"connection"}
    match call http_peer::ws_poll_event(owner, connection)
        when
            first: owner, "w1" => ok http_peer::ws_poll_result(option::some(http_peer::ws_event("text", [9, 8])), 0, 1, 1)
            quiet: owner, "w1" => ok http_peer::ws_poll_result(option::none(), 0, 0, 0)
            closed: owner, "w1" => test::closed_handle{"connection"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::ws_poll_result got => ok got
/// Record the local close with code and reason.
fn http_peer::ws_close_receipt close_local
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        str connection
        int close_code
        str reason
    asserts
        first: "w1", 1000, "done" => ok http_peer::ws_close_receipt("local", 1000, false, 0, 0)
        bad_code: "w1", 999, "done" => http_peer::peer_fault{"invalid-request", "close code must be an integer 1000..4999"}
        bad_reason: "w1", 1000, "doné" => http_peer::peer_fault{"invalid-request", "close reason must be printable ASCII"}
    match call http_peer::ws_close(owner, connection, close_code, reason)
        when
            first: owner, "w1", 1000, "done" => ok http_peer::ws_close_receipt("local", 1000, false, 0, 0)
            bad_code: owner, "w1", 999, "done" => http_peer::peer_fault{"invalid-request", "close code must be an integer 1000..4999"}
            bad_reason: owner, "w1", 1000, "doné" => http_peer::peer_fault{"invalid-request", "close reason must be printable ASCII"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::ws_close_receipt got => ok got
/// Inject the scripted remote close with code and reason.
fn http_peer::ws_close_receipt deliver_remote_close
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        str connection
        int close_code
        str reason
    asserts
        first: "w1", 1000, "bye" => ok http_peer::ws_close_receipt("remote", 1000, true, 0, 0)
        twice: "w1", 1000, "bye" => http_peer::peer_fault{"invalid-state", "remote close already recorded"}
        shut: "w1", 1000, "bye" => test::closed_handle{"connection"}
    match call http_peer::ws_deliver_remote_close(owner, connection, close_code, reason)
        when
            first: owner, "w1", 1000, "bye" => ok http_peer::ws_close_receipt("remote", 1000, true, 0, 0)
            twice: owner, "w1", 1000, "bye" => http_peer::peer_fault{"invalid-state", "remote close already recorded"}
            shut: owner, "w1", 1000, "bye" => test::closed_handle{"connection"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::ws_close_receipt got => ok got
/// Read connection facts; closes stay independent.
fn http_peer::ws_connection_facts read_facts
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        str connection
    asserts
        first: "w1" => ok http_peer::ws_connection_facts("w1", "grant-stub", "ws-a", "open", option::none(), option::none(), 0, 0, 0, 0, 0, 0, 0, 0)
        stale: "w1" => test::stale_handle{"owner"}
    match call http_peer::ws_read_connection_facts(owner, connection)
        when
            first: owner, "w1" => ok http_peer::ws_connection_facts("w1", "grant-stub", "ws-a", "open", option::none(), option::none(), 0, 0, 0, 0, 0, 0, 0, 0)
            stale: owner, "w1" => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::ws_connection_facts got => ok got
