package i05
    provides [connect, send_text, send_binary, send_ping, send_pong, deliver_text, deliver_binary, deliver_ping, deliver_pong, poll_event, close_local, deliver_remote_close, read_facts]
    uses [http_peer, option, test]

/// WebSocket operation wrappers (I05): one function per
/// operation, except ws_send and ws_deliver_event, which
/// split one per opcode forced by the NT-I05 literal
/// allowlist (I01 per-kind precedent). Wrappers are
/// check-time-only: when-stubs pin the call shape and stub
/// results; rows execute live at the Q gate. Owners are
/// admission-first (test::owner elides in rows). Connections
/// travel as plain string ids. Rows pin ok shapes plus the
/// exact K21 fault verdicts (I04 style): peer_fault carries
/// {kind, reason} with the service message verbatim,
/// closed-handle arrives as test::closed_handle, and
/// wrong-owner arrives as test::stale_handle.

/// Connect one client to a declared destination.
fn http_peer::ws_connection_handle connect
    emits {test::stale_handle, http_peer::peer_fault}
    given
        test::owner owner
        str destination
    asserts
        first: "ws-a" => ok http_peer::ws_connection_handle("websocket", "w1", "grant-stub", "ws-a")
        foreign: "ws-evil" => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
        stale: "ws-a" => test::stale_handle{"owner"}
    match call http_peer::ws_connect(owner, destination)
        when
            first: owner, "ws-a" => ok http_peer::ws_connection_handle("websocket", "w1", "grant-stub", "ws-a")
            foreign: owner, "ws-evil" => http_peer::peer_fault{"foreign-destination", "destination is not declared"}
            stale: owner, "ws-a" => test::stale_handle{"owner"}
        test::stale_handle
        http_peer::peer_fault
        ok http_peer::ws_connection_handle got => ok got
/// Send one text frame on an open connection.
fn http_peer::ws_send_receipt send_text
    emits {test::stale_handle, test::closed_handle, http_peer::peer_fault}
    given
        test::owner owner
        str connection
        int[] payload
    asserts
        first: "w1", [1, 2, 3] => ok http_peer::ws_send_receipt("text", 3, 1, 3)
        half: "w1", [1] => http_peer::peer_fault{"invalid-state", "connection is half-closed"}
        closed: "w1", [1] => test::closed_handle{"connection"}
    match call http_peer::ws_send(owner, connection, "text", payload)
        when
            first: owner, "w1", "text", [1, 2, 3] => ok http_peer::ws_send_receipt("text", 3, 1, 3)
            half: owner, "w1", "text", [1] => http_peer::peer_fault{"invalid-state", "connection is half-closed"}
            closed: owner, "w1", "text", [1] => test::closed_handle{"connection"}
        test::stale_handle
        test::closed_handle
        http_peer::peer_fault
        ok http_peer::ws_send_receipt got => ok got
