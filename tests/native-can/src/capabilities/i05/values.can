package i05
    provides [opcode_known, ws_state_known, close_origin_known]
    uses []

/// WebSocket closed vocabularies (I05). opcode_known mirrors
/// exactly the K21 WS_OPCODES input words
/// (text/binary/ping/pong); ws_state_known mirrors exactly
/// the K21 WS_CONNECTION_STATES observed words
/// (open/local-closed/remote-closed/closed); close_origin_known
/// mirrors exactly the K21 WS_CLOSE_ORIGINS observed words
/// (local/remote). The opcode predicate mirrors the NT-I05
/// checker allowlist statically; the adapter re-validates at
/// runtime and fails unknown words as peer_fault. Every
/// assert pins a real computed answer.

/// Closed opcode vocabulary: exactly text/binary/ping/pong.
fn bool opcode_known
    emits {}
    given
        str opcode
    asserts
        text: "text" => ok true
        binary: "binary" => ok true
        ping: "ping" => ok true
        pong: "pong" => ok true
        close: "close" => ok false
        empty: "" => ok false
    match opcode
        "text" => ok true
        "binary" => ok true
        "ping" => ok true
        "pong" => ok true
        _ => ok false
/// Closed connection-state vocabulary: the four K21 states.
fn bool ws_state_known
    emits {}
    given
        str state
    asserts
        open: "open" => ok true
        local: "local-closed" => ok true
        remote: "remote-closed" => ok true
        closed: "closed" => ok true
        half: "half-closed" => ok false
        empty: "" => ok false
    match state
        "open" => ok true
        "local-closed" => ok true
        "remote-closed" => ok true
        "closed" => ok true
        _ => ok false
/// Closed close-origin vocabulary: exactly local/remote.
fn bool close_origin_known
    emits {}
    given
        str origin
    asserts
        local: "local" => ok true
        remote: "remote" => ok true
        both: "both" => ok false
        empty: "" => ok false
    match origin
        "local" => ok true
        "remote" => ok true
        _ => ok false
