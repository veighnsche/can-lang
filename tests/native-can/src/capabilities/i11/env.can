package i11
    provides [scalars_less_at, str_less, names_sorted_from, str_member, names_unique_from, all_env_names_ok, all_args_ok, argv_ok, env_names_ok, environment_ok]
    uses [descriptor, option, test, text]

/// Environment validators (I11): the K17 semantic_environment rules plus
/// the schema word/shape gates, in pure Can. environment_ok pins the whole
/// doc (schema version, run/launch ids, known entry, argv rules with the
/// entry coupling, shaped/unique/sorted env names, env digest, log sink).
/// Sortedness compares Unicode scalar values (text::scalars code points),
/// which agrees with schema ordering on the ASCII env fixtures. Regex and
/// scalar failures relay their errors; every assert pins a real answer.

/// Lexicographic less-than over scalar lists from an index: first
/// difference decides; a strict prefix is less; equals is not less.
fn bool scalars_less_at
    emits {}
    given
        int[] a
        int[] b
        int index
    asserts
        less: [65], [66], 0 => ok true
        greater: [66], [65], 0 => ok false
        equal: [65], [65], 0 => ok false
        prefix: [65], [65, 66], 0 => ok true
        longer: [65, 66], [65], 0 => ok false
        deep: [65, 66], [65, 67], 0 => ok true
    match index >= a.length
        true => match index >= b.length
            true => ok false
            false => ok true
        false => match index >= b.length
            true => ok false
            false => match a[index] is b[index]
                true => relay call scalars_less_at(a, b, index + 1)
                false => match a[index] <= b[index]
                    true => ok true
                    false => ok false
/// Lexicographic less-than over strings by scalar value.
fn bool str_less
    emits {text::invalid_unicode}
    given
        str a
        str b
    asserts
        path: "CAN_LOCALE", "PATH" => ok true
        flipped: "PATH", "CAN_LOCALE" => ok false
        equal: "PATH", "PATH" => ok false
        prefix: "CAN", "CAN_LOCALE" => ok true
    match call text::scalars(a)
        text::invalid_unicode
        ok int[] a_points => match call text::scalars(b)
            text::invalid_unicode
            ok int[] b_points => relay call scalars_less_at(a_points, b_points, 0)
/// Names are sorted from an index: no adjacent descent (equals allowed;
/// duplicates are rejected by names_unique_from, not here).
fn bool names_sorted_from
    emits {text::invalid_unicode}
    given
        str[] names
        int index
    asserts
        pair: ["CAN_LOCALE", "PATH"], 0 => ok true
        flipped: ["PATH", "CAN_LOCALE"], 0 => ok false
        single: ["PATH"], 0 => ok true
        empty: [], 0 => ok true
    match index + 1 >= names.length
        true => ok true
        false => match call str_less(names[index + 1], names[index])
            text::invalid_unicode
            ok bool descends => match descends
                true => ok false
                false => relay call names_sorted_from(names, index + 1)
/// Membership of a word in a list at or after an index.
fn bool str_member
    emits {}
    given
        str[] words
        str word
        int index
    asserts
        hit: ["a", "b"], "b", 0 => ok true
        miss: ["a"], "z", 0 => ok false
        empty: [], "a", 0 => ok false
        offset: ["a", "b"], "a", 1 => ok false
    match index >= words.length
        true => ok false
        false => match words[index] is word
            true => ok true
            false => relay call str_member(words, word, index + 1)
/// Names are unique from an index: no name repeats later.
fn bool names_unique_from
    emits {}
    given
        str[] names
        int index
    asserts
        pair: ["CAN_LOCALE", "PATH"], 0 => ok true
        dup: ["PATH", "PATH"], 0 => ok false
        single: ["PATH"], 0 => ok true
        empty: [], 0 => ok true
    match index >= names.length
        true => ok true
        false => match call str_member(names, names[index], index + 1)
            ok bool repeats => match repeats
                true => ok false
                false => relay call names_unique_from(names, index + 1)
/// Every env name matches the K17 envName shape from an index.
fn bool all_env_names_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str[] names
        int index
    asserts
        pair: ["CAN_LOCALE", "PATH"], 0 => ok true
        lower: ["path"], 0 => ok false
        empty: [], 0 => ok true
    match index >= names.length
        true => ok true
        false => match call env_name_ok(names[index])
            text::invalid_regex
            text::invalid_limit
            ok bool head_ok => match head_ok
                false => ok false
                true => relay call all_env_names_ok(names, index + 1)
/// Every argv item matches the K17 arg shape from an index.
fn bool all_args_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str[] argv
        int index
    asserts
        words: ["c-suite", "run"], 0 => ok true
        blank: [""], 0 => ok false
        empty: [], 0 => ok true
    match index >= argv.length
        true => ok true
        false => match call arg_ok(argv[index])
            text::invalid_regex
            text::invalid_limit
            ok bool head_ok => match head_ok
                false => ok false
                true => relay call all_args_ok(argv, index + 1)
/// Argv rules: at most 64 items, every item shaped, and the entry
/// coupling (c-cli requires argv with argv0; direct-entry needs empty argv).
fn bool argv_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str entry
        str[] argv
    asserts
        cli: "c-cli", ["c-suite", "run", "--case", "f1-stdin"] => ok true
        cli_bare: "c-cli", [] => ok false
        direct: "direct-entry", [] => ok true
        direct_argv: "direct-entry", ["x"] => ok false
        cli_blank: "c-cli", [""] => ok false
    match argv.length <= 64
        false => ok false
        true => match call all_args_ok(argv, 0)
            text::invalid_regex
            text::invalid_limit
            ok bool shaped => match shaped
                false => ok false
                true => match entry
                    "c-cli" => match argv.length >= 1
                        true => ok true
                        false => ok false
                    "direct-entry" => match argv.length is 0
                        true => ok true
                        false => ok false
                    _ => ok false
/// Env names rules: at most 128 names, every name shaped, unique, sorted.
fn bool env_names_ok
    emits {text::invalid_regex, text::invalid_limit, text::invalid_unicode}
    given
        str[] names
    asserts
        pair: ["CAN_LOCALE", "PATH"] => ok true
        unsorted: ["PATH", "CAN_LOCALE"] => ok false
        dup: ["PATH", "PATH"] => ok false
        lower: ["path"] => ok false
        empty: [] => ok true
    match names.length <= 128
        false => ok false
        true => match call all_env_names_ok(names, 0)
            text::invalid_regex
            text::invalid_limit
            ok bool shaped => match shaped
                false => ok false
                true => match call names_unique_from(names, 0)
                    ok bool unique => match unique
                        false => ok false
                        true => match call names_sorted_from(names, 0)
                            text::invalid_unicode
                            ok bool sorted => match sorted
                                true => ok true
                                false => ok false
/// Whole environment: schema version 1, id-shaped run/launch, known
/// entry, argv rules, env-names rules, env digest, known log sink.
/// Rows mirror the K17 fixtures 1:1 (2 valid + 5 invalid). bad-env-type
/// and secret-value are excluded by construction (str[] typing and
/// closed records make them unspellable), not by validator logic.
fn bool environment_ok
    emits {text::invalid_regex, text::invalid_limit, text::invalid_unicode}
    given
        descriptor::environment doc
    asserts
        cli: descriptor::environment("1", "run-20260930-001", "launch-0001", "c-cli", ["c-suite", "run", "--case", "f1-stdin"], ["CAN_LOCALE", "PATH"], "sha256:c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1", "fd2") => ok true
        direct: descriptor::environment("1", "run-20260930-001", "launch-0002", "direct-entry", [], [], "sha256:d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2", "none") => ok true
        c_cli_no_argv: descriptor::environment("1", "run-20260930-001", "launch-0009", "c-cli", [], ["PATH"], "sha256:c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1", "fd2") => ok false
        direct_entry_argv: descriptor::environment("1", "run-20260930-001", "launch-0009", "direct-entry", ["c-suite"], [], "sha256:d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2", "none") => ok false
        dup_env: descriptor::environment("1", "run-20260930-001", "launch-0009", "c-cli", ["c-suite"], ["PATH", "PATH"], "sha256:c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1", "fd2") => ok false
        log_path: descriptor::environment("1", "run-20260930-001", "launch-0009", "c-cli", ["c-suite"], ["PATH"], "sha256:c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1", "/tmp/secret.log") => ok false
        unsorted_env: descriptor::environment("1", "run-20260930-001", "launch-0009", "c-cli", ["c-suite"], ["PATH", "CAN_LOCALE"], "sha256:c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1", "fd2") => ok false
    match doc.schema_version is "1"
        false => ok false
        true => match call id_ok(doc.run_id)
            text::invalid_regex
            text::invalid_limit
            ok bool run_ok => match run_ok
                false => ok false
                true => match call id_ok(doc.launch_id)
                    text::invalid_regex
                    text::invalid_limit
                    ok bool launch_ok => match launch_ok
                        false => ok false
                        true => match call entry_known(doc.entry)
                            ok bool entry_good => match entry_good
                                false => ok false
                                true => match call argv_ok(doc.entry, doc.argv)
                                    text::invalid_regex
                                    text::invalid_limit
                                    ok bool argv_good => match argv_good
                                        false => ok false
                                        true => match call env_names_ok(doc.env_names)
                                            text::invalid_regex
                                            text::invalid_limit
                                            text::invalid_unicode
                                            ok bool names_good => match names_good
                                                false => ok false
                                                true => match call digest_ok(doc.env_digest)
                                                    text::invalid_regex
                                                    text::invalid_limit
                                                    ok bool digest_good => match digest_good
                                                        false => ok false
                                                        true => match call log_sink_known(doc.log_sink)
                                                            ok bool sink_good => match sink_good
                                                                true => ok true
                                                                false => ok false
