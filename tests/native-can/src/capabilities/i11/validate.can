package i11
    provides [fd_bytes_ok, fd_entry_ok, fd_seen, fd_set_ok, all_entries_ok, descriptor_map_ok]
    uses [descriptor, option, test, text]

/// Descriptor-map validators (I11): the K17 semantic_descriptor_map rules
/// plus the schema word/shape gates, in pure Can. fd_entry_ok pins one
/// entry (N owner, K17 direction contract, byte counts, hold-lease state,
/// exhausted/closed coupling, released lifetime); descriptor_map_ok pins
/// the whole doc (schema version, run/launch ids, fresh snapshot with a
/// digest, exactly fds 0..4, every entry ok). Regex failures relay
/// invalid_regex/invalid_limit; every assert pins a real computed answer.

/// Byte counts: both are K17 counts and accepted never exceeds offered.
fn bool fd_bytes_ok
    emits {}
    given
        int offered
        int accepted
    asserts
        fresh: 1024, 256 => ok true
        exact: 4096, 4096 => ok true
        zero: 0, 0 => ok true
        overflow: 256, 1024 => ok false
        negative: -1, 0 => ok false
        huge: 9007199254740992, 0 => ok false
    match call count_ok(offered)
        ok bool offered_ok => match offered_ok
            false => ok false
            true => match call count_ok(accepted)
                ok bool accepted_ok => match accepted_ok
                    false => ok false
                    true => match accepted <= offered
                        true => ok true
                        false => ok false
/// One fd entry: N-owned, vocabulary words, K17 direction contract, byte
/// counts, and the state/lifetime coupling (hold lease carries no
/// byte/eof state or bytes; tracked fds carry both; exhausted bytes need
/// sealed eof; closed eof needs exhausted bytes; released lifetime needs
/// closed (or hold-none) eof).
fn bool fd_entry_ok
    emits {}
    given
        descriptor::fd_entry entry
    asserts
        fresh0: descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 1024, 256) => ok true
        fresh1: descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0) => ok true
        hold4: descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0) => ok true
        foreign: descriptor::fd_entry(0, "C", "in", "streaming", "open", "active", 1024, 256) => ok false
        flipped: descriptor::fd_entry(0, "N", "out", "streaming", "open", "active", 1024, 256) => ok false
        overflow: descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 256, 1024) => ok false
        hold_bytes: descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 8, 8) => ok false
        open_exhausted: descriptor::fd_entry(1, "N", "out", "exhausted", "open", "active", 0, 0) => ok false
        closed_streaming: descriptor::fd_entry(1, "N", "out", "streaming", "closed", "active", 0, 0) => ok false
        released_open: descriptor::fd_entry(1, "N", "out", "streaming", "open", "released", 0, 0) => ok false
        drained: descriptor::fd_entry(1, "N", "out", "exhausted", "closed", "released", 0, 0) => ok true
        sealed_released: descriptor::fd_entry(1, "N", "out", "exhausted", "eof-sent", "released", 0, 0) => ok false
    match entry.owner is "N"
        false => ok false
        true => match call direction_known(entry.direction)
            ok bool direction_ok => match direction_ok
                false => ok false
                true => match call byte_state_known(entry.byte_state)
                    ok bool bytes_ok => match bytes_ok
                        false => ok false
                        true => match call eof_state_known(entry.eof_state)
                            ok bool eof_ok => match eof_ok
                                false => ok false
                                true => match call lifetime_known(entry.lifetime)
                                    ok bool life_ok => match life_ok
                                        false => ok false
                                        true => match call fd_direction_ok(entry.fd, entry.direction)
                                            ok bool contract_ok => match contract_ok
                                                false => ok false
                                                true => match call fd_bytes_ok(entry.bytes_offered, entry.bytes_accepted)
                                                    ok bool counts_ok => match counts_ok
                                                        false => ok false
                                                        true => match entry.fd is 4
                                                            true => match entry.byte_state is "none"
                                                                false => ok false
                                                                true => match entry.eof_state is "none"
                                                                    false => ok false
                                                                    true => match entry.bytes_offered is 0
                                                                        false => ok false
                                                                        true => match entry.bytes_accepted is 0
                                                                            true => ok true
                                                                            false => ok false
                                                            false => match entry.byte_state is "none"
                                                                true => ok false
                                                                false => match entry.eof_state is "none"
                                                                    true => ok false
                                                                    false => match entry.byte_state is "exhausted"
                                                                        true => match call sealed_eof(entry.eof_state)
                                                                            ok bool sealed => match sealed
                                                                                false => ok false
                                                                                true => match entry.lifetime is "released"
                                                                                    false => ok true
                                                                                    true => match entry.eof_state is "closed"
                                                                                        true => ok true
                                                                                        false => ok false
                                                                        false => match entry.eof_state is "closed"
                                                                            true => ok false
                                                                            false => match entry.lifetime is "released"
                                                                                false => ok true
                                                                                true => ok false
/// Whether an fd appears in the entries at or after an index.
fn bool fd_seen
    emits {}
    given
        descriptor::fd_entry[] entries
        int fd
        int index
    asserts
        hit: [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0)], 0, 0 => ok true
        miss: [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0)], 1, 0 => ok false
        empty: [], 0, 0 => ok false
        offset: [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0)], 0, 1 => ok false
    match index >= entries.length
        true => ok false
        false => match entries[index].fd is fd
            true => ok true
            false => relay call fd_seen(entries, fd, index + 1)
/// Exactly fds 0,1,2,3,4: five entries with each fd present (hence once).
fn bool fd_set_ok
    emits {}
    given
        descriptor::fd_entry[] entries
    asserts
        full: [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)] => ok true
        short: [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0)] => ok false
        dup: [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)] => ok false
    match entries.length is 5
        false => ok false
        true => match call fd_seen(entries, 0, 0)
            ok bool seen0 => match seen0
                false => ok false
                true => match call fd_seen(entries, 1, 0)
                    ok bool seen1 => match seen1
                        false => ok false
                        true => match call fd_seen(entries, 2, 0)
                            ok bool seen2 => match seen2
                                false => ok false
                                true => match call fd_seen(entries, 3, 0)
                                    ok bool seen3 => match seen3
                                        false => ok false
                                        true => match call fd_seen(entries, 4, 0)
                                            ok bool seen4 => match seen4
                                                true => ok true
                                                false => ok false
/// Every entry from an index validates.
fn bool all_entries_ok
    emits {}
    given
        descriptor::fd_entry[] entries
        int index
    asserts
        one: [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 1024, 256)], 0 => ok true
        bad: [descriptor::fd_entry(0, "C", "in", "streaming", "open", "active", 1024, 256)], 0 => ok false
        empty: [], 0 => ok true
    match index >= entries.length
        true => ok true
        false => match call fd_entry_ok(entries[index])
            ok bool head_ok => match head_ok
                false => ok false
                true => relay call all_entries_ok(entries, index + 1)
/// Whole descriptor map: schema version 1, id-shaped run/launch, a fresh
/// snapshot bound to a generation digest, exactly fds 0..4, every entry ok.
/// Rows mirror the K17 fixtures 1:1 (fresh/drained valid plus all seven
/// invalid maps) with two synthetic unit rows (bad version/digest).
fn bool descriptor_map_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        descriptor::descriptor_map doc
    asserts
        fresh: descriptor::descriptor_map("1", "run-20260930-001", "launch-0001", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 1024, 256), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 4096, 4096), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok true
        drained: descriptor::descriptor_map("1", "run-20260930-001", "launch-0002", descriptor::snapshot("fresh", "sha256:b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7"), [descriptor::fd_entry(0, "N", "in", "exhausted", "eof-observed", "active", 1024, 1024), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 512, 200), descriptor::fd_entry(2, "N", "out", "exhausted", "closed", "released", 64, 64), descriptor::fd_entry(3, "N", "in", "exhausted", "eof-sent", "active", 4096, 4000), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok true
        accepted_overflow: descriptor::descriptor_map("1", "run-20260930-001", "launch-0009", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 100, 101), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        foreign_owner: descriptor::descriptor_map("1", "run-20260930-001", "launch-0009", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "C", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        missing_fd3: descriptor::descriptor_map("1", "run-20260930-001", "launch-0009", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        open_exhausted: descriptor::descriptor_map("1", "run-20260930-001", "launch-0009", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "exhausted", "open", "active", 100, 100), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        private_fd: descriptor::descriptor_map("1", "run-20260930-001", "launch-0009", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(5, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        reused_snapshot: descriptor::descriptor_map("1", "run-20260930-001", "launch-0009", descriptor::snapshot("reused", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        wrong_direction: descriptor::descriptor_map("1", "run-20260930-001", "launch-0009", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(1, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 0, 0), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        bad_version: descriptor::descriptor_map("2", "run-20260930-001", "launch-0001", descriptor::snapshot("fresh", "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 1024, 256), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 4096, 4096), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
        bad_digest: descriptor::descriptor_map("1", "run-20260930-001", "launch-0001", descriptor::snapshot("fresh", "nope"), [descriptor::fd_entry(0, "N", "in", "streaming", "open", "active", 1024, 256), descriptor::fd_entry(1, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(2, "N", "out", "streaming", "open", "active", 0, 0), descriptor::fd_entry(3, "N", "in", "streaming", "open", "active", 4096, 4096), descriptor::fd_entry(4, "N", "hold", "none", "none", "active", 0, 0)]) => ok false
    match doc.schema_version is "1"
        false => ok false
        true => match call id_ok(doc.run_id)
            text::invalid_regex
            text::invalid_limit
            ok bool run_ok => match run_ok
                false => ok false
                true => match call id_ok(doc.launch_id)
                    text::invalid_regex
                    text::invalid_limit
                    ok bool launch_ok => match launch_ok
                        false => ok false
                        true => match doc.snapshot.state is "fresh"
                            false => ok false
                            true => match call digest_ok(doc.snapshot.generation_digest)
                                text::invalid_regex
                                text::invalid_limit
                                ok bool digest_good => match digest_good
                                    false => ok false
                                    true => match call fd_set_ok(doc.descriptors)
                                        ok bool set_ok => match set_ok
                                            false => ok false
                                            true => match call all_entries_ok(doc.descriptors, 0)
                                                ok bool entries_ok => match entries_ok
                                                    true => ok true
                                                    false => ok false
