package i11
    provides [direction_known, byte_state_known, eof_state_known, lifetime_known, entry_known, log_sink_known, sealed_eof, fd_direction_ok, id_ok, digest_ok, env_name_ok, arg_ok, count_ok]
    uses [descriptor, option, test, text]

/// Descriptor-delivery closed vocabularies and wire shapes (I11). The word
/// sets are exactly the K17 descriptor-map/environment schema enums; the
/// shape predicates compile the K17 $defs patterns (id/digest/envName/arg)
/// and the count range. fd_direction_ok pins the fixed K17 direction
/// contract (child side: 0 in, 1 out, 2 out, 3 in, 4 hold). Regex failures
/// relay invalid_regex/invalid_limit (the patterns are static literals, so
/// rows never see them); every assert pins a real computed answer.

/// Closed direction vocabulary: exactly in/out/hold.
fn bool direction_known
    emits {}
    given
        str direction
    asserts
        stdin: "in" => ok true
        stdout: "out" => ok true
        lease: "hold" => ok false
        both: "inout" => ok false
        empty: "" => ok false
    match direction
        "in" => ok true
        "out" => ok true
        "hold" => ok true
        _ => ok false
/// Closed byte-state vocabulary: exactly none/streaming/exhausted.
fn bool byte_state_known
    emits {}
    given
        str state
    asserts
        none: "none" => ok true
        streaming: "streaming" => ok true
        exhausted: "exhausted" => ok true
        open: "open" => ok false
        empty: "" => ok false
    match state
        "none" => ok true
        "streaming" => ok true
        "exhausted" => ok true
        _ => ok false
/// Closed eof-state vocabulary: exactly none/open/eof-sent/eof-observed/closed.
fn bool eof_state_known
    emits {}
    given
        str state
    asserts
        none: "none" => ok true
        open: "open" => ok true
        sent: "eof-sent" => ok true
        observed: "eof-observed" => ok true
        closed: "closed" => ok true
        done: "done" => ok false
        empty: "" => ok false
    match state
        "none" => ok true
        "open" => ok true
        "eof-sent" => ok true
        "eof-observed" => ok true
        "closed" => ok true
        _ => ok false
/// Closed lifetime vocabulary: exactly active/released.
fn bool lifetime_known
    emits {}
    given
        str lifetime
    asserts
        active: "active" => ok true
        released: "released" => ok true
        dead: "dead" => ok false
        empty: "" => ok false
    match lifetime
        "active" => ok true
        "released" => ok true
        _ => ok false
/// Closed entry vocabulary: exactly c-cli/direct-entry.
fn bool entry_known
    emits {}
    given
        str entry
    asserts
        cli: "c-cli" => ok true
        direct: "direct-entry" => ok true
        shell: "shell" => ok false
        empty: "" => ok false
    match entry
        "c-cli" => ok true
        "direct-entry" => ok true
        _ => ok false
/// Closed log-sink vocabulary: exactly fd1/fd2/none. Paths are
/// unrepresentable: log routing is an fd enum only.
fn bool log_sink_known
    emits {}
    given
        str sink
    asserts
        out: "fd1" => ok true
        err: "fd2" => ok true
        none: "none" => ok true
        path: "/tmp/x.log" => ok false
        fd3: "fd3" => ok false
    match sink
        "fd1" => ok true
        "fd2" => ok true
        "none" => ok true
        _ => ok false
/// Sealed eof set: exactly eof-sent/eof-observed/closed (K17 SEALED_EOF).
fn bool sealed_eof
    emits {}
    given
        str state
    asserts
        sent: "eof-sent" => ok true
        observed: "eof-observed" => ok true
        closed: "closed" => ok true
        open: "open" => ok false
        none: "none" => ok false
    match state
        "eof-sent" => ok true
        "eof-observed" => ok true
        "closed" => ok true
        _ => ok false
/// Fixed K17 direction contract, child side: 0 in, 1 out, 2 out, 3 in,
/// 4 hold. Any other fd, or any other direction for a known fd, is false.
fn bool fd_direction_ok
    emits {}
    given
        int fd
        str direction
    asserts
        stdin: 0, "in" => ok true
        stdout: 1, "out" => ok true
        stderr: 2, "out" => ok true
        extra: 3, "in" => ok true
        lease: 4, "hold" => ok true
        flipped: 0, "out" => ok false
        private: 5, "in" => ok false
        negative: -1, "in" => ok false
    match fd is 0
        true => match direction is "in"
            true => ok true
            false => ok false
        false => match fd is 1
            true => match direction is "out"
                true => ok true
                false => ok false
            false => match fd is 2
                true => match direction is "out"
                    true => ok true
                    false => ok false
                false => match fd is 3
                    true => match direction is "in"
                        true => ok true
                        false => ok false
                    false => match fd is 4
                        true => match direction is "hold"
                            true => ok true
                            false => ok false
                        false => ok false
/// K17 id shape: ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$ (run/launch ids).
fn bool id_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str value
    asserts
        run: "run-20260930-001" => ok true
        launch: "launch-0001" => ok true
        lead_dash: "-run" => ok false
        blank: "" => ok false
        spaced: "run 1" => ok false
    match call text::compile_regex("^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, value, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K17 digest shape: ^sha256:[0-9a-f]{64}$ (snapshot/env digests).
fn bool digest_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str value
    asserts
        gen: "sha256:a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3" => ok true
        short: "sha256:a3a3" => ok false
        upper: "sha256:A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3A3" => ok false
        bare: "a3a3a3a3" => ok false
    match call text::compile_regex("^sha256:[0-9a-f]{64}$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, value, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K17 envName shape: ^[A-Z][A-Z0-9_]{0,63}$ (env_names items).
fn bool env_name_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str value
    asserts
        path: "PATH" => ok true
        locale: "CAN_LOCALE" => ok true
        lower: "path" => ok false
        lead_digit: "9LIVES" => ok false
        empty: "" => ok false
    match call text::compile_regex("^[A-Z][A-Z0-9_]{0,63}$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, value, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K17 arg shape: 1..512 chars. Length counts regex code units, which
/// agrees with schema chars on the ASCII argv fixtures.
fn bool arg_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str value
    asserts
        word: "run" => ok true
        flag: "--case" => ok true
        empty: "" => ok false
    match call text::compile_regex("^[\\s\\S]{1,512}$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, value, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K17 count shape: 0..9007199254740991 (byte counts).
fn bool count_ok
    emits {}
    given
        int n
    asserts
        zero: 0 => ok true
        kilo: 1024 => ok true
        max: 9007199254740991 => ok true
        negative: -1 => ok false
        over: 9007199254740992 => ok false
    match n >= 0
        false => ok false
        true => match n <= 9007199254740991
            true => ok true
            false => ok false
