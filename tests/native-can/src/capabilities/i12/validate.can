package i12
    provides [probe_report_ok]
    uses [descriptor]

/// Probe verdict acceptance (I12): the S/A verdict helper the Q suite
/// calls on every descriptor::probe_lease result. The report path must
/// echo the probe target exactly (the adapter relays the owner path
/// verbatim and never invents it), and the verdict must be coherent
/// (lease_report_ok). Echo and coherence are independent gates: a
/// coherent verdict for the wrong path still fails. The probe op
/// itself has no Can wrapper (live N observations; emitter fixture
/// chain only). Every assert pins a real computed answer; rows are
/// static until qualified execution.

/// Accept a probe verdict: exact path echo plus a coherent verdict.
fn bool probe_report_ok
    emits {}
    given
        str expected
        descriptor::lease_report report
    asserts
        held_echo: "/tmp/can-fd4.lease", descriptor::lease_report("/tmp/can-fd4.lease", true, true, false) => ok true
        released_echo: "/tmp/can-fd4.lease", descriptor::lease_report("/tmp/can-fd4.lease", true, false, true) => ok true
        mismatch: "/tmp/can-fd4.lease", descriptor::lease_report("/tmp/other.lease", true, true, false) => ok false
        incoherent: "/tmp/can-fd4.lease", descriptor::lease_report("/tmp/can-fd4.lease", true, true, true) => ok false
        empty_echo: "", descriptor::lease_report("", true, false, false) => ok false
    match report.path is expected
        false => ok false
        true => match call lease_report_ok(report)
            ok bool coherent => match coherent
                true => ok true
                false => ok false
