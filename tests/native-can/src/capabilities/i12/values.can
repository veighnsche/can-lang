package i12
    provides [lease_path_ok, lease_state, lease_report_ok]
    uses [descriptor]

/// Inherited generation-lease verdict vocabulary (I12). The K19 probe
/// surface is thin on purpose: paths are non-empty (AcquireLease and
/// ProbeLease reject the empty path), and the verdict is three bools.
/// lease_state classifies the raw verdict (held wins on incoherent
/// input; lease_report_ok rejects such reports); lease_report_ok pins
/// the coupling (released implies not held). inherited is context
/// (the fd-4 hold), not coupled to the verdict. Every assert pins a
/// real computed answer; rows are static until qualified execution.

/// Lease paths are non-empty: K19 rejects the empty path before any
/// filesystem or lock work. No filename pattern exists (AcquireLease
/// takes any path), so shape checks stop here.
fn bool lease_path_ok
    emits {}
    given
        str path
    asserts
        abs: "/tmp/can-fd4.lease" => ok true
        nested: "/var/run/can/leases/gen-7.lease" => ok true
        empty: "" => ok false
    match path is ""
        true => ok false
        false => ok true
/// Classify the raw probe verdict: held while any process holds the
/// lock, released once the lease file is gone, free when the file
/// exists with no holder. held wins over released on incoherent
/// input; lease_report_ok rejects such reports instead of guessing.
fn str lease_state
    emits {}
    given
        descriptor::lease_report report
    asserts
        held: descriptor::lease_report("/tmp/can-fd4.lease", true, true, false) => ok "held"
        free: descriptor::lease_report("/tmp/can-fd4.lease", true, false, false) => ok "free"
        released: descriptor::lease_report("/tmp/can-fd4.lease", true, false, true) => ok "released"
        foreign: descriptor::lease_report("/tmp/other.lease", false, false, false) => ok "free"
        incoherent: descriptor::lease_report("/tmp/can-fd4.lease", true, true, true) => ok "held"
    match report.held
        true => ok "held"
        false => match report.released
            true => ok "released"
            false => ok "free"
/// Coherent probe verdicts: a non-empty path, and a released path is
/// held by nobody (a gone file carries no lock). inherited is the
/// fd-4 context bit and stays uncoupled: foreign free verdicts are
/// coherent (an unrelated path with no holder probes free).
fn bool lease_report_ok
    emits {}
    given
        descriptor::lease_report report
    asserts
        held: descriptor::lease_report("/tmp/can-fd4.lease", true, true, false) => ok true
        free: descriptor::lease_report("/tmp/can-fd4.lease", true, false, false) => ok true
        released: descriptor::lease_report("/tmp/can-fd4.lease", true, false, true) => ok true
        foreign_free: descriptor::lease_report("/tmp/other.lease", false, false, false) => ok true
        empty_path: descriptor::lease_report("", true, false, false) => ok false
        incoherent: descriptor::lease_report("/tmp/can-fd4.lease", true, true, true) => ok false
    match call lease_path_ok(report.path)
        ok bool path_ok => match path_ok
            false => ok false
            true => match report.released
                false => ok true
                true => match report.held
                    true => ok false
                    false => ok true
