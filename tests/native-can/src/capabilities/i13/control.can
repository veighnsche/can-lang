            one: owner, "compile-0", [db::seed_row([db::number_cell("7")])] => ok db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::final_rows_facts got => ok got
/// Re-read final-row facts.
fn db::final_rows_facts read_final
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str compile
    asserts
        first: "compile-0" => ok db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
    match call db::final_facts(owner, compile)
        when
            first: owner, "compile-0" => ok db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::final_rows_facts got => ok got
/// Compare payload rows against final rows of one compile;
/// cross-compile facts reject malformed-statement.
fn db::returning_comparison compare_payload_final
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        db::returning_payload_facts payload
        db::final_rows_facts final
    asserts
        agreed: db::returning_payload_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub"), db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok db::returning_comparison(true, [])
    match call db::compare_payload_to_final(owner, payload, final)
        when
            agreed: owner, db::returning_payload_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub"), db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok db::returning_comparison(true, [])
        test::stale_handle
        db::db_fault
        ok db::returning_comparison got => ok got
/// Compare claimed cells against stored payload or final cells.
/// Never throws: emits stale_handle only.
fn db::returning_comparison compare_claimed_cells
    emits {test::stale_handle}
    given
        test::owner owner
        db::cell[] stored
        db::cell[] claimed
    asserts
        exact: [db::text_cell("a")], [db::text_cell("a")] => ok db::returning_comparison(true, [])
        drifted: [db::text_cell("a")], [db::text_cell("b")] => ok db::returning_comparison(false, [0])
    match call db::compare_claimed_row(owner, stored, claimed)
        when
            exact: owner, [db::text_cell("a")], [db::text_cell("a")] => ok db::returning_comparison(true, [])
            drifted: owner, [db::text_cell("a")], [db::text_cell("b")] => ok db::returning_comparison(false, [0])
        test::stale_handle
        ok db::returning_comparison got => ok got
/// Report the constant never-credit-C verdict: raw RETURNING
/// alone cannot credit C; QD1 holds credit.
fn db::returning_credit_verdict read_credit_verdict
    emits {test::stale_handle}
    given
        test::owner owner
    asserts
        fresh: => ok db::returning_credit_verdict(false, "raw RETURNING alone cannot credit C")
    match call db::credit_verdict(owner)
        when
            fresh: owner => ok db::returning_credit_verdict(false, "raw RETURNING alone cannot credit C")
        test::stale_handle
        ok db::returning_credit_verdict got => ok got
