    asserts
        one: "compile-0", [db::seed_row([db::number_cell("7")])] => ok db::final_rows_facts("compile-0", 1, [db::returning_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
    match call db::record_final_rows(owner, compile, rows)
