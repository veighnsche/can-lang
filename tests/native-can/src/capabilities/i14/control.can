/// Re-read settlement facts; unsettled actors throw.
fn db::settlement_record read_settlement
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str actor
    asserts
        first: "a1" => ok db::settlement_record("a1", "conn:a1", "committed", "postgres", "sha256:stub")
    match call db::settlement_facts(owner, actor)
        when
            first: owner, "a1" => ok db::settlement_record("a1", "conn:a1", "committed", "postgres", "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::settlement_record got => ok got
/// Release the actor handle after settlement; early release refuses.
fn db::release_record release_actor
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str actor
        str token
    asserts
        freed: "a1", "txn-token-stub" => ok db::release_record("a1", "conn:a1", true, "sha256:stub")
    match call db::release(owner, actor, token)
        when
            freed: owner, "a1", "txn-token-stub" => ok db::release_record("a1", "conn:a1", true, "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::release_record got => ok got
/// Re-read the release acknowledgment.
fn db::release_record read_release
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str actor
    asserts
        freed: "a1" => ok db::release_record("a1", "conn:a1", true, "sha256:stub")
    match call db::release_ack(owner, actor)
        when
            freed: owner, "a1" => ok db::release_record("a1", "conn:a1", true, "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::release_record got => ok got
