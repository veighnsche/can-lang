package i14
    provides [engine_known, outcome_known, actor_ok, actor_length_ok]
    uses [text]

/// Fresh-pool transaction closed vocabularies and actor shapes
/// (I14). The word sets are exactly the K24 closed vocabularies
/// (engines postgres/sqlite/mysql, outcomes
/// committed/rolled-back/unknown); actor_ok compiles the K24
/// checkActor charset (^[A-Za-z0-9][A-Za-z0-9_.:-]*$,
/// textually identical to the K22 name rule but mirrored here
/// because it is K24's own rule), and actor_length_ok pins the
/// 128-code cap. These mirror the NT-I14 checker allowlists
/// statically; the adapter re-validates at runtime and fails
/// unknown words as db_fault. Regex failures relay
/// invalid_regex/invalid_limit (patterns are static literals, so
/// rows never see them); every assert pins a real computed
/// answer. Length edge: the service counts UTF-16 code units
/// while Can counts Unicode scalars; the adapter enforces the
/// exact bound.

/// Closed engine vocabulary: exactly postgres/sqlite/mysql.
fn bool engine_known
    emits {}
    given
        str engine
    asserts
        postgres: "postgres" => ok true
        sqlite: "sqlite" => ok true
        mysql: "mysql" => ok true
        oracle: "oracle" => ok false
        empty: "" => ok false
    match engine
        "postgres" => ok true
        "sqlite" => ok true
        "mysql" => ok true
        _ => ok false
/// Closed outcome vocabulary: exactly committed/rolled-back/unknown.
fn bool outcome_known
    emits {}
    given
        str outcome
    asserts
        committed: "committed" => ok true
        rolled_back: "rolled-back" => ok true
        unknown: "unknown" => ok true
        done: "done" => ok false
        empty: "" => ok false
    match outcome
        "committed" => ok true
        "rolled-back" => ok true
        "unknown" => ok true
        _ => ok false
/// K24 actor charset: ^[A-Za-z0-9][A-Za-z0-9_.:-]*$.
fn bool actor_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str actor
    asserts
        plain: "a1" => ok true
        dotted: "worker-2:x" => ok true
        leading_dash: "-a1" => ok false
        spaced: "a 1" => ok false
        empty: "" => ok false
    match call text::compile_regex("^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, actor, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K24 actor length cap: at most 128 codes (scalars approximation).
fn bool actor_length_ok
    emits {text::invalid_unicode}
    given
        str actor
    asserts
        short: "a1" => ok true
        empty: "" => ok true
    match call text::scalars(actor)
        text::invalid_unicode
        ok int[] points => ok points.length <= 128
