package i15
    provides [begin_poison, begin_control, read_attempt, record_error, read_error, report_success, report_threw, read_callback, settle_poison_rolled_back, settle_poison_committed, read_poison_settlement, record_fresh, read_fresh, record_replay, read_replay, compare_reads, probe_fresh, probe_replay, read_agreement]
    uses [db, option, test]

/// Poison-attempt operation wrappers (I15): one function per
/// operation, except record_poison_settlement and
/// record_callback_report, which split one per word forced by the
/// NT-I15 literal allowlists (I01 per-kind precedent). Wrappers
/// are check-time-only: when-stubs pin the call shape and stub
/// facts; rows execute live at the Q gate. Owners are
/// admission-first (test::owner elides in rows). Rejection
/// verdicts stay visible as db::db_fault{layer, code} (the
/// adapter contract tests pin those verdicts instead).

/// Begin a poison attempt: sentinel write plus poison statement.
fn db::poison_attempt_record begin_poison
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str[] schema
        db::seed_row sentinel_row
        str poison_statement
    asserts
        fresh: ["number"], db::seed_row([db::number_cell("7")]), "DELETE FROM items" => ok db::poison_attempt_record("attempt-0", "poison", ["number"], "sha256:stub", option::some("sha256:stub"))
    match call db::begin_poison_attempt(owner, schema, sentinel_row, poison_statement)
        when
            fresh: owner, ["number"], db::seed_row([db::number_cell("7")]), "DELETE FROM items" => ok db::poison_attempt_record("attempt-0", "poison", ["number"], "sha256:stub", option::some("sha256:stub"))
        test::stale_handle
        db::db_fault
        ok db::poison_attempt_record got => ok got
/// Begin the omit-poison control with the same sentinel write.
fn db::poison_attempt_record begin_control
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str[] schema
        db::seed_row sentinel_row
    asserts
        fresh: ["number"], db::seed_row([db::number_cell("1")]) => ok db::poison_attempt_record("attempt-1", "control", ["number"], "sha256:stub", option::none())
    match call db::begin_control_attempt(owner, schema, sentinel_row)
        when
            fresh: owner, ["number"], db::seed_row([db::number_cell("1")]) => ok db::poison_attempt_record("attempt-1", "control", ["number"], "sha256:stub", option::none())
        test::stale_handle
        db::db_fault
        ok db::poison_attempt_record got => ok got
/// Re-read an attempt record.
fn db::poison_attempt_record read_attempt
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str attempt
    asserts
        fresh: "attempt-0" => ok db::poison_attempt_record("attempt-0", "poison", ["number"], "sha256:stub", option::some("sha256:stub"))
    match call db::attempt_record(owner, attempt)
        when
            fresh: owner, "attempt-0" => ok db::poison_attempt_record("attempt-0", "poison", ["number"], "sha256:stub", option::some("sha256:stub"))
        test::stale_handle
        db::db_fault
        ok db::poison_attempt_record got => ok got
/// Record the PG error-code observation for the poison write.
fn db::poison_error_facts record_error
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str attempt
        str code
        str detail
    asserts
        first: "attempt-0", "23505", "duplicate key" => ok db::poison_error_facts("attempt-0", "23505", "23", "duplicate key", "sha256:stub")
    match call db::record_poison_error(owner, attempt, code, detail)
        when
            first: owner, "attempt-0", "23505", "duplicate key" => ok db::poison_error_facts("attempt-0", "23505", "23", "duplicate key", "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::poison_error_facts got => ok got
