/// Compare fresh rows against replay rows of one attempt;
/// cross-attempt facts reject malformed-statement.
fn db::sentinel_comparison compare_reads
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        db::fresh_sentinel_facts fresh
        db::replay_sentinel_facts replay
    asserts
        agreed: db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub"), db::replay_sentinel_facts("attempt-0", "replay", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok db::sentinel_comparison(true, [])
    match call db::compare_fresh_to_replay(owner, fresh, replay)
        when
            agreed: owner, db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub"), db::replay_sentinel_facts("attempt-0", "replay", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok db::sentinel_comparison(true, [])
        test::stale_handle
        db::db_fault
        ok db::sentinel_comparison got => ok got
/// Probe whether the sentinel row is present in a fresh read.
fn bool probe_fresh
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str attempt
        db::fresh_sentinel_facts read
    asserts
        present: "attempt-0", db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok true
    match call db::sentinel_present_in_fresh(owner, attempt, read)
        when
            present: owner, "attempt-0", db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok true
        test::stale_handle
        db::db_fault
        ok bool got => ok got
/// Probe whether the sentinel row is present in a replay read.
fn bool probe_replay
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str attempt
        db::replay_sentinel_facts read
    asserts
        present: "attempt-0", db::replay_sentinel_facts("attempt-0", "replay", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok true
    match call db::sentinel_present_in_replay(owner, attempt, read)
        when
            present: owner, "attempt-0", db::replay_sentinel_facts("attempt-0", "replay", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub") => ok true
        test::stale_handle
        db::db_fault
        ok bool got => ok got
/// Verdict whether terminal settlement agrees with both reads:
/// rolled-back needs the sentinel absent from both, committed
/// needs it present in both. Missing evidence throws instead of
/// defaulting; callback reports are never consulted.
fn db::settlement_agreement read_agreement
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str attempt
    asserts
        rolled_back: "attempt-0" => ok db::settlement_agreement(true, "sentinel-absent-after-rollback")
    match call db::settlement_agrees_with_reads(owner, attempt)
        when
            rolled_back: owner, "attempt-0" => ok db::settlement_agreement(true, "sentinel-absent-after-rollback")
        test::stale_handle
        db::db_fault
        ok db::settlement_agreement got => ok got
