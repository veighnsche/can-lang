    asserts
        first: "attempt-0" => ok db::poison_callback_facts("attempt-0", "success", "nothing")
    match call db::record_callback_report(owner, attempt, "success")
        when
            first: owner, "attempt-0", "success" => ok db::poison_callback_facts("attempt-0", "success", "nothing")
        test::stale_handle
        db::db_fault
        ok db::poison_callback_facts got => ok got
