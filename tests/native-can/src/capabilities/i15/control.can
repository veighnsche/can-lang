    asserts
        one: "attempt-0" => ok db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
    match call db::fresh_facts(owner, attempt)
        when
            one: owner, "attempt-0" => ok db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::fresh_sentinel_facts got => ok got
