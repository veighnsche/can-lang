/// Record the fresh-pool sentinel read.
fn db::fresh_sentinel_facts record_fresh
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str attempt
        db::seed_row[] rows
    asserts
        one: "attempt-0", [db::seed_row([db::number_cell("7")])] => ok db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
    match call db::record_fresh_read(owner, attempt, rows)
        when
            one: owner, "attempt-0", [db::seed_row([db::number_cell("7")])] => ok db::fresh_sentinel_facts("attempt-0", "fresh", 1, [db::sentinel_row_facts(0, [db::number_cell("7")], "sha256:stub")], "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::fresh_sentinel_facts got => ok got
/// Re-read fresh sentinel facts.
fn db::fresh_sentinel_facts read_fresh
    emits {test::stale_handle, db::db_fault}
    given
