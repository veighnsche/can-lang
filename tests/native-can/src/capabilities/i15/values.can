package i15
    provides [poison_outcome_known, callback_report_known, attempt_id_ok, pg_code_ok]
    uses [text]

/// Poison-attempt closed vocabularies and id/code shapes (I15).
/// The word sets are exactly the K25 closed vocabularies
/// (poison outcomes rolled-back/committed with no unknown,
/// callback reports success/threw); attempt_id_ok compiles the
/// K25 checkAttemptId shape (^attempt-[0-9]+$), and pg_code_ok
/// compiles the K25 SQLSTATE rule (five uppercase alphanumerics
/// whose class is not 00) as one regex. These mirror the NT-I15
/// checker allowlists statically; the adapter re-validates at
/// runtime and fails unknown words as db_fault. Regex failures
/// relay invalid_regex/invalid_limit (patterns are static
/// literals, so rows never see them); every assert pins a real
/// computed answer.

/// Closed poison-outcome vocabulary: rolled-back/committed only.
fn bool poison_outcome_known
    emits {}
    given
        str outcome
    asserts
        rolled_back: "rolled-back" => ok true
        committed: "committed" => ok true
        unknown: "unknown" => ok false
        empty: "" => ok false
    match outcome
        "rolled-back" => ok true
        "committed" => ok true
        _ => ok false
/// Closed callback-report vocabulary: success/threw only.
fn bool callback_report_known
    emits {}
    given
        str reported
    asserts
        success: "success" => ok true
        threw: "threw" => ok true
        okay: "ok" => ok false
        empty: "" => ok false
    match reported
        "success" => ok true
        "threw" => ok true
        _ => ok false
/// K25 attempt id shape: ^attempt-[0-9]+$ (begin mints attemptN).
fn bool attempt_id_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str attempt
    asserts
        zeroth: "attempt-0" => ok true
        twelfth: "attempt-12" => ok true
        bare: "attempt" => ok false
        alpha: "attempt-x" => ok false
        empty: "" => ok false
    match call text::compile_regex("^attempt-[0-9]+$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, attempt, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// K25 SQLSTATE rule: five uppercase alphanumerics, class not 00.
fn bool pg_code_ok
    emits {text::invalid_regex, text::invalid_limit}
    given
        str code
    asserts
        unique_violation: "23505" => ok true
        not_null: "23502" => ok true
        success: "00000" => ok false
        short: "2350" => ok false
        lower: "2350a" => ok false
        empty: "" => ok false
    match call text::compile_regex("^(0[1-9A-Z]|[1-9A-Z][0-9A-Z])[0-9A-Z]{3}$", "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, code, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
