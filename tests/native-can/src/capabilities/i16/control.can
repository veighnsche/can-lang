/// Acquire a postgres cancel grant: the only engine with a
/// server-cancel channel.
fn db::cancel_grant grant_cancel_postgres
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
    asserts
        first: => ok db::cancel_grant(db::cancel_grant_facts("postgres", "sha256:stub"), "grant-stub")
    match call db::acquire_cancel_grant(owner, "postgres")
        when
            first: owner, "postgres" => ok db::cancel_grant(db::cancel_grant_facts("postgres", "sha256:stub"), "grant-stub")
        test::stale_handle
        db::db_fault
        ok db::cancel_grant got => ok got
