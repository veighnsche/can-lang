        str work
    asserts
        first: "work-0" => ok db::deadline_record("work-0", "postgres", 50, "sha256:stub")
    match call db::deadline_facts(owner, work)
        when
            first: owner, "work-0" => ok db::deadline_record("work-0", "postgres", 50, "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::deadline_record got => ok got
