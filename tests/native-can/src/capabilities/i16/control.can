        when
            first: owner, "work-0", "tok-stub", "completed" => ok db::driver_settlement_facts("work-0", "postgres", "completed", "unresolved", "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::driver_settlement_facts got => ok got
