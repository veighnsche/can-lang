    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str work
        str token
    asserts
        first: "work-0", "tok-stub" => ok db::fence_record("work-0", "postgres", "nothing", "sha256:stub")
    match call db::fence(owner, work, token)
        when
            first: owner, "work-0", "tok-stub" => ok db::fence_record("work-0", "postgres", "nothing", "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::fence_record got => ok got
