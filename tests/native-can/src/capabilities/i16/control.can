package i16
    provides [dispatch_postgres, dispatch_sqlite, dispatch_mysql, read_dispatch, watch_deadline, read_deadline, settle_driver_completed, settle_driver_timed_out, read_driver, ack_server_applied, ack_server_absent, ack_server_unknown, read_server, grant_cancel_postgres, grant_cancel_sqlite, grant_cancel_mysql, ask_cancel, read_cancel, rest_postgres, rest_sqlite, rest_mysql, fence_work, read_fence, read_lease, free_work, read_release]
    uses [db, test]

/// Deadline-settlement operation wrappers (I16): one function
/// per operation, except dispatch, record_driver_settlement,
/// record_server_ack, acquire_cancel_grant and quiesce_engine,
/// which split one per word forced by the NT-I16 literal
/// allowlists (I01 per-kind precedent). Wrappers are
/// check-time-only: when-stubs pin the call shape and stub
/// facts; rows execute live at the Q gate. Owners are
/// admission-first (test::owner elides in rows). Rejection
/// verdicts stay visible as db::db_fault{layer, code} (the
/// adapter contract tests pin those verdicts instead). The
/// sqlite/mysql cancel-grant wrappers pin the call shape only:
/// those engines have no server-cancel channel, so live
/// execution always refuses malformed-statement.

/// Dispatch one SQL work item to postgres; the statement is
/// named by digest only, never executed.
fn db::dispatched_work dispatch_postgres
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str work
        str statement
    asserts
        first: "work-0", "SELECT 1" => ok db::dispatched_work(db::dispatch_record("work-0", "postgres", "ns-alpha", "sha256:stub", "sha256:stub"), "tok-stub")
    match call db::dispatch(owner, work, statement, "postgres")
        when
            first: owner, "work-0", "SELECT 1", "postgres" => ok db::dispatched_work(db::dispatch_record("work-0", "postgres", "ns-alpha", "sha256:stub", "sha256:stub"), "tok-stub")
        test::stale_handle
        db::db_fault
        ok db::dispatched_work got => ok got
