/// Request cancellation under a capable grant; the recorded
/// cancel proves nothing about the server.
fn db::cancel_record ask_cancel
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str work
        str token
        str grant
    asserts
        first: "work-0", "tok-stub", "grant-stub" => ok db::cancel_record("work-0", "postgres", "nothing-about-server", "sha256:stub")
    match call db::request_cancel(owner, work, token, grant)
        when
            first: owner, "work-0", "tok-stub", "grant-stub" => ok db::cancel_record("work-0", "postgres", "nothing-about-server", "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::cancel_record got => ok got
