/// Quiesce postgres: stop new dispatches, report live work.
fn str[] rest_postgres
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
    asserts
        first: => ok ["work-0"]
    match call db::quiesce_engine(owner, "postgres")
        when
            first: owner, "postgres" => ok ["work-0"]
        test::stale_handle
        db::db_fault
        ok str[] got => ok got
