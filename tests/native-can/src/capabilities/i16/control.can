/// Re-read dispatch facts for one work item.
fn db::dispatch_record read_dispatch
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str work
    asserts
        first: "work-0" => ok db::dispatch_record("work-0", "postgres", "ns-alpha", "sha256:stub", "sha256:stub")
    match call db::dispatch_facts(owner, work)
        when
            first: owner, "work-0" => ok db::dispatch_record("work-0", "postgres", "ns-alpha", "sha256:stub", "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::dispatch_record got => ok got
/// Observe the visible deadline tick for one dispatched work;
/// single record, and driver settlement needs it first.
fn db::deadline_record watch_deadline
    emits {test::stale_handle, db::db_fault}
    given
        test::owner owner
        str work
        str token
        int deadline_ms
    asserts
        first: "work-0", "tok-stub", 50 => ok db::deadline_record("work-0", "postgres", 50, "sha256:stub")
    match call db::observe_deadline(owner, work, token, deadline_ms)
        when
            first: owner, "work-0", "tok-stub", 50 => ok db::deadline_record("work-0", "postgres", 50, "sha256:stub")
        test::stale_handle
        db::db_fault
        ok db::deadline_record got => ok got
/// Re-read deadline facts for one work item.
fn db::deadline_record read_deadline
    emits {test::stale_handle, db::db_fault}
    given
