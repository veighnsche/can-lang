package i17
    provides [open_prefix, read_receipt, close_prefix, open_session, read_token, close_session, stage_write, settle_write, read_pending, fetch_object, remove_object, same_bytes, scan_page, seal_store, shared_digest]
    uses [bytes, option, store, test]

/// Object-store operation wrappers (I17): one function per
/// operation; K27 carries no closed input vocabulary, so no
/// per-word splits exist. Wrappers are check-time-only:
/// when-stubs pin the call shape and stub facts; rows execute
/// live at the Q gate. Owners are admission-first (test::owner
/// elides in rows). The K27 owner string travels as
/// grant_owner to keep it distinct from the admission handle.
/// Buffers cross as bytes::buffer: stubs pin the empty buffer
/// through the infallible bytes::empty() call (opaque results
/// cannot be constructed literally). Rejection verdicts stay
/// visible as store::store_fault{layer, code} (the adapter
/// contract tests pin those verdicts instead).

/// Open one owned prefix under an exact grant.
fn store::prefix_receipt open_prefix
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
    asserts
        first: "owner-a", "tenant-a/owned" => ok store::prefix_receipt("tenant-a/owned", "owner-a", "prefix-handle:owner-a:tenant-a/owned", "sha256:stub", 0)
    match call store::open_prefix(owner, grant_owner, prefix)
        when
            first: owner, "owner-a", "tenant-a/owned" => ok store::prefix_receipt("tenant-a/owned", "owner-a", "prefix-handle:owner-a:tenant-a/owned", "sha256:stub", 0)
        test::stale_handle
        store::store_fault
        ok store::prefix_receipt got => ok got
/// Re-read the prefix receipt.
fn store::prefix_receipt read_receipt
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
    asserts
        first: "owner-a", "tenant-a/owned" => ok store::prefix_receipt("tenant-a/owned", "owner-a", "prefix-handle:owner-a:tenant-a/owned", "sha256:stub", 0)
    match call store::receipt(owner, grant_owner, prefix)
        when
            first: owner, "owner-a", "tenant-a/owned" => ok store::prefix_receipt("tenant-a/owned", "owner-a", "prefix-handle:owner-a:tenant-a/owned", "sha256:stub", 0)
        test::stale_handle
        store::store_fault
        ok store::prefix_receipt got => ok got
/// Close one owned prefix; pinned sessions refuse.
fn void close_prefix
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
    asserts
        first: "owner-a", "tenant-a/owned" => ok
    match call store::close_prefix(owner, grant_owner, prefix)
        when
            first: owner, "owner-a", "tenant-a/owned" => ok
        test::stale_handle
        store::store_fault
        ok => ok
/// Pin one session to an owned prefix; facts carry no token.
fn store::session_facts open_session
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
    asserts
        first: "owner-a", "tenant-a/owned", "s0" => ok store::session_facts("s0", "tenant-a/owned", "owner-a", "sha256:stub", true)
    match call store::open_session(owner, grant_owner, prefix, session)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0" => ok store::session_facts("s0", "tenant-a/owned", "owner-a", "sha256:stub", true)
        test::stale_handle
        store::store_fault
        ok store::session_facts got => ok got
/// Read the pinned session token; the sole readout.
fn str read_token
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
    asserts
        first: "owner-a", "tenant-a/owned", "s0" => ok "sess-stub"
    match call store::session_token_for_test(owner, grant_owner, prefix, session)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0" => ok "sess-stub"
        test::stale_handle
        store::store_fault
        ok str got => ok got
/// Close one pinned session under its token.
fn void close_session
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
        str token
    asserts
        first: "owner-a", "tenant-a/owned", "s0", "tok-stub" => ok
    match call store::close_session(owner, grant_owner, prefix, session, token)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0", "tok-stub" => ok
        test::stale_handle
        store::store_fault
        ok => ok
/// Accept one write; accepted is not settled.
fn store::write_facts stage_write
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
        str token
        str key
        bytes::buffer payload
    asserts
        first: "owner-a", "tenant-a/owned", "s0", "tok-stub", "tenant-a/owned/a", call bytes::empty() => ok store::write_facts("w1", "tenant-a/owned/a", "sha256:stub", false)
    match call store::put(owner, grant_owner, prefix, session, token, key, payload)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0", "tok-stub", "tenant-a/owned/a", call bytes::empty() => ok store::write_facts("w1", "tenant-a/owned/a", "sha256:stub", false)
        test::stale_handle
        store::store_fault
        ok store::write_facts got => ok got
/// Settle one accepted write into a visible object.
fn store::object_facts settle_write
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
        str token
        str write_id
    asserts
        first: "owner-a", "tenant-a/owned", "s0", "tok-stub", "w1" => ok store::object_facts("tenant-a/owned/a", 0, "sha256:stub")
    match call store::settle_write(owner, grant_owner, prefix, session, token, write_id)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0", "tok-stub", "w1" => ok store::object_facts("tenant-a/owned/a", 0, "sha256:stub")
        test::stale_handle
        store::store_fault
        ok store::object_facts got => ok got
/// List unsettled writes, sorted by write id.
fn store::pending_facts read_pending
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
        str token
    asserts
        first: "owner-a", "tenant-a/owned", "s0", "tok-stub" => ok store::pending_facts("tenant-a/owned", [store::write_facts("w1", "tenant-a/owned/a", "sha256:stub", false)], 1)
    match call store::pending(owner, grant_owner, prefix, session, token)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0", "tok-stub" => ok store::pending_facts("tenant-a/owned", [store::write_facts("w1", "tenant-a/owned/a", "sha256:stub", false)], 1)
        test::stale_handle
        store::store_fault
        ok store::pending_facts got => ok got
/// Fetch one settled object, byte-exact.
fn store::stored_object fetch_object
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
        str token
        str key
    asserts
        first: "owner-a", "tenant-a/owned", "s0", "tok-stub", "tenant-a/owned/a" => ok store::stored_object("tenant-a/owned/a", call bytes::empty(), 0, "sha256:stub")
    match call store::get(owner, grant_owner, prefix, session, token, key)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0", "tok-stub", "tenant-a/owned/a" => ok store::stored_object("tenant-a/owned/a", call bytes::empty(), 0, "sha256:stub")
        test::stale_handle
        store::store_fault
        ok store::stored_object got => ok got
/// Delete one settled object.
fn void remove_object
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
        str token
        str key
    asserts
        first: "owner-a", "tenant-a/owned", "s0", "tok-stub", "tenant-a/owned/a" => ok
    match call store::delete(owner, grant_owner, prefix, session, token, key)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0", "tok-stub", "tenant-a/owned/a" => ok
        test::stale_handle
        store::store_fault
        ok => ok
/// Compare two buffers for byte-exact equality.
fn bool same_bytes
    emits {test::stale_handle}
    given
        test::owner owner
        bytes::buffer stored
        bytes::buffer claimed
    asserts
        pair: call bytes::empty(), call bytes::empty() => ok true
    match call store::compare_bytes(owner, stored, claimed)
        when
            pair: owner, call bytes::empty(), call bytes::empty() => ok true
        test::stale_handle
        ok bool got => ok got
/// List one page of settled keys; none starts the listing.
fn store::page_facts scan_page
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
        str session
        str token
        int limit
        option::value<str> continuation
    asserts
        first: "owner-a", "tenant-a/owned", "s0", "tok-stub", 8, option::none() => ok store::page_facts("tenant-a/owned", [store::object_facts("tenant-a/owned/a", 0, "sha256:stub")], 1, true, option::none(), 0, "sha256:stub")
    match call store::list(owner, grant_owner, prefix, session, token, limit, continuation)
        when
            first: owner, "owner-a", "tenant-a/owned", "s0", "tok-stub", 8, option::none() => ok store::page_facts("tenant-a/owned", [store::object_facts("tenant-a/owned/a", 0, "sha256:stub")], 1, true, option::none(), 0, "sha256:stub")
        test::stale_handle
        store::store_fault
        ok store::page_facts got => ok got
/// Seal the prefix as cleaned up.
fn store::cleanup_receipt seal_store
    emits {test::stale_handle, store::store_fault}
    given
        test::owner owner
        str grant_owner
        str prefix
    asserts
        first: "owner-a", "tenant-a/owned" => ok store::cleanup_receipt("tenant-a/owned", "owner-a", "sha256:stub", 0, 0, 0, "sha256:stub")
    match call store::seal_cleanup(owner, grant_owner, prefix)
        when
            first: owner, "owner-a", "tenant-a/owned" => ok store::cleanup_receipt("tenant-a/owned", "owner-a", "sha256:stub", 0, 0, 0, "sha256:stub")
        test::stale_handle
        store::store_fault
        ok store::cleanup_receipt got => ok got
/// Digest the foreign shared bucket.
fn str shared_digest
    emits {test::stale_handle}
    given
        test::owner owner
    asserts
        first: => ok "sha256:stub"
    match call store::shared_digest(owner)
        when
            first: owner => ok "sha256:stub"
        test::stale_handle
        ok str got => ok got
