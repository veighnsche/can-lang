package controller
    provides [fanout_ok, fanout_rejected, fanout, aggregate_valid, aggregate_invalid, aggregate_missing, aggregate, plan_attempts, launch_keys, keys_distinct, combine_verdicts, join_attempts, source_send_fits, output_recv_fits, attempt_bound]
    uses [reducer, spec, text, worker]

/// Attempt fanout and aggregate join for one (case, variant) run (P19).
/// Ordinary Can owns the attempt vector, the shared identity keys, the
/// conjunctive join across attempts, and the direction-separate channel
/// checks; the Go handoff owns only the mechanics (spawn one fresh Bun
/// worker per launch, enforce liveness, move bounded bytes). Attempts are
/// repeated evidence, not retries: every attempt must complete with a
/// bound report, and any crash, timeout, rejection, drift, short vector or
/// controller death yields an invalid or missing aggregate, never a valid
/// one. Static checks here are provisional until P26/P23, like the P15
/// skeleton.

/// A fanned-out attempt vector: one launch per attempt, attempts running
/// 0, 1, 2 without gaps. The Go handoff spawns one fresh Bun worker per
/// launch in this vector.
record fanout_ok
    worker::launch[] launches
/// A rejected fanout: one diagnostic per detected problem. No worker
/// spawns behind a rejected fanout.
record fanout_rejected
    spec::diagnostic[] problems
/// Attempt-fanout outcome.
variant fanout
    fanout_ok
    fanout_rejected
/// A valid aggregate: the joined verdict across every attempt plus the
/// observed attempt count. Only a fully observed, fully bound join with a
/// live controller yields one; the verdict itself may still fail or stand
/// incomplete, but it is never forged from a crash, timeout or death.
record aggregate_valid
    reducer::reduced verdict
    int attempts
/// An invalid aggregate: a worker crash, timeout, rejection or identity
/// drift broke the join. The detail names the first broken attempt.
/// Never a verdict, never publishable as a pass.
record aggregate_invalid
    str detail
/// A missing aggregate: the controller died, nothing was planned, an
/// attempt never reported, or no verdict exists to join. Never a verdict.
record aggregate_missing
    str detail
/// Attempt-join outcome: a valid aggregate, or an explicit invalid/missing
/// aggregate that no qualifier may treat as evidence.
variant aggregate
    aggregate_valid
    aggregate_invalid
    aggregate_missing
/// One clean join step: the reduced verdict of a bound attempt.
record step_clean
    reducer::reduced verdict
/// One broken join step: the detail that invalidates the aggregate.
record step_broken
    str detail
/// Single-attempt join outcome: a verdict to gather, or the detail that
/// stops the join.
variant step_outcome
    step_clean
    step_broken
/// One clean combine step: the advanced matched total.
record combine_advance
    int matched
/// One stuck combine step: the verdict that sticks as the aggregate.
record combine_stuck
    reducer::reduced verdict
/// Single-verdict combine outcome: advance the total, or stick a verdict.
variant combine_outcome
    combine_advance
    combine_stuck
/// One fanout identity field must be present: an empty case, variant, run
/// or generation cannot route a worker.
fn spec::diagnostic[] id_problems
    emits {}
    given
        str value
        str field
        spec::context c
    asserts
        present: "a", "case", spec::context("a", "v", "", "r") => ok []
        missing: "", "case", spec::context("", "v", "", "r") => ok [spec::diagnostic("controller::plan_attempts", "case  variant v root fanout run r", "missing-id", "case")]
    match value is ""
        false => ok []
        true => ok [spec::diagnostic("controller::plan_attempts", call spec::reproduction_selector(c, "fanout"), "missing-id", field)]
/// The attempt count is bounded: at least one worker must run, and at most
/// eight share one join. The bound keeps the fanout a fixed vector, never
/// an open-ended retry loop; wider matrices plan several joins.
fn spec::diagnostic[] attempts_problems
    emits {}
    given
        int attempts
        spec::context c
    asserts
        one: 1, spec::context("a", "v", "", "r") => ok []
        eight: 8, spec::context("a", "v", "", "r") => ok []
        zero: 0, spec::context("a", "v", "", "r") => ok [spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "bad-attempts", "0")]
        nine: 9, spec::context("a", "v", "", "r") => ok [spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "bad-attempts", "9")]
    match attempts >= 1
        false => ok [spec::diagnostic("controller::plan_attempts", call spec::reproduction_selector(c, "fanout"), "bad-attempts", call text::from_int(attempts))]
        true => match attempts <= 8
            true => ok []
            false => ok [spec::diagnostic("controller::plan_attempts", call spec::reproduction_selector(c, "fanout"), "bad-attempts", call text::from_int(attempts))]
/// The worker deadline must be positive. The upper bound lives with the
/// worker slice: validate_launch fits the deadline inside the case budget
/// against the descriptor, which the controller does not carry.
fn spec::diagnostic[] timeout_problems
    emits {}
    given
        int timeout_ms
        spec::context c
    asserts
        some: 15000, spec::context("a", "v", "", "r") => ok []
        zero: 0, spec::context("a", "v", "", "r") => ok [spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "bad-timeout", "0")]
        negative: -5, spec::context("a", "v", "", "r") => ok [spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "bad-timeout", "-5")]
    match timeout_ms >= 1
        true => ok []
        false => ok [spec::diagnostic("controller::plan_attempts", call spec::reproduction_selector(c, "fanout"), "bad-timeout", call text::from_int(timeout_ms))]
/// Build the attempt vector from an index, threading gathered launches:
/// attempt numbers run with the index, so every launch in one fanout
/// shares case, variant, run, generation and deadline but owns a distinct
/// attempt.
fn worker::launch[] plan_at
    emits {}
    given
        str case_id
        str variant_id
        str run_id
        str generation
        int attempts
        int timeout_ms
        int index
        worker::launch[] gathered
    asserts
        pair: "a", "v", "r", "g", 2, 1000, 0, [] => ok [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)]
        tail: "a", "v", "r", "g", 2, 1000, 1, [worker::launch("a", "v", 0, "r", "g", 1000)] => ok [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)]
        done: "a", "v", "r", "g", 2, 1000, 2, [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)] => ok [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)]
    match index >= attempts
        true => ok gathered
        false => relay call plan_at(case_id, variant_id, run_id, generation, attempts, timeout_ms, index + 1, call append(gathered, worker::launch(case_id, variant_id, index, run_id, generation, timeout_ms)))
/// Fan out one attempt vector for a (case, variant): attempts launches
/// sharing the run, generation and deadline, attempt numbers 0..N-1. Every
/// identity, count and deadline problem is reported; only a clean fanout
/// yields launches for the Go handoff to spawn.
fn fanout plan_attempts
    emits {}
    given
        str case_id
        str variant_id
        str run_id
        str generation
        int attempts
        int timeout_ms
    asserts
        single: "a", "v", "r", "g", 1, 1000 => ok fanout_ok([worker::launch("a", "v", 0, "r", "g", 1000)])
        three: "a", "v", "r", "g", 3, 1000 => ok fanout_ok([worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000), worker::launch("a", "v", 2, "r", "g", 1000)])
        skeleton: "process/nonzero-result", "default", "run-1", "gen-7", 1, 15000 => ok fanout_ok([worker::launch("process/nonzero-result", "default", 0, "run-1", "gen-7", 15000)])
        zero: "a", "v", "r", "g", 0, 1000 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "bad-attempts", "0")])
        nine: "a", "v", "r", "g", 9, 1000 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "bad-attempts", "9")])
        missing_case: "", "v", "r", "g", 1, 1000 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case  variant v root fanout run r", "missing-id", "case")])
        missing_variant: "a", "", "r", "g", 1, 1000 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case a variant  root fanout run r", "missing-id", "variant")])
        missing_run: "a", "v", "", "g", 1, 1000 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run ", "missing-id", "run")])
        missing_generation: "a", "v", "r", "", 1, 1000 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "missing-id", "generation")])
        bad_timeout: "a", "v", "r", "g", 1, 0 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case a variant v root fanout run r", "bad-timeout", "0")])
        several: "", "", "", "", 0, 0 => ok fanout_rejected([spec::diagnostic("controller::plan_attempts", "case  variant  root fanout run ", "missing-id", "case"), spec::diagnostic("controller::plan_attempts", "case  variant  root fanout run ", "missing-id", "variant"), spec::diagnostic("controller::plan_attempts", "case  variant  root fanout run ", "missing-id", "run"), spec::diagnostic("controller::plan_attempts", "case  variant  root fanout run ", "missing-id", "generation"), spec::diagnostic("controller::plan_attempts", "case  variant  root fanout run ", "bad-attempts", "0"), spec::diagnostic("controller::plan_attempts", "case  variant  root fanout run ", "bad-timeout", "0")])
    match call spec::context_for(case_id, variant_id, "", run_id)
        ok spec::context c => match call id_problems(case_id, "case", c)
            ok spec::diagnostic[] p1 => match call id_problems(variant_id, "variant", c)
                ok spec::diagnostic[] p2 => match call id_problems(run_id, "run", c)
                    ok spec::diagnostic[] p3 => match call id_problems(generation, "generation", c)
                        ok spec::diagnostic[] p4 => match call attempts_problems(attempts, c)
                            ok spec::diagnostic[] p5 => match call timeout_problems(timeout_ms, c)
                                ok spec::diagnostic[] p6 => match call p1.concat(call p2.concat(call p3.concat(call p4.concat(call p5.concat(p6)))))
                                    ok spec::diagnostic[] all => match all.length is 0
                                        true => ok fanout_ok(call plan_at(case_id, variant_id, run_id, generation, attempts, timeout_ms, 0, []))
                                        false => ok fanout_rejected(all)
/// Render launch keys from an index, threading gathered keys in order.
fn str[] launch_keys_at
    emits {}
    given
        worker::launch[] launches
        int index
        str[] gathered
    asserts
        head: [worker::launch("a", "v", 0, "r", "g", 1000)], 0, [] => ok ["case a variant v attempt 0 run r generation g"]
        tail: [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)], 1, ["case a variant v attempt 0 run r generation g"] => ok ["case a variant v attempt 0 run r generation g", "case a variant v attempt 1 run r generation g"]
        done: [worker::launch("a", "v", 0, "r", "g", 1000)], 1, ["case a variant v attempt 0 run r generation g"] => ok ["case a variant v attempt 0 run r generation g"]
    match index >= launches.length
        true => ok gathered
        false => match call worker::launch_key(launches[index])
            ok str key => relay call launch_keys_at(launches, index + 1, call append(gathered, key))
/// Render the identity key of every launch in a fanout, in attempt order,
/// through the single shared worker::launch_key renderer. The controller
/// never renders keys its own way: one renderer on both sides is what
/// makes key comparison an identity proof.
fn str[] launch_keys
    emits {}
    given
        worker::launch[] launches
    asserts
        pair: [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)] => ok ["case a variant v attempt 0 run r generation g", "case a variant v attempt 1 run r generation g"]
        empty: [] => ok []
    relay call launch_keys_at(launches, 0, [])
/// Whether a key reappears at or after an index: the duplicate-identity
/// scan proving every attempt in a fanout owns a fresh worker.
fn bool key_seen_later
    emits {}
    given
        str[] keys
        str key
        int from
    asserts
        seen: ["a", "b", "a"], "a", 1 => ok true
        absent: ["a", "b"], "a", 1 => ok false
        empty: [], "a", 0 => ok false
    match from >= keys.length
        true => ok false
        false => match keys[from] is key
            false => relay call key_seen_later(keys, key, from + 1)
            true => ok true
/// Whether every key in a fanout is distinct: a repeated key would route
/// two attempts to one worker identity, breaking per-attempt isolation.
fn bool keys_distinct
    emits {}
    given
        str[] keys
        int index
    asserts
        distinct: ["a", "b"], 0 => ok true
        duplicate: ["a", "a"], 0 => ok false
        later_pair: ["a", "b", "b"], 0 => ok false
        single: ["a"], 0 => ok true
        empty: [], 0 => ok true
        done: ["a", "b"], 2 => ok true
    match index >= keys.length
        true => ok true
        false => match call key_seen_later(keys, keys[index], index + 1)
            ok bool seen => match seen
                false => relay call keys_distinct(keys, index + 1)
                true => ok false
/// The controller-death detail: the first planned key when a plan exists,
/// so the missing aggregate still names the lost run.
fn str dead_detail
    emits {}
    given
        worker::launch[] expected
    asserts
        planned: [worker::launch("a", "v", 0, "r", "g", 1000)] => ok "controller-dead:case a variant v attempt 0 run r generation g"
        empty: [] => ok "controller-dead:no-plan"
    match expected.length is 0
        true => ok "controller-dead:no-plan"
        false => match call worker::launch_key(expected[0])
            ok str key => ok call text::join(["controller-dead", key], ":")
/// Join one observed attempt against its planned launch. A done worker
/// must echo the planned identity key exactly, bind its report to the
/// plan, and reduce cleanly before its verdict gathers; a crash, timeout,
/// rejection or drift breaks the step with the detail that invalidates
/// the whole aggregate.
fn step_outcome join_one
    emits {}
    given
        worker::launch exp_launch
        worker::worker_outcome outcome
        int index
        spec::check_ref[] required
        reducer::scope limits
    asserts
        done_clean: worker::launch("a", "v", 0, "r", "g", 1000), worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)])), 0, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok step_clean(reducer::reduced_ok(1))
        key_drift: worker::launch("a", "v", 0, "r", "g", 1000), worker::worker_done(worker::launch("a", "v", 1, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 1, "completed", "matched", "ok", "", true, [])), 0, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok step_broken("identity-drift:attempt:0:expected:case a variant v attempt 0 run r generation g:observed:case a variant v attempt 1 run r generation g")
        report_drift: worker::launch("a", "v", 0, "r", "g", 1000), worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "z", "v", "r", 0, "completed", "matched", "ok", "", true, [])), 0, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok step_broken("report-drift:attempt:0:case:a:z")
        crashed: worker::launch("a", "v", 0, "r", "g", 1000), worker::worker_crashed(worker::launch("a", "v", 0, "r", "g", 1000), "exit:1"), 0, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok step_broken("worker-crash:attempt:0:exit:1")
        timed_out: worker::launch("a", "v", 0, "r", "g", 1000), worker::worker_timed_out(worker::launch("a", "v", 0, "r", "g", 1000), 1000), 0, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok step_broken("worker-timeout:attempt:0:1000")
        rejected: worker::launch("a", "v", 0, "r", "g", 1000), worker::worker_rejected(worker::launch("a", "v", 0, "r", "g", 1000), spec::diagnostic("worker::outcome_of", "case a variant v root collect run r", "missing-report", "0")), 0, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok step_broken("worker-rejected:attempt:0:missing-report:0")
    match outcome
        worker::worker_done => match call worker::launch_key(exp_launch)
            ok str exp_key => match call worker::launch_key(outcome.identity)
                ok str got_key => match exp_key is got_key
                    false => ok step_broken(call text::join(["identity-drift", "attempt", call text::from_int(index), "expected", exp_key, "observed", got_key], ":"))
                    true => match call worker::check_report_identity(exp_launch, outcome.report)
                        ok worker::identity_outcome bound => match bound
                            worker::identity_ok => match call worker::verdict_of(outcome, required, limits)
                                ok reducer::reduced verdict => ok step_clean(verdict)
                            worker::identity_rejected => ok step_broken(call text::join(["report-drift", "attempt", call text::from_int(index), bound.problem.detail], ":"))
        worker::worker_crashed => ok step_broken(call text::join(["worker-crash", "attempt", call text::from_int(index), outcome.cause], ":"))
        worker::worker_timed_out => ok step_broken(call text::join(["worker-timeout", "attempt", call text::from_int(index), call text::from_int(outcome.deadline_ms)], ":"))
        worker::worker_rejected => ok step_broken(call text::join(["worker-rejected", "attempt", call text::from_int(index), outcome.problem.kind, outcome.problem.detail], ":"))
/// Join observed attempts against the plan from an index, threading the
/// gathered verdicts of every clean bound attempt so far. The first
/// broken step invalidates the aggregate with its detail, discarding the
/// gathered row; reaching the end means every attempt joined.
fn aggregate join_at
    emits {}
    given
        worker::launch[] expected
        worker::worker_outcome[] observed
        int index
        spec::check_ref[] required
        reducer::scope limits
        reducer::reduced[] gathered
    asserts
        end_combines: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, []))], 1, [spec::check_ref("a")], reducer::scope("full", "full-roots"), [reducer::reduced_ok(1)] => ok aggregate_valid(reducer::reduced_ok(1), 1)
        clean_advances: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)]))], 0, [spec::check_ref("a")], reducer::scope("full", "full-roots"), [] => ok aggregate_valid(reducer::reduced_ok(1), 1)
        broken_stops: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_crashed(worker::launch("a", "v", 0, "r", "g", 1000), "exit:1")], 0, [spec::check_ref("a")], reducer::scope("full", "full-roots"), [] => ok aggregate_invalid("worker-crash:attempt:0:exit:1")
        empty_end: [], [], 0, [spec::check_ref("a")], reducer::scope("full", "full-roots"), [] => ok aggregate_missing("no-verdicts")
    match index >= expected.length
        true => relay call combine_verdicts(gathered, 0, expected.length, 0)
        false => match call join_one(expected[index], observed[index], index, required, limits)
            ok step_outcome stepped => match stepped
                step_clean => relay call join_at(expected, observed, index + 1, required, limits, call append(gathered, stepped.verdict))
                step_broken => ok aggregate_invalid(stepped.detail)
/// Combine one gathered verdict: a clean verdict advances the matched
/// total, while a failed, incomplete or rejected verdict sticks as the
/// aggregate verdict.
fn combine_outcome combine_one
    emits {}
    given
        reducer::reduced verdict
        int matched
    asserts
        ok_advances: reducer::reduced_ok(1), 0 => ok combine_advance(1)
        failed_sticks: reducer::reduced_failed("b", "", "", []), 0 => ok combine_stuck(reducer::reduced_failed("b", "", "", []))
        incomplete_sticks: reducer::reduced_incomplete("missing-check:a"), 5 => ok combine_stuck(reducer::reduced_incomplete("missing-check:a"))
        rejected_sticks: reducer::reduced_rejected([spec::diagnostic("reducer::reduce_unit", "case a variant v root reduce run r", "early-ok", "a")]), 0 => ok combine_stuck(reducer::reduced_rejected([spec::diagnostic("reducer::reduce_unit", "case a variant v root reduce run r", "early-ok", "a")]))
    match verdict
        reducer::reduced_ok => ok combine_advance(matched + verdict.matched)
        reducer::reduced_failed => ok combine_stuck(reducer::reduced_failed(verdict.behavior_check, verdict.execution, verdict.cleanup_detail, verdict.not_reached))
        reducer::reduced_incomplete => ok combine_stuck(reducer::reduced_incomplete(verdict.detail))
        reducer::reduced_rejected => ok combine_stuck(reducer::reduced_rejected(verdict.problems))
/// Combine gathered attempt verdicts in attempt order: the first failed,
/// incomplete or rejected verdict sticks, and only an all-clean row
/// passes with the summed match count. An empty row with zero attempts is
/// missing, never an empty pass: reaching the end without attempts means
/// no evidence was ever gathered.
fn aggregate combine_verdicts
    emits {}
    given
        reducer::reduced[] verdicts
        int index
        int attempts
        int matched
    asserts
        all_clean: [reducer::reduced_ok(1), reducer::reduced_ok(2)], 0, 2, 0 => ok aggregate_valid(reducer::reduced_ok(3), 2)
        end_clean: [reducer::reduced_ok(1)], 1, 1, 1 => ok aggregate_valid(reducer::reduced_ok(1), 1)
        failed_first: [reducer::reduced_failed("b", "", "", []), reducer::reduced_ok(1)], 0, 2, 0 => ok aggregate_valid(reducer::reduced_failed("b", "", "", []), 2)
        incomplete_first: [reducer::reduced_incomplete("missing-check:a"), reducer::reduced_failed("b", "", "", [])], 0, 2, 0 => ok aggregate_valid(reducer::reduced_incomplete("missing-check:a"), 2)
        failed_after_clean: [reducer::reduced_ok(1), reducer::reduced_failed("b", "", "", [])], 0, 2, 0 => ok aggregate_valid(reducer::reduced_failed("b", "", "", []), 2)
        empty_guarded: [], 0, 0, 0 => ok aggregate_missing("no-verdicts")
    match index >= verdicts.length
        true => match attempts is 0
            true => ok aggregate_missing("no-verdicts")
            false => ok aggregate_valid(reducer::reduced_ok(matched), attempts)
        false => match call combine_one(verdicts[index], matched)
            ok combine_outcome combined => match combined
                combine_advance => relay call combine_verdicts(verdicts, index + 1, attempts, combined.matched)
                combine_stuck => ok aggregate_valid(combined.verdict, attempts)
/// Join observed worker outcomes against the planned attempt vector. A dead
/// controller, an empty plan, or a short/overlong observation vector is a
/// missing aggregate before any verdict is read; otherwise every attempt
/// joins in order through join_at, and any crash, timeout, rejection or
/// drift invalidates the aggregate instead of joining a partial row.
fn aggregate join_attempts
    emits {}
    given
        worker::launch[] expected
        worker::worker_outcome[] observed
        bool controller_alive
        spec::check_ref[] required
        reducer::scope limits
    asserts
        single_clean: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)]))], true, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_valid(reducer::reduced_ok(1), 1)
        pair_clean: [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)])), worker::worker_done(worker::launch("a", "v", 1, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 1, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)]))], true, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_valid(reducer::reduced_ok(2), 2)
        dead_missing: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)]))], false, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_missing("controller-dead:case a variant v attempt 0 run r generation g")
        dead_no_plan: [], [], false, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_missing("controller-dead:no-plan")
        empty_plan: [], [], true, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_missing("no-attempts-planned")
        short_observed: [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)]))], true, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_missing("missing-attempt:expected:2:observed:1")
        overlong_observed: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)])), worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)]))], true, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_missing("missing-attempt:expected:1:observed:2")
        crash_invalid: [worker::launch("a", "v", 0, "r", "g", 1000), worker::launch("a", "v", 1, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, [reducer::check_row(0, "a", "1", "1", true)])), worker::worker_crashed(worker::launch("a", "v", 1, "r", "g", 1000), "exit:1")], true, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_invalid("worker-crash:attempt:1:exit:1")
        timeout_invalid: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_timed_out(worker::launch("a", "v", 0, "r", "g", 1000), 1000)], true, [spec::check_ref("a")], reducer::scope("full", "full-roots") => ok aggregate_invalid("worker-timeout:attempt:0:1000")
        behavior_failed: [worker::launch("a", "v", 0, "r", "g", 1000)], [worker::worker_done(worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "mismatched", "ok", "", true, [reducer::check_row(0, "b", "2", "3", false)]))], true, [spec::check_ref("b"), spec::check_ref("c")], reducer::scope("full", "full-roots") => ok aggregate_valid(reducer::reduced_failed("b", "", "", ["c"]), 1)
    match controller_alive
        false => ok aggregate_missing(call dead_detail(expected))
        true => match expected.length is 0
            true => ok aggregate_missing("no-attempts-planned")
            false => match observed.length is expected.length
                false => ok aggregate_missing(call text::join(["missing-attempt", "expected", call text::from_int(expected.length), "observed", call text::from_int(observed.length)], ":"))
                true => relay call join_at(expected, observed, 0, required, limits, [])
/// The controller's source-direction send check: bytes fit the source bound
/// of the launch. This predicate only ever sees a source_bound; output
/// bounds cannot flow into the send path.
fn bool source_send_fits
    emits {}
    given
        worker::source_bound bound
        int bytes_len
    asserts
        fits: worker::source_bound(65536), 100 => ok true
        exact: worker::source_bound(65536), 65536 => ok true
        over: worker::source_bound(65536), 65537 => ok false
        negative: worker::source_bound(65536), -1 => ok false
    match call worker::source_fits(bytes_len, bound)
        ok bool fits => ok fits
/// The controller's output-direction receive check: rows and bytes fit the
/// output bound of the launch. This predicate only ever sees an
/// output_bound; source bounds cannot flow into the receive path. The two
/// directions are disjoint by construction: no predicate takes both.
fn bool output_recv_fits
    emits {}
    given
        worker::output_bound bound
        int rows_len
        int bytes_len
    asserts
        fits: worker::output_bound(65536, 64), 4, 100 => ok true
        exact: worker::output_bound(65536, 64), 64, 65536 => ok true
        rows_over: worker::output_bound(65536, 64), 65, 100 => ok false
        bytes_over: worker::output_bound(65536, 64), 4, 65537 => ok false
        negative_rows: worker::output_bound(65536, 64), -1, 100 => ok false
    match call worker::output_fits(rows_len, bytes_len, bound)
        ok bool fits => ok fits
/// The controller-side binding predicate for one attempt: true exactly
/// when the observed report echoes the planned launch. The join uses the
/// full check_report_identity outcome for precise drift details; this
/// predicate is the boolean control proving the same binding per attempt.
fn bool attempt_bound
    emits {}
    given
        worker::launch expected
        reducer::unit_report observed
    asserts
        bound: worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 0, "completed", "matched", "ok", "", true, []) => ok true
        case_drift: worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "z", "v", "r", 0, "completed", "matched", "ok", "", true, []) => ok false
        attempt_drift: worker::launch("a", "v", 0, "r", "g", 1000), reducer::unit_report("1", "a", "v", "r", 1, "completed", "matched", "ok", "", true, []) => ok false
    match call worker::check_report_identity(expected, observed)
        ok worker::identity_outcome bound => match bound
            worker::identity_ok => ok true
            worker::identity_rejected => ok false
