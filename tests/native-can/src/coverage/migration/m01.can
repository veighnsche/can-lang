        other: "nope" => ok []
    match scope is "m01"
        false => ok []
        true => ok [row_map("CORE-002", "retained", "tests/native-can/migration/m01-assertion-and-check-evidence/core-002-report-shape.can", "28bc3859b85017122ad2467c6861e578f10dd83013c9388925680da1c18a1be4", "bundled/report-shape", ["report-kind", "schema-version", "basic-count", "native-count", "queues-count", "supplied-marker", "stderr-separate", "mismatch-fails", "static-no-publish", "pipe-fails-closed"], ["Structured assertion report, full and selected scopes, supplied versus real completion", "mismatch and malformed/static fixtures fail and do not publish", "duplicate/ambiguous selectors and exact full selector", "native fixture argument validation, shared queue exhaustion/leftovers and callable creation path", "caught external I/O cannot make missing fixture pass, supplied boundary can, domain completion and initialization failure"], ["basic, native-slice, queues fixtures", "full, short and qualified selectors", "bad expected value, bad fixture type, duplicate root, bad arguments, missing/unused rows, caught I/O, domain and initializer"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional with CAN_BUN"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-002", "retained", "tests/native-can/migration/m01-assertion-and-check-evidence/core-002-selection.can", "59375aea31e4a85aa481ff9806eb8a4df7984d4a247f4a91cd73ee66c5b9ea8d", "bundled/selection", ["short-count", "full-selector-text", "unselected-real", "duplicate-refused", "ambiguous-refused", "full-selector-green", "qualified-accepted", "selection-stderr-quiet"], ["Structured assertion report, full and selected scopes, supplied versus real completion", "mismatch and malformed/static fixtures fail and do not publish", "duplicate/ambiguous selectors and exact full selector", "native fixture argument validation, shared queue exhaustion/leftovers and callable creation path", "caught external I/O cannot make missing fixture pass, supplied boundary can, domain completion and initial