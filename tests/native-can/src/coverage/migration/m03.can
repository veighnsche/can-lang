package migration
    provides [m03_slice, claim_m03_identity_problems, validate_m03_claim, campaign_m03_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m03 (CORE-001..CORE-010).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 4 Arrays, bytes, codecs and collections rows. Multi-case rows: one row_map per (row, case) pair; claims resolve through row_case_index; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for CORE-001..CORE-010. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m03_slice
    emits {}
    given
        str scope
    asserts
        m03: "m03" => ok [row_map("CORE-001", "retained", "tests/native-can/migration/m03-arrays-bytes-codecs-and-collec/core-001-roots-green.can", "a26e4ffe3dde8160db33db462b185c069c04b5f2b83b7a70aca18b2d35139b83", "bundled/arrays-roots", ["assert-green", "report-passed", "main-count", "contracts-count", "main-fixture", "contracts-fixture", "main-helpers", "main-map", "main-search", "main-fold", "main-sort-copy", "main-append", "main-entry", "contracts-capture", "contracts-protected", "contracts-failure", "contracts-schedule", "contracts-sort", "contracts-owner", "contracts-entry", "run-silent"], ["Array map/filter/search/reduce/sort/copy preserve order, aliases, immutable sources, callback scheduling and failure stop", "main and contracts fixtures yield 46 and 28 passing Can assertion roots", "production run is silent and strict emitted TypeScript optionally typechecks"], ["main 46 roots", "contracts 28 roots", "callback failure, owner context, thenable/getter hostility and native delegation"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional with CAN_BUN"], ["DELEGATE-006"], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-001", "retained", "tests/native-can/migration/m03-arrays-bytes-codecs-and-collec/core-001-array-semantics.can", "420ca390a16dbbccd649974db3f37f83ceff82b4d1088678e425943314809a7b", "bundled/array-semantics", ["map-order", "map-alias", "search-early", "reduce-chain", "failure-stop", "failure-adapters", "stop-order", "sort-stable", "copy-immutable", "sync-serial", "fixture-ordered"], ["Array map/filter/search/reduce/sort/copy preserve order, aliases, immutable sources, callback scheduling and failure stop", "main and contracts fixtures yield 46 and 28 passing Can assertion roots", "production run is silent and strict emitted TypeScript optionally typechecks"], ["main 46 roots", "contracts 28 roots", "callback failure, owner context, thenable/getter hostility and native delegation"], ["CAN_BUN_ARCHIVE", "macOS san