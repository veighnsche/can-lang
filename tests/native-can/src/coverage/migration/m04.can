        other: "nope" => ok []
    match scope is "m04"
        false => ok []
        true => ok [row_map("CORE-012", "retained", "tests/native-can/migration/m04-coordination-occurrence-identi/core-012-roots-green.can", "4fe7d3790bee986c81df4c3a412df66273b3c1236ab5fa89fee26e6656516702", "bundled/coordination-roots", ["assert-green", "report-passed", "root-count", "fixture-name", "one-roots", "text-roots", "unavailable-roots", "fail-all-roots", "aggregate-size-roots", "summarize-roots", "observe-roots", "main-roots", "composition-rows", "heterogeneous-rows", "trace-pass", "trace-fail"], ["Promise all/allSettled/any/race selection, ordered outcomes, empty modes, domain/standard failures, owner retention and native delegation", "Can fixture assertions and silent production run"], ["main fixture", "late/losing failures, handler faults, empty race and snapshot identity"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional with CAN_BUN"], ["DELEGATE-009"], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-012", "retained", "tests/native-can/migration/m04-coordination-occurrence-identi/core-012-coordination-selection.can", "441a66bafecc4f69db052abfea4c162b84e76308eaa02bec7b7fe8a5c4d6967f", "bundled/coordination-selection", ["all-first-rejection", "settled-ordered", "settled-handler-stop", "any-allfailed-order", "any-consume-late", "race-first", "empty-modes", "aggregate-identity", "first-failure-handling", "settled-standard-slot", "any-last-success", "handler-faults", "snapshot-identity", "empty-race-pending", "owner-retention", "native-delegation"], ["Promise all/allSettled/any/race selection, ordered outcomes, empty modes, domain/standard failures, owner retention and native delegation", "Can fixture assertions and silent production run"], ["main fixture", "late/losing failures, handler faults, empty race and snapshot identity"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional with CAN_BUN"], ["DELEGATE-009"], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-012", "retained", "tests/native-can/migration/m04-coordination-occurrence-identi/core-012-run-shape.can", "de444b8324676131225ac129da16cefebca0ecfa1640defb7454a7423a9315ad", "bundled/coordination-run", ["run-exit", "run-stdout-empty", "run-stderr-empty", "entry-silent", "sandbox-profile", "offline-ok"], ["Promise all/allSettled/any/race selection, ordered outcomes, empty modes, domain/standard failures, owner retention and native delegation", "Can fixture assertions and silent production run"], ["main fixture", "late/losing failures, handler faults, empty race and snapshot identity"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional with CAN_BUN"], ["DELEGATE-009"], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-013", "retained", "tests/native-can/migration/m04-coordination-occurrence-identi/core-013-roots-green.can", "9c88489b22870742626a7ba05d93eb2899ccf2b323dfc55f921d278d10bcb094", "coordination/snapshot-roots", ["assert-green", "report-passed", "root-count", "fixture-name", "boom-roots", "identical-roots", "main-roots"], ["One standard occurrence seen through ordinary catch and coordination aggregate retains identity rather than minting a new error"], ["catch then aggregate of same standard occurrence"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional with CAN_BUN"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-013", "retained", "tests/native-can/migration/m04-coordination-occurrence-identi/core-013-snapshot-identity.can", "36e6ae9c904388275d7a3339d08a4b90415d36b6390ad4c86ad4bfa68b0b5cfb", "coordination/snapshot-identity", ["raise-source", "catch-kind", "catch-bound", "aggregate-op", "leaf-first", "occurrence-same", "kind-same", "message-same", "no-fresh-mint", "domain-kind", "value-arm-false"], ["One standard occurrence seen through ordinary catch and coordination aggregate retains identity rather than minting a new error"], ["catch then aggregate of same standard occurrence"], ["CAN_BUN_ARCHIVE", "macO