package migration
    provides [m06_slice, claim_m06_identity_problems, validate_m06_claim, campaign_m06_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m06 (CORE-014..CORE-040).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 3 Crypto, files and streams rows. Multi-case rows: one row_map per (row, case) pair; claims resolve through row_case_index; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for CORE-014..CORE-040. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m06_slice
    emits {}
    given
        str scope
    asserts
        m06: "m06" => ok [row_map("CORE-014", "retained", "tests/native-can/migration/m06-crypto-files-and-streams/core-014-roots-green.can", "5055cd88c5844957c0346ae7b3e264e185e025a8bb42c2aea2d07827127d3e6e", "crypto/commands-roots", ["assert-green", "report-passed", "root-count", "fixture-name", "hmac-roots", "password-roots", "signature-roots", "seal-roots", "main-roots"], ["Crypto assertions, deterministic build identity across rebuild and relocation, production crypto wiring, strict emission and live native commands", "wrong argument type and missing emits reject", "roundtrip/HMAC/password cases pass, key misuse and tampering return domain errors"], ["roundtrip, hmac, ask correct/wrong, misuse, tamper", "two negative source mutations"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-014", "retained", "tests/native-can/migration/m06-crypto-files-and-streams/core-014-crypto-commands.can", "8a84c283a29944db9668c1ddf2802769aeff87936dcb204e83a619a5fc8603d2", "crypto/crypto-commands", ["roundtrip", "hmac", "ask-correct", "ask-wrong", "misuse-reject", "tamper-reject", "build-identity", "wrong-arg-reject", "missing-emits-reject", "mutation-argtype-site", "mutation-emits-site"], ["Crypto assertions, deterministic build identity across rebuild and relocation, production crypto wiring, strict emission and live native commands", "wrong argument type and missing emits reject", "roundtrip/HMAC/password cases pass, key misuse and tampering return domain errors"], ["roundtrip, hmac, ask correct/wrong, misuse, tamper", "two negative source mutations"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_TSC optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-014", "retained", "tests/native-can/migration/m06-crypto-files-and-streams/core-014-run-shape.can", "7eecf5e40daa36202334cc23bd7a38add06b1f69764cd607af194c4a765e559d", "crypto/commands-run", ["run-exi