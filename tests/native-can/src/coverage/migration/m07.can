sed", "root-count", "fixture-name", "report-roots", "assess-roots", "roundtrip-roots", "main-roots", "helper-roots", "asks-roots", "label-supplied"], ["Mixed question consumer handles boolean/string/choice/number/confidence and nested followup", "invalid answer, duplicate criterion, faulty handler/record reject before launch", "lower confidence selects fallback", "raw provider fixture request comparison and strict emission"], ["normal, invalid, duplicate, handler/record faults, confidence fallback, two-stage followup, raw provider"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_I27_TOKEN supplied", "CAN_TSC optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "38370ce9"), row_map("CORE-035", "retained", "tests/native-can/migration/m07-fetch-formats-generation-and-c/core-035-questions-semantics.can", "5cc73a0eeac583c9f31aea1f14d89ae25875ec33992ad77c60746433c3e1042d", "bundled/questions-semantics", ["batch-request", "request-headers", "answer-kinds", "invalid-answer", "invalid-silent", "duplicate-rejects", "duplicate-silent", "handler-rejects", "handler-silent", "record-rejects", "record-silent", "confidence-fallback", "second-stage", "followup-judge", "two-stage", "mixed-requests", "raw-build-exit", "raw-request", "raw-sandbox", "raw-report", "emitted-shape", "strict-ts"], ["Mixed question consumer handles boolean/string/choice/number/confidence and nested followup", "invalid answer, duplicate criterion, faulty handler/record reject before launch", "lower confidence selects fallback", "raw provider fixture request comparison and strict emission"], ["normal, invalid, duplicate, handler/record faults, confidence fallback, two-stage followup, raw provider"], ["CAN_BUN_ARCHIVE", "macOS sandbox-exec", "CAN_I27_TOKEN supplied", "CAN_TSC optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "38370ce9"), row_map("CORE-035", "retained", "tests/native-can/migration/m07-fetch-formats-generation-and-c/core-035-run-shape.can", "08c2fea5d92e5b9c7