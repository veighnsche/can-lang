/// Identity side of a complete-coverage claim against the m10 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. delegates are checked both directions.
fn spec::diagnostic[] claim_m10_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case dist/sidecar variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "CORE-015", "dist/sidecar-missing", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case dist/sidecar-missing variant default root coverage run r1", "unknown-row", "CORE-015")]
        entry_drift: [job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "CORE-015", "dist/roots", "default", "r1", 1, "attempt", "passed", "full", 14, 14, "", "", -1)], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case dist/sidecar variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", [], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case dist/sidecar variant default root coverage run r1", "missing-engine", "CORE-015")]
        unaccepted: [job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case dist/sidecar variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005", "DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case dist/sidecar variant default root coverage run r1", "extra-delegate", "CORE-015")]
    match call m10_slice("m10")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m10_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m10: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m10_slice.
fn spec::diagnostic[] validate_m10_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 1, "attempt", "passed", "full", 35, 35, "", "", -1)], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m10_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 1, "attempt", "failed", "full", 0, 35, "", "", -1), job_entry("j1", "CORE-015", "dist/sidecar", "default", "r1", 3, "attempt", "passed", "full", 35, 35, "", "", -1)], claim("j1", "CORE-015", "dist/sidecar", "default", "r1", ["CAN_BUN_ARCHIVE pinned archive", "macOS arm64", "sandbox-exec"], ["DELEGATE-001", "DELEGATE-002", "DELEGATE-003", "DELEGATE-004", "DELEGATE-005"], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case dist/sidecar variant default root coverage run r1", "cherry-picked-report", "j1")]
    match call claim_m10_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m10_manifest
    emits {}
    given
        str scope
    asserts
        m10: "m10" => ok campaign("z01-manifest/m10/2026-10-02", "z01-campaign/m10/attempt-1", ["CORE-015", "CORE-016", "CORE-036", "CORE-037", "CORE-046"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m10"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m10/2026-10-02", "z01-campaign/m10/attempt-1", ["CORE-015", "CORE-016", "CORE-036", "CORE-037", "CORE-046"])
