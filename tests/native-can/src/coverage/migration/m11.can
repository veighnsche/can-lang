package migration
    provides [m11_slice, claim_m11_identity_problems, validate_m11_claim, campaign_m11_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m11 (CORE-049..CORE-051).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 3 Raw fixture staging mechanics rows. Multi-case rows: one row_map per (row, case) pair; claims resolve through row_case_index; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for CORE-049..CORE-051. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m11_slice
    emits {}
    given
        str scope
    asserts
        m11: "m11" => ok [row_map("CORE-049", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-049-selection.can", "786e849b9893ed8d7745d0e8009f5e8d6350888afe73f962a1164e889f3136b0", "raw-staging/selection", ["json-only", "dirs-skipped", "required-set", "staged-count"], ["Raw fixture staging rewrites only selected origin/endpoint references while preserving exact request/response bytes and required fixture set; static fixture files remain inputs rather than scenarios"], ["fetch and other current raw-fixture areas; URL relocation"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-049", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-049-rewrite.can", "d2e2685b7929a39e71d8bec0786d8418e84a8859d9a714f2785f08f1a988566f", "raw-staging/rewrite", ["pairs-ordered", "only-selected", "bytes-identical", "relocation", "source-pristine"], ["Raw fixture staging rewrites only selected origin/endpoint references while preserving exact request/response bytes and required fixture set; static fixture files remain inputs rather than scenarios"], ["fetch and other current raw-fixture areas; URL relocation"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-049", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-049-layout.can", "0c0275bacd2925e56b70a662cc1c649bcee43fa95457c93a4e4996652f61e1fb", "raw-staging/layout", ["dest-dir", "name-preserved", "no-assert-semantics", "no-extra-writes"], ["Raw fixture staging rewrites only selected origin/endpoint references while preserving exact request/response bytes and required fixture set; static fixture files remain inputs rather than scenarios"], ["fetch and other current raw-fixture areas; URL relocation"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-050", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-050-selection.can", "4f6ff51aea5ae7c25cced5e07ab274f065317f8d2dddf397fc9a63ecc0a13512", "auth-strip/selection", ["auth-only", "exact-name", "two-cell", "per-variant"], ["Removes staged authorization request-header pairs from raw fixtures for direct conformance probes; preserves other headers and refuses malformed fixture structure"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-050", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-050-rewrite.can", "945826705836f5d092aa381d3e75ad0e9af5de1cb2b0dcb2c9b2542d7926dc1e", "auth-strip/rewrite", ["pairs-removed", "others-identical", "request-scoped", "malformed-refused", "no-strip-no-write"], ["Removes staged authorization request-header pairs from raw fixtures for direct conformance probes; preserves other headers and refuses malformed fixture structure"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-050", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-050-layout.can", "1b2bfa2709f8389dc2b23d63dbf1cb02d5c7813dfd58926a7978a54008ef1d1a", "auth-strip/layout", ["same-path", "no-extra-writes", "source-pristine", "mode-restricted"], ["Removes staged authorization request-header pairs from raw fixtures for direct conformance probes; preserves other headers and refuses malformed fixture structure"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-051", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-051-selection.can", "c247a2cb486209640f606aa7bcfc8d9b895f0f9d2945744e7b7ec0c476f69cd3", "env-clear/selection", ["every-fixture", "env-key", "json-only", "per-variant"], ["Empties per-fixture environment snapshots for direct conformance probes while retaining exchange body and request comparisons"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-051", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-051-rewrite.can", "529f6d901d608d259653e56c79c18d2730ef228521fab5e78758e1c65676235b", "env-clear/rewrite", ["env-emptied", "others-identical", "env-scoped", "malformed-refused", "always-rewrite"], ["Empties per-fixture environment snapshots for direct conformance probes while retaining exchange body and request comparisons"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-051", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-051-layout.can", "c2264b41cb37b0883b14aacb5cee51688d8e445e885aea9d63472fd9dd1eee20", "env-clear/layout", ["same-path", "no-extra-writes", "source-pristine", "mode-restricted"], ["Empties per-fixture environment snapshots for direct conformance probes while retaining exchange body and request comparisons"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m11"
        false => ok []
        true => ok [row_map("CORE-049", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-049-selection.can", "786e849b9893ed8d7745d0e8009f5e8d6350888afe73f962a1164e889f3136b0", "raw-staging/selection", ["json-only", "dirs-skipped", "required-set", "staged-count"], ["Raw fixture staging rewrites only selected origin/endpoint references while preserving exact request/response bytes and required fixture set; static fixture files remain inputs rather than scenarios"], ["fetch and other current raw-fixture areas; URL relocation"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-049", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-049-rewrite.can", "d2e2685b7929a39e71d8bec0786d8418e84a8859d9a714f2785f08f1a988566f", "raw-staging/rewrite", ["pairs-ordered", "only-selected", "bytes-identical", "relocation", "source-pristine"], ["Raw fixture staging rewrites only selected origin/endpoint references while preserving exact request/response bytes and required fixture set; static fixture files remain inputs rather than scenarios"], ["fetch and other current raw-fixture areas; URL relocation"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-049", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-049-layout.can", "0c0275bacd2925e56b70a662cc1c649bcee43fa95457c93a4e4996652f61e1fb", "raw-staging/layout", ["dest-dir", "name-preserved", "no-assert-semantics", "no-extra-writes"], ["Raw fixture staging rewrites only selected origin/endpoint references while preserving exact request/response bytes and required fixture set; static fixture files remain inputs rather than scenarios"], ["fetch and other current raw-fixture areas; URL relocation"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-050", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-050-selection.can", "4f6ff51aea5ae7c25cced5e07ab274f065317f8d2dddf397fc9a63ecc0a13512", "auth-strip/selection", ["auth-only", "exact-name", "two-cell", "per-variant"], ["Removes staged authorization request-header pairs from raw fixtures for direct conformance probes; preserves other headers and refuses malformed fixture structure"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-050", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-050-rewrite.can", "945826705836f5d092aa381d3e75ad0e9af5de1cb2b0dcb2c9b2542d7926dc1e", "auth-strip/rewrite", ["pairs-removed", "others-identical", "request-scoped", "malformed-refused", "no-strip-no-write"], ["Removes staged authorization request-header pairs from raw fixtures for direct conformance probes; preserves other headers and refuses malformed fixture structure"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-050", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-050-layout.can", "1b2bfa2709f8389dc2b23d63dbf1cb02d5c7813dfd58926a7978a54008ef1d1a", "auth-strip/layout", ["same-path", "no-extra-writes", "source-pristine", "mode-restricted"], ["Removes staged authorization request-header pairs from raw fixtures for direct conformance probes; preserves other headers and refuses malformed fixture structure"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-051", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-051-selection.can", "c247a2cb486209640f606aa7bcfc8d9b895f0f9d2945744e7b7ec0c476f69cd3", "env-clear/selection", ["every-fixture", "env-key", "json-only", "per-variant"], ["Empties per-fixture environment snapshots for direct conformance probes while retaining exchange body and request comparisons"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-051", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-051-rewrite.can", "529f6d901d608d259653e56c79c18d2730ef228521fab5e78758e1c65676235b", "env-clear/rewrite", ["env-emptied", "others-identical", "env-scoped", "malformed-refused", "always-rewrite"], ["Empties per-fixture environment snapshots for direct conformance probes while retaining exchange body and request comparisons"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("CORE-051", "retained", "tests/native-can/migration/m11-raw-fixture-staging-mechanics/core-051-layout.can", "c2264b41cb37b0883b14aacb5cee51688d8e445e885aea9d63472fd9dd1eee20", "env-clear/layout", ["same-path", "no-extra-writes", "source-pristine", "mode-restricted"], ["Empties per-fixture environment snapshots for direct conformance probes while retaining exchange body and request comparisons"], ["judge, questions and generation direct raw-provider probes"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m11 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. delegates are checked both directions.
fn spec::diagnostic[] claim_m11_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case raw-staging/selection variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "CORE-049", "raw-staging/selection-missing", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case raw-staging/selection-missing variant default root coverage run r1", "unknown-row", "CORE-049")]
        entry_drift: [job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "CORE-049", "raw-staging/rewrite", "default", "r1", 1, "attempt", "passed", "full", 5, 5, "", "", -1)], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case raw-staging/selection variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", [], [], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case raw-staging/selection variant default root coverage run r1", "missing-engine", "CORE-049")]
        unaccepted: [job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case raw-staging/selection variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", ["bun-prototype-env"], ["DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case raw-staging/selection variant default root coverage run r1", "extra-delegate", "CORE-049")]
    match call m11_slice("m11")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m11_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m11: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m11_slice.
fn spec::diagnostic[] validate_m11_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 1, "attempt", "passed", "full", 4, 4, "", "", -1)], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m11_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 1, "attempt", "failed", "full", 0, 4, "", "", -1), job_entry("j1", "CORE-049", "raw-staging/selection", "default", "r1", 3, "attempt", "passed", "full", 4, 4, "", "", -1)], claim("j1", "CORE-049", "raw-staging/selection", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case raw-staging/selection variant default root coverage run r1", "cherry-picked-report", "j1")]
    match call claim_m11_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m11_manifest
    emits {}
    given
        str scope
    asserts
        m11: "m11" => ok campaign("z01-manifest/m11/2026-10-02", "z01-campaign/m11/attempt-1", ["CORE-049", "CORE-050", "CORE-051"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m11"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m11/2026-10-02", "z01-campaign/m11/attempt-1", ["CORE-049", "CORE-050", "CORE-051"])
