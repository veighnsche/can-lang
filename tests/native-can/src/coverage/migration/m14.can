package migration
    provides [m14_slice, claim_m14_identity_problems, validate_m14_claim, campaign_m14_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m14 (BROWSER-010..BROWSER-040).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 4 Browser wire codec parity rows. No retained rows (missing only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for BROWSER-010..BROWSER-040. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m14_slice
    emits {}
    given
        str scope
    asserts
        m14: "m14" => ok [row_map("BROWSER-010", "missing", "", "", "", [], ["Compare runtime wire vectors under Bun, sealed browser bundle, Chromium and WebKit; Firefox remains optional.", "Audit all 14 overlay edges against compiler table, reject node imports/test shims, require JSON.rawJSON on required engines and exact result parity."], ["Chromium required", "WebKit required", "Firefox optional"], ["bun and node/Playwright installed", "CAN_BROWSER_EVIDENCE_DIR optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-038", "missing", "", "", "", [], ["Bundle shared wire vectors through the exact 14-edge browser overlay; fail if another node builtin reaches the graph.", "Keep overlay-table drift detectable against compiler canonical table."], ["14 overlay edges", "unexpected node import"], ["Bun bundler"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-039", "missing", "", "", "", [], ["Launch named browser, report engine/version/UA and JSON.rawJSON availability, execute vector bundle and return raw results.", "Can case, not this script, must decide required-engine policy and exact parity."], ["Chromium", "WebKit", "Firefox"], ["Playwright/browser engines"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-040", "missing", "", "", "", [], ["Test-only TypeScript entry imports runtime/test/browser-wire-vectors.ts and writes results to globalThis; its delegated vector oracle must be represented by Can-authored vectors and comparison policy.", "Preserve all 12 delegated vector obligations: int64-beyond-safe, int64-huge-exponent, float-finite, float-nonfinite-rejected, variant-canonical-tag, variant-wrong-tag, option-some-none, duplicate-member, duplicate-native-syntax, extra-member, missing-member, nested-roundtrip-stable (runtime/test/browser-wire-vectors.ts:45-157)."], ["wire vector inputs"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m14"
        false => ok []
        true => ok [row_map("BROWSER-010", "missing", "", "", "", [], ["Compare runtime wire vectors under Bun, sealed browser bundle, Chromium and WebKit; Firefox remains optional.", "Audit all 14 overlay edges against compiler table, reject node imports/test shims, require JSON.rawJSON on required engines and exact result parity."], ["Chromium required", "WebKit required", "Firefox optional"], ["bun and node/Playwright installed", "CAN_BROWSER_EVIDENCE_DIR optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-038", "missing", "", "", "", [], ["Bundle shared wire vectors through the exact 14-edge browser overlay; fail if another node builtin reaches the graph.", "Keep overlay-table drift detectable against compiler canonical table."], ["14 overlay edges", "unexpected node import"], ["Bun bundler"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-039", "missing", "", "", "", [], ["Launch named browser, report engine/version/UA and JSON.rawJSON availability, execute vector bundle and return raw results.", "Can case, not this script, must decide required-engine policy and exact parity."], ["Chromium", "WebKit", "Firefox"], ["Playwright/browser engines"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-040", "missing", "", "", "", [], ["Test-only TypeScript entry imports runtime/test/browser-wire-vectors.ts and writes results to globalThis; its delegated vector oracle must be represented by Can-authored vectors and comparison policy.", "Preserve all 12 delegated vector obligations: int64-beyond-safe, int64-huge-exponent, float-finite, float-nonfinite-rejected, variant-canonical-tag, variant-wrong-tag, option-some-none, duplicate-member, duplicate-native-syntax, extra-member, missing-member, nested-roundtrip-stable (runtime/test/browser-wire-vectors.ts:45-157)."], ["wire vector inputs"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m14 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m14_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m14_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-010", "", "default", "r1", ["bun and node/Playwright installed", "CAN_BROWSER_EVIDENCE_DIR optional"], [], false, false) => ok [spec::diagnostic("migration::claim_m14_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-010")]
    match call m14_slice("m14")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m14_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m14: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m14_slice.
fn spec::diagnostic[] validate_m14_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m14_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-010", "", "default", "r1", ["bun and node/Playwright installed", "CAN_BROWSER_EVIDENCE_DIR optional"], [], false, false) => ok [spec::diagnostic("migration::claim_m14_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-010")]
    match call claim_m14_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m14_manifest
    emits {}
    given
        str scope
    asserts
        m14: "m14" => ok campaign("z01-manifest/m14/2026-10-02", "z01-campaign/m14/attempt-1", ["BROWSER-010", "BROWSER-038", "BROWSER-039", "BROWSER-040"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m14"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m14/2026-10-02", "z01-campaign/m14/attempt-1", ["BROWSER-010", "BROWSER-038", "BROWSER-039", "BROWSER-040"])
