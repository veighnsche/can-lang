package migration
    provides [m16_slice, claim_m16_identity_problems, validate_m16_claim, campaign_m16_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m16 (BROWSER-013..BROWSER-018).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 6 Grid and compare contract build matrix rows. No retained rows (missing only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for BROWSER-013..BROWSER-018. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m16_slice
    emits {}
    given
        str scope
    asserts
        m16: "m16" => ok [row_map("BROWSER-013", "missing", "", "", "", [], ["Grid and compare projects assert with real-can evidence (currently 394 and 221 roots respectively).", "Compare browser build and server pairing each repeat with stable identity and no stray emit; inspect browser asset/import audit."], ["grid", "compare"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-014", "missing", "", "", "", [], ["Break vendored controls API in staged copy; both grid and compare check must fail with relevant located diagnostics."], ["grid", "compare", "API break edits"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-015", "missing", "", "", "", [], ["Apply five shared contract edits: route rename remains compatible and both server/grid production targets build; capture, wire shape, body mode and leaf edits must diagnose in both consumers.", "Require edited declaration names and located source clues in each rejection."], ["route compatible", "capture break", "wire arity break", "body mode break", "leaf break", "server/grid consumers"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-016", "missing", "", "", "", [], ["Server Can assertions with real evidence; deterministic compare/grid browser builds and paired IDs, distinct drift generations.", "Run compare, grid, rollout and rollback browser legs on all three required engines."], ["compare", "grid", "rollout", "rollback", "Chromium", "WebKit", "Firefox"], ["CAN_BUN_ARCHIVE", "node/Playwright installed", "CAN_FIREFOX_WS optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-017", "missing", "", "", "", [], ["Probe required Chromium/WebKit/Firefox before builds; stage invoice server, grid, conformance fixture and empty app with real Can assertions.", "Repeat browser and paired builds for identity, import isolation and no stray output; run grid/conformance/empty/invoice live matrix with DB, network, DOM, fault and evidence checks.", "Keep the recorded WebKit same-origin redirect interception limitation explicit; Chromium qualifies that branch."], ["grid", "conformance", "empty", "invoice", "Chromium/WebKit/Firefox", "redirect qualified on Chromium"], ["CAN_BUN_ARCHIVE", "node/Playwright installed", "CAN_FIREFOX_WS optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-018", "missing", "", "", "", [], ["Reject invoice server argv entry for browser target at entry-shape gate.", "Scan grid Can sources for no set_timeout/setTimeout token so timer-free leak surface remains."], ["server entry", "grid source scan"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m16"
        false => ok []
        true => ok [row_map("BROWSER-013", "missing", "", "", "", [], ["Grid and compare projects assert with real-can evidence (currently 394 and 221 roots respectively).", "Compare browser build and server pairing each repeat with stable identity and no stray emit; inspect browser asset/import audit."], ["grid", "compare"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-014", "missing", "", "", "", [], ["Break vendored controls API in staged copy; both grid and compare check must fail with relevant located diagnostics."], ["grid", "compare", "API break edits"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-015", "missing", "", "", "", [], ["Apply five shared contract edits: route rename remains compatible and both server/grid production targets build; capture, wire shape, body mode and leaf edits must diagnose in both consumers.", "Require edited declaration names and located source clues in each rejection."], ["route compatible", "capture break", "wire arity break", "body mode break", "leaf break", "server/grid consumers"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-016", "missing", "", "", "", [], ["Server Can assertions with real evidence; deterministic compare/grid browser builds and paired IDs, distinct drift generations.", "Run compare, grid, rollout and rollback browser legs on all three required engines."], ["compare", "grid", "rollout", "rollback", "Chromium", "WebKit", "Firefox"], ["CAN_BUN_ARCHIVE", "node/Playwright installed", "CAN_FIREFOX_WS optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-017", "missing", "", "", "", [], ["Probe required Chromium/WebKit/Firefox before builds; stage invoice server, grid, conformance fixture and empty app with real Can assertions.", "Repeat browser and paired builds for identity, import isolation and no stray output; run grid/conformance/empty/invoice live matrix with DB, network, DOM, fault and evidence checks.", "Keep the recorded WebKit same-origin redirect interception limitation explicit; Chromium qualifies that branch."], ["grid", "conformance", "empty", "invoice", "Chromium/WebKit/Firefox", "redirect qualified on Chromium"], ["CAN_BUN_ARCHIVE", "node/Playwright installed", "CAN_FIREFOX_WS optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-018", "missing", "", "", "", [], ["Reject invoice server argv entry for browser target at entry-shape gate.", "Scan grid Can sources for no set_timeout/setTimeout token so timer-free leak surface remains."], ["server entry", "grid source scan"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m16 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m16_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m16_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-013", "", "default", "r1", ["CAN_BUN_ARCHIVE"], [], false, false) => ok [spec::diagnostic("migration::claim_m16_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-013")]
    match call m16_slice("m16")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m16_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m16: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m16_slice.
fn spec::diagnostic[] validate_m16_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m16_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-013", "", "default", "r1", ["CAN_BUN_ARCHIVE"], [], false, false) => ok [spec::diagnostic("migration::claim_m16_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-013")]
    match call claim_m16_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m16_manifest
    emits {}
    given
        str scope
    asserts
        m16: "m16" => ok campaign("z01-manifest/m16/2026-10-02", "z01-campaign/m16/attempt-1", ["BROWSER-013", "BROWSER-014", "BROWSER-015", "BROWSER-016", "BROWSER-017", "BROWSER-018"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m16"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m16/2026-10-02", "z01-campaign/m16/attempt-1", ["BROWSER-013", "BROWSER-014", "BROWSER-015", "BROWSER-016", "BROWSER-017", "BROWSER-018"])
