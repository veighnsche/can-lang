package migration
    provides [m17_slice, claim_m17_identity_problems, validate_m17_claim, campaign_m17_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m17 (BROWSER-019..BROWSER-027).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 9 Invoice contract mutation matrix rows. No retained rows (missing only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for BROWSER-019..BROWSER-027. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m17_slice
    emits {}
    given
        str scope
    asserts
        m17: "m17" => ok [row_map("BROWSER-019", "missing", "", "", "", [], ["Rename load route in shared contract; paired build must bind edit.", "Old route returns 405, unknown route 404, new route loads revision/lines, malformed capture 400; browser load/save uses edited route and DB replay records correct rows."], ["route rename", "old/new/unknown/malformed path"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-020", "missing", "", "", "", [], ["Rename named capture across contract and caller; paired entry and HTTP load/save use new capture, malformed input rejected.", "Browser saves with renamed capture and database/DOM remain consistent."], ["capture rename", "valid/malformed"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-021", "missing", "", "", "", [], ["Rename invoice field; new-field JSON save commits while old-field payload is rejected.", "Browser request must carry new field exactly and never old field; DOM and database agree."], ["new field", "old field"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-022", "missing", "", "", "", [], ["Rename domain failure leaf; invalid save returns 422 with new tag, valid save still works.", "Browser renders renamed error; invalid and valid database/replay legs stay distinct."], ["renamed leaf", "invalid/valid save"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-023", "missing", "", "", "", [], ["Move save success status to 201 through shared contract and relock; server and browser both observe 201.", "Browser DOM and committed database rows reflect one save; pristine contract base remains unchanged."], ["status edit", "pristine vs edited"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-024", "missing", "", "", "", [], ["Lower body budget: over-limit HTTP request gets 413 and does not commit; browser blocks oversized save before sending.", "Under-limit request succeeds and commits exactly the shrunk line; byte boundary is measured."], ["over-limit", "browser budget", "under-limit"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-025", "missing", "", "", "", [], ["Flip route body mode and relock: grid build must reject JSON-kind mismatch.", "Form route accepts form body; JSON-to-form and HTML-to-JSON get 415; untouched load and pristine JSON route continue working."], ["form mode", "JSON mismatch", "HTML mismatch", "pristine"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-026", "missing", "", "", "", [], ["Edited and pristine browser builds get distinct identities; pairing edited server with pristine or tampered browser manifest must be refused.", "A matched edited browser/server pair is the positive control and publishes a paired entry."], ["pristine manifest", "tampered manifest"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-027", "missing", "", "", "", [], ["Unregister routes in staged server; load, save and form save return 404 without recording posts.", "Health and grid shell remain available so refusal is route-specific."], ["load", "JSON save", "form save", "health/grid shell"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m17"
        false => ok []
        true => ok [row_map("BROWSER-019", "missing", "", "", "", [], ["Rename load route in shared contract; paired build must bind edit.", "Old route returns 405, unknown route 404, new route loads revision/lines, malformed capture 400; browser load/save uses edited route and DB replay records correct rows."], ["route rename", "old/new/unknown/malformed path"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-020", "missing", "", "", "", [], ["Rename named capture across contract and caller; paired entry and HTTP load/save use new capture, malformed input rejected.", "Browser saves with renamed capture and database/DOM remain consistent."], ["capture rename", "valid/malformed"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-021", "missing", "", "", "", [], ["Rename invoice field; new-field JSON save commits while old-field payload is rejected.", "Browser request must carry new field exactly and never old field; DOM and database agree."], ["new field", "old field"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-022", "missing", "", "", "", [], ["Rename domain failure leaf; invalid save returns 422 with new tag, valid save still works.", "Browser renders renamed error; invalid and valid database/replay legs stay distinct."], ["renamed leaf", "invalid/valid save"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-023", "missing", "", "", "", [], ["Move save success status to 201 through shared contract and relock; server and browser both observe 201.", "Browser DOM and committed database rows reflect one save; pristine contract base remains unchanged."], ["status edit", "pristine vs edited"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-024", "missing", "", "", "", [], ["Lower body budget: over-limit HTTP request gets 413 and does not commit; browser blocks oversized save before sending.", "Under-limit request succeeds and commits exactly the shrunk line; byte boundary is measured."], ["over-limit", "browser budget", "under-limit"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-025", "missing", "", "", "", [], ["Flip route body mode and relock: grid build must reject JSON-kind mismatch.", "Form route accepts form body; JSON-to-form and HTML-to-JSON get 415; untouched load and pristine JSON route continue working."], ["form mode", "JSON mismatch", "HTML mismatch", "pristine"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-026", "missing", "", "", "", [], ["Edited and pristine browser builds get distinct identities; pairing edited server with pristine or tampered browser manifest must be refused.", "A matched edited browser/server pair is the positive control and publishes a paired entry."], ["pristine manifest", "tampered manifest"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-027", "missing", "", "", "", [], ["Unregister routes in staged server; load, save and form save return 404 without recording posts.", "Health and grid shell remain available so refusal is route-specific."], ["load", "JSON save", "form save", "health/grid shell"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m17 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m17_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m17_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-019", "", "default", "r1", ["CAN_BUN_ARCHIVE"], [], false, false) => ok [spec::diagnostic("migration::claim_m17_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-019")]
    match call m17_slice("m17")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m17_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m17: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m17_slice.
fn spec::diagnostic[] validate_m17_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m17_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-019", "", "default", "r1", ["CAN_BUN_ARCHIVE"], [], false, false) => ok [spec::diagnostic("migration::claim_m17_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-019")]
    match call claim_m17_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m17_manifest
    emits {}
    given
        str scope
    asserts
        m17: "m17" => ok campaign("z01-manifest/m17/2026-10-02", "z01-campaign/m17/attempt-1", ["BROWSER-019", "BROWSER-020", "BROWSER-021", "BROWSER-022", "BROWSER-023", "BROWSER-024", "BROWSER-025", "BROWSER-026", "BROWSER-027"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m17"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m17/2026-10-02", "z01-campaign/m17/attempt-1", ["BROWSER-019", "BROWSER-020", "BROWSER-021", "BROWSER-022", "BROWSER-023", "BROWSER-024", "BROWSER-025", "BROWSER-026", "BROWSER-027"])
