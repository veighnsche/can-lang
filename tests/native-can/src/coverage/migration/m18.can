package migration
    provides [m18_slice, claim_m18_identity_problems, validate_m18_claim, campaign_m18_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m18 (BROWSER-028..BROWSER-056).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 9 Invoice live server, guard and DB fixtures rows. No retained rows (missing only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for BROWSER-028..BROWSER-056. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m18_slice
    emits {}
    given
        str scope
    asserts
        m18: "m18" => ok [row_map("BROWSER-028", "missing", "", "", "", [], ["Stage invoice-grid browser build; all attached Can assertions pass with real evidence.", "Browser report and asset identity/content shape are valid."], ["invoice-grid"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-029", "missing", "", "", "", [], ["Serve invoice form and grid with seeded SQLite; verify tenant/session/CSRF/origin/method denials and hostile escaping.", "Exercise form and JSON saves, validation/stale/structural/replay/conflict/status paths; inspect independent invoice/replay rows and retention effects.", "Check shell/CSP/headers/body, exact amounts and row order, failures and untouched state after rejection."], ["GET/form/JSON", "valid/stale/invalid/hostile/forbidden", "replay and retention", "fault injection"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-030", "missing", "", "", "", [], ["Server must exit before listening for missing/invalid PUBLIC_ORIGIN or nonpositive/malformed replay window."], ["bad origin", "missing origin", "zero/negative/malformed window"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-031", "missing", "", "", "", [], ["Paired invoice server serves exactly report-selected digest script in grid and form shell; script bytes and non-HTML health response are correct.", "The empty browser fixture proves wiring only, not grid interactions."], ["grid shell", "form shell", "health"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-032", "missing", "", "", "", [], ["Drive invoice.mjs on the compiled live invoice server and seeded SQLite; require a well-formed passing browser report and every reported check passed.", "Independently inspect the SQLite invoice row and require invoice 7 revision to differ from 1 after browser submission."], ["Chromium default of invoice.mjs", "tenant_id content gate on script source"], ["CAN_BUN_ARCHIVE", "pinned Playwright installation", "invoice.mjs contains tenant_id (currently true)"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-033", "missing", "", "", "", [], ["Server page declares same-origin htmx noSwap and allowed per-status swaps; emitted fragments have exact HTML content type and safe escaped bytes.", "Save statuses 200/403/409/422/503 and denied/malformed/redirect cases preserve draft/error semantics."], ["success", "forbidden", "conflict", "validation", "busy", "malformed/redirect"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-034", "missing", "", "", "", [], ["Validate supplied UP23 verdict record includes engine/commit and pass plus evidence for every required DOM leg: 200/403/409/422/503 swaps, missing targets, rejected out-of-band/partial/control headers and remount.", "A supplied report is historical/indirect evidence, not live execution by this Go test."], ["11 named verdict legs"], ["CAN_UP23_RESULTS supplied or skipped"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-055", "missing", "", "", "", [], ["Setup schema and seed deterministic sessions, memberships, invoices and lines including hostile text; independent readback stringifies exact integer values and replay rows.", "Can-selected mutations: touch replay timestamp, drop allowlisted table, read revision, revoke session, add/remove membership and inject/delete lines."], ["setup", "seed", "inspect", "touch-replay", "fault", "revision", "revoke", "member/unmember", "inject-line/delete-line"], ["disposable SQLite database"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-056", "missing", "", "", "", [], ["Validate 12-statement fixed seed shape, setup PostgreSQL 17 tables/rows and teardown owned tables; report server version and three row counts."], ["setup", "teardown"], ["CAN_TEST_POSTGRES_URL disposable PostgreSQL"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m18"
        false => ok []
        true => ok [row_map("BROWSER-028", "missing", "", "", "", [], ["Stage invoice-grid browser build; all attached Can assertions pass with real evidence.", "Browser report and asset identity/content shape are valid."], ["invoice-grid"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-029", "missing", "", "", "", [], ["Serve invoice form and grid with seeded SQLite; verify tenant/session/CSRF/origin/method denials and hostile escaping.", "Exercise form and JSON saves, validation/stale/structural/replay/conflict/status paths; inspect independent invoice/replay rows and retention effects.", "Check shell/CSP/headers/body, exact amounts and row order, failures and untouched state after rejection."], ["GET/form/JSON", "valid/stale/invalid/hostile/forbidden", "replay and retention", "fault injection"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-030", "missing", "", "", "", [], ["Server must exit before listening for missing/invalid PUBLIC_ORIGIN or nonpositive/malformed replay window."], ["bad origin", "missing origin", "zero/negative/malformed window"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-031", "missing", "", "", "", [], ["Paired invoice server serves exactly report-selected digest script in grid and form shell; script bytes and non-HTML health response are correct.", "The empty browser fixture proves wiring only, not grid interactions."], ["grid shell", "form shell", "health"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-032", "missing", "", "", "", [], ["Drive invoice.mjs on the compiled live invoice server and seeded SQLite; require a well-formed passing browser report and every reported check passed.", "Independently inspect the SQLite invoice row and require invoice 7 revision to differ from 1 after browser submission."], ["Chromium default of invoice.mjs", "tenant_id content gate on script source"], ["CAN_BUN_ARCHIVE", "pinned Playwright installation", "invoice.mjs contains tenant_id (currently true)"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-033", "missing", "", "", "", [], ["Server page declares same-origin htmx noSwap and allowed per-status swaps; emitted fragments have exact HTML content type and safe escaped bytes.", "Save statuses 200/403/409/422/503 and denied/malformed/redirect cases preserve draft/error semantics."], ["success", "forbidden", "conflict", "validation", "busy", "malformed/redirect"], ["CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-034", "missing", "", "", "", [], ["Validate supplied UP23 verdict record includes engine/commit and pass plus evidence for every required DOM leg: 200/403/409/422/503 swaps, missing targets, rejected out-of-band/partial/control headers and remount.", "A supplied report is historical/indirect evidence, not live execution by this Go test."], ["11 named verdict legs"], ["CAN_UP23_RESULTS supplied or skipped"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-055", "missing", "", "", "", [], ["Setup schema and seed deterministic sessions, memberships, invoices and lines including hostile text; independent readback stringifies exact integer values and replay rows.", "Can-selected mutations: touch replay timestamp, drop allowlisted table, read revision, revoke session, add/remove membership and inject/delete lines."], ["setup", "seed", "inspect", "touch-replay", "fault", "revision", "revoke", "member/unmember", "inject-line/delete-line"], ["disposable SQLite database"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-056", "missing", "", "", "", [], ["Validate 12-statement fixed seed shape, setup PostgreSQL 17 tables/rows and teardown owned tables; report server version and three row counts."], ["setup", "teardown"], ["CAN_TEST_POSTGRES_URL disposable PostgreSQL"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m18 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m18_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m18_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-028", "", "default", "r1", ["CAN_BUN_ARCHIVE"], [], false, false) => ok [spec::diagnostic("migration::claim_m18_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-028")]
    match call m18_slice("m18")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m18_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m18: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m18_slice.
fn spec::diagnostic[] validate_m18_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m18_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-028", "", "default", "r1", ["CAN_BUN_ARCHIVE"], [], false, false) => ok [spec::diagnostic("migration::claim_m18_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-028")]
    match call claim_m18_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m18_manifest
    emits {}
    given
        str scope
    asserts
        m18: "m18" => ok campaign("z01-manifest/m18/2026-10-02", "z01-campaign/m18/attempt-1", ["BROWSER-028", "BROWSER-029", "BROWSER-030", "BROWSER-031", "BROWSER-032", "BROWSER-033", "BROWSER-034", "BROWSER-055", "BROWSER-056"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m18"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m18/2026-10-02", "z01-campaign/m18/attempt-1", ["BROWSER-028", "BROWSER-029", "BROWSER-030", "BROWSER-031", "BROWSER-032", "BROWSER-033", "BROWSER-034", "BROWSER-055", "BROWSER-056"])
