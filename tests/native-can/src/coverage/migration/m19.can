package migration
    provides [m19_slice, claim_m19_identity_problems, validate_m19_claim, campaign_m19_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m19 (BROWSER-035..BROWSER-049).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 4 Accounts, assets, dashboard and forms UI rows. No retained rows (missing only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for BROWSER-035..BROWSER-049. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m19_slice
    emits {}
    given
        str scope
    asserts
        m19: "m19" => ok [row_map("BROWSER-035", "missing", "", "", "", [], ["Chromium account-search HTMX page: pinned local scripts, 200 search swap, quiet 422 search, escaped hostile search, validation 422/200 swaps and dashboard polling.", "Require no outbound request and screenshot/report evidence.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, search-200-swap, search-422-quiet, search-hostile-escaped, validate-422-swap, validate-200-swap, dashboard-poll, no-external-requests."], ["Chromium", "valid/empty/hostile search", "valid/invalid validation"], ["Playwright/Chromium", "live seeded PostgreSQL"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-036", "missing", "", "", "", [], ["Browser asset page: pinned HTMX/guard and local stylesheet, CSP/config, form 422 quiet/200 swap, hostile escaping, 204/500 no-swap and dashboard polling.", "Require no outbound requests and screenshot/report evidence.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, htmx-config, stylesheet-local, csp-header, form-422-quiet, form-200-swap, hostile-escaped, 204-no-swap, 500-no-swap, dashboard-polling, no-external-requests."], ["Chromium", "form/status variants"], ["Playwright/Chromium"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-045", "missing", "", "", "", [], ["Chromium HTMX dashboard: pinned scripts, initial poll swap and repeated polls; no external requests.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, dashboard-poll-swap, dashboard-repeated-polls, no-external-requests."], ["Chromium", "first/repeated poll"], ["Playwright/Chromium", "live seeded PostgreSQL"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-049", "missing", "", "", "", [], ["Chromium signup form: HTMX and pinned scripts, no inline handlers, CSP, 422 and 200 swaps, hostile escaping with no script execution.", "All browser requests stay loopback and screenshot/report are captured.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, no-inline-handlers, csp-header, form-422-swap, form-200-swap, hostile-escaped, no-external-requests."], ["Chromium", "invalid/valid/hostile form"], ["Playwright/Chromium"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m19"
        false => ok []
        true => ok [row_map("BROWSER-035", "missing", "", "", "", [], ["Chromium account-search HTMX page: pinned local scripts, 200 search swap, quiet 422 search, escaped hostile search, validation 422/200 swaps and dashboard polling.", "Require no outbound request and screenshot/report evidence.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, search-200-swap, search-422-quiet, search-hostile-escaped, validate-422-swap, validate-200-swap, dashboard-poll, no-external-requests."], ["Chromium", "valid/empty/hostile search", "valid/invalid validation"], ["Playwright/Chromium", "live seeded PostgreSQL"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-036", "missing", "", "", "", [], ["Browser asset page: pinned HTMX/guard and local stylesheet, CSP/config, form 422 quiet/200 swap, hostile escaping, 204/500 no-swap and dashboard polling.", "Require no outbound requests and screenshot/report evidence.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, htmx-config, stylesheet-local, csp-header, form-422-quiet, form-200-swap, hostile-escaped, 204-no-swap, 500-no-swap, dashboard-polling, no-external-requests."], ["Chromium", "form/status variants"], ["Playwright/Chromium"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-045", "missing", "", "", "", [], ["Chromium HTMX dashboard: pinned scripts, initial poll swap and repeated polls; no external requests.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, dashboard-poll-swap, dashboard-repeated-polls, no-external-requests."], ["Chromium", "first/repeated poll"], ["Playwright/Chromium", "live seeded PostgreSQL"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-049", "missing", "", "", "", [], ["Chromium signup form: HTMX and pinned scripts, no inline handlers, CSP, 422 and 200 swaps, hostile escaping with no script execution.", "All browser requests stay loopback and screenshot/report are captured.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, no-inline-handlers, csp-header, form-422-swap, form-200-swap, hostile-escaped, no-external-requests."], ["Chromium", "invalid/valid/hostile form"], ["Playwright/Chromium"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m19 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m19_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m19_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-035", "", "default", "r1", ["Playwright/Chromium", "live seeded PostgreSQL"], [], false, false) => ok [spec::diagnostic("migration::claim_m19_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-035")]
    match call m19_slice("m19")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m19_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m19: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m19_slice.
fn spec::diagnostic[] validate_m19_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m19_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-035", "", "default", "r1", ["Playwright/Chromium", "live seeded PostgreSQL"], [], false, false) => ok [spec::diagnostic("migration::claim_m19_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-035")]
    match call claim_m19_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m19_manifest
    emits {}
    given
        str scope
    asserts
        m19: "m19" => ok campaign("z01-manifest/m19/2026-10-02", "z01-campaign/m19/attempt-1", ["BROWSER-035", "BROWSER-036", "BROWSER-045", "BROWSER-049"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m19"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m19/2026-10-02", "z01-campaign/m19/attempt-1", ["BROWSER-035", "BROWSER-036", "BROWSER-045", "BROWSER-049"])
