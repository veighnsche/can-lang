package migration
    provides [m21_slice, claim_m21_identity_problems, validate_m21_claim, campaign_m21_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m21 (BROWSER-051..BROWSER-052).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 2 Invoice contract and form UI rows. No retained rows (missing only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for BROWSER-051..BROWSER-052. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m21_slice
    emits {}
    given
        str scope
    asserts
        m21: "m21" => ok [row_map("BROWSER-051", "missing", "", "", "", [], ["Contract-edit browser observer: boot revision/rows and paired script identity.", "Scenario save dispatches exactly one POST; invalid edit renders new error; budget edit blocks POST after network quiescence.", "Named old checks/legs to account for: boot-loads, client-identity, contract-save, contract-invalid, contract-budget."], ["Chromium", "save", "invalid", "budget"], ["Playwright/Chromium", "paired contract server"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-052", "missing", "", "", "", [], ["Live invoice form/HTMX: pinned scripts and policy; rendered inputs/escaped hostile content; 200/422/409/503/403 swaps preserve draft and focus.", "Missing target before/during, remount and restored/final save; reject OOB/partial/control headers and redirects; no outbound requests.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, htmx-config-policy, form-renders, save-200-swap, validation-422-swap, draft-and-focus-preserved, stale-409-swap, busy-503-swap, denied-403-swap, target-absence-stable, remount-stable, target-restored-save, missing-target-during, final-save, redirect-rejected, no-external-requests."], ["Chromium/WebKit/Firefox", "five statuses", "missing target/remount", "hostile response injection"], ["Playwright/browser engines", "paired invoice server and SQLite"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m21"
        false => ok []
        true => ok [row_map("BROWSER-051", "missing", "", "", "", [], ["Contract-edit browser observer: boot revision/rows and paired script identity.", "Scenario save dispatches exactly one POST; invalid edit renders new error; budget edit blocks POST after network quiescence.", "Named old checks/legs to account for: boot-loads, client-identity, contract-save, contract-invalid, contract-budget."], ["Chromium", "save", "invalid", "budget"], ["Playwright/Chromium", "paired contract server"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("BROWSER-052", "missing", "", "", "", [], ["Live invoice form/HTMX: pinned scripts and policy; rendered inputs/escaped hostile content; 200/422/409/503/403 swaps preserve draft and focus.", "Missing target before/during, remount and restored/final save; reject OOB/partial/control headers and redirects; no outbound requests.", "Named old checks/legs to account for: htmx-loaded, pinned-scripts, htmx-config-policy, form-renders, save-200-swap, validation-422-swap, draft-and-focus-preserved, stale-409-swap, busy-503-swap, denied-403-swap, target-absence-stable, remount-stable, target-restored-save, missing-target-during, final-save, redirect-rejected, no-external-requests."], ["Chromium/WebKit/Firefox", "five statuses", "missing target/remount", "hostile response injection"], ["Playwright/browser engines", "paired invoice server and SQLite"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m21 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m21_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m21_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-051", "", "default", "r1", ["Playwright/Chromium", "paired contract server"], [], false, false) => ok [spec::diagnostic("migration::claim_m21_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-051")]
    match call m21_slice("m21")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m21_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m21: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m21_slice.
fn spec::diagnostic[] validate_m21_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m21_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "BROWSER-051", "", "default", "r1", ["Playwright/Chromium", "paired contract server"], [], false, false) => ok [spec::diagnostic("migration::claim_m21_identity_problems", "case  variant default root coverage run r1", "unretained-row", "BROWSER-051")]
    match call claim_m21_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m21_manifest
    emits {}
    given
        str scope
    asserts
        m21: "m21" => ok campaign("z01-manifest/m21/2026-10-02", "z01-campaign/m21/attempt-1", ["BROWSER-051", "BROWSER-052"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m21"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m21/2026-10-02", "z01-campaign/m21/attempt-1", ["BROWSER-051", "BROWSER-052"])
