package migration
    provides [m23_slice, claim_m23_identity_problems, validate_m23_claim, campaign_m23_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m23 (HISTORY-003..HISTORY-022).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 4 Transactions and persistence rows. Multi-case rows: one row_map per (row, case) pair; claims resolve through row_case_index; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for HISTORY-003..HISTORY-022. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m23_slice
    emits {}
    given
        str scope
    asserts
        m23: "m23" => ok [row_map("HISTORY-003", "retained", "tests/native-can/migration/m23-transactions-and-persistence/history-003-roots-green.can", "d6d3e6dc73891e8f3882c08d451c5bfb1df17596ed90c69a145199992bae4031", "history/tx-roots", ["fixture-path", "project-name", "errors-name", "errors-empty", "entry-src", "source-root-key", "error-registry-key", "param-search-type", "param-id-type", "row-account-type", "assert-exit", "assert-diag-empty"], ["Twelve supplied transaction assertion roots pass; emitted transaction/SQL wiring and repeatable relocated build identity hold; optional strict typecheck passes.", "Wrong cardinality, missing parameter type, wrong row type and undeclared descriptor each reject."], ["four negative manifest mutations"], ["CAN_BUN_ARCHIVE", "CAN_TSC optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-003", "retained", "tests/native-can/migration/m23-transactions-and-persistence/history-003-tx-semantics.can", "2feb4fcd070e52719a3bbe190ad1385ee98b18d6a6350f80ba9ae9e58d19b0f3", "history/tx", ["env-gate", "skip-needle", "ctx-timeout-min", "sandbox-profile", "offline-path", "canlc-bin", "assert-cmd", "assert-exit", "report-passed", "report-passed-key", "report-assertions-key", "report-root-count", "desc-count", "desc-tx-add", "desc-tx-get", "card-execute", "card-one", "dialect", "row-limit-param", "root-decide-add", "root-decide-rollback", "root-decide-fetch-sample", "root-decide-fetch-missing", "root-decide-inner", "root-decide-nested", "root-run-add", "root-run-rollback", "root-run-fetch", "root-run-nested", "root-main-empty", "root-main-badop"], ["Twelve supplied transaction assertion roots pass; emitted transaction/SQL wiring and repeatable relocated build identity hold; optional strict typecheck passes.", "Wrong cardinality, missing parameter type, wrong row type and undeclared descriptor each reject."], ["four negative manifest mutations"], ["CAN_BUN_ARCHIVE", "CAN_TSC optional"], [], ["qualified-rep