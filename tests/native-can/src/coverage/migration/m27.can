 "owner-forge/rejection-outcome", ["exit-nonzero", "report-absent"], ["Foreign owner-record constructor is rejected at check phase, with no assertion report."], ["forged owner source"], ["CONV_BUNDLE or CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-025", "retained", "tests/native-can/migration/m27-owner-factory-and-isolation-co/history-025-diagnostic-confinement.can", "d6f2496c5a06187e71b4e551dcf5beda66eba2492a71dff075028f049e7c47cd", "owner-forge/diagnostic-confinement", ["diagnostic-present", "diagnostic-exact"], ["Foreign owner-record constructor is rejected at check phase, with no assertion report."], ["forged owner source"], ["CONV_BUNDLE or CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-026", "retained", "tests/native-can/migration/m27-owner-factory-and-isolation-co/history-026-sneak-shape.can", "08463c8d6784512a663227a4ea6755d6c9ce417be6f4ab3d5d7d63b3bd148c08", "owner-sneak/sneak-shape", ["sneak-package", "sneak-provides-empty", "sneak-uses-handler", "sneak-calls-factory", "factory-unprovided"], ["Foreign package cannot call private fixture_id factory."], ["injected sneak package"], ["CONV_BUNDLE or CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-026", "retained", "tests/native-can/migration/m27-owner-factory-and-isolation-co/history-026-check-rejection.can", "528b7a987cbfffc053989bfd479b69f2d8ceea6744af2abe0e152612a7d9677b", "owner-sneak/check-rejection", ["exit-nonzero", "report-absent", "phase-check"], ["Foreign package cannot call private fixture_id factory."], ["injected sneak package"], ["CONV_BUNDLE or CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-026", "retained", "tests/native-can/migration/m27-owner-factory-and-isolation-co/history-026-diagnostic-text.can", "f4390218ebe29a29ebb9d55940a5d1c7cc7ac5f535dc123844810fbb14b5c5c5", "owner-sneak/diagnos