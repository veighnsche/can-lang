-receipt"], "")]
        other: "nope" => ok []
    match scope is "m27"
        false => ok []
        true => ok [row_map("HISTORY-023", "retained", "tests/native-can/migration/m27-owner-factory-and-isolation-co/history-023-roots-green.can", "cefecf97fb53e9583c8db9357e6d16952d6f8d6c83dad067e3359eda0bf30c65", "owner-setup/green-roots", ["root-count", "ids-parse-good", "ids-parse-bad", "ids-value-good", "tier-for-gold", "tier-for-silver", "tier-for-bronze", "handle-gold", "handle-silver", "handle-bronze", "handle-bad", "factory-unit", "trap-kind-green", "trap-message-green", "app-empty"], ["Owner helper extraction through private fallible factory, trap kind/message probes and all pre-extraction roots green (14 roots)."], ["positive owner project"], ["CONV_BUNDLE or CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-023", "retained", "tests/native-can/migration/m27-owner-factory-and-isolation-co/history-023-report-provenance.can", "059906dfe54e3a4be1401b8a1de23ac1fb7a619707f7d567344ffbcab0b62628", "owner-setup/report-provenance", ["exit-zero", "report-passed", "real-can-count"], ["Owner helper extraction through private fallible factory, trap kind/message probes and all pre-extraction roots green (14 roots)."], ["positive owner project"], ["CONV_BUNDLE or CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-023", "retained", "tests/native-can/migration/m27-owner-factory-and-isolation-co/history-023-factory-boundary.can", "aa9d523efd5cd08015ceb5356e77c4f6bae75212eaf21f5ccd4cfa105ec125ab", "owner-setup/factory-boundary", ["provides-exact", "factory-private", "helper-owner-typed", "trap-armed", "trap-kind", "trap-message", "trap-op"], ["Owner helper extraction through private fallible factory, trap kind/message probes and all pre-extraction roots green (14 roots)."], ["positive owner project"], ["CONV_BUNDLE or CAN_BUN_ARCHIVE"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-024", "retained", "tests/native-can/migration/m27-owner-factory-