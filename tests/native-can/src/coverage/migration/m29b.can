/// Identity side of a complete-coverage claim against the m29b manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. delegates are checked both directions.
fn spec::diagnostic[] claim_m29b_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case life/key-semantics variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "LIFE-017", "life/key-semantics-missing", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case life/key-semantics-missing variant default root coverage run r1", "unknown-row", "LIFE-017")]
        entry_drift: [job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "LIFE-017", "life/key-roots", "default", "r1", 1, "attempt", "passed", "full", 28, 28, "", "", -1)], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case life/key-semantics variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", [], [], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case life/key-semantics variant default root coverage run r1", "missing-engine", "LIFE-017")]
        unaccepted: [job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case life/key-semantics variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", ["bun-prototype-env"], ["DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case life/key-semantics variant default root coverage run r1", "extra-delegate", "LIFE-017")]
    match call m29b_slice("m29b")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m29b_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m29b: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m29b_slice.
fn spec::diagnostic[] validate_m29b_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 1, "attempt", "passed", "full", 12, 12, "", "", -1)], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m29b_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 1, "attempt", "failed", "full", 0, 12, "", "", -1), job_entry("j1", "LIFE-017", "life/key-semantics", "default", "r1", 3, "attempt", "passed", "full", 12, 12, "", "", -1)], claim("j1", "LIFE-017", "life/key-semantics", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case life/key-semantics variant default root coverage run r1", "cherry-picked-report", "j1")]
    match call claim_m29b_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m29b_manifest
    emits {}
    given
        str scope
    asserts
        m29b: "m29b" => ok campaign("z01-manifest/m29b/2026-10-02", "z01-campaign/m29b/attempt-1", ["LIFE-017", "LIFE-018", "LIFE-019", "LIFE-020", "LIFE-021", "LIFE-022", "LIFE-023", "LIFE-024"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m29b"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m29b/2026-10-02", "z01-campaign/m29b/attempt-1", ["LIFE-017", "LIFE-018", "LIFE-019", "LIFE-020", "LIFE-021", "LIFE-022", "LIFE-023", "LIFE-024"])
