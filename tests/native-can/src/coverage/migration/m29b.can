"], ""), row_map("LIFE-023", "retained", "tests/native-can/migration/m29-cache-ownership-reuse-recovery/life-023-roots-green.can", "e7d2eef4532fd4a3ac94593f903e721da63d8d151a203a5438521df4afcb6f64", "life/shared-roots", ["archive-line", "getenv-call", "env-name", "gate-line", "gate-guard", "skip-line", "skip-call", "skip-diag", "ctx-line", "ctx-call", "bg-call", "timeout-shape", "cancel-line", "err-guard", "fatal-err", "comment-share", "comment-fill", "comment-stage", "bundle-count", "errguard-count", "comment-count"], ["Two bundle requests share one suite-owned artifact with <=1 new fill"], ["default"], ["CAN_BUN_ARCHIVE required"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-023", "retained", "tests/native-can/migration/m29-cache-ownership-reuse-recovery/life-023-run-shape.can", "c012170fa75a9847ad5e8b797eb8cc938345af1731efbd57fa5ccd0039bc0a2a", "life/shared-run", ["test-name", "sig-line", "before-leg", "first-leg", "second-leg", "identity-line", "fatalf-share", "fill-line", "fatalf-fill", "fatalf-call", "bundle-count", "fatalf-count"], ["Two bundle requests share one suite-owned artifact with <=1 new fill"], ["default"], ["CAN_BUN_ARCHIVE required"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-024", "retained", "tests/native-can/migration/m29-cache-ownership-reuse-recovery/life-024-cache-semantics.can", "fefc362148ca65244e22f6a2359a671f175b880720a94fa6545f993a3570e6f2", "life/testmain-cache-semantics", ["create-wording", "remove-wording", "fill-wording", "manifest-wording", "verify-wording", "verify-compare", "marker-compare", "fill-deadline", "heavy-default", "single-cache", "key-memoized", "atomic-publish", "cleanup-after-fail", "cleanup-overrides", "stale-reaped"], ["One per-run owned build cache; input-key reuse; manifest hash verification on hits; atomic fill and bounded contention", "Suite cleanup runs after failed tests and cleanup error overrides successful exit", "Heavy job admission polic