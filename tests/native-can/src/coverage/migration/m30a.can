 "tests/native-can/migration/m30-baseline-t26-t27-relevance/history-050-base-semantics.can", "0482c294ec2fba684073d5f546812615c3a366cf638e73ed78cc0f49aa258b95", "history/t27-no-deferred-base", ["numbered-pattern", "numbered-allow-1", "numbered-allow-2", "returning-file", "returning-wording", "finally-dir", "finally-suffix", "finally-pattern", "markup-file", "markup-spelling", "triplet-file", "triplet-suite", "triplet-fixture", "catalogue-path", "catalogue-group-packages", "catalogue-group-types", "catalogue-group-errors", "catalogue-group-operations", "deferred-pattern", "deferred-word-bulk", "deferred-word-billing", "deferred-word-calendar", "deferred-word-markup", "std-dir", "std-pkg-billing", "std-pkg-calendar", "candidate-dir", "candidate-readme", "candidate-record", "deferr-stem", "catalogue-group-count", "deferred-word-count", "std-pkg-count", "candidate-file-count", "leg-count"], ["No unauthorized numbered errors, RETURNING, finally/markup or bulk/billing/calendar surface; explicit parser rejection and deferral anchors persist."], ["default"], ["Bun/Go/Git for T01 smoke or generator when applicable"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-050", "retained", "tests/native-can/migration/m30-baseline-t26-t27-relevance/history-050-roots-green.can", "efbd7f2f5fbd8dd8d5bf3638b41b9ebfa2a96d595fd3d4fb826981de3cbda1a3", "history/t27-no-deferred-roots", ["walk-dir-compiler", "walk-dir-examples", "walk-dir-std", "walk-dir-tests", "suffix-can", "suffix-go", "skip-test-suffix", "entry-type", "entry-name-field", "entry-identity-field", "group-kind-field", "group-entries-field", "entry-tag-name", "entry-tag-identity", "numbered-extra-hit", "walk-dir-count", "suffix-count", "numbered-hit-count", "numbered-allow-count"], ["No unauthorized numbered errors, RETURNING, finally/markup or bulk/billing/calendar surface; explicit parser rejection and deferral anchors persist."], ["default"], ["Bun/Go/Git for T01 smoke or generator when applicable"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-050", "retained", "tests/native-can/migration/m30-baseline-t26-t27-relevance/history-050-run-shape.can", "1a723b9d05412c53bd8620198c15cb3dbf79a1aacc949df047622208fd5b5b4d", "history/t27-no-deferred-run", ["test-name", "root-call", "compile-call", "walk-call", "is-dir-call", "suffix-call", "rel-call", "read-file-call", "match-call", "fatalf-call", "error-call", "len-call", "read-call", "contains-call", "error-bare-call", "glob-call", "fatal-bare-call", "load-call", "match-string-call", "stat-call", "is-not-exist-call", "lower-call", "allowed-ident", "numbered-ident", "hits-ident", "finally-ident", "deferred-ident", "word-walk-fail", "word-numbered-outside", "word-numbered-hits", "word-returning-lost", "word-finally-hit", "word-markup-hit", "word-triplet-lost", "word-catalogue-hit", "word-std-exists", "word-deferral-lost", "errorf-site-count", "error-site-count", "fatal-site-count", "diagnostic-site-count"], ["No unauthorized numbered errors, RETURNING, finally/markup or bulk/billing/calendar surface; explicit parser rejection and deferral anchors persist."], ["default"], ["Bun/Go/Git for T01 smoke or generator when applicable"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-051", "retained", "tests/native-can/migration/m30-baseline-t26-t27-relevance/history-051-base-semantics.can", "308c1e1f9e33e26307ee4ad7a8a88b8eaddacbabfe0a98d8bfe2f6b494fd9350", "history/t27-gate-base", ["ev-comp-check", "ev-comp-emit", "ev-comp-syntax", "ev-gate3", "ev-gate4", "ev-gate5", "ev-grid", "ev-build-grid", "ev-sha256", "ev-baseline", "ev-registry", "ev-findings", "ev-count"], ["Audit links extant nonempty compiler/integration/browser evidence and baseline/consultation records."], ["default"], ["Bun/Go/Git for T01 smoke or generator when applicable"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-051", "retained", "tests/native-can/migration/m30-baseline-t26-t27-relevance/history-051-roots-green.can", "f974c2ed0379c41fbeb5045782e1999376c514e9096d0fd97a879c6e0641aa04", "history/t27-gate-roots", ["line-comp-check", "line-comp-emit", "line-comp-syntax", "line-gate3", "line-gate4", "line-gate5", "line-grid", "line-build-grid", "line-sha256", "line-baseline", "line-registry", "line-findings", "linked-count"], ["Audit links extant nonempty compiler/integration/browser evidence and baseline/consultation records."], ["default"], ["Bun/Go/Git for T01 smoke or generator when applicable"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-051", "retained", "tests/native-can/migration/m30-baseline-t26-t27-relevance/history-051-run-shape.can", "c35d54155991cdc63b9de87986d7568e7ab92f0e89a8b65abdd8ed2339bfa3df", "history/t27-gate-run", ["test-name", "audit-const", "audit-path", "root-call", "read-call", "evidence-ident", "loop-ident", "stat-call", "join-call", "slash-call", "size-call", "contains-call", "error-call", "error-missing", "error-unlinked", "error-site-count"], ["Audit links extant nonempty compiler/integration/browser evidence and baseline/consultation records."], ["default"], ["Bun/Go/Git for T01 smoke or generator when applicable"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m30a manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. delegates are checked both directions.
fn spec::diagnostic[] claim_m30a_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], [], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case history/toolchain-freeze variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "HISTORY-042", "history/toolchain-freeze-missing", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], [], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case history/toolchain-freeze-missing variant default root coverage run r1", "unknown-row", "HISTORY-042")]
        entry_drift: [job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-042", "history/toolchain-roots", "default", "r1", 1, "attempt", "passed", "full", 18, 18, "", "", -1)], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], [], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case history/toolchain-freeze variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", [], [], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case history/toolchain-freeze variant default root coverage run r1", "missing-engine", "HISTORY-042")]
        unaccepted: [job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], [], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case history/toolchain-freeze variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], ["DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case history/toolchain-freeze variant default root coverage run r1", "extra-delegate", "HISTORY-042")]
    match call m30a_slice("m30a")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m30a_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m30a: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m30a_slice.
fn spec::diagnostic[] validate_m30a_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 1, "attempt", "passed", "full", 19, 19, "", "", -1)], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m30a_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 1, "attempt", "failed", "full", 0, 19, "", "", -1), job_entry("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", 3, "attempt", "passed", "full", 19, 19, "", "", -1)], claim("j1", "HISTORY-042", "history/toolchain-freeze", "default", "r1", ["Bun/Go/Git for T01 smoke or generator when applicable"], [], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case history/toolchain-freeze variant default root coverage run r1", "cherry-picked-report", "j1")]
    match call claim_m30a_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m30a_manifest
    emits {}
    given
        str scope
    asserts
        m30a: "m30a" => ok campaign("z01-manifest/m30a/2026-10-02", "z01-campaign/m30a/attempt-1", ["HISTORY-042", "HISTORY-043", "HISTORY-044", "HISTORY-045", "HISTORY-046", "HISTORY-047", "HISTORY-048", "HISTORY-049", "HISTORY-050", "HISTORY-051"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m30a"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m30a/2026-10-02", "z01-campaign/m30a/attempt-1", ["HISTORY-042", "HISTORY-043", "HISTORY-044", "HISTORY-045", "HISTORY-046", "HISTORY-047", "HISTORY-048", "HISTORY-049", "HISTORY-050", "HISTORY-051"])
