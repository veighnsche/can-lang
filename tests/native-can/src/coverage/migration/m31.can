ead-manifest", "word-parse-manifest", "word-status", "word-twice", "word-entry-status", "word-dangles", "word-read-tree", "word-missing", "word-proto-status", "fatalf-site-count", "diagnostic-site-count", "join-site-count", "suffix-site-count", "name-site-count"], ["Review manifest is closed, unreviewed status and each prototype TS file appears exactly once without dangling entries."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m31 manifest:
/// same first-only contract as the pilot claim_identity_problems, but
/// resolved by (row, case) through row_case_index, so each of the nine
/// ported cases is addressable and case drift reports unknown-row. A
/// resolved but unretained row reports unretained-row (claims against
/// blocked, missing or obsolete rows are categorically invalid), and
/// delegates are checked both directions (required subset of offered
/// plus no offered extra), closing the pilot's one-directional subset
/// limitation for new slices.
fn spec::diagnostic[] claim_m31_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case history/prototype-admission-base variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "HISTORY-061", "history/prototype-admission-base-missing", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case history/prototype-admission-base-missing variant default root coverage run r1", "unknown-row", "HISTORY-061")]
        entry_drift: [job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-061", "history/prototype-admission-roots", "default", "r1", 1, "attempt", "passed", "full", 12, 12, "", "", -1)], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case history/prototype-admission-base variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", [], [], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case history/prototype-admission-base variant default root coverage run r1", "missing-engine", "HISTORY-061")]
        unaccepted: [job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case history/prototype-admission-base variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", ["bun-prototype-env"], ["DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case history/prototype-admission-base variant default root coverage run r1", "extra-delegate", "HISTORY-061")]
    match call m31_slice("m31")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m31_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m31: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m31_slice.
fn spec::diagnostic[] validate_m31_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 1, "attempt", "passed", "full", 11, 11, "", "", -1)], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m31_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 1, "attempt", "failed", "full", 0, 11, "", "", -1), job_entry("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", 3, "attempt", "passed", "full", 11, 11, "", "", -1)], claim("j1", "HISTORY-061", "history/prototype-admission-base", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case history/prototype-admission-base variant default root coverage run r1", "cherry-picked-report", "j1")]
    match call claim_m31_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m31_manifest
    emits {}
    given
        str scope
    asserts
        m31: "m31" => ok campaign("z01-manifest/m31/2026-10-02", "z01-campaign/m31/attempt-1", ["HISTORY-061", "HISTORY-062", "HISTORY-063"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m31"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m31/2026-10-02", "z01-campaign/m31/attempt-1", ["HISTORY-061", "HISTORY-062", "HISTORY-063"])
