package migration
    provides [m31_slice, claim_m31_identity_problems, validate_m31_claim, campaign_m31_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m31 (HISTORY-061..063).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for the three retained M31 prototype-admission rows. Each row ports
/// three cases (base/roots/run), so the slice lists one row_map per
/// (row, case) pair and resolves claims through row_case_index; the
/// shared credit, campaign and obligation machinery is reused unchanged
/// from the pilot. Source hashes are the reviewed sha256 bindings of the
/// port files; a port edit invalidates its binding until re-reviewed.
/// Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding. The m31_slice assert and body lists are generated from
// the M31 row evidence case_check_ids plus sha256 of the port files.)
fn row_map[] m31_slice
    emits {}
    given
        str scope
    asserts
        m31: "m31" => ok [row_map("HISTORY-061", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-061-base-semantics.can", "4300686258386001492f12ebffb2ef3a46583e0380927dec3bade222f32ff909", "history/prototype-admission-base", ["prefix-storage", "prefix-clipboard", "prefix-chart", "catalogue-path", "identity-field", "generated-path", "prefix-count", "tree-count", "operation-count", "catalogue-hit-count", "generated-hit-count"], ["Catalogue source and generated runtime contain no storage/clipboard/chart prototype identities; prevents self-admission."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-061", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-061-roots-green.can", "4a83947198111e9afd326be522b0f29046df99b2b6f0775b878fbd2482f5f3af", "history/prototype-admission-roots", ["list-name", "catalogue-rel-dir", "catalogue-leaf", "generated-rel-dir", "generated-leaf", "inventory-field", "identity-tag", "operations-tag", "prefix-call", "contains-call", "read-count", "loop-count"], ["Catalogue source and generated runtime contain no storage/clipboard/chart prototype identities; prevents self-admission."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-061", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-061-run-shape.can", "dd0add3cb19b2a9bbe15e969089c1b1c90ea06a78f82dc87446cf30f7450b860", "history/prototype-admission-run", ["test-name", "root-call", "read-call", "unmarshal-call", "len-call", "fatalf-call", "fatal-call", "word-read-catalogue", "word-parse-catalogue", "word-vacuous", "word-admitted", "word-read-generated", "word-generated-contains", "fatalf-site-count", "fatal-site-count", "diagnostic-site-count"], ["Catalogue source and generated runtime contain no storage/clipboard/chart prototype identities; prevents self-admission."], ["defa