word-read-manifest", "word-parse-manifest", "word-status", "word-twice", "word-entry-status", "word-dangles", "word-read-tree", "word-missing", "word-proto-status", "fatalf-site-count", "diagnostic-site-count", "join-site-count", "suffix-site-count", "name-site-count"], ["Review manifest is closed, unreviewed status and each prototype TS file appears exactly once without dangling entries."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m31"
        false => ok []
        true => ok [row_map("HISTORY-061", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-061-base-semantics.can", "4300686258386001492f12ebffb2ef3a46583e0380927dec3bade222f32ff909", "history/prototype-admission-base", ["prefix-storage", "prefix-clipboard", "prefix-chart", "catalogue-path", "identity-field", "generated-path", "prefix-count", "tree-count", "operation-count", "catalogue-hit-count", "generated-hit-count"], ["Catalogue source and generated runtime contain no storage/clipboard/chart prototype identities; prevents self-admission."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-061", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-061-roots-green.can", "4a83947198111e9afd326be522b0f29046df99b2b6f0775b878fbd2482f5f3af", "history/prototype-admission-roots", ["list-name", "catalogue-rel-dir", "catalogue-leaf", "generated-rel-dir", "generated-leaf", "inventory-field", "identity-tag", "operations-tag", "prefix-call", "contains-call", "read-count", "loop-count"], ["Catalogue source and generated runtime contain no storage/clipboard/chart prototype identities; prevents self-admission."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-061", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-061-run-shape.can", "dd0add3cb19b2a9bbe15e969089c1b1c90ea06a78f82dc87446cf30f7450b860", "history/prototype-admission-run", ["test-name", "root-call", "read-call", "unmarshal-call", "len-call", "fatalf-call", "fatal-call", "word-read-catalogue", "word-parse-catalogue", "word-vacuous", "word-admitted", "word-read-generated", "word-generated-contains", "fatalf-site-count", "fatal-site-count", "diagnostic-site-count"], ["Catalogue source and generated runtime contain no storage/clipboard/chart prototype identities; prevents self-admission."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-062", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-062-base-semantics.can", "77b50b326ba627a0fdd135c8f371aa9794181fd273c7be9ff46acc1d05702027", "history/prototype-unreferenced-base", ["needle", "tree-runtime", "tree-tools-runtime", "tree-compiler", "tree-examples", "tree-distribution", "tree-internal", "reverse-policy", "reverse-target", "reverse-file-count", "tree-count", "present-tree-count", "scanned-count", "violation-count"], ["Owned production trees do not reference host-discrimination prototype paths; reverse imports remain allowed."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-062", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-062-roots-green.can", "56f3829865513ab76e15f7cdd8f2ab9ad109dcc2045538523dc985db0638c612", "history/prototype-unreferenced-roots", ["list-name", "violations-ident", "skip-vendor", "skip-node-modules", "skip-git", "suffix-ts", "suffix-go", "suffix-json", "walk-call", "readdir-call", "skip-count", "suffix-count"], ["Owned production trees do not reference host-discrimination prototype paths; reverse imports remain allowed."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-062", "retained", "tests/native-can/migration/m31-prototype-admission-guards/history-062-run-shape.can", "d4cd4c9451c4c04636fd82e1424a6cf0861df043f4825c80379f89a9363acc83", "history/prototype-unreferenced-run", ["test-name", "root-call", "join-call", "isdir-call", "name-call", "skipdir-ident", "suffix-call", "read-call", "contains-call", "len-call", "fatalf-call", "word-read-tree", "word-walk-tree", "word-referenced", "fatalf-site-count", "diagnostic-site-count"], ["Owned production trees do not reference host-discrimination prototype paths; reverse imports remai