"unavailable-code", "no-native-text"], ["native security failure maps to unavailable with no native text; operations localGet; expected leaves storage::unavailable; native exception or secret text does not leak"], ["all values/host faults enumerated in this declaration"], ["Bun prototype test environment"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-089", "retained", "tests/native-can/migration/m32-prototype-local-adapters/history-089-storage-immutable-copies.can", "92de7cffd95c2072e1d48f2a40613d558b7a4aa1396f89cc8ae1cd9d34a8972a", "storage/immutable-copies", ["same-value", "result-frozen", "past-immutable"], ["immutable copies: results are frozen primitives with no aliasing; operations localGet, localSet; frozen/opaque output"], ["all values/host faults enumerated in this declaration"], ["Bun prototype test environment"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-090", "retained", "tests/native-can/migration/m32-prototype-local-adapters/history-090-storage-census.can", "14c63688cf07597a7401e7af3fe3ebf00b83543d61da20fa09d7074bd111af79", "storage/surface-census", ["op-names", "failure-leaves", "zero-callbacks"], ["surface census: three ops, three failure leaves, zero callbacks; operations localGet, localSet; expected leaves storage::invalid_key, storage::quota_exceeded, storage::unavailable"], ["all values/host faults enumerated in this declaration"], ["Bun prototype test environment"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m32 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m32_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case clipboard/roundtrip-write-read variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read-missing", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case clipboard/roundtrip-write-read-missing variant default root coverage run r1", "unknown-row", "HISTORY-076")]
        entry_drift: [job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-076", "clipboard/empty-reads-empty-leaf", "default", "r1", 1, "attempt", "passed", "full", 2, 2, "", "", -1)], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case clipboard/roundtrip-write-read variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", [], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case clipboard/roundtrip-write-read variant default root coverage run r1", "missing-engine", "HISTORY-076")]
        unaccepted: [job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case clipboard/roundtrip-write-read variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", ["Bun prototype test environment"], ["DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case clipboard/roundtrip-write-read variant default root coverage run r1", "extra-delegate", "HISTORY-076")]
        unretained_hit: [], claim("j1", "HISTORY-064", "m32history064/decide", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case m32history064/decide variant default root coverage run r1", "unretained-row", "HISTORY-064")]
    match call m32_slice("m32")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m32_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m32: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m32_slice.
fn spec::diagnostic[] validate_m32_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 1, "attempt", "passed", "full", 3, 3, "", "", -1)], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 1, "attempt", "failed", "full", 0, 3, "", "", -1), job_entry("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", 3, "attempt", "passed", "full", 3, 3, "", "", -1)], claim("j1", "HISTORY-076", "clipboard/roundtrip-write-read", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case clipboard/roundtrip-write-read variant default root coverage run r1", "cherry-picked-report", "j1")]
        unretained_hit: [], claim("j1", "HISTORY-064", "m32history064/decide", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m32_identity_problems", "case m32history064/decide variant default root coverage run r1", "unretained-row", "HISTORY-064")]
    match call claim_m32_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m32_manifest
    emits {}
    given
        str scope
    asserts
        m32: "m32" => ok campaign("z01-manifest/m32/2026-10-02", "z01-campaign/m32/attempt-1", ["HISTORY-064", "HISTORY-065", "HISTORY-066", "HISTORY-067", "HISTORY-068", "HISTORY-069", "HISTORY-070", "HISTORY-071", "HISTORY-072", "HISTORY-073", "HISTORY-074", "HISTORY-075", "HISTORY-076", "HISTORY-077", "HISTORY-078", "HISTORY-079", "HISTORY-080", "HISTORY-081", "HISTORY-082", "HISTORY-083", "HISTORY-084", "HISTORY-085", "HISTORY-086", "HISTORY-087", "HISTORY-088", "HISTORY-089", "HISTORY-090"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m32"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m32/2026-10-02", "z01-campaign/m32/attempt-1", ["HISTORY-064", "HISTORY-065", "HISTORY-066", "HISTORY-067", "HISTORY-068", "HISTORY-069", "HISTORY-070", "HISTORY-071", "HISTORY-072", "HISTORY-073", "HISTORY-074", "HISTORY-075", "HISTORY-076", "HISTORY-077", "HISTORY-078", "HISTORY-079", "HISTORY-080", "HISTORY-081", "HISTORY-082", "HISTORY-083", "HISTORY-084", "HISTORY-085", "HISTORY-086", "HISTORY-087", "HISTORY-088", "HISTORY-089", "HISTORY-090"])
