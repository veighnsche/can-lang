package migration
    provides [m33rest_slice, claim_m33rest_identity_problems, validate_m33rest_claim, campaign_m33rest_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m33rest (HISTORY-099..HISTORY-117).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 19 Prototype companion surfaces and packaging rows. No retained rows (obsolete only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for HISTORY-099..HISTORY-117. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m33rest_slice
    emits {}
    given
        str scope
    asserts
        m33rest: "m33rest" => ok [row_map("HISTORY-099", "obsolete", "tests/native-can/migration/m33-prototype-companion-surfaces-a/history-099-clipboard-roundtrip.can", "c8c4cb91039a013db9de91c40b25972d51cb095f48024ce4529b2b4427c0889c", "m33history099/decide", ["history_099", "unknown"], ["pastebin roundtrip: write then read returns the text; operations readText, writeText"], ["all values/host faults enumerated in this declaration"], ["Bun prototype test environment"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-100", "obsolete", "tests/native-can/migration/m33-prototype-companion-surfaces-a/history-100-clipboard-empty-leaf.can", "4e748fb42a831aaaed99076783d869cc66e32cdc7209fa7246f3afd1dc248e0d", "m33history100/decide", ["history_100", "unknown"], ["empty companion cell reads the empty leaf; operations readText; expected leaves clipboard::empty"], ["all values/host faults enumerated in this declaration"], ["Bun prototype test environment"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-101", "obsolete", "tests/native-can/migration/m33-prototype-companion-surfaces-a/history-101-clipboard-fail-closed.can", "731b92b2aa253470c147f65cd2b59d67e68d91c0d34ae48d935e251351d175b9", "m33history101/decide", ["history_101", "unknown"], ["denied destination and bad credential fail closed; operations readText; expected leaves companion::destination_denied, companion::unauthorized; no host contact or wire send on rejected input"], ["all values/host faults enumerated in this declaration"], ["Bun prototype test environment"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-102", "obsolete", "tests/native-can/migration/m33-prototype-companion-surfaces-a/history-102-clipboard-version-transport.can", "c0aba976d1a1ad10769b69914a9074e5be646aa1b2ff9a0f703a73f5c1476d5c", "m33history102/decide", ["history_102", "unknown"], ["version mismatch and transport failure map honestly; operations rea