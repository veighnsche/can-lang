/// Identity side of a complete-coverage claim against the m33rest manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m33rest_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "HISTORY-099", "m33history099/decide", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", "case m33history099/decide variant default root coverage run r1", "unretained-row", "HISTORY-099")]
    match call m33rest_slice("m33rest")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m33rest: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m33rest_slice.
fn spec::diagnostic[] validate_m33rest_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "HISTORY-099", "m33history099/decide", "default", "r1", ["Bun prototype test environment"], [], false, false) => ok [spec::diagnostic("migration::claim_m33rest_identity_problems", "case m33history099/decide variant default root coverage run r1", "unretained-row", "HISTORY-099")]
    match call claim_m33rest_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m33rest_manifest
    emits {}
    given
        str scope
    asserts
        m33rest: "m33rest" => ok campaign("z01-manifest/m33rest/2026-10-02", "z01-campaign/m33rest/attempt-1", ["HISTORY-099", "HISTORY-100", "HISTORY-101", "HISTORY-102", "HISTORY-103", "HISTORY-104", "HISTORY-105", "HISTORY-106", "HISTORY-107", "HISTORY-108", "HISTORY-109", "HISTORY-110", "HISTORY-111", "HISTORY-112", "HISTORY-113", "HISTORY-114", "HISTORY-115", "HISTORY-116", "HISTORY-117"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m33rest"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m33rest/2026-10-02", "z01-campaign/m33rest/attempt-1", ["HISTORY-099", "HISTORY-100", "HISTORY-101", "HISTORY-102", "HISTORY-103", "HISTORY-104", "HISTORY-105", "HISTORY-106", "HISTORY-107", "HISTORY-108", "HISTORY-109", "HISTORY-110", "HISTORY-111", "HISTORY-112", "HISTORY-113", "HISTORY-114", "HISTORY-115", "HISTORY-116", "HISTORY-117"])
