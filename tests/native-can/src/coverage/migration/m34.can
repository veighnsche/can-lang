package migration
    provides [m34_slice, claim_m34_identity_problems, validate_m34_claim, campaign_m34_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m34 (HISTORY-118..HISTORY-126).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 9 Prototype source and review records rows. No retained rows (obsolete/preserve only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for HISTORY-118..HISTORY-126. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m34_slice
    emits {}
    given
        str scope
    asserts
        m34: "m34" => ok [row_map("HISTORY-118", "preserve", "tests/native-can/migration/m34-prototype-source-and-review-re/history-118-review-manifest.can", "59b826a0e93fe9f53963e1d1e6529a2808ce335cf57299918a669a9315e5d682", "m34history118/decide", ["history_118", "unknown"], ["Records unadmitted prototype inventory, tier comparison and selection context."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-119", "preserve", "tests/native-can/migration/m34-prototype-source-and-review-re/history-119-x-r01-1.can", "a958dc820b7d0cdf834063b44b31235c78bad07287beb20c97ea13879efd930a", "m34history119/decide", ["history_119", "unknown"], ["Records unadmitted prototype inventory, tier comparison and selection context."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-120", "preserve", "tests/native-can/migration/m34-prototype-source-and-review-re/history-120-t1-sketches.can", "f21d3b675b7c3741abe94d2cff9090137545022ce41ec4a4898f4a1fa82133fc", "m34history120/decide", ["history_120", "unknown"], ["Records unadmitted prototype inventory, tier comparison and selection context."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-121", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-121-adapter-chart-widget.can", "a0c97d271b3c33a75c7b973397c102dbdb0232f2d4cd0b620c679e7a1c93b712", "m34history121/decide", ["history_121", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-122", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-122-adapter-clipboard.can", "877e5e94575a3bf163ceb334f64d8e7e8c1e824a3522a32b1a0b4638a8acdade", "m34history122/decide", ["history_122", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-123", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-123-adapter-storage.can", "8f0d71ea477096121a717ffe0d7002efe1a5886aa47f070b2809dfa8c0b11630", "m34history123/decide", ["history_123", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-124", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-124-companion-chart-widget.can", "a340e111900010b1b0d329b5feae4c85bff60d8d77d5b631cb82487374346ac2", "m34history124/decide", ["history_124", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-125", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-125-companion-clipboard.can", "80fe754d55f09363bf5e17923ca21eca1db548b7c5171f6945514c661cba8c6d", "m34history125/decide", ["history_125", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-126", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-126-companion-storage.can", "40fb802d4468167fe0a64a011b156fe5afd27889047046fc135f80d545f2a5e9", "m34history126/decide", ["history_126", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m34"
        false => ok []
        true => ok [row_map("HISTORY-118", "preserve", "tests/native-can/migration/m34-prototype-source-and-review-re/history-118-review-manifest.can", "59b826a0e93fe9f53963e1d1e6529a2808ce335cf57299918a669a9315e5d682", "m34history118/decide", ["history_118", "unknown"], ["Records unadmitted prototype inventory, tier comparison and selection context."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-119", "preserve", "tests/native-can/migration/m34-prototype-source-and-review-re/history-119-x-r01-1.can", "a958dc820b7d0cdf834063b44b31235c78bad07287beb20c97ea13879efd930a", "m34history119/decide", ["history_119", "unknown"], ["Records unadmitted prototype inventory, tier comparison and selection context."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-120", "preserve", "tests/native-can/migration/m34-prototype-source-and-review-re/history-120-t1-sketches.can", "f21d3b675b7c3741abe94d2cff9090137545022ce41ec4a4898f4a1fa82133fc", "m34history120/decide", ["history_120", "unknown"], ["Records unadmitted prototype inventory, tier comparison and selection context."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-121", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-121-adapter-chart-widget.can", "a0c97d271b3c33a75c7b973397c102dbdb0232f2d4cd0b620c679e7a1c93b712", "m34history121/decide", ["history_121", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-122", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-122-adapter-clipboard.can", "877e5e94575a3bf163ceb334f64d8e7e8c1e824a3522a32b1a0b4638a8acdade", "m34history122/decide", ["history_122", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-123", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-123-adapter-storage.can", "8f0d71ea477096121a717ffe0d7002efe1a5886aa47f070b2809dfa8c0b11630", "m34history123/decide", ["history_123", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-124", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-124-companion-chart-widget.can", "a340e111900010b1b0d329b5feae4c85bff60d8d77d5b631cb82487374346ac2", "m34history124/decide", ["history_124", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-125", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-125-companion-clipboard.can", "80fe754d55f09363bf5e17923ca21eca1db548b7c5171f6945514c661cba8c6d", "m34history125/decide", ["history_125", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-126", "obsolete", "tests/native-can/migration/m34-prototype-source-and-review-re/history-126-companion-storage.can", "40fb802d4468167fe0a64a011b156fe5afd27889047046fc135f80d545f2a5e9", "m34history126/decide", ["history_126", "unknown"], ["Unadmitted adapter/companion prototype implementation exercised by associated Bun test declarations; must not be mistaken for production Can coverage."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m34 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m34_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m34_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "HISTORY-118", "m34history118/decide", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m34_identity_problems", "case m34history118/decide variant default root coverage run r1", "unretained-row", "HISTORY-118")]
    match call m34_slice("m34")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m34_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m34: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m34_slice.
fn spec::diagnostic[] validate_m34_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m34_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "HISTORY-118", "m34history118/decide", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m34_identity_problems", "case m34history118/decide variant default root coverage run r1", "unretained-row", "HISTORY-118")]
    match call claim_m34_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m34_manifest
    emits {}
    given
        str scope
    asserts
        m34: "m34" => ok campaign("z01-manifest/m34/2026-10-02", "z01-campaign/m34/attempt-1", ["HISTORY-118", "HISTORY-119", "HISTORY-120", "HISTORY-121", "HISTORY-122", "HISTORY-123", "HISTORY-124", "HISTORY-125", "HISTORY-126"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m34"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m34/2026-10-02", "z01-campaign/m34/attempt-1", ["HISTORY-118", "HISTORY-119", "HISTORY-120", "HISTORY-121", "HISTORY-122", "HISTORY-123", "HISTORY-124", "HISTORY-125", "HISTORY-126"])
