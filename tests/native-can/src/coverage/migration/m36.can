43829b42dc13e6a0c43d450f2dbb139caa9a69a19d50", "m36history140/decide", ["history_140", "unknown"], ["near baseline Can source is a comparison subject for authoring-policy baseline/reference leg."], ["near", "baseline"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-141", "retain-fixture", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-141-near-reference.can", "11ba4c6b943e30a5e58aca5a7438a0612317e66921c006a380faae8fca5be03f", "m36history141/decide", ["history_141", "unknown"], ["near reference Can source is a comparison subject for authoring-policy baseline/reference leg."], ["near", "reference"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-142", "preserve", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-142-x-r02-1.can", "ba856cdc4598538f923a5daeedb45fed757966e88eb8033e5bd73c5a253cd9cc", "m36history142/decide", ["history_142", "unknown"], ["Historical browser-control experiment records checker/build observations; it does not supply live browser matrix evidence."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m36"
        false => ok []
        true => ok [row_map("HISTORY-132", "preserve", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-132-registry-readme.can", "7d491078ebf5c30ad9bba9971cad1dacc7d212bdf2971b4b36148e304ad80e84", "m36history132/decide", ["history_132", "unknown"], ["Registered authoring-policy comparison inputs and recorded baseline/reference evidence; agent trials explicitly remain unrun."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-133", "preserve", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-133-registry-json.can", "5abe3d35e67f925853751159feaf5833cc911b31d2e55e29437b1b77b617f3d8", "m36history133/decide", ["history_133", "unknown"], ["Registered authoring-policy comparison inputs and recorded baseline/reference evidence; agent trials explicitly remain unrun."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-134", "preserve", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-134-x-r08-comparison.can", "c5b189426de17749438f5caa7ce0b4d8fd595df00f28cdbf3c9367831ec1b9ae", "m36history134/decide", ["history_134", "unknown"], ["Registered authoring-policy comparison inputs and recorded baseline/reference evidence; agent trials explicitly remain unrun."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-135", "preserve", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-135-candidates-readme.can", "9651ee094ee50380044c5d7aee4b4ce5a4f6127f830c80c1ed082e564f42e244", "m36history135/decide", ["history_135", "unknown"], ["Registered authoring-policy comparison inputs and recorded baseline/reference evidence; agent trials explicitly remain unrun."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-136", "retain-fixture", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-136-boolean-baseline.can", "e1398d03bf4bfd5c1984169ca21aa61d0c14f844ed271b4f0c90a599a1ee8f7f", "m36history136/decide", ["history_136", "unknown"], ["boolean baseline Can source is a comparison subject for authoring-policy baseline/reference leg."], ["boolean", "baseline"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-137", "retain-fixture", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-137-boolean-reference.can", "8c01bb9262f779ec0db3051848b1c3f5af1fd21936bfb28881a0d55218ba4d35", "m36history137/decide", ["history_137", "unknown"], ["boolean reference Can source is a comparison subject for authoring-policy baseline/reference leg."], ["boolean", "reference"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-138", "retain-fixture", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-138-locals-baseline.can", "3591d0718d7c97b249c1f3a41f1450f4c6155f783a2ac64f6bf5fa14ff74702a", "m36history138/decide", ["history_138", "unknown"], ["locals baseline Can source is a comparison subject for authoring-policy baseline/reference leg."], ["locals", "baseline"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-139", "retain-fixture", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-139-locals-reference.can", "9917796202e411970b690ad7947156742467bab78bcd1ceb4dc5505f403e26fe", "m36history139/decide", ["history_139", "unknown"], ["locals reference Can source is a comparison subject for authoring-policy baseline/reference leg."], ["locals", "reference"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-140", "retain-fixture", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-140-near-baseline.can", "46e74834ceed2958a08a43829b42dc13e6a0c43d450f2dbb139caa9a69a19d50", "m36history140/decide", ["history_140", "unknown"], ["near baseline Can source is a comparison subject for authoring-policy baseline/reference leg."], ["near", "baseline"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-141", "retain-fixture", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-141-near-reference.can", "11ba4c6b943e30a5e58aca5a7438a0612317e66921c006a380faae8fca5be03f", "m36history141/decide", ["history_141", "unknown"], ["near reference Can source is a comparison subject for authoring-policy baseline/reference leg."], ["near", "reference"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("HISTORY-142", "preserve", "tests/native-can/migration/m36-authoring-policy-comparison-re/history-142-x-r02-1.can", "ba856cdc4598538f923a5daeedb45fed757966e88eb8033e5bd73c5a253cd9cc", "m36history142/decide", ["history_142", "unknown"], ["Historical browser-control experiment records checker/build observations; it does not supply live browser matrix evidence."], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m36 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m36_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m36_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "HISTORY-132", "m36history132/decide", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m36_identity_problems", "case m36history132/decide variant default root coverage run r1", "unretained-row", "HISTORY-132")]
    match call m36_slice("m36")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m36_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m36: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m36_slice.
fn spec::diagnostic[] validate_m36_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m36_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "HISTORY-132", "m36history132/decide", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m36_identity_problems", "case m36history132/decide variant default root coverage run r1", "unretained-row", "HISTORY-132")]
    match call claim_m36_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m36_manifest
    emits {}
    given
        str scope
    asserts
        m36: "m36" => ok campaign("z01-manifest/m36/2026-10-02", "z01-campaign/m36/attempt-1", ["HISTORY-132", "HISTORY-133", "HISTORY-134", "HISTORY-135", "HISTORY-136", "HISTORY-137", "HISTORY-138", "HISTORY-139", "HISTORY-140", "HISTORY-141", "HISTORY-142"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m36"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m36/2026-10-02", "z01-campaign/m36/attempt-1", ["HISTORY-132", "HISTORY-133", "HISTORY-134", "HISTORY-135", "HISTORY-136", "HISTORY-137", "HISTORY-138", "HISTORY-139", "HISTORY-140", "HISTORY-141", "HISTORY-142"])
