package migration
    provides [m41_slice, claim_m41_identity_problems, validate_m41_claim, campaign_m41_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m41 (LIFE-012..LIFE-015).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 4 Linux, S3 and UP23 verdict rows. Mixed dispositions (missing/retained): claims against unretained rows report unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for LIFE-012..LIFE-015. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m41_slice
    emits {}
    given
        str scope
    asserts
        m41: "m41" => ok [row_map("LIFE-012", "retained", "tests/native-can/migration/m41-linux-s3-and-up23-verdict/life-012-base-semantics.can", "ca1cfe223c47475152e1463a3d25df3576a770305042b9373f3ef37c885ebdc3", "life/installed-smoke-base", ["build-call", "release-call", "install-call", "selection-call", "build-tag", "wrong-selection-note", "canlc-leaf", "runtime-cmd", "runtime-status-note", "identity-field-bun", "identity-field-revision", "identity-field-platform", "identity-field-architecture", "identity-field-executable", "want-bun", "want-revision", "want-arch", "identity-note", "revision-note", "outside-note", "install-step-count", "identity-field-count", "pinned-value-count"], ["Linux build/release/install selection and pinned runtime identity from actual installed executable", "Offline qualification APIs/behaviors, negative controls and glibc evidence", "Installed process/files/crypto/SQLite examples assert and run; SQLite build identity stable"], ["process/files/crypto match+mismatch/SQLite", "native qualification when python present in old harness"], ["linux/amd64; CAN_BUN_ARCHIVE", "network denied container; python3 currently makes native leg optional"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-012", "retained", "tests/native-can/migration/m41-linux-s3-and-up23-verdict/life-012-roots-green.can", "aacfc4592156410ba5cef29025da0c11643dd85ae44386ae8b14058450baf344", "life/installed-smoke-roots", ["qualify-prog", "qualify-skip-note", "qualify-report-name", "qualify-script", "qualify-flag-archive", "qualify-flag-report", "qualify-flag-target", "qualify-flag-net", "qualify-target-file", "qualify-net-note", "report-field-passed", "report-field-target", "report-field-caps", "report-field-behaviors", "report-field-execution", "report-field-failures", "qualify-target-id", "qualify-not-passed-note", "qualify-missing-api-note", "qualify-failing-probe-note", "qualify-negative-field", "qualify-glibc-field", "qualify-lacks-note", "qua