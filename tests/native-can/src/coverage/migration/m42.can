package migration
    provides [m42_slice, claim_m42_identity_problems, validate_m42_claim, campaign_m42_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m42 (LIFE-025..LIFE-026).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 2 Webhook and S3 independent setup rows. Multi-case rows: one row_map per (row, case) pair; claims resolve through row_case_index; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for LIFE-025..LIFE-026. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m42_slice
    emits {}
    given
        str scope
    asserts
        m42: "m42" => ok [row_map("LIFE-025", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-025-base-semantics.can", "228efc3091ed96a3233e416282b94fd34442a0fd8301ef97c70cbd1915bcc74c", "life/webhook-setup-schema", ["setup-mode-word", "schema-count-note", "table-prefix-guard", "guard-note", "db-missing-note", "schema-missing-note", "comment-marker", "tables-key", "statement-separator", "schema-statement-count", "mode-arg-index", "db-arg-index", "schema-arg-index"], ["Five-table webhook schema setup validation", "Ordered ledger/outbox/attempt/dead-letter/nonce observations with large integers preserved"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-025", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-025-roots-green.can", "0e3d33b0a735d1dce6135b5f639259d4ea0483c62054d08dc73624de8f8fae09", "life/webhook-inspect-queries", ["inspect-mode-word", "ledger-query", "outbox-query", "attempt-query", "dead-query", "nonce-query", "order-delivery-key", "order-attempt-key", "order-nonce-key", "inspect-query-count", "ledger-column-count", "outbox-column-count", "attempt-column-count", "dead-column-count", "nonce-column-count", "observed-table-count"], ["Five-table webhook schema setup validation", "Ordered ledger/outbox/attempt/dead-letter/nonce observations with large integers preserved"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-025", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-025-run-shape.can", "fd1ad62d664f8c318540781c76602dab6583c10ff8e16ec840da16820e5d4d32", "life/webhook-driver-shape", ["adapter-name", "safe-integers-key", "bigint-kind", "to-string-call", "unknown-mode-note", "mode-arg-name", "db-arg-name", "schema-arg-name", "freeze-ledger-key", "freeze-outbox-key", "freeze-attempts-key", "freeze-dead-key", "freeze-nonces-key", "static-fn-name", "close-call", "run-mode-count", "freeze-key-count", "to-string-radix", "setup-template-sites", "inspect-template-sites"], ["Five-table webhook schema setup validation", "Ordered ledger/outbox/attempt/dead-letter/nonce observations with large integers preserved"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-026", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-026-base-semantics.can", "3edf20e98d125c58d43183d7e7bee2ed6fa09e2caf4825500b6e72a953e70d45", "life/s3-setup-seed", ["setup-command-word", "payload-file-name", "payload-content-kind", "staged-key-name", "s3-list-word", "s3-write-word", "s3-stat-word", "payload-read-word", "file-handle-word", "payload-md5", "payload-byte-size", "list-max-keys"], ["Independent reachable-bucket seed of 8192-byte binary payload", "Report host/bucket/key/size without credentials"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-026", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-026-roots-green.can", "6eb0e7cf7e260b04318435010d58d6b71a7bb423896dad1bbff2c08372a419e4", "life/s3-setup-report", ["report-host-key", "report-bucket-key", "report-size-key", "report-host-shape", "report-size-shape", "report-encode-call", "report-emit-call", "credential-guard-note", "credential-first-name", "credential-second-name", "report-field-count", "s3-call-count"], ["Independent reachable-bucket seed of 8192-byte binary payload", "Report host/bucket/key/size without credentials"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-026", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-026-run-shape.can", "89a55abdd445dea1d0cc81a6d1247fcd6cdd2db8aebf0eaf63b5134cd545c897", "life/s3-driver-shape", ["driver-file-name", "usage-note", "missing-note", "client-name", "client-source", "endpoint-env-name", "region-env-name", "bucket-env-name", "access-env-name", "secret-env-name", "argv-word", "command-arg-name", "payload-arg-name", "prefix-arg-name", "argv-index", "usage-exit-code", "env-name-count", "driver-arg-count"], ["Independent reachable-bucket seed of 8192-byte binary payload", "Report host/bucket/key/size without credentials"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m42"
        false => ok []
        true => ok [row_map("LIFE-025", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-025-base-semantics.can", "228efc3091ed96a3233e416282b94fd34442a0fd8301ef97c70cbd1915bcc74c", "life/webhook-setup-schema", ["setup-mode-word", "schema-count-note", "table-prefix-guard", "guard-note", "db-missing-note", "schema-missing-note", "comment-marker", "tables-key", "statement-separator", "schema-statement-count", "mode-arg-index", "db-arg-index", "schema-arg-index"], ["Five-table webhook schema setup validation", "Ordered ledger/outbox/attempt/dead-letter/nonce observations with large integers preserved"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-025", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-025-roots-green.can", "0e3d33b0a735d1dce6135b5f639259d4ea0483c62054d08dc73624de8f8fae09", "life/webhook-inspect-queries", ["inspect-mode-word", "ledger-query", "outbox-query", "attempt-query", "dead-query", "nonce-query", "order-delivery-key", "order-attempt-key", "order-nonce-key", "inspect-query-count", "ledger-column-count", "outbox-column-count", "attempt-column-count", "dead-column-count", "nonce-column-count", "observed-table-count"], ["Five-table webhook schema setup validation", "Ordered ledger/outbox/attempt/dead-letter/nonce observations with large integers preserved"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-025", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-025-run-shape.can", "fd1ad62d664f8c318540781c76602dab6583c10ff8e16ec840da16820e5d4d32", "life/webhook-driver-shape", ["adapter-name", "safe-integers-key", "bigint-kind", "to-string-call", "unknown-mode-note", "mode-arg-name", "db-arg-name", "schema-arg-name", "freeze-ledger-key", "freeze-outbox-key", "freeze-attempts-key", "freeze-dead-key", "freeze-nonces-key", "static-fn-name", "close-call", "run-mode-count", "freeze-key-count", "to-string-radix", "setup-template-sites", "inspect-template-sites"], ["Five-table webhook schema setup validation", "Ordered ledger/outbox/attempt/dead-letter/nonce observations with large integers preserved"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-026", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-026-base-semantics.can", "3edf20e98d125c58d43183d7e7bee2ed6fa09e2caf4825500b6e72a953e70d45", "life/s3-setup-seed", ["setup-command-word", "payload-file-name", "payload-content-kind", "staged-key-name", "s3-list-word", "s3-write-word", "s3-stat-word", "payload-read-word", "file-handle-word", "payload-md5", "payload-byte-size", "list-max-keys"], ["Independent reachable-bucket seed of 8192-byte binary payload", "Report host/bucket/key/size without credentials"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-026", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-026-roots-green.can", "6eb0e7cf7e260b04318435010d58d6b71a7bb423896dad1bbff2c08372a419e4", "life/s3-setup-report", ["report-host-key", "report-bucket-key", "report-size-key", "report-host-shape", "report-size-shape", "report-encode-call", "report-emit-call", "credential-guard-note", "credential-first-name", "credential-second-name", "report-field-count", "s3-call-count"], ["Independent reachable-bucket seed of 8192-byte binary payload", "Report host/bucket/key/size without credentials"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("LIFE-026", "retained", "tests/native-can/migration/m42-webhook-and-s3-independent-set/life-026-run-shape.can", "89a55abdd445dea1d0cc81a6d1247fcd6cdd2db8aebf0eaf63b5134cd545c897", "life/s3-driver-shape", ["driver-file-name", "usage-note", "missing-note", "client-name", "client-source", "endpoint-env-name", "region-env-name", "bucket-env-name", "access-env-name", "secret-env-name", "argv-word", "command-arg-name", "payload-arg-name", "prefix-arg-name", "argv-index", "usage-exit-code", "env-name-count", "driver-arg-count"], ["Independent reachable-bucket seed of 8192-byte binary payload", "Report host/bucket/key/size without credentials"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m42 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. delegates are checked both directions.
fn spec::diagnostic[] claim_m42_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case life/webhook-setup-schema variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "LIFE-025", "life/webhook-setup-schema-missing", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case life/webhook-setup-schema-missing variant default root coverage run r1", "unknown-row", "LIFE-025")]
        entry_drift: [job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "LIFE-025", "life/webhook-inspect-queries", "default", "r1", 1, "attempt", "passed", "full", 16, 16, "", "", -1)], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case life/webhook-setup-schema variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", [], [], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case life/webhook-setup-schema variant default root coverage run r1", "missing-engine", "LIFE-025")]
        unaccepted: [job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case life/webhook-setup-schema variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", ["bun-prototype-env"], ["DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case life/webhook-setup-schema variant default root coverage run r1", "extra-delegate", "LIFE-025")]
    match call m42_slice("m42")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m42_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m42: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m42_slice.
fn spec::diagnostic[] validate_m42_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 1, "attempt", "passed", "full", 13, 13, "", "", -1)], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m42_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 1, "attempt", "failed", "full", 0, 13, "", "", -1), job_entry("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", 3, "attempt", "passed", "full", 13, 13, "", "", -1)], claim("j1", "LIFE-025", "life/webhook-setup-schema", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case life/webhook-setup-schema variant default root coverage run r1", "cherry-picked-report", "j1")]
    match call claim_m42_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m42_manifest
    emits {}
    given
        str scope
    asserts
        m42: "m42" => ok campaign("z01-manifest/m42/2026-10-02", "z01-campaign/m42/attempt-1", ["LIFE-025", "LIFE-026"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m42"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m42/2026-10-02", "z01-campaign/m42/attempt-1", ["LIFE-025", "LIFE-026"])
