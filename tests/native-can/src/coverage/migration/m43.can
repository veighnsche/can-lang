package migration
    provides [m43_slice, claim_m43_identity_problems, validate_m43_claim, campaign_m43_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m43 (EDGE-001..EDGE-005).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 5 Native and Linux external consumers rows. Mixed dispositions (blocked/retained): claims against unretained rows report unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for EDGE-001..EDGE-005. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m43_slice
    emits {}
    given
        str scope
    asserts
        m43: "m43" => ok [row_map("EDGE-001", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-001.json", "575e9eaeb27a229fbce5a990c18b1aaeb528a647cafb2d0c350b3c37b8866124", "", [], ["Target OS/architecture/minimum version and glibc, archive size/hash and extracted runtime digest", "No ambient configuration/install/PATH runtime; offline isolation verified, never assumed", "Native API/behavior and deliberate rejection results combined into provenance-bound report"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-002", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-002.json", "a066bc88d5e6ba73ea01f164f4f46da13b3669a719d05f21699c42397b7d9d19", "", [], ["Installed Linux runtime identity, offline native qualification, real process/files/crypto/SQLite example outputs and build determinism"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-003", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-003.json", "1df5d89c49f2f3dd0d75b4e040325cd4e212d4e485f4c65c53153ef15873e706", "", [], ["Installed sidecar and PostgreSQL-17 row/version roundtrip expectations"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-004", "retained", "tests/native-can/migration/m43-native-and-linux-external-cons/edge-004-base-semantics.can", "3b8851fde932885e4963254cfd5a6307e1c1a0c622cbb22699e9cab76d58a2fb", "edge/pg-driver-envelope", ["driver-tag", "product-name", "roundtrip-verbs", "env-source", "bun-env", "import-word", "sql-name", "bun-name", "helper-name", "template-word", "freeze-word", "new-pool", "guard-word", "disposable-word", "sidecar-word", "image-pin", "header-comment-count", "env-name-count", "sql-call-count"], ["Direct native create/insert/select/drop, PostgreSQL version, row count/content and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-004", "retained", "tests/native-can/migration/m43-native-and-linux-external-cons/edge-004-roots-green.can", "b25ac11cfaab8d6793c6c7e7cee59216d94c3046188f4f9e990f6c8f001f35c9", "edge/pg-roundtrip-statements", ["show-stmt", "version-field", "prefix-check", "major-want", "version-guard", "drop-probe", "create-prefix", "not-null-suffix", "table-name", "insert-stmt", "select-stmt", "id-body-pair", "body-want", "missing-word", "drop-stmt", "id-want", "row-count-want", "drop-count", "table-mention-count"], ["Direct native create/insert/select/drop, PostgreSQL version, row count/content and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-004", "retained", "tests/native-can/migration/m43-native-and-linux-external-cons/edge-004-run-shape.can", "ba3bf315b9cc7d55805ffae2839d31a061ce3651989db62d1b2d52cd7ee2e555", "edge/pg-report-closure", ["report-call", "report-keys", "id-string", "rows-word", "rows-length", "close-call", "finally-word", "try-open", "await-word", "catch-word", "error-call", "exit-call", "error-name", "exit-code-want", "await-count", "error-count", "console-count"], ["Direct native create/insert/select/drop, PostgreSQL version, row count/content and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-005", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-005.json", "9bf70b742ab92a1b90e2e9af5c711d68550f3a40565959c35b523f74aa8fa3bd", "", [], ["Native insertion/readback of the smoke row and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m43"
        false => ok []
        true => ok [row_map("EDGE-001", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-001.json", "575e9eaeb27a229fbce5a990c18b1aaeb528a647cafb2d0c350b3c37b8866124", "", [], ["Target OS/architecture/minimum version and glibc, archive size/hash and extracted runtime digest", "No ambient configuration/install/PATH runtime; offline isolation verified, never assumed", "Native API/behavior and deliberate rejection results combined into provenance-bound report"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-002", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-002.json", "a066bc88d5e6ba73ea01f164f4f46da13b3669a719d05f21699c42397b7d9d19", "", [], ["Installed Linux runtime identity, offline native qualification, real process/files/crypto/SQLite example outputs and build determinism"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-003", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-003.json", "1df5d89c49f2f3dd0d75b4e040325cd4e212d4e485f4c65c53153ef15873e706", "", [], ["Installed sidecar and PostgreSQL-17 row/version roundtrip expectations"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-004", "retained", "tests/native-can/migration/m43-native-and-linux-external-cons/edge-004-base-semantics.can", "3b8851fde932885e4963254cfd5a6307e1c1a0c622cbb22699e9cab76d58a2fb", "edge/pg-driver-envelope", ["driver-tag", "product-name", "roundtrip-verbs", "env-source", "bun-env", "import-word", "sql-name", "bun-name", "helper-name", "template-word", "freeze-word", "new-pool", "guard-word", "disposable-word", "sidecar-word", "image-pin", "header-comment-count", "env-name-count", "sql-call-count"], ["Direct native create/insert/select/drop, PostgreSQL version, row count/content and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-004", "retained", "tests/native-can/migration/m43-native-and-linux-external-cons/edge-004-roots-green.can", "b25ac11cfaab8d6793c6c7e7cee59216d94c3046188f4f9e990f6c8f001f35c9", "edge/pg-roundtrip-statements", ["show-stmt", "version-field", "prefix-check", "major-want", "version-guard", "drop-probe", "create-prefix", "not-null-suffix", "table-name", "insert-stmt", "select-stmt", "id-body-pair", "body-want", "missing-word", "drop-stmt", "id-want", "row-count-want", "drop-count", "table-mention-count"], ["Direct native create/insert/select/drop, PostgreSQL version, row count/content and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-004", "retained", "tests/native-can/migration/m43-native-and-linux-external-cons/edge-004-run-shape.can", "ba3bf315b9cc7d55805ffae2839d31a061ce3651989db62d1b2d52cd7ee2e555", "edge/pg-report-closure", ["report-call", "report-keys", "id-string", "rows-word", "rows-length", "close-call", "finally-word", "try-open", "await-word", "catch-word", "error-call", "exit-call", "error-name", "exit-code-want", "await-count", "error-count", "console-count"], ["Direct native create/insert/select/drop, PostgreSQL version, row count/content and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-005", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M43-EDGE-005.json", "9bf70b742ab92a1b90e2e9af5c711d68550f3a40565959c35b523f74aa8fa3bd", "", [], ["Native insertion/readback of the smoke row and pool closure"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m43 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m43_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unregistered: [], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case edge/pg-driver-envelope variant default root coverage run r1", "unregistered-job", "j1")]
        case_drift: [], claim("j1", "EDGE-004", "edge/pg-driver-envelope-missing", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case edge/pg-driver-envelope-missing variant default root coverage run r1", "unknown-row", "EDGE-004")]
        entry_drift: [job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "EDGE-004", "edge/pg-roundtrip-statements", "default", "r1", 1, "attempt", "passed", "full", 19, 19, "", "", -1)], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case edge/pg-driver-envelope variant default root coverage run r1", "incompatible-identity", "j1")]
        missing_engine: [job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", [], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case edge/pg-driver-envelope variant default root coverage run r1", "missing-engine", "EDGE-004")]
        unaccepted: [job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 0, "register", "registered", "full", 0, 0, "s1", "", -1)], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case edge/pg-driver-envelope variant default root coverage run r1", "unaccepted-reference", "j1")]
        reverse_extra: [job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1)], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", ["bun-prototype-env"], ["DELEGATE-X"], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case edge/pg-driver-envelope variant default root coverage run r1", "extra-delegate", "EDGE-004")]
        unretained_hit: [], claim("j1", "EDGE-001", "", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case  variant default root coverage run r1", "unretained-row", "EDGE-001")]
    match call m43_slice("m43")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m43_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m43: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m43_slice.
fn spec::diagnostic[] validate_m43_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        clean: [job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 1, "attempt", "passed", "full", 19, 19, "", "", -1)], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", ["bun-prototype-env"], [], false, false) => ok []
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        cherry_full: [job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 0, "register", "registered", "full", 0, 0, "", "", -1), job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 1, "attempt", "failed", "full", 0, 19, "", "", -1), job_entry("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", 3, "attempt", "passed", "full", 19, 19, "", "", -1)], claim("j1", "EDGE-004", "edge/pg-driver-envelope", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_credit_problems", "case edge/pg-driver-envelope variant default root coverage run r1", "cherry-picked-report", "j1")]
        unretained_hit: [], claim("j1", "EDGE-001", "", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m43_identity_problems", "case  variant default root coverage run r1", "unretained-row", "EDGE-001")]
    match call claim_m43_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m43_manifest
    emits {}
    given
        str scope
    asserts
        m43: "m43" => ok campaign("z01-manifest/m43/2026-10-02", "z01-campaign/m43/attempt-1", ["EDGE-001", "EDGE-002", "EDGE-003", "EDGE-004", "EDGE-005"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m43"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m43/2026-10-02", "z01-campaign/m43/attempt-1", ["EDGE-001", "EDGE-002", "EDGE-003", "EDGE-004", "EDGE-005"])
