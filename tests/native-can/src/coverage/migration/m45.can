package migration
    provides [m45_slice, claim_m45_identity_problems, validate_m45_claim, campaign_m45_manifest]
    uses [coverage, reducer, registry, spec, text]

/// Z01 migration-coverage reconciliation, slice m45 (EDGE-014..EDGE-016).
/// Per-row facet, variant, environment and delegated-declaration mappings
/// for 3 Operator documentation callers rows. No retained rows (blocked/missing only): claims report unknown-row or unretained-row; the shared credit, campaign
/// and obligation machinery is reused unchanged from the pilot. Source
/// hashes are the reviewed sha256 bindings of the bound files; a bound-file
/// edit invalidates its binding until re-reviewed. Delegates are checked
/// both directions. Provisional until P23: no execution credit is claimed.

// (Row data lines are long by construction: each row_map carries the full
// reviewed binding for EDGE-014..EDGE-016. Generated from the row evidence
// case_check_ids plus sha256 of the bound files.)
fn row_map[] m45_slice
    emits {}
    given
        str scope
    asserts
        m45: "m45" => ok [row_map("EDGE-014", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M45-EDGE-014.json", "ce7945eeb87a1a8f9bbdc019de69aa53cbff19e45fce37b59806ba9074cdbc92", "", [], ["Documented entrypoints for native and integration qualification"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-015", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M45-EDGE-015.json", "fa66cb404fb0782be1f8e573695b48d8aa084eb0dcf28b5a6a5f4424b9d09166", "", [], ["Linux smoke/PostgreSQL qualification reproductions"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-016", "missing", "", "", "", [], ["External callers can install/find shared browser machinery"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
        other: "nope" => ok []
    match scope is "m45"
        false => ok []
        true => ok [row_map("EDGE-014", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M45-EDGE-014.json", "ce7945eeb87a1a8f9bbdc019de69aa53cbff19e45fce37b59806ba9074cdbc92", "", [], ["Documented entrypoints for native and integration qualification"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-015", "blocked", "docs/implementation/native-can-tests-plan-2026-09-30/evidence/M45-EDGE-015.json", "fa66cb404fb0782be1f8e573695b48d8aa084eb0dcf28b5a6a5f4424b9d09166", "", [], ["Linux smoke/PostgreSQL qualification reproductions"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], ""), row_map("EDGE-016", "missing", "", "", "", [], ["External callers can install/find shared browser machinery"], ["default"], ["bun-prototype-env"], [], ["qualified-report", "n-receipt", "cleanup-receipt"], "")]
/// Identity side of a complete-coverage claim against the m45 manifest:
/// same first-only contract as the pilot claim_identity_problems, resolved
/// by (row, case) through row_case_index. claims against blocked, missing or obsolete rows report unretained-row, and delegates are checked both directions.
fn spec::diagnostic[] claim_m45_identity_problems
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m45_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "EDGE-014", "", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m45_identity_problems", "case  variant default root coverage run r1", "unretained-row", "EDGE-014")]
    match call m45_slice("m45")
        ok row_map[] rows => match call row_case_index(rows, c.row_id, c.case_id, 0)
            ok int at => match at is -1
                true => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unknown-row", c.row_id)]
                false => match call row_retained(rows, at)
                    ok bool kept => match kept
                        false => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unretained-row", c.row_id)]
                        true => match call job_registered(entries, c.job_id, 0)
                            ok bool reg => match reg
                                false => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unregistered-job", c.job_id)]
                                true => match call identity_compatible(entries, c, 0)
                                    ok bool same => match same
                                        false => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "incompatible-identity", c.job_id)]
                                        true => match call str_subset(rows[at].environments, c.engines, 0)
                                            ok bool engined => match engined
                                                false => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "missing-engine", c.row_id)]
                                                true => match call str_subset(rows[at].delegates, c.delegates, 0)
                                                    ok bool delegated => match delegated
                                                        false => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "undeclared-delegate", c.row_id)]
                                                        true => match call str_subset(c.delegates, rows[at].delegates, 0)
                                                            ok bool declared => match declared
                                                                false => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "extra-delegate", c.row_id)]
                                                                true => match call references_accepted(entries, c, 0)
                                                                    ok bool cited => match cited
                                                                        false => ok [spec::diagnostic("migration::claim_m45_identity_problems", call spec::reproduction_selector(call spec::context_for(c.case_id, c.variant_id, "", c.run_id), "coverage"), "unaccepted-reference", c.job_id)]
                                                                        true => ok []
/// Validate one complete-coverage claim against m45: identity first,
/// then the shared credit side. Mirrors validate_claim resolved
/// against m45_slice.
fn spec::diagnostic[] validate_m45_claim
    emits {}
    given
        job_entry[] entries
        claim c
    asserts
        unknown_row: [], claim("j1", "HISTORY-999", "c", "v", "r", [], [], false, false) => ok [spec::diagnostic("migration::claim_m45_identity_problems", "case c variant v root coverage run r", "unknown-row", "HISTORY-999")]
        unretained_hit: [], claim("j1", "EDGE-014", "", "default", "r1", ["bun-prototype-env"], [], false, false) => ok [spec::diagnostic("migration::claim_m45_identity_problems", "case  variant default root coverage run r1", "unretained-row", "EDGE-014")]
    match call claim_m45_identity_problems(entries, c)
        ok spec::diagnostic[] shaped => match shaped.length is 0
            false => ok shaped
            true => relay call claim_credit_problems(entries, c, shaped)
/// Reviewed campaign manifest for the slice: fixed IDs plus every
/// declared row. ID shapes are exact reviewed strings, not patterns.
fn campaign campaign_m45_manifest
    emits {}
    given
        str scope
    asserts
        m45: "m45" => ok campaign("z01-manifest/m45/2026-10-02", "z01-campaign/m45/attempt-1", ["EDGE-014", "EDGE-015", "EDGE-016"])
        other: "nope" => ok campaign("", "", [])
    match scope is "m45"
        false => ok campaign("", "", [])
        true => ok campaign("z01-manifest/m45/2026-10-02", "z01-campaign/m45/attempt-1", ["EDGE-014", "EDGE-015", "EDGE-016"])
