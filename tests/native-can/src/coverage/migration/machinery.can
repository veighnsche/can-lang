package migration
    provides [row_case_index, row_retained]
    uses [coverage, reducer, registry, spec, text]

/// Z01 shared slice machinery: (row, case) resolution for multi-case
/// rows. The pilot (m33chart.can) resolves claims by row_id alone,
/// which fits single-case rows; rows with several ported cases need
/// the pair, since duplicate row_ids would otherwise all resolve to
/// the first case entry. Slice claim fns in later files resolve
/// through row_case_index; the pilot fns keep row_index untouched so
/// the reviewed pilot evidence stays valid.

/// Position of a (row id, case id) pair at or after an index, or -1
/// when absent. Multi-case rows list one row_map per case; the pair
/// key keeps each case addressable.
fn int row_case_index
    emits {}
    given
        row_map[] rows
        str row_id
        str case_id
        int from
    asserts
        hit: [row_map("HISTORY-061", "retained", "s", "h", "c1", ["x"], ["f"], ["v"], ["e"], [], ["qr"], ""), row_map("HISTORY-061", "retained", "s", "h", "c2", ["y"], ["f"], ["v"], ["e"], [], ["qr"], "")], "HISTORY-061", "c2", 0 => ok 1
        first: [row_map("HISTORY-061", "retained", "s", "h", "c1", ["x"], ["f"], ["v"], ["e"], [], ["qr"], ""), row_map("HISTORY-061", "retained", "s", "h", "c2", ["y"], ["f"], ["v"], ["e"], [], ["qr"], "")], "HISTORY-061", "c1", 0 => ok 0
        case_miss: [row_map("HISTORY-061", "retained", "s", "h", "c1", ["x"], ["f"], ["v"], ["e"], [], ["qr"], "")], "HISTORY-061", "c9", 0 => ok -1
        row_miss: [row_map("HISTORY-061", "retained", "s", "h", "c1", ["x"], ["f"], ["v"], ["e"], [], ["qr"], "")], "HISTORY-099", "c1", 0 => ok -1
        offset: [row_map("HISTORY-061", "retained", "s", "h", "c1", ["x"], ["f"], ["v"], ["e"], [], ["qr"], "")], "HISTORY-061", "c1", 1 => ok -1
    match from >= rows.length
        true => ok -1
        false => match rows[from].row_id is row_id and rows[from].case_id is case_id
            false => relay call row_case_index(rows, row_id, case_id, from + 1)
            true => ok from
/// Whether the row at a resolved index is retained: coverage claims
/// against blocked, missing, obsolete, preserve or retain-fixture
/// rows are categorically invalid, so slice claim fns gate on this
/// right after (row, case) resolution and report unretained-row
/// otherwise.
fn bool row_retained
    emits {}
    given
        row_map[] rows
        int at
    asserts
        kept: [row_map("HISTORY-061", "retained", "s", "h", "c1", ["x"], ["f"], ["v"], ["e"], [], ["qr"], "")], 0 => ok true
        obsolete: [row_map("HISTORY-099", "obsolete", "s", "h", "c9", ["x"], ["f"], ["v"], ["e"], [], ["qr"], "")], 0 => ok false
        blocked: [row_map("EDGE-001", "blocked", "s", "h", "", [], ["f"], ["v"], ["e"], [], ["qr"], "")], 0 => ok false
        preserved: [row_map("HISTORY-118", "preserve", "s", "h", "c8", ["x"], ["f"], ["v"], ["e"], [], ["qr"], "")], 0 => ok false
        fixture: [row_map("HISTORY-141", "retain-fixture", "s", "h", "c1", ["x"], ["f"], ["v"], ["e"], [], ["qr"], "")], 0 => ok false
    match rows[at].disposition is "retained"
        true => ok true
        false => ok false
