package protocol
    provides [frame, request_view, result_view, encode_frame, decode_frame, decode_request, decode_result]
    uses [bytes, checks, codec, number, text]

/// Native Can mirror of the P02 frame + envelope codec. Byte layout, check
/// order and failure reasons follow tools/native-test-owner/protocol/codec:
/// frames carry magic NT, version 1, kind 1..3, big-endian sequence and
/// length; envelopes validate identities, digests, clocks and outcome/kind
/// agreement. Every failure surfaces as checks::failed with a reason that
/// contains the Go wantError substring for its vector.

/// One decoded wire frame: kind 1 request, 2 reply or 3 event.
record frame
    int kind
    int seq
    int[] payload
/// Validated request envelope: the deadline stays flat (clock + ms).
record request_view
    str schema_version
    str run_id
    str operation_id
    str owner_grant
    str operation
    str arguments_digest
    str clock
    int ms
/// Validated result envelope: facts/partial survive as entry counts only.
record result_view
    str schema_version
    str run_id
    str operation_id
    str outcome
    str kind
    int facts_len
    int partial_len
/// Big-endian u32 at a byte index. Callers guarantee index + 4 fits.
fn int u32_at
    emits {}
    given
        int[] bytes
        int index
    asserts
        sample: [0, 0, 0, 246], 0 => ok 246
        offset: [9, 0, 0, 0, 1], 1 => ok 1
    ok bytes[index] * 16777216 + bytes[index + 1] * 65536 + bytes[index + 2] * 256 + bytes[index + 3]
/// Big-endian u32 encoding. Negative values fail instead of wrapping.
fn int[] u32_bytes
    emits {checks::failed, number::zero_divisor}
    given
        int value
    asserts
        zero: 0 => ok [0, 0, 0, 0]
        one: 1 => ok [0, 0, 0, 1]
        sample: 16909060 => ok [1, 2, 3, 4]
        max: 4294967295 => ok [255, 255, 255, 255]
        negative: -1 => checks::failed{"u32 value is negative"}
    match call checks::require(value >= 0, "u32 value is negative")
        checks::failed
        ok => match call number::divmod(value, 16777216)
            number::zero_divisor
            ok number::division top => match call number::divmod(top.remainder, 65536)
                number::zero_divisor
                ok number::division mid => match call number::divmod(mid.remainder, 256)
                    number::zero_divisor
                    ok number::division low => ok [top.quotient, mid.quotient, low.quotient, low.remainder]
/// Concatenate a list of byte lists.
fn int[] concat_all
    emits {}
    given
        int[][] lists
    asserts
        sample: [[1], [2, 3]] => ok [1, 2, 3]
        empty: [] => ok []
    match lists.length is 0
        true => ok []
        false => ok call lists[0].concat(call concat_all(call lists.slice(1, lists.length)))
/// Decode hex text to bytes. Test vectors arrive as hex; the runner works
/// in byte lists, so this stays a test-side helper.
fn int[] frame_bytes
    emits {checks::failed}
    given
        str hex_text
    asserts
        sample: "4e54" => ok [78, 84]
        empty: "" => ok []
        bad: "zz" => checks::failed{"frame hex is not valid hex"}
    match call bytes::decode_hex(hex_text)
        codec::invalid_data => relay call fail_ints("frame hex is not valid hex")
        ok bytes::buffer raw => ok call bytes::to_ints(raw)
/// Unconditional str failure. The ok arm is unreachable by construction:
/// require(false, ...) never yields ok, so fixtures pin the reason exactly.
fn str fail_str
    emits {checks::failed}
    given
        str reason
    asserts
        always: "gone" => checks::failed{"gone"}
    match call checks::require(false, reason)
        checks::failed
        ok => ok "unreachable"
/// Unconditional int failure; see fail_str for the dead ok arm.
fn int fail_int
    emits {checks::failed}
    given
        str reason
    asserts
        always: "gone" => checks::failed{"gone"}
    match call checks::require(false, reason)
        checks::failed
        ok => ok -1
/// Unconditional int[] failure; see fail_str for the dead ok arm.
fn int[] fail_ints
    emits {checks::failed}
    given
        str reason
    asserts
        always: "gone" => checks::failed{"gone"}
    match call checks::require(false, reason)
        checks::failed
        ok => ok []
/// Unconditional json_object failure; see fail_str for the dead ok arm.
fn codec::json_object fail_obj
    emits {checks::failed}
    given
        str reason
    asserts
        always: "gone" => checks::failed{"gone"}
    match call checks::require(false, reason)
        checks::failed
        ok => ok codec::json_object([])
/// Index of the named member at or after index, or -1 when absent.
fn int find_at
    emits {}
    given
        codec::json_member[] members
        str name
        int index
    asserts
        first: [codec::json_member("a", codec::json_int(1))], "a", 0 => ok 0
        skip: [codec::json_member("a", codec::json_int(1)), codec::json_member("b", codec::json_int(2))], "b", 0 => ok 1
        missing: [codec::json_member("a", codec::json_int(1))], "z", 0 => ok -1
    match index >= members.length
        true => ok -1
        false => match members[index].name is name
            true => ok index
            false => match call find_at(members, name, index + 1)
                ok int found => ok found
/// True when the name appears in the list at or after index.
fn bool str_known
    emits {}
    given
        str[] names
        str name
        int index
    asserts
        hit: ["a", "b"], "b", 0 => ok true
        miss: ["a"], "z", 0 => ok false
    match index >= names.length
        true => ok false
        false => match names[index] is name
            true => ok true
            false => match call str_known(names, name, index + 1)
                ok bool rest => ok rest
/// Index of the first member whose name is not allowed, or -1 when the key
/// set is clean. Mirrors the Go unknown-field rejection.
fn int unknown_at
    emits {}
    given
        codec::json_member[] members
        str[] allowed
        int index
    asserts
        clean: [codec::json_member("a", codec::json_int(1))], ["a"], 0 => ok -1
        dirty: [codec::json_member("a", codec::json_int(1)), codec::json_member("x", codec::json_int(2))], ["a"], 0 => ok 1
    match index >= members.length
        true => ok -1
        false => match call str_known(allowed, members[index].name, 0)
            ok bool known => match known
                true => match call unknown_at(members, allowed, index + 1)
                    ok int rest => ok rest
                false => ok index
/// Narrow a JSON value to an object, failing with the reason otherwise.
fn codec::json_object narrowed_obj
    emits {checks::failed}
    given
        codec::json_value value
        str reason
    asserts
        object: codec::json_object([codec::json_member("a", codec::json_int(1))]), "no" => ok codec::json_object([codec::json_member("a", codec::json_int(1))])
        scalar: codec::json_int(5), "no" => checks::failed{"no"}
    match value
        codec::json_null => relay call fail_obj(reason)
        codec::json_bool => relay call fail_obj(reason)
        codec::json_int => relay call fail_obj(reason)
        codec::json_float => relay call fail_obj(reason)
        codec::json_string => relay call fail_obj(reason)
        codec::json_array => relay call fail_obj(reason)
        codec::json_object => ok value
/// Byte length of text, matching Go len() on multibyte input.
fn int byte_len
    emits {checks::failed}
    given
        str value
    asserts
        sample: "abc" => ok 3
        empty: "" => ok 0
    match call bytes::from_utf8(value)
        codec::invalid_data => relay call fail_int("text is not encodable")
        ok bytes::buffer raw => ok raw.length
/// True when the whole value matches the anchored pattern.
fn bool matches_pattern
    emits {text::invalid_regex, text::invalid_limit}
    given
        str value
        str pattern
    asserts
        id: "run-1", "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" => ok true
        id_bad: "bad id!", "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" => ok false
        digest: "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "^sha256:[0-9a-f]{64}$" => ok true
        digest_bad: "sha256:xyz", "^sha256:[0-9a-f]{64}$" => ok false
        outcome: "completed", "^(completed|rejected|failed|deadline|indeterminate)$" => ok true
        kind: "native-io", "^(ok|invalid-request|unsupported-capability|wrong-owner|stale-handle|closed-handle|not-found|permission|changed-input|kind-collision|resource-limit|native-io|transport-failure|unresolved-cleanup)$" => ok true
    match call text::compile_regex(pattern, "")
        text::invalid_regex
        ok text::regex re => match call text::matches(re, value, 1)
            text::invalid_limit
            ok text::regex_match[] hits => ok hits.length >= 1
/// Parse envelope bytes to a top-level object.
fn codec::json_object envelope_object
    emits {checks::failed}
    given
        int[] bytes
    asserts
        object: [123, 125] => ok codec::json_object([])
        scalar: [53] => checks::failed{"envelope must be an object"}
        garbage: [120] => checks::failed{"envelope is not valid json"}
    match call bytes::from_ints(bytes)
        codec::invalid_data => relay call fail_obj("payload bytes are out of range")
        ok bytes::buffer raw => match call codec::decode_json_value(raw)
            codec::invalid_data => relay call fail_obj("envelope is not valid json")
            ok codec::json_value value => match call narrowed_obj(value, "envelope must be an object")
                checks::failed
                ok codec::json_object top => ok top
/// Required string member: missing and mistyped members fail by name.
fn str get_str
    emits {checks::failed}
    given
        codec::json_member[] members
        str name
    asserts
        hit: [codec::json_member("a", codec::json_string("x"))], "a" => ok "x"
        missing: [codec::json_member("a", codec::json_string("x"))], "z" => checks::failed{"z is missing"}
        number: [codec::json_member("a", codec::json_int(1))], "a" => checks::failed{"a must be a string"}
    match call find_at(members, name, 0)
        ok int idx => match call checks::require(idx >= 0, name + " is missing")
            checks::failed
            ok => match call codec::encode_json_value(members[idx].value)
                codec::invalid_data => relay call fail_str(name + " is not encodable")
                ok bytes::buffer raw => match call codec::decode_json<str>(raw)
                    codec::invalid_data => relay call fail_str(name + " must be a string")
                    ok str found => ok found
/// Integer member with a default for absent keys; present values must be
/// integers. Covers deadline ms, where Go defaults a missing ms to zero.
fn int get_int_default
    emits {checks::failed}
    given
        codec::json_member[] members
        str name
        int default
    asserts
        hit: [codec::json_member("ms", codec::json_int(7))], "ms", 0 => ok 7
        missing: [codec::json_member("clock", codec::json_string("n-monotonic"))], "ms", 0 => ok 0
        text: [codec::json_member("ms", codec::json_string("7"))], "ms", 0 => checks::failed{"ms must be an integer"}
    match call find_at(members, name, 0)
        ok int idx => match idx >= 0
            false => ok default
            true => match call codec::encode_json_value(members[idx].value)
                codec::invalid_data => relay call fail_int(name + " is not encodable")
                ok bytes::buffer raw => match call codec::decode_json<int>(raw)
                    codec::invalid_data => relay call fail_int(name + " must be an integer")
                    ok int whole => ok whole
/// Optional object member: absent keys decode to the empty object.
fn codec::json_object get_obj_or_empty
    emits {checks::failed}
    given
        codec::json_member[] members
        str name
        str reason
    asserts
        hit: [codec::json_member("facts", codec::json_object([codec::json_member("a", codec::json_int(1))]))], "facts", "no" => ok codec::json_object([codec::json_member("a", codec::json_int(1))])
        missing: [codec::json_member("kind", codec::json_string("ok"))], "facts", "no" => ok codec::json_object([])
        scalar: [codec::json_member("facts", codec::json_int(1))], "facts", "no" => checks::failed{"no"}
    match call find_at(members, name, 0)
        ok int idx => match idx >= 0
            false => ok codec::json_object([])
            true => match call narrowed_obj(members[idx].value, reason)
                checks::failed
                ok codec::json_object found => ok found
/// Required deadline_ms object.
fn codec::json_object deadline_obj
    emits {checks::failed}
    given
        codec::json_member[] members
    asserts
        hit: [codec::json_member("deadline_ms", codec::json_object([]))] => ok codec::json_object([])
        missing: [codec::json_member("kind", codec::json_string("ok"))] => checks::failed{"deadline_ms is missing"}
    match call find_at(members, "deadline_ms", 0)
        ok int idx => match call checks::require(idx >= 0, "deadline_ms is missing")
            checks::failed
            ok => match call narrowed_obj(members[idx].value, "deadline_ms must be an object")
                checks::failed
                ok codec::json_object found => ok found
/// Require a full pattern match, failing with the reason otherwise.
fn str check_pattern
    emits {checks::failed, text::invalid_regex, text::invalid_limit}
    given
        str value
        str pattern
        str reason
    asserts
        hit: "run-1", "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "no" => ok "ok"
        miss: "bad!", "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "no" => checks::failed{"no"}
    match call matches_pattern(value, pattern)
        text::invalid_regex
        text::invalid_limit
        ok bool good => match good
            true => ok "ok"
            false => relay call fail_str(reason)
/// Require lo <= length <= hi, failing with the reason otherwise.
fn str check_range
    emits {checks::failed}
    given
        int length
        int lo
        int hi
        str reason
    asserts
        hit: 3, 1, 256, "no" => ok "ok"
        low: 0, 1, 256, "no" => checks::failed{"no"}
        high: 257, 1, 256, "no" => checks::failed{"no"}
    match call checks::require(length >= lo, reason)
        checks::failed
        ok => match call checks::require(length <= hi, reason)
            checks::failed
            ok => ok "ok"
/// Unconditional request_view failure; see fail_str for the dead ok arm.
fn request_view fail_request
    emits {checks::failed}
    given
        str reason
    asserts
        always: "gone" => checks::failed{"gone"}
    match call checks::require(false, reason)
        checks::failed
        ok => ok request_view("", "", "", "", "", "", "", 0)
/// Unconditional result_view failure; see fail_str for the dead ok arm.
fn result_view fail_result
    emits {checks::failed}
    given
        str reason
    asserts
        always: "gone" => checks::failed{"gone"}
    match call checks::require(false, reason)
        checks::failed
        ok => ok result_view("", "", "", "", "", 0, 0)
/// Unconditional frame failure; see fail_str for the dead ok arm.
fn frame fail_frame
    emits {checks::failed}
    given
        str reason
    asserts
        always: "gone" => checks::failed{"gone"}
    match call checks::require(false, reason)
        checks::failed
        ok => ok frame(0, 0, [])
/// Decode and validate a request envelope (frame kind 1). Shape first:
/// object, key set, member types; then value checks in Go order.
fn request_view decode_request
    emits {checks::failed, text::invalid_regex, text::invalid_limit}
    given
        int[] bytes
    asserts
        envelope_request: [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 95, 100, 105, 103, 101, 115, 116, 34, 58, 34, 115, 104, 97, 50, 53, 54, 58, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 34, 44, 34, 100, 101, 97, 100, 108, 105, 110, 101, 95, 109, 115, 34, 58, 123, 34, 99, 108, 111, 99, 107, 34, 58, 34, 110, 45, 109, 111, 110, 111, 116, 111, 110, 105, 99, 34, 44, 34, 109, 115, 34, 58, 49, 48, 48, 48, 125, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 34, 58, 34, 119, 111, 114, 107, 46, 114, 101, 97, 100, 34, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 95, 105, 100, 34, 58, 34, 111, 112, 45, 49, 34, 44, 34, 111, 119, 110, 101, 114, 95, 103, 114, 97, 110, 116, 34, 58, 34, 103, 45, 49, 34, 44, 34, 114, 117, 110, 95, 105, 100, 34, 58, 34, 114, 117, 110, 45, 49, 34, 44, 34, 115, 99, 104, 101, 109, 97, 95, 118, 101, 114, 115, 105, 111, 110, 34, 58, 34, 49, 34, 125] => ok request_view("1", "run-1", "op-1", "g-1", "work.read", "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "n-monotonic", 1000)
        envelope_bad_version: [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 95, 100, 105, 103, 101, 115, 116, 34, 58, 34, 115, 104, 97, 50, 53, 54, 58, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 34, 44, 34, 100, 101, 97, 100, 108, 105, 110, 101, 95, 109, 115, 34, 58, 123, 34, 99, 108, 111, 99, 107, 34, 58, 34, 110, 45, 109, 111, 110, 111, 116, 111, 110, 105, 99, 34, 44, 34, 109, 115, 34, 58, 49, 48, 48, 48, 125, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 34, 58, 34, 119, 111, 114, 107, 46, 114, 101, 97, 100, 34, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 95, 105, 100, 34, 58, 34, 111, 112, 45, 49, 34, 44, 34, 111, 119, 110, 101, 114, 95, 103, 114, 97, 110, 116, 34, 58, 34, 103, 45, 49, 34, 44, 34, 114, 117, 110, 95, 105, 100, 34, 58, 34, 114, 117, 110, 45, 49, 34, 44, 34, 115, 99, 104, 101, 109, 97, 95, 118, 101, 114, 115, 105, 111, 110, 34, 58, 34, 50, 34, 125] => checks::failed{"schema_version must be 1"}
        envelope_missing_run_id: [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 95, 100, 105, 103, 101, 115, 116, 34, 58, 34, 115, 104, 97, 50, 53, 54, 58, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 34, 44, 34, 100, 101, 97, 100, 108, 105, 110, 101, 95, 109, 115, 34, 58, 123, 34, 99, 108, 111, 99, 107, 34, 58, 34, 110, 45, 109, 111, 110, 111, 116, 111, 110, 105, 99, 34, 44, 34, 109, 115, 34, 58, 49, 48, 48, 48, 125, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 34, 58, 34, 119, 111, 114, 107, 46, 114, 101, 97, 100, 34, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 95, 105, 100, 34, 58, 34, 111, 112, 45, 49, 34, 44, 34, 111, 119, 110, 101, 114, 95, 103, 114, 97, 110, 116, 34, 58, 34, 103, 45, 49, 34, 44, 34, 115, 99, 104, 101, 109, 97, 95, 118, 101, 114, 115, 105, 111, 110, 34, 58, 34, 49, 34, 125] => checks::failed{"run_id is missing"}
        envelope_unknown_field: [123, 34, 97, 114, 103, 117, 109, 101, 110, 116, 115, 95, 100, 105, 103, 101, 115, 116, 34, 58, 34, 115, 104, 97, 50, 53, 54, 58, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 34, 44, 34, 100, 101, 97, 100, 108, 105, 110, 101, 95, 109, 115, 34, 58, 123, 34, 99, 108, 111, 99, 107, 34, 58, 34, 110, 45, 109, 111, 110, 111, 116, 111, 110, 105, 99, 34, 44, 34, 109, 115, 34, 58, 49, 48, 48, 48, 125, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 34, 58, 34, 119, 111, 114, 107, 46, 114, 101, 97, 100, 34, 44, 34, 111, 112, 101, 114, 97, 116, 105, 111, 110, 95, 105, 100, 34, 58, 34, 111, 112, 45, 49, 34, 44, 34, 111, 119, 110, 101, 114, 95, 103, 114, 97, 110, 116, 34, 58, 34, 103, 45, 49, 34, 44, 34, 114, 117, 110, 95, 105, 100, 34, 58, 34, 114, 117, 110, 45, 49, 34, 44, 34, 115, 99, 104, 101, 109, 97, 95, 118, 101, 114, 115, 105, 111, 110, 34, 58, 34, 49, 34, 44, 34, 115, 109, 117, 103, 103, 108, 101, 100, 34, 58, 34, 120, 34, 125] => checks::failed{"unknown field smuggled"}
