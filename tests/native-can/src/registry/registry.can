package registry
    provides [planned_unit, blocked_unit, selection_ok, selection_rejected, selection, accepted_plan, rejected_plan, plan, registry, case_variants, profile_cases, profile_known, profile_variants, str_member, variant_offered, ref_member, id_seen_from, str_seen_before, ref_seen_before, chosen_has, case_has_tag, tag_known_in, append_tag_matches, select_ids, select_ids_at, select_profile, select_tags, select_tags_at, intersect, intersect_at, missing_require, expand_case, expand_units, plan_profile, collect_refs, collect_refs_at, validate_required, validate_required_at]
    uses [option, spec, text]

/// Pure Can registration, profile/matrix selection, dependency planning and
/// required-check inventories (P16). Ordinary Can owns every comparison:
/// selection, gating and planning diagnostics carry the originating source
/// function and an exact reproduction selector. Static checks here are
/// provisional until P26/P23, like the P15 skeleton.

/// One planned work item: report identity is (case_id, variant_id) with the
/// case's required checks copied onto the unit for coverage reconciliation.
record planned_unit
    str case_id
    str variant_id
    spec::check_ref[] required_checks
/// A selected unit that cannot begin: kind is "unavailable-variant" when
/// the profile requires a matrix leg the case does not offer, or
/// "missing-capability" when a descriptor require is not offered. Blocked
/// units stay on the accepted plan; they are never silently dropped.
record blocked_unit
    str case_id
    str variant_id
    str kind
    str missing
/// Accepted multi-selection: the chosen descriptors in selection order.
record selection_ok
    spec::test_case[] chosen
/// Rejected selection: one diagnostic per detected problem, no partial
/// choice.
record selection_rejected
    spec::diagnostic[] problems
/// Multi-select outcome: explicit ids, profiles and tag unions resolve here.
variant selection
    selection_ok
    selection_rejected
/// Accepted plan: ready units plus explicitly blocked units.
record accepted_plan
    planned_unit[] ready
    blocked_unit[] blocked
/// Rejected plan: one diagnostic per detected problem.
record rejected_plan
    spec::diagnostic[] problems
/// Dependency-planning outcome: expansion and capability gating.
variant plan
    accepted_plan
    rejected_plan
/// Canonical planner registry per scope: deterministic data, no live I/O.
/// Selection, planning and coverage test the same descriptor the suite runs.
fn spec::test_case[] registry
    emits {}
    given
        str scope
    asserts
        skeleton: "skeleton" => ok [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)]
        other: "nope" => ok []
    match scope is "skeleton"
        false => ok []
        true => ok [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)]
/// Explicit variant declaration per case id: the matrix legs a case offers.
/// Unknown ids offer nothing; a profile leg the case does not offer is
/// blocked at plan time, never silently dropped.
fn spec::case_variant[] case_variants
    emits {}
    given
        str case_id
    asserts
        known: "process/nonzero-result" => ok [spec::case_variant("default", "default execution")]
        unknown: "nope" => ok []
    match case_id is "process/nonzero-result"
        false => ok []
        true => ok [spec::case_variant("default", "default execution")]
/// Profile membership: case ids selected by a named profile. Unknown
/// profiles are empty; select_profile rejects them before resolving ids.
fn str[] profile_cases
    emits {}
    given
        str profile
    asserts
        quick: "quick" => ok ["process/nonzero-result"]
        full: "full" => ok ["process/nonzero-result"]
        unknown: "nope" => ok []
    match profile
        "quick" => ok ["process/nonzero-result"]
        "full" => ok ["process/nonzero-result"]
        _ => ok []
/// Whether a profile name is declared. Guards selection and planning so an
/// unknown profile fails as unknown-profile instead of an empty plan.
fn bool profile_known
    emits {}
    given
        str profile
    asserts
        quick: "quick" => ok true
        full: "full" => ok true
        unknown: "nope" => ok false
    match profile
        "quick" => ok true
        "full" => ok true
        _ => ok false
/// Required matrix variants for a profile/case pair. The full profile also
/// requires a "locale-c" leg the skeleton case does not offer yet, so full
/// plans carry an explicit blocked unit until the case declares that leg.
/// Unknown profiles and cases require nothing.
fn str[] profile_variants
    emits {}
    given
        str profile
        str case_id
    asserts
        quick: "quick", "process/nonzero-result" => ok ["default"]
        full: "full", "process/nonzero-result" => ok ["default", "locale-c"]
        unknown_profile: "nope", "process/nonzero-result" => ok []
        unknown_case: "quick", "nope" => ok []
    match profile
        "quick" => match case_id is "process/nonzero-result"
            false => ok []
            true => ok ["default"]
        "full" => match case_id is "process/nonzero-result"
            false => ok []
            true => ok ["default", "locale-c"]
        _ => ok []
/// Membership of a string in a list from an index. Shared by id, tag and
/// capability scans.
fn bool str_member
    emits {}
    given
        str[] ids
        str id
        int index
    asserts
        hit: ["a", "b"], "b", 0 => ok true
        miss: ["a"], "z", 0 => ok false
        empty: [], "a", 0 => ok false
        offset: ["a", "b"], "a", 1 => ok false
    match index >= ids.length
        true => ok false
        false => match ids[index] is id
            false => relay call str_member(ids, id, index + 1)
            true => ok true
/// Membership of a variant id in a declared variant list from an index.
fn bool variant_offered
    emits {}
    given
        spec::case_variant[] variants
        str id
        int index
    asserts
        hit: [spec::case_variant("default", "D")], "default", 0 => ok true
        miss: [spec::case_variant("default", "D")], "locale-c", 0 => ok false
        empty: [], "default", 0 => ok false
    match index >= variants.length
        true => ok false
        false => match variants[index].id is id
            false => relay call variant_offered(variants, id, index + 1)
            true => ok true
/// Membership of a check id in a required-check list from an index.
fn bool ref_member
    emits {}
    given
        spec::check_ref[] refs
        str id
        int index
    asserts
        hit: [spec::check_ref("a"), spec::check_ref("b")], "b", 0 => ok true
        miss: [spec::check_ref("a")], "z", 0 => ok false
        empty: [], "a", 0 => ok false
    match index >= refs.length
        true => ok false
        false => match refs[index].id is id
            false => relay call ref_member(refs, id, index + 1)
            true => ok true
/// Whether an id reappears at or after an index: the duplicate-selection
/// scan over a requested id list.
fn bool id_seen_from
    emits {}
    given
        str[] ids
        str id
        int from
    asserts
        seen: ["a", "b", "a"], "a", 1 => ok true
        absent: ["a", "b"], "a", 1 => ok false
        empty: [], "a", 0 => ok false
    match from >= ids.length
        true => ok false
        false => match ids[from] is id
            false => relay call id_seen_from(ids, id, from + 1)
            true => ok true
/// Whether an id occurs in ids within [at, end): first-occurrence scans so
/// repeated selections report once per distinct id or tag. Diagnostics carry
/// no position, so one problem per distinct repeated value avoids noise.
fn bool str_seen_before
    emits {}
    given
        str[] ids
        str id
        int at
        int end
    asserts
        seen: ["a", "b"], "a", 0, 2 => ok true
        absent: ["a"], "b", 0, 1 => ok false
        outside: ["a", "b"], "b", 0, 1 => ok false
    match at >= end
        false => match ids[at] is id
            false => relay call str_seen_before(ids, id, at + 1, end)
            true => ok true
        true => ok false
/// Whether a check id already occurs in refs within [at, end): the
/// duplicate-required-check scan inside one descriptor plan.
fn bool ref_seen_before
    emits {}
    given
        spec::check_ref[] refs
        str id
        int at
        int end
    asserts
        seen: [spec::check_ref("a"), spec::check_ref("b")], "a", 0, 2 => ok true
        absent: [spec::check_ref("a")], "b", 0, 1 => ok false
        outside: [spec::check_ref("a"), spec::check_ref("b")], "b", 0, 1 => ok false
    match at >= end
        false => match refs[at].id is id
            false => relay call ref_seen_before(refs, id, at + 1, end)
            true => ok true
        true => ok false
/// Whether a descriptor id is already in a chosen list from an index:
/// tag-union deduplication across repeated tags.
fn bool chosen_has
    emits {}
    given
        spec::test_case[] chosen
        str id
        int index
    asserts
        seen: [spec::test_case("a", [], [], 0, [], callable spec::nonzero_result)], "a", 0 => ok true
        absent: [spec::test_case("a", [], [], 0, [], callable spec::nonzero_result)], "z", 0 => ok false
        empty: [], "a", 0 => ok false
    match index >= chosen.length
        true => ok false
        false => match chosen[index].id is id
            false => relay call chosen_has(chosen, id, index + 1)
            true => ok true
/// Whether a descriptor carries a tag.
fn bool case_has_tag
    emits {}
    given
        spec::test_case candidate
        str tag
    asserts
        hit: spec::test_case("a", ["fast"], [], 0, [], callable spec::nonzero_result), "fast" => ok true
        miss: spec::test_case("a", ["fast"], [], 0, [], callable spec::nonzero_result), "slow" => ok false
    relay call str_member(candidate.tags, tag, 0)
/// Whether any descriptor carries a tag from an index: unknown-tag detection.
fn bool tag_known_in
    emits {}
    given
        spec::test_case[] cases
        str tag
        int index
    asserts
        known: [spec::test_case("a", ["fast"], [], 0, [], callable spec::nonzero_result)], "fast", 0 => ok true
        unknown: [spec::test_case("a", ["fast"], [], 0, [], callable spec::nonzero_result)], "slow", 0 => ok false
        empty: [], "fast", 0 => ok false
    match index >= cases.length
        true => ok false
        false => match call case_has_tag(cases[index], tag)
            ok bool hit => match hit
                false => relay call tag_known_in(cases, tag, index + 1)
                true => ok true
/// Append descriptors carrying a tag from an index, skipping ids already
/// chosen: repeated tags form a union without duplicating descriptors.
fn spec::test_case[] append_tag_matches
    emits {}
    given
        spec::test_case[] cases
        str tag
        int index
        spec::test_case[] chosen
    asserts
        matched: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], "fast", 0, [] => ok [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)]
        skip: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], "slow", 0, [] => ok []
        dedup: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], "fast", 0, [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)] => ok [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)]
        done: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], "fast", 1, [] => ok []
    match index >= cases.length
        false => match call case_has_tag(cases[index], tag)
            ok bool hit => match hit
                false => relay call append_tag_matches(cases, tag, index + 1, chosen)
                true => match call chosen_has(chosen, cases[index].id, 0)
                    ok bool seen => match seen
                        false => relay call append_tag_matches(cases, tag, index + 1, call append(chosen, cases[index]))
                        true => relay call append_tag_matches(cases, tag, index + 1, chosen)
        true => ok chosen
/// Resolve an explicit id union against the registry in selection order.
/// Empty, duplicate and unknown selections are planning errors: the
/// rejected outcome carries one diagnostic per detected problem and no
/// partial choice. Exact ids are strict so a mistyped rerun cannot
/// silently narrow scope; tags stay union-tolerant in select_tags.
fn selection select_ids
    emits {}
    given
        spec::test_case[] cases
        str[] ids
    asserts
        one: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], ["b"] => ok selection_ok([spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)])
        pair: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], ["b", "a"] => ok selection_ok([spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result), spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)])
        empty: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], [] => ok selection_rejected([spec::diagnostic("registry::select_ids", "case - variant - root select run static", "empty-selection", "ids")])
        duplicate: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["a", "a"] => ok selection_rejected([spec::diagnostic("registry::select_ids", "case a variant - root select run static", "duplicate-selection", "a")])
        unknown: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["z"] => ok selection_rejected([spec::diagnostic("spec::select_case", "case z variant - root select run static", "unknown-case", "z")])
        mixed: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["a", "z", "a"] => ok selection_rejected([spec::diagnostic("registry::select_ids", "case a variant - root select run static", "duplicate-selection", "a"), spec::diagnostic("spec::select_case", "case z variant - root select run static", "unknown-case", "z")])
        triple: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["a", "a", "a"] => ok selection_rejected([spec::diagnostic("registry::select_ids", "case a variant - root select run static", "duplicate-selection", "a")])
    match ids.length is 0
        false => relay call select_ids_at(cases, ids, 0, [], [])
        true => ok selection_rejected([spec::diagnostic("registry::select_ids", call spec::reproduction_selector(call spec::context_for("-", "-", "", "static"), "select"), "empty-selection", "ids")])
/// Resolve requested ids from an index, threading the chosen descriptors
/// and every detected problem. A repeated id reports duplicate-selection
/// once at its first occurrence; later repeats are skipped without further
/// problems. An unresolvable id reuses the shared unknown-case diagnostic
/// from spec::select_case.
fn selection select_ids_at
    emits {}
    given
        spec::test_case[] cases
        str[] ids
        int index
        spec::test_case[] chosen
        spec::diagnostic[] problems
    asserts
        resolve: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["a"], 0, [], [] => ok selection_ok([spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)])
        duplicate: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["a", "a"], 0, [], [] => ok selection_rejected([spec::diagnostic("registry::select_ids", "case a variant - root select run static", "duplicate-selection", "a")])
        unknown: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["z"], 0, [], [] => ok selection_rejected([spec::diagnostic("spec::select_case", "case z variant - root select run static", "unknown-case", "z")])
        done_ok: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["a"], 1, [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], [] => ok selection_ok([spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)])
        done_rejected: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["a"], 1, [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], [spec::diagnostic("registry::select_ids", "case a variant - root select run static", "duplicate-selection", "a")] => ok selection_rejected([spec::diagnostic("registry::select_ids", "case a variant - root select run static", "duplicate-selection", "a")])
    match index >= ids.length
        false => match call id_seen_from(ids, ids[index], index + 1)
            ok bool dup => match dup
                false => match call spec::select_case(cases, ids[index], 0)
                    ok spec::select_outcome found => match found
                        spec::selected => relay call select_ids_at(cases, ids, index + 1, call append(chosen, found.descriptor), problems)
                        spec::unselected => relay call select_ids_at(cases, ids, index + 1, chosen, call append(problems, found.problem))
                true => match call str_seen_before(ids, ids[index], 0, index)
                    ok bool earlier => match earlier
                        false => relay call select_ids_at(cases, ids, index + 1, chosen, call append(problems, spec::diagnostic("registry::select_ids", call spec::reproduction_selector(call spec::context_for(ids[index], "-", "", "static"), "select"), "duplicate-selection", ids[index])))
                        true => relay call select_ids_at(cases, ids, index + 1, chosen, problems)
        true => match problems.length is 0
            false => ok selection_rejected(problems)
            true => ok selection_ok(chosen)
/// Resolve a named profile against the registry. Unknown profiles fail
/// before any id lookup; member resolution reuses select_ids so unknown
/// members and empty membership fail the same way explicit ids do.
fn selection select_profile
    emits {}
    given
        spec::test_case[] cases
        str profile
    asserts
        quick: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "quick" => ok selection_ok([spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)])
        full: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "full" => ok selection_ok([spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)])
        unknown: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "nope" => ok selection_rejected([spec::diagnostic("registry::select_profile", "case - variant - root select run static", "unknown-profile", "nope")])
        missing_member: [], "quick" => ok selection_rejected([spec::diagnostic("spec::select_case", "case process/nonzero-result variant - root select run static", "unknown-case", "process/nonzero-result")])
    match call profile_known(profile)
        ok bool known => match known
            false => ok selection_rejected([spec::diagnostic("registry::select_profile", call spec::reproduction_selector(call spec::context_for("-", "-", "", "static"), "select"), "unknown-profile", profile)])
            true => relay call select_ids(cases, call profile_cases(profile))
/// Resolve a tag union against the registry. Repeated tags form a union
/// (matching descriptors appear once); unknown tags and empty tag lists
/// are planning errors.
fn selection select_tags
    emits {}
    given
        spec::test_case[] cases
        str[] tags
    asserts
        one: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], ["slow"] => ok selection_ok([spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)])
        union: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], ["slow", "fast"] => ok selection_ok([spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result), spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)])
        repeated: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], ["fast", "fast"] => ok selection_ok([spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)])
        empty: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], [] => ok selection_rejected([spec::diagnostic("registry::select_tags", "case - variant - root select run static", "empty-selection", "tags")])
        unknown: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["nope"] => ok selection_rejected([spec::diagnostic("registry::select_tags", "case - variant - root select run static", "unknown-tag", "nope")])
        repeated_unknown: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["nope", "nope"] => ok selection_rejected([spec::diagnostic("registry::select_tags", "case - variant - root select run static", "unknown-tag", "nope")])
    match tags.length is 0
        false => relay call select_tags_at(cases, tags, 0, [], [])
        true => ok selection_rejected([spec::diagnostic("registry::select_tags", call spec::reproduction_selector(call spec::context_for("-", "-", "", "static"), "select"), "empty-selection", "tags")])
/// Resolve requested tags from an index, threading chosen descriptors and
/// every detected problem. Known tags append their matches; unknown tags
/// report unknown-tag once per distinct tag, without resolving anything
/// for that tag.
fn selection select_tags_at
    emits {}
    given
        spec::test_case[] cases
        str[] tags
        int index
        spec::test_case[] chosen
        spec::diagnostic[] problems
    asserts
        resolve: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], ["fast"], 0, [], [] => ok selection_ok([spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)])
        unknown: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["nope"], 0, [], [] => ok selection_rejected([spec::diagnostic("registry::select_tags", "case - variant - root select run static", "unknown-tag", "nope")])
        mixed: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["fast", "nope"], 0, [], [] => ok selection_rejected([spec::diagnostic("registry::select_tags", "case - variant - root select run static", "unknown-tag", "nope")])
        done_ok: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["fast"], 1, [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], [] => ok selection_ok([spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)])
        done_rejected: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], ["fast"], 1, [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], [spec::diagnostic("registry::select_tags", "case - variant - root select run static", "unknown-tag", "nope")] => ok selection_rejected([spec::diagnostic("registry::select_tags", "case - variant - root select run static", "unknown-tag", "nope")])
    match index >= tags.length
        false => match call tag_known_in(cases, tags[index], 0)
            ok bool known => match known
                false => match call str_seen_before(tags, tags[index], 0, index)
                    ok bool earlier => match earlier
                        false => relay call select_tags_at(cases, tags, index + 1, chosen, call append(problems, spec::diagnostic("registry::select_tags", call spec::reproduction_selector(call spec::context_for("-", "-", "", "static"), "select"), "unknown-tag", tags[index])))
                        true => relay call select_tags_at(cases, tags, index + 1, chosen, problems)
                true => relay call select_tags_at(cases, tags, index + 1, call append_tag_matches(cases, tags[index], 0, chosen), problems)
        true => match problems.length is 0
            false => ok selection_rejected(problems)
            true => ok selection_ok(chosen)
/// Intersect two id lists in first-list order: callers compose profile and
/// tag unions, because different selector categories intersect. Order is
/// preserved so select_ids reports duplicates in stable positions.
fn str[] intersect
    emits {}
    given
        str[] first
        str[] second
        int index
    asserts
        some: ["a", "b"], ["b", "c"], 0 => ok ["b"]
        all: ["a", "b"], ["a", "b"], 0 => ok ["a", "b"]
        none: ["a"], ["b"], 0 => ok []
        empty: [], ["a"], 0 => ok []
    relay call intersect_at(first, second, index, [])
/// Intersect from an index, threading kept ids in first-list order.
fn str[] intersect_at
    emits {}
    given
        str[] first
        str[] second
        int index
        str[] kept
    asserts
        keep: ["a", "b"], ["b"], 0, [] => ok ["b"]
        drop: ["a"], ["b"], 0, [] => ok []
        done: ["a"], ["a"], 1, ["a"] => ok ["a"]
    match index >= first.length
        false => match call str_member(second, first[index], 0)
            ok bool hit => match hit
                false => relay call intersect_at(first, second, index + 1, kept)
                true => relay call intersect_at(first, second, index + 1, call append(kept, first[index]))
        true => ok kept
/// First descriptor require missing from the offered capabilities, or none
/// when every require is satisfied.
fn option::value<str> missing_require
    emits {}
    given
        str[] requires
        str[] capabilities
        int index
    asserts
        satisfied: ["a"], ["a", "b"], 0 => ok option::none()
        missing: ["a", "b"], ["a"], 0 => ok option::some("b")
        empty: [], ["a"], 0 => ok option::none()
        done: ["a"], ["a"], 1 => ok option::none()
    match index >= requires.length
        false => match call str_member(capabilities, requires[index], 0)
            ok bool hit => match hit
                false => ok option::some(requires[index])
                true => relay call missing_require(requires, capabilities, index + 1)
        true => ok option::none()
/// Expand one descriptor's required matrix legs into ready or blocked units,
/// threading one accepted accumulator. A leg the case does not offer is an
/// unavailable-variant block; an unsatisfied require is a missing-capability
/// block. Blocked legs stay recorded on the plan, never silently dropped.
fn accepted_plan expand_case
    emits {}
    given
        spec::test_case descriptor
        str[] variant_ids
        str[] capabilities
        int index
        accepted_plan acc
    asserts
        ready: spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result), ["default"], ["posix-false"], 0, accepted_plan([], []) => ok accepted_plan([planned_unit("process/nonzero-result", "default", [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")])], [])
        unavailable: spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result), ["locale-c"], ["posix-false"], 0, accepted_plan([], []) => ok accepted_plan([], [blocked_unit("process/nonzero-result", "locale-c", "unavailable-variant", "locale-c")])
        missing_capability: spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result), ["default"], [], 0, accepted_plan([], []) => ok accepted_plan([], [blocked_unit("process/nonzero-result", "default", "missing-capability", "posix-false")])
        mixed_legs: spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result), ["default", "locale-c"], ["posix-false"], 0, accepted_plan([], []) => ok accepted_plan([planned_unit("process/nonzero-result", "default", [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")])], [blocked_unit("process/nonzero-result", "locale-c", "unavailable-variant", "locale-c")])
        done: spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result), ["default"], ["posix-false"], 1, accepted_plan([planned_unit("a", "default", [spec::check_ref("x")])], []) => ok accepted_plan([planned_unit("a", "default", [spec::check_ref("x")])], [])
    match index >= variant_ids.length
        false => match call variant_offered(call case_variants(descriptor.id), variant_ids[index], 0)
            ok bool offered => match offered
                false => relay call expand_case(descriptor, variant_ids, capabilities, index + 1, accepted_plan(acc.ready, call append(acc.blocked, blocked_unit(descriptor.id, variant_ids[index], "unavailable-variant", variant_ids[index]))))
                true => match call missing_require(descriptor.requires, capabilities, 0)
                    ok option::value<str> gap => match gap
                        option::some => relay call expand_case(descriptor, variant_ids, capabilities, index + 1, accepted_plan(acc.ready, call append(acc.blocked, blocked_unit(descriptor.id, variant_ids[index], "missing-capability", gap.value))))
                        option::none => relay call expand_case(descriptor, variant_ids, capabilities, index + 1, accepted_plan(call append(acc.ready, planned_unit(descriptor.id, variant_ids[index], descriptor.required_checks)), acc.blocked))
        true => ok acc
/// Expand chosen descriptors under a profile into ready/blocked units in
/// registry order, threading one accepted accumulator. Assumes a known
/// profile (plan_profile guards); unknown profiles require no variants.
fn plan expand_units
    emits {}
    given
        spec::test_case[] chosen
        str profile
        str[] capabilities
        int index
        accepted_plan acc
    asserts
        one: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "quick", ["posix-false"], 0, accepted_plan([], []) => ok accepted_plan([planned_unit("process/nonzero-result", "default", [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")])], [])
        blocked_leg: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "full", ["posix-false"], 0, accepted_plan([], []) => ok accepted_plan([planned_unit("process/nonzero-result", "default", [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")])], [blocked_unit("process/nonzero-result", "locale-c", "unavailable-variant", "locale-c")])
        no_capability: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "quick", [], 0, accepted_plan([], []) => ok accepted_plan([], [blocked_unit("process/nonzero-result", "default", "missing-capability", "posix-false")])
        done: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "quick", ["posix-false"], 1, accepted_plan([planned_unit("a", "default", [spec::check_ref("x")])], [blocked_unit("b", "v", "missing-capability", "cap")]) => ok accepted_plan([planned_unit("a", "default", [spec::check_ref("x")])], [blocked_unit("b", "v", "missing-capability", "cap")])
    match index >= chosen.length
        false => relay call expand_units(chosen, profile, capabilities, index + 1, call expand_case(chosen[index], call profile_variants(profile, chosen[index].id), capabilities, 0, acc))
        true => ok accepted_plan(acc.ready, acc.blocked)
/// Plan chosen descriptors under a profile with offered capabilities:
/// unknown profiles and empty selections are rejected; required matrix
/// legs the case does not offer, and unsatisfied requires, become blocked
/// units on an accepted plan instead of silent scope loss.
fn plan plan_profile
    emits {}
    given
        spec::test_case[] chosen
        str profile
        str[] capabilities
    asserts
        quick_ready: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "quick", ["posix-false"] => ok accepted_plan([planned_unit("process/nonzero-result", "default", [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")])], [])
        full_blocked: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "full", ["posix-false"] => ok accepted_plan([planned_unit("process/nonzero-result", "default", [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")])], [blocked_unit("process/nonzero-result", "locale-c", "unavailable-variant", "locale-c")])
        no_capability: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "quick", [] => ok accepted_plan([], [blocked_unit("process/nonzero-result", "default", "missing-capability", "posix-false")])
        unknown_profile: [spec::test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [spec::check_ref("exit-code"), spec::check_ref("signal"), spec::check_ref("stdout"), spec::check_ref("stderr")], callable spec::nonzero_result)], "nope", ["posix-false"] => ok rejected_plan([spec::diagnostic("registry::plan_profile", "case - variant - root plan run static", "unknown-profile", "nope")])
        empty: [], "quick", ["posix-false"] => ok rejected_plan([spec::diagnostic("registry::plan_profile", "case - variant - root plan run static", "empty-selection", "quick")])
    match call profile_known(profile)
        ok bool known => match known
            false => ok rejected_plan([spec::diagnostic("registry::plan_profile", call spec::reproduction_selector(call spec::context_for("-", "-", "", "static"), "plan"), "unknown-profile", profile)])
            true => match chosen.length is 0
                false => relay call expand_units(chosen, profile, capabilities, 0, accepted_plan([], []))
                true => ok rejected_plan([spec::diagnostic("registry::plan_profile", call spec::reproduction_selector(call spec::context_for("-", "-", "", "static"), "plan"), "empty-selection", profile)])
/// Collect required checks across descriptors in order: the plan-side
/// inventory reconciled against the coverage manifest.
fn spec::check_ref[] collect_refs
    emits {}
    given
        spec::test_case[] descriptors
        int index
    asserts
        pair: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], 0 => ok [spec::check_ref("x"), spec::check_ref("y")]
        one: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], 0 => ok [spec::check_ref("x")]
        empty: [], 0 => ok []
    relay call collect_refs_at(descriptors, index, [])
/// Collect required checks from an index, threading gathered refs in order.
fn spec::check_ref[] collect_refs_at
    emits {}
    given
        spec::test_case[] descriptors
        int index
        spec::check_ref[] gathered
    asserts
        head: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], 0, [] => ok [spec::check_ref("x")]
        tail: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), spec::test_case("b", ["slow"], [], 2000, [spec::check_ref("y")], callable spec::nonzero_result)], 1, [spec::check_ref("x")] => ok [spec::check_ref("x"), spec::check_ref("y")]
        done: [spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result)], 1, [spec::check_ref("x")] => ok [spec::check_ref("x")]
    match index >= descriptors.length
        false => relay call collect_refs_at(descriptors, index + 1, call gathered.concat(descriptors[index].required_checks))
        true => ok gathered
/// Validate one descriptor plan against the declared check inventory:
/// every required check must be declared, and no check may repeat within
/// the descriptor. All problems are reported, not just the first.
fn spec::plan_outcome validate_required
    emits {}
    given
        spec::test_case descriptor
        spec::check[] known
    asserts
        clean: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), [spec::check("x", "X")] => ok spec::plan_ok([spec::check_ref("x")])
        unknown: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("z")], callable spec::nonzero_result), [spec::check("x", "X")] => ok spec::plan_rejected([spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "unknown-check", "z")])
        duplicate: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x"), spec::check_ref("x")], callable spec::nonzero_result), [spec::check("x", "X")] => ok spec::plan_rejected([spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "duplicate-check", "x")])
        both: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x"), spec::check_ref("x"), spec::check_ref("z")], callable spec::nonzero_result), [spec::check("x", "X")] => ok spec::plan_rejected([spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "duplicate-check", "x"), spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "unknown-check", "z")])
        empty_refs: spec::test_case("a", ["fast"], [], 1000, [], callable spec::nonzero_result), [] => ok spec::plan_ok([])
    relay call validate_required_at(descriptor, known, 0, [])
/// Validate required checks from an index, threading every problem.
/// Unknown checks report unknown-check; repeats report duplicate-check.
fn spec::plan_outcome validate_required_at
    emits {}
    given
        spec::test_case descriptor
        spec::check[] known
        int index
        spec::diagnostic[] problems
    asserts
        known_advance: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), [spec::check("x", "X")], 0, [] => ok spec::plan_ok([spec::check_ref("x")])
        unknown: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("z")], callable spec::nonzero_result), [spec::check("x", "X")], 0, [] => ok spec::plan_rejected([spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "unknown-check", "z")])
        duplicate: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x"), spec::check_ref("x")], callable spec::nonzero_result), [spec::check("x", "X")], 1, [] => ok spec::plan_rejected([spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "duplicate-check", "x")])
        done_ok: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), [spec::check("x", "X")], 1, [] => ok spec::plan_ok([spec::check_ref("x")])
        done_rejected: spec::test_case("a", ["fast"], [], 1000, [spec::check_ref("x")], callable spec::nonzero_result), [spec::check("x", "X")], 1, [spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "unknown-check", "z")] => ok spec::plan_rejected([spec::diagnostic("registry::validate_required", "case a variant - root plan run static", "unknown-check", "z")])
    match index >= descriptor.required_checks.length
        false => match call spec::check_known(known, descriptor.required_checks[index].id, 0)
            ok bool hit => match hit
                false => relay call validate_required_at(descriptor, known, index + 1, call append(problems, spec::diagnostic("registry::validate_required", call spec::reproduction_selector(call spec::context_for(descriptor.id, "-", "", "static"), "plan"), "unknown-check", descriptor.required_checks[index].id)))
                true => match call ref_seen_before(descriptor.required_checks, descriptor.required_checks[index].id, 0, index)
                    ok bool dup => match dup
                        false => relay call validate_required_at(descriptor, known, index + 1, problems)
                        true => relay call validate_required_at(descriptor, known, index + 1, call append(problems, spec::diagnostic("registry::validate_required", call spec::reproduction_selector(call spec::context_for(descriptor.id, "-", "", "static"), "plan"), "duplicate-check", descriptor.required_checks[index].id)))
        true => match problems.length is 0
            false => ok spec::plan_rejected(problems)
            true => ok spec::plan_ok(descriptor.required_checks)
