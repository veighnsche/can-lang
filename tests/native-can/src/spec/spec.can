package spec
    provides [context, failed, broken, check, check_ref, case_variant, expected_check, evidence, diagnostic, fixture_row, fixture_store, exec_result, test_case, consumed, diagnosed, consume_outcome, selected, unselected, select_outcome, plan_ok, plan_rejected, plan_outcome, reduction_ok, reduction_failed, reduction_incomplete, reduction, offline_context, context_for, reproduction_selector, require_int, require_text, require_bool, expected_vector, skeleton_checks, check_known, plan_checks, id_seen_later, validate_unique_ids, lookup_row, select_case, evidence_index, reduce_required, run_process, nonzero_result]
    uses [bytes, files, process, text]

/// Canonical native-suite skeleton (P15). Ordinary Can owns case logic,
/// selection, expected vectors and reduction. Every diagnostic carries its
/// source function and an exact reproduction selector so an agent can rerun
/// the failing step. Static checks here are provisional until P26/P23.

/// Constructible execution context: case/variant identity, candidate
/// workspace path and run identity. No live handles cross with it.
record context
    str case_id
    str variant_id
    str workspace
    str run_id
/// A named expectation failed: expected/observed values stay on evidence.
error failed{str check}
/// Execution broke before a verdict: operation, qualified failure kind and
/// the most specific available cause. Never a passing verdict.
error broken{str operation, str kind, str cause}
/// One declared check: stable identity plus human title.
record check
    str id
    str title
/// Typed reference to a declared check, shared by plan and body.
record check_ref
    str id
/// One named case variant (profile/matrix member).
record case_variant
    str id
    str title
/// One expected-vector row: check identity plus expected value text.
record expected_check
    str check
    str expected
/// One recorded comparison: check, expected/observed text, outcome and the
/// exact reproduction selector of the context that produced it.
record evidence
    str check
    str expected
    str observed
    bool matched
    str selector
/// A planning/selection/fixture problem: originating source function, exact
/// reproduction selector, machine kind and human detail.
record diagnostic
    str source
    str selector
    str kind
    str detail
/// One fixture row: lookup key, payload text and consumption budget.
record fixture_row
    str key
    str payload
    int budget
/// Case-owned boundary fixture store: plain data threaded through asserts.
record fixture_store
    fixture_row[] rows
/// Can-friendly subprocess observation: exit code, signal and hex streams.
record exec_result
    int code
    str signal
    str stdout_hex
    str stderr_hex
/// Canonical case descriptor: identity, tags, requirements, deadline, typed
/// required checks and the uniform-slot body. Bodies outside this effect
/// bound cannot register; adapters translate them to spec::broken instead.
record test_case
    str id
    str[] tags
    str[] requires
    int timeout_ms
    check_ref[] required_checks
    callable void (context) emits {failed, broken} body
/// Successful fixture consumption: the row payload.
record consumed
    str payload
/// Failed fixture consumption: the identifying diagnostic.
record diagnosed
    diagnostic problem
/// Fixture consumption outcome: payload or diagnostic, never confused.
variant consume_outcome
    consumed
    diagnosed
/// Successful selection: the chosen descriptor.
record selected
    test_case descriptor
/// Failed selection: the identifying diagnostic.
record unselected
    diagnostic problem
/// Registry selection outcome.
variant select_outcome
    selected
    unselected
/// Accepted plan: the validated required checks.
record plan_ok
    check_ref[] checks
/// Rejected plan: one diagnostic per detected problem.
record plan_rejected
    diagnostic[] problems
/// Static plan validation outcome.
variant plan_outcome
    plan_ok
    plan_rejected
/// Clean reduction: every required check matched, with the count.
record reduction_ok
    int matched
/// Behavior failure: the first mismatched check stays visible.
record reduction_failed
    str check
/// Incomplete evidence: missing, extra or short check accounting.
record reduction_incomplete
    str detail
/// Evidence reduction outcome: pass, sticky failure or incomplete.
variant reduction
    reduction_ok
    reduction_failed
    reduction_incomplete
/// Offline assertion context for a case: default variant, no workspace, run
/// "offline". Roots run the real comparisons against supplied boundaries.
fn context offline_context
    emits {}
    given
        str case_id
    asserts
        sample: "process/nonzero-result" => ok context("process/nonzero-result", "default", "", "offline")
    ok context(case_id, "default", "", "offline")
/// Full context constructor for live and planned scopes.
fn context context_for
    emits {}
    given
        str case_id
        str variant_id
        str workspace
        str run_id
    asserts
        live: "a/b", "v", "/tmp/w", "r1" => ok context("a/b", "v", "/tmp/w", "r1")
    ok context(case_id, variant_id, workspace, run_id)
/// Exact reproduction selector: "case <id> variant <v> root <r> run <run>".
fn str reproduction_selector
    emits {}
    given
        context c
        str root
    asserts
        sample: context("process/nonzero-result", "default", "", "offline"), "exit-code" => ok "case process/nonzero-result variant default root exit-code run offline"
        planned: context("a/b", "-", "", "static"), "plan" => ok "case a/b variant - root plan run static"
    ok call text::join(["case", c.case_id, "variant", c.variant_id, "root", root, "run", c.run_id], " ")
/// Compare two ints for a named check: matched evidence or failed check.
/// The negative row is the altered-observation seed at helper level.
fn evidence require_int
    emits {failed}
    given
        int observed
        int expected
        context c
        str check
    asserts
        same: 3, 3, context("process/nonzero-result", "default", "", "offline"), "exit-code" => ok evidence("exit-code", "3", "3", true, "case process/nonzero-result variant default root exit-code run offline")
        different: 3, 4, context("process/nonzero-result", "default", "", "offline"), "exit-code" => failed{"exit-code"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_int(expected), call text::from_int(observed), true, call reproduction_selector(c, check))
/// Compare two texts for a named check.
fn evidence require_text
    emits {failed}
    given
        str observed
        str expected
        context c
        str check
    asserts
        same: "a", "a", context("process/nonzero-result", "default", "", "offline"), "signal" => ok evidence("signal", "a", "a", true, "case process/nonzero-result variant default root signal run offline")
        different: "a", "b", context("process/nonzero-result", "default", "", "offline"), "signal" => failed{"signal"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, expected, observed, true, call reproduction_selector(c, check))
/// Compare two bools for a named check.
fn evidence require_bool
    emits {failed}
    given
        bool observed
        bool expected
        context c
        str check
    asserts
        same: true, true, context("process/nonzero-result", "default", "", "offline"), "held" => ok evidence("held", "true", "true", true, "case process/nonzero-result variant default root held run offline")
        different: true, false, context("process/nonzero-result", "default", "", "offline"), "held" => failed{"held"}
    match observed is expected
        false => failed{check}
        true => ok evidence(check, call text::from_bool(expected), call text::from_bool(observed), true, call reproduction_selector(c, check))
/// Expected observation vector per case id. Unknown ids have no vector.
fn expected_check[] expected_vector
    emits {}
    given
        str case_id
    asserts
        known: "process/nonzero-result" => ok [expected_check("exit-code", "1"), expected_check("signal", ""), expected_check("stdout", ""), expected_check("stderr", "")]
        unknown: "nope" => ok []
    match case_id is "process/nonzero-result"
        false => ok []
        true => ok [expected_check("exit-code", "1"), expected_check("signal", ""), expected_check("stdout", ""), expected_check("stderr", "")]
/// Declared skeleton check inventory per scope. Unknown scopes are empty.
fn check[] skeleton_checks
    emits {}
    given
        str scope
    asserts
        known: "skeleton" => ok [check("exit-code", "process exit code"), check("signal", "termination signal"), check("stdout", "standard output hex"), check("stderr", "standard error hex")]
        unknown: "other" => ok []
    match scope is "skeleton"
        false => ok []
        true => ok [check("exit-code", "process exit code"), check("signal", "termination signal"), check("stdout", "standard output hex"), check("stderr", "standard error hex")]
/// Membership of a check id in the declared inventory from an index.
fn bool check_known
    emits {}
    given
        check[] known
        str id
        int index
    asserts
        hit: [check("a", "A"), check("b", "B")], "b", 0 => ok true
        miss: [check("a", "A")], "z", 0 => ok false
        empty: [], "a", 0 => ok false
    match index >= known.length
        true => ok false
        false => match known[index].id is id
            false => relay call check_known(known, id, index + 1)
            true => ok true
/// Validate a descriptor plan: every required check must be declared.
/// Static planners carry no live context, so the diagnostic selector names
/// the descriptor id with variant "-" and run "static". Reports the first
/// unknown check; full accumulation is later planner work.
fn plan_outcome plan_checks
    emits {}
    given
        test_case descriptor
        check[] known
        int index
    asserts
        all_known: test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [check_ref("exit-code"), check_ref("signal")], callable nonzero_result), [check("exit-code", "process exit code"), check("signal", "termination signal")], 0 => ok plan_ok([check_ref("exit-code"), check_ref("signal")])
        unknown: test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [check_ref("nope")], callable nonzero_result), [check("exit-code", "process exit code")], 0 => ok plan_rejected([diagnostic("spec::plan_checks", "case process/nonzero-result variant - root plan run static", "unknown-check", "nope")])
        empty_required: test_case("process/nonzero-result", ["process"], ["posix-false"], 15000, [], callable nonzero_result), [], 0 => ok plan_ok([])
    match index >= descriptor.required_checks.length
        true => ok plan_ok(descriptor.required_checks)
        false => match call check_known(known, descriptor.required_checks[index].id, 0)
            ok bool known_hit => match known_hit
                false => ok plan_rejected([diagnostic("spec::plan_checks", call reproduction_selector(call context_for(descriptor.id, "-", "", "static"), "plan"), "unknown-check", descriptor.required_checks[index].id)])
                true => relay call plan_checks(descriptor, known, index + 1)
/// Whether an id reappears at or after an index.
fn bool id_seen_later
    emits {}
    given
        test_case[] cases
        str id
        int from
    asserts
        seen: [test_case("a", [], [], 0, [], callable nonzero_result), test_case("b", [], [], 0, [], callable nonzero_result)], "b", 0 => ok true
        absent: [test_case("a", [], [], 0, [], callable nonzero_result)], "z", 0 => ok false
        empty: [], "a", 0 => ok false
    match from >= cases.length
        true => ok false
        false => match cases[from].id is id
            false => relay call id_seen_later(cases, id, from + 1)
            true => ok true
/// Reject duplicate descriptor ids. The duplicate row is the seeded
/// duplicate-ids diagnostic: source plus exact reproduction selector.
fn plan_outcome validate_unique_ids
    emits {}
    given
        test_case[] cases
        int index
    asserts
        unique: [test_case("a", [], [], 0, [], callable nonzero_result), test_case("b", [], [], 0, [], callable nonzero_result)], 0 => ok plan_ok([])
        duplicate: [test_case("a", [], [], 0, [], callable nonzero_result), test_case("a", [], [], 0, [], callable nonzero_result)], 0 => ok plan_rejected([diagnostic("spec::validate_unique_ids", "case a variant - root validate run static", "duplicate-id", "a")])
        empty: [], 0 => ok plan_ok([])
        single: [test_case("a", [], [], 0, [], callable nonzero_result)], 0 => ok plan_ok([])
    match index >= cases.length
        true => ok plan_ok([])
        false => match call id_seen_later(cases, cases[index].id, index + 1)
            ok bool seen => match seen
                false => relay call validate_unique_ids(cases, index + 1)
                true => ok plan_rejected([diagnostic("spec::validate_unique_ids", call reproduction_selector(call context_for(cases[index].id, "-", "", "static"), "validate"), "duplicate-id", cases[index].id)])
/// Consume one fixture row by key. `spent` counts prior consumptions of the
/// same key; reaching the row budget is exhausted, an absent key is missing.
/// Runs inside a live case, so the caller threads its real context and root
/// for exact diagnostics. Missing and exhausted rows are the seeded
/// missing/exhausted-fixture diagnostics.
fn consume_outcome lookup_row
    emits {}
    given
        fixture_store store
        str key
        int spent
        int index
        context c
        str root
    asserts
        hit_first: fixture_store([fixture_row("token", "abc", 1), fixture_row("seed", "zz", 2)]), "token", 0, 0, context("process/nonzero-result", "default", "", "offline"), "consume" => ok consumed("abc")
        hit_second: fixture_store([fixture_row("token", "abc", 1), fixture_row("seed", "zz", 2)]), "seed", 1, 0, context("process/nonzero-result", "default", "", "offline"), "consume" => ok consumed("zz")
        exhausted: fixture_store([fixture_row("token", "abc", 1)]), "token", 1, 0, context("process/nonzero-result", "default", "", "offline"), "consume" => ok diagnosed(diagnostic("spec::lookup_row", "case process/nonzero-result variant default root consume run offline", "exhausted-fixture", "token"))
        missing: fixture_store([fixture_row("token", "abc", 1)]), "nope", 0, 0, context("process/nonzero-result", "default", "", "offline"), "consume" => ok diagnosed(diagnostic("spec::lookup_row", "case process/nonzero-result variant default root consume run offline", "missing-fixture", "nope"))
        empty_store: fixture_store([]), "token", 0, 0, context("process/nonzero-result", "default", "", "offline"), "consume" => ok diagnosed(diagnostic("spec::lookup_row", "case process/nonzero-result variant default root consume run offline", "missing-fixture", "token"))
    match index >= store.rows.length
        true => ok diagnosed(diagnostic("spec::lookup_row", call reproduction_selector(c, root), "missing-fixture", key))
        false => match store.rows[index].key is key
            false => relay call lookup_row(store, key, spent, index + 1, c, root)
            true => match spent >= store.rows[index].budget
                false => ok consumed(store.rows[index].payload)
                true => ok diagnosed(diagnostic("spec::lookup_row", call reproduction_selector(c, root), "exhausted-fixture", key))
/// Select one descriptor by id. Static selection names the sought id with
/// variant "-" and run "static" in its miss diagnostic.
fn select_outcome select_case
    emits {}
    given
        test_case[] cases
        str id
        int index
    asserts
        first: [test_case("a", [], [], 0, [], callable nonzero_result), test_case("b", [], [], 0, [], callable nonzero_result)], "a", 0 => ok selected(test_case("a", [], [], 0, [], callable nonzero_result))
        second: [test_case("a", [], [], 0, [], callable nonzero_result), test_case("b", [], [], 0, [], callable nonzero_result)], "b", 0 => ok selected(test_case("b", [], [], 0, [], callable nonzero_result))
        miss: [test_case("a", [], [], 0, [], callable nonzero_result)], "z", 0 => ok unselected(diagnostic("spec::select_case", "case z variant - root select run static", "unknown-case", "z"))
        empty: [], "a", 0 => ok unselected(diagnostic("spec::select_case", "case a variant - root select run static", "unknown-case", "a"))
    match index >= cases.length
        true => ok unselected(diagnostic("spec::select_case", call reproduction_selector(call context_for(id, "-", "", "static"), "select"), "unknown-case", id))
        false => match cases[index].id is id
            false => relay call select_case(cases, id, index + 1)
            true => ok selected(cases[index])
/// Position of a check's evidence from an index, or -1 when absent.
fn int evidence_index
    emits {}
    given
        evidence[] got
        str check
        int from
    asserts
        hit: [evidence("a", "1", "1", true, "s1"), evidence("b", "2", "3", false, "s2")], "b", 0 => ok 1
        miss: [evidence("a", "1", "1", true, "s1")], "z", 0 => ok -1
        empty: [], "a", 0 => ok -1
    match from >= got.length
        true => ok -1
        false => match got[from].check is check
            false => relay call evidence_index(got, check, from + 1)
            true => ok from
/// Reduce evidence against required checks: every required check needs one
/// matched evidence row and no extras. The first mismatch sticks as the
/// verdict; missing or extra accounting is incomplete, never a pass.
fn reduction reduce_required
    emits {}
    given
        check_ref[] required
        evidence[] got
        int index
    asserts
        pass: [check_ref("a"), check_ref("b")], [evidence("a", "1", "1", true, "s1"), evidence("b", "2", "2", true, "s2")], 0 => ok reduction_ok(2)
        sticky: [check_ref("a"), check_ref("b")], [evidence("a", "1", "1", true, "s1"), evidence("b", "2", "3", false, "s2")], 0 => ok reduction_failed("b")
        missing: [check_ref("a"), check_ref("b")], [evidence("a", "1", "1", true, "s1")], 0 => ok reduction_incomplete("missing-check:b")
        extra: [check_ref("a")], [evidence("a", "1", "1", true, "s1"), evidence("b", "2", "2", true, "s2")], 0 => ok reduction_incomplete("extra-evidence:2:1")
        empty: [], [], 0 => ok reduction_ok(0)
    match index >= required.length
        true => match got.length is required.length
            false => ok reduction_incomplete(call text::join(["extra-evidence", call text::from_int(got.length), call text::from_int(required.length)], ":"))
            true => ok reduction_ok(required.length)
        false => match call evidence_index(got, required[index].id, 0)
            ok int at => match at is -1
                true => ok reduction_incomplete(call text::join(["missing-check", required[index].id], ":"))
                false => match got[at].matched
                    false => ok reduction_failed(got[at].check)
                    true => relay call reduce_required(required, got, index + 1)
/// Bounded subprocess execution for cases: fixed empty args, the case
/// workspace as cwd, no inherited environment, 4096-byte stream caps and a
/// 5000ms deadline with 250ms grace. Adapts every operational domain error
/// into spec::broken with operation, qualified kind and cause, so case
/// bodies keep the uniform {failed, broken} slot. This is the wrong-effect
/// seed: each operational error maps to a distinct broken value and no
/// nonzero exit is mistaken for an execution error.
fn exec_result run_process
    emits {broken}
    given
        context c
        str executable
    asserts
        ran: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => ok exec_result(1, "", "", "")
        not_found: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => broken{"spec::run_process", "files::not_found", "/usr/bin/false"}
        denied: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => broken{"spec::run_process", "files::denied", "/usr/bin/false"}
        spawn_failed: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => broken{"spec::run_process", "process::spawn_failed", "/usr/bin/false"}
        timed_out: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => broken{"spec::run_process", "process::timeout", "5000"}
        capped: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => broken{"spec::run_process", "process::output_limit", "stdout"}
        bad_config: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => broken{"spec::run_process", "process::invalid_config", "deadline_ms"}
        io_broken: context("process/nonzero-result", "default", "", "offline"), "/usr/bin/false" => broken{"spec::run_process", "process::io_error", "read"}
    bytes::buffer empty = call bytes::empty()
    process::options options = process::options(c.workspace, false, [], empty, 4096, 4096, 5000, 250)
    match call process::run(executable, [], options)
        when
            ran: executable, [], options => ok process::result(empty, empty, 1, "")
            not_found: executable, [], options => files::not_found{"/usr/bin/false"}
            denied: executable, [], options => files::denied{"/usr/bin/false", "spawn"}
            spawn_failed: executable, [], options => process::spawn_failed{"/usr/bin/false"}
            timed_out: executable, [], options => process::timeout{5000}
            capped: executable, [], options => process::output_limit{"stdout", 4096}
            bad_config: executable, [], options => process::invalid_config{"deadline_ms", "negative"}
            io_broken: executable, [], options => process::io_error{"read"}
        files::not_found as failure => broken{"spec::run_process", "files::not_found", failure.path}
        files::denied as failure => broken{"spec::run_process", "files::denied", failure.path}
        process::spawn_failed as failure => broken{"spec::run_process", "process::spawn_failed", failure.executable}
        process::timeout as failure => broken{"spec::run_process", "process::timeout", call text::from_int(failure.deadline_ms)}
        process::output_limit as failure => broken{"spec::run_process", "process::output_limit", failure.stream}
        process::invalid_config as failure => broken{"spec::run_process", "process::invalid_config", failure.field}
        process::io_error as failure => broken{"spec::run_process", "process::io_error", failure.operation}
        ok process::result got => match call bytes::encode_hex(got.stdout)
            ok str out_hex => match call bytes::encode_hex(got.stderr)
                ok str err_hex => ok exec_result(got.code, got.signal, out_hex, err_hex)
/// Canonical skeleton case: a completed nonzero subprocess result keeps its
/// separate exit-code, signal and stream fields. Fixtures supply only the
/// run_process operation boundary; every comparison still executes. The
/// wrong_code root alters the observed exit code and must fail at the real
/// require_int call, proving supplied execution is not a passing test. This
/// is the altered-observation seed. No root replaces the case with ok.
fn void nonzero_result
    emits {failed, broken}
    given
        context c
    asserts
        expected: context("process/nonzero-result", "default", "", "offline") => ok
        wrong_code: context("process/nonzero-result", "default", "", "offline") => failed{"exit-code"}
    match call run_process(c, "/usr/bin/false")
        when
            expected: c, "/usr/bin/false" => ok exec_result(1, "", "", "")
            wrong_code: c, "/usr/bin/false" => ok exec_result(0, "", "", "")
        broken
        ok exec_result got => match call require_int(got.code, 1, c, "exit-code")
            failed
            ok evidence code_ok => match call require_text(got.signal, "", c, "signal")
                failed
                ok evidence signal_ok => match call require_text(got.stdout_hex, "", c, "stdout")
                    failed
                    ok evidence out_ok => match call require_text(got.stderr_hex, "", c, "stderr")
                        failed
                        ok evidence err_ok => ok
/// Seeded single-use fixture store: a second spend of "token" is exhausted.
/// The duplicate-ids seed lives in the validate_unique_ids roots instead: a
/// package value cannot hold callable bodies under inert initialization.
fixture_store exhaust_seed = fixture_store([fixture_row("token", "abc", 1)])
