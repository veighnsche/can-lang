package test_owner
    provides []
    uses [checks, codec, test]
fn int roundtrip_depth
    emits {test::invalid_grant, test::stale_handle, test::invalid_kind, test::closed_handle, test::channel_full, test::detached_transport, test::channel_empty, test::transport_failure}
    given
        str grant
    asserts
        probe: "ng1-0123456789abcdef0123456789abcdef" => ok 0
        bad_grant: "xx" => test::invalid_grant{"bad-length"}
    match chain
        call test::grant_admit(grant) as test::owner owner
        call test::channel_open(owner, "dispatch") as test::channel channel
        call test::channel_send(channel, codec::json_object([codec::json_member("op", codec::json_string("probe"))])) as int sent
        call test::channel_recv(channel) as codec::json_object envelope
        call test::channel_pending(channel) as int depth
        call test::channel_close(channel)
        call test::grant_release(owner)
        test::invalid_grant
        test::stale_handle
        test::invalid_kind
        test::closed_handle
        test::channel_full
        test::detached_transport
        test::channel_empty
        test::transport_failure
        ok => ok depth
fn void main
    emits {test::invalid_grant, test::stale_handle, test::invalid_kind, test::closed_handle, test::channel_full, test::detached_transport, test::channel_empty, test::transport_failure, checks::failed}
    given
        str[] args
    asserts
        sample: [] => ok
    match call roundtrip_depth("ng1-0123456789abcdef0123456789abcdef")
        test::invalid_grant
        test::stale_handle
        test::invalid_kind
        test::closed_handle
        test::channel_full
        test::detached_transport
        test::channel_empty
        test::transport_failure
        ok int depth => match call checks::require(depth is 0, "expected drained channel")
            checks::failed
            ok => ok
